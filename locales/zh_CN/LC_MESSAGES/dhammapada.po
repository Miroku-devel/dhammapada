msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "title"
msgstr "法句經"

msgid "chaps"
msgstr "章節"

msgid "fontsize"
msgstr "字體大小"

msgid "chap1"
msgstr "双品"

msgid "1"
msgstr "诸法意先导，意主意造作。\n若以染污意，或语或行业，\n是则苦随彼，如轮随兽足。"

msgid "2"
msgstr "诸法意先导，意主意造作。\n若以清净意，或语或行业，\n是则乐随彼，如影不离形。"

msgid "3"
msgstr "「彼骂我打我，败我劫夺我」，\n若人怀此念，怨恨不能息。"

msgid "4"
msgstr "「彼骂我打我，败我劫夺我」，\n若人舍此念，怨恨自平息。"

msgid "5"
msgstr "于此世界中，从非怨止怨，\n唯以忍止怨；此古圣常法。"

msgid "6"
msgstr "彼人不了悟：「我等将毁灭」。\n若彼等知此，则诤论自息。"

msgid "7"
msgstr "唯求住净乐，不摄护诸根，\n饮食不知量，懈惰不精进，\n彼实为魔伏，如风吹弱树。"

msgid "8"
msgstr "愿求非乐住，善摄护诸根，\n饮食知节量，具信又精进，\n魔不能胜彼，如风吹石山。"

msgid "9"
msgstr "若人穿袈裟，不离诸垢秽，\n无诚实克己，不应着袈裟。"

msgid "10"
msgstr "若人离诸垢，能善持戒律，\n克己与诚实，彼应着袈裟。"

msgid "11"
msgstr "非真思真实，真实见非真，\n邪思惟境界，彼不达真实。"

msgid "12"
msgstr "真实思真实，非真知非真，\n正思惟境界，彼能达真实。"

msgid "13"
msgstr "如盖屋不密，必为雨漏浸，\n如是不修心，贪欲必漏入。"

msgid "14"
msgstr "如善密盖屋，不为雨漏浸，\n如是善修心，贪欲不漏入。"

msgid "15"
msgstr "现世此处悲，死后他处悲，\n作诸恶业者，两处俱忧悲，\n见自恶业已，他悲他苦恼。"

msgid "16"
msgstr "现世此处乐，死后他处乐，\n作诸善业者，两处俱受乐，\n见自善业已，他乐他极乐。"

msgid "17"
msgstr "现世此处苦，死后他处苦，\n作诸恶业者，两处俱受苦，\n现悲「我作恶」，堕恶趣更苦。"

msgid "18"
msgstr "现世此处喜，死后他处喜，\n修诸福业者，两处俱欢喜，\n现喜「我修福」，生善趣更喜。"

msgid "19"
msgstr "虽多诵经集，放逸而不行，\n如牧数他牛，自无沙门分。"

msgid "20"
msgstr "虽诵经典少，能依教实行，\n具足正知识，除灭贪瞋痴，\n善净解脱心，弃舍于世欲，\n此界或他界，彼得沙门分。"

msgid "chap2"
msgstr "不放逸品"

msgid "21"
msgstr "无逸不死道，放逸趣死路。\n无逸者不死，放逸者如尸。"

msgid "22"
msgstr "智者深知此，所行不放逸。\n不放逸得乐，喜悦于圣境。"

msgid "23"
msgstr "智者常坚忍，勇猛修禅定。\n解脱得安隐，证无上涅槃。"

msgid "24"
msgstr "奋勉常正念，净行能克己，\n如法而生活，无逸善名增。"

msgid "25"
msgstr "奋勉不放逸，克己自调御，\n智者自作洲，不为洪水没。"

msgid "26"
msgstr "暗钝愚痴人，耽溺于放逸，\n智者不放逸，如富人护宝。"

msgid "27"
msgstr "莫耽溺放逸，莫嗜爱欲乐。\n警觉修定者，始得大安乐。"

msgid "28"
msgstr "智者以无逸，除逸则无忧，\n圣贤登慧阁，观愚者多忧，\n如登于高山，俯视地上物。"

msgid "29"
msgstr "放逸中无逸，如众睡独醒。\n智者如骏驰，驽骀所不及。"

msgid "30"
msgstr "摩伽以无逸，得为诸天主。\n无逸人所赞，放逸为人诃。"

msgid "31"
msgstr "乐不放逸比丘，或者惧见放逸，\n犹如猛火炎炎，烧去大结小结。"

msgid "32"
msgstr "乐不放逸比丘，或者惧见放逸，\n彼已邻近涅槃，必定不易堕落。"

msgid "chap3"
msgstr "心品"

msgid "33"
msgstr "轻动变易心，难护难制服。\n智者调直之，如匠搦箭直。"

msgid "34"
msgstr "如鱼离水栖，投于陆地上，\n以此战栗心，摆脱魔境界。"

msgid "35"
msgstr "此心随欲转，轻躁难捉摸。\n善哉心调伏，心调得安乐。"

msgid "36"
msgstr "此心随欲转，微妙极难见。\n智者防护心，心护得安乐。"

msgid "37"
msgstr "远行与独行，无形隐深窟。\n谁能调伏心，解脱魔罗缚。"

msgid "38"
msgstr "心若不安定，又不了正法，\n信心不坚者，智慧不成就。"

msgid "39"
msgstr "若得无漏心，亦无诸惑乱，\n超越善与恶，觉者无恐怖。"

msgid "40"
msgstr "知身如陶器，住心似城廓，\n慧剑击魔罗，守胜莫染着。"

msgid "41"
msgstr "此身实不久，当睡于地下，\n被弃无意识，无用如木屑。"

msgid "42"
msgstr "仇敌害仇敌，怨家对怨家，\n若心向邪行，恶业最为大。"

msgid "43"
msgstr "善非父母作，亦非他眷属，\n若心向正行，善业最为大。"

msgid "chap4"
msgstr "华品"

msgid "44"
msgstr "谁征服地界，阎魔界天界，\n谁善说法句，如巧匠采花？"

msgid "45"
msgstr "有学克地界，阎魔界天界，\n有学说法句，如巧匠采花。"

msgid "46"
msgstr "知此身如泡，觉悟是幻法，\n折魔罗花箭，越死王所见。"

msgid "47"
msgstr "采集诸花已，其人心爱着，\n死神捉将去，如瀑流睡村。"

msgid "48"
msgstr "采集诸花已，其人心爱着，\n贪欲无厌足，实为死魔伏。"

msgid "49"
msgstr "牟尼入村落，譬如蜂采华，\n不坏色与香，但取其蜜去。"

msgid "50"
msgstr "不观他人过，不观作不作，\n但观自身行，已作与未作。"

msgid "51"
msgstr "犹如鲜妙花，色美而无香，\n如是说善语，彼不行无果。"

msgid "52"
msgstr "犹如鲜妙花，色美而芳香，\n如是说善语，彼实行有果。"

msgid "53"
msgstr "如从诸花聚，得造众花鬘，\n如是生为人，当作诸善事。"

msgid "54"
msgstr "花香不逆风，栴檀多伽罗，末利香亦尔。\n德香逆风薰，彼正人之香，遍闻于诸方。"

msgid "55"
msgstr "栴檀多伽罗，拔悉基青莲，\n如是诸香中，戒香为最上。"

msgid "56"
msgstr "栴檀多伽罗，此等香甚微。\n持戒者最上，香薰诸天间。"

msgid "57"
msgstr "成就诸戒行，住于不放逸，\n正智解脱者，魔不知所趣。"

msgid "58"
msgstr "犹如粪秽聚，弃着于大道，\n莲华生其中，香洁而悦意。"

msgid "59"
msgstr "如是粪秽等，盲昧凡夫中，\n正觉者弟子，以智慧光照。"

msgid "chap5"
msgstr "愚品"

msgid "60"
msgstr "不眠者夜长，倦者由旬长，\n不明达正法──愚者轮回长。"

msgid "61"
msgstr "不得胜我者为友，与我相等者亦无，\n宁可坚决独行居，不与愚人作伴侣。"

msgid "62"
msgstr "「此我子我财」，愚人常为忧。\n我且无有我，何有子与财？"

msgid "63"
msgstr "愚者自知愚，彼即是智人。\n愚人自谓智，实称真愚夫。"

msgid "64"
msgstr "愚者虽终身，亲近于智人，\n彼不了达摩，如匙尝汤味。"

msgid "65"
msgstr "慧者须臾顷，亲近于智人，\n能速解达摩，如舌尝汤味。"

msgid "66"
msgstr "愚人不觉知，与自仇敌行，\n造作诸恶业，受定众苦果。"

msgid "67"
msgstr "彼作不善业，作已生后悔，\n哭泣泪满面，应得受异熟。"

msgid "68"
msgstr "若彼作善业，作已不追悔，\n欢喜而愉悦，应得受异熟。"

msgid "69"
msgstr "恶业未成熟，愚人思如蜜；\n恶业成熟时，愚人必受苦。"

msgid "70"
msgstr "愚者月复月，虽仅取少食──以孤沙草端；\n彼所得功德，不及思法者，十六分之一。"

msgid "71"
msgstr "犹如搆牛乳，醍醐非速成。\n愚人造恶业，不即感恶果，\n业力随其后，如死灰覆火。"

msgid "72"
msgstr "愚夫求知识，反而趋灭亡，\n损害其幸福，破碎其头首。"

msgid "73"
msgstr "愚人骛虚名：僧中作上座，僧院为院主，他人求供养。"

msgid "74"
msgstr "「僧与俗共知──此事由我作，事无论大小，皆由我作主」，\n"
"愚人作此想，贪与慢增长。"

msgid "75"
msgstr "一道引世利，一道向涅槃。\n佛弟子比丘，当如是了知，\n莫贪着世利，专注于远离。"

msgid "chap6"
msgstr "智者品"

msgid "76"
msgstr "若见彼智者──能指示过失，并能谴责者，当与彼为友；\n犹如知识者，能指示宝藏。\n与彼智人友，定善而无恶。"

msgid "77"
msgstr "训诫与教示，阻他人过恶。\n善人爱此人，但为恶人憎。"

msgid "78"
msgstr "莫与恶友交，莫友卑鄙者。\n应与善友交，应友高尚士。"

msgid "79"
msgstr "得饮法水者，心清而安乐。\n智者常喜悦，圣者所说法。"

msgid "80"
msgstr "灌溉者引水，箭匠之矫箭，\n木匠之绳木，智者自调御。"

msgid "81"
msgstr "犹如坚固巖，不为风所摇，\n毁谤与赞誉，智者不为动。"

msgid "82"
msgstr "亦如一深池，清明而澄净，\n智者闻法已，如是心清净。"

msgid "83"
msgstr "善人离诸欲，不论诸欲事。\n苦乐所不动，智者无喜忧。"

msgid "84"
msgstr "不因自因他，智者作诸恶，\n不求子求财、及谋国作恶。\n不欲以非法，求自己繁荣。\n彼实具戒行，智慧正法者。"

msgid "85"
msgstr "于此人群中，达彼岸者少。\n其余诸人等，徘徊于此岸。"

msgid "86"
msgstr "善能说法者，及依正法行，\n彼能达彼岸，度难度魔境。"

msgid "87"
msgstr "应舍弃黑法，智者修白法，\n从家来无家，喜独处不易。"

msgid "88"
msgstr "当求是法乐，舍欲无所有，\n智者须清净，自心诸垢秽。"

msgid "89"
msgstr "彼于诸觉支，正心而修习。\n远离诸固执，乐舍诸爱着，\n漏尽而光耀，此世证涅槃。"

msgid "chap7"
msgstr "阿罗汉品"

msgid "90"
msgstr "路行尽无忧，于一切解脱，\n断一切系缚，无有苦恼者。"

msgid "91"
msgstr "正念奋勇者，彼不乐在家。\n如鹅离池去，彼等弃水家。"

msgid "92"
msgstr "彼等无积聚，于食如实知，\n空无相解脱──是彼所行境，\n如鸟游虚空，踪迹不可得。"

msgid "93"
msgstr "彼等诸漏尽，亦不贪饮食，\n空无相解脱──是彼所行境，\n如鸟游虚空，踪迹不可得。"

msgid "94"
msgstr "彼诸根寂静，如御者调馬，\n离我慢无漏，为天人所慕。"

msgid "95"
msgstr "彼已无愤恨，犹如于大地，\n彼虔诚坚固，如因陀揭罗，\n如无污泥池，是人无轮回。"

msgid "96"
msgstr "彼人心寂静，语与业寂静，\n正智而解脱，如是得安稳。"

msgid "97"
msgstr "无信知无为，断系因永谢，\n弃舍于贪欲，真实无上士。"

msgid "98"
msgstr "于村落林间，平地或丘陵，\n何处有罗汉，彼地即可庆。"

msgid "99"
msgstr "林野甚可乐，世人所不乐；\n彼喜离欲乐，不求诸欲乐。"

msgid "chap8"
msgstr "千品"

msgid "100"
msgstr "虽诵一千言，若无义理者，\n不如一义语，闻已得寂静。"

msgid "101"
msgstr "虽诵千句偈，若无义理者，\n不如一句偈，闻已得寂静。"

msgid "102"
msgstr "彼诵百句偈，若无义理者，\n不如一法句，闻已得寂静。"

msgid "103"
msgstr "彼于战场上，虽胜百万人；\n未若克己者，战士之最上！"

msgid "104"
msgstr "能克制自己，过于胜他人。\n若有克己者，常行自节制。"

msgid "105"
msgstr "天神干闼婆，魔王并梵天，\n皆遭于败北，不能胜彼人。"

msgid "106"
msgstr "月月投千金──供牺牲百年，\n不如须臾间，供养修己者，\n彼如是供养，胜祭祀百年。"

msgid "107"
msgstr "若人一百年──事火于林中，\n不如须臾间，供养修己者，\n彼如是供养，胜祭祀百年。"

msgid "108"
msgstr "若人于世间，施舍 or 供养，\n求福一周年，如是诸功德，\n不及四分一，礼敬正直者。"

msgid "109"
msgstr "好乐敬礼者，常尊于长老，\n四法得增长：寿美乐与力。"

msgid "110"
msgstr "若人寿百岁──破戒无三昧，\n不如生一日──持戒修禅定。"

msgid "111"
msgstr "若人寿百岁──无慧无三昧，\n不如生一日──具慧修禅定。"

msgid "112"
msgstr "若人寿百岁──怠惰不精进，\n不如生一日──励力行精进。"

msgid "113"
msgstr "若人寿百岁──不见生灭法，\n不如生一日──得见生灭法。"

msgid "114"
msgstr "若人寿百岁──不见不死道，\n不如生一日──得见不死道。"

msgid "115"
msgstr "若人寿百岁──不见最上法，\n不如生一日──得见最上法。"

msgid "chap9"
msgstr "恶品"

msgid "116"
msgstr "应急速作善，制止罪恶心。\n怠慢作善者，心则喜于恶。"

msgid "117"
msgstr "若人作恶已，不可数数作；\n莫喜于作恶，积恶则受苦。"

msgid "118"
msgstr "若人作善已，应复数数作；\n当喜于作善，积善则受乐。"

msgid "119"
msgstr "恶业未成熟，恶者以为乐。\n恶业成熟时，恶者方见恶。"

msgid "120"
msgstr "善业未成熟，善人以为苦。\n善业成熟时，善人始见善。"

msgid "121"
msgstr "莫轻于小恶！谓「我不招报」，\n须知滴水落，亦可满水瓶，\n愚夫盈其恶，少许少许积。"

msgid "122"
msgstr "莫轻于小善！谓「我不招报」，\n须知滴水落，亦可满水瓶，\n智者完其善，少许少许积。"

msgid "123"
msgstr "商人避险道，伴少而货多；\n爱生避毒品，避恶当亦尔。"

msgid "124"
msgstr "假若无有疮伤手，\n可以其手持毒药。\n毒不能患无伤手。\n不作恶者便无恶。"

msgid "125"
msgstr "若犯无邪者，清净无染者，\n罪恶向愚人，如逆风扬尘。"

msgid "126"
msgstr "有人生于母胎中，\n作恶者则堕地狱，\n正直之人升天界，\n漏尽者证入涅槃。"

msgid "127"
msgstr "非于虚空及海中，\n亦非入深山洞窟，\n欲求逃遁恶业者，\n世间实无可觅处。"

msgid "128"
msgstr "非于虚空及海中，\n亦非入深山洞窟，\n欲求不为死魔制，\n世间实无可觅处。"

msgid "chap10"
msgstr "刀杖品"

msgid "129"
msgstr "一切惧刀杖，一切皆畏死，\n以自度他情，莫杀教他杀。"

msgid "130"
msgstr "一切惧刀杖，一切皆爱生，\n以自度他情，莫杀教他杀。"

msgid "131"
msgstr "于求乐有情，刀杖加恼害，\n但求自己乐，后世乐难得。"

msgid "132"
msgstr "于求乐有情，不加刀杖害，\n欲求自己乐，后世乐可得。"

msgid "133"
msgstr "对人莫说粗恶语，汝所说者还说汝。\n愤怒之言实堪痛；互击刀杖可伤汝。"

msgid "134"
msgstr "汝若自默然，如一破铜锣，\n已得涅槃路；于汝无诤故。"

msgid "135"
msgstr "如牧人以杖，驱牛至牧场，\n如是老与死．驱逐众生命。"

msgid "136"
msgstr "愚夫造作诸恶业，却不自知有果报，\n痴人以自业感苦，宛如以火而自烧。"

msgid "137"
msgstr "若以刀杖害，无恶无害者，\n十事中一种，彼将迅速得。"

msgid "138"
msgstr "极苦痛失财，身体被损害，\n或重病所逼，或失心狂乱。"

msgid "139"
msgstr "或为王迫害，或被诬重罪，\n或眷属离散，或破灭财产。"

msgid "140"
msgstr "或彼之房屋，为劫火焚烧。\n痴者身亡后，复堕于地狱。"

msgid "141"
msgstr "非裸行结发，非涂泥绝食，\n卧地自尘身，非以蹲踞住，\n不断疑惑者，能令得清净。"

msgid "142"
msgstr "严身住寂静，调御克制，\n必然修梵行，不以刀杖等，\n加害诸有情，彼即婆罗门，\n彼即是沙门，彼即是比丘。"

msgid "143"
msgstr "以惭自禁者，世间所罕有，\n彼善避羞辱，如良马避鞭。"

msgid "144"
msgstr "如良马加鞭，当奋勉忏悔。\n以信戒精进，以及三摩地，\n善分别正法，以及明行足，\n汝当念勿忘，消灭无穷苦。"

msgid "145"
msgstr "灌溉者引水，箭匠之矫箭，\n木匠之绳木，善行者自御。"

msgid "chap11"
msgstr "老品"

msgid "146"
msgstr "常在燃烧中，何喜何可笑？\n幽暗之所蔽，何不求光明？"

msgid "147"
msgstr "观此粉饰身：疮伤一堆骨，\n疾病多思惟。绝非常存者。"

msgid "148"
msgstr "此衰老形骸，病薮而易坏；\n朽聚必毁灭，有生终归死。"

msgid "149"
msgstr "犹如葫卢瓜，散弃于秋季，\n骸骨如鸽色，观此何可乐？"

msgid "150"
msgstr "此城骨所建，涂以血与肉，\n储藏老与死，及慢并虚伪。"

msgid "151"
msgstr "盛饰王车亦必朽，此身老迈当亦尔。\n唯善人法不老朽，善人传示于善人。"

msgid "152"
msgstr "寡闻之愚人，生长如牡牛，\n唯增长筋肉，而不增智慧。"

msgid "153"
msgstr "经多生轮回，寻求造屋者，\n但未得见之，痛苦再再生。"

msgid "154"
msgstr "已见造屋者！不再造于屋。\n椽桷皆毁坏，栋梁亦摧折。\n我既证无为，一切爱尽灭。"

msgid "155"
msgstr "少壮不得财，并不修梵行，\n如池边老鹭，无鱼而萎灭。"

msgid "156"
msgstr "少壮不得财，并不修梵行，\n卧如破折弓，悲叹于过去。"

msgid "chap12"
msgstr "自己品"

msgid "157"
msgstr "若人知自爱，须善自保护。\n三时中一时，智者应醒觉。"

msgid "158"
msgstr "第一将自己，安置于正道，\n然后教他人；贤者始无过。"

msgid "159"
msgstr "若欲诲他者，应如己所行，\n自制乃制他，克己实最难。"

msgid "160"
msgstr "自为自依怙，他人何可依？\n自己善调御，证难得所依。"

msgid "161"
msgstr "恶业实由自己作，从自己生而自起。\n恶业摧坏于愚者，犹如金刚破宝石。"

msgid "162"
msgstr "破戒如蔓萝，缠覆裟罗树。\n彼自如此作，徒快敌者意。"

msgid "163"
msgstr "不善事易作，然无益于己；\n善与利益事，实为极难行。"

msgid "164"
msgstr "恶慧愚痴人，以其邪见故，\n侮蔑罗汉教，依正法行者，\n以及尊者教，而自取毁灭，\n如格他格草，结果自灭亡。"

msgid "165"
msgstr "恶实由己作，染污亦由己；\n由己不作恶，清净亦由己。\n净不净依己，他何能净他？"

msgid "166"
msgstr "莫以利他事，忽于己利益。\n善知己利者，常专心利益。"

msgid "chap13"
msgstr "世品"

msgid "167"
msgstr "莫从卑劣法。莫住于放逸。\n莫随于邪见。莫增长世俗。"

msgid "168"
msgstr "奋起莫放逸！行正法善行。\n依正法行者，此世他世乐。"

msgid "169"
msgstr "行正法善行。勿行于恶行。\n依正法行者，此世他世乐。"

msgid "170"
msgstr "视如水上浮沤，视如海市蜃楼，\n若人观世如是，死王不得见他。"

msgid "171"
msgstr "来看这个世界，犹如庄严王车。\n愚人沈湎此中，智者毫无执着。"

msgid "172"
msgstr "若人先放逸，但后不放逸。\n彼照耀此世，如月出云翳。"

msgid "173"
msgstr "若作恶业已，覆之以善者。\n彼照耀此世，如月出云翳。"

msgid "174"
msgstr "此世界盲暝，能得见者少。\n如鸟脱罗网，鲜有升天者。"

msgid "175"
msgstr "天鹅飞行太阳道，以神通力可行空。\n智者破魔王魔眷，得能脱离于世间。"

msgid "176"
msgstr "违犯一乘法，及说妄语者，\n不信来世者，则无恶不作。"

msgid "177"
msgstr "悭者不生天。愚不赞布施。\n智者随喜施，后必得安乐。"

msgid "178"
msgstr "一统大地者，得生天上者，\n一切世界主，不及预流胜。"

msgid "chap14"
msgstr "佛陀品"

msgid "179"
msgstr "彼之胜利无能胜，败者于世无可从，\n佛智无边无行迹，汝复以何而诳惑？"

msgid "180"
msgstr "彼已不具于结缚，爱欲难以诱使去，\n佛智无边无行迹，汝复以何而诳惑？"

msgid "181"
msgstr "智者修禅定，喜出家寂静，\n正念正觉者，天人所敬爱。"

msgid "182"
msgstr "得生人道难，生得寿终难，\n得闻正法难，遇佛出世难。"

msgid "183"
msgstr "一切恶莫作，一切善应行，\n自调净其意，是则诸佛教。"

msgid "184"
msgstr "诸佛说涅槃最上，忍辱为最高苦行。\n害他实非出家者，恼他不名为沙门。"

msgid "185"
msgstr "不诽与不害，严持于戒律，\n饮食知节量，远处而独居，\n勤修增上定，是为诸佛教。"

msgid "186"
msgstr "即使雨金钱，欲心不满足。\n智者知淫欲，乐少而苦多！"

msgid "187"
msgstr "故彼于天欲，亦不起希求。\n正觉者弟子，希灭于爱欲。"

msgid "188"
msgstr "诸人恐怖故，去皈依山岳，\n或依于森林，园苑树支提。"

msgid "189"
msgstr "此非安稳依，此非最上依，\n如是皈依者，不离一切苦。"

msgid "190"
msgstr "若人皈依佛，皈依法及僧，\n由于正智慧，得见四圣谛。"

msgid "191"
msgstr "苦与苦之因，以及苦之灭，\n并八支圣道，能令苦寂灭。"

msgid "192"
msgstr "此皈依安稳，此皈依无上，\n如是皈依者，解脱一切苦。"

msgid "193"
msgstr "圣人极难得，彼非随处生；\n智者所生处，家族咸蒙庆。"

msgid "194"
msgstr "诸佛出现乐，演说正法乐，\n僧伽和合乐，修士和合乐。"

msgid "195"
msgstr "供养应供者──脱离于虚妄，\n超越诸忧患，佛及佛弟子。"

msgid "196"
msgstr "若供养如是──寂静无畏者，\n其所得功德，无能测量者。"

msgid "chap15"
msgstr "乐品"

msgid "197"
msgstr "我等实乐生，憎怨中无憎。\n于憎怨人中，我等无憎住。"

msgid "198"
msgstr "我等实乐生，疾病中无病。\n于疾病人中，我等无病住。"

msgid "199"
msgstr "我等实乐生，贪欲中无欲。\n于贪欲人中，我等无欲住。"

msgid "200"
msgstr "我等实乐生，我等无物障，\n我等乐为食，如光音天人。"

msgid "201"
msgstr "胜利生憎怨，败者住苦恼。\n胜败两俱舍，和静住安乐。"

msgid "202"
msgstr "无火如贪欲，无恶如瞋恨，\n无苦如五蕴，无乐胜寂静。"

msgid "203"
msgstr "飢为最大病，行为最大苦；\n如实知此已，涅槃乐最上。"

msgid "204"
msgstr "无病最上利，知足最上财，\n信赖最上亲，涅槃最上乐。"

msgid "205"
msgstr "已饮独居味，以及寂静味，\n喜饮于法味，离怖畏去恶。"

msgid "206"
msgstr "善哉见圣者，与彼同住乐。\n由不见愚人，彼即常欢乐。"

msgid "207"
msgstr "与愚者同行，长时处忧悲。\n与愚同住苦，如与敌同居。\n与智者同住，乐如会亲族。"

msgid "208"
msgstr "是故真实：\n贤者智者多闻者，\n持戒虔诚与圣者，\n从斯善人贤惠游，\n犹如月从于星道。"

msgid "chap16"
msgstr "喜爱品"

msgid "209"
msgstr "专事不当事，不事于应修，\n弃善趋爱欲，却羡自勉者。"

msgid "210"
msgstr "莫结交爱人，莫结不爱人。\n不见爱人苦，见憎人亦苦。\n因此莫爱着，爱别离为苦。\n若无爱与憎，彼即无羁缚。"

msgid "211"
msgstr "是故莫爱着，爱别离为苦。\n若无爱与憎，彼即无羁缚。"

msgid "212"
msgstr "从喜爱生忧，从喜爱生怖；\n离喜爱无忧，何处有恐怖。"

msgid "213"
msgstr "从亲爱生忧，从亲爱生怖；\n离亲爱无忧，何处有恐怖。"

msgid "214"
msgstr "从贪欲生忧，从贪欲生怖；\n离贪欲无忧，何处有恐怖。"

msgid "215"
msgstr "从欲乐生忧，从欲乐生怖；\n离欲乐无忧，何处有恐怖。"

msgid "216"
msgstr "从爱欲生忧，从爱欲生怖；\n离爱欲无忧，何处有恐怖。"

msgid "217"
msgstr "具戒及正见，住法知真谛，\n圆满自所行，彼为世人爱。"

msgid "218"
msgstr "渴求离言法，充满思虑心，\n诸欲心不着，是名上流人。"

msgid "219"
msgstr "久客异乡者，自远处安归，\n亲友与知识，欢喜而迎彼。"

msgid "220"
msgstr "造福亦如是，从此生彼界，\n福业如亲友，以迎爱者來。"

msgid "chap17"
msgstr "忿怒品"

msgid "221"
msgstr "舍弃于忿怒，除灭于我慢，\n解脱一切缚，不执着名色，\n彼无一物者，苦不能相随。"

msgid "222"
msgstr "若能抑忿发，如止急行车，\n是名善御者，余为执缰人。"

msgid "223"
msgstr "以不忿胜忿。以善胜不善。\n以施胜悭吝。以实胜虚妄。"

msgid "224"
msgstr "谛语不瞋恚，分施与乞者；\n以如是三事，能生于诸天。"

msgid "225"
msgstr "彼无害牟尼，常调伏其身，\n到达不死境─无有悲忧处。"

msgid "226"
msgstr "恒常醒觉者，日夜勤修学，\n志向于涅槃，息灭诸烦恼。"

msgid "227"
msgstr "阿多罗应知：\n此非今日事，古语已有之。\n默然为人诽，多语为人诽，寡言为人诽；\n不为诽谤者，斯世实无有。"

msgid "228"
msgstr "全被人诽者，或全被赞者，\n非曾有当有，现在亦无有。"

msgid "229"
msgstr "若人朝朝自反省，行无瑕疵并贤明，\n智慧戒行兼具者，彼为智人所称赞。"

msgid "230"
msgstr "品如阎浮金，谁得诽辱之？\n彼为婆罗门，诸天所称赞。"

msgid "231"
msgstr "摄护身忿怒，调伏于身行。\n舍离身恶行，以身修善行。"

msgid "232"
msgstr "摄护语忿怒，调伏于语行。\n舍离语恶行，以语修善行。"

msgid "233"
msgstr "摄护意忿怒，调伏于意行。\n舍离意恶行，以意修善行。"

msgid "234"
msgstr "智者身调伏，亦复语调伏，\n于意亦调伏，实一切调伏。"

msgid "chap18"
msgstr "垢秽品"

msgid "235"
msgstr "汝今已似枯燋叶，阎魔使者近身边。\n汝已伫立死门前，旅途汝亦无资粮。"

msgid "236"
msgstr "汝宜自造安全洲，迅速精勤为智者。\n拂除尘垢无烦恼，得达诸天之圣境。"

msgid "237"
msgstr "汝今寿命行已终，汝已移步近阎魔。\n道中既无停息处，旅途汝亦无资粮。"

msgid "238"
msgstr "汝宜自造安全洲，迅速精勤为智者。\n拂除尘垢无烦恼，不复重来生与老。"

msgid "239"
msgstr "剎那剎那间，智者分分除，\n渐拂自垢秽，如冶工锻金。"

msgid "240"
msgstr "如铁自生锈，生已自腐蚀，\n犯罪者亦尔，自业导恶趣。"

msgid "241"
msgstr "不诵经典秽，不勤为家秽，\n懒惰为色秽，放逸护卫秽。"

msgid "242"
msgstr "邪行妇人秽，吝啬施者秽。\n此界及他界，恶法实为秽。"

msgid "243"
msgstr "此等诸垢中，无明垢为最，\n汝当除此垢，成无垢比丘！"

msgid "244"
msgstr "生活无惭愧，卤莽如乌鸦，\n诋毁于他人，大胆自夸张，\n傲慢邪恶者，其人生活易。"

msgid "245"
msgstr "生活于惭愧，常求于清净，\n不着欲谦逊，住清净生活，\n富于识见者，其人生活难。"

msgid "246"
msgstr "若人于世界，杀生说妄语，\n取人所不与，犯于别人妻。"

msgid "247"
msgstr "及耽湎饮酒，行为如是者，\n即于此世界，毁掘自善根。"

msgid "248"
msgstr "如是汝应知：不制则为恶；\n莫贪与非法，自陷于永苦。"

msgid "249"
msgstr "若信乐故施。心嫉他得食，\n彼于昼 or 夜，不得入三昧。"

msgid "250"
msgstr "若斩断此心，拔根及除灭，\n则于昼或夜，彼得入三昧。"

msgid "251"
msgstr "无火等于贪欲，无执着如瞋恚，\n无网等于愚痴，无河流如爱欲。"

msgid "252"
msgstr "易见他人过，自见则为难。\n扬恶如颺糠，已过则覆匿，\n如彼狡博者，隐匿其格利。"

msgid "253"
msgstr "若见他人过，心常易忿者，\n增长于烦恼；去断惑远矣。"

msgid "254"
msgstr "虚空无道迹，外道无沙门。\n众生喜虚妄，如来无虚妄。"

msgid "255"
msgstr "虚空无道迹，外道无沙门。\n五蕴无常住，诸佛无动乱。"

msgid "chap19"
msgstr "法住品"

msgid "256"
msgstr "卤莽处事故，不为法住者。\n智者应辨别──孰正与孰邪。"

msgid "257"
msgstr "导人不卤莽，如法而公平，\n智者护于法，是名法住者。"

msgid "258"
msgstr "不以多言故，彼即为智者。\n安静无怨怖，是名为智者。"

msgid "259"
msgstr "不以多言故，彼为持法者。\n彼虽闻少分，但由身见法，\n于法不放逸，是名持法者。"

msgid "260"
msgstr "不因彼白头，即得为长老。\n彼年龄虚熟，徒有长老名。"

msgid "261"
msgstr "于彼具真实，具法不杀生，\n节制并调伏，彼有智慧人。\n除灭诸垢秽，实名为长老。"

msgid "262"
msgstr "嫉悭虚伪者，虽以其辩才，\n或由相端严，不为善良人。"

msgid "263"
msgstr "若斩断此心，拔根及除灭，\n彼舍瞋智者，名为善良人。"

msgid "264"
msgstr "若破戒妄语，削发非沙门。\n充满欲与贪，云何为沙门？"

msgid "265"
msgstr "彼息灭诸恶──无论大与小，\n因息灭诸恶，故名为沙门。"

msgid "266"
msgstr "仅向他行乞，不即是比丘。\n行宗教法仪，亦不为比丘。"

msgid "267"
msgstr "仅舍善与恶，修于梵行者，\n以知住此世，彼实名比丘。"

msgid "268"
msgstr "愚昧无知者，不以默然故，\n而名为牟尼。智者如权衡。"

msgid "269"
msgstr "舍恶取其善，乃得为牟尼。\n彼知于两界，故称为牟尼。"

msgid "270"
msgstr "彼人非圣贤，以其杀生故。\n不害诸众生，是名为圣者。"

msgid "271"
msgstr "不以戒律行，或由于多闻，\n或由证三昧，或由于独居，"

msgid "272"
msgstr "谓：「受出家乐，非凡夫所能」。\n汝等漏未尽，莫生保信想！"

msgid "chap20"
msgstr "道品"

msgid "273"
msgstr "八支道中胜，四句谛中胜，\n离欲法中胜，具眼两足胜。"

msgid "274"
msgstr "实唯此一道。无余知见净。\n汝等顺此行。魔为之惑乱。"

msgid "275"
msgstr "汝顺此道行，使汝苦灭尽。\n知我所说道，得除去荆棘。"

msgid "276"
msgstr "汝当自努力！如来唯说者。\n随禅定行者，解脱魔系缚。"

msgid "277"
msgstr "「一切行无常」，以慧观照时，\n得厌离于苦，此乃清净道。"

msgid "278"
msgstr "「一切行是苦」，以慧观照时，\n得厌离于苦，此乃清净道。"

msgid "279"
msgstr "「一切法无我」，以慧观照时，\n得厌离于苦，此乃清净道。"

msgid "280"
msgstr "当努力时不努力，年虽少壮陷怠惰，\n意志消沈又懒弱，怠者不以智得道。"

msgid "281"
msgstr "慎语而制意，不以身作恶。\n净此三业道，得圣所示道。"

msgid "282"
msgstr "由瑜伽生智，无瑜伽慧灭。\n了知此二道，及其得与失，\n当自努力行，增长于智慧。"

msgid "283"
msgstr "应伐欲稠林，勿伐于树木。\n从欲林生怖，当脱欲稠林。"

msgid "284"
msgstr "男女欲丝丝，未断心犹系；\n如饮乳犊子，不离于母牛。"

msgid "285"
msgstr "自己断除爱情，如以手折秋莲。\n勤修寂静之道。善逝所说涅槃。"

msgid "286"
msgstr "「雨季我住此，冬夏亦住此」，\n此为愚夫想，而不觉危险。"

msgid "287"
msgstr "溺爱子与畜，其人心惑着，\n死神捉将去，如瀑流睡村。"

msgid "288"
msgstr "父子与亲戚，莫能为救护。\n彼为死所制，非亲族能救。"

msgid "289"
msgstr "了知此义已，智者持戒律，\n通达涅槃路──迅速令清净。"

msgid "chap21"
msgstr "杂品"

msgid "290"
msgstr "若弃于小乐，得见于大乐。\n智者弃小乐，当见于大乐。"

msgid "291"
msgstr "施与他人苦，为求自己乐；\n彼为瞋系缚，怨憎不解脱。"

msgid "292"
msgstr "应作而不作，不应作而作，\n傲慢放逸者，彼之漏增长。"

msgid "293"
msgstr "常精勤观身，不作不应作，\n应作则常作，观者漏灭尽。"

msgid "294"
msgstr "杀爱欲母与慢父，杀剎帝利族二王，\n破王国杀其从臣，趋向无忧婆罗门。"

msgid "295"
msgstr "杀爱欲母与慢父，杀婆罗门族二王，\n杀其虎将第五疑，趋向无忧婆罗门。"

msgid "296"
msgstr "乔达摩弟子，常善自醒觉，\n无论昼与夜，彼常念佛陀。"

msgid "297"
msgstr "乔达摩弟子，常善自醒觉，\n无论昼与夜，彼常念达摩。"

msgid "298"
msgstr "乔达摩弟子，常善自醒觉，\n无论昼与夜，彼常念僧伽。"

msgid "299"
msgstr "乔达摩弟子，常善自醒觉，\n无论昼与夜，彼常念于身。"

msgid "300"
msgstr "乔达摩弟子，常善自醒觉，\n无论昼与夜，常乐不杀生。"

msgid "301"
msgstr "乔达摩弟子，常善自醒觉，\n无论昼与夜，心常乐禅定。"

msgid "302"
msgstr "出家爱乐难，在家生活难，\n非俦共住苦，轮回往来苦。\n故不应往来，随从于痛苦。"

msgid "303"
msgstr "正信而具戒，得誉及财者，\n彼至于何处，处处受尊敬。"

msgid "304"
msgstr "善名扬远方，高显如雪山。\n恶者如夜射，虽近不能见。"

msgid "305"
msgstr "独坐与独卧，独行而不倦，\n彼独自调御，喜乐于林中。"

msgid "chap22"
msgstr "地狱品"

msgid "306"
msgstr "说妄语者堕地狱，或已作言「我无作」。\n此二恶业者死后，他世同受地狱苦。"

msgid "307"
msgstr "多袈裟缠颈，恶行不节制，\n恶人以恶业，终堕于地狱。"

msgid "308"
msgstr "若破戒无制，受人信施食，\n不如吞铁丸──热从火焰出。"

msgid "309"
msgstr "放逸淫人妻，必遭于四事：\n获罪睡不安，诽三地狱四。"

msgid "310"
msgstr "非福并恶趣，恐怖乐甚少，\n国王加重罪，故莫淫他妇。"

msgid "311"
msgstr "不善执孤沙，则伤害其手；\n沙门作邪行，则趣向地狱。"

msgid "312"
msgstr "诸有懈惰行，及染污戒行，\n怀疑修梵行，彼不得大果。"

msgid "313"
msgstr "应作所当作，作之须尽力！\n放荡游行僧，增长于欲尘。"

msgid "314"
msgstr "不作恶业胜，作恶后受苦。\n作诸善业胜，作善不受苦。"

msgid "315"
msgstr "譬如边区城，内外均防护，自护当亦尔。\n剎那莫放逸。剎那疏忽者，入地狱受苦行。"

msgid "316"
msgstr "不应羞而羞，应羞而不羞，\n怀此邪见者，众生趋恶趣。"

msgid "317"
msgstr "不应怖见怖，应怖不见怖，\n怀此邪见者，众生趋恶趣。"

msgid "318"
msgstr "非过思为过，是过见无过，\n怀此邪见者，众生趋恶趣。"

msgid "319"
msgstr "过失知过失，无过知无过，\n怀此正见者，众生趋善趣。"

msgid "chap23"
msgstr "象品"

msgid "320"
msgstr "如象在战阵，堪忍弓箭射，\n我忍谤亦尔。世多破戒者。"

msgid "321"
msgstr "调御象可赴集会，调御象可为王乘。\n若能堪忍于谤言，人中最胜调御者。"

msgid "322"
msgstr "调御之骡为优良，信度骏马为优良，\n憍罗大象亦优良，自调御者更优良。"

msgid "323"
msgstr "实非彼等车乘，得达难到境地，\n若人善自调御，由于调御得达。"

msgid "324"
msgstr "如象名财护，泌液暴难制，\n系缚不入食，惟念于象林。"

msgid "325"
msgstr "乐睡又贪食，转侧唯长眠，\n如猪食无厌，愚者数入胎。"

msgid "326"
msgstr "我此过去心──任意随所欲，随爱好游行。\n我今悉调伏，如象师持Hook，制御泌液象。"

msgid "327"
msgstr "当乐不放逸，善护于自心。\n自救出难处，如象出泥坑。"

msgid "328"
msgstr "若得同行伴──善行富智虑，\n能服诸艰困，欣然共彼行。"

msgid "329"
msgstr "若无同行伴──善行富智虑，\n应如王弃国，如象独行林。"

msgid "330"
msgstr "宁一人独行，不与愚为友。\n独行离欲恶，如象独游林。"

msgid "331"
msgstr "应时得友乐，适时满足乐，\n命终善业乐，离一切苦乐。"

msgid "332"
msgstr "世中敬母乐，敬父亲亦乐。\n世敬沙门乐，敬圣人亦乐。"

msgid "333"
msgstr "至老持戒乐，正信成就乐，\n获得智慧乐，不作诸恶乐。"

msgid "chap24"
msgstr "爱欲品"

msgid "334"
msgstr "若住于放逸，爱增如蔓萝。\n此生又彼生，如猿求林果。"

msgid "335"
msgstr "若于此世界，为卑执爱缚，\n忧苦日增长，如毘罗草生。"

msgid "336"
msgstr "若于此世界，能伏难伏爱，\n忧苦自堕落，如水滴荷叶。"

msgid "337"
msgstr "我今告汝等：集此大大众，\n为求毘罗根，当掘爱欲本。\n莫令魔破汝，如浪摧芦荻。"

msgid "338"
msgstr "如树根未拔，虽剪犹复生。\n爱苗若未除，数数感生苦。"

msgid "339"
msgstr "彼具三十六，爱流甚强力，\n唯爱乐是趋，大水漂邪见。"

msgid "340"
msgstr "爱流到处流，蔓萝随处生。\n既见蔓萝生，当以慧断根。"

msgid "341"
msgstr "世喜悦欲滋润，亦喜驰逐六尘。\n彼虽向乐求乐，但唯得于生灭。"

msgid "342"
msgstr "随逐爱欲人，驰回如网兔。\n缠缚于烦恼，再再长受苦。"

msgid "343"
msgstr "随逐爱欲人，驰回如网兔。\n比丘求无欲，故须自离欲。"

msgid "344"
msgstr "舍欲喜林间，离欲复向欲，\n当观于此人：解缚复向缚。"

msgid "345"
msgstr "铁木麻作者，智说非坚缚。\n迷恋妻子财，是实为坚缚。"

msgid "346"
msgstr "能引堕落者，智说为坚缚。\n彼虽似宽缓，而实难解脱。\n断此无著者，舍欲而出家。"

msgid "347"
msgstr "彼耽于欲随欲流，投自结网如蜘蛛。\n断此缚与无著者，离一切苦而遨游。"

msgid "348"
msgstr "舍过现未来，而渡于彼岸。\n心解脱一切，不再受生老。"

msgid "349"
msgstr "恶想所乱者，求乐欲炽然，\n彼欲倍增长，自作坚牢缚。"

msgid "350"
msgstr "喜离恶想者，常念于不净。\n当除于爱欲，不为魔罗缚。"

msgid "351"
msgstr "达究竟处无畏，离爱欲无垢秽，\n断除生有之箭，此为彼最后身。"

msgid "352"
msgstr "离欲无染者，通达词无碍，\n善知义与法，及字聚次第，\n彼为最后身，大智大丈夫。"

msgid "353"
msgstr "我降伏一切，我了知一切。\n一切法无染，离弃于一切，\n灭欲得解脱，自证谁称师？"

msgid "354"
msgstr "诸施法施胜；诸味法味胜；\n诸喜法喜胜；除爱胜诸苦。"

msgid "355"
msgstr "财富毁灭愚人，决非求彼岸者。\n愚人为财欲害，自害如害他人。"

msgid "356"
msgstr "杂草害田地，贪欲害世人。\n施与离贪者，故得大果报。"

msgid "357"
msgstr "杂草害田地，瞋恚害世人。\n施与离瞋者，故得大果报。"

msgid "358"
msgstr "杂草害田地，愚痴害世人。\n施与离痴者，故得大果报。"

msgid "359"
msgstr "杂草害田地，欲望害世人。\n施与离欲者，故得大果报。"

msgid "chap25"
msgstr "比丘品"

msgid "360"
msgstr "善哉制于眼，善哉制于耳，\n善哉制于鼻，善哉制于舌。"

msgid "361"
msgstr "善哉制于身，善哉制于语，\n善哉制于意，善哉制一切，\n制一切比丘，解脱一切苦。"

msgid "362"
msgstr "调御手足及言语，调御最高之头首，\n心喜于禅住于定，独居知足名比丘。"

msgid "363"
msgstr "比丘调于语，善巧而寂静，\n显示法与义，所说甚和婉。"

msgid "364"
msgstr "住法之乐园，喜法与随法，\n思惟忆念法，比丘不复退。"

msgid "365"
msgstr "莫轻自所得；莫羡他所得。\n比丘羡他得，不证三摩地。"

msgid "366"
msgstr "比丘所得虽少，而不轻嫌所得，\n生活清净不怠，实为诸天称赞。"

msgid "367"
msgstr "若于名与色，不着我我所，\n非有故无忧，彼实称比丘。"

msgid "368"
msgstr "住于慈悲比丘，喜悦佛陀教法，\n到达寂静安乐，诸行解脱境界。"

msgid "369"
msgstr "比丘汲此舟水，水去则舟轻快。\n断除贪欲瞋恚，则得证于涅槃。"

msgid "370"
msgstr "五断及五弃，而五种勤修，\n越五着比丘──名渡瀑流者。"

msgid "371"
msgstr "修定莫放逸，心莫惑于欲！\n莫待吞铁丸，烧然乃苦号！"

msgid "372"
msgstr "无慧者无定，无定者无慧。\n兼具定与慧，彼实近涅槃。"

msgid "373"
msgstr "比丘入屏处，彼之心寂静，\n审观于正法，得受超人乐。"

msgid "374"
msgstr "若人常正念：诸蕴之生灭，\n获得喜与乐，知彼得不死。"

msgid "375"
msgstr "若智慧比丘，于世先作是：\n摄根及知足，护持别解脱。"

msgid "376"
msgstr "态度须诚恳，行为须端正；\n是故彼多乐，得灭尽诸苦。"

msgid "377"
msgstr "如跋悉迦花，枯萎而凋谢，\n汝等诸比丘，弃贪瞋亦尔。"

msgid "378"
msgstr "身静及语静，心寂住三昧，\n舍俗乐比丘，是名寂静者。"

msgid "379"
msgstr "汝当自警策，汝应自反省！\n自护与正念，比丘住安乐。"

msgid "380"
msgstr "自为自保护。自为自依怙。\n汝应自调御，如商调良马。"

msgid "381"
msgstr "比丘具欢喜心，诚信佛陀教法，\n到达寂静安乐，诸行解脱境界。"

msgid "382"
msgstr "比丘虽年少，勤行佛陀教，\n彼辉耀此世，如月出云翳。"

msgid "chap26"
msgstr "婆罗门品"

msgid "383"
msgstr "勇敢断除于欲流，汝当弃欲婆罗门！\n若知于诸行灭尽，汝便知无作涅槃。"

msgid "384"
msgstr "若常住于二法，婆罗门达彼岸；\n所有一切系缚，从彼智者而灭。"

msgid "385"
msgstr "无彼岸此岸，两岸悉皆无，\n离苦无系缚，是谓婆罗门。"

msgid "386"
msgstr "彼人入禅定，安住离尘垢，\n所作皆已办，无诸烦恼漏，\n证最高境界，是谓婆罗门。"

msgid "387"
msgstr "日照昼兮月明夜，剎帝利武装辉耀，\n婆罗门禅定光明，佛陀光普照昼夜。"

msgid "388"
msgstr "弃除恶业者，是名婆罗门。\n行为清净者，则称为沙门，\n自除垢秽者，是名出家人。"

msgid "389"
msgstr "莫打婆罗门！婆罗门莫瞋，\n打彼者可耻，忿发耻更甚！"

msgid "390"
msgstr "婆罗门此非小益──若自喜乐制其心。\n随时断除于害心，是唯得止于苦痛。"

msgid "391"
msgstr "不以身语意，行作诸恶业，\n制此三处者，是谓婆罗门。"

msgid "392"
msgstr "正等觉者所说法，不论从何而得闻，\n于彼说者应敬礼，如婆罗门敬圣火。"

msgid "393"
msgstr "不因髻发与种族，亦非生为婆罗门。\n谁知真实及达摩，彼为幸福婆罗门。"

msgid "394"
msgstr "愚者结发髻，衣羊皮何益？\n内心具欲林，形仪徒严饰！"

msgid "395"
msgstr "诸着粪扫衣，消瘦露经脉，\n林中独入定，是谓婆罗门。"

msgid "396"
msgstr "所谓婆罗门，非从母胎生。\n如执诸烦恼，但名说「菩」者。\n若无一切执，是谓婆罗门。"

msgid "397"
msgstr "断除一切结，彼实无恐怖，\n无着离系缚，是谓婆罗门。"

msgid "398"
msgstr "除皮带与缰，及断绳所属，\n舍障碍觉者，是谓婆罗门。"

msgid "399"
msgstr "能忍骂与打，而无有瞋恨，\n具忍力强军，是谓婆罗门。"

msgid "400"
msgstr "无有瞋怒具德行，持戒不为诸欲润，\n调御得达最后身──我称彼为婆罗门。"

msgid "401"
msgstr "犹如水落于莲叶，如置芥子于针锋，\n不染着于爱欲者──我称彼为婆罗门。"

msgid "402"
msgstr "若人于此世界中，觉悟消灭其自苦，\n放弃重负得解脱──我称彼为婆罗门。"

msgid "403"
msgstr "有甚深智慧，善辨道非道，\n证无上境界，是谓婆罗门。"

msgid "404"
msgstr "不与俗人混，不与僧相杂，\n无家无欲者，是谓婆罗门。"

msgid "405"
msgstr "一切强弱有情中，彼人尽弃于刀杖，\n不自杀不教他杀──我称彼为婆罗门。"

msgid "406"
msgstr "于仇敌中友谊者，执杖人中温和者，\n执着人中无著者──我称彼为婆罗门。"

msgid "407"
msgstr "贪欲瞋恚并慢心，以及虚伪皆脱落，\n犹如芥子落针锋──我称彼为婆罗门。"

msgid "408"
msgstr "不言粗恶语，说益语实语，\n不触怒于人，是谓婆罗门。"

msgid "409"
msgstr "于此善或恶，修短与粗细，\n不与而不取，是谓婆罗门。"

msgid "410"
msgstr "对此世他世，均无有欲望，\n无欲而解脱，是谓婆罗门。"

msgid "411"
msgstr "无有贪欲者，了悟无疑惑，\n证得无生地，是谓婆罗门。"

msgid "412"
msgstr "若于此世间，不着善与恶，\n无忧而清净，是谓婆罗门。"

msgid "413"
msgstr "如月净无瑕，澄静及清明，\n灭于再生欲，是谓婆罗门。"

msgid "414"
msgstr "超越泥泞崎岖道，并踰愚痴轮回海，\n得度彼岸住禅定，无欲而又无疑惑，\n无着证涅槃寂静──我称彼为婆罗门。"

msgid "415"
msgstr "弃舍欲乐于此世，出家而成无家人，\n除灭欲乐生起者──我称彼为婆罗门。"

msgid "416"
msgstr "弃舍爱欲于此世，出家而成无家人，\n除灭爱欲生起者──我称彼为婆罗门。"

msgid "417"
msgstr "远离人间缚，超越天上缚，\n除一切缚者，是谓婆罗门。"

msgid "418"
msgstr "弃舍喜不喜，清凉无烦恼，\n勇者胜世间，是谓婆罗门。"

msgid "419"
msgstr "若遍知一切──有情死与生，\n无执善逝佛，是谓婆罗门。"

msgid "420"
msgstr "诸天干闼婆及人，俱不知彼之所趣，\n烦恼漏尽阿罗汉──我称彼为婆罗门。"

msgid "421"
msgstr "前后与中间，彼无有一物，\n不着一物者，是谓婆罗门。"

msgid "422"
msgstr "牛王最尊勇猛者，大仙无欲胜利者，\n浴己无垢及觉者──我称彼为婆罗门。"

msgid "423"
msgstr "牟尼能知于前生，并见天界及恶趣，\n获得除灭于再生，业已完成无上智，\n一切圆满成就者──我称彼为婆罗门。"
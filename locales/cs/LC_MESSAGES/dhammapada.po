msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "title"
msgstr "Dhammapada"

msgid "chaps"
msgstr "Kapitoly"

msgid "fontsize"
msgstr "Velikost písma"

msgid "chap1"
msgstr "Dvojice"

msgid "1"
msgstr ""
"mysl je předchůdcem stavů,\n"
"mysl je základem, mysl je tvůrcem,\n"
"s myslí znečištěnou [zkaženou]\n"
"kdo hovoří, kdo jedná,\n"
"toho strast následuje\n"
"jako kolo nohu tažného zvířete"

msgid "2"
msgstr ""
"mysl je předchůdcem stavů,\n"
"mysl je základem, mysl je tvůrcem,\n"
"s myslí čistou [povznešenou]\n"
"kdo hovoří, kdo jedná,\n"
"toho štěstí následuje\n"
"jako věrný stín"

msgid "3"
msgstr ""
"„zhanil mě, zbil mě,\n"
"přepadl mě a oloupil mě“ —\n"
"u těch, kdo na tom prodlévají,\n"
"jejich zášť se neutiší"

msgid "4"
msgstr ""
"„zhanil mě, zbil mě,\n"
"přepadl mě a oloupil mě“ —\n"
"u těch, kdo na tom neprodlévají,\n"
"jejich zášť se utiší"

msgid "5"
msgstr ""
"nikoli nenávistí se nenávist\n"
"kdy zde utiší,\n"
"jen beznenávistností se utiší,\n"
"takový je věčný stav věcí [zákon]"

msgid "6"
msgstr ""
"mnozí nevědí,\n"
"že jednou musíme zemřít,\n"
"avšak ti, kdo to vědí,\n"
"utiší své spory"

msgid "7"
msgstr ""
"[tělesnou] krásu nazíraje, kdo prodlévá,\n"
"své smysly nekontroluje,\n"
"v jídle je nemírný,\n"
"líný a ochablý,\n"
"toho zkosí Mára,\n"
"jako vítr slabý strom"

msgid "8"
msgstr ""
"[tělesnou] odpornost nazíraje, kdo prodlévá,\n"
"své smysly dobře kontroluje,\n"
"v jídle je umírněný,\n"
"obdařen důvěrou a energický,\n"
"toho nezkosí Mára,\n"
"jako vítr kamennou skálu"

msgid "9"
msgstr ""
"kdo není zbaven mentálních nečistot a z oranžového roucha\n"
"oděv si oblékne,\n"
"postrádaje sebekontrolu a opravdovost,\n"
"ten si nezasluhuje oranžové roucho"

msgid "10"
msgstr ""
"kdo však, byť není v oranžovém rouchu,\n"
"je ctnostný a dobře soustředěný,\n"
"obdařený sebekontrolou a opravdovostí,\n"
"ten si zasluhuje oranžové roucho"

msgid "11"
msgstr ""
"ti, kdo nepodstatné považují za podstatné\n"
"a podstatné vidí jako nepodstatné,\n"
"ti k podstatě nedojdou,\n"
"zastávajíce oblast špatného myšlení"

msgid "12"
msgstr ""
"ale ti, kdo podstatné jakožto podstatné rozpoznají\n"
"a nepodstatné jakožto nepodstatné,\n"
"ti k podstatě dojdou,\n"
"zastávajíce oblast správného myšlení"

msgid "13"
msgstr ""
"jako do domu špatně pokrytého\n"
"déšť pronikne,\n"
"tak do nerozvinuté mysli\n"
"vášeň pronikne"

msgid "14"
msgstr ""
"jako do domu dobře pokrytého\n"
"déšť nepronikne,\n"
"tak do dobře rozvinuté mysli\n"
"vášeň nepronikne"

msgid "15"
msgstr ""
"v tomto světě se trápí, na onom světě se trápí,\n"
"kdo koná zlo, v obou světech se trápí,\n"
"trápí se a trpí,\n"
"když obzírá své nečisté konání"

msgid "16"
msgstr ""
"v tomto světě se raduje, na onom světě se raduje,\n"
"kdo koná dobro, v obou světech se raduje,\n"
"raduje se a těší se,\n"
"když obzírá své očištěné konání"

msgid "17"
msgstr ""
"v tomto světě je trýzněn, na onom světě je trýzněn,\n"
"kdo koná zlo, v obou světech je trýzněn,\n"
"při pomyšlení: ‘konal jsem zlo’ je trýzněn\n"
"a ještě více je trýzněn, když dojde do strastného stavu bytí"

msgid "18"
msgstr ""
"v tomto světě je potěšen, na onom světě je potěšen,\n"
"kdo koná dobro [zásluhy], v obou světech je potěšen,\n"
"při pomyšlení: ‘konal jsem dobro [zásluhy]’ je potěšen\n"
"a ještě více je potěšen, když dojde do šťastného stavu bytí"

msgid "19"
msgstr ""
"i když mnoho posvátné texty cituje,\n"
"ale nekoná podle toho — nedbalý člověk,\n"
"jako pastýř sčítající krávy, jež patří jiným,\n"
"ten nemá podíl na asketickém životě"

msgid "20"
msgstr ""
"i když málo posvátné texty cituje,\n"
"ale následuje Dhammu a jedná v souladu s Dhammou,\n"
"vášeň a nenávist odvrhl, i zaslepenost,\n"
"jasně chápající, se správně osvobozenou myslí,\n"
"nelpí na tomto ani na onom světě,\n"
"ten ma podíl na asketickém životě"

msgid "chap2"
msgstr "Dbalost"

msgid "21"
msgstr ""
"dbalost je cesta k bezsmrtnosti,\n"
"nedbalost je cesta ke smrti,\n"
"dbalí neumírají,\n"
"ale nedbalci jsou již jakoby mrtví"

msgid "22"
msgstr ""
"tento rozdíl když pochopili,\n"
"dbalí mudrcové,\n"
"dbalostí se těší,\n"
"v oblasti ušlechtilých se radují"

msgid "23"
msgstr ""
"ti v meditačním pohroužení setrvávající,\n"
"stále s vytrvalým úsilím,\n"
"tito mudrci dosáhnou odpoutání,\n"
"nepřekonatelného vyproštění z jha"

msgid "24"
msgstr ""
"kdo je snaživý a má uvědomění,\n"
"čistých činů uvážlivý vykonavatel,\n"
"v kázni a v Dhammě žijící,\n"
"tomuto dbalému sláva narůstá"

msgid "25"
msgstr ""
"snaživostí a dbalostí,\n"
"sebekázní a sebeovládáním\n"
"ostrov si vytvoří moudrý člověk\n"
"jenž žádná záplava nezatopí"

msgid "26"
msgstr ""
"nedbalosti jsou oddaní\n"
"pošetilí a hloupí lidé,\n"
"svoji dbalost však moudrý člověk\n"
"jako své nejlepší bohatství ochraňuje"

msgid "27"
msgstr ""
"neoddávejte se nedbalosti\n"
"ani smyslnému potěšení intimností,\n"
"ten, kdo je dbalý a dlí v meditačním pohroužení\n"
"dosáhne rozsáhlejší blaženosti"

msgid "28"
msgstr ""
"nedbalost dbalostí\n"
"když moudrý člověk vypudí,\n"
"na věž moudrosti vystoupí,\n"
"bez trápení pak na trápící se lidstvo,\n"
"jako z vrcholku hory na zem,\n"
"moudrý na pošetilé shlíží"

msgid "29"
msgstr ""
"dbalý mezi nedbalci,\n"
"mezi ospalci zcela bdělý,\n"
"jako před slabého koně rychlý kůň,\n"
"stejně tak postupuje vpřed moudrý"

msgid "30"
msgstr ""
"dbalostí Maghavá\n"
"mezi bohy prvenství došel,\n"
"dbalost je chválena,\n"
"nedbalost kritizována, vždy"

msgid "31"
msgstr ""
"dbalostí se těšící mnich,\n"
"na nedbalost ve strachu hledící,\n"
"pouta malá i velká\n"
"v sobě spálí, jako požár když postupuje"

msgid "32"
msgstr ""
"dbalostí se těšící mnich,\n"
"na nedbalost ve strachu hledící,\n"
"je neschopen odpadnutí\n"
"a je již v blízkosti odpoutání"

msgid "chap3"
msgstr "Mysl"

msgid "33"
msgstr ""
"těkavou a rozechvělou mysl\n"
"je těžké uhlídat, těžké zvládnout,\n"
"srovná ji však ten, kdo je moudrý,\n"
"tak jako šípař [zbrojíř] hrot"

msgid "34"
msgstr ""
"jako ryba na zem vyvržená,\n"
"ze svého vodního útulku vytažená,\n"
"tak se zmítá tato mysl,\n"
"Márovo panství má-li opustit"

msgid "35"
msgstr ""
"těžko udržitelnou a hbitou\n"
"která podle libosti poletuje :\n"
"tuto mysl zkrotit je dobré,\n"
"zkrocená mysl přináší blaženost"

msgid "36"
msgstr ""
"velmi těžko viditelnou a velmi jemnou\n"
"která podle libosti poletuje :\n"
"tuto mysl hlídat by měl moudrý,\n"
"střežená mysl přináší blaženost"

msgid "37"
msgstr ""
"v dálkách se osaměle toulající\n"
"nehmotnou a v skrytu sídlící :\n"
"tuto mysl kdo ukázní,\n"
"osvobodí se z Márových pout"

msgid "38"
msgstr ""
"kdo nemá ustálenou mysl,\n"
"pravou Dhammu nezná\n"
"a má chatrnou důvěru,\n"
"moudrosti naplnění nedojde"

msgid "39"
msgstr ""
"kdo nemá chtíčem naplněnou mysl\n"
"a nemá útočnou vůli\n"
"kdo dobro i zlo opustil :\n"
"pro toho, bdělého, již není strachu"

msgid "40"
msgstr ""
"jako hliněný džbán že je toto tělo, nahlédnouce,\n"
"jako pevnost tuto mysl opevněte,\n"
"zaútočte na Máru se zbraní moudrosti\n"
"a ochraňujte bez odpočinutí, co kdo dobude"

msgid "41"
msgstr ""
"zakrátko bude toto tělo\n"
"na zemi ležet,\n"
"opuštěné a bez vědomí\n"
"jako neužitečný kus dřeva"

msgid "42"
msgstr ""
"cokoli si nepřátelé mohou navzájem způsobit,\n"
"nebo ti, co se vzájemně nenávidí,\n"
"špatně vedená mysl\n"
"ještě horší věci ti způsobí"

msgid "43"
msgstr ""
"co ti matka ani otec nemohou způsobit,\n"
"ani žádný jiný příbuzný —\n"
"správně vedená mysl\n"
"ještě lepší věci ti způsobí"

msgid "chap4"
msgstr "Květiny"

msgid "44"
msgstr ""
"kdo tuto zemi pronikne\n"
"a tento svět smrti s jeho bohy ?\n"
"kdo tato slova Dhammy dobře vyložená\n"
"jako odborník květinu vycítí ?"

msgid "45"
msgstr ""
"ten, kdo se cvičí, tuto zemi pronikne\n"
"a tento svět smrti s jeho bohy,\n"
"ten, kdo se cvičí, tato slova Dhammy dobře vyložená\n"
"jako odborník květinu vycítí"

msgid "46"
msgstr ""
"jako pěna je toto tělo — nahlédnuv,\n"
"jeho povahu přeludu dokonale pochopiv,\n"
"odetni Márovy květiny [rozkoší]\n"
"a tam, kde tě nespatří král smrti, odejdi"

msgid "47"
msgstr ""
"kdo jen květiny [rozkoší] sbírá,\n"
"člověk s ulpívající myslí,\n"
"jako na spící vesnici velká povodeň,\n"
"tak na něj přijde a uchvátí ho smrt"

msgid "48"
msgstr ""
"kdo jen květiny [rozkoší] sbírá,\n"
"člověk s ulpívající myslí,\n"
"nenasytný ve smyslných požitcích,\n"
"toho se zmocní ukončitel životů"

msgid "49"
msgstr ""
"jako včela z květiny,\n"
"aniž by její barvě a vůni uškodila,\n"
"sesbírá nektar a odletí,\n"
"tak nechť mudrc prochází vesnicí"

msgid "50"
msgstr ""
"ne na ostatních přestupky,\n"
"ne na to, co ostatní vykonali nebo nevykonali,\n"
"ale sám na sebe se ohlížej,\n"
"co jsi vykonal nebo nevykonal"

msgid "51"
msgstr ""
"jako nádherná květina,\n"
"krásně zbarvená, ale bez vůně,\n"
"taková je dobře vyslovená řeč,\n"
"neplodná je pro toho, kdo podle ní nejedná"

msgid "52"
msgstr ""
"jako nádherná květina,\n"
"krásně zbarvená a vonící,\n"
"taková je dobře vyslovená řeč,\n"
"plodná je pro toho, kdo podle ní jedná"

msgid "53"
msgstr ""
"jako z hromady květin\n"
"lze vytvořit věnců mnoho,\n"
"tak ze zrození smrtelníka\n"
"vykonáno by mělo být prospěšného mnoho"

msgid "54"
msgstr ""
"vůně květin nejde proti větru,\n"
"ani vůně santalu, tagary či jasmínu,\n"
"ale vůně dobrých jedinců pronikne i proti větru,\n"
"jejich vůně vane všemi směry"

msgid "55"
msgstr ""
"ať santal, tagara,\n"
"lotos či jasmín,\n"
"mezi těmito vůněmi\n"
"vůně ctnosti je nepřekonatelná"

msgid "56"
msgstr ""
"chabá je tato vůně\n"
"tagary či santalu,\n"
"avšak vůně ctnostných,\n"
"která vane až k bohům, je nejvyšší"

msgid "57"
msgstr ""
"k těm, kdo jsou obdařeni ctností,\n"
"prodlévají v dbalosti\n"
"a jsou osvobozeni správným poznáním,\n"
"Mára nenajde stezku"

msgid "58"
msgstr ""
"jako z hromady smetí\n"
"vyhozené u silnice\n"
"může vyrůst lotos,\n"
"krásně vonící a mysl potěšující,"

msgid "59"
msgstr ""
"tak v davu bytostí,\n"
"zaslepených obyčejných světských lidí,\n"
"vyzařuje moudrost\n"
"žák dokonale Probuzeného"

msgid "chap5"
msgstr "Pošetilý"

msgid "60"
msgstr ""
"dlouhá je bdícímu noc,\n"
"dlouhá je míle znavenému,\n"
"dlouhý je koloběh životů pošetilcům,\n"
"neznalým dobrého učení"

msgid "61"
msgstr ""
"jestliže v životě nenajdeš\n"
"někoho lepšího nebo sobě rovného,\n"
"pak vytrvale žij sám,\n"
"není pro tebe sdružování s pošetilými"

msgid "62"
msgstr ""
"„ach moji synové, ach můj majetek“\n"
"tak se trápí pošetilý,\n"
"jenž ani sám sobě nepatří,\n"
"natož synové, natož majetek"

msgid "63"
msgstr ""
"pošetilý, jenž se považuje za pošetilého,\n"
"moudrým se stane,\n"
"ale pošetilý, který se má za moudrého,\n"
"vpravdě pošetilým je nazýván"

msgid "64"
msgstr ""
"i když po celý život pošetilý\n"
"s moudrým pobývá,\n"
"nepozná Dhammu,\n"
"tak jako lžíce neokusí chuť polévky"

msgid "65"
msgstr ""
"i když pouhý okamžik vnímavý [inteligentní] člověk\n"
"s moudrým pobývá,\n"
"rychle pozná Dhammu,\n"
"tak jako jazyk okouší chuť polévky"

msgid "66"
msgstr ""
"pošetilí a hloupí se chovají\n"
"sami k sobě jako nepřátelé,\n"
"tím, že konají zlé činy,\n"
"které nesou trpké plody"

msgid "67"
msgstr ""
"takový čin nebyl vykonán dobře,\n"
"kterého po vykonání lituješ,\n"
"jehož se slzami v tváři a s nářkem\n"
"následek pak sklízíš"

msgid "68"
msgstr ""
"takový čin byl vykonán dobře,\n"
"kterého po vykonání nelituješ,\n"
"jehož s potěšením a radostí\n"
"následek pak sklízíš"

msgid "69"
msgstr ""
"za med ho může považovat pošetilec,\n"
"zlo, dokud nedozraje,\n"
"když však zlo dozraje,\n"
"pak stihne pošetilce strast"

msgid "70"
msgstr ""
"stéblem trávy měsíc za měsícem\n"
"může pošetilec pojídat své jídlo,\n"
"těch, kdo pochopili Dhammu,\n"
"tím však nedosáhne ani šestnáctinu jejich ceny"

msgid "71"
msgstr ""
"ani vykonaný zlý čin\n"
"se ihned, tak jako mléko, nesrazí,\n"
"ale doutnaje, následuje pošetilce\n"
"jako oheň skrytý v žhavých uhlících"

msgid "72"
msgstr ""
"pouze k vlastnímu neprospěchu\n"
"bude pošetilci popularita [věhlas],\n"
"zničí pošetilci pravé štěstí\n"
"a rozláme mu hlavu"

msgid "73"
msgstr ""
"přeje si nezasloužené postavení,\n"
"přednost mezi mnichy,\n"
"představenství v klášteře\n"
"a pocty od laických rodin"

msgid "74"
msgstr ""
"„nechť si o mě myslí\n"
"hospodáři i ti, co odešli do bezdomoví,\n"
"že toto jsem udělal já sám,\n"
"nechť sám rozhoduji co má být konáno a co ne“ —\n"
"takové jsou pošetilcovy myšlenky [záměry]\n"
"a jeho žádosti a domýšlivost jen vzrůstají"

msgid "75"
msgstr ""
"jiné je získávání materiální opory,\n"
"jiné je to, co vede k odpoutání [vyhasnutí],\n"
"toto pochopiv,\n"
"mnich, který je žákem probuzeného\n"
"by si neměl libovat v poctách\n"
"a zachovávat si od nich odstup"

msgid "chap6"
msgstr "Moudrý"

msgid "76"
msgstr ""
"jako toho, kdo ukazuje poklady\n"
"nahlížej toho, kdo vidouc tvé chyby\n"
"ti je vytkne — moudrý,\n"
"s tímto mudrcem pobývej,\n"
"neboť pro takto pobývajícího\n"
"je to lepší, nikoli horší"

msgid "77"
msgstr ""
"tím, že poučuje, radí\n"
"a od nízkých způsobů odvrací,\n"
"uvědomělým je milý,\n"
"neuvědomělým je nemilý"

msgid "78"
msgstr ""
"nepobývej se špatnými přáteli,\n"
"nepobývej s nízkými lidmi,\n"
"pobývej s dobrými přáteli,\n"
"pobývej se vznešenými lidmi"

msgid "79"
msgstr ""
"kdo je nadšený Dhammou dlí blaženě,\n"
"s povznešenou myslí,\n"
"ušlechtilými hlásanou Dhammou\n"
"vždy je potěšen moudrý"

msgid "80"
msgstr ""
"vodu rozvádějí zavlažovači,\n"
"šípaři obrábějí hroty,\n"
"dřevo obrábějí tesaři,\n"
"sebe ovládají moudří"

msgid "81"
msgstr ""
"jako skála z jednoho kusu\n"
"není otřesena větrem,\n"
"tak hanou či chválou\n"
"nepohnuti jsou moudří"

msgid "82"
msgstr ""
"jako jezero, hluboké,\n"
"zářivě čisté a nezčeřené,\n"
"tak, vyslechnouce Dhammu,\n"
"zářivě čistými se stanou moudří"

msgid "83"
msgstr ""
"kdekoli se nacházejí dobří jedinci, jsou zdrženliví,\n"
"mírní netlachají pro potěšení,\n"
"ať dotčeni štěstím či strastí,\n"
"moudří nedají najevo povznesení či skleslost"

msgid "84"
msgstr ""
"ani kvůli sobě ani kvůli ostatním\n"
"neměl by si člověk přát syna, bohatství či království,\n"
"neměl by si přát získat vlastní prospěch nepravým způsobem,\n"
"tak se stane ctnostným, moudrým a pravdivým"

msgid "85"
msgstr ""
"málo je mezi lidmi\n"
"těch jedinců, kteří překročí na druhý břeh,\n"
"ostatní lidé jen\n"
"sem a tam po tomto [břehu] pobíhají"

msgid "86"
msgstr ""
"ti, kdo správně ukazují\n"
"Dhammu a následují Dhammu,\n"
"tito jedinci překročí\n"
"tuto říši smrti, kterou je těžké překonat"

msgid "87"
msgstr ""
"temné učení když zavrhl\n"
"a rozvíjí jasné — ten, kdo je moudrý\n"
"odešel z domova do bezdomoví\n"
"a dlí v odloučení, z něhož je těžké se radovat"

msgid "88"
msgstr ""
"vyšší radost by si měl přát —\n"
"odvrhnuv smyslné požitky — ten, kdo nic nemá,\n"
"měl by se očistit\n"
"od toho, co znečisťuje mysl — ten, kdo je moudrý"

msgid "89"
msgstr ""
"ti, kdo členy probuzení\n"
"správně ve své mysli rozvinuli,\n"
"těší se ze zanechání,\n"
"z neulpívání se radují,\n"
"oproštěni od zákalů a plni jasu,\n"
"již v tomto světě jsou zcela odpoutáni"

msgid "chap7"
msgstr "Zasloužilý"

msgid "90"
msgstr ""
"u toho, kdo dokončil cestu a je prost trápení,\n"
"osvobozeného ve všech směrech,\n"
"jenž opustil všechna pouta,\n"
"již nelze nalézt horečnatost"

msgid "91"
msgstr ""
"ti, kdo jsou obdařeni energií a uvědoměním\n"
"se neradují ve svých obydlích,\n"
"jako labutě odlétají z jezer,\n"
"tak opouštějí své domovy"

msgid "92"
msgstr ""
"těch, kdo nic nehromadí,\n"
"kdo porozuměli jídlu :\n"
"prázdnota prostá znaků a\n"
"osvobození je jejich pastvou,\n"
"jako ptáků v prostoru\n"
"je jejich cesta nepostižitelná"

msgid "93"
msgstr ""
"těch, jejichž zákaly jsou zcela odstraněny\n"
"a jsou nezávislí na výživě :\n"
"prázdnota prostá znaků a\n"
"osvobození je jejich pastvou,\n"
"jako ptáků v prostoru\n"
"je jejich stopa [cesta] nepostižitelná"

msgid "94"
msgstr ""
"koho smysly došly uklidnění\n"
"jako když vozataj dobře zvládne koně,\n"
"kdo opustil domýšlivost a je bez zákalů,\n"
"takového mají v lásce i bohové"

msgid "95"
msgstr ""
"kdo není vzdorovitý, podobně jako země,\n"
"kdo je kultivovaný a je jako Indův sloup,\n"
"kdo je jako nezkalené jezero,\n"
"pro takového již neexistuje koloběh putování"

msgid "96"
msgstr ""
"mírná je jeho mysl,\n"
"mírná je řeč i činy\n"
"toho, kdo je osvobozen správným poznáním,\n"
"kdo dospěl k míru a je takový"

msgid "97"
msgstr ""
"mimo pouhou důvěru, kdo [sám] poznal nestvořené,\n"
"člověk, který odetnul svá pouta [spojení],\n"
"ukončil své naděje a odvrhl své očekávání,\n"
"ten je nejvyšším jedincem"

msgid "98"
msgstr ""
"ať ve vsi či v lese,\n"
"v údolí či na pláni,\n"
"kdekoliv prodlévají Zasloužilí,\n"
"to jsou místa radosti"

msgid "99"
msgstr ""
"radostné jsou lesy,\n"
"v nichž se běžní lidé neradují,\n"
"ti, kdo jsou prosti vášně se v nich však radují,\n"
"neboť nehledají smyslové požitky"

msgid "chap8"
msgstr "Tisíc"

msgid "100"
msgstr ""
"než tisíc výroků\n"
"z nesmyslných slov sestávajících,\n"
"je jediné smysluplné slovo lepší,\n"
"jehož vyslechnutí je utišující"

msgid "101"
msgstr ""
"než tisíc veršů\n"
"z nesmyslných slov sestávajících,\n"
"je jediné slovo verše lepší,\n"
"jehož vyslechnutí je utišující"

msgid "102"
msgstr ""
"než recitovat sto veršů\n"
"z nesmyslných slov sestávajících,\n"
"je jediné slovo o Dhammě lepší,\n"
"jehož vyslechnutí je utišující"

msgid "103"
msgstr ""
"i kdyby někdo tisíckrát nad tisíci\n"
"muži v bitvě zvítězil,\n"
"jedině ten, kdo zvítězil sám nad sebou\n"
"je v bitvě vítězem nejvyšším"

msgid "104"
msgstr ""
"nad sebou zvítězit je lepší\n"
"než nad jinými bytostmi,\n"
"člověk, jenž zkrotil sám sebe\n"
"se stále chová ukázněně"

msgid "105"
msgstr ""
"žádný bůh ani nebeská bytost\n"
"ani Mára spolu s Brahmou\n"
"ne-přemění v porážku vítězství\n"
"takového člověka"

msgid "106"
msgstr ""
"měsíc po měsíci kdybys tisíc\n"
"obětí přinášel po sto let\n"
"a nebo jednou toho, kdo sám sebe rozvinul\n"
"jen na okamžik uctil,\n"
"toto uctění by bylo lepší\n"
"než oněch sto let obětování"

msgid "107"
msgstr ""
"kdybys sto let života\n"
"[obětní] oheň obcházel v lese\n"
"a nebo jednou toho, kdo sám sebe rozvinul\n"
"jen na okamžik uctil,\n"
"toto uctění by bylo lepší\n"
"než oněch sto let obětování"

msgid "108"
msgstr ""
"cokoliv nabídne či obětuje ve světě\n"
"třeba po celý rok ten, kdo hledá zásluhy přinášením obětí,\n"
"nedojde tím vším ani čtvrtiny [zásluh],\n"
"lepší je prokázat úctu tomu, kdo je na přímé stezce"

msgid "109"
msgstr ""
"kdo pozdrav má ve zvyku\n"
"a stále starší ctí\n"
"čtyři věci u něj vzrůstají :\n"
"dlouhý život, krása, štěstí a síla"

msgid "110"
msgstr ""
"než sto let života\n"
"bez ctnosti a bez soustředění\n"
"je lepší jeden den prožitý\n"
"ctnostně a v meditačním pohroužení"

msgid "111"
msgstr ""
"než sto let života\n"
"bez moudrosti a bez soustředění\n"
"je lepší jeden den prožitý\n"
"moudře a v meditačním pohroužení"

msgid "112"
msgstr ""
"než sto let života\n"
"v lenosti a ochablosti\n"
"je lepší jeden den prožitý\n"
"energicky a upevněně"

msgid "113"
msgstr ""
"než sto let života\n"
"bez vidění vzniku a zániku\n"
"je lepší jeden den prožitý\n"
"s viděním vzniku a zániku"

msgid "114"
msgstr ""
"než sto let života\n"
"bez vidění bezsmrtného stavu\n"
"je lepší jeden den prožitý\n"
"s viděním bezsmrtného stavu"

msgid "115"
msgstr ""
"než sto let života\n"
"bez vidění nejvyšší Dhammy\n"
"je lepší jeden den prožitý\n"
"s viděním nejvyšší Dhammy"

msgid "chap9"
msgstr "Zlo"

msgid "116"
msgstr ""
"neváhej v konání dobra\n"
"a odvracej mysl od zla,\n"
"kdo váhá v konání dobra [zásluh]\n"
"jeho mysl najde zalíbení ve zlu"

msgid "117"
msgstr ""
"vykonal-li člověk zlo,\n"
"nechť ho již nevykonává znovu a znovu,\n"
"nechť nemá vůli ho dále vykonávat,\n"
"neboť nahromadění zla je utrpení"

msgid "118"
msgstr ""
"vykonal-li člověk dobro [zásluhy],\n"
"nechť ho vykonává znovu a znovu,\n"
"nechť má vůli ho dále vykonávat,\n"
"neboť nahromadění dobra [zásluh] je štěstí"

msgid "119"
msgstr ""
"i zlý člověk zakouší dobro\n"
"dokud jeho zlo neuzraje,\n"
"když však jeho zlo uzraje,\n"
"pak zlý člověk zakouší zlo"

msgid "120"
msgstr ""
"I dobrý člověk zakouší zlo\n"
"dokud jeho dobro neuzraje,\n"
"když však jeho dobro uzraje,\n"
"pak dobrý člověk zakouší dobro"

msgid "121"
msgstr ""
"nepodceňujte zlé skutky :\n"
"„nic z toho se mi nevrátí“,\n"
"i kapky vody padající\n"
"vodou džbán naplní,\n"
"tak naplní se pošetilec zlem,\n"
"když trošku po trošce ho nahromadí"

msgid "122"
msgstr ""
"nepodceňujte dobré skutky :\n"
"„nic z toho se mi nevrátí“,\n"
"i kapky vody padající\n"
"vodou džbán naplní,\n"
"tak naplní se moudrý dobrem,\n"
"když trošku po trošce ho nahromadí"

msgid "123"
msgstr ""
"jako [se vyhne] obchodník nebezpečné cestě,\n"
"má-li malou karavanu a velký majetek,\n"
"nebo člověk milující život [se vyhne] jedu,\n"
"tak je třeba vyhýbat se zlu"

msgid "124"
msgstr ""
"když ruka není poraněná,\n"
"může tato ruka nést jed\n"
"a jed do ní nemůže nasáknout a proniknout,\n"
"tak zlo nemůže postihnout toho, kdo ho sám neprovádí"

msgid "125"
msgstr ""
"ublíží-li někdo nezkaženému člověku\n"
"nebo čisté osobě bez poskvrny,\n"
"vrátí se toto zlo pošetilci zpět\n"
"jako jemný prach vržený proti větru"

msgid "126"
msgstr ""
"někteří se znovuzrodí v lůně,\n"
"vykonavatelé zla [se znovuzrodí] v pekle,\n"
"kdo správně postupují půjdou do nebe,\n"
"kdo jsou prosti zákalů dosáhnou úplného odpoutání"

msgid "127"
msgstr ""
"ani v nebeském prostoru, ani uprostřed oceánu,\n"
"ani když člověk odejde do horské jeskyně,\n"
"v oblasti tohoto světa [vesmíru] nenajde\n"
"místo, kde by mohl spočinout a uniknout svým zlým činům"

msgid "128"
msgstr ""
"ani v nebeském prostoru, ani uprostřed oceánu,\n"
"ani když člověk odejde do horské jeskyně,\n"
"v oblasti tohoto světa [vesmíru] nenajde\n"
"místo, kde by mohl spočinout aniž by ho zkosila smrt"

msgid "chap10"
msgstr "Hůl"

msgid "129"
msgstr ""
"všichni se třesou před holí [trestem],\n"
"všichni se bojí smrti,\n"
"přirovnávaje ostatní k sobě,\n"
"nechť nikdo nezabíjí ani k tomu nenavádí"

msgid "130"
msgstr ""
"všichni se třesou před holí [trestem],\n"
"všem je život milý\n"
"přirovnávaje ostatní k sobě,\n"
"nechť nikdo nezabíjí ani k tomu nenavádí"

msgid "131"
msgstr ""
"bytostem toužícím po štěstí\n"
"kdo holí [zbraní] ubližuje,\n"
"sám hledaje štěstí,\n"
"po smrti nezíská štěstí"

msgid "132"
msgstr ""
"bytostem toužícím po štěstí\n"
"kdo holí [zbraní] neubližuje,\n"
"sám hledaje štěstí,\n"
"po smrti získá štěstí"

msgid "133"
msgstr ""
"nehovoř hrubě k nikomu\n"
"nebo ti stejnými slovy odpoví,\n"
"vskutku strastná je vznětlivá řeč,\n"
"tato hůl [zbraň] tě zpětně udeří"

msgid "134"
msgstr ""
"budeš-li sám ztichlý\n"
"jako puklý gong,\n"
"dosáhl jsi odpoutání [vyhasnutí]\n"
"a vznětlivost již u tebe není k nalezení"

msgid "135"
msgstr ""
"jako pastýř holí\n"
"dobytek vyhání na pastvu,\n"
"tak stáří a smrt\n"
"život vyhánějí z živých bytostí"

msgid "136"
msgstr ""
"když vykonává zlé činy,\n"
"pošetilec nechápe co dělá,\n"
"vlastními činy bude hlupák\n"
"trýzněn, jakoby jej pálil oheň"

msgid "137"
msgstr ""
"kdo ozbrojený neozbrojeným\n"
"nezkaženým bytostem ubližuje,\n"
"do některé z těchto deseti situací\n"
"rychle se dostane :"

msgid "138"
msgstr ""
"kruté a zničující pocity,\n"
"tělesné zranění [rozpad],\n"
"těžké onemocnění\n"
"pomatenost mysli ho stihnou,"

msgid "139"
msgstr ""
"potíže u krále,\n"
"strašné pomluvy,\n"
"oddělení od příbuzných\n"
"či pozbytí majetku"

msgid "140"
msgstr ""
"nebo jeho domy\n"
"spálí plameny ohně\n"
"či se po rozpadu těla takový nemoudrý člověk\n"
"znovuzrodí v pekle"

msgid "141"
msgstr ""
"ani nahota, ani spletené vlasy, ani bláto,\n"
"ani odmítání jídla, ani spaní na holé zemi,\n"
"ani prach a špína, ani dřepění na patách\n"
"ne-očistí smrtelníka, který nepřekonal své pochybnosti"

msgid "142"
msgstr ""
"kdo se třeba obléká zdobně, avšak má klidné chování,\n"
"je mírný, zkrocený, má jistotu, vede čistý [svatý] život\n"
"a vůči všem živým bytostem odložil hůl [zbraň],\n"
"ten je vskutku bráhmanem, asketou, mnichem"

msgid "143"
msgstr ""
"člověk ovládaný studem špatně jednat —\n"
"kdo takový je k nalezení ve světě,\n"
"kdo chápe, co je to hanba,\n"
"[kdo je] jako ušlechtilý kůň [ovládaný] bičem ?"

msgid "144"
msgstr ""
"jako ušlechtilý kůň popohnaný bičem\n"
"buďte horliví a obdaření pocitem naléhavosti,\n"
"důvěrou, ctností a energií,\n"
"soustředěním a zkoumáním Dhammy,\n"
"obdařeni věděním, správným jednáním a uvědoměním\n"
"opusťte toto nemalé utrpení"

msgid "145"
msgstr ""
"vodu rozvádějí zavlažovači\n"
"šípaři obrábějí ostří\n"
"dřevo obrábějí tesaři\n"
"sami sebe ovládají [krotí] ti, kdo jednají správně"

msgid "chap11"
msgstr "Stáří"

msgid "146"
msgstr ""
"jak se lze smát, jak se lze radovat,\n"
"když toto vše je stále v plamenech,\n"
"temnotou obklopeni\n"
"nebudete hledat světlo ?"

msgid "147"
msgstr ""
"pohleď na tuto myslí vytvořenou loutku,\n"
"navršenou hromadu neduhů\n"
"a nemocí, naplněnou myšlenkami,\n"
"v níž není nic trvalého a stálého"

msgid "148"
msgstr ""
"zkáze podléhá toto tělo,\n"
"křehké hnízdo nemocí,\n"
"rozpadá se v hnijící změť,\n"
"když smrt ukončí jeho život"

msgid "149"
msgstr ""
"[zbudou-li] jen tyto rozházené,\n"
"jako seschlé tykve\n"
"vybělené kosti,\n"
"lze se při takovém pohledu radovat [ze života] ?"

msgid "150"
msgstr ""
"z kostí je toto město postavené,\n"
"masem a krví omítnuté,\n"
"v něm stáří a smrt,\n"
"domýšlivost a pohrdavost jsou ukryté"

msgid "151"
msgstr ""
"zestárnou i královy pestře zbarvené vozy,\n"
"rovněž toto tělo dochází stárnutí,\n"
"jen dobrá Dhamma stárnutí nedochází\n"
"a mírní [ctnostní] ji dávají poznat dobrým lidem"

msgid "152"
msgstr ""
"[v Dhammě] nepoučený člověk\n"
"stárne jako vůl,\n"
"přibývá mu masa,\n"
"ale moudrosti mu nepřibývá"

msgid "153"
msgstr ""
"nejedním zrozením v tomto koloběhu životů\n"
"prošel jsem, nenalézaje,\n"
"stavitele tohoto domu hledaje,\n"
"strastné je zrozování opětovné"

msgid "154"
msgstr ""
"staviteli domu, nyní však jsi spatřen,\n"
"znovu dům již nepostavíš,\n"
"všechny krokve jsou zlámané,\n"
"hřeben domu je roztříštěn,\n"
"do nezformovaného stavu vstoupila mysl,\n"
"toužení dospělo k ukončení"

msgid "155"
msgstr ""
"ti, kdo nežili čistým [svatým] životem\n"
"a nezískali v mládí duchovní bohatství,\n"
"chřadnou jako stará volavka\n"
"u jezera bez ryb"

msgid "156"
msgstr ""
"ti, kdo nežili čistým [svatým] životem\n"
"a nezískali v mládí duchovní bohatství,\n"
"leží jako zlomené luky\n"
"a oplakávají staré časy"

msgid "chap12"
msgstr "O Sobě"

msgid "157"
msgstr ""
"kdo je sám sobě milý,\n"
"nechť se opatruje, dobře opatruje,\n"
"ve všech třech obdobích života\n"
"nechť nad sebou bdí ten, kdo je moudrý"

msgid "158"
msgstr ""
"nejprve sám sebe\n"
"ať ustaví v tom, co je správné,\n"
"pak teprve nechť poučuje druhé,\n"
"nechť se [porušováním toho] nepošpiňuje ten, kdo je moudrý"

msgid "159"
msgstr ""
"kdo sám v sobě vyvinul to,\n"
"v čem poučuje druhé,\n"
"ten je vskutku dobře zkrocený a zvládnutý,\n"
"neboť sám sebe je vpravdě obtížné zvládnout"

msgid "160"
msgstr ""
"každý je vskutku sám sobě ochráncem,\n"
"kdo jiný by mu mohl být ochráncem ?\n"
"kdo sám sebe dobře zkrotí,\n"
"získává onu ochranu, jež je těžko získatelná"

msgid "161"
msgstr ""
"zlo vykonané jím samým,\n"
"zrozené z něj samého, vzešlé z něj samého,\n"
"rozdrtí hloupého člověka,\n"
"tak jako diamant [rozdrtí] drahokam"

msgid "162"
msgstr ""
"ten, kdo je nadmíru nectnostný,\n"
"jako když popínavá rostlina dusí sálový strom,\n"
"tak se chová sám k sobě,\n"
"jak by mu to přál jen jeho nepřítel"

msgid "163"
msgstr ""
"je snadné konat věci nedobré\n"
"a sobě samému neprospěšné,\n"
"ale co je vpravdě prospěšné a dobré,\n"
"to je vpravdě nanejvýš obtížné konat"

msgid "164"
msgstr ""
"když učením zasloužilých,\n"
"ušlechtilých jedinců, kteří žijí podle Dhammy,\n"
"hloupý člověk pohrdá,\n"
"opíraje se o zlé názory,\n"
"tak jako plody bambusu,\n"
"přinese mu to plody sebezničení"

msgid "165"
msgstr ""
"kdo sám koná zlo,\n"
"sám sebe znečišťuje,\n"
"kdo sám nekoná zlo,\n"
"sám sebe očišťuje,\n"
"čistým nebo nečistým se každý sám učiní,\n"
"nikdo někoho jiného očistit ne-může"

msgid "166"
msgstr ""
"svůj vlastní cíl kvůli cílům druhých,\n"
"jakkoli velkým, neztrácej,\n"
"kdo přímo poznal svůj vlastní cíl,\n"
"nechť se zaměří právě na něj"

msgid "chap13"
msgstr "Svět"

msgid "167"
msgstr ""
"nepraktikuj nízké věci,\n"
"nežij nedbale,\n"
"nepraktikuj špatné názory\n"
"a nerozvíjej světskost"

msgid "168"
msgstr ""
"vzchop se a buď dbalý,\n"
"žij správně podle Dhammy,\n"
"kdo žije podle Dhammy spočívá šťastně,\n"
"na tomto i na onom světě"

msgid "169"
msgstr ""
"žij správně podle Dhammy,\n"
"nežij nesprávně,\n"
"kdo žije podle Dhammy spočívá šťastně,\n"
"na tomto i na onom světě"

msgid "170"
msgstr ""
"nazírej ho jako bublinu,\n"
"nazírej ho jako přelud,\n"
"kdo takto nahlíží tento svět,\n"
"toho král smrti nespatří"

msgid "171"
msgstr ""
"pojď a pohleď na tento svět,\n"
"ozdobený jako královský kočár,\n"
"kde pošetilí jsou ponořeni,\n"
"nejsou upoutáni vědoucí"

msgid "172"
msgstr ""
"kdo byl dříve nedbalý,\n"
"ale později se stal dbalým,\n"
"ozáří tento svět\n"
"jako z mraků vynořivší se měsíc"

msgid "173"
msgstr ""
"kdo konal zlé činy,\n"
"ale pak prospěšnými je odčinil,\n"
"ozáří tento svět\n"
"jako z mraků vynořivší se měsíc"

msgid "174"
msgstr ""
"oslepený je tento svět,\n"
"jen málokdo je tu jasně vidoucí,\n"
"jako pták, jenž se vyprostil ze sítě,\n"
"málokdo do nebeských světů odejde"

msgid "175"
msgstr ""
"labutě létají cestou za sluncem,\n"
"ti, kdo mají magické síly létají prostorem,\n"
"moudří však odlétají z tohoto světa,\n"
"když přemohli Máru s jeho armádou"

msgid "176"
msgstr ""
"této jedné věci nechávaje průchod,\n"
"člověk, který vědomě lže,\n"
"nedbaje onoho světa [po smrti],\n"
"není pro něj zla, které by nevykonal"

msgid "177"
msgstr ""
"lakomci se do světa bohů ne-dostanou,\n"
"jelikož tito pošetilci neoceňují štědrost,\n"
"moudří se však ze štědrosti radují,\n"
"a tak budou šťastní na onom světě [po smrti]"

msgid "178"
msgstr ""
"než svrchovaně vládnout celé Zemi,\n"
"než vstoupit do nebeského světa,\n"
"než panovat celému světu [vesmíru],\n"
"plody vstupu do proudu [Dhammy] jsou lepší [větší]"

msgid "chap14"
msgstr "Probuzený"

msgid "179"
msgstr ""
"jeho vítězství nemůže být překonáno,\n"
"jeho vítězství nemůže obsáhnout nikdo ve světě,\n"
"Probuzeného pastvou je nekonečnost,\n"
"jakým způsobem bys ho mohl svést z cesty ?"

msgid "180"
msgstr ""
"jeho lepivá spleť\n"
"toužení již nikdy nemůže svést,\n"
"Probuzeného pastvou je nekonečnost,\n"
"jakým způsobem bys ho mohl svést z cesty ?"

msgid "181"
msgstr ""
"moudří, kteří se věnují meditačnímu pohroužení\n"
"a těší se z klidu odříkání,\n"
"i bohům jsou drazí,\n"
"zcela probuzení a uvědomělí"

msgid "182"
msgstr ""
"těžko lze získat lidské zrození,\n"
"těžký je život smrtelníků,\n"
"těžké je [mít možnost] vyslechnout pravou Dhammu,\n"
"těžko je [možné zažít] vyvstání Probuzených"

msgid "183"
msgstr ""
"nekonání žádného zla,\n"
"provádění toho, co je prospěšné,\n"
"očišťování své mysli,\n"
"to je učení Probuzených"

msgid "184"
msgstr ""
"vytrvalá trpělivost je nejvyšší askezí,\n"
"odpoutání je to nejvyšší, říkají Probuzení,\n"
"není poutníkem ten, kdo škodí druhým,\n"
"není asketou ten, kdo ubližuje druhým"

msgid "185"
msgstr ""
"nemluvit urážlivě a neškodit,\n"
"ovládat se podle pravidel cvičení,\n"
"být střídmý v jídle,\n"
"prodlévat v samotě\n"
"a oddávat se vyšší mysli,\n"
"to je učení Probuzených"

msgid "186"
msgstr ""
"ani deštěm zlaťáků\n"
"ne-lze dosáhnout ukojení smyslových požitků,\n"
"neradostné a strastné jsou smyslové požitky,\n"
"to poznal moudrý"

msgid "187"
msgstr ""
"ani v nebeských smyslových požitcích\n"
"potěšení nenalézá\n"
"ten, jehož potěšením je odstranění toužení :\n"
"žák dokonale Probuzeného"

msgid "188"
msgstr ""
"mnozí útočiště hledají\n"
"v horách či v lesích,\n"
"v zahradách či stromových svatyních :\n"
"lidé strachem vyděšení"

msgid "189"
msgstr ""
"to však nejsou útočiště bezpečná,\n"
"to nejsou útočiště nejvyšší,\n"
"ne ten, kdo k těmto útočištím jde,\n"
"od veškeré strasti se osvobodí"

msgid "190"
msgstr ""
"kdo však k Buddhovi, k Dhammě\n"
"a k Sangze jako ke svému útočišti jde\n"
"a čtyři ušlechtilé pravdy\n"
"se správným porozuměním vidí :"

msgid "191"
msgstr ""
"strast, vznikání strasti,\n"
"strasti překonání\n"
"a ušlechtilou osmičlennou stezku\n"
"k utišení strasti vedoucí :"

msgid "192"
msgstr ""
"to jsou útočiště bezpečná,\n"
"to jsou útočiště nejvyšší,\n"
"kdo k těmto útočištím jde,\n"
"od veškeré strasti se osvobodí"

msgid "193"
msgstr ""
"je obtížné nalézt jedince obdařeného poznáním,\n"
"neboť se všude nerodí,\n"
"kde se takový mudrc zrodí,\n"
"té rodině se šťastně daří"

msgid "194"
msgstr ""
"šťastné je vyvstání Probuzených,\n"
"šťastné je vykládání pravé Dhammy,\n"
"šťastný je soulad Sanghy,\n"
"šťastná je askeze těch, kdo jsou v souladu"

msgid "195"
msgstr ""
"uctí-li někdo ty, kdo jsou úcty hodní,\n"
"Probuzené nebo jejich žáky,\n"
"kteří překonali mentální rozbujelost\n"
"a překročili trápení a naříkání,"

msgid "196"
msgstr ""
"uctí-li ty, kdo jsou takoví,\n"
"odpoutaní a oproštění od strachu,\n"
"je nemožné spočítat jeho zásluhy,\n"
"které jsou nezměrné"

msgid "chap15"
msgstr "Štěstí"

msgid "197"
msgstr ""
"velmi šťastně žijeme\n"
"mezi nenávistnými bez nenávisti [zášti],\n"
"mezi nenávistnými lidmi\n"
"prodléváme bez nenávisti"

msgid "198"
msgstr ""
"velmi šťastně žijeme\n"
"mezi nemocnými bez nemocí,\n"
"mezi nemocnými lidmi\n"
"prodléváme bez nemocí"

msgid "199"
msgstr ""
"velmi šťastně žijeme\n"
"mezi vzrušenými nevzrušeně,\n"
"mezi vzrušenými lidmi\n"
"prodléváme nevzrušeně"

msgid "200"
msgstr ""
"velmi šťastně žijeme\n"
"my, kdo nic nemáme,\n"
"budeme se živit radostným nadšením\n"
"jako Zářící bohové"

msgid "201"
msgstr ""
"vítězství plodí nenávist [zášť],\n"
"poražený žije strastně,\n"
"ten, kdo dosáhl míru, žije šťastně,\n"
"neboť odložil stranou vítězství i porážku"

msgid "202"
msgstr ""
"není ohně, jež by se vyrovnal vášni,\n"
"není hříchu, jež by se vyrovnal nenávisti,\n"
"není utrpení, jež by se vyrovnalo osobnostním skupinám,\n"
"není většího štěstí než je stav míru"

msgid "203"
msgstr ""
"nenasytnost je největší nemocí,\n"
"formace jsou největším utrpením,\n"
"pro toho, kdo toto poznal v souladu se skutečností,\n"
"je odpoutání [vyhasnutí] největším štěstím"

msgid "204"
msgstr ""
"[mentální] zdraví je největším ziskem,\n"
"spokojenost je největším bohatstvím,\n"
"důvěra [v Učení] je největším přítelem,\n"
"odpoutání [vyhasnutí] je největším štěstím"

msgid "205"
msgstr ""
"kdo okusil chuť samoty\n"
"a chuť klidu,\n"
"oproštěn od bídy a zla,\n"
"zakouší chuť nadšení z Dhammy"

msgid "206"
msgstr ""
"je dobré vídat ušlechtilé,\n"
"pobývání s nimi je vždy šťastné,\n"
"kdo nemusí vídat pošetilé,\n"
"může být stále šťastný"

msgid "207"
msgstr ""
"kdo s pošetilci se stýká,\n"
"dlouhou dobu se trápí,\n"
"strastná je pošetilců společnost\n"
"jako nepřátelů — vždy,\n"
"moudrých však šťastná je společnost\n"
"jako s příbuznými setkání"

msgid "208"
msgstr ""
"proto [následujte] moudrého, rozumného a dobře poučeného,\n"
"vytrvalého v ctnosti a ušlechtilého, dbalého svých povinností,\n"
"takového moudrého člověka\n"
"následujte, jako měsíc svou dráhu skrze souhvězdí"

msgid "chap16"
msgstr "O Tom, co je Milé"

msgid "209"
msgstr ""
"kdo se oddává věcem, kterým by se neměl oddávat\n"
"a neoddává se věcem, kterým by se měl oddávat,\n"
"kdo opustí pravý cíl kvůli tomu, co je mu milé,\n"
"bude závidět těm, kdo se oddávají svému cíli"

msgid "210"
msgstr ""
"nespojuj se s tím, co je milé\n"
"ani s tím, co je nemilé,\n"
"je utrpení nevidět to, co je milé\n"
"a vidět to, co je nemilé"

msgid "211"
msgstr ""
"proto nechovej nic jako milé,\n"
"neboť je zlé ztratit něco milého,\n"
"u toho již pouta nejsou k nalezení,\n"
"komu není nic milé ani nemilé"

msgid "212"
msgstr ""
"z toho, co je milé se rodí trápení,\n"
"z toho, co je milé se rodí strach,\n"
"kdo se oprostil od toho, co je milé,\n"
"pro toho není trápení, natož strachu"

msgid "213"
msgstr ""
"z toho, co je drahé se rodí trápení,\n"
"z toho, co je drahé se rodí strach,\n"
"kdo se oprostil od toho, co je drahé,\n"
"pro toho není trápení, natož strachu"

msgid "214"
msgstr ""
"z potěšení se rodí trápení,\n"
"z potěšení se rodí strach,\n"
"kdo se oprostil od potěšení,\n"
"pro toho není trápení, natož strachu"

msgid "215"
msgstr ""
"ze smyslových požitků se rodí trápení,\n"
"ze smyslových požitků se rodí strach,\n"
"kdo se oprostil od smyslových požitků,\n"
"pro toho není trápení, natož strachu"

msgid "216"
msgstr ""
"z toužení se rodí trápení,\n"
"z toužení se rodí strach,\n"
"kdo se oprostil od toužení,\n"
"pro toho není trápení, natož strachu"

msgid "217"
msgstr ""
"kdo je obdařen ctností a viděním,\n"
"je spravedlivý a zná pravdu,\n"
"kdo splnil svůj úkol,\n"
"ten je lidem milý"

msgid "218"
msgstr ""
"v kom se zrodila touha po tom, co nelze popsat\n"
"a dotkl se toho svou myslí,\n"
"koho mysl není spoutána smyslovými požitky,\n"
"o tom se říká, že pluje proti proudu"

msgid "219"
msgstr ""
"když se člověk po dlouhé nepřítomnosti\n"
"šťastně vrátí z daleka domů,\n"
"jeho příbuzní, přátelé a druhové\n"
"se radují z jeho návratu"

msgid "220"
msgstr ""
"podobně toho, kdo konal záslužné skutky,\n"
"když odejde z tohoto světa na onen svět,\n"
"záslužné skutky ho uvítají,\n"
"jako milého příbuzného, jenž se vrátil domů"

msgid "chap17"
msgstr "Hněv"

msgid "221"
msgstr ""
"zanech hněvu, úplně opusť domýšlivost,\n"
"a překonej všechna pouta,\n"
"kdo nelpí na jménu-a-hmotě,\n"
"toho nepostihne žádná strast"

msgid "222"
msgstr ""
"kdo vzmáhající se hněv\n"
"jako odbržděný povoz zastaví,\n"
"toho nazývám vozatajem,\n"
"ostatní jen drží otěže"

msgid "223"
msgstr ""
"bezhněvností překonej hněv,\n"
"nedobré dobrotou překonej,\n"
"překonej lakomce štědrostí\n"
"a pravdou lháře"

msgid "224"
msgstr ""
"mluv pravdu a nepodlehni zlobě,\n"
"požádán daruj i z mála,\n"
"skrze tyto tři věci\n"
"dojdeš do společnosti bohů"

msgid "225"
msgstr ""
"mudrci, kteří zanechali ubližování\n"
"a stále ovládají své tělo,\n"
"dosáhnou neochvějného stavu,\n"
"kde dojdou oproštění od trápení"

msgid "226"
msgstr ""
"ti, kdo jsou vždy bdělí\n"
"a cvičí se dnem i nocí,\n"
"zaměřeni k odpoutání,\n"
"dojdou k ukončení zákalů"

msgid "227"
msgstr ""
"i v dávných dobách, Atulo,\n"
"nejen dnes,\n"
"byli haněni ti, kdo nemluví,\n"
"byli haněni ti, kdo mluví mnoho\n"
"i ti, kdo mluví přiměřeně byli haněni,\n"
"není ve světě ten, kdo není haněn"

msgid "228"
msgstr ""
"nebyl a nebude\n"
"ani nyní není k nalezení\n"
"ten, kdo by byl pouze haněn\n"
"nebo pouze chválen"

msgid "229"
msgstr ""
"ale ti, kdo jsou inteligentní pochválí toho,\n"
"u koho den za dnem pozorují,\n"
"že jeho jednání je bez poskvrny a je moudrý,\n"
"obdařený porozuměním, ctností a soustředěním"

msgid "230"
msgstr ""
"kdo je jako zlatý šperk,\n"
"jak by si mohl zasloužit hanu,\n"
"i bohové ho chválí,\n"
"ba i Brahmou je chválen"

msgid "231"
msgstr ""
"chraň se tělesného jednání v hněvu,\n"
"buď vládcem svého těla,\n"
"zanech špatného jednání tělem\n"
"a praktikuj správné jednání tělem"

msgid "232"
msgstr ""
"chraň se mluvení v hněvu,\n"
"buď vládcem své řeči,\n"
"zanech špatného jednání řečí\n"
"a praktikuj správné jednání řečí"

msgid "233"
msgstr ""
"chraň se myšlení v hněvu,\n"
"buď vládcem svého myšlení,\n"
"zanech špatného jednání myslí\n"
"a praktikuj správné jednání myslí"

msgid "234"
msgstr ""
"mudrci, kteří ovládají své tělo,\n"
"kteří ovládají svou řeč,\n"
"mudrci, kteří ovládají svou mysl,\n"
"ti se zcela a dokonale ovládají"

msgid "chap18"
msgstr "Poskvrna"

msgid "235"
msgstr ""
"jsi nyní jako zežloutlý list,\n"
"poslové smrti tě již očekávají,\n"
"stojíš u výchozí brány\n"
"a nemáš nic co by sis vzal na cestu"

msgid "236"
msgstr ""
"proto si v sobě vytvoř ostrov\n"
"a rychle usiluj aby ses stal moudrým,\n"
"zbavíš-li se poskvrn a nečistot,\n"
"přijdeš do nebeské říše ušlechtilých"

msgid "237"
msgstr ""
"jsi nyní u konce života,\n"
"dospěl jsi do blízkosti smrti,\n"
"není už pro tebe spočinutí\n"
"a nemáš nic co by sis vzal na cestu"

msgid "238"
msgstr ""
"proto si v sobě vytvoř ostrov\n"
"a rychle usiluj aby ses stal moudrým,\n"
"zbavíš-li se poskvrn a nečistot,\n"
"nepůjdeš znovu vstříc zrození a stárnutí"

msgid "239"
msgstr ""
"nechť se moudrý postupně,\n"
"trošku po trošce, kousek po kousku\n"
"tak jako zlatník stříbro,\n"
"zbavuje poskvrn"

msgid "240"
msgstr ""
"jako rezavá skvrna vzniklá ze železa,\n"
"sama toto železo stravuje,\n"
"tak toho, kdo žije zhýrale\n"
"jeho vlastní činy přivedou do bědných stavů"

msgid "241"
msgstr ""
"nerecitování je poskvrnou ústní tradice,\n"
"netečnost je poskvrnou domácnosti,\n"
"poskvrnou krásy je lenost,\n"
"nedbalost je poskvrnou ochránce"

msgid "242"
msgstr ""
"ženu poskvrňuje špatné chování,\n"
"chamtivost je poskvrnou dárce,\n"
"zlé věci jsou poskvrnou\n"
"na tomto i na onom světě"

msgid "243"
msgstr ""
"avšak je ještě větší poskvrna než tyto poskvrny,\n"
"nevědomost je největší poskvrnou,\n"
"této poskvrny se zbavte\n"
"a budete bez poskvrny, mniši"

msgid "244"
msgstr ""
"snadný život má nestoudník,\n"
"který je chytrý jako vrána, pomlouvá druhé,\n"
"je úskočný a drzý [nadutý]\n"
"a jeho živobytí je pošpiněné"

msgid "245"
msgstr ""
"ten, kdo zná stud má však těžký život,\n"
"kdo stále hledá jen čistotu,\n"
"není líný ani drzý [nadutý],\n"
"jeho živobytí je čisté a je prozíravý"

msgid "246"
msgstr ""
"když zabíjí živé bytosti,\n"
"mluví lži,\n"
"bere ve světě to, co mu nebylo darováno,\n"
"chodí za ženou druhého"

msgid "247"
msgstr ""
"a požívání opojných nápojů\n"
"když se člověk oddává,\n"
"již zde, v tomto světě, si\n"
"vykopává svůj vlastní kořen"

msgid "248"
msgstr ""
"toto milý člověče poznej :\n"
"zlé stavy postihnou neukázněného,\n"
"proto nedopusť aby tě chtivost a špatnost\n"
"na dlouhou dobu stáhly do utrpení"

msgid "249"
msgstr ""
"podle své víry dávají\n"
"lidé, podle své důvěry,\n"
"kdo by se zde rmoutil\n"
"kvůli jídlu a pití, jež dostali ostatní,\n"
"ani ve dne, ani v noci,\n"
"soustředění ne-dosáhne"

msgid "250"
msgstr ""
"kdo však takové [myšlenky] vymýtil,\n"
"vykořenil a zcela zavrhl,\n"
"ať ve dne či v noci,\n"
"soustředění dosáhne"

msgid "251"
msgstr ""
"není ohně, jež by se vyrovnal vášni,\n"
"není posedlosti, jež by se vyrovnala nenávisti,\n"
"není sítě [pasti], jež by se vyrovnala zaslepenosti,\n"
"není proudu, jež by se vyrovnal toužení"

msgid "252"
msgstr ""
"snadné je vidět chyby druhých,\n"
"vlastní však těžké je vidět,\n"
"druhých chyby jsou\n"
"probírány jako plevy,\n"
"vlastní však skrývány,\n"
"jako svůj hřích zapírá podvodník"

msgid "253"
msgstr ""
"kdo vidí jen chyby druhých\n"
"a neustále vnímá jejich provinění,\n"
"u toho zákaly jen narůstají,\n"
"je vzdálen odstranění zákalů"

msgid "254"
msgstr ""
"[pravá] cesta není v prostoru,\n"
"[pravý] asketa není vně [nejeví se navenek],\n"
"lidé si libují v mentální rozbujelosti,\n"
"Tathágatové jsou však prosti mentální rozbujelosti"

msgid "255"
msgstr ""
"[pravá] cesta není v prostoru,\n"
"[pravý] asketa není vně [nejeví se navenek],\n"
"[mentální] formace nejsou věčné,\n"
"v Probuzených není rozrušenost"

msgid "chap19"
msgstr "Spravedlnost"

msgid "256"
msgstr ""
"není spravedlivý ten,\n"
"kdo správnost neuváženě posuzuje,\n"
"co je správné a co je nesprávné —\n"
"obojí by měl moudrý rozvážit"

msgid "257"
msgstr ""
"kdo uváženě, podle Dhammy\n"
"a nestranně vede druhé,\n"
"ten je ochráncem Dhammy a [pravým] mudrcem,\n"
"ten je nazýván „spravedlivý“"

msgid "258"
msgstr ""
"není moudrým ten,\n"
"kdo toho mnoho namluví,\n"
"kdo zajišťuje bezpečí, kdo je prost zášti a prost strachu,\n"
"ten je nazýván „moudrý“"

msgid "259"
msgstr ""
"není držitelem Dhammy ten,\n"
"kdo toho mnoho namluví,\n"
"kdo však třeba jen málo vyslechl,\n"
"Dhammu však svým tělem uzřel,\n"
"ten je držitelem Dhammy,\n"
"ten není nedbalý Dhammy"

msgid "260"
msgstr ""
"není Thérou [Starším] ten,\n"
"kdo má jen zšedlé vlasy na hlavě,\n"
"někdo může být pokročilého věku,\n"
"a [přesto] je nazýván „starý hlupák“"

msgid "261"
msgstr ""
"kdo je však naplněn pravdou a Dhammou,\n"
"je nenásilný, ukázněný a zkrocený,\n"
"ten je mudrcem bez poskvrny,\n"
"ten je nazýván „Théra“"

msgid "262"
msgstr ""
"ani ozdobná mluva,\n"
"ani půvabný vzhled\n"
"ne-dělají dobrého člověka,\n"
"je-li závistivý, chamtivý a falešný"

msgid "263"
msgstr ""
"kdo však takové [vlastnosti] vymýtil,\n"
"vykořenil a zcela zavrhl,\n"
"ten je mudrcem, jenž zanechal nenávisti,\n"
"ten je nazýván „dobrý člověk“"

msgid "264"
msgstr ""
"kdo má jen oholenou hlavu není asketou,\n"
"nedbá-li etických zásad a mluví falešně,\n"
"kdo je obdařen žádostmi a chtivostí,\n"
"jak by mohl být asketou ?"

msgid "265"
msgstr ""
"kdo však v sobě utišil zlé vlastnosti,\n"
"ať malé či velké, všechny\n"
"zlé vlastnosti kdo utišil,\n"
"ten je nazýván „asketa“"

msgid "266"
msgstr ""
"není mnichem ten,\n"
"kdo jen žije z almužních darů ostatních,\n"
"kdo praktikuje odporné věci,\n"
"ten vůbec není mnichem"

msgid "267"
msgstr ""
"kdo se však nad dobro i zlo\n"
"povznesl čistým životem\n"
"a kráčí světem s rozvahou,\n"
"ten je nazýván „mnich“"

msgid "268"
msgstr ""
"ten, kdo jen mlčí není mudrcem\n"
"je-li pošetilý a nevědoucí,\n"
"kdo však jako na vahách považuje\n"
"a vybírá to nejlepší, ten je moudrý"

msgid "269"
msgstr ""
"kdo se vyvaruje zlých činů,\n"
"ten je mudrcem, proto je mudrcem,\n"
"kdo zná oba světy,\n"
"ten je nazýván „mudrc“"

msgid "270"
msgstr ""
"není ušlechtilým ten,\n"
"kdo živým bytostem ubližuje,\n"
"kdo neubližuje žádným živým bytostem,\n"
"ten je nazýván „ušlechtilý“"

msgid "271"
msgstr ""
"ne[mysli si], že když jsi dbal etických zásad\n"
"a mnoho studoval\n"
"či získal soustředění\n"
"nebo pobýval v odloučení :"

msgid "272"
msgstr ""
"„dospěl jsem k blaženosti odříkání,\n"
"kterou neprožívají obyčejní světští lidé“ —\n"
"tuto důvěru v sobě ne-chovej, mnichu,\n"
"dokud jsi nedosáhl odstranění zákalů"

msgid "chap20"
msgstr "Stezka"

msgid "273"
msgstr ""
"ze stezek osmičlenná je nejlepší,\n"
"z pravd čtyři pravdy,\n"
"bezvášnivost je nejlepší z věcí [ze stavů],\n"
"z dvounohých bytostí ten, kdo je vidoucí"

msgid "274"
msgstr ""
"jen toto je stezka a není jiné\n"
"k očištění vidění,\n"
"po ní postupujte\n"
"a Máru oslepíte"

msgid "275"
msgstr ""
"budete-li po ní postupovat,\n"
"učiníte konec strasti,\n"
"ukazuji tuto stezku,\n"
"když jsem konečně poznal, jak vytrhnout šíp [strasti]"

msgid "276"
msgstr ""
"vy sami musíte vyvinout horlivost,\n"
"pouze ukazatelé cesty jsou Tathágatové,\n"
"ti, kdo postupují po stezce se osvobodí —\n"
"dlící v meditačním pohroužení — z Márových pout"

msgid "277"
msgstr ""
"všechny formace jsou nestálé,\n"
"když to někdo moudře nahlédne,\n"
"tak se odvrátí od utrpení,\n"
"to je stezka k očištění"

msgid "278"
msgstr ""
"všechny formace jsou strastné,\n"
"když to někdo moudře nahlédne,\n"
"tak se odvrátí od utrpení,\n"
"to je stezka k očištění"

msgid "279"
msgstr ""
"všechny věci [stavy] jsou ne-já,\n"
"když to někdo moudře nahlédne,\n"
"tak se odvrátí od utrpení,\n"
"to je stezka k očištění"

msgid "280"
msgstr ""
"kdo neusiluje, když je čas k úsilí,\n"
"jsa mladý a silný se oddává letargii,\n"
"místo aby byl rozhodné mysli, jsa líný\n"
"a letargický, stezku moudrosti nenalezne"

msgid "281"
msgstr ""
"kdo hlídá svou řeč a dobře ovládá svou mysl,\n"
"nechť ani tělesně neprospěšný čin nevykoná,\n"
"nechť tyto tři cesty činu očistí\n"
"a vzbudí v sobě stezku, hlásanou zřeci"

msgid "282"
msgstr ""
"z oddanosti se rodí vědění,\n"
"bez oddanosti vědění zaniká,\n"
"tyto dvě cesty pochopiv —\n"
"rozvoj a úpadek,\n"
"měl by se člověk zařídit tak,\n"
"aby jeho vědění vzrůstalo"

msgid "283"
msgstr ""
"celý les [žádostí] pokácejte, nejen nějaký strom,\n"
"z tohoto lesa se rodí strach,\n"
"když vymýtíte celý les i s podrostem,\n"
"budete, mniši, odpoutaní [vyhaslí]"

msgid "284"
msgstr ""
"dokud není vymýcen i podrost [žádostí] —\n"
"byť nepatrný — muže po ženě,\n"
"jeho mysl je k ní připoutaná\n"
"jako mléko sající tele ke své matce"

msgid "285"
msgstr ""
"vymyť sebelásku,\n"
"jako bys na podzim vytrhl lilii,\n"
"rozviň tuto stezku k míru\n"
"a k odpoutání [vyhasnutí], kterou vykládá Blažený"

msgid "286"
msgstr ""
"„zde strávím dobu dešťů,\n"
"zde zimu, zde léto“ —\n"
"tak uvažuje pošetilec,\n"
"který nechápe nebezpečí"

msgid "287"
msgstr ""
"kdo je opojen svými potomky a majetkem,\n"
"člověk s ulpívající myslí,\n"
"jako na spící vesnici velká povodeň,\n"
"tak na něj přijde a uchvátí ho smrt"

msgid "288"
msgstr ""
"ani synové nejsou ochranou,\n"
"ani otec či jiní blízcí,\n"
"koho uchopí ukončitel životů,\n"
"nemá již ochrany u příbuzných"

msgid "289"
msgstr ""
"pochopiv tento určující smysl,\n"
"moudrý a ctností střežený člověk,\n"
"stezku vedoucí k odpoutání [vyhasnutí]\n"
"nechť rychle očistí"

msgid "chap21"
msgstr "Různé"

msgid "290"
msgstr ""
"je-li možné opuštěním omezeného štěstí\n"
"spatřit rozsáhlé štěstí,\n"
"pak moudrý opustí omezené štěstí\n"
"aby spatřil rozsáhlé štěstí"

msgid "291"
msgstr ""
"kdo způsobuje ostatním utrpení,\n"
"v touze po vlastním štěstí,\n"
"zaplete se do spleti nenávisti\n"
"a z této nenávisti [zášti] se nevyprostí"

msgid "292"
msgstr ""
"ti, kdo odmítají to, co by měli dělat\n"
"a dělají to, co by neměli dělat —\n"
"drzí a nedbalí —\n"
"u těch zákaly jen narůstají"

msgid "293"
msgstr ""
"ale ti, kdo jsou správně upevnění,\n"
"stále si uvědomují tělo,\n"
"neprovádějí to, co by neměli\n"
"a vytrvale konají to, co by měli,\n"
"uvědomělí a jasně chápající —\n"
"ti dojdou k ukončení zákalů"

msgid "294"
msgstr ""
"když zabil matku [žádostivost] a otce [klam „já“],\n"
"dva bojovné krále [víru ve věčnou existenci a víru v úplný zánik],\n"
"a zničil království a jeho poddané [šest smyslových základen a vášeň],\n"
"putuje bráhman prost strázně"

msgid "295"
msgstr ""
"když zabil matku [žádostivost] a otce [klam „já“],\n"
"dva učené krále [víru ve věčnou existenci a víru v úplný zánik],\n"
"když zabil pětici tygrů [pět mentálních překážek],\n"
"putuje bráhman prost strázně"

msgid "296"
msgstr ""
"jsou probuzení, zcela probuzení —\n"
"vždy — Gótamovi žáci,\n"
"kteří si dnem i nocí\n"
"stále uvědomují [připomínají] Buddhu"

msgid "297"
msgstr ""
"jsou probuzení, zcela probuzení —\n"
"vždy — Gótamovi žáci,\n"
"kteří si dnem i nocí\n"
"stále uvědomují Dhammu"

msgid "298"
msgstr ""
"jsou probuzení, zcela probuzení —\n"
"vždy — Gótamovi žáci,\n"
"kteří si dnem i nocí\n"
"stále uvědomují Sanghu"

msgid "299"
msgstr ""
"jsou probuzení, zcela probuzení —\n"
"vždy — Gótamovi žáci,\n"
"kteří si dnem i nocí\n"
"stále uvědomují tělo"

msgid "300"
msgstr ""
"jsou probuzení, zcela probuzení —\n"
"vždy — Gótamovi žáci,\n"
"kteří dnem i nocí\n"
"těší svou mysl neubližováním"

msgid "301"
msgstr ""
"jsou probuzení, zcela probuzení —\n"
"vždy — Gótamovi žáci,\n"
"kteří dnem i nocí\n"
"těší svou mysl [meditačním] rozvíjením"

msgid "302"
msgstr ""
"je těžké odejít do bezdomoví a nalézt v tom uspokojení,\n"
"těžký a strastný je život hospodáře,\n"
"strastné je pobývání mezi cizími lidmi,\n"
"poutník [životy] je stále stíhán strastmi,\n"
"proto nebuďte jen poutníky [životy],\n"
"nedejte se stále stíhat strastmi"

msgid "303"
msgstr ""
"kdo je obdařen důvěrou a ctností,\n"
"dosáhne slávy a bohatství,\n"
"kamkoli přijde,\n"
"tam bude poctěn"

msgid "304"
msgstr ""
"kdo je naplněný mírem, šíří jas již z dálky,\n"
"jako zasněžený vrcholek,\n"
"nemírný [nectnostný] však není zřetelný ani z blízka,\n"
"jako šíp vystřelený v noci"

msgid "305"
msgstr ""
"kdo sám usedá a sám uléhá,\n"
"sám se prochází a není pohodlný [líný],\n"
"kdo sám sebe krotí [ovládá],\n"
"bude spokojený v lesích"

msgid "chap22"
msgstr "Peklo"

msgid "306"
msgstr ""
"ti, kdo říkají nepravdu [lžou] odcházejí do pekla,\n"
"stejně jako ti, kdo něco udělají a říkají: „neudělal jsem to“ [zapírají],\n"
"oba si po smrti budou rovni —\n"
"na onom světě — tito lidé nízkého konání"

msgid "307"
msgstr ""
"mnozí z těch, kdo se oděli oranžovým rouchem\n"
"mají zlou povahu a jsou neukáznění,\n"
"tito zlí se díky svým zlým činům\n"
"znovuzrodí v pekle"

msgid "308"
msgstr ""
"lepší je spolknout železnou kouli,\n"
"rozžhavenou jako planoucí oheň,\n"
"než takto pojídat nectnostně\n"
"a neukázněně almužní jídlo kraje"

msgid "309"
msgstr ""
"do čtyř stavů nedbalý muž,\n"
"který svádí ženu druhého upadne:\n"
"nahromadění viny [hříchu], neklidný spánek,\n"
"zatřetí hanlivá pověst a začtvrté peklo"

msgid "310"
msgstr ""
"kromě nahromadění viny [hříchu] a zlého budoucího stavu\n"
"jsou oba vystrašení i během krátké doby potěšení,\n"
"neboť i král za to uvaluje těžký trest,\n"
"proto by muž neměl svádět ženu druhého"

msgid "311"
msgstr ""
"jako ostrá tráva, je-li špatně uchopena,\n"
"tu ruku pořeže,\n"
"tak i špatně pojímaný asketický život\n"
"tě svrhne do pekla"

msgid "312"
msgstr ""
"nějaký ledabyle vykonaný čin,\n"
"nějaký nečistý zvyk\n"
"nebo pochybně vedený svatý život\n"
"nepřinese velké plody"

msgid "313"
msgstr ""
"co je třeba vykonat, to konejte\n"
"upevněně a usilovně,\n"
"neboť ledabylý odchod do bezdomoví\n"
"zvedá nejvíce prachu"

msgid "314"
msgstr ""
"je lepší nevykonat špatný čin,\n"
"neboť špatný čin [tě] poté spálí,\n"
"lepší je vykonat dobrý čin,\n"
"neboť ten [tě] nespálí"

msgid "315"
msgstr ""
"jako město na hranici země\n"
"je střeženo uvnitř i zvenku,\n"
"tak i vy střežte sami sebe,\n"
"ani okamžik nepropásněte,\n"
"ti, kdo na okamžik poleví, se pak trápí,\n"
"když do pekla se dostanou"

msgid "316"
msgstr ""
"ti, kdo se hanbí za to, co hanebné není\n"
"a nehanbí se za to, co hanebné je,\n"
"přijímají špatné názory,\n"
"tyto bytosti kráčí do bědných stavů"

msgid "317"
msgstr ""
"ti, kdo vidí nebezpečí v tom, co nebezpečné není\n"
"a nevidí nebezpečí v tom, co nebezpečné je,\n"
"přijímají špatné názory,\n"
"tyto bytosti kráčí do bědných stavů"

msgid "318"
msgstr ""
"ti, kdo vidí chybu v tom, co chybou není\n"
"a nevidí chybu v tom, co chybou je,\n"
"přijímají špatné názory,\n"
"tyto bytosti kráčí do bědných stavů"

msgid "319"
msgstr ""
"avšak ti, kdo rozpoznají chybu jakožto chybu\n"
"a bezchybnost jakožto bezchybnost,\n"
"přijímají správné názory,\n"
"tyto bytosti kráčí do šťastných stavů"

msgid "chap23"
msgstr "Nága"

msgid "320"
msgstr ""
"tak jako slon v bitvě\n"
"z luku vystřelený šíp —\n"
"je třeba snášet urážky,\n"
"neboť mnoho lidí je nectnostných"

msgid "321"
msgstr ""
"zkrocený [slon] je voděn i ve shromáždění,\n"
"na zkroceného [slona] usedne i král,\n"
"i mezi lidmi je nejlepší ten, kdo je zkrocený,\n"
"kdo umí snášet urážky"

msgid "322"
msgstr ""
"je skvělé [umět] zkrotit muly,\n"
"ušlechtilé sindhské koně\n"
"či statné velké slony,\n"
"skvělejší je však [umět] zkrotit sám sebe"

msgid "323"
msgstr ""
"neboť nelze na žádném z těchto prostředků\n"
"dojít do onoho kraje, kam noha nevkročí,\n"
"kam jen ten, kdo sám sebe dobře zkrotil,\n"
"skrze své zkrocení dojde"

msgid "324"
msgstr ""
"Dhanapálako, slona,\n"
"který je v době říje, je těžké udržet,\n"
"je-li upoután, nepožije ani sousta,\n"
"vzpomíná na sloní les a na slony"

msgid "325"
msgstr ""
"kdo je malátný, přejídá se\n"
"a ospale se povaluje\n"
"jako velký vepř na krmníku —\n"
"takový tupec vstupuje do lůna znovu a znovu"

msgid "326"
msgstr ""
"dříve se tato toulavá mysl zatoulala\n"
"kamkoli se jí zachtělo, kdekoli jí bylo libo a příjemno,\n"
"ode dneška ji však budu důkladně držet na uzdě,\n"
"tak jako chomout drží slona v říji"

msgid "327"
msgstr ""
"radujte se z dbalosti,\n"
"a dobře chraňte svou mysl,\n"
"pozvedněte se z blátivé cesty\n"
"jako slon z bahna do něhož zapadl"

msgid "328"
msgstr ""
"jestliže získáš bystrého přítele,\n"
"souputníka, který má dobré chování a je prozíravý,\n"
"pak, překonávaje všechna nebezpečí,\n"
"putuj s ním, s potěšenou a uvědomělou myslí"

msgid "329"
msgstr ""
"jestliže nezískáš bystrého přítele,\n"
"souputníka, který má dobré chování a je prozíravý,\n"
"pak, jako král, který opouští své poražené království,\n"
"putuj sám, jako osamělý slon lesem Mátanga"

msgid "330"
msgstr ""
"putovat sám je lepší,\n"
"není radno spolčovat se s pošetilci,\n"
"proto putuj sám, nekonaje zlo,\n"
"bezstarostný, jako osamělý slon lesem Mátanga"

msgid "331"
msgstr ""
"ve vzniklé nouzi mít přátele je štěstím,\n"
"spokojenost s jakýmikoliv potřebami je štěstím,\n"
"zásluhy na konci života jsou štěstím,\n"
"opuštění veškeré strasti je štěstím"

msgid "332"
msgstr ""
"štěstím ve světě je úcta k matce,\n"
"stejně tak úcta k otci je štěstím,\n"
"štěstím ve světě je úcta k asketům,\n"
"stejně tak úcta k bráhmanům je štěstím"

msgid "333"
msgstr ""
"štěstím je ctnostný život až do stáří,\n"
"štěstím je upevněná důvěra,\n"
"štěstím je nabytí moudrosti,\n"
"nekonání zla je štěstím"

msgid "chap24"
msgstr "Toužení"

msgid "334"
msgstr ""
"u člověka, který žije nedbale,\n"
"toužení vzrůstá jako popínavá rostlina,\n"
"plave jen sem a tam [z života do života],\n"
"toužebně vyhledávaje plody, jako opice v lese"

msgid "335"
msgstr ""
"koho přemůže toto hrubé\n"
"a lepivé toužení ve světě,\n"
"u toho trápení narůstá\n"
"jako tráva po dešti"

msgid "336"
msgstr ""
"kdo však přemůže toto hrubé\n"
"toužení ve světě, z něhož je těžké se vymanit,\n"
"od toho trápení odpadne\n"
"jako kapky vody z lotosového květu"

msgid "337"
msgstr ""
"toto vám říkám: blaze vám,\n"
"zde shromážděným,\n"
"kteří vytrhnete kořen svého toužení,\n"
"tak jako sběrač vonných kořínků trávu,\n"
"nedopusťte aby vás — tak jako říční proud rákos —\n"
"Mára lámal [ničil] znovu a znovu"

msgid "338"
msgstr ""
"jako nepoškozený silný kořen\n"
"uťatého stromu znovu vyroste,\n"
"tak ze sklonu k toužení, není-li vykořeněn,\n"
"vyvstává toto utrpení, znovu a znovu"

msgid "339"
msgstr ""
"u koho je šestatřicet proudů [smyslnosti]\n"
"vyvěrajících z toho, co je příjemné, mohutných,\n"
"toho tento tok odplaví [do strastného stavu], tyto zhoubné názory\n"
"a myšlenky [motivy] spočívající na vášni"

msgid "340"
msgstr ""
"tyto proudy tečou všude,\n"
"popínavé rostliny [vášně] vypučí, když se uchytí,\n"
"vidíš-li jak se taková popínavá rostlina rodí,\n"
"její kořen moudře vytrhni"

msgid "341"
msgstr ""
"uvolněné a bez zábran\n"
"jsou lidské radosti,\n"
"ti, kdo hledají štěstí v příjemnostech,\n"
"vskutku tito lidé podléhají zrození a stárnutí"

msgid "342"
msgstr ""
"touhu upřednostňující lidé\n"
"se chvějí jako polapený zajíc,\n"
"spoutáni a svázáni pouty,\n"
"přicházejí k utrpení, znovu a znovu, po dlouhou dobu"

msgid "343"
msgstr ""
"touhu upřednostňující lidé\n"
"se chvějí jako polapený zajíc,\n"
"proto by měl tuto touhu odstranit\n"
"mnich, který si přeje být oproštěn od vášně"

msgid "344"
msgstr ""
"když vymítil podrost, ale zůstal obklopen lesem [žádostí],\n"
"ač mohl být vysvobozen z lesa, znovu se do lesa vrací,\n"
"pohleď na tohoto člověka,\n"
"ač mohl být vysvobozen, znovu se ke svým poutům vrací"

msgid "345"
msgstr ""
"není pevné pouto, říkají mudrcové,\n"
"které je ze železa, ze dřeva či z travních vláken,\n"
"je to zalíbení v klenotech a špercích\n"
"toužení po ženách a dětech [potomcích]"

msgid "346"
msgstr ""
"pevné je to pouto, říkají mudrcové,\n"
"které stahuje dolů, je poddajné a je těžké se z něj vyprostit,\n"
"proto jej odetli a odešli do bezdomoví,\n"
"prosti toužení opustili příjemné smyslné požitky"

msgid "347"
msgstr ""
"ti, kdo se radují z vášně, padají do jejího proudu,\n"
"jako pavouk do sítě, kterou sám vyrobil,\n"
"proto ji mudrci odetli a odešli,\n"
"prosti toužení opustili veškerou strast"

msgid "348"
msgstr ""
"oprosti se od toho, co je před tebou i od toho, co je za tebou,\n"
"oprosti se i od toho, co je mezi tím a překroč bytí,\n"
"s myslí od všeho osvobozenou\n"
"již nepůjdeš znovu vstříc zrození a stárnutí"

msgid "349"
msgstr ""
"u člověka s rozrušenými myšlenkami\n"
"a silnou vášní, který nazírá jen [tělesnou] krásu,\n"
"velmi vzrůstá toužení,\n"
"jen si tím upevňuje pouta"

msgid "350"
msgstr ""
"kdo se však těší utišováním myšlenek,\n"
"a medituje nad [tělesnou] odporností, vždy uvědomělý,\n"
"ten učiní konec,\n"
"ten odetne Márova pouta"

msgid "351"
msgstr ""
"kdo došel cíle a je beze strachu,\n"
"prost toužení a bez poskvrny,\n"
"ten vytrhl šípy bytí\n"
"a je vtělen naposledy"

msgid "352"
msgstr ""
"kdo je prost toužení a bez lpění,\n"
"je obeznámen s texty —\n"
"se skladbu slov —\n"
"zná které předcházejí a které je následují,\n"
"ten je vtělen naposledy,\n"
"o tom se říká, že je velký člověk s velkou moudrostí"

msgid "353"
msgstr ""
"všechno jsem přemohl, všechno jsem poznal,\n"
"na žádných věcech [stavech] nelpím,\n"
"všeho jsem zanechal a jsem osvobozen odstraněním toužení:\n"
"sám jsem to přímo poznal, koho bych měl nazvat svým učitelem ?"

msgid "354"
msgstr ""
"všechny dary předčí dar Dhammy,\n"
"všechny chutě předčí chuť Dhammy,\n"
"všechny radosti předčí radost z Dhammy,\n"
"odstranění toužení předčí všechno utrpení"

msgid "355"
msgstr ""
"požitky [bohatství] ničí nemoudrého člověka,\n"
"ne toho, kdo hledá druhý břeh,\n"
"z touhy po požitcích [bohatství] nemoudrý člověk\n"
"ničí ostatní i sebe"

msgid "356"
msgstr ""
"plevel ničí pole,\n"
"vášeň ničí tyto lidi,\n"
"proto — těm, kdo jsou prosti vášně —\n"
"dávání přináší velké plody"

msgid "357"
msgstr ""
"plevel ničí pole,\n"
"nenávist ničí tyto lidi,\n"
"proto — těm, kdo jsou prosti nenávisti —\n"
"dávání přináší velké plody"

msgid "358"
msgstr ""
"plevel ničí pole,\n"
"zaslepenost ničí tyto lidi,\n"
"proto — těm, kdo jsou prosti zaslepenosti —\n"
"dávání přináší velké plody"

msgid "359"
msgstr ""
"plevel ničí pole,\n"
"žádostivost ničí tyto lidi,\n"
"proto — těm, kdo jsou prosti žádostivosti —\n"
"dávání přináší velké plody"

msgid "chap25"
msgstr "Mnich"

msgid "360"
msgstr ""
"ovládat své oko [zrak] je dobré,\n"
"je dobré ovládat své ucho [sluch],\n"
"ovládat svůj nos [čich] je dobré,\n"
"je dobré ovládat svůj jazyk [chuť]"

msgid "361"
msgstr ""
"ovládat své tělo je dobré,\n"
"je dobré ovládat svou řeč,\n"
"ovládat svou mysl je dobré,\n"
"je dobré zcela se ovládat,\n"
"zcela se kontrolující mnich\n"
"od veškeré strasti se osvobodí"

msgid "362"
msgstr ""
"kdo ukázní své ruce, ukázní své nohy,\n"
"ukázní svou řeč, nanejvýš se ukázní —\n"
"v niterné radosti, soustředěný\n"
"a spokojený v samotě — ten je nazýván mnichem"

msgid "363"
msgstr ""
"mnich, který ukázní svá ústa,\n"
"recituje bez rozrušení [nepovýšeně]\n"
"a objasňuje smysl Dhammy —\n"
"sladká je jeho řeč"

msgid "364"
msgstr ""
"Dhammou se těšící, z Dhammy se radující,\n"
"Dhammu zkoumající,\n"
"Dhammu si připomínající mnich\n"
"od dobré Dhammy neodpadne"

msgid "365"
msgstr ""
"nemysli na vlastní zisk,\n"
"nežij v závisti vůči ostatním,\n"
"mnich, který závidí ostatním,\n"
"soustředění nedosáhne"

msgid "366"
msgstr ""
"i když mnich nenabyl zisku,\n"
"na vlastní zisk nemyslí,\n"
"toho i bohové chválí,\n"
"kdo žije čistě a nepolevuje v úsilí"

msgid "367"
msgstr ""
"jakékoli jméno-a-hmotu,\n"
"kdo nepovažuje za své vlastní,\n"
"a kvůli tomu, co není se netrápí,\n"
"ten je nazýván mnichem"

msgid "368"
msgstr ""
"v laskavosti prodlévající mnich,\n"
"povznešený Buddhovým učením,\n"
"dosáhne stavu míru :\n"
"štěstí utišení formací"

msgid "369"
msgstr ""
"vyprázdni, mnichu, tento člun,\n"
"prázdný pro tebe bude lehčí,\n"
"odetneš-li vášeň a nenávist,\n"
"dojdeš tím k odpoutání"

msgid "370"
msgstr ""
"odetni pět [nižších pout], zanech pět [vyšších pout]\n"
"a rozviň přednostně pět [řídících schopností],\n"
"mnich, který překonal pět připoutaností\n"
"je nazýván „ten, kdo překročil záplavu“"

msgid "371"
msgstr ""
"cvič meditační pohroužení, mnichu, nebuď nedbalý,\n"
"nenech svou mysl potulovat u pramenů smyslnosti,\n"
"nespolkni z nedbalosti tuto žhavou železnou kouli,\n"
"aby ses nespálil a nenaříkal : „to je utrpení“"

msgid "372"
msgstr ""
"není meditační pohroužení u toho, kdo postrádá moudrost,\n"
"není moudrost u toho, kdo postrádá meditační pohroužení,\n"
"kdo je však obdařen meditačním pohroužením i moudrostí,\n"
"ten je již v blízkosti odpoutání"

msgid "373"
msgstr ""
"do prázdného příbytku vstupuje\n"
"mnich, který má mysl naplněnou mírem,\n"
"zakouší radost, kterou nezakouší obyčejní lidé,\n"
"ten, kdo správně a jasně vidí Dhammu"

msgid "374"
msgstr ""
"kdo správně pozná [zakusí] jakým způsobem\n"
"osobnostní skupiny vznikají a zanikají,\n"
"ten získá nadšení a radost,\n"
"neboť tím pozná bezsmrtný stav"

msgid "375"
msgstr ""
"toto jsou první kroky\n"
"moudrého mnicha, zde [v tomto učení] :\n"
"střežení svých smyslů a spokojenost,\n"
"sebekontrola podle pravidel cvičení,\n"
"sdružování se s dobrými přáteli,\n"
"čistý život a nepolevování v úsilí,"

msgid "376"
msgstr ""
"měl by mít přátelské způsoby\n"
"a být zkušený v jednání,\n"
"tím bude naplněn radostí\n"
"a učiní konec utrpení"

msgid "377"
msgstr ""
"jako jasmín květů\n"
"uvadlých se zbavuje,\n"
"tak vášně a nenávisti\n"
"zcela se zbavte, mniši"

msgid "378"
msgstr ""
"kdo má mírné [klidné] tělo a mírnou řeč,\n"
"je mírný a dobře soustředěný,\n"
"mnich, který opustil světské návnady,\n"
"ten je nazýván „umírněný“"

msgid "379"
msgstr ""
"sám sebe napravuj [napomínej],\n"
"sám sebe zkoumej,\n"
"když střeží sám sebe a je uvědomělý,\n"
"bude mnich prodlévat blaženě"

msgid "380"
msgstr ""
"každý je sám sobě ochráncem,\n"
"každý je sám sobě vůdcem,\n"
"proto bys měl ukáznit sám sebe,\n"
"jako chovatel svého skvělého koně"

msgid "381"
msgstr ""
"radostí naplněný mnich,\n"
"povznešený Buddhovým učením,\n"
"dosáhne stavu míru :\n"
"štěstí utišení formací"

msgid "382"
msgstr ""
"když mladý mnich\n"
"bojuje [usiluje] v Buddhově učení,\n"
"ozáří tento svět,\n"
"jako z mraků vynořivší se měsíc"

msgid "chap26"
msgstr "Bráhman"

msgid "383"
msgstr ""
"s odvahou odetni [zastav] proud [vznikání]\n"
"a zavrhni smyslové požitky, bráhmane,\n"
"s poznáním ukončení formací\n"
"poznáš to, co je nestvořené, bráhmane"

msgid "384"
msgstr ""
"když tyto dvě věci\n"
"bráhman překročí,\n"
"pak všechna jeho pouta\n"
"dojdou k ukončení — u toho, kdo je vědoucí"

msgid "385"
msgstr ""
"pro koho již onen svět ani tento svět,\n"
"ani onen-i-tento svět neexistuje [není k nalezení],\n"
"je prostý úzkosti a zbavený pout,\n"
"toho nazývám bráhmanem"

msgid "386"
msgstr ""
"kdo dlí bez poskvrn v meditačním pohroužení,\n"
"kdo splnil svůj úkol a je prostý zákalů,\n"
"kdo dosáhl nejvyššího cíle,\n"
"toho nazývám bráhmanem"

msgid "387"
msgstr ""
"slunce září ve dne,\n"
"měsíc svítí v noci,\n"
"bojovník září ve své zbroji,\n"
"bráhman září v meditačním pohroužení,\n"
"avšak po celý [každý] den i noc\n"
"září svým jasem Probuzený"

msgid "388"
msgstr ""
"„bráhman“ proto, že se zbavil zla,\n"
"„asketa“ proto je někdo nazýván, že žije správně,\n"
"že opustil vlastní poskvrnění,\n"
"proto je někdo nazýván „ten, kdo opustil [odešel]“"

msgid "389"
msgstr ""
"nechť nikdo neudeří bráhmana\n"
"a bráhman nechť nepovolí svému hněvu,\n"
"hanba tomu, kdo napadne bráhmana,\n"
"větší hanba, když ten povolí svému hněvu"

msgid "390"
msgstr ""
"nic není pro bráhmana lepší\n"
"než pevně ovládaná mysl vůči tomu, co je milé,\n"
"a do jaké míry se odvrátí od ubližování,\n"
"do té míry se utiší jeho utrpení"

msgid "391"
msgstr ""
"kdo tělesně, slovně\n"
"a mentálně nekoná špatné skutky,\n"
"ovládá se v těchto třech způsobech,\n"
"toho nazývám bráhmanem"

msgid "392"
msgstr ""
"od koho jsi byl poučen v Dhammě,\n"
"vyložené dokonale Probuzeným,\n"
"toho chovej v náležité úctě,\n"
"jako bráhman obětní oheň"

msgid "393"
msgstr ""
"ani splétáním vlasů, ani rodem\n"
"ani zrozením se nikdo nestane bráhmanem,\n"
"v kom je však pravda a Dhamma,\n"
"ten je čistým, ten je bráhmanem"

msgid "394"
msgstr ""
"k čemu je ti splétání vlasů, nemoudrý člověče,\n"
"k čemu je ti plášť z antilopí kůže?,\n"
"uvnitř jsi zamotaný,\n"
"navenek uhlazený"

msgid "395"
msgstr ""
"kdo se obléká do odhozených hadrů,\n"
"je vyhublý až mu vystupují žíly\n"
"a osamotě dlí v lesích v meditačním pohroužení,\n"
"toho nazývám bráhmanem"

msgid "396"
msgstr ""
"nenazývám někoho bráhmanem podle toho\n"
"z jakého lůna, z jaké matky se zrodil,\n"
"nazýván ctěným učitelem [vykladačem]\n"
"je ten, kdo nic nemá —\n"
"kdo na ničem nelpí,\n"
"toho nazývám bráhmanem"

msgid "397"
msgstr ""
"kdo odetnul všechna pouta,\n"
"není rozrušený\n"
"a je oproštěn od připoutanosti,\n"
"toho nazývám bráhmanem"

msgid "398"
msgstr ""
"kdo odetnul popruh a řemen,\n"
"otěž a uzdu,\n"
"odstranil závoru a je probuzený,\n"
"toho nazývám bráhmanem"

msgid "399"
msgstr ""
"kdo napadení, rány i pouta\n"
"snáší prost zloby\n"
"a jeho silou je síla trpělivosti,\n"
"toho nazývám bráhmanem"

msgid "400"
msgstr ""
"kdo je prost hněvu a dbalý svých povinností,\n"
"dbalý ctnosti a prost pýchy,\n"
"kdo je zkrocený a je vtělen naposledy,\n"
"toho nazývám bráhmanem"

msgid "401"
msgstr ""
"jako voda na lotosovém listě\n"
"či hořčičné semínko na hrotu jehly,\n"
"kdo na smyslových požitcích neulpí,\n"
"toho nazývám bráhmanem"

msgid "402"
msgstr ""
"kdo vzhledem k utrpení poznává,\n"
"že ho právě zde, sám pro sebe ukončil,\n"
"kdo odložil břemeno a je odpoután,\n"
"toho nazývám bráhmanem"

msgid "403"
msgstr ""
"mudrce s hlubokou moudrostí,\n"
"který rozezná co je stezka a co není stezka,\n"
"který dosáhl nejvyššího cíle,\n"
"toho nazývám bráhmanem"

msgid "404"
msgstr ""
"kdo se nesdružuje s hospodáři\n"
"ani s poutníky bez domova,\n"
"kdo žije v bezdomoví a má málo přání,\n"
"toho nazývám bráhmanem"

msgid "405"
msgstr ""
"kdo zanechal násilí [odložil hůl] vůči živým bytostem,\n"
"ať bázlivým či statečným,\n"
"kdo nezabíjí ani nenavádí ostatní k zabíjení,\n"
"toho nazývám bráhmanem"

msgid "406"
msgstr ""
"kdo je prost nepřátelství mezi nepřáteli,\n"
"mezi násilníky je umírněný [odpoutaný]\n"
"a mezi ulpívajícími je prost lpění,\n"
"toho nazývám bráhmanem"

msgid "407"
msgstr ""
"od koho vášeň i nenávist,\n"
"domýšlivost i pohrdavost odpadla\n"
"jako hořčičné semínko z hrotu jehly,\n"
"toho nazývám bráhmanem"

msgid "408"
msgstr ""
"kdo ne-hrubá, poučná\n"
"a pravdivá slova pronáší,\n"
"kdo nikoho neuráží,\n"
"toho nazývám bráhmanem"

msgid "409"
msgstr ""
"kdo zde — ať dlouhé či krátké,\n"
"malé či velké, krásné či ošklivé —\n"
"ve světě nebere nic nedarovaného,\n"
"toho nazývám bráhmanem"

msgid "410"
msgstr ""
"u koho není k nalezení touha\n"
"po tomto světě či po onom světě [po smrti],\n"
"kdo je zbaven touhy a je odpoutaný,\n"
"toho nazývám bráhmnem"

msgid "411"
msgstr ""
"u koho není k nalezení místo jeho lpění\n"
"a je prost pochybností díky konečnému poznání,\n"
"kdo dosáhl hlubiny bezsmrtnosti,\n"
"toho nazývám bráhmanem"

msgid "412"
msgstr ""
"kdo zde [v tomto světě] dobro i zlo,\n"
"obě tato lpění překonal\n"
"a je prost trápení, bez poskvrny, čistý,\n"
"toho nazývám bráhmanem"

msgid "413"
msgstr ""
"kdo je jako měsíc, neposkvrněný a čistý,\n"
"čirý a klidný,\n"
"kdo zcela odstranil zalíbení v bytí,\n"
"toho nazývám bráhmanem"

msgid "414"
msgstr ""
"kdo tuto nebezpečnou a obtížnou cestu,\n"
"koloběh životů a zaslepenost překonal,\n"
"kdo překročil na druhý břeh a dlí v meditačním pohroužení,\n"
"kdo je prost žádostí, prost pochybností,\n"
"odpoutaný skrze neulpívání,\n"
"toho nazývám bráhmanem"

msgid "415"
msgstr ""
"kdo zde, opustiv smyslné požitky,\n"
"odejde z domova do bezdomoví,\n"
"kdo zcela ukončil [odstranil] smyslné bytí,\n"
"toho nazývám bráhmanem"

msgid "416"
msgstr ""
"kdo zde, opustiv toužení,\n"
"odejde z domova do bezdomoví,\n"
"kdo zcela ukončil [odstranil] toužení po bytí,\n"
"toho nazývám bráhmanem"

msgid "417"
msgstr ""
"kdo opustil lidská pouta\n"
"a překonal i pouta nebeská,\n"
"kdo je zbaven všech pout,\n"
"toho nazývám bráhmanem"

msgid "418"
msgstr ""
"kdo opustil libost i nelibost,\n"
"kdo je vychladlý a prostý přivlastňování,\n"
"kdo je hrdinou, jenž přemohl celý svět,\n"
"toho nazývám bráhmanem"

msgid "419"
msgstr ""
"kdo zná zanikání [odcházení] bytostí\n"
"a jejich znovuvyvstávání, v celistvosti,\n"
"kdo je bez lpění, blažený a probuzený,\n"
"toho nazývám bráhmanem"

msgid "420"
msgstr ""
"ten, jehož směr [místo určení] neznají\n"
"bohové, nebešťané ani lidé,\n"
"kdo je oproštěný od zákalů, zasloužilý,\n"
"toho nazývám bráhmanem"

msgid "421"
msgstr ""
"pro koho je minulost, budoucnost\n"
"i to, co je mezi tím nicotou,\n"
"kdo na ničem nelpí,\n"
"toho nazývám bráhmanem"

msgid "422"
msgstr ""
"kdo je vůdce a ušlechtilý hrdina,\n"
"kdo je velkým zřecem, jenž nad vším zvítězil,\n"
"kdo je prost žádostí, očištěný od zla a probuzený,\n"
"toho nazývám bráhmanem"

msgid "423"
msgstr ""
"kdo své dřívější životy poznal\n"
"a nebeské světy i místa utrpení uzřel,\n"
"kdo ukončení zrozování dosáhl\n"
"a je mudrcem s dokonalým přímým poznáním,\n"
"kdo dovršil vše, co lze dovršit,\n"
"toho nazývám bráhmanem"
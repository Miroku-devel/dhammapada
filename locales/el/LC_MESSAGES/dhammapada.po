msgid "title"
msgstr "Ντάμαπαντα"

msgid "chaps"
msgstr "Κεφάλαια"

msgid "fontsize"
msgstr "Μέγεθος γραμματοσειράς"

msgid "chap1"
msgstr "Τα Ζεύγη"

msgid "1"
msgstr "Τα νοητικά φαινόμενα έχουν πρόδρομο τον νου, έχουν τον νου ως κυρίαρχο, είναι δημιουργημένα από τον νου· αν με διεφθαρμένο νου κάποιος μιλά ή πράττει· τότε αυτόν η δυστυχία ακολουθεί, όπως ο τροχός το πόδι αυτού που σέρνει."

msgid "2"
msgstr "Τα νοητικά φαινόμενα έχουν πρόδρομο τον νου, έχουν τον νου ως κυρίαρχο, είναι δημιουργημένα από τον νου· αν με καθαρό νου κάποιος μιλά ή πράττει· τότε αυτόν η ευτυχία ακολουθεί, σαν σκιά αχώριστη."

msgid "3"
msgstr "'Με ύβρισε, με χτύπησε, με νίκησε, μου πήρε· όσοι κρατούν μνησικακία για αυτό, η έχθρα τους δεν καταλαγιάζει."

msgid "4"
msgstr "'Με ύβρισε, με χτύπησε, με νίκησε, μου πήρε· όσοι δεν κρατούν μνησικακία για αυτό, η έχθρα τους καταλαγιάζει."

msgid "5"
msgstr "Διότι ποτέ εδώ οι έχθρες δεν καταλαγιάζουν με έχθρα· με μη-έχθρα καταλαγιάζουν, αυτή είναι η αιώνια αρχή."

msgid "6"
msgstr "'Οι άλλοι δεν συνειδητοποιούν ότι εμείς εδώ πεθαίνουμε· όσοι εκεί συνειδητοποιούν, από αυτό καταλαγιάζουν οι διαμάχες."

msgid "7"
msgstr "Αυτόν που ζει παρατηρώντας το ωραίο, ασυγκράτητο στις ικανότητες· και χωρίς να γνωρίζει το μέτρο στην τροφή, οκνηρό με κατώτερη ενεργητικότητα· αυτόν πράγματι καταβάλλει ο Μάρα, όπως ο άνεμος ένα αδύναμο δέντρο."

msgid "8"
msgstr "Αυτόν που ζει παρατηρώντας το μη ελκυστικό, καλά συγκρατημένο στις ικανότητες· και γνωρίζοντας το μέτρο στην τροφή, πιστό, καταβάλλοντας έντονη ενεργητικότητα· αυτόν πράγματι δεν καταβάλλει ο Μάρα, όπως ο άνεμος έναν βράχινο ορεινό όγκο."

msgid "9"
msgstr "Όποιος δεν έχει απαλλαγεί από τη διαφθορά, θα φορέσει το πορτοκαλί ράσο· στερημένος από αυτοέλεγχο και αλήθεια, αυτός δεν αξίζει το πορτοκαλί ράσο."

msgid "10"
msgstr "Όποιος όμως έχει απορρίψει τη διαφθορά, είναι καλά εδραιωμένος στην ηθική· εφοδιασμένος με αυτοέλεγχο και αλήθεια, αυτός πράγματι αξίζει το πορτοκαλί ράσο."

msgid "11"
msgstr "Αυτοί που θεωρούν ουσιώδες το επουσιώδες, και βλέπουν ως επουσιώδες το ουσιώδες· αυτοί δεν φτάνουν στην ουσία, έχοντας ως πεδίο τους λανθασμένους λογισμούς."

msgid "12"
msgstr "Έχοντας γνωρίσει το ουσιώδες ως ουσιώδες, και το επουσιώδες ως επουσιώδες· αυτοί φτάνουν στην ουσία, έχοντας ως πεδίο τους ορθούς λογισμούς."

msgid "13"
msgstr "Όπως μια οικία κακοσκεπασμένη, η βροχή τη διαπερνά· Έτσι μια μη αναπτυγμένη συνείδηση, το πάθος τη διαπερνά."

msgid "14"
msgstr "Όπως μια οικία καλοσκεπασμένη, η βροχή δεν τη διαπερνά· Έτσι μια καλά αναπτυγμένη συνείδηση, το πάθος δεν τη διαπερνά."

msgid "15"
msgstr "Εδώ θλίβεται, πεθαίνοντας θλίβεται, αυτός που κάνει κακό και στις δύο περιπτώσεις θλίβεται· Αυτός θλίβεται, αυτός ταλαιπωρείται, έχοντας δει τη μολυσμένη πράξη του εαυτού του."

msgid "16"
msgstr "Εδώ χαίρεται, πεθαίνοντας χαίρεται, αυτός που έκανε αξιέπαινες πράξεις και στις δύο περιπτώσεις χαίρεται· Αυτός χαίρεται, αυτός αγάλλεται, έχοντας δει τον εξαγνισμό της πράξης του εαυτού του."

msgid "17"
msgstr "Εδώ βασανίζεται, πεθαίνοντας βασανίζεται, αυτός που κάνει κακό και στις δύο περιπτώσεις βασανίζεται· βασανίζεται σκεπτόμενος 'κακό έχω κάνει', περισσότερο βασανίζεται έχοντας πάει στον κακότυχο κόσμο."

msgid "18"
msgstr "Εδώ χαίρεται, πεθαίνοντας χαίρεται, αυτός που έκανε αξιέπαινες πράξεις και στις δύο περιπτώσεις χαίρεται· χαίρεται σκεπτόμενος 'αξιέπαινη πράξη έχω κάνει', περισσότερο χαίρεται έχοντας πάει στον καλότυχο κόσμο."

msgid "19"
msgstr "Ακόμη κι αν πολλά από τα ιερά κείμενα απαγγέλλει, ο αμελής άνθρωπος δεν τα εφαρμόζει· όπως ο βοσκός που μετρά τις αγελάδες των άλλων, δεν είναι μέτοχος της ασκητικής ζωής."

msgid "20"
msgstr "Ακόμη κι αν λίγα από τα ιερά κείμενα απαγγέλλει, αυτός που ακολουθεί τη συμφωνούσα διδασκαλία της Διδασκαλίας· έχοντας εγκαταλείψει τη λαγνεία και το μίσος και την αυταπάτη, με ορθή κατανόηση, με καλά απελευθερωμένο νου· μη προσκολλώμενος εδώ ή εκεί, αυτός είναι μέτοχος της ασκητικής ζωής."

msgid "chap2"
msgstr "Η Επιμέλεια"

msgid "21"
msgstr "Η επιμέλεια είναι η πορεία προς την αθανασία, η αμέλεια είναι η πορεία προς τον θάνατο·οι επιμελείς δεν πεθαίνουν, όσοι αμελείς είναι σαν νεκροί."

msgid "22"
msgstr "Έτσι έχοντας γνωρίσει τη διάκριση, οι σοφοί στην επιμέλεια·Χαίρονται στην επιμέλεια, ευχαριστημένοι στο πεδίο των ευγενών."

msgid "23"
msgstr "Αυτοί οι διαλογιστές, οι επίμονοι, πάντα με σταθερή προσπάθεια·οι σοφοί βιώνουν τη Νιμπάνα, την ανυπέρβλητη ελευθερία από τις δεσμεύσεις."

msgid "24"
msgstr "Για τον εργατικό, τον μνήμονα, αυτόν με καθαρές πράξεις, που ενεργεί με σύνεση·για τον συγκρατημένο, που ζει σύμφωνα με τη Διδασκαλία, τον επιμελή, η φήμη αυξάνεται."

msgid "25"
msgstr "Με εργατικότητα και επιμέλεια, με αυτοσυγκράτηση και αυτοέλεγχο·ο ευφυής ας δημιουργήσει ένα νησί, που η νοητική πλημμύρα δεν κατακλύζει."

msgid "26"
msgstr "Στην αμέλεια αφοσιώνονται οι ανόητοι, οι άφρονες άνθρωποι·αλλά ο ευφυής την επιμέλεια προστατεύει σαν τον ανώτερο θησαυρό."

msgid "27"
msgstr "Μην αφοσιώνεστε στην αμέλεια, μήτε στην οικειότητα με την ηδονική τέρψη·διότι ο επιμελής που διαλογίζεται, φτάνει σε άφθονη ευτυχία."

msgid "28"
msgstr "Όταν την αμέλεια με την επιμέλεια ο σοφός απωθεί·ανεβαίνοντας στο ανάκτορο της σοφίας, χωρίς λύπη, τη γενιά με λύπη·όπως αυτός που στέκεται σε βουνό αυτούς που στέκεται στο έδαφος, ο συνετός τους αδαείς παρατηρεί."

msgid "29"
msgstr "Επιμελής μεταξύ αμελών, ξύπνιος μεταξύ κοιμισμένων·όπως γρήγορο άλογο αδύναμο, αφήνοντας πίσω προχωρά ο σοφός."

msgid "30"
msgstr "Με την επιμέλεια ο Μαγκχαβάν, στην υπεροχή των θεών έφτασε·Την επιμέλεια επαινούν, η αμέλεια κατακρίνεται πάντα."

msgid "31"
msgstr "Ο μοναχός που χαίρεται στην επιμέλεια, ή βλέπει κίνδυνο στην αμέλεια·νοητικό δεσμό μικρό και μεγάλο, καίγοντας σαν φωτιά προχωρά."

msgid "32"
msgstr "Ο μοναχός που χαίρεται στην επιμέλεια, ή βλέπει κίνδυνο στην αμέλεια·Είναι ανίκανος για παρακμή, είναι κοντά στο Νιμπάνα."

msgid "chap3"
msgstr "Ο Νους"

msgid "33"
msgstr "Η συνείδηση που τρέμει, που είναι άστατη, δύσκολη να φυλαχτεί, δύσκολη να συγκρατηθεί·ο ευφυής την κάνει ευθεία, όπως ο κατασκευαστής βελών το βέλος."

msgid "34"
msgstr "Όπως ψάρι πεταμένο στη στεριά, τραβηγμένο από το νερό, το καταφύγιό του·Τρεμοπαλεύει αυτή η συνείδηση, για να εγκαταλείψει την κυριαρχία του Μάρα."

msgid "35"
msgstr "Του δυσκόλως ελεγχόμενου, ελαφρού, που πέφτει όπου επιθυμεί·Της συνείδησης το δάμασμα είναι καλό, η δαμασμένη συνείδηση φέρνει ευτυχία."

msgid "36"
msgstr "Πολύ δυσδιάκριτη, πολύ λεπτή, πέφτει όπου επιθυμεί·τη συνείδηση ας φυλάει ο ευφυής, η φυλαγμένη συνείδηση φέρνει ευτυχία."

msgid "37"
msgstr "Αυτό που ταξιδεύει μακριά, που περιπλανιέται μόνο του, που είναι ασώματο, που κατοικεί στη σπηλιά·όσοι θα συγκρατήσουν τη συνείδηση, θα απελευθερωθούν από τα δεσμά του Μάρα."

msgid "38"
msgstr "Αυτού που η συνείδηση είναι ασταθής, που δεν κατανοεί την Άριστη Διδασκαλία·αυτού που η πεποίθηση κλονίζεται, η σοφία δεν ολοκληρώνεται."

msgid "39"
msgstr "Για αυτόν με τη συνείδηση που δεν έχει διαποτιστεί, με τον νου που δεν έχει πληγεί·Για αυτόν που έχει εγκαταλείψει την αξιέπαινη πράξη και το κακό, δεν υπάρχει φόβος για τον άγρυπνο."

msgid "40"
msgstr "Γνωρίζοντας ότι αυτό το σώμα είναι σαν πήλινο δοχείο, εδραιώνοντας αυτή τη συνείδηση σαν οχυρωμένη πόλη·Πολεμήστε τον Μάρα με το όπλο της σοφίας, και προστατεύστε αυτό που κατακτήθηκε, χωρίς να προσκολλάστε."

msgid "41"
msgstr "Σύντομα, βεβαίως, αυτό το σώμα θα κείτεται στη γη·πεταμένο, χωρίς συνείδηση, άχρηστο σαν κούτσουρο."

msgid "42"
msgstr "Ό,τι ένας εχθρός θα έκανε σε έναν εχθρό, ή ένας αντίπαλος σε έναν αντίπαλο·η λανθασμένα κατευθυνόμενη συνείδηση, χειρότερα από αυτό θα του έκανε."

msgid "43"
msgstr "Αυτό δεν θα το έκανε μητέρα ή πατέρας, ούτε και άλλοι συγγενείς·η ορθά κατευθυνόμενη συνείδηση, καλύτερα από αυτό θα του έκανε."

msgid "chap4"
msgstr "Τα Άνθη"

msgid "44"
msgstr "Ποιος θα διακρίνει αυτή τη γη, και τον κόσμο του Γιάμα αυτόν μαζί με τους θεούς;Ποιος το εδάφιο της Διδασκαλίας, καλά διδαγμένο, επιδέξιος σαν λουλούδι θα διαλέξει;"

msgid "45"
msgstr "Ο ασκούμενος θα διακρίνει αυτή τη γη, και τον κόσμο του Γιάμα αυτόν μαζί με τους θεούς·Ο ασκούμενος το εδάφιο της Διδασκαλίας, καλά διδαγμένο, επιδέξιος σαν λουλούδι θα διαλέξει."

msgid "46"
msgstr "Γνωρίζοντας ότι αυτό το σώμα είναι σαν αφρό, κατανοώντας πλήρως τη φύση του αντικατοπτρισμού·κόβοντας τα βέλη με τα λουλούδια του Μάρα, ας πάει στο αόρατο για τον βασιλιά του θανάτου."

msgid "47"
msgstr "Τον άνθρωπο που μαζεύει λουλούδια, με προσκολλημένο νου·σαν μεγάλη πλημμύρα κοιμισμένο χωριό, ο θάνατος παίρνοντάς τον φεύγει."

msgid "48"
msgstr "Τον άνθρωπο που μαζεύει λουλούδια, με προσκολλημένο νου·ανικανοποίητο ακόμη στις ηδονές, ο θάνατος τον φέρνει υπό την εξουσία του."

msgid "49"
msgstr "Όπως η μέλισσα το λουλούδι, χωρίς να βλάψει το χρώμα και την οσμή·φεύγει αφού πάρει το νέκταρ, έτσι στο χωριό ας ζει ο σοφός."

msgid "50"
msgstr "Όχι τα εχθρικά λόγια των άλλων, όχι τα πεπραγμένα και τα μη πεπραγμένα των άλλων·μόνο τον εαυτό του θα πρέπει να εξετάζει, τα πεπραγμένα και τα μη πεπραγμένα."

msgid "51"
msgstr "Όπως ένα όμορφο λουλούδι, με ωραίο χρώμα αλλά χωρίς οσμή·Έτσι ο καλά ειπωμένος λόγος, είναι άκαρπος για αυτόν που δεν τον εφαρμόζει."

msgid "52"
msgstr "Όπως ένα όμορφο λουλούδι, με ωραίο χρώμα και ευωδιαστό·Έτσι ο καλά ειπωμένος λόγος, είναι καρποφόρος για αυτόν που τον εφαρμόζει."

msgid "53"
msgstr "Όπως από έναν σωρό λουλουδιών, θα έφτιαχνε κανείς πολλά στεφάνια·Έτσι από έναν θνητό που γεννήθηκε, πρέπει να γίνει πολύ καλό."

msgid "54"
msgstr "Η οσμή του άνθους δεν πηγαίνει αντίθετα στον άνεμο, ούτε το σανταλόξυλο ή το ταγκάρα ή η γιασεμιά·αλλά η οσμή των αγαθών πηγαίνει αντίθετα στον άνεμο, το ενάρετο άτομο αποπνέει προς όλες τις κατευθύνσεις."

msgid "55"
msgstr "Το σανταλόξυλο ή το ταγκάρα, ο μπλε λωτός και η γιασεμιά·Από αυτά τα είδη αρωμάτων, η οσμή της ηθικής είναι ανυπέρβλητη."

msgid "56"
msgstr "Ασήμαντη είναι αυτή η οσμή, αυτή του ταγκάρα και του σανδαλόξυλου·αλλά η οσμή των ηθικών αποπνέει ανώτατη μεταξύ των θεών."

msgid "57"
msgstr "Αυτών που είναι τέλειοι στην ηθική, που διαμένουν με επιμέλεια·πλήρως απελευθερωμένων μέσω της τελικής γνώσης, ο Μάρα δεν βρίσκει την οδό."

msgid "58"
msgstr "Όπως σε σωρό απορριμμάτων, πεταμένο στον κεντρικό δρόμο·ένας λωτός εκεί θα φύτρωνε, καθαρά ευωδιαστός, ευχάριστος."

msgid "59"
msgstr "Έτσι ανάμεσα σε αυτούς που είναι σαν απορρίμματα, στον τυφλό κοσμικό άνθρωπο·Υπερλάμπει με σοφία, ο μαθητής του Πλήρως Αυτοφωτισμένου."

msgid "chap5"
msgstr "Οι Ανόητοι"

msgid "60"
msgstr "Μακρά είναι η νύχτα για τον άγρυπνο, μακρά είναι η γιότζανα για τον κουρασμένο·Μακρά είναι η περιπλάνηση στον κύκλο των επαναγεννήσεων για τους αδαείς, που δεν κατανοούν την Άριστη Διδασκαλία."

msgid "61"
msgstr "Αν περιπλανώμενος δεν βρει, ανώτερο ή όμοιο με τον εαυτό του·ας κάνει σταθερή τη μοναχική πορεία, δεν υπάρχει συντροφιά με τον αδαή."

msgid "62"
msgstr "'Έχω γιους, έχω πλούτη', έτσι ο αδαής ταλαιπωρείται·ο εαυτός δεν υπάρχει για τον εαυτό, πώς θα υπάρχουν γιοι, πώς θα υπάρχουν πλούτη;"

msgid "63"
msgstr "Όποιος αδαής αναγνωρίζει την αδάειά του, σοφός ή ακόμη και γι' αυτό είναι·αλλά ο αδαής που νομίζει ότι είναι σοφός, αυτός πράγματι ονομάζεται 'αδαής'."

msgid "64"
msgstr "Ακόμη κι αν ο αδαής για όλη του τη ζωή υπηρετεί τον σοφό·αυτός δεν κατανοεί τη Διδασκαλία, όπως η κουτάλα τη γεύση του καρυκεύματος."

msgid "65"
msgstr "Ακόμη κι αν ο νοήμονας για μια στιγμή υπηρετεί τον σοφό·γρήγορα κατανοεί τη Διδασκαλία, όπως η γλώσσα τη γεύση του καρυκεύματος."

msgid "66"
msgstr "Περιφέρονται οι ανόητοι, οι άφρονες, με τον εαυτό τους σαν εχθρό·κάνοντας κακόβουλη πράξη, που έχει πικρό καρπό."

msgid "67"
msgstr "Δεν είναι καλή εκείνη η πράξη που έγινε, την οποία κάνοντας μετανιώνει·της οποίας με δακρυσμένο πρόσωπο κλαίγοντας, βιώνει το επακόλουθο."

msgid "68"
msgstr "Και εκείνη η πράξη που έγινε είναι καλή, την οποία κάνοντας δεν μετανιώνει·της οποίας ικανοποιημένος, χαρούμενος, βιώνει το επακόλουθο."

msgid "69"
msgstr "Μελένιο το φαντάζεται ο αδαής, όσο το κακό δεν ωριμάζει·όταν όμως ωριμάζει το κακό, ο αδαής υφίσταται δυστυχία."

msgid "70"
msgstr "Μήνα με τον μήνα με την άκρη του χόρτου, ο αδαής θα έτρωγε τροφή·αυτός δεν αξίζει ένα δέκατο έκτο κλάσμα αυτών που έχουν κατανοήσει τη Διδασκαλία."

msgid "71"
msgstr "Διότι η κακή πράξη που έγινε δεν ωριμάζει αμέσως, όπως το γάλα·ακολουθεί τον αδαή καίγοντάς τον, όπως η φωτιά σκεπασμένη με στάχτη."

msgid "72"
msgstr "Μόνο για βλάβη, η φήμη του αδαούς γεννιέται·Καταστρέφει το ευεργετικό μερίδιο του αδαούς, συντρίβοντας τη σοφία του."

msgid "73"
msgstr "Μπορεί να ποθεί ανύπαρκτη εκτίμηση, και προβολή μεταξύ των μοναχών·και κυριαρχία στις κατοικίες, και τιμή σε ξένες οικογένειες."

msgid "74"
msgstr "'Ας νομίζουν ότι έγινε μόνο από μένα', οι οικοδεσπότες και οι αναχωρητές, και οι δύο·'Ας είναι υπό τον έλεγχό μου μόνο', σε οποιαδήποτε υπόθεση μικρή ή μεγάλη·έτσι είναι ο λογισμός του αδαούς, ο πόθος και η αλαζονεία αυξάνονται."

msgid "75"
msgstr "Διότι άλλη είναι η κοντινή αιτία για υλικό κέρδος, άλλη αυτή που οδηγεί στο Νιμπάνα·Έτσι αυτό έχοντας άμεσα γνωρίσει, ο μοναχός μαθητής του Βούδα·Δεν θα έπρεπε να απολαμβάνει την τιμή, θα έπρεπε να καλλιεργεί την απομόνωση."

msgid "chap6"
msgstr "Ο Σοφός"

msgid "76"
msgstr "Σαν αυτόν που αποκαλύπτει θησαυρούς, όποιον βλέπει να επισημαίνει τα σφάλματα·αυτόν που επιπλήττει, τον συνετό, έναν τέτοιο σοφό να συναναστρέφεσαι·για αυτόν που συναναστρέφεται έναν τέτοιο, γίνεται καλύτερος, όχι χειρότερος."

msgid "77"
msgstr "Θα πρέπει να προτρέπει και να καθοδηγεί, και να αποτρέπει από τα ανάρμοστα·αυτός είναι αγαπητός στους αγαθούς, στους μη αγαθούς είναι μη αγαπητός."

msgid "78"
msgstr "Μη συναναστρέφεσαι κακούς φίλους, μη συναναστρέφεσαι κατώτερους ανθρώπους·να συναναστρέφεσαι καλούς φίλους, να συναναστρέφεσαι άριστους ανθρώπους."

msgid "79"
msgstr "Αυτός που πίνει τη Διδασκαλία κοιμάται ευτυχισμένος, με γαλήνιο νου·στη Διδασκαλία που κήρυξε ο Ευγενής, πάντα ευχαριστιέται ο σοφός."

msgid "80"
msgstr "Οι αρδευτές κατευθύνουν το νερό, οι κατασκευαστές βελών ισιώνουν το βέλος·οι ξυλουργοί λυγίζουν το ξύλο, οι σοφοί δαμάζουν τον εαυτό τους."

msgid "81"
msgstr "Όπως ένας βράχος συμπαγής, δεν ταράσσεται από τον άνεμο·Έτσι στην κατηγορία και στον έπαινο, δεν κλονίζονται οι σοφοί."

msgid "82"
msgstr "Όπως μια λίμνη βαθιά, διαυγής, χωρίς θολότητα·Έτσι ακούγοντας τις διδασκαλίες, οι σοφοί γαληνεύουν."

msgid "83"
msgstr "Παντού πράγματι τα ενάρετα άτομα εγκαταλείπουν, δεν φλυαρούν οι γαλήνιοι επιθυμώντας ηδονές·είτε από ευτυχία αγγιγμένοι είτε από δυστυχία, οι σοφοί δεν δείχνουν διακυμάνσεις."

msgid "84"
msgstr "Ούτε για χάρη του εαυτού του ούτε για χάρη άλλου, ούτε γιο να ποθεί ούτε πλούτη ούτε βασίλειο·ούτε θα ποθούσε την ευημερία του εαυτού του με αδικία, αυτός θα ήταν ηθικός, σοφός, δίκαιος."

msgid "85"
msgstr "'Λίγοι είναι αυτοί μεταξύ των ανθρώπων, οι άνθρωποι που πηγαίνουν στην άλλη όχθη·ενώ αυτή η υπόλοιπη γενιά τρέχει κατά μήκος της όχθης."

msgid "86"
msgstr "'Όσοι όμως στην ορθά διακηρυγμένη Διδασκαλία ακολουθούν τη Διδασκαλία·αυτοί οι άνθρωποι θα φτάσουν στην άλλη όχθη, διασχίζοντας το βασίλειο του θανάτου τόσο δύσκολο να διαβεί."

msgid "87"
msgstr "Εγκαταλείποντας τη σκοτεινή κατάσταση, ο σοφός ας αναπτύσσει τη φωτεινή·από το σπίτι στην αστεγία έχοντας έρθει, στην απομόνωση όπου είναι δύσκολο να απολαύσει."

msgid "88"
msgstr "Εκεί ας επιθυμεί την ευχαρίστηση, έχοντας εγκαταλείψει τις ηδονές, μη κατέχοντας τίποτα·ας καθαρίσει τον εαυτό του ο σοφός από τις νοητικές μολύνσεις της συνείδησης."

msgid "89"
msgstr "Αυτοί των οποίων στους παράγοντες της φώτισης η συνείδηση είναι ορθά καλά αναπτυγμένη·στην παραίτηση από την κατοχή, μέσω της μη προσκόλλησης αυτοί που χαίρονται·έχοντας εξαλείψει τις νοητικές διαφθορές, λαμπροί, αυτοί στον κόσμο έχουν επιτύχει το τελικό Νιμπάνα."

msgid "chap7"
msgstr "Οι Άξιοι"

msgid "90"
msgstr "Για αυτόν που έχει ολοκληρώσει το ταξίδι, που είναι χωρίς λύπη, που είναι πλήρως απελευθερωμένος παντού·για αυτόν που έχει εγκαταλείψει όλους τους νοητικούς κόμβους, πυρετός δεν υπάρχει."

msgid "91"
msgstr "Οι έχοντες μνήμη προσπαθούν, δεν χαίρονται στην κατοικία αυτοί·όπως κύκνοι εγκαταλείποντας τη λίμνη, κάθε κατοικία εγκαταλείπουν αυτοί."

msgid "92"
msgstr "Αυτοί για τους οποίους δεν υπάρχει συσσώρευση, αυτοί που έχουν πλήρως κατανοήσει την τροφή·Κενότητα και χωρίς χαρακτηριστικά, απολύτρωση είναι το πεδίο τους·Όπως των πουλιών στον ουρανό, ο προορισμός τους είναι δύσκολο να ανιχνευθεί."

msgid "93"
msgstr "Αυτού που οι νοητικές διαφθορές έχουν εξαλειφθεί, και στην τροφή είναι ανεξάρτητος·Κενότητα και χωρίς χαρακτηριστικά, απολύτρωση είναι το πεδίο του·Όπως των πουλιών στον ουρανό, η πορεία του είναι δύσκολο να ανιχνευθεί."

msgid "94"
msgstr "Αυτός του οποίου οι ικανότητες έχουν φτάσει σε ηρεμία, όπως άλογα καλά δαμασμένα από αμαξηλάτη·αυτού που έχει εγκαταλείψει την αλαζονεία, που είναι χωρίς νοητικές διαφθορές, ακόμη και οι θεοί τον ζηλεύουν, τον ακλόνητο."

msgid "95"
msgstr "Όμοιος με τη γη δεν αντιδρά, όμοιος με την πύλη, ακλόνητος, καλής διαγωγής·σαν λίμνη χωρίς λάσπη, περιπλανήσεις στον κύκλο των επαναγεννήσεων δεν υπάρχουν για τον ακλόνητο."

msgid "96"
msgstr "Γαλήνιος είναι ο νους του, γαλήνια η ομιλία και η πράξη·στον πλήρως απελευθερωμένο μέσω της τελικής γνώσης, στον γαλήνιο, τον ακλόνητο."

msgid "97"
msgstr "Όποιος άνθρωπος είναι άπιστος και γνωρίζει το αδημιούργητο, και έχει κόψει τη σύνδεση·έχει καταστρέψει την ευκαιρία, έχει απορρίψει την ελπίδα, αυτός πράγματι είναι ο ύψιστος άνθρωπος."

msgid "98"
msgstr "Σε χωριό ή σε δάσος, σε κοιλάδα ή σε στεριά·όπου διαμένουν οι Άξιοι, εκείνο το μέρος είναι ευχάριστο."

msgid "99"
msgstr "Απολαυστικά είναι τα δάση, όπου ο κόσμος δεν χαίρεται·αυτοί χωρίς πάθος θα χαρούν, αυτοί δεν αναζητούν ηδονές."

msgid "chap8"
msgstr "Οι Χιλιάδες"

msgid "100"
msgstr "Ακόμα κι αν χίλιες λέξεις, συνδέονται με ανώφελα εδάφια·ένα ωφέλιμο εδάφιο είναι καλύτερο, ακούγοντας το οποίο κάποιος ηρεμεί."

msgid "101"
msgstr "Ακόμα κι αν χίλιοι στίχοι, συνδέονται με ανώφελα εδάφια·ένα εδάφιο στίχου είναι καλύτερο, ακούγοντας το οποίο κάποιος ηρεμεί."

msgid "102"
msgstr "Κι αν κάποιος εκατό στίχους απαγγείλει, συνδεδεμένους με ανώφελα εδάφια·ένα εδάφιο της Διδασκαλίας είναι καλύτερο, ακούγοντας το οποίο κάποιος ηρεμεί."

msgid "103"
msgstr "Όποιος χίλιους επί χίλιους, σε μάχη ανθρώπους νικήσει·αλλά έναν νικήσει, τον εαυτό του, αυτός πράγματι είναι ο ανώτατος νικητής της μάχης."

msgid "104"
msgstr "Η νίκη επί του εαυτού πράγματι είναι καλύτερη, από αυτή την υπόλοιπη γενιά·σε ένα άτομο που έχει δαμάσει τον εαυτό του, που πάντα βαδίζει με αυτοσυγκράτηση."

msgid "105"
msgstr "Ούτε θεός ούτε γκαντχάμπα, ούτε Μάρα μαζί με τον Βράχμα·θα μπορούσε να κάνει τη νίκη ήττα, ενός τέτοιου είδους όντος."

msgid "106"
msgstr "Μήνα με τον μήνα με χίλια, όποιος θυσιάζει για εκατό χρόνια·κι έναν με αναπτυγμένο εαυτό, ακόμη και για μια στιγμή τιμήσει·αυτή η τιμή είναι καλύτερη, από ό,τι εκατό χρόνια προσφορά."

msgid "107"
msgstr "Κι αυτός που εκατό χρόνια, το πλάσμα, περιποιείται τη φωτιά στο δάσος·κι έναν με αναπτυγμένο εαυτό, ακόμη και για μια στιγμή τιμήσει·αυτή η τιμή είναι καλύτερη, από ό,τι εκατό χρόνια προσφορά."

msgid "108"
msgstr "Οποιαδήποτε θυσία ή προσφορά στον κόσμο, για ένα χρόνο θα πρόσφερε αυτός που επιθυμεί αξιέπαινη πράξη·όλο αυτό δεν φτάνει ούτε το ένα τέταρτο, η απόδοση σεβασμού σε αυτούς που πορεύονται ευθέως είναι καλύτερη."

msgid "109"
msgstr "Σε αυτόν που έχει τη συνήθεια να αποδίδει σεβασμό, που πάντα τιμά τους μεγαλύτερους·τέσσερα φαινόμενα αυξάνονται, ζωή, ομορφιά, ευτυχία και δύναμη."

msgid "110"
msgstr "Κι αυτός που εκατό χρόνια ζει, ανήθικος, μη αυτοσυγκεντρωμένος·μια μέρα ζωής είναι καλύτερη, του ηθικού διαλογιστή."

msgid "111"
msgstr "Κι αυτός που εκατό χρόνια ζει, άσοφος, μη αυτοσυγκεντρωμένος·μια μέρα ζωής είναι καλύτερη, του σοφού διαλογιστή."

msgid "112"
msgstr "Κι αυτός που εκατό χρόνια ζει, οκνηρός, με μικρή ενεργητικότητα·μια μέρα ζωής είναι καλύτερη, αυτού που αναπτύσσει σταθερή ενεργητικότητα."

msgid "113"
msgstr "Κι αυτός που εκατό χρόνια ζει, μη βλέποντας την έγερση και την παρακμή·μια μέρα ζωής είναι καλύτερη, αυτού που βλέπει την έγερση και την παρακμή."

msgid "114"
msgstr "Κι αυτός που εκατό χρόνια ζει, μη βλέποντας την αθάνατη κατάσταση·μια μέρα ζωής είναι καλύτερη, αυτού που βλέπει την αθάνατη κατάσταση."

msgid "115"
msgstr "Κι αυτός που εκατό χρόνια ζει, μη βλέποντας την ύψιστη Διδασκαλία·μια μέρα ζωής είναι καλύτερη, αυτού που βλέπει την ύψιστη Διδασκαλία."

msgid "chap9"
msgstr "Ο Κακός"

msgid "116"
msgstr "Να σπεύδετε στο καλό, να συγκρατείτε τη συνείδηση από το κακό·γιατί σε αυτόν που κάνει αργά την αξιέπαινη πράξη, ο νους χαίρεται στο κακό."

msgid "117"
msgstr "Αν ένας άνθρωπος έκανε κακό, ας μην το κάνει ξανά και ξανά·ας μην αναπτύσσει επιθυμία για αυτό, η συσσώρευση του κακού είναι δυστυχία."

msgid "118"
msgstr "Αν ένας άνθρωπος έκανε αξιέπαινη πράξη, ας την κάνει ξανά και ξανά·ας αναπτύσσει επιθυμία για αυτήν, η συσσώρευση αξιέπαινων πράξεων είναι ευτυχία."

msgid "119"
msgstr "Ακόμη και ο κακός βλέπει καλό, όσο το κακό δεν ωριμάζει·όταν όμως ωριμάζει το κακό, τότε ο κακός βλέπει κακά."

msgid "120"
msgstr "Ακόμη και ο καλός βλέπει κακό, όσο το καλό δεν ωριμάζει·όταν όμως ωριμάζει το καλό, τότε ο καλός βλέπει καλά."

msgid "121"
msgstr "Ας μην περιφρονεί κανείς το κακό, 'δεν θα έρθει σε μένα'·με την πτώση σταγόνων νερού, ακόμη και η στάμνα γεμίζει·ο αδαής γεμίζει με κακό, συσσωρεύοντας λίγο λίγο."

msgid "122"
msgstr "Ας μην περιφρονεί κανείς την αξιέπαινη πράξη, 'δεν θα έρθει σε μένα'·με την πτώση σταγόνων νερού, ακόμη και η στάμνα γεμίζει·ο σοφός γεμίζει με αξιέπαινες πράξεις, συσσωρεύοντας λίγο λίγο."

msgid "123"
msgstr "Όπως έμπορος με μεγάλο πλούτο και μικρό καραβάνι αποφεύγει τον επικίνδυνο δρόμο·όπως αυτός που επιθυμεί να ζήσει αποφεύγει το δηλητήριο, έτσι ας αποφεύγει τα κακά."

msgid "124"
msgstr "Αν στην παλάμη δεν υπήρχε πληγή, θα μπορούσε να κρατήσει δηλητήριο με την παλάμη·το δηλητήριο δεν διεισδύει σε αυτήν χωρίς πληγή, δεν υπάρχει κακό για αυτόν που δεν το διαπράττει."

msgid "125"
msgstr "Όποιος βλάπτει έναν άνθρωπο αβλαβή, αγνό άτομο χωρίς νοητική κηλίδα·σε αυτόν ακριβώς τον αδαή επιστρέφει το κακό, όπως λεπτοφυής σκόνη πεταμένη αντίθετα στον άνεμο."

msgid "126"
msgstr "Στη μήτρα κάποιοι γεννιούνται, στην κόλαση οι κακοπράγμονες·στον παράδεισο οι καλότυχοι πηγαίνουν, επιτυγχάνουν το τελικό Νιμπάνα αυτοί χωρίς νοητικές διαφθορές."

msgid "127"
msgstr "Ούτε στο μεσουράνημα ούτε στο μέσον του ωκεανού, ούτε εισερχόμενος σε σπήλαιο βουνών·δεν υπάρχει εκείνο το μέρος του κόσμου, όπου στεκόμενος θα απαλλασσόταν από τις κακόβουλες πράξεις."

msgid "128"
msgstr "Ούτε στο μεσουράνημα ούτε στο μέσον του ωκεανού, ούτε εισερχόμενος σε σπήλαιο βουνών·δεν υπάρχει εκείνο το μέρος του κόσμου, όπου στεκόμενος ο θάνατος δεν θα τον κατανικούσε."

msgid "chap10"
msgstr "Η Βία"

msgid "129"
msgstr "Όλοι τρέμουν το ραβδί, όλοι φοβούνται τον θάνατο·θεωρώντας τον εαυτό σου ως παράδειγμα, μην σκοτώνεις μήτε να βάζεις άλλους να σκοτώνουν."

msgid "130"
msgstr "Όλοι τρέμουν το ραβδί, για όλους η ζωή είναι αγαπητή·θεωρώντας τον εαυτό σου ως παράδειγμα, μην σκοτώνεις μήτε να βάζεις άλλους να σκοτώνουν."

msgid "131"
msgstr "Τα πλάσματα που επιθυμούν την ευτυχία, όποιος με ραβδί τα κακοποιεί·αναζητώντας την ευτυχία για τον εαυτό του, πεθαίνοντας αυτός δεν αποκτά ευτυχία."

msgid "132"
msgstr "Τα πλάσματα που επιθυμούν την ευτυχία, όποιος με ραβδί δεν τα βλάπτει·αναζητώντας την ευτυχία για τον εαυτό του, πεθαίνοντας αυτός αποκτά ευτυχία."

msgid "133"
msgstr "Μην πεις σκληρά λόγια σε κανέναν, αυτοί που τα άκουσαν θα σου απαντήσουν·Διότι η ομιλία με ένταση είναι οδυνηρή, αντίποινα θα σε βρουν."

msgid "134"
msgstr "Αν δεν ταράξεις τον εαυτό σου, όπως ένα κύμβαλο σπασμένο·αυτός έφτασες στη Νιμπάνα, αντιζηλία σε σένα δεν υπάρχει."

msgid "135"
msgstr "Όπως με ραβδί ο βοσκός, τις αγελάδες οδηγεί στο βοσκοτόπι·Έτσι το γήρας και ο θάνατος, τη ζωή οδηγούν των ζωντανών."

msgid "136"
msgstr "Τότε ο αδαής που κάνει κακές πράξεις δεν κατανοεί·ο άφρονας βασανίζεται από τις δικές του πράξεις, σαν καμένος από φωτιά."

msgid "137"
msgstr "Όποιος με ραβδί τους αβλαβείς, τους αμόλυντους βλάπτει·μία από δέκα καταστάσεις, γρήγορα θα υποστεί."

msgid "138"
msgstr "Σκληρό αίσθημα, απώλεια, και σπάσιμο του σώματος·ή ακόμη και βαριά ασθένεια, και διατάραξη του νου θα φτάσει."

msgid "139"
msgstr "ή δυστυχία από τον βασιλιά, και σκληρή συκοφαντία·και πλήρη εξάλειψη των συγγενών, και καταστροφή των πλούτων."

msgid "140"
msgstr "Ή τα σπίτια του, η φωτιά καίει η πύρινη·με την κατάρρευση του σώματος ο άσοφος, επαναγεννιέται στην κόλαση."

msgid "141"
msgstr "Ούτε η γυμνή περιπλάνηση, ούτε τα πλεγμένα μαλλιά, ούτε ο βούρκος, ούτε η νηστεία ή ο ύπνος στο γυμνό έδαφος·η σκόνη και η βρωμιά, η επίμονη προσπάθεια σε οκλάζουσα στάση, δεν καθαρίζουν τον θνητό που δεν έχει διαβεί την αβεβαιότητα."

msgid "142"
msgstr "Ακόμη κι αν στολισμένος συμπεριφέρεται δίκαια, γαλήνιος, δαμασμένος, βέβαιος, ασκούμενος στην άγια ζωή·έχοντας αποθέσει την τιμωρία σε όλα τα όντα, αυτός είναι βραχμάνος, αυτός είναι ασκητής, αυτός είναι μοναχός."

msgid "143"
msgstr "Ένας άνθρωπος που συγκρατείται από την ντροπή, υπάρχει κάποιος τέτοιος στον κόσμο;Αυτός που αποδιώχνει τον ύπνο, όπως ένα καλό άλογο το μαστίγιο."

msgid "144"
msgstr "Όπως ένα καλό άλογο που χτυπήθηκε από μαστίγιο, γίνετε ενεργητικοί και με αίσθηση επείγοντος·με πίστη και ηθική και ενεργητικότητα, με αυτοσυγκέντρωση και κρίση των φαινομένων·τέλειοι στην αληθινή γνώση και τη συμπεριφορά, μνήμονες, θα εγκαταλείψετε αυτή την όχι λίγη δυστυχία."

msgid "145"
msgstr "Οι αρδευτές κατευθύνουν το νερό, οι κατασκευαστές βελών ισιώνουν το βέλος·οι ξυλουργοί λυγίζουν το ξύλο, οι καλοσυμπεριφερόμενοι δαμάζουν τον εαυτό τους."

msgid "chap11"
msgstr "Τα Γηρατειά"

msgid "146"
msgstr "Τι γέλιο, τι χαρά, όταν συνεχώς φλέγεται;Καλυμμένοι από σκοτάδι, δεν αναζητάτε το φως;"

msgid "147"
msgstr "Δες αυτό το ομοίωμα στολισμένο, ένα σώμα γεμάτο πληγές, υψωμένο·άρρωστο, αντικείμενο πολλών σκέψεων, του οποίου δεν υπάρχει σταθερή διάρκεια."

msgid "148"
msgstr "Αυτό το σώμα είναι φθαρμένο, φωλιά ασθενειών, εύθραυστο·Διαλύεται αυτή η σάπια μάζα, διότι η ζωή έχει τον θάνατο ως τέλος."

msgid "149"
msgstr "Αυτά τα πεταμένα οστά, σαν κολοκύθες το φθινόπωρο·Γκριζωπά οστά, βλέποντάς τα ποια ευχαρίστηση;"

msgid "150"
msgstr "Από οστά έχει φτιαχτεί η πόλη, με σάρκα και αίμα επιχρισμένη·όπου το γήρας και ο θάνατος, η αλαζονεία και η περιφρόνηση έχουν τοποθετηθεί."

msgid "151"
msgstr "Γηράσκουν πράγματι τα βασιλικά άρματα τα όμορφα διακοσμημένα, και επίσης το σώμα υφίσταται το γήρας·αλλά η Διδασκαλία των αγαθών δεν υφίσταται το γήρας, οι αγαθοί πράγματι το διακηρύσσουν μαζί με τους αγαθούς."

msgid "152"
msgstr "Ο ολιγομαθής αυτός άνθρωπος, γερνά σαν βόδι·οι σάρκες του αυξάνονται, η σοφία του δεν αυξάνεται."

msgid "153"
msgstr "Μέσα από αμέτρητες γεννήσεις στον κύκλο των επαναγεννήσεων, περιπλανήθηκα χωρίς να βρω·Αναζητώντας τον οικοδόμο του σπιτιού, οδυνηρή η γέννηση ξανά και ξανά."

msgid "154"
msgstr "Κτίστη του σπιτιού, έχεις ιδωθεί, πάλι σπίτι δεν θα κτίσεις·Όλα σου τα δοκάρια έχουν σπάσει, η κορυφή του σπιτιού έχει αποσυντεθεί·Η συνείδηση έχει φτάσει στο ασυνθηκοκράτητο, έχει επιτύχει την εξάλειψη των επιθυμιών."

msgid "155"
msgstr "Μη ακολουθήσαντες την άγια ζωή, μη αποκτήσαντες πλούτη στη νεότητα·σαν γερασμένοι ερωδιοί θρηνούν, σε λίμνη με εξαντλημένα ψάρια."

msgid "156"
msgstr "Μη ακολουθήσαντες την άγια ζωή, μη αποκτήσαντες πλούτη στη νεότητα·κείτονται σαν βέλη εξαντλημένα από το τόξο, θρηνώντας για τα παλιά."

msgid "chap12"
msgstr "Ο Εαυτός"

msgid "157"
msgstr "Αν γνωρίζει κανείς τον εαυτό του ως αγαπητό, θα τον προστατεύει καλά προστατευμένο·κάποια από τις τρεις περιόδους, ο σοφός θα φροντίζει."

msgid "158"
msgstr "Τον εαυτό του πρώτα, στο πρέπον ας εδραιώσει·έπειτα τους άλλους ας καθοδηγεί, δεν θα μολυνθεί ο σοφός."

msgid "159"
msgstr "Αν κάποιος έκανε τον εαυτό του έτσι, όπως καθοδηγεί τους άλλους·καλά δαμασμένος πράγματι θα δάμαζε, ο εαυτός βεβαίως είναι δύσκολο να δαμαστεί."

msgid "160"
msgstr "Ο εαυτός είναι ο προστάτης του εαυτού, ποιος άλλος θα μπορούσε να είναι προστάτης;Διότι με τον εαυτό καλά δαμασμένο, αποκτά προστάτη δυσεύρετο."

msgid "161"
msgstr "Το κακό που έγινε από τον ίδιο, γεννημένο από τον εαυτό, με προέλευση τον εαυτό·συντρίβει τον άφρονα, όπως το διαμάντι τον πολύτιμο λίθο από πέτρα."

msgid "162"
msgstr "Αυτού που η απόλυτη ανηθικότητα, όπως αναρριχητικό φυτό δέντρο σάλα έχει καλύψει·αυτός κάνει τον εαυτό του έτσι, όπως τον επιθυμεί ο εχθρός."

msgid "163"
msgstr "Εύκολα είναι τα κακά, και επιβλαβή για τον εαυτό·αυτό που πράγματι είναι ωφέλιμο και καλό, αυτό πράγματι είναι εξαιρετικά δύσκολο."

msgid "164"
msgstr "Όποιος τη Διδαχή των Αξίων, των ευγενών που ζουν σύμφωνα με τη Διδασκαλία·απορρίπτει ο άφρονας, βασιζόμενος σε κακόβουλη άποψη·σαν τους καρπούς του μπαμπού, καρποφορεί για την καταστροφή του εαυτού του."

msgid "165"
msgstr "Το κακό που έγινε από τον ίδιο, από τον ίδιο μολύνεται·Το κακό που δεν έγινε από τον ίδιο, από τον ίδιο εξαγνίζεται·Αγνότητα και ακαθαρσία είναι ατομικές, κανείς άλλος δεν μπορεί να εξαγνίσει άλλον."

msgid "166"
msgstr "Το δικό του καλό με το καλό των άλλων, ακόμη και με πολλά, να μην εγκαταλείπει·Αναγνωρίζοντας το δικό του καλό, στο δικό του καλό να είναι αφοσιωμένος."

msgid "chap13"
msgstr "Ο Κόσμος"

msgid "167"
msgstr "Μην ακολουθεί κανείς κατώτερη κατάσταση, μην ζει με αμέλεια·μην ακολουθεί κανείς λανθασμένη άποψη, μην γίνεται αυτός που αυξάνει τον κόσμο."

msgid "168"
msgstr "Δεν πρέπει να αμελεί στην ελεημοσύνη, ας ασκεί τη Διδασκαλία με καλή συμπεριφορά·αυτός που ζει σύμφωνα με τη Διδασκαλία κοιμάται ευτυχισμένος, σε αυτόν τον κόσμο και στον άλλο."

msgid "169"
msgstr "Ας ασκεί τη Διδασκαλία με καλή συμπεριφορά, ας μην την ασκεί με κακή συμπεριφορά·αυτός που ζει σύμφωνα με τη Διδασκαλία κοιμάται ευτυχισμένος, σε αυτόν τον κόσμο και στον άλλο."

msgid "170"
msgstr "Όπως θα έβλεπε μια φυσαλίδα, όπως θα έβλεπε μια οφθαλμαπάτη·αυτόν που έτσι παρατηρεί τον κόσμο, ο βασιλιάς του θανάτου δεν τον βλέπει."

msgid "171"
msgstr "Ελάτε, δείτε αυτόν τον κόσμο, στολισμένο σαν βασιλικό άρμα·όπου οι ανόητοι βυθίζονται, δεν υπάρχει προσκόλληση για αυτούς που συνειδητοποιούν."

msgid "172"
msgstr "Όποιος πρώτα αμέλησε, αλλά μετά δεν αμελεί·αυτός φωτίζει αυτόν τον κόσμο, όπως η σελήνη ελευθερωμένη από τα σύννεφα."

msgid "173"
msgstr "Εκείνου του οποίου η κακή πράξη που έγινε καλύπτεται από το καλό·αυτός φωτίζει αυτόν τον κόσμο, όπως η σελήνη ελευθερωμένη από τα σύννεφα."

msgid "174"
msgstr "Τυφλός έχει γίνει αυτός ο κόσμος, λίγοι εδώ βλέπουν με διόραση·Όπως πουλί που ξέφυγε από δίχτυ, λίγοι πηγαίνουν στον ουράνιο κόσμο."

msgid "175"
msgstr "Οι χήνες στο μονοπάτι του ήλιου πηγαίνουν, στον ουρανό πηγαίνουν με υπερφυσική δύναμη·οι σοφοί εξέρχονται από τον κόσμο, έχοντας νικήσει τον Μάρα μαζί με τον στρατό του."

msgid "176"
msgstr "Για αυτόν που έχει παραβεί μία αρχή, για το ψεύτη όν·για αυτόν που έχει απορρίψει τον μεταθανάτιο κόσμο, δεν υπάρχει κακό που δεν θα έκανε."

msgid "177"
msgstr "Οι φιλάργυροι πράγματι δεν πηγαίνουν στον κόσμο των θεών, οι ανόητοι πράγματι δεν επαινούν τη δωρεά·αλλά ο σοφός που δίνει ευχαριστίες για τη δωρεά, γι' αυτό ακριβώς αυτός γίνεται ευτυχισμένος στην επόμενη ζωή."

msgid "178"
msgstr "Με τη μοναδική βασιλεία της γης, ή με την πορεία προς τον παράδεισο·με την κυριαρχία σε όλο τον κόσμο, ο καρπός της εισόδου στο ρεύμα είναι άριστος."

msgid "chap14"
msgstr "Οι Βούδες"

msgid "179"
msgstr "Αυτός του οποίου η νίκη δεν ανατρέπεται, η νίκη του οποίου κανείς στον κόσμο δεν ακολουθεί·αυτόν τον Βούδα με το άπειρο πεδίο, χωρίς ίχνος, με ποια πορεία θα τον οδηγήσετε;"

msgid "180"
msgstr "Αυτός στον οποίο η παγιδευτική, η κολλώδης επιθυμία δεν υπάρχει για να τον οδηγήσει πουθενά·αυτόν τον Βούδα με το άπειρο πεδίο, χωρίς ίχνος, με ποια πορεία θα τον οδηγήσετε;"

msgid "181"
msgstr "Οι σοφοί που είναι αφοσιωμένοι στη διαλογιστική έκσταση, που χαίρονται στη γαλήνη της απάρνησης·ακόμη και οι θεοί τους ζηλεύουν, τους Αυτοφωτισμένους που έχουν επίγνωση."

msgid "182"
msgstr "Δύσκολη είναι η απόκτηση ανθρώπινης ύπαρξης, δύσκολη είναι η ζωή των θνητών·Δύσκολη είναι η ακοή της Άριστης Διδασκαλίας, δύσκολη είναι η έγερση των Βουδών."

msgid "183"
msgstr "Η μη-εκτέλεση κάθε κακού, η απόκτηση του καλού·ο καθαρισμός του δικού του νου, αυτή είναι η διδασκαλία των Βουδών."

msgid "184"
msgstr "Η υπομονή είναι ο υπέρτατος ασκητισμός, η ανοχή, το Νιμπάνα είναι το υπέρτατο, λένε οι Βούδες·διότι δεν είναι αναχωρητής αυτός που βλάπτει άλλους, δεν είναι ασκητής αυτός που κακοποιεί άλλους."

msgid "185"
msgstr "Η μη κατηγορία, η μη βλάβη, η αυτοσυγκράτηση στον κύριο μοναστικό κώδικα·η μετριοπάθεια στην τροφή, και η απομονωμένη κατοικία·και η προσπάθεια στην ανώτερη συνείδηση, αυτή είναι η διδασκαλία των Βουδών."

msgid "186"
msgstr "Ούτε με βροχή νομισμάτων, ικανοποίηση στις ηδονές υπάρχει·Με λίγη απόλαυση, οδυνηρές οι ηδονές, έτσι αναγνωρίζοντας ο σοφός."

msgid "187"
msgstr "Ακόμη και στις ουράνιες ηδονές, αυτός δεν βρίσκει τέρψη·χαίρεται στην εξάλειψη της επιθυμίας, ο μαθητής του Πλήρως Αυτοφωτισμένου."

msgid "188"
msgstr "Πολλά πράγματι ως καταφύγιο πηγαίνουν, βουνά και δάση·πάρκα, δέντρα και ιερά, οι άνθρωποι απειλούμενοι από φόβο."

msgid "189"
msgstr "Αυτό δεν είναι ασφαλές καταφύγιο, αυτό δεν είναι το ύψιστο καταφύγιο·καταφεύγοντας σε αυτό το καταφύγιο, δεν απελευθερώνεται κανείς από κάθε δυστυχία."

msgid "190"
msgstr "Όποιος όμως στον Βούδα και στη Διδασκαλία, και στην Κοινότητα ως καταφύγιο έχει πάει·τις τέσσερις ευγενείς αλήθειες, με ορθή σοφία βλέπει."

msgid "191"
msgstr "τον υπαρξιακό πόνο, την προέλευση του υπαρξιακού πόνου, και την υπέρβαση του υπαρξιακού πόνου·και την ευγενή οκταπλή οδό, που οδηγεί στη γαλήνη από τον υπαρξιακό πόνο."

msgid "192"
msgstr "Αυτό είναι το ασφαλές καταφύγιο, αυτό είναι το ύψιστο καταφύγιο·καταφεύγοντας σε αυτό το καταφύγιο, απελευθερώνεται κανείς από κάθε δυστυχία."

msgid "193"
msgstr "Σπάνιος είναι ο εξαίρετος άνθρωπος, αυτός δεν γεννιέται παντού·Όπου αυτός ο σοφός γεννιέται, εκείνη η οικογένεια ευημερεί στην ευτυχία."

msgid "194"
msgstr "Ευτυχία είναι η έγερση των Βουδών, ευτυχία είναι η διδαχή της Άριστης Διδασκαλίας·Ευτυχία είναι η ομόνοια της Κοινότητας, ο αυστηρός ασκητισμός αυτών που είναι σε ομόνοια είναι ευτυχία."

msgid "195"
msgstr "Αυτός που τιμά τους άξιους τιμής, τους Βούδες ή τους μαθητές·αυτούς που έχουν ξεπεράσει τις εμμονές, που έχουν διαβεί τη λύπη και τον θρήνο."

msgid "196"
msgstr "Αυτός που τιμά τέτοιους, κατασβεσμένους, χωρίς φόβο από πουθενά·η αξιέπαινη πράξη δεν μπορεί να υπολογιστεί, ούτε τόσο δα από κανέναν."

msgid "chap15"
msgstr "Η Ευτυχία"

msgid "197"
msgstr "Πράγματι ευτυχισμένα ζούμε, χωρίς έχθρα μεταξύ εχθρικών·μεταξύ εχθρικών ανθρώπων, διαμένουμε χωρίς έχθρα."

msgid "198"
msgstr "Πράγματι ευτυχισμένα ζούμε, χωρίς ασθένεια μεταξύ ασθενών·μεταξύ ασθενών ανθρώπων, διαμένουμε χωρίς ασθένεια."

msgid "199"
msgstr "Πράγματι ευτυχισμένα ζούμε, χωρίς ανησυχία μεταξύ ανήσυχων·μεταξύ ανήσυχων ανθρώπων, διαμένουμε χωρίς ανησυχία."

msgid "200"
msgstr "Πράγματι ευτυχισμένα ζούμε, εμείς που δεν έχουμε καμία κατοχή·θα τρεφόμαστε με αγαλλίαση, όπως οι ακτινοβόλοι θεοί."

msgid "201"
msgstr "Ο νικητής γεννά έχθρα, ο ηττημένος κοιμάται με πόνο·ο γαλήνιος κοιμάται ευτυχισμένος, αφού εγκατέλειψε νίκη και ήττα."

msgid "202"
msgstr "Δεν υπάρχει φωτιά όμοια με τη λαγνεία, δεν υπάρχει ατυχία όμοια με το μίσος·Δεν υπάρχουν βάσανα όμοια με τα συναθροίσματα, δεν υπάρχει ευτυχία πέρα από την ειρήνη."

msgid "203"
msgstr "Η πείνα είναι η υπέρτατη αρρώστια, οι δραστηριότητες είναι η υπέρτατη οδύνη·Αυτό γνωρίζοντας όπως πραγματικά είναι, το Νιμπάνα είναι η υπέρτατη ευδαιμονία."

msgid "204"
msgstr "Η υγεία είναι το ύψιστο κέρδος, η ικανοποίηση είναι ο υπέρτατος πλούτος·Η εμπιστοσύνη είναι ο ύψιστος συγγενής, το Νιμπάνα είναι η υπέρτατη ευδαιμονία."

msgid "205"
msgstr "Έχοντας πιει τη γεύση της μοναξιάς, και τη γεύση της γαλήνης·γίνεται χωρίς οδύνη, χωρίς κακό, πίνοντας τη γεύση της χαράς της Διδασκαλίας."

msgid "206"
msgstr "Καλή είναι η θέαση των ευγενών, η συμβίωση πάντα ευτυχής·με τη μη θέαση των αδαών, μόνιμα ευτυχισμένος θα ήταν κανείς."

msgid "207"
msgstr "Αυτός που συναναστρέφεται με αδαείς, θλίβεται για μεγάλο χρονικό διάστημα·η συγκατοικία με αδαείς είναι δυστυχία, όπως με εχθρό για πάντα·αλλά ο σοφός είναι ευχάριστος στη συμβίωση, όπως η συνάντηση με συγγενείς."

msgid "208"
msgstr "Γι' αυτό λοιπόν -τον σταθερό και σοφό και πολυμαθή, με ηθική που σηκώνει το βάρος, τον ευγενή με ασκητικές πρακτικές·έναν τέτοιο ενάρετο άνθρωπο, τον συνετό, να συναναστρέφεσαι, όπως η σελήνη την ατραπό των άστρων."

msgid "chap16"
msgstr "Η Αγάπη"

msgid "209"
msgstr "Αφοσιώνοντας τον εαυτό του σε αυτό που δεν αξίζει προσπάθεια, και μη αφοσιωνόμενος σε αυτό που αξίζει· εγκαταλείποντας το όφελος, αρπάζοντας το ευχάριστο, ζηλεύει αυτούς που αφοσιώνονται στον εαυτό τους."

msgid "210"
msgstr "Μην συναντάς τα αγαπημένα, μήτε τα μη αγαπημένα ποτέ· η μη θέαση των αγαπημένων είναι οδύνη, και η θέαση των μη αγαπημένων."

msgid "211"
msgstr "Για αυτό ας μην κάνει κανείς κάτι αγαπητό, διότι ο αποχωρισμός από το αγαπητό είναι κακός· νοητικοί κόμβοι σε αυτούς δεν υπάρχουν, για όσους δεν υπάρχει αγαπητό και μη αγαπητό."

msgid "212"
msgstr "Από τον αγαπημένο γεννιέται η λύπη, από τον αγαπημένο γεννιέται ο φόβος· Για αυτόν που είναι ελεύθερος από τον αγαπημένο, δεν υπάρχει λύπη, πώς θα υπάρχει φόβος;"

msgid "213"
msgstr "Από την αγάπη γεννιέται η λύπη, από την αγάπη γεννιέται ο φόβος· Για αυτόν που είναι ελεύθερος από την αγάπη, δεν υπάρχει λύπη, πώς θα υπάρχει φόβος;"

msgid "214"
msgstr "Από την τέρψη γεννιέται η λύπη, από την τέρψη γεννιέται ο φόβος· Για αυτόν που είναι ελεύθερος από την τέρψη, δεν υπάρχει λύπη, πώς θα υπάρχει φόβος;"

msgid "215"
msgstr "Από την ηδονή γεννιέται η λύπη, από την ηδονή γεννιέται ο φόβος· Για αυτόν που είναι ελεύθερος από την ηδονή, δεν υπάρχει λύπη, πώς θα υπάρχει φόβος;"

msgid "216"
msgstr "Από την επιθυμία γεννιέται η λύπη, από την επιθυμία γεννιέται ο φόβος· Για αυτόν που είναι ελεύθερος από την επιθυμία, δεν υπάρχει λύπη, πώς θα υπάρχει φόβος;"

msgid "217"
msgstr "Αυτόν που είναι τέλειος στην ηθική και την ενόραση, εδραιωμένος στη Διδασκαλία, γνώστης της αλήθειας· αυτόν που εκτελεί το έργο του εαυτού του, ο κόσμος τον κάνει αγαπητό."

msgid "218"
msgstr "Σε αυτόν που έχει γεννηθεί θέληση για το αδήλωτο, και θα ήταν διαποτισμένος με τον νου· και με νου απροσκόλλητο στις ηδονές, ονομάζεται 'ανοδικά πορευόμενος'."

msgid "219"
msgstr "Τον άνθρωπο που έλειπε για καιρό, που ήρθε σώος από μακριά· συγγενείς, φίλοι και καλοί σύντροφοι, χαίρονται για τον ερχομό του."

msgid "220"
msgstr "Ομοίως και αυτόν που έχει κάνει αξιέπαινες πράξεις, που έχει φύγει από αυτόν τον κόσμο στο υπερπέραν· οι αξιέπαινες πράξεις τον υποδέχονται, όπως συγγενείς τον αγαπημένο που έχει έρθει."

msgid "chap17"
msgstr "Η Οργή"

msgid "221"
msgstr "Ας εγκαταλείψει την οργή, ας απαρνηθεί την αλαζονεία, ας υπερβεί κάθε νοητικό δεσμό·αυτόν που δεν προσκολλάται στη νοητικότητα και υλικότητα, τον μη κατέχοντα τίποτα, δεν τον ακολουθούν οι πόνοι."

msgid "222"
msgstr "Όποιος πράγματι την ξεσηκωμένη οργή, όπως άρμα που τρέχει ανεξέλεγκτα, συγκρατήσει·αυτόν εγώ τον αποκαλώ αμαξηλάτη, ο υπόλοιπος κόσμος απλώς κρατά τα ηνία."

msgid "223"
msgstr "Με μη-οργή ας νικήσει την οργή, τον κακό με το καλό ας νικήσει·Ας νικήσει τον τσιγκούνη με δωρεά, τον ψευδολόγο με αλήθεια."

msgid "224"
msgstr "Ας λέει την αλήθεια, ας μην θυμώνει, ας δίνει ακόμη και λίγο όταν του ζητούν·με αυτούς τους τρεις λόγους, πηγαίνει κοντά στους θεούς."

msgid "225"
msgstr "Αβλαβείς οι σοφοί, πάντα σωματικά συγκρατημένοι·αυτοί πηγαίνουν στην άφθαρτη κατάσταση, εκεί όπου αφού πάνε δεν θλίβονται."

msgid "226"
msgstr "Αυτών που πάντα είναι άγρυπνοι, που εξασκούνται μέρα και νύχτα·αυτών που είναι αφοσιωμένοι στη Νιμπάνα, οι νοητικές διαφθορές εξαφανίζονται."

msgid "227"
msgstr "Αυτό είναι αρχαίο, Ατούλα, δεν είναι αυτό κάτι σημερινό·κατηγορούν αυτόν που κάθεται σιωπηλός, κατηγορούν αυτόν που μιλάει πολύ·κατηγορούν ακόμα και αυτόν που μιλάει μετρημένα, δεν υπάρχει στον κόσμο ακατηγόρητος."

msgid "228"
msgstr "Δεν υπήρξε ούτε θα υπάρξει, ούτε τώρα υπάρχει·εντελώς κατηγορημένος άνθρωπος, ή εντελώς επαινεμένος."

msgid "229"
msgstr "Αυτόν που οι νοήμονες επαινούν, αφού εξετάσουν μέρα με τη μέρα·τον με άψογη διαγωγή, τον συνετό, τον εδραιωμένο σε σοφία και ηθική."

msgid "230"
msgstr "Σαν χρυσό κόσμημα από χρυσάφι του ποταμού Τζάμπου, ποιος αξίζει να τον κατακρίνει;Ακόμη και οι θεοί τον επαινούν, επαινεμένος ακόμη και από τον Βράχμα."

msgid "231"
msgstr "Ας προστατεύει από τον σωματικό εκνευρισμό, ας είναι συγκρατημένος στο σώμα·εγκαταλείποντας την κακή σωματική συμπεριφορά, ας ασκεί την καλή σωματική συμπεριφορά."

msgid "232"
msgstr "Ας προστατεύει από τον λεκτικό εκνευρισμό, ας είναι συγκρατημένος στην ομιλία·εγκαταλείποντας την κακή λεκτική συμπεριφορά, ας ασκεί την καλή λεκτική συμπεριφορά."

msgid "233"
msgstr "Ας προστατεύει από τον νοητικό εκνευρισμό, ας είναι συγκρατημένος στον νου·εγκαταλείποντας την κακή νοητική συμπεριφορά, ας ασκεί την καλή νοητική συμπεριφορά."

msgid "234"
msgstr "Σωματικά συγκρατημένοι οι σοφοί, και επίσης λεκτικά συγκρατημένοι·νοητικά συγκρατημένοι οι σοφοί, αυτοί πράγματι είναι πλήρως συγκρατημένοι."

msgid "chap18"
msgstr "Οι Ακαθαρσίες"

msgid "235"
msgstr "Σαν κιτρινισμένο φύλλο είσαι τώρα, και οι απεσταλμένοι του Γιάμα σε περιμένουν·στο κατώφλι της αναχώρησης στέκεσαι, και εφόδια δεν έχεις."

msgid "236"
msgstr "Γι' αυτό φτιάξε ένα νησί για τον εαυτό σου, γρήγορα προσπάθησε, γίνε σοφός·με αποβεβλημένο ρύπο, χωρίς νοητική κηλίδα, θα φτάσεις στο θεϊκό ευγενές επίπεδο."

msgid "237"
msgstr "Η ηλικία σου έχει παρέλθει τώρα, και είσαι έτοιμος να πας κοντά στον Γιάμα·Δεν υπάρχει διαμονή για σένα στο ενδιάμεσο, και εφόδια δεν έχεις."

msgid "238"
msgstr "Γι' αυτό φτιάξε ένα νησί για τον εαυτό σου, γρήγορα προσπάθησε, γίνε σοφός·με αποβεβλημένο ρύπο, χωρίς νοητική κηλίδα, δεν θα υποστείς ξανά γέννηση και γήρας."

msgid "239"
msgstr "Σταδιακά ο ευφυής, λίγο λίγο, στιγμή με στιγμή·όπως ο χρυσοχόος το ασήμι, ας αποβάλλει τον ρύπο του εαυτού του."

msgid "240"
msgstr "Όπως η σκουριά που προκύπτει από το σίδερο, αφού προκύψει από αυτό, αυτό το ίδιο κατατρώει·έτσι αυτόν που συμπεριφέρεται υπερβολικά, οι δικές του πράξεις τον οδηγούν στον κακότυχο κόσμο."

msgid "241"
msgstr "Η μη απαγγελία είναι ο ρύπος των ιερών κειμένων, η έλλειψη εργατικότητας είναι ο ρύπος των σπιτιών·η οκνηρία είναι ο ρύπος της ομορφιάς, η αμέλεια είναι ο ρύπος αυτού που προστατεύει."

msgid "242"
msgstr "Η κακή συμπεριφορά είναι ο ρύπος της γυναίκας, η τσιγκουνιά είναι ο ρύπος αυτού που δίνει·οι κακές νοητικές καταστάσεις πράγματι είναι ρύποι, σε αυτόν τον κόσμο και στον άλλο."

msgid "243"
msgstr "Από αυτούς τους ρύπους πιο ρυπαρή, η άγνοια είναι ο υπέρτατος ρύπος·αυτόν τον ρύπο εγκαταλείποντας, να γίνετε χωρίς ρύπο, μοναχοί."

msgid "244"
msgstr "Εύκολη είναι η ζωή για τον αδιάντροπο, θρασύ σαν κοράκι, επιθετικό·για τον παρείσακτο, αυθάδη, μολυσμένη είναι η ζωή."

msgid "245"
msgstr "Δύσκολη είναι η ζωή για αυτόν που έχει ντροπή, που πάντα αναζητά την καθαρότητα·για αυτόν που δεν είναι νωθρός, χωρίς αυθάδεια, με αγνό βιοπορισμό, που βλέπει καθαρά."

msgid "246"
msgstr "'Όποιος σκοτώνει έμβιο ον, και λέει ψέματα·στον κόσμο παίρνει το μη δοσμένο, και πηγαίνει με τη γυναίκα άλλου."

msgid "247"
msgstr "Και στην κατανάλωση οινοπνευματωδών ποτών και ηδυπότων, όποιος άνθρωπος αφοσιώνεται·εδώ ακριβώς αυτός στον κόσμο, σκάβει τη ρίζα του εαυτού του."

msgid "248"
msgstr "Έτσι, αγαπητέ άνθρωπε, να γνωρίζεις, οι κακόβουλου χαρακτήρα είναι ασυγκράτητοι·μη σε η απληστία και το ανήθικο, για πολύ καιρό σε οδύνη καταβάλουν."

msgid "249"
msgstr "Δίνει πράγματι σύμφωνα με την πίστη του, σύμφωνα με την πεποίθησή του ο κόσμος·εκεί όποιος ταράζεται, για το ρόφημα και την τροφή των άλλων·αυτός ούτε την ημέρα ούτε τη νύχτα, επιτυγχάνει αυτοσυγκέντρωση."

msgid "250"
msgstr "Αυτός που αυτό έχει εκριζωθεί, ξεριζωμένο από τη ρίζα, εξαλειμμένο·αυτός πράγματι την ημέρα ή τη νύχτα, επιτυγχάνει αυτοσυγκέντρωση."

msgid "251"
msgstr "Δεν υπάρχει φωτιά όμοια με τη λαγνεία, δεν υπάρχει σύλληψη όμοια με το μίσος·Δεν υπάρχει δίχτυ όμοιο με την αυταπάτη, δεν υπάρχει ποταμός όμοιος με την επιθυμία."

msgid "252"
msgstr "Εύκολο να δεις το σφάλμα των άλλων, το δικό σου όμως δυσδιάκριτο·διότι αυτός τα σφάλματα των άλλων τα λιχνίζει σαν άχυρο·τα δικά του όμως κρύβει, όπως ο δόλιος απατεώνας το κακό ζάρι."

msgid "253"
msgstr "Αυτού που παρατηρεί τα σφάλματα των άλλων, πάντα με σκοπό την εύρεση σφάλματος·οι νοητικές διαφθορές του αυξάνονται, αυτός είναι μακριά από την εξάλειψη των νοητικών διαφθορών."

msgid "254"
msgstr "Στον χώρο δεν υπάρχει πατημασιά, ασκητής δεν υπάρχει στο εξωτερικό·Η γενιά απολαμβάνει την εμμονή, οι Τατχάγκατα είναι χωρίς εμμονή."

msgid "255"
msgstr "Στον χώρο δεν υπάρχει πατημασιά, ασκητής δεν υπάρχει στο εξωτερικό·οι δραστηριότητες δεν είναι αιώνιες, δεν υπάρχει διαταράξιμο για τους Βούδες."

msgid "chap19"
msgstr "Ο Δίκαιος"

msgid "256"
msgstr "Δεν είναι εδραιωμένος στη Διδασκαλία με το να κρίνει μια υπόθεση βιαστικά·όποιος όμως σοφός αποφασίζει και για το επωφελές και για το μη επωφελές, και τα δύο."

msgid "257"
msgstr "Χωρίς βία, με δικαιοσύνη, δίκαια κρίνει τους άλλους·φύλακας της Διδασκαλίας, ευφυής, ονομάζεται 'εδραιωμένος στη Διδασκαλία'."

msgid "258"
msgstr "Δεν είναι σοφός με το να μιλά πολύ·ο ειρηνικός, χωρίς έχθρα, άφοβος, 'σοφός' ονομάζεται."

msgid "259"
msgstr "Δεν είναι κάτοχος της Διδασκαλίας με το να μιλά πολύ·όποιος όμως ακόμη και λίγα ακούγοντας, βλέπει τη Διδασκαλία με το σώμα·αυτός πράγματι είναι κάτοχος της Διδασκαλίας, αυτός που δεν αμελεί τη Διδασκαλία."

msgid "260"
msgstr "Δεν γίνεται κάποιος πρεσβύτερος με αυτό, ότι το κεφάλι του είναι γκρίζο·Η ηλικία του έχει ωριμάσει, 'μάταια γερασμένος' ονομάζεται."

msgid "261"
msgstr "Σε όποιον υπάρχει αλήθεια και αρχή, αβλάβεια, αυτοέλεγχος, δάμασμα·αυτός πράγματι, ο συνετός που έχει αποβάλει τον ρύπο, ονομάζεται 'πρεσβύτερος'."

msgid "262"
msgstr "Ούτε μόνο με την ομιλία, ούτε με την ομορφιά και τη λάμψη·ο ζηλόφθονος, τσιγκούνης, δόλιος άνθρωπος δεν είναι ωραίος."

msgid "263"
msgstr "Αυτός που αυτό έχει εκριζωθεί, ξεριζωμένο από τη ρίζα, εξαλειμμένο·αυτός που έχει απορρίψει το μίσος, ο ευφυής, ονομάζεται 'ωραίος'."

msgid "264"
msgstr "Δεν γίνεται κανείς ασκητής με το ξύρισμα της κεφαλής, χωρίς ηθικές πρακτικές, λέγοντας ψέματα·γεμάτος πόθο και απληστία, πώς θα γίνει ασκητής;"

msgid "265"
msgstr "Όποιος όμως καταπαύει τα κακά, μικρά και μεγάλα, εξολοκλήρου·λόγω της κατάπαυσης των κακών, 'ασκητής' ονομάζεται."

msgid "266"
msgstr "Δεν γίνεται κανείς μοναχός, μόνο επειδή ζητιανεύει από τους άλλους·αναλαμβάνοντας δύσοσμη νοητική κατάσταση, δεν γίνεται μοναχός με αυτό και μόνο."

msgid "267"
msgstr "Αυτός που εδώ και την αξιέπαινη πράξη και την κακή, έχοντας αποβάλει, ζώντας την άγια ζωή·περιφέρεται στον κόσμο με γνώση, αυτός πράγματι ονομάζεται 'μοναχός'."

msgid "268"
msgstr "Δεν γίνεται σοφός με τη σιωπή, ο παραπλανημένος αδαής·όποιος όμως σαν να κρατά ζυγαριά, παίρνοντας το άριστο, ο σοφός."

msgid "269"
msgstr "Αποφεύγει τα κακά, αυτός είναι σοφός, γι' αυτό είναι σοφός·όποιος μετρά και τους δύο κόσμους, 'σοφός' γι' αυτό ονομάζεται."

msgid "270"
msgstr "Δεν είναι ευγενής με το να βλάπτει έμβια όντα·με την αβλάβεια προς όλα τα έμβια όντα, ονομάζεται 'ευγενής'."

msgid "271"
msgstr "Ούτε μόνο με ηθικούς κανόνες και αυστηρότητες, ούτε με πολυμάθεια·ή με την επίτευξη αυτοσυγκέντρωσης, ή με απομονωμένη διαμονή."

msgid "272"
msgstr "Βιώνω την ευτυχία της απάρνησης, τη μη συχναζόμενη από κοσμικούς·Ο μοναχός να μην έχει εμπιστοσύνη, χωρίς να έχει φτάσει στην εξάλειψη των νοητικών διαφθορών."

msgid "chap20"
msgstr "Η Οδός"

msgid "273"
msgstr "Η οκταμερής οδός είναι η άριστη από τις οδούς, οι τέσσερις όροι είναι οι άριστοι από τις αλήθειες·το μη πάθος είναι το άριστο από τα φαινόμενα, και ο έχων όραση είναι ο άριστος από τα δίποδα."

msgid "274"
msgstr "Αυτή ακριβώς είναι η οδός, δεν υπάρχει άλλη, για τον εξαγνισμό της ενόρασης·Ακολουθήστε λοιπόν αυτήν, αυτή είναι η σύγχυση του Μάρα."

msgid "275"
msgstr "Ακολουθώντας λοιπόν αυτήν, θα τερματίσετε τον πόνο·Η οδός διδάχθηκε σε εσάς από εμένα, έχοντας γνωρίσει την εξαγωγή του βέλους."

msgid "276"
msgstr "Από σας πρέπει να γίνει η προσπάθεια· οι Τατχάγκατα είναι αυτοί που δείχνουν·όσοι ασκούνται θα απελευθερωθούν, οι διαλογιστές, από τα δεσμά του Μάρα."

msgid "277"
msgstr "'Όλες οι δραστηριότητες είναι παροδικές', όταν με σοφία βλέπει·τότε αποστασιοποιείται από τη δυστυχία, αυτή είναι η οδός για τον εξαγνισμό."

msgid "278"
msgstr "'Όλες οι δραστηριότητες είναι ταλαιπωρία', όταν με σοφία βλέπει·τότε αποστασιοποιείται από τη δυστυχία, αυτή είναι η οδός για τον εξαγνισμό."

msgid "279"
msgstr "'Όλα τα φαινόμενα είναι μη-εαυτός', όταν με σοφία βλέπει·τότε αποστασιοποιείται από τη δυστυχία, αυτή είναι η οδός για τον εξαγνισμό."

msgid "280"
msgstr "Αυτός που δεν εργάζεται την ώρα της εργασίας, νέος και δυνατός, κυριευμένος από τεμπελιά·με νου βυθισμένο σε λογισμούς, οκνηρός, ο τεμπέλης δεν βρίσκει την οδό με σοφία."

msgid "281"
msgstr "Προστατεύοντας την ομιλία, καλά συγκρατημένος με τον νου, με το σώμα δεν θα έκανε μη-καλό·αυτές τις τρεις πορείες πράξης θα εξαγνίσει, θα επιτύχει την οδό που διακηρύχθηκε από τους σοφούς."

msgid "282"
msgstr "Από τον διαλογισμό πράγματι γεννιέται η σοφία, από την έλλειψη διαλογισμού η εξάλειψη της σοφίας·Έχοντας γνωρίσει αυτό το διπλό μονοπάτι, για την ύπαρξη και τη μη ύπαρξη·έτσι ας εγκαταστήσει τον εαυτό του, ώστε η σοφία να αυξάνεται."

msgid "283"
msgstr "Κόψτε το δάσος, όχι το δέντρο, από το δάσος γεννιέται ο φόβος·Αφού κόψετε το δάσος και τη θαμνώδη βλάστηση, να γίνετε χωρίς δάσος, μοναχοί."

msgid "284"
msgstr "Όσο το δάσος των μολύνσεων δεν κόβεται, έστω και ελάχιστο, του άνδρα για τις γυναίκες·τόσο αυτός έχει δεμένο νου, όπως το μοσχάρι που θηλάζει γάλα στη μητέρα του."

msgid "285"
msgstr "Κόψε τη στοργή για τον εαυτό σου όπως το φθινοπωρινό νούφαρο·Καλλιέργησε μόνο την οδό της ειρήνης, τη Νιμπάνα που διδάχθηκε από τον Καλότυχο."

msgid "286"
msgstr "Εδώ θα κατοικήσω κατά την βροχερή εποχή, εδώ κατά τον χειμώνα και το καλοκαίρι·έτσι ο αδαής σκέφτεται, δεν κατανοεί το εμπόδιο."

msgid "287"
msgstr "Αυτόν που είναι μεθυσμένος από γιους και ζώα, τον άνθρωπο με προσκολλημένο νου·σαν μεγάλη πλημμύρα κοιμισμένο χωριό, ο θάνατος παίρνοντάς τον φεύγει."

msgid "288"
msgstr "Δεν υπάρχουν γιοι για προστασία, ούτε πατέρας ούτε συγγενείς·Για αυτόν που έχει καταληφθεί από τον θάνατο, δεν υπάρχει προστασία στους συγγενείς."

msgid "289"
msgstr "Έχοντας γνωρίσει αυτόν τον λόγο, ο σοφός συγκρατημένος στην ηθική·την οδό που οδηγεί στο Νιμπάνα, γρήγορα ας εξαγνίσει."

msgid "chap21"
msgstr "Τα Ποικίλα"

msgid "290"
msgstr "Αν με την απάρνηση της μικρής ευτυχίας, βλέπει κανείς άφθονη ευτυχία·ας απαρνηθεί τη μικρή ευτυχία ο σοφός, βλέποντας την άφθονη ευτυχία."

msgid "291"
msgstr "Προκαλώντας δυστυχία σε άλλους, ποθεί ευτυχία για τον εαυτό του·συνδεδεμένος με τη σύσφιξη δεσμού έχθρας, αυτός δεν απελευθερώνεται από την έχθρα."

msgid "292"
msgstr "Αυτό που πρέπει να γίνει εγκαταλείπεται, αυτό που δεν πρέπει όμως γίνεται·αυτών των αλαζόνων και αμελών, οι νοητικές διαφθορές αυξάνονται."

msgid "293"
msgstr "Αυτών που η μνήμη επί του σώματος είναι καλά ξεκινημένη, πάντα·αυτοί δεν κάνουν αυτό που δεν πρέπει, σε αυτό που πρέπει με ακατάπαυστη προσπάθεια·των μνημόνων, αυτών με πλήρη επίγνωση, οι νοητικές διαφθορές εξαφανίζονται."

msgid "294"
msgstr "Σκοτώνοντας μητέρα και πατέρα, και δύο βασιλιάδες της πολεμικής κάστας·σκοτώνοντας βασίλειο μαζί με τον ακόλουθό του, χωρίς ταραχή προχωρά ο βραχμάνος."

msgid "295"
msgstr "Σκοτώνοντας μητέρα και πατέρα, και δύο βασιλιάδες της βραχμανικής κάστας·σκοτώνοντας την τίγρη ως πέμπτο, χωρίς ταραχή προχωρά ο βραχμάνος."

msgid "296"
msgstr "Πλήρως αφυπνισμένοι ξυπνούν, πάντα οι μαθητές του Γκόταμα·αυτοί που την ημέρα και τη νύχτα, συνεχώς έχουν τη μνήμη στραμμένη στον Βούδα."

msgid "297"
msgstr "Πλήρως αφυπνισμένοι ξυπνούν, πάντα οι μαθητές του Γκόταμα·αυτοί που την ημέρα και τη νύχτα, συνεχώς έχουν τη μνήμη στραμμένη στη Διδασκαλία."

msgid "298"
msgstr "Πλήρως αφυπνισμένοι ξυπνούν, πάντα οι μαθητές του Γκόταμα·αυτοί που την ημέρα και τη νύχτα, συνεχώς έχουν τη μνήμη στραμμένη στην Κοινότητα."

msgid "299"
msgstr "Πλήρως αφυπνισμένοι ξυπνούν, πάντα οι μαθητές του Γκόταμα·αυτοί που την ημέρα και τη νύχτα, συνεχώς έχουν τη μνήμη επί του σώματος."

msgid "300"
msgstr "Πλήρως αφυπνισμένοι ξυπνούν, πάντα οι μαθητές του Γκόταμα·αυτοί που την ημέρα και τη νύχτα, ο νους τους χαίρεται στη μη βία."

msgid "301"
msgstr "Πλήρως αφυπνισμένοι ξυπνούν, πάντα οι μαθητές του Γκόταμα·αυτοί που την ημέρα και τη νύχτα, ο νους τους χαίρεται στην ανάπτυξη."

msgid "302"
msgstr "Δύσκολη η αναχώρηση, δύσκολη η ευχαρίστηση, δύσκολη η διαμονή, τα σπίτια είναι οδυνηρά·Οδυνηρή η συγκατοικία με ανόμοιους, οδυνηρός ο ταξιδιώτης που ακολουθείται από τη δυστυχία·Για αυτό ας μην είναι κανείς ταξιδιώτης, ούτε ας ακολουθείται από τη δυστυχία."

msgid "303"
msgstr "Πιστός, τέλειος στην ηθική, προικισμένος με φήμη και πλούτη·όποια περιοχή κι αν επισκέπτεται, εκεί ακριβώς χαίρει ευσέβειας."

msgid "304"
msgstr "Οι γαλήνιοι λάμπουν από μακριά, όπως το όρος Χιμαβάντα·οι μη γαλήνιοι εδώ δεν φαίνονται, όπως βέλη ριγμένα τη νύχτα."

msgid "305"
msgstr "Μόνος να κάθεται, μόνος να κοιμάται, μόνος να περπατά χωρίς λήθαργο·Μόνος δαμάζοντας τον εαυτό του, στην άκρη του δάσους θα ευφραινόταν."

msgid "chap22"
msgstr "Η Κόλαση"

msgid "306"
msgstr "Αυτός που λέει ψέματα πηγαίνει στην κόλαση, ή και αυτός που έχοντας κάνει κάτι λέει 'δεν το κάνω'·και οι δύο αυτοί πεθαίνοντας γίνονται ίσοι, άνθρωποι με ταπεινές πράξεις στην επόμενη ζωή."

msgid "307"
msgstr "Πολλοί φορούν το πορτοκαλί ράσο στον λαιμό, κακόβουλου χαρακτήρα, ασυγκράτητοι·οι κακοί με τις κακές τους πράξεις, στην κόλαση επαναγεννιούνται."

msgid "308"
msgstr "Καλύτερη μια σιδερένια σφαίρα καταναλωμένη, πυρακτωμένη σαν φλόγα φωτιάς·παρά να έτρωγε ο ανήθικος, την προσφερόμενη τροφή της χώρας ασυγκράτητος."

msgid "309"
msgstr "Τέσσερις καταστάσεις ο αμελής άνθρωπος, διαπράττει αυτός που συνευρίσκεται με τη γυναίκα άλλου·απόκτηση αξιόμεμπτου, δυσάρεστο κρεβάτι, κατηγορία τρίτον, κόλαση τέταρτον."

msgid "310"
msgstr "Απόκτηση αξιόμεμπτης πράξης και κακός προορισμός, του φοβισμένου με τη φοβισμένη η απόλαυση είναι μικρή·και ο βασιλιάς βαριά τιμωρία επιβάλλει, για αυτό ο άνθρωπος τη γυναίκα άλλου ας μην πλησιάζει."

msgid "311"
msgstr "Όπως το γρασίδι κούσα που πιάστηκε λάθος, κόβει ακριβώς το χέρι·ο ασκητισμός που ασκείται λάθος, σέρνει στην κόλαση."

msgid "312"
msgstr "Οποιαδήποτε χαλαρή πράξη, και οποιαδήποτε μολυσμένη ασκητική πρακτική·η αμφίβολη άγια ζωή, αυτή δεν έχει μεγάλο καρπό."

msgid "313"
msgstr "Αν κάποιος θα έκανε, ας το κάνει, ας προσπαθήσει σταθερά·διότι η χαλαρή αναχώρηση σκορπίζει περισσότερη σκόνη."

msgid "314"
msgstr "Η ανάρμοστη πράξη που δεν έγινε είναι καλύτερη, η ανάρμοστη πράξη καίει αργότερα·και η καλή πράξη που έγινε είναι καλύτερη, την οποία κάνοντας δεν μετανιώνει."

msgid "315"
msgstr "Όπως μια παραμεθόρια πόλη, φυλαγμένη εσωτερικά και εξωτερικά·έτσι φυλάξτε τον εαυτό σας, η στιγμή ας μην σας παρέλθει·διότι αυτοί που άφησαν τη στιγμή να περάσει θρηνούν, ριγμένοι στην κόλαση."

msgid "316"
msgstr "Ντρέπονται για αυτό που δεν πρέπει να ντρέπονται, για αυτό που πρέπει να ντρέπονται δεν ντρέπονται·υιοθετώντας λανθασμένες απόψεις, τα όντα πηγαίνουν στον κακότυχο κόσμο."

msgid "317"
msgstr "Βλέποντας φόβο στο άφοβο, και βλέποντας αφοβία στον κίνδυνο·υιοθετώντας λανθασμένες απόψεις, τα όντα πηγαίνουν στον κακότυχο κόσμο."

msgid "318"
msgstr "Θεωρώντας σφάλμα αυτό που δεν είναι σφάλμα, και βλέποντας ως μη σφάλμα αυτό που είναι σφάλμα·υιοθετώντας λανθασμένες απόψεις, τα όντα πηγαίνουν στον κακότυχο κόσμο."

msgid "319"
msgstr "Έχοντας γνωρίσει το σφάλμα ως σφάλμα, και το μη σφάλμα ως μη σφάλμα·υιοθετώντας την ορθή άποψη, τα όντα πηγαίνουν στον καλότυχο κόσμο."

msgid "chap23"
msgstr "Ο Ελέφαντας"

msgid "320"
msgstr "Εγώ όπως ελέφαντας σε μάχη, βέλος που έπεσε από τόξο·θα υπομείνω την προσβολή, διότι ανήθικος είναι πολύς κόσμος."

msgid "321"
msgstr "Τον δαμασμένο οδηγούν στη συνάθροιση, τον δαμασμένο ανεβαίνει ο βασιλιάς·Ο δαμασμένος είναι ο άριστος μεταξύ των ανθρώπων, αυτός που υπομένει τα υβριστικά λόγια."

msgid "322"
msgstr "Άριστα τα δαμασμένα μουλάρια, και τα ευγενή άλογα της Σίνδου·και οι ελέφαντες, οι μεγάλοι νάγκα, αυτός που δάμασε τον εαυτό του είναι αριστότερος από αυτά."

msgid "323"
msgstr "Διότι με αυτά τα οχήματα, δεν θα πήγαινε κανείς σε κατεύθυνση που δεν έχει πάει·όπως με τον εαυτό καλά δαμασμένο, ο δαμασμένος με τη δάμαση πηγαίνει."

msgid "324"
msgstr "Ο ελέφαντας ονόματι Ντανάπαλα, με οξύ οίστρο, δύσκολος να συγκρατηθεί·δέσμιος δεν τρώει μπουκιά, θυμάται το δάσος των ελεφάντων ο ελέφαντας."

msgid "325"
msgstr "Όταν είναι νωθρός και αδηφάγος, κοιμάται και ξαπλώνει στριφογυρίζοντας·σαν μεγάλος χοίρος ταϊσμένος με τροφή, ξανά και ξανά ο ανόητος μπαίνει στη μήτρα."

msgid "326"
msgstr "Αυτός ο νους στο παρελθόν περιπλανιόταν, όπου ήθελε, όπου επιθυμούσε, όπως του άρεσε·Αυτόν σήμερα εγώ θα συγκρατήσω συνετά, όπως αυτός που κρατά το αγκίστρι τον οργισμένο ελέφαντα."

msgid "327"
msgstr "Να χαίρεστε με την επιμέλεια, να προστατεύετε τον νου σας·να ανασύρετε τον εαυτό σας από το δυσπρόσιτο, όπως ο ελέφαντας βυθισμένος στη λάσπη."

msgid "328"
msgstr "Αν βρεις συνετό σύντροφο, που περπατά μαζί, ζει καλά, σοφό·υπερβαίνοντας όλους τους κινδύνους, ας περπατά μαζί του ευχαριστημένος, με επίγνωση."

msgid "329"
msgstr "Αν δεν βρεις συνετό σύντροφο, που περπατά μαζί, ζει καλά, σοφό·όπως βασιλιάς εγκαταλείποντας κατακτημένο βασίλειο, ας περπατά μόνος, όπως ελέφαντας στο δάσος."

msgid "330"
msgstr "Καλύτερη η μοναχική πορεία, δεν υπάρχει συντροφιά με τον αδαή·ας περπατά μόνος και να μην κάνει κακά, ζώντας άνετα, όπως ελέφαντας στο δάσος."

msgid "331"
msgstr "Όταν προκύπτει ανάγκη, ευτυχία είναι οι σύντροφοι, ευτυχία είναι η ικανοποίηση με οτιδήποτε·Ευτυχία είναι η αξιέπαινη πράξη στο τέλος της ζωής, ευτυχία είναι η εγκατάλειψη όλου του πόνου."

msgid "332"
msgstr "Ευτυχία είναι η ευσέβεια προς τη μητέρα στον κόσμο, και επίσης η ευσέβεια προς τον πατέρα είναι ευτυχία·Ευτυχία είναι ο σεβασμός προς τους ασκητές στον κόσμο, και επίσης ο σεβασμός προς τους αγίους είναι ευτυχία."

msgid "333"
msgstr "Ευτυχία είναι η ηθική μέχρι τα γηρατειά, ευτυχία είναι η πίστη εδραιωμένη·Ευτυχία είναι η απόκτηση σοφίας, η μη-εκτέλεση κακών είναι ευτυχία."

msgid "chap24"
msgstr "Η Επιθυμία"

msgid "334"
msgstr "Του ανθρώπου που ζει απρόσεκτα, η επιθυμία αυξάνεται όπως αναρριχητικό φυτό·Αυτός πηδά από εδώ εκεί, όπως πίθηκος στο δάσος που ποθεί καρπούς."

msgid "335"
msgstr "Αυτόν που αυτή η ποταπή, η κολλώδης επιθυμία στον κόσμο κυριεύει·οι λύπες του αυξάνονται, όπως το χορτάρι μπιράνα όταν βρέχεται."

msgid "336"
msgstr "Αυτός που αυτήν την ποταπή, δυσυπέρβλητη επιθυμία στον κόσμο υπερνικά·οι λύπες από αυτόν πέφτουν, όπως σταγόνα νερού από φύλλο λωτού."

msgid "337"
msgstr "Αυτό σας λέω, καλό να σας γίνει, όσοι έχετε συγκεντρωθεί εδώ·Σκάψτε τη ρίζα της επιθυμίας, όπως αυτός που θέλει ουσίρα σκάβει το χορτάρι μπιράνα·Μην σας συντρίψει ο Μάρα ξανά και ξανά, όπως το ρεύμα το καλάμι."

msgid "338"
msgstr "Όπως όταν η ρίζα είναι αβλαβής και γερή, ακόμα κι αν κοπεί το δέντρο, ξαναφυτρώνει·έτσι επίσης όταν η υπολανθάνουσα τάση της επιθυμίας δεν έχει εκριζωθεί, αυτή η δυστυχία γεννιέται ξανά και ξανά."

msgid "339"
msgstr "Αυτού που τα τριάντα έξι ρεύματα, που ρέουν προς τα ευχάριστα, είναι σφοδρά·τα μεγάλα παρασύρουν τον κακόγνωμο, οι λογισμοί βασισμένοι στη λαγνεία."

msgid "340"
msgstr "Ρέουν παντού τα ρεύματα, η αναρριχητική φυτεία εγείρεται και παραμένει·Και αυτή την αναρριχητική φυτεία έχοντας δει γεννημένη, κόψτε τη ρίζα με σοφία."

msgid "341"
msgstr "Ενθυμήσεις και προσκολλήσεις, ευαρέσκειες υπάρχουν για το ον·αυτοί βασισμένοι στην άνεση, αναζητώντας την ευτυχία, αυτοί πράγματι υπόκεινται σε γέννηση και γήρας, οι άνθρωποι."

msgid "342"
msgstr "Η γενιά με τη δίψα μπροστά, τρέμει σαν λαγός παγιδευμένος·δεμένοι με τους νοητικούς δεσμούς και τις προσκολλήσεις, υφίστανται δυστυχία ξανά και ξανά για πολύ καιρό."

msgid "343"
msgstr "Η γενιά με τη δίψα μπροστά, τρέμει σαν λαγός παγιδευμένος·για αυτό ας απομακρύνει τη δίψα, ποθώντας το μη πάθος για τον εαυτό του."

msgid "344"
msgstr "Όποιος χωρίς νοητικές μολύνσεις είναι αφοσιωμένος στο δάσος, απελευθερωμένος από το δάσος τρέχει πάλι στο δάσος·ελάτε να δείτε αυτό το άτομο, απελευθερωμένος τρέχει πάλι στον δεσμό."

msgid "345"
msgstr "'Δεν το αποκαλούν σταθερό δεσμό οι σοφοί, αυτό που είναι από σίδερο, από ξύλο ή από σχοινί·η βαθιά λαγνεία για πολύτιμα σκουλαρίκια, η προσκόλληση σε γιους και συζύγους."

msgid "346"
msgstr "Αυτό το αποκαλούν σταθερό δεσμό οι σοφοί, που σέρνει κάτω, χαλαρό, δύσκολο να λυθεί·κόβοντας και αυτό, αναχωρούν, χωρίς προσκόλληση, εγκαταλείποντας την ηδονική ευτυχία."

msgid "347"
msgstr "Όσοι βαμμένοι από λαγνεία ακολουθούν το ρεύμα, αυτοδημιούργητο σαν του αράχνη το δίχτυ·κόβοντας και αυτό, οι σοφοί πηγαίνουν, χωρίς προσκόλληση, εγκαταλείποντας κάθε υπαρξιακό πόνο."

msgid "348"
msgstr "Άφησε το παρελθόν, άφησε το μέλλον, άφησε το παρόν, αυτός που έχει διαβεί στην άλλη όχθη του γίγνεσθαι·με νου απελευθερωμένο παντού, δεν θα υποστείς ξανά γέννηση και γήρας."

msgid "349"
msgstr "Για το ον που ταράζεται από λογισμούς, που έχει έντονη λαγνεία, που παρατηρεί το ωραίο·η επιθυμία περισσότερο αυξάνεται, αυτός κάνει σταθερό τον δεσμό."

msgid "350"
msgstr "Και όποιος χαίρεται στη γαλήνη του λογισμού, αναπτύσσει τη ρυπαρότητα, πάντα μνήμων·αυτός πράγματι θα τερματίσει, αυτός θα κόψει τον δεσμό του Μάρα."

msgid "351"
msgstr "Έχοντας φτάσει στον σκοπό, χωρίς φόβο, απαλλαγμένος από επιθυμία, χωρίς νοητική κηλίδα·έκοψε τα βέλη της ύπαρξης, αυτή είναι η τελευταία ύπαρξη."

msgid "352"
msgstr "Απαλλαγμένος από επιθυμία, χωρίς προσκόλληση, επιδέξιος στη γλώσσα και τους όρους·γνωρίζει τον συνδυασμό των γραμμάτων, και τα προηγούμενα και τα επόμενα·αυτός πράγματι ονομάζεται 'με το τελευταίο σώμα, με μεγάλη σοφία, μεγάλος άνθρωπος'."

msgid "353"
msgstr "Είμαι ο κυρίαρχος όλων, ο γνώστης όλων, σε όλα τα φαινόμενα αμόλυντος·έχοντας εγκαταλείψει τα πάντα, απελευθερωμένος με την εξάλειψη της επιθυμίας, έχοντας ο ίδιος γνωρίσει άμεσα, ποιον να υποδείξω;"

msgid "354"
msgstr "Η δωρεά της Διδασκαλίας νικά κάθε δωρεά, η γεύση της Διδασκαλίας νικά κάθε γεύση·Η τέρψη της Διδασκαλίας νικά κάθε τέρψη, η εξάλειψη της επιθυμίας νικά κάθε υπαρξιακό πόνο."

msgid "355"
msgstr "Ο πλούτος σκοτώνει τον άφρονα, αλλά όχι αυτόν που αναζητά το υπερπέραν·ο άφρονας με την επιθυμία για πλούτη σκοτώνει τον ίδιο τον εαυτό του."

msgid "356"
msgstr "Τα χωράφια έχουν το ελάττωμα των ζιζανίων, αυτή η γενιά έχει το ελάττωμα του πάθους·Γι' αυτό λοιπόν σε αυτούς που είναι χωρίς πάθος, το δοσμένο έχει μεγάλο καρπό."

msgid "357"
msgstr "Τα χωράφια έχουν το ελάττωμα των ζιζανίων, αυτή η γενιά έχει το ελάττωμα του μίσους·Γι' αυτό λοιπόν σε αυτούς που είναι χωρίς μίσος, το δοσμένο έχει μεγάλο καρπό."

msgid "358"
msgstr "Τα χωράφια έχουν το ελάττωμα των ζιζανίων, αυτή η γενιά έχει το ελάττωμα της αυταπάτης·Γι' αυτό λοιπόν σε αυτούς που είναι χωρίς αυταπάτη, το δοσμένο έχει μεγάλο καρπό."

msgid "359"
msgstr "Τα χωράφια έχουν το ελάττωμα των ζιζανίων, αυτή η γενιά έχει το ελάττωμα της επιθυμίας·Γι' αυτό λοιπόν σε αυτούς που είναι χωρίς επιθυμία, το δοσμένο έχει μεγάλο καρπό."

msgid "chap25"
msgstr "Οι Μοναχοί"

msgid "360"
msgstr "Η αυτοσυγκράτηση με το μάτι είναι καλή, καλή είναι η αυτοσυγκράτηση με το αυτί·Η αυτοσυγκράτηση με τη μύτη είναι καλή, καλή είναι η αυτοσυγκράτηση με τη γλώσσα."

msgid "361"
msgstr "Η σωματική αυτοσυγκράτηση είναι καλή, καλή είναι η λεκτική αυτοσυγκράτηση·Η νοητική αυτοσυγκράτηση είναι καλή, καλή είναι η αυτοσυγκράτηση παντού·Ο μοναχός που είναι συγκρατημένος παντού, απελευθερώνεται από κάθε δυστυχία."

msgid "362"
msgstr "Συγκρατημένος στα χέρια, συγκρατημένος στα πόδια, συγκρατημένος στην ομιλία, άριστα συγκρατημένος·Χαίροντας εσωτερικά, αυτοσυγκεντρωμένος, μόνος, ικανοποιημένος - αυτόν τον αποκαλούν μοναχό."

msgid "363"
msgstr "Ο μοναχός που συγκρατεί το στόμα του, που μιλά με σοφία, χωρίς ανησυχία·παρουσιάζει το νόημα και τη Διδασκαλία, γλυκιά είναι η ρήση του."

msgid "364"
msgstr "Αυτός που απολαμβάνει τη Διδασκαλία, τέρπεται με τη Διδασκαλία, στοχάζεται τη Διδασκαλία·ο μοναχός που αναθυμάται τη Διδασκαλία, δεν ξεπέφτει από την Άριστη Διδασκαλία."

msgid "365"
msgstr "Δεν πρέπει να περιφρονεί το δικό του κέρδος, δεν πρέπει να ζει ποθώντας των άλλων·Ο μοναχός που ποθεί των άλλων, δεν επιτυγχάνει αυτοσυγκέντρωση."

msgid "366"
msgstr "Ακόμα κι αν ο μοναχός έχει λίγο κέρδος, δεν περιφρονεί το δικό του κέρδος·αυτόν πράγματι οι θεοί επαινούν, τον αγνό στη ζωή, τον μη οκνηρό."

msgid "367"
msgstr "Όποιος δεν έχει ιδιοποίηση στη νοητικότητα και υλικότητα, εξολοκλήρου·και δεν θλίβεται για αυτό που δεν υπάρχει, αυτός πράγματι ονομάζεται 'μοναχός'."

msgid "368"
msgstr "Ο μοναχός που διαμένει με φιλικότητα, που έχει πίστη στη Διδαχή του Βούδα·θα φτάσει στη γαλήνια κατάσταση, την ευτυχία της γαλήνης των δραστηριοτήτων."

msgid "369"
msgstr "Άδειασε, μοναχέ, αυτό το πλοίο, αδειασμένο θα γίνει ελαφρύ για σένα·αφού κόψεις τη λαγνεία και το μίσος, τότε θα φτάσεις στη Νιμπάνα."

msgid "370"
msgstr "Πέντε να κόψει, πέντε να εγκαταλείψει, πέντε επιπλέον να αναπτύξει·πέντε προσκολλήσεις ξεπερνώντας ένας μοναχός, 'διαβάτης των νοητικών πλημμυρών' ονομάζεται."

msgid "371"
msgstr "Διαλογίσου, μοναχέ, μην αμελείς, μη αφήνεις τη συνείδησή σου να τέρπεται στα είδη αισθησιακής ηδονής·Μην καταπιείς σιδερένια σφαίρα απρόσεκτος, μην κλαις 'αυτό είναι πόνος' καιγόμενος."

msgid "372"
msgstr "Δεν υπάρχει διαλογιστική έκσταση για αυτόν χωρίς σοφία, δεν υπάρχει σοφία για αυτόν που δεν διαλογίζεται·σε όποιον υπάρχει και διαλογιστική έκσταση και σοφία, αυτός πράγματι είναι κοντά στο Νιμπάνα."

msgid "373"
msgstr "Για τον μοναχό που έχει μπει σε άδεια οικία, με γαλήνια συνείδηση·υπάρχει υπεράνθρωπη ευχαρίστηση, βλέποντας ορθά τη Διδασκαλία με διόραση."

msgid "374"
msgstr "Όποτε και όπως εξετάζει, την έγερση και την παρακμή των συναθροισμάτων·αποκτά χαρά και αγαλλίαση, αυτό είναι το αθάνατο για αυτούς που συνειδητοποιούν."

msgid "375"
msgstr "Εδώ αυτή είναι η αρχή, για τον σοφό μοναχό·Η φύλαξη των ικανοτήτων, η ικανοποίηση, και η αυτοσυγκράτηση στον κύριο μοναστικό κώδικα."

msgid "376"
msgstr "Να συναναστρέφεσαι καλούς φίλους, με αγνό βιοπορισμό, χωρίς λήθαργο·να είσαι επιδέξιος στην καλή συμπεριφορά, με τρόπο φιλικής υποδοχής·τότε γεμάτος χαρά, θα θέσεις τέρμα στον πόνο."

msgid "377"
msgstr "Όπως η γιασεμιά τα λουλούδια, τα μαραμένα αφήνει·έτσι τη λαγνεία και το μίσος, να αφήσετε, μοναχοί."

msgid "378"
msgstr "Γαλήνιος στο σώμα, γαλήνιος στην ομιλία, γαλήνιος, καλά αυτοσυγκεντρωμένος·ο μοναχός που έχει απορρίψει τα κοσμικά δελεάσματα, ονομάζεται 'γαλήνιος'."

msgid "379"
msgstr "Ο ίδιος να ελέγχεις τον εαυτό σου, ο ίδιος να εξετάζεις τον εαυτό σου·Αυτός που προστατεύει τον εαυτό του, μνήμων, με ευτυχία, μοναχέ, θα διαμένεις."

msgid "380"
msgstr "Ο εαυτός είναι ο προστάτης του εαυτού, (ποιος άλλος θα μπορούσε να είναι προστάτης;)Ο εαυτός είναι ο προορισμός του εαυτού·Για αυτό να ελέγχεις τον εαυτό σου, όπως ο έμπορος ένα καλό άλογο."

msgid "381"
msgstr "Ο μοναχός γεμάτος χαρά, που έχει πίστη στη Διδαχή του Βούδα·θα φτάσει στη γαλήνια κατάσταση, την ευτυχία της γαλήνης των δραστηριοτήτων."

msgid "382"
msgstr "'Όποιος πράγματι νεαρός μοναχός αφοσιώνεται στη Διδαχή του Βούδα·αυτός φωτίζει αυτόν τον κόσμο, όπως η σελήνη ελευθερωμένη από τα σύννεφα."

msgid "chap26"
msgstr "Οι Βραχμάνοι"

msgid "383"
msgstr "Κόψε το ρεύμα με προσπάθεια, απομάκρυνε τις ηδονές, βραχμάνε·Έχοντας γνωρίσει την εξάλειψη των δραστηριοτήτων, γνώστης του αδημιούργητου είσαι, βραχμάνε."

msgid "384"
msgstr "Όταν στις δύο διδασκαλίες, αυτός που έχει διαβεί στην άλλη όχθη γίνεται βραχμάνος·τότε όλοι οι δεσμοί του, εξαφανίζονται σε αυτόν που γνωρίζει."

msgid "385"
msgstr "Για αυτόν που η πέρα όχθη ή η εδώ όχθη, ή και οι δύο όχθες δεν υπάρχουν·τον απαλλαγμένο από αγωνία, τον αποδεσμευμένο, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "386"
msgstr "Τον διαλογιστή, τον χωρίς πάθος, τον καθήμενο μόνο, τον ολοκληρώσαντα το καθήκον, τον χωρίς νοητικές διαφθορές·τον φτάσαντα στον ύψιστο σκοπό, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "387"
msgstr "Την ημέρα λάμπει ο ήλιος, τη νύχτα φέγγει η σελήνη·ο οπλισμένος πολεμιστής λάμπει, ο διαλογιστής βραχμάνος λάμπει·αλλά όλη τη μέρα και τη νύχτα, ο Βούδας λάμπει με τη λαμπρότητά του."

msgid "388"
msgstr "Αυτός που έχει απομακρύνει το κακό ονομάζεται βραχμάνος, λόγω της γαλήνιας συμπεριφοράς ονομάζεται ασκητής·αποβάλλοντας τον ρύπο του εαυτού του, για αυτό ονομάζεται 'αναχωρητής'."

msgid "389"
msgstr "Κανείς να μη χτυπήσει βραχμάνο, ούτε ο βραχμάνος να εκδικηθεί·αλίμονο σε αυτόν που χτυπά βραχμάνο, αλίμονο ακόμη περισσότερο σε αυτόν που εκδικείται."

msgid "390"
msgstr "Για τον βραχμάνο αυτό δεν είναι καθόλου καλύτερο, όταν υπάρχει αναχαίτιση του νου από τα αγαπημένα·Από όπου και αν ο βλαπτικός νους αποσύρεται, από εκεί καταλαγιάζει η δυστυχία."

msgid "391"
msgstr "Αυτός που με το σώμα, με την ομιλία, με τον νου δεν έχει ανάρμοστη πράξη·συγκρατημένος σε αυτούς τους τρεις τόπους, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "392"
msgstr "Από όποιον κατανοεί τη Διδασκαλία, διδαγμένη από τον Πλήρως Αυτοφωτισμένο·αυτόν πρέπει να τιμά προσεκτικά, όπως ο βραχμάνος την ιερή φωτιά."

msgid "393"
msgstr "Ούτε από τα πλεγμένα μαλλιά ούτε από το σόι, ούτε από τη γέννηση γίνεται βραχμάνος·σε όποιον υπάρχει αλήθεια και Διδασκαλία, αυτός είναι καθαρός, αυτός είναι βραχμάνος."

msgid "394"
msgstr "Τι σου χρειάζονται τα πλεγμένα μαλλιά, άφρωνα, τι σου χρειάζεται το ένδυμα από δέρμα αντιλόπης·Το εσωτερικό σου είναι πυκνό δάσος, το εξωτερικό καθαρίζεις."

msgid "395"
msgstr "Το ον που φορά κουρέλια, αδύνατο, με φλέβες διάχυτες στο σώμα·μόνο στο δάσος διαλογιζόμενο, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "396"
msgstr "Και δεν αποκαλώ εγώ βραχμάνο, αυτόν που γεννήθηκε από μήτρα, που προήλθε από μητέρα·αυτός ονομάζεται 'αξιότιμε', αν έχει κατοχές·τον μη κατέχοντα τίποτα, τον χωρίς προσκόλληση, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "397"
msgstr "Αφού έκοψε όλους τους νοητικούς δεσμούς, αυτός που πράγματι δεν ταράζεται·τον υπερβάντα την προσκόλληση, τον αποδεσμευμένο, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "398"
msgstr "Αφού έκοψε τη μνησικακία και τη δίψα, την αλυσίδα μαζί με τον κόμπο·τον σηκώσαντα τον μοχλό, τον φωτισμένο, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "399"
msgstr "Αυτός που χωρίς κακία υπομένει την ύβρη, τη δολοφονία και τη φυλάκιση·τον έχοντα τη δύναμη της υπομονής ως στρατιωτική μονάδα, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "400"
msgstr "Τον μη οργίλο, τον ασκούντα ασκητικές πρακτικές, τον ηθικό, τον χωρίς υπερβολή·τον δαμασμένο, τον με το τελευταίο σώμα, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "401"
msgstr "Όπως το νερό στο φύλλο του λωτού, όπως ο σπόρος σιναπιού στην αιχμή της βελόνας·αυτός που δεν προσκολλάται στις ηδονές, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "402"
msgstr "'Αυτός που κατανοεί εδώ ακριβώς την εξάλειψη του πόνου του·τον αποθέσαντα το φορτίο, τον αποδεσμευμένο, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "403"
msgstr "Τον με βαθιά σοφία, τον συνετό, τον επιδέξιο στην οδό και τη μη-οδό·τον φτάσαντα στον ύψιστο σκοπό, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "404"
msgstr "Τον μη συναναστρεφόμενο με οικοδεσπότες, και με τους άστεγους, και με τους δύο·τον μη προσκολλημένο σε κατοικία, τον ολιγαρκή, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "405"
msgstr "Αφού απέθεσε την τιμωρία στα όντα, στα τρέμοντα και στα σταθερά·αυτός που δεν σκοτώνει ούτε προκαλεί φόνο, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "406"
msgstr "Τον μη εχθρικό ανάμεσα στους εχθρικούς, τον κατασβεσμένο ανάμεσα σε αυτούς που κρατούν ρόπαλα·τον χωρίς προσκόλληση ανάμεσα σε αυτούς με προσκόλληση, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "407"
msgstr "Αυτός του οποίου η λαγνεία και το μίσος, η αλαζονεία και η περιφρόνηση έχουν πέσει·όπως ο σπόρος σιναπιού από την αιχμή της βελόνας, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "408"
msgstr "Μη τραχύ, κατανοητό, λόγο αληθινό ας εκφέρει·με τον οποίο δεν προσβάλλει κανέναν, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "409"
msgstr "Αυτός που εδώ είτε μακρύ είτε κοντό, λεπτό ή χοντρό, όμορφο ή άσχημο·στον κόσμο δεν παίρνει το μη δοσμένο, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "410"
msgstr "Αυτός στον οποίο δεν υπάρχουν ελπίδες, σε αυτόν τον κόσμο και στον άλλο·τον χωρίς ελπίδες, τον αποδεσμευμένο, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "411"
msgstr "Αυτός στον οποίο δεν υπάρχουν προσκολλήσεις, που γνωρίζοντας είναι χωρίς αμφιβολία·τον βασισμένο στο αθάνατο και που το έχει επιτύχει, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "412"
msgstr "Αυτός που εδώ και την αξιέπαινη πράξη και την κακή, και τις δύο προσκολλήσεις ξεπέρασε·τον χωρίς λύπη, τον χωρίς σκόνη, τον αγνό, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "413"
msgstr "Σαν τη σελήνη, άσπιλο, αγνό, διαυγές, αθόλωτο·αυτόν στον οποίο η απόλαυση και η ύπαρξη έχουν εξαλειφθεί, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "414"
msgstr "Αυτός που αυτό το λασπώδες μονοπάτι, το δύσβατο, την περιπλάνηση στον κύκλο των επαναγεννήσεων, την αυταπάτη υπερέβη·αυτός που έχει διαβεί, που έχει υπερβεί, διαλογιστής, χωρίς λαχτάρα, χωρίς αμφιβολία·μέσω της μη προσκόλλησης κατασβεσμένος, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "415"
msgstr "Αυτός που εδώ τις ηδονές εγκαταλείποντας, άοικος περιπλανιέται·αυτόν στον οποίο η ηδονή και η ύπαρξη έχουν εξαλειφθεί, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "416"
msgstr "Αυτός που εδώ την επιθυμία εγκαταλείποντας, άοικος περιπλανιέται·αυτόν στον οποίο η επιθυμία και η ύπαρξη έχουν εξαλειφθεί, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "417"
msgstr "'Αφού εγκατέλειψε την ανθρώπινη νοητική δέσμευση, την θεϊκή νοητική δέσμευση υπερέβη·τον αποδεσμευμένο από κάθε νοητική δέσμευση, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "418"
msgstr "Αφού εγκατέλειψε την τέρψη και τη δυσαρέσκεια, τον ψυχρό, τον χωρίς προσκόλληση·τον κυρίαρχο όλου του κόσμου, τον ήρωα, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "419"
msgstr "Αυτός που γνώρισε τον θάνατο των όντων, και την επαναγέννηση πλήρως·τον μη προσκολλημένο, τον καλότυχο, τον φωτισμένο, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "420"
msgstr "Αυτού του οποίου τον προορισμό δεν γνωρίζουν, θεοί, γκαντχάμπα και άνθρωποι·αυτόν που έχει εξαλείψει τις νοητικές διαφθορές, τον Άξιο, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "421"
msgstr "Αυτός στον οποίο στο παρελθόν και στο μέλλον, και στο παρόν δεν υπάρχει καμία κατοχή·τον μη κατέχοντα τίποτα, τον χωρίς προσκόλληση, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "422"
msgstr "Τον ταύρο, τον εξαίρετο, τον ήρωα, τον μεγάλο αναζητητή, τον νικητή·τον χωρίς λαχτάρα, τον λουσμένο, τον φωτισμένο, αυτόν εγώ αποκαλώ βραχμάνο."

msgid "423"
msgstr "Αυτός που γνώρισε τις προηγούμενες ζωές, και βλέπει τον παράδεισο και τους κόσμους της αθλιότητας·και επίσης έφτασε στην εξάλειψη της γέννησης, ο σοφός που ολοκληρώθηκε μέσω της άμεσης γνώσης·τον ολοκληρωμένο σε όλες τις ολοκληρώσεις, αυτόν εγώ αποκαλώ βραχμάνο."

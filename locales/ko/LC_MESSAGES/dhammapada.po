msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "title"
msgstr "법구경"

msgid "chaps"
msgstr "품"

msgid "fontsize"
msgstr "글자 크기"

msgid "chap1"
msgstr "대구 (상대적 구절)"

msgid "1"
msgstr "모든 것을 마음은 다스리고, 마음에서 나와 마음으로 이루어진다. 나쁜 마음을 가지고 말하거나 행하면 괴로움이 따르리니, 마치 소와 말 걸음에 수레바퀴가 따르듯 하리."

msgid "2"
msgstr "모든 것을 마음은 다스리고 마음에서 나와 마음으로 이루어진다. 깨끗한 마음을 가지고 말하거나 행하면 즐거움이 따르리니, 마치 그림자가 꼴을 따르듯 하리."

msgid "3"
msgstr "‘나를 욕했다. 나를 때렸다. 나를 이겼다. 내 것을 훔쳤다.’ 이러한 생각을 품은 이에겐 원한이 가라앉지 않으리라."

msgid "4"
msgstr "‘나를 욕했다. 나를 때렸다. 나를 이겼다. 내 것을 훔쳤다.’ 이러한 생각을 품지 않은 이에겐 원한이 가라앉으리라."

msgid "5"
msgstr "이 세상에서 [품은] 원한은 원한[으로 갚는다고] 풀어지지 않으리니 원한을 버릴 때에만 풀리리라. 아, 변치 않을 영원한 진리여!"

msgid "6"
msgstr "[우리는 이 세상에서 죽어야 할 존재다]라고 깨닫지 못하는 이가 있다. 사람이 만일 이것을 깨달으면 모든 싸움이 사라지리라."

msgid "7"
msgstr "[더러운 것을] 깨끗하다고 보면서 살며, 오관의 욕구를 삭이지 못하고, 음식을 절제하지 못하고, 게으른 데다 근면하지 못한 사람은, 마치 바람이 약한 나무를 넘어뜨리듯 악마가 쉽게 정복한다."

msgid "8"
msgstr "[더러운 것을] 더럽게 보면서 살며 오관의 욕구를 잘 삭이면서 음식을 절제하고, 굳은 신념을 지니고, 근면 정진하는 이는 마치 바람이 바위산을 정복할 수 없듯이, 악마도 정복할 수 없다."

msgid "9"
msgstr "더러운 것을 버리지 못하면 가사(수도승의 옷)를 입으려 할지라도, 절제와 진실이 없기 때문에 가사를 입을 가치가 없으리라."

msgid "10"
msgstr "더러운 것을 버리고 온갖 계명을 지키고 절제와 진실을 지닌 사람은 참으로 가사를 입을 자격이 있다."

msgid "11"
msgstr "만물의 본질이 아닌 것을 본질이라 생각하고, 만물의 본질을 본질 아닌 것으로 보는 사람은, 그릇된 생각에 서서 본질에 이르지 못하리라."

msgid "12"
msgstr "만물의 본질이 본질인 줄 알고, 본질 아닌 것을 본질 아닌 줄 아는 사람은, 바른 생각에 서서 본질에 이르리라."

msgid "13"
msgstr "마치 허술하게 지붕을 이은 집에 비가 새듯이, 수양을 쌓지 않은 마음에는 탐욕이 스며든다."

msgid "14"
msgstr "마치 지붕이 잘 덮인 집에 비가 새지 않듯이, 수양을 쌓은 마음에는 탐욕이 스며들지 못한다."

msgid "15"
msgstr "몹쓸 짓을 한 사람은 이 세상에서 슬퍼하고 저 세상에서 슬퍼하고 두 곳에서 슬퍼한다. 자기의 더러운 행실을 보고 그는 슬퍼하고 괴로워한다."

msgid "16"
msgstr "착한 일을 한 사람은 이 세상에서 기뻐하고 저 세상에서도 기뻐하고 두 곳에서 기뻐한다. 자기의 깨끗한 행실을 보고 그이는 기뻐하고 즐거워한다."

msgid "17"
msgstr "몹쓸 짓을 한 사람은 이 세상에서 괴로워하고, 내세에서도 괴로워하고, 두 곳에서 괴로워한다. ‘몹쓸 짓을 했다’ 하며 괴로워하고, 지옥에 떨어져 다시 괴로워한다."

msgid "18"
msgstr "착한 일을 한 사람은 이 세상에서 기뻐하고 내세에서도 기뻐하고 두 곳에서 기뻐한다. ‘착한 일을 했다’ 하고 기뻐하고, 하늘나라 가서도 더욱 기뻐한다."

msgid "19"
msgstr "가령 많은 경전을 외울지라도 방종하여 실천하지 않는 자는, 남의 소만 세고 있는 목자일 뿐 [참된] 수도자가 되지 못한다."

msgid "20"
msgstr "가령 적은 경전을 외울지라도 법을 따르고, 탐욕, 노여움, 헤매임을 버리고, 바른 지혜가 있고 마음의 자유를 얻고, 이 세상과 저 세상에 얽매이지 않은 이는 참된 수도자에 끼게 된다."

msgid "chap2"
msgstr "근면하라"

msgid "21"
msgstr "게으르지 않음은 영원히 사는 길이요, 게으름은 죽음의 길이다. 게으르지 않은 이는 죽지 않겠지만, 게으른 이는 이미 죽은 거나 마찬가지다."

msgid "22"
msgstr "이 이치를 분명히 알고 거스르지 않는 달인은 게으르지 않음을 기뻐하고, 성인의 경지를 즐기리라."

msgid "23"
msgstr "생각을 깊이 하고 참을성 있고 항상 힘써 애쓰는 어진 이는, 가장 높은 자유와 행복이 있는 열반을 얻으리라."

msgid "24"
msgstr "애쓰고 깊이 생각하고, 행실이 깨끗하고 신중하게 행하고 스스로 억누르고 법에 따라 사는 근면한 사람은 그 영광이 더욱 빛나리라."

msgid "25"
msgstr "애쓰고 부지런하고, 깊은 자제로써 꾹 억누름으로 지혜가 있는 이는, 홍수(번뇌)도 밀어낼 수 없는 섬을 쌓아야 하리."

msgid "26"
msgstr "어리석어 슬기 없는 이는 게으름에 빠지고, 슬기가 있는 이는 귀중한 재산을 지키듯 부지런함을 지킨다."

msgid "27"
msgstr "게으르지 말라. 쾌락을 가까이 말라. 정욕에 가까이 말라. 게으르지 않고 깊은 생각을 하는 이만 큰 안락을 얻으리라."

msgid "28"
msgstr "어진 이가 부지런하여 게으름을 물리칠 때 지혜의 높은 탑에 오르고, 근심을 떠나 근심하는 어리석은 무리들을 내려다본다. 마치 산에 오른 이가 땅에 있는 사람들을 내려다보듯."

msgid "29"
msgstr "게으른 무리 가운데서 부지런하고 잠자는 무리 사이에 깨어 있는 어진 이는, 빠른 말이 느린 말을 앞질러 달리듯이 나아간다."

msgid "30"
msgstr "[마가반(제석천)] 신은 부지런함으로써 모든 신의 으뜸이 되었다. 부지런함은 찬미를 받고, 게으름은 언제나 비난을 받는다."

msgid "31"
msgstr "부지런함을 즐기고 게으름을 두려워하는 수도자(비구)는, 크고 작은 모든 속박을 불같이 태우면서 전진한다."

msgid "32"
msgstr "부지런함을 즐기고 게으름을 두려워하는 수도자는 열반에서 결코 물러서지 않는다."

msgid "chap3"
msgstr "마음"

msgid "33"
msgstr "마음은 불안하여 흔들리고, 지키기 어렵고, 억제하기 어렵다. 어진 이는 마음을 곧게 지키기를 마치 활쟁이가 화살을 [곧게 만들듯이] 곧게 한다."

msgid "34"
msgstr "물속 제 고장에서 물 밖으로 던져진 물고기처럼, 이 마음은 마왕의 세계에서 벗어나려고 파닥거린다."

msgid "35"
msgstr "잡기 어렵고 경솔하고 욕정 따라 헤매는 마음을 억제하기란 즐거운 일이다. 억제된 마음은 안락을 가져다주리라."

msgid "36"
msgstr "몹시 알아보기 어렵고 또 아주 섬세하고, 욕정에 따라 헤매는 마음을 슬기로운 이는 지켜야 하리라. 잘 지켜진 마음은 안락을 가져다주리라."

msgid "37"
msgstr "멀리 홀로 가며, 꼴도 없이 마음속에 숨은 생각을 억제하는 동안에는 마귀의 굴레에서 벗어나리라."

msgid "38"
msgstr "마음이 불안하고 바른 법을 모르며, 신념이 흔들리는 사람의 지혜는 완성을 이루지 못하리라."

msgid "39"
msgstr "마음에 번뇌가 없고 생각이 흔들리지 않고, 또 선악을 초월하고 깨어 있는 사람에겐 두려움이 없으리라."

msgid "40"
msgstr "이 몸은 물항아리처럼 [깨지기 쉬운 줄] 알고, 이 마음을 성곽처럼 굳건히 하고서 지혜를 무기로 가지고 악마와 싸우라. 싸워 얻은 것은 지키고 앞으로 전진하라."

msgid "41"
msgstr "아아, 이 몸은 곧 땅 위에 누으리라. 의식도 없이 쓸모도 없는 나무토막처럼 버림을 받으리."

msgid "42"
msgstr "적이 적을 대하고 원수가 원수를 향하여 어떠한 [악]을 할지라도, 몹쓸 악을 향한 마음은 더욱 큰 악을 사람에게 하리라."

msgid "43"
msgstr "어머니와 아버지, 어느 친척이 주는 선보다도 바른 도를 향한 마음은 우리에게 더 큰 선을 주리."

msgid "chap4"
msgstr "꽃"

msgid "44"
msgstr "누가 이 세상과 염라계와 천상계를 정복할 것인가? 누가 훌륭하게 설법된 진리의 말씀을 모을 것인가? 마치 솜씨 좋은 이가 예쁜 꽃을 찾아 꾸미듯 할 것인가?"

msgid "45"
msgstr "[불교의] 수도자는 이 세상과 염라계와 천상계를 정복할 수 있다. 그 수도자는 훌륭하게 설법된 진리의 말씀을 모을 수 있다. 마치 솜씨 좋은 사람이 예쁜 꽃을 찾아 꾸미듯 하리."

msgid "46"
msgstr "이 몸은 물거품 같고 아지랑이 같은 줄 깨달은 이는, 악마의 꽃화살(유혹)을 끊어 버리고 [지옥의] 염라왕과 만나지 않는 [세계에] 이르리라."

msgid "47"
msgstr "꽃(쾌락)을 꺾는 일에만 마음이 쏠려 애욕에 묻힌 사람은 죽음의 신이 앗아간다. 마치 잠자는 마을을 홍수가 휩쓸어 가듯."

msgid "48"
msgstr "꽃만을 꺾고 마음에 집착을 가지며 애욕에 지칠 줄 모르는 이는 죽음의 마귀가 정복하리라."

msgid "49"
msgstr "벌이 꽃과 향내와 빛깔을 다치지 않고 단 꿀을 따가듯이, 성자(무니)는 마을에서 탁발을 해야 한다."

msgid "50"
msgstr "남의 잘못을 보지 말라. 남이 한 일, 하지 않은 일을 보지 말라. 내가 저지른 것(과실)과 하지 않은 것(게으름)만을 보라."

msgid "51"
msgstr "사랑스럽고 색깔이 아름다울지라도 향기가 없는 꽃처럼 실천이 따르지 않는 훌륭한 말은 효과가 없으리라."

msgid "52"
msgstr "사랑스럽고 색깔이 아름답고 향기 짙은 꽃처럼, 실천이 따른 훌륭한 말은 효과가 있으리라."

msgid "53"
msgstr "쌓아 올린 꽃 무더기에서 꽃다발을 만들 수 있는 것처럼, 사람으로 태어났다면 착한 일을 많이 해야 하리라."

msgid "54"
msgstr "꽃 향기는 바람을 거스르지 못한다. 찬다라, 타가라, 발리카의 향도 마찬가지다. 그러나 착한 사람의 향기는 바람을 거슬러 흘러가고 바른 사람은 모든 방향에 향기를 뿌리리라."

msgid "55"
msgstr "찬다라, 타가라, 푸른 연꽃, 밧시키 따위 많은 향이 있을지라도 계의 향이 가장 뛰어난 것이다."

msgid "56"
msgstr "타가라나 찬다나의 향기는 미미한 것이다. 계를 지키는 이의 향기는 더할 나위 없는 것으로서 신들에게까지도 번지어 간다."

msgid "57"
msgstr "계를 다 지키고, 부지런하고, 바른 지혜로 해탈한 사람은 마왕도 가까이할 수 없다."

msgid "58"
msgstr "큰 길가에 버려진 쓰레기 산더미 속에서도 향기 짙은 아름다운 연꽃이 피어오르듯."

msgid "59"
msgstr "쓰레기처럼 눈먼 중생 가운데 있으면서 바로 깨친 이의 제자는 예지로서 찬란하게 빛나리라."

msgid "chap5"
msgstr "바보"

msgid "60"
msgstr "잠 못 이루는 이에게 밤은 길고, 지쳐 있는 자에겐 지척도 천리다. 바른 진리를 깨닫지 못하는 어리석은 자에게 윤회는 길다."

msgid "61"
msgstr "자기보다 훌륭하거나 비슷한 이를 만나 길을 갈 수 없거든 차라리 혼자서 길을 가라. 어리석은 자와는 길벗이 되지 말라."

msgid "62"
msgstr "어리석은 사람은 ‘이 아이는 내 아들이다’ 또는 ‘내게는 재산이 있다’고 생각하면서 번민한다. 벌써 자신조차 제 것이 못 되는데, 어찌 아들이나 재산을 제 것이라 할 것인가!"

msgid "63"
msgstr "어리석은 자가 [스스로] 어리석은 줄 알고 있다면 그만큼은 어진 이인 것이다. 그러나 어리석은 자가 [스스로] 슬기롭다고 생각한다면 그는 정말 어리석은 사람이다."

msgid "64"
msgstr "어리석은 자가 한평생 어진 이를 섬기더라도 진리를 깨닫지 못하는 것은, 마치 숟가락이 국 맛을 [모르는 것] 같으리."

msgid "65"
msgstr "지혜 있는 이는 한순간이나마 어진 이를 섬긴다면 곧 진리를 깨닫기를, 마치 혀가 국 맛을 [알듯이] 깨달으리."

msgid "66"
msgstr "지혜가 없는 어리석은 사람은 자기를 원수처럼 대하여 행동한다. 괴로운 결과를 부를 몹쓸 행실을 하면서."

msgid "67"
msgstr "행동한 뒤에 뉘우치거나, 눈물을 흘려 울면서 그 대가를 받는다. 이런 행실은 훌륭하게 이루어졌다고 할 수 없다."

msgid "68"
msgstr "행위한 뒤에 뉘우치지도 않고 즐거워하고 반갑게 그 대가를 받게 되는 행실은 훌륭하게 이루어졌다고 할 수 있다."

msgid "69"
msgstr "어리석은 자는 악도 그 과보가 생기기 전엔 그것을 꿀같이 달콤하게 생각한다. 그러나 어리석은 자는 악의 과보가 생기면 그때에야 괴로움을 맛본다."

msgid "70"
msgstr "어리석은 사람은 가령 몇 달을 [쿠사] 풀을 놓아 [적은] 음식을 먹는 고행을 하더라도, 진리를 생각하는 사람의 16분의 1만큼도 값어치가 없다."

msgid "71"
msgstr "나쁜 행실을 해도 새로 짠 우유처럼 곧 굳어지지 않는다. 재로 덮인 불씨처럼 타면서 어리석은 자를 따른다."

msgid "72"
msgstr "어리석은 자에게 지혜가 생겨도 마침내 도움이 되지 않는다. [그 지혜는] 도리어 그의 머리를 부수면서 그의 행운을 좀먹는다."

msgid "73"
msgstr "어리석은 사람은 헛된 명성을 바란다. 수도자들 가운데는 윗자리를, 승단 안에서는 다스리는 권력을, 다른 집에서는 공양을 [바란다]."

msgid "74"
msgstr "[집에 있는 이나 집 떠난 이나 이것을 한 것은 나라고 생각하라. 그들은 해야 할 일이든 하지 말아야 할 일이든 무엇이나 내 마음을 따라야 한다]고 하는 것은 어리석은 자의 생각이요, 욕심과 교만은 점점 커만 가리라."

msgid "75"
msgstr "하나는 이익으로 인도하는 길이요, 하나는 열반으로 인도하는 길이다. 부처님의 제자인 수도승은 이치를 깨닫고 남의 존경을 기뻐하지 말라. 외로운 길 걷기에 한결같으라."

msgid "chap6"
msgstr "어진 이"

msgid "76"
msgstr "잘못과 죄를 가르쳐 주고 꾸짖는 슬기로운 이를 만났으면 그와 사귀어라. 마치 감추어진 보배를 가르쳐 주는 이를 대하듯 하라. 그와 사귀면 이익이 있을 뿐 손해는 없으리니."

msgid "77"
msgstr "계를 지켜라, 가르쳐라. 그리고 부당한 것을 피하라. 이런 이를 선한 이는 사랑하고, 악한 이는 미워하리라."

msgid "78"
msgstr "나쁜 친구와 사귀지 말라. 저속한 사람과도 사귀지 말라. 착한 벗과 사귀고, 가장 훌륭한 사람과 사귀어라."

msgid "79"
msgstr "진리를 사랑하는 사람은 맑은 마음으로 잘 자리라. 어진 이는 언제나 성인들이 말씀한 진리를 즐긴다."

msgid "80"
msgstr "운하의 기사는 물을 끌어들이고, 활쟁이는 화살을 곧게 만든다. 목수는 나무를 곧게 다듬고 어진 이는 자신을 제어한다."

msgid "81"
msgstr "굳은 바위가 바람에 끄떡않는 것처럼, 어진 이는 비방과 칭찬의 소리에도 흔들리지 않는다."

msgid "82"
msgstr "깊은 못이 고요하고 맑은 것처럼, 어진 이는 진리를 듣고 마음이 깨끗해진다."

msgid "83"
msgstr "착한 사람들은 모든 것에서 [욕망을] 버리고, 쾌락을 구하여 헛수고를 하지 않는다. 어진 이는 즐거움을 만나나 괴로움을 만나나 흔들리는 기색이 없다."

msgid "84"
msgstr "나를 위하거나 남을 위해서 아들이나 재산이나 토지를 원하지 말라. 계명을 가지고 지혜를 가지고 바른 사람이 되라."

msgid "85"
msgstr "사람들 가운데서 피안에 이른 이는 아주 적다. 거의 이편 강가에서 서성거릴 뿐이다."

msgid "86"
msgstr "진리가 바로 전해졌을 때 그 이치를 따라간 사람은 피안에 이르리라. [생]사의 세계는 몹시 넘기 어려운 것이다."

msgid "87"
msgstr "어진 이는 악을 버리고 선을 닦아야 하리. 집을 [나와] 집 떠나고 외롭고 쾌락이 없는 곳으로."

msgid "88"
msgstr "묘방의 약을 구하라. 어진 이는 욕망을 버리고 한 푼도 가지지 말라. 마음의 더러움을 씻고 자신을 깨끗이 하라."

msgid "89"
msgstr "깨달음을 얻기 위한 방법으로 마음을 바르게 수양하고 집착을 끊은 다음, 소유욕을 버리고 기뻐하며 번뇌를 다 없애어 빛나는 사람은 이 세상에서 열반에 들어간 것이다."

msgid "chap7"
msgstr "성인"

msgid "90"
msgstr "[속세의] 나그넷길을 마치고 근심을 떠나 모든 면에서 자유를 얻어, 모든 속박을 끊은 사람에겐 고뇌가 없다."

msgid "91"
msgstr "[바르게] 생각하는 사람은 집 떠나고, 쉴 집도 반기지 않는다. 호수를 떠나는 백조처럼 그들은 저마다 집을 떠난다."

msgid "92"
msgstr "저축도 없고, 알맞게 먹고, 공과 무상과 자유를 얻은 이의 길은, 마치 하늘을 나는 새의 [길에] 자취가 없듯이 정녕 따르기 힘들다."

msgid "93"
msgstr "모든 번뇌를 다 끊어버리고, 먹을 것에 구애를 않고 공과 무상과 자유를 얻은 사람들의 발자취는 하늘을 나는 새의 발자취처럼 따르기 힘들다."

msgid "94"
msgstr "잘 길들인 말처럼 모든 감각이 잔잔하고, 교만이나 번뇌를 끊어버린 사람은 신들조차 부러워한다."

msgid "95"
msgstr "경건한 [인격]자는 대지와 같이 거스르지 않고, 또 문지방 같이 깨끗한데, 흙탕이 없는 호수와 같다. 이런 이에게 벌써 윤회가 없다."

msgid "96"
msgstr "바로 깨닫고 자유를 얻어 고요함을 얻은 사람은 마음은 고요에 돌아가고 말과 행동은 조용하다."

msgid "97"
msgstr "망령된 믿음 없이 절대를 깨닫고 윤회의 끈을 끊어버리고 유혹을 물리치고 욕망마저 버린 사람은 참으로 뛰어난 사람이다."

msgid "98"
msgstr "마을이거나 숲속이거나, 푹 패인 땅이거나 또 평지이거나, 예배할 만한 이(아라한)가 사는 곳이면 어딜지라도 즐겁다."

msgid "99"
msgstr "숲속은 즐겁다. 세상 사람들이 즐기지 않는 곳에서 탐욕을 떠난 이들은 즐거우리라. 그들은 감각의 쾌락을 구하지 않기 때문에."

msgid "chap8"
msgstr "천 (일천 번의 노래)"

msgid "100"
msgstr "가령 쓸모없는 말을 모아 천 마디를 만들어도 들을 때 마음이 가라앉는 유익한 한 마디 쪽이 뛰어난 말이니라."

msgid "101"
msgstr "가령 쓸모없는 구절을 모아 천 편의 시를 짓기보다, 들으면 마음이 가라앉는 한 구절의 시가 뛰어난 것이다."

msgid "102"
msgstr "쓸모없는 구절로 된 백 편의 시를 읊기보다, 들으면 마음이 가라앉는 한 편의 시귀가 뛰어난 것이다."

msgid "103"
msgstr "싸움터에서 백만 인을 이기기보다, 자기 하나를 이기는 이가 가장 뛰어난 승리자다."

msgid "104"
msgstr "자기를 이기는 일은 남을 이기는 일보다 뛰어난 것이다. 자신을 억제하고 항상 절제하는 사람의 승리는,"

msgid "105"
msgstr "신도 귀신(건달바)도 마왕도 또한 범천도 이런 이의 승리만은 꺾을 수 없다."

msgid "106"
msgstr "달마다 천금을 들여 백 년 동안 희생을 바치기보다, 단 한 순간이나마 잘 수양한 이를 공양하는 편이 뛰어난 것이다."

msgid "107"
msgstr "숲속에서 백 년 동안 화신에게 제사 지내기보다, 단 한 순간이라도 잘 수양한 사람에게 공양하는 편이 뛰어난 것이다."

msgid "108"
msgstr "이 세상에서 복을 얻기 위하여 한 해 동안 희생을 바치고 제사를 드려도, 그 모든 것은 자신을 잘 수양한 사람을 공경하는 것의 반의반도 못하리라."

msgid "109"
msgstr "잘 공경하고 윗사람을 존경하는 사람에게는 네 가지 복이 더 는다. 곧 나이, 아름다움, 행운, 힘이다."

msgid "110"
msgstr "비록 백 년을 살더라도 계명을 깨뜨리고 마음의 고요를 잃는다면, 바르게 행하며 마음의 고요를 가진 이가 하루 사는 편이 뛰어난 것이다."

msgid "111"
msgstr "비록 백 년을 살지라도 지혜가 없고 마음의 고요를 잃는다면, 지혜가 있고 마음의 고요를 가진 사람이 단 하루를 사는 편이 뛰어난 것이다."

msgid "112"
msgstr "비록 백 년을 살지라도 게으르고 노력하지 않는다면, 부지런히 노력하면서 사는 하루가 낫다."

msgid "113"
msgstr "비록 백 년을 살지라도 낳고 죽는 이치를 모른다면, 낳고 죽는 이치를 아는 이의 하루 사는 편이 뛰어난 것이다."

msgid "114"
msgstr "비록 백 년을 살지라도 죽음이 없는 도를 모른다면, 죽음이 없는 도(열반)를 아는 이가 하루를 사는 편이 더 뛰어난 것이다."

msgid "115"
msgstr "비록 백 년을 살지라도 가장 높은 진리를 모른다면, 가장 높은 진리를 아는 이가 하루를 사는 편이 더 뛰어난 것이다."

msgid "chap9"
msgstr "악"

msgid "116"
msgstr "선한 일은 서둘러 행하고, 악한 일에서는 마음을 멀리하라. 선한 일을 하는 데 게으르면 그의 마음은 악을 즐긴다."

msgid "117"
msgstr "사람이 만일 악을 행했다면 다시는 되풀이하지 말라. 그 일을 즐겁게 여기지 말라. 악이 쌓이는 것은 괴로움이다."

msgid "118"
msgstr "사람이 만일 선한 일을 했다면 늘 그것을 되풀이하라. 그 일을 즐겁게 여기라. 선이 쌓이는 것은 즐거움이다."

msgid "119"
msgstr "악한 자도 그 악의 열매가 맺기 전에는 행복을 맛본다. 그러나 악행의 열매가 생겼을 때, 악한 자는 재앙을 맛본다."

msgid "120"
msgstr "선한 자도 선의 열매가 맺기 전에는 몹쓸 괴로움을 맛본다. 그러나 선행의 열매가 생겼을 때, 선한 자는 행복을 얻는다."

msgid "121"
msgstr "‘내게 업보가 오지 않으리라’ 하고 악을 가볍게 여기지 말라. 물방울이 고여서 항아리를 채운다. 어리석은 자는 조금씩 쌓여서 악으로 가득 차리라."

msgid "122"
msgstr "‘내게 업보가 오지 않으리라’고 선을 가볍게 여기지 말라. 물방울이 고여서 항아리를 채운다. 슬기로운 이는 조금씩 쌓여서 선으로 가득 차리라."

msgid "123"
msgstr "동행이 적고 재물 많은 상인이 위험한 길을 피하듯이, 모든 악행은 피해야 한다."

msgid "124"
msgstr "손에 상처가 없다면 독을 만질 수 있으리라. 상처 없는 자에게 독은 해를 주지 못한다. 악을 행하지 않는 이에게 악은 없다."

msgid "125"
msgstr "순진하고 때 없는 이를 해치고, 깨끗하고 더럽지 않은 이를 해친다면, 악은 오히려 어리석은 자에게 떨어진다. 마치 맞바람에 던진 먼지가 되날아오듯이."

msgid "126"
msgstr "어떤 이는 모태 안에 들어가고, 악인은 지옥으로 떨어지고, 선인은 하늘나라로 올라간다. 모든 번뇌에서 벗어난 이는 열반에 들어가고."

msgid "127"
msgstr "하늘이나 바다나 산속 동굴에 들어가도 악업의 갚음에서 벗어날 세계는 없으리라."

msgid "128"
msgstr "하늘이나 바다나 산속 동굴에 들어가도 거기 머물러 죽음을 벗어날 수 있는 세계는 없으리라."

msgid "chap10"
msgstr "채찍"

msgid "129"
msgstr "모두 채찍을 두려워하고 모두 죽음을 두려워한다. 제 몸에 견주어서 남을 죽이지 말라. 죽이게 하지 말라."

msgid "130"
msgstr "모두 채찍을 두려워하고 모두 삶을 사랑한다. 제 몸에 견주어서 남을 죽이지 말라. 죽이게 하지 말라."

msgid "131"
msgstr "복락을 바라는 중생에게 채찍으로 해치는 자는 자기 복락을 구하여 죽은 다음 복락을 얻지 못하리."

msgid "132"
msgstr "복락을 바라는 중생에게 채찍으로 해치지 않는 사람은 복락을 구하여 죽은 다음 행복을 얻으리."

msgid "133"
msgstr "거친 말을 하지 말라. 가는 말이 고와야 오는 말이 곱다. 성난 말은 고통이다. 채찍은 오히려 내게 돌아오리."

msgid "134"
msgstr "깨진 징처럼 묵묵히 있는 사람은 벌써 열반을 얻은 것이다. 네겐 노여움이 없기 때문에."

msgid "135"
msgstr "소치는 사람이 채찍으로 소를 목장으로 몰고 가듯, 늙음과 죽음은 중생의 목숨을 몰고 간다."

msgid "136"
msgstr "어리석은 자는 악을 행하고도 깨닫지 못하고, 불속에서 타듯 제 행실로써 괴로워하리."

msgid "137"
msgstr "죄 없는 순진한 사람에게 채찍으로 해치는 자는 다음 열 가지 중에서 한 가지 갚음을 만나리라."

msgid "138"
msgstr "곧 심한 고통, 노쇠, 육체의 상처, 중병, 정신착란,"

msgid "139"
msgstr "또는 왕이 내리는 재앙, 지독한 중상, 친척의 멸망, 재산의 파멸,"

msgid "140"
msgstr "또 불이 그의 집을 태우니, 이 열 가지다. 어리석은 자는 죽은 다음 지옥으로 떨어지리."

msgid "141"
msgstr "나체의 고행, 소라처럼 짠 상투도, 몸에 재를 바름도, 또 고요히 앉음 따위 갖가지 고행도 의심을 끊지 못한 중생을 깨끗이 할 수 없다."

msgid "142"
msgstr "몸을 화려하게 꾸몄더라도 냉정하고 고요한 마음을 지니고 제어하며, 자제하고 음욕을 끊고 모든 생명을 해치지 않는다면, 이야말로 바라문이며 수도자이며 수도승이다."

msgid "143"
msgstr "훌륭한 말이 채찍을 피하듯이, 누가 겸손으로 자기 자신을 억제하겠는가?"

msgid "144"
msgstr "채찍을 맞은 훌륭한 말처럼 부지런히 도를 닦으라. 믿음과 계행과 정진으로, 정신 통일과 진리의 식별로, 밝은 지혜와 옳은 행동을 아울러 갖추고 묵상을 다하여 커다란 고통을 없애리라."

msgid "145"
msgstr "운하의 기사는 물을 끌어들이고, 활쟁이는 화살을 곧게 만들고, 목수는 나무를 깎아 다듬고, 덕 있는 이는 자신을 제어한다."

msgid "chap11"
msgstr "늙음"

msgid "146"
msgstr "무엇을 기뻐하고 있는가? 무엇을 즐기고 있는가? 이 세상은 항상 불타고 있는데. 당신들은 암흑에 쌓여 있다. 왜 빛을 구하지 않는가?"

msgid "147"
msgstr "보라, 이 꾸며놓은 형체. 이 몸은 합성된 상처 덩어리요, 언제나 앓고 욕심이 많고 견고하지도 영원하지도 않다."

msgid "148"
msgstr "이 육신은 늙어 시들고 병고의 주머니요 깨지기 쉽다. 썩은 육체는 흩어지고 삶은 반드시 죽음으로 끝난다."

msgid "149"
msgstr "가을에 버려진 표주박처럼, 이 흰 뼈다귀를 보고 무슨 기쁨인들 있으랴!"

msgid "150"
msgstr "뼈로 성곽을 이루고 살과 피로 칠해졌다. 그 속에 늙음과 죽음과 거짓이 도사리고 있다."

msgid "151"
msgstr "찬란하게 꾸민 임금의 수레도 닳아 없어지고 육신도 또한 늙는다. 하지만 착한 이의 교법은 시들지 않으니, 착한 이는 서로 교법을 말한다."

msgid "152"
msgstr "보고 들은 게 적은 사람은 황소처럼 늙는다. 살은 찌지만 지혜는 자라지 않는다."

msgid "153"
msgstr "나는 이 집(육체)을 지은 자를 구하여 찾지 못한 채 여러 생을 보냈으나, 생존은 다 고통이었다."

msgid "154"
msgstr "집을 지은 이여! 이제 당신을 알게 되었다. 당신은 다시 집을 짓지 않으리라. 기둥은 부러지고 서까래는 내려앉았다. 마음은 만물을 떠나 애욕을 다 면할 수 있었다."

msgid "155"
msgstr "젊었을 때 도를 닦지 않고 재산을 모으지 못한 사람은, 고기 없는 못에 사는 늙은 백로처럼 죽어가리라."

msgid "156"
msgstr "젊었을 때 도를 닦지 않고 재산을 모으지 못한 사람은, 부러진 화살처럼 지난 일을 뉘우치며 한숨 지으리라."

msgid "chap12"
msgstr "자기(제 몸)"

msgid "157"
msgstr "자기를 사랑해야 할 줄 안다면 자기를 잘 지켜야 한다. 지혜 있는 이는 밤의 세 때(청년, 장년, 노년의 세 때) 중 한 번쯤은 깨어 있어야 한다."

msgid "158"
msgstr "먼저 자기를 바로 갖추고 남을 가르치라. 그러면 현명한 이는 괴로워하지 않으리라."

msgid "159"
msgstr "남을 가르치듯 스스로 행하면 그 자신을 잘 억제할 수도 있고, 또 남도 잘 억제할 수 있게 될 것이다."

msgid "160"
msgstr "자기만이 자기의 주인, 어떤 주인이 따로 있으랴? 자기만 잘 제어할 때 얻기 힘든 주인을 얻은 것이다."

msgid "161"
msgstr "자기가 한 악은 자기에게서 생겼고 자기에게서 일어난 것이다. 그것은 마치 금강석이 굳은 마니구슬을 부숴버리듯이 어리석은 자를 부숴버린다."

msgid "162"
msgstr "파계가 심한 자는 칡넝쿨이 '샤알라' 나무를 휘어잡아 말라 죽기를 기다리듯, 원수가 바라듯 스스로 파멸한다."

msgid "163"
msgstr "몹쓸 짓과 제게 해되는 행실은 하기 쉽다. 이롭고 선한 일은 행하기 어렵다."

msgid "164"
msgstr "거룩하고 바르게 살아 예배하기에 합당한 이(아라한)의 가르침을 몹쓸 견해로 비방하는 바보들은, 열매가 여물면 저절로 말라죽는 '캇디카' 갈대처럼 스스로 파멸한다."

msgid "165"
msgstr "스스로 악을 행하면 스스로 더러워지고, 스스로 악을 하지 않으면 깨끗해진다. 깨끗함과 더러움은 자신에 달려 있다. 아무도 남을 깨끗하게 할 수는 없다."

msgid "166"
msgstr "아무리 큰일이더라도 남을 위한다는 핑계로 자신의 의무를 등한히 하지 말라. 자기 의무를 알고 그 의무에 충실해야 한다."

msgid "chap13"
msgstr "세속"

msgid "167"
msgstr "비열한 짓을 하지 말라. 그릇된 견해를 따르지 말라. 세속에 속한 무리가 되지 말라."

msgid "168"
msgstr "힘차게 일어나라. 게으르지 말라. 바른 행실을 하라. 바르게 사는 자는 이 세상에서나 저 세상에서나 안락하게 잠잔다."

msgid "169"
msgstr "바른 행실을 하라. 나쁜 행실을 하지 말라. 바르게 행하는 이는 이 세상에서나 저 세상에서나 안락하게 잠잔다."

msgid "170"
msgstr "물거품처럼, 아지랑이처럼 이 세상을 보는 사람은 죽음의 왕을 보지 않으리라."

msgid "171"
msgstr "와서 보라, 임금의 수레처럼 잘 꾸민 이 세계를. 어리석은 자는 그 속에 빠지고, 지혜로운 이는 집착하지 않는다."

msgid "172"
msgstr "전에는 게으렀으나 나중에는 게으르지 않는다면, 그 사람은 구름에서 벗어난 달처럼 이 세상을 비추리라."

msgid "173"
msgstr "몹쓸 행실을 하였을지라도 착한 행실로 덮어버리면, 구름을 벗어난 달처럼 이 세상을 비추리라."

msgid "174"
msgstr "이 세상은 암흑이다. 그 속에서 잘 통찰하는 사람은 드물다. 마치 그물에서 벗어난 새와 같이 하늘에 오르는 이는 적다."

msgid "175"
msgstr "백조는 태양의 길을 가고 신통의 힘으로 하늘을 난다. 현명한 이는 악마와 그 무리들을 쳐부수고 이 세상을 벗어난다."

msgid "176"
msgstr "단 하나인 법을 어기고 거짓말을 하며 내세를 믿지 않는 사람은 어떠한 악이라도 서슴지 않는다."

msgid "177"
msgstr "진실로 욕심이 많은 사람은 하늘나라에 가지 못한다. 어리석은 자는 보시를 찬양하지 않는다. 그러나 현명한 이는 보시를 기뻐함으로써 저 세상에서 복락을 누린다."

msgid "178"
msgstr "온 땅의 왕이 되기보다, 혹은 하늘에 올라가기보다, 온 세상을 다스리기보다, 열반에 들어가는 첫걸음(예류과)은 더 훌륭하다."

msgid "chap14"
msgstr "부처님"

msgid "179"
msgstr "그 승리는 결코 잃지 않고, 그 승리는 이 세상에서 아무도 따를 수 없다. 행동 범위는 한없고 발자취도 없는 부처를 어떠한 도로써 꾀거나 인도할 수 있겠는가?"

msgid "180"
msgstr "그물처럼 뒤엉킨 욕망조차 어디에든 유혹할 수 없다. 행동 범위는 한없고 발자취 없는 부처를 어떠한 도로 꾀어 이끌 수 있겠는가?"

msgid "181"
msgstr "정신 통일에 잠기고 슬기롭고 집 떠난 생활의 고요를 기뻐하며, 깨달음을 얻고 깊이 생각하는 이는 신들조차 부러워한다."

msgid "182"
msgstr "사람으로 태어나기 어렵고 살아가기도 어렵고 바른 가르침을 듣기도 어렵다. 깨달은 사람들(여러 부처)이 나타나기 어렵다."

msgid "183"
msgstr "모든 악을 행하지 않고 선을 행하며 자기 마음을 깨끗이 한다. 이것이 깨달은 이들의 가르침이다."

msgid "184"
msgstr "참고 견딤은 가장 높은 고행이요, 열반은 가장 뛰어난 것이라고 깨달은 이들이 외친다. 참으로 남을 해치는 집 떠난 이는 없고, 남을 괴롭히는 수도자는 없다."

msgid "185"
msgstr "욕하지 않고, 해치지 않고, 계율을 지키고, 음식을 절제하고, 홀로 살면서 앉아 있고, 위없는 사색에 전념한다. 이것이 깨달은 사람들의 가르침이다."

msgid "186"
msgstr "가령 금이 소나기처럼 쏟아질지라도 욕망을 채울 수는 없으리라. '욕망에는 짧은 쾌락과 많은 고통이 있다'고 알고서 현자는"

msgid "187"
msgstr "천상의 쾌락에도 기뻐하지 않는다. 바르게 깨달은 이의 제자는 이 욕망이 다 없어짐을 기뻐한다."

msgid "188"
msgstr "공포에 쫓긴 사람들은 산과 수풀과 동산과 나무와 사당에서 갖가지로 의지할 곳을 구한다."

msgid "189"
msgstr "그러나 그곳은 안전한 의지할 곳이 못 되고 가장 좋은 곳도 아니다. 그런 곳에 의지한 후에도 모든 고통으로부터 벗어나지 못한다."

msgid "190"
msgstr "부처와 교법과 교단에 의지할 곳을 찾은 사람은 바른 지혜로써 네 가지 거룩한 진리(사성제)를 본다."

msgid "191"
msgstr "괴로움과 괴로움이 일어난 원인, 괴로움의 소멸과 괴로움의 소멸에 이르는 여덟 가지 바른 길(팔정도)이 그것이다."

msgid "192"
msgstr "그것만이 안전하고 뛰어난 의지할 곳이다. 이런 의지할 곳을 얻은 후에는 모든 고통으로부터 벗어난다."

msgid "193"
msgstr "거룩한 이는 얻기 어렵다. 아무 데서나 태어나지 않는다. 이런 현명한 사람이 태어난 가문은 안락하며 번영하리라."

msgid "194"
msgstr "깨달은 이의 탄생은 즐겁고, 바른 법을 가르침도 즐겁다. 교단의 단결은 즐겁고, 단결 속에 살고 있는 자들의 수도도 즐겁다."

msgid "195"
msgstr "공양할 만한 분들, 즉 허망을 벗어나 근심과 고민을 초월한 부처 혹은 부처의 제자를 공양하는 것,"

msgid "196"
msgstr "그렇게 마음의 자유를 누리고 공포로부터 벗어난 사람을 공양하는 공덕은 아무도 헤아릴 수 없으리라."

msgid "chap15"
msgstr "행복"

msgid "197"
msgstr "원한을 가진 사람들 가운데서 원한을 버리고 크게 즐기며 살자. 원한을 가진 사람들 가운데 있으니 원한에서 벗어나 살자."

msgid "198"
msgstr "고민하고 있는 사람들 가운데 있으나 고민에서 벗어나 크게 즐기며 살자. 고민하고 있는 사람 가운데 있으니 고민에서 벗어나 살자."

msgid "199"
msgstr "탐욕이 있는 사람들과 함께 살면서 탐욕에서 벗어나 크게 즐기며 살자. 탐욕이 있는 사람들과 살면서 탐욕에서 벗어나 살자."

msgid "200"
msgstr "아무것도 가지지 않고 크게 즐기며 살자. 우리는 광음천의 신들처럼 즐거움을 먹으며 살자."

msgid "201"
msgstr "승리는 원한을 낳고, 패자는 괴로움에 쓰러진다. 승리와 패배를 모두 버리고 마음의 고요를 얻은 사람은 즐겁게 산다."

msgid "202"
msgstr "탐욕과 같은 불길은 없고, 노여움과 같은 죄악은 없으며, 육체(오온)보다 더한 괴로움은 없고, 마음의 고요보다 더한 안락은 없다."

msgid "203"
msgstr "굶주림은 가장 큰 병이요, 형성된 것들(오온)은 가장 큰 괴로움이다. 이것을 참으로 안다면 최고의 안락인 열반에 이르리라."

msgid "204"
msgstr "건강은 가장 큰 이익이고, 만족은 가장 큰 재산이다. 신뢰는 가장 귀한 친척이고, 열반은 가장 높은 복락이다."

msgid "205"
msgstr "홀로 있음의 맛과 고요함의 맛을 본 사람은, 진리의 기쁜 맛을 느끼며 공포와 악으로부터 벗어난다."

msgid "206"
msgstr "성인을 만나는 것은 좋은 일이다. 그와 함께 살면 언제나 즐겁다. 어리석은 자를 만나지 않는다면 늘 편안하고 즐거우리라."

msgid "207"
msgstr "어리석은 자와 함께 걷는 자는 오래도록 괴로워한다. 어리석은 자와 사는 것은 원수와 사는 것처럼 언제나 고통이다. 현명한 사람과 사는 것은 친척들의 모임처럼 즐겁다."

msgid "208"
msgstr "그러므로 달이 별들의 궤도를 따르듯이, 현명하고 지혜롭고 널리 배우고 인내하며 믿음이 있는 거룩한 사람, 이러한 선인과 선지식을 따르라."

msgid "chap16"
msgstr "쾌락"

msgid "209"
msgstr "수행해야 할 것을 잊고 명상에 전념하지 못하며, 뜻있는 일을 버리고 좋아하는 것만을 따르는 자는, 명상에 깊이 잠긴 이를 부러워하게 된다."

msgid "210"
msgstr "사랑하는 사람과 만나지 말라. 미워하는 사람과도 만나지 말라. 사랑하는 이를 만나지 못함은 괴로움이요, 미워하는 이를 만나는 것도 괴로움이다."

msgid "211"
msgstr "그러므로 사랑하는 사람을 만들지 말라. 사랑하는 이를 잃는 것도 재앙이기 때문이다. 사랑과 미움이 없는 사람은 얽매임이 없다."

msgid "212"
msgstr "사랑에서 근심이 생기고 사랑에서 두려움이 생긴다. 사랑에서 벗어난 이에게는 근심이 없는데, 어찌 두려움이 있으랴!"

msgid "213"
msgstr "집착에서 근심이 생기고 집착에서 두려움이 생긴다. 집착에서 벗어난 이에게는 근심이 없으니 어찌 두려움이 있으랴."

msgid "214"
msgstr "탐닉에서 근심이 생기고 탐닉에서 두려움이 생긴다. 탐닉에서 벗어난 이에게는 근심이 없으니 어찌 두려움이 있으랴."

msgid "215"
msgstr "애욕에서 근심이 생기고 애욕에서 두려움이 생긴다. 애욕에서 벗어난 이에게는 근심이 없으니 어찌 두려움이 있으랴."

msgid "216"
msgstr "욕망에서 근심이 생기고 욕망에서 두려움이 생긴다. 욕망에서 벗어난 이에게는 근심이 없으니 어찌 두려움이 있으랴."

msgid "217"
msgstr "계행과 통찰력을 갖추고 바르게 행하며, 진실을 말하고 자기 의무를 다하는 자는 이웃의 사랑을 받으리라."

msgid "218"
msgstr "말할 수 없는 경지(열반)에 이르기를 바라고, 생각이 깊으며 갖가지 욕망에서 벗어난 이를 ‘흐름을 거슬러 올라가는 사람’이라 부른다."

msgid "219"
msgstr "오랜 세월 타향을 헤매다가 무사히 고향으로 돌아온 사람을 친척이나 친구들이 반겨 맞이하듯,"

msgid "220"
msgstr "사랑하는 사람이 멀리서 돌아올 때 친척들이 환영하듯, 자신이 지은 선행의 공덕이 저 세상에 이른 그를 환영한다."

msgid "chap17"
msgstr "노여움"

msgid "221"
msgstr "노여움을 버리고 거만을 버리라. 세속적인 속박을 뛰어넘으라. 명칭과 형태에 집착하지 않고 아무것도 가진 것이 없는 사람은 괴로움에 쫓기지 않는다."

msgid "222"
msgstr "달리는 마차를 제어하듯 일어나는 노여움을 삭이는 이를 나는 진짜 ‘마부’라고 부르겠다. 다른 사람들은 고삐만을 쥐고 있을 뿐이다."

msgid "223"
msgstr "온화함으로 노여움을 이기고, 선행으로 악행을 이기라. 베풂으로써 인색함을 이기고, 진실로써 거짓을 이기라."

msgid "224"
msgstr "진실을 말하라. 노여워하지 말라. 비록 아주 적은 것이라도 청하거든 주라. 이 세 가지 덕행으로써 신들의 곁으로 가리라."

msgid "225"
msgstr "남을 해치지 않고 항상 육신을 절제하는 성자들은 불멸의 자리(열반)에 이른다. 거기에 이르면 더 이상 근심하지 않는다."

msgid "226"
msgstr "항상 깨어 있고 밤낮으로 공부하며 열반을 추구하는 이의 번뇌는 마침내 사라진다."

msgid "227"
msgstr "아툴라여, 이것은 옛날부터 전해오는 것이지 오늘날 시작된 게 아니다. 침묵을 지켜도 비난을 받고, 말을 많이 해도 비난을 받으며, 적당히 말해도 비난을 받는다. 이 세상에 비난받지 않는 자는 아무도 없다."

msgid "228"
msgstr "오직 비난만 받거나 오직 칭찬만 받는 사람은 과거에도 없었고 미래에도 없을 것이며 현재에도 존재하지 않는다."

msgid "229"
msgstr "현자가 날마다 살펴보고 ‘행실에 흠이 없고 총명하여 지혜와 계행을 갖추었다’고 칭찬하는 이가 있다면,"

msgid "230"
msgstr "그는 ‘잠부강의 정금으로 만든 금화’와 같으니, 누가 그를 비방하겠는가? 신들도 그를 칭찬하고 범천도 칭찬하리라."

msgid "231"
msgstr "몸의 노여움을 막고 몸을 제어하라. 몸의 악행을 버리고 몸으로써 선행을 하라."

msgid "232"
msgstr "말의 노여움을 막고 말을 제어하라. 말의 악행을 버리고 말로써 선행을 하라."

msgid "233"
msgstr "마음의 노여움을 막고 마음을 제어하라. 마음의 악행을 버리고 마음으로써 선행을 하라."

msgid "234"
msgstr "현자는 몸을 억제하고 또한 말을 억제하며 마음을 억제한다. 그들이야말로 참으로 잘 제어된 이들이다."

msgid "chap18"
msgstr "더러움"

msgid "235"
msgstr "너는 이제 시든 낙엽이다. 죽음의 사자가 이미 네 곁에 와 있고, 너는 죽음으로 가는 길목에 서 있다. 그런데 네게는 노자마저 없구나."

msgid "236"
msgstr "스스로 피난처를 만들라. 서둘러 노력하고 현명하라. 더러움을 털고 죄에서 벗어나면, 하늘나라 거룩한 땅으로 올라가리라."

msgid "237"
msgstr "이제 죽을 때가 가까워졌고 죽음의 왕 앞에 와 있다. 도중에는 쉴 집도 없는데, 노자마저 없구나."

msgid "238"
msgstr "스스로 피난처를 만들라. 서둘러 노력하고 현명하라. 더러움을 털고 죄로부터 벗어나면, 다시는 태어남과 늙음의 길로 들어서지 않으리라."

msgid "239"
msgstr "마치 대장장이가 은의 불순물을 제거하듯, 슬기로운 이는 서서히 그리고 차례대로 자신의 더러움을 제거해야 한다."

msgid "240"
msgstr "쇠에서 생긴 녹이 쇠를 먹어 들어가듯, 방종한 자는 자기 행위 때문에 스스로 파멸의 길로 이끌려간다."

msgid "241"
msgstr "외우지 않음은 경전의 더러움이요, 수리하지 않음은 집의 더러움이다. 게으름은 외모의 더러움이며, 방종은 계를 지키는 자의 더러움이다."

msgid "242"
msgstr "부정한 행위는 부인의 더러움이요, 인색함은 보시자의 더러움이다. 참으로 악행은 이 세상과 저 세상의 모든 더러움이다."

msgid "243"
msgstr "그러나 이런 더러움 가운데서도 가장 큰 더러움은 무명(진리에 대한 무지)이다. 비구들이여, 이 더러움을 씻어 버림으로써 때 묻지 않은 이가 되라."

msgid "244"
msgstr "수치를 모르고, 뻔뻔스럽고, 남을 헐뜯기 좋아하며, 무모하고 더러운 사람에게 인생은 살기 쉽다."

msgid "245"
msgstr "수치를 알고 언제나 깨끗함을 구하며, 집착하지 않고 겸손하고 조촐하게 사는 식견 있는 이에게 인생은 살기 힘들다."

msgid "246"
msgstr "살생을 하고, 거짓을 말하며, 세상에서 주어지지 않은 것을 취하고, 남의 아내를 범하며,"

msgid "247"
msgstr "취하게 하는 술에 빠져버린 사람은, 바로 이 세상에서 자신의 뿌리를 파내고 있는 셈이다."

msgid "248"
msgstr "오 사람들이여! ‘자제가 없음은 악덕이다’라는 사실을 알아두라. 탐욕과 불법(不法)으로 인해 오랫동안 고통받지 말라."

msgid "249"
msgstr "사람은 각자 믿는 바와 좋아하는 것에 따라 보시한다. 그러므로 남이 얻은 음식에 불만을 품으면 밤낮으로 안정을 얻지 못한다."

msgid "250"
msgstr "이러한 불만을 끊고 뿌리째 없앤 사람은 밤낮으로 마음의 안정을 누린다."

msgid "251"
msgstr "탐욕처럼 심한 불길은 없고, 노여움처럼 심한 얽매임은 없으며, 어리석음에 비길 그물도 없고, 갈애와 같은 거센 물결도 없다."

msgid "252"
msgstr "남의 허물은 보기 쉽지만 자기 허물은 보기 어렵다. 남의 허물은 겨처럼 까불러 흩어버리지만, 자기 허물은 도박꾼이 불리한 패를 숨기듯 감춘다."

msgid "253"
msgstr "남의 허물만을 찾아내어 항상 비난하는 마음을 품은 사람은 번뇌가 자란다. 그는 번뇌를 없애기는커녕 오히려 늘려갈 뿐이다."

msgid "254"
msgstr "허공에는 길이 없고, 불교 밖에는 참된 수도자가 없다. 중생은 허망한 것을 즐거워하지만, 여래에게는 허망함이 없다."

msgid "255"
msgstr "허공에는 길이 없고, 불교 밖에는 참된 수도자가 없다. 형성된 것들 가운데 영원한 것은 없으며, 깨달은 이들에게는 동요가 없다."

msgid "chap19"
msgstr "진리에 삶"

msgid "256"
msgstr "강제로 남을 이끈다고 해서 진리에 사는 사람이라 할 수 없다. 옳고 그름을 잘 분별하는 현명한 사람이어야 한다."

msgid "257"
msgstr "강제가 아니라 정의와 평등으로 남을 인도하고, 법을 지키는 지혜를 가진 사람을 ‘진리에 사는 이’라 부른다."

msgid "258"
msgstr "말을 많이 한다고 해서 슬기로운 사람이 아니다. 고요하고 미움과 두려움에서 벗어난 사람을 어진 이라 부른다."

msgid "259"
msgstr "말을 많이 한다고 해서 법을 지키는 자가 아니다. 배운 것이 적더라도 몸소 진리를 체험하고, 진리를 소홀히 하지 않는 이가 참으로 법을 가진 이다."

msgid "260"
msgstr "머리카락이 희다고 해서 장로가 아니다. 지혜 없이 나이만 헛되이 먹었다면 그는 단지 ‘늙은이’라 불릴 뿐이다."

msgid "261"
msgstr "정직과 진리, 해치지 않음과 절제와 자제를 실천하고 더러움을 벗어난 이를 참된 장로라 한다."

msgid "262"
msgstr "말을 잘하거나 용모가 아름답다 해도, 질투와 인색과 간사함에 찬 사람은 훌륭한 인물이 아니다."

msgid "263"
msgstr "질투와 인색과 간사함을 뿌리째 뽑아 없애버리고, 노여움을 여읜 현명한 사람을 훌륭한 인물이라 한다."

msgid "264"
msgstr "서원을 지키지 않고 거짓말을 하는 자는 머리를 깎더라도 수도자가 아니다. 욕망과 탐애에 차 있는 자가 어떻게 수도자가 될 수 있겠는가?"

msgid "265"
msgstr "크고 작은 모든 악을 가라앉힌 사람은, 모든 악을 정복했기에 ‘수도자’라 부를 수 있다."

msgid "266"
msgstr "단지 걸식한다는 것만으로 수도승이라 할 수 없다. 모든 법을 실천해야 수도승이 되는 것이지, 형식만으로는 수도승이라 하지 않는다."

msgid "267"
msgstr "이 세상에서 선과 악을 모두 버리고 순결을 지키며 신중하게 세상을 살아가는 사람을 참된 수도승이라 한다."

msgid "268"
msgstr "침묵을 지키더라도 어리석고 무지하다면 성자가 아니다. 어진 이가 저울질하듯 좋은 것만 취하고 악을 멀리한다면,"

msgid "269"
msgstr "그렇게 악을 물리치는 이가 바로 성자다. 그는 그것으로써 성자가 된다. 이 세상에서 선과 악 양면의 의미를 알면 그를 성자라 부른다."

msgid "270"
msgstr "살아 있는 것을 해치는 자는 성인이 아니다. 모든 생명을 가련히 여기고 해치지 않기에 그를 성인이라 부른다."

msgid "271"
msgstr "계행과 서원, 박식함 때문만이 아니요, 정신 통일을 얻었기 때문만도 아니며, 홀로 조용한 곳에 살기 때문만도 아니다."

msgid "272"
msgstr "범속한 사람이 누릴 수 없는 출가 수행의 즐거움을 누리고 있더라도, 오 수도승이여! 모든 번뇌를 다 끊기 전까지는 결코 방심하지 말라."

msgid "chap20"
msgstr "길"

msgid "273"
msgstr "모든 길 가운데 ‘여덟 가지 바른 길(팔정도)’이 가장 뛰어나고, 모든 진리 가운데 ‘네 가지 거룩한 진리(사성제)’가 가장 뛰어나며, 모든 덕목 가운데 ‘탐욕을 떠남’이 가장 뛰어나고, 모든 사람 가운데 참으로 ‘눈 밝은 이(부처)’가 가장 뛰어나다."

msgid "274"
msgstr "이것이 길이다. 지견을 맑게 하는 다른 길은 있을 수 없다. 이 길을 따르라. 이것은 악마를 어지럽게 하리라."

msgid "275"
msgstr "이 길을 가면 괴로움을 없앨 수 있으리라. 나는 괴로움의 화살을 뽑는 법을 알고서 이 길을 가리킨 것이다."

msgid "276"
msgstr "해야 할 일은 스스로 노력하는 것이다. 여래는 길을 가리키는 자일 뿐이다. 그 길을 실천하는 자는 마왕의 사슬에서 벗어나리라."

msgid "277"
msgstr "‘모든 형성된 것은 덧없다’고 지혜로써 깨닫는 이는 괴로움에서 멀어진다. 이것이 깨끗함에 이르는 길이다."

msgid "278"
msgstr "‘모든 형성된 것은 괴로움이다’라고 지혜로써 깨닫는 이는 괴로움에서 멀어진다. 이것이 깨끗함에 이르는 길이다."

msgid "279"
msgstr "‘모든 것은 실체가 없다(제법무아)’고 지혜로써 깨닫는 이는 괴로움에서 멀어진다. 이것이 깨끗함에 이르는 길이다."

msgid "280"
msgstr "일어나야 할 때 일어나지 않고, 젊고 힘이 있음에도 게으름에 빠지며, 의지나 생각이 나약한 사람은 지혜로써 길을 찾지 못한다."

msgid "281"
msgstr "말을 조심하고 마음을 자제하며 몸으로 악을 짓지 말아야 한다. 이 세 가지 업을 깨끗이 닦으라. 그러면 옛 성인이 가르치신 길에 이르리라."

msgid "282"
msgstr "명상에서 지혜가 솟아나고, 명상이 없으면 지혜도 사라진다. 번영과 쇠퇴의 두 길을 알고 지혜가 늘도록 자신을 확립하라."

msgid "283"
msgstr "탐욕의 숲을 자르라. 나무 한 그루를 자르는 데 그치지 말라. 탐욕의 숲에서 두려움이 생긴다. 비구들이여, 탐욕의 숲과 애욕의 덤불을 모두 베어내고 욕망 없는 이가 되라."

msgid "284"
msgstr "여자에 대한 남자의 욕정은 아무리 작더라도 끊어지기 전에는 그 사람의 마음을 묶어 놓는다. 마치 송아지가 어미 젖에 매달리듯이."

msgid "285"
msgstr "가을의 연꽃을 손으로 꺾듯 자신에 대한 애착을 끊으라. 부처님께서 가르쳐 주신 평화의 길, 열반에 이르는 길을 닦으라."

msgid "286"
msgstr "‘장마철에는 여기서 살고, 겨울과 여름에는 여기서 살겠다’라고 어리석은 자는 생각하지만, 죽음이 다가오는 줄은 깨닫지 못한다."

msgid "287"
msgstr "자식이나 가축에만 마음을 빼앗기고 그것에 집착하는 자는 죽음이 휩쓸어 간다. 마치 홍수가 잠든 마을을 휩쓸어 가듯이."

msgid "288"
msgstr "자식도 구할 수 없고, 아버지나 친척도 구할 수 없다. 죽음의 신에게 붙잡힌 자를 친척이라 할지라도 구할 수 없다."

msgid "289"
msgstr "이 이치를 깨달은 어진 이는 계행을 지키고, 열반에 이르는 길을 신속히 닦아야 한다."

msgid "chap21"
msgstr "여러 가지 일"

msgid "290"
msgstr "만일 조그만 즐거움을 버림으로써 큰 즐거움을 얻을 수 있다면, 어진 이는 큰 즐거움을 얻기 위해 작은 즐거움을 기꺼이 버릴 것이다."

msgid "291"
msgstr "남에게 고통을 주어 자신의 즐거움을 구하는 자는 원한의 사슬에 얽매여 결코 원한에서 벗어날 수 없다."

msgid "292"
msgstr "해야 할 일을 등한히 하고 해서는 안 될 일을 하며, 교만하고 방종에 빠진 자에게는 번뇌가 점점 늘어난다."

msgid "293"
msgstr "항상 몸의 본질을 관찰하고 해서는 안 될 일을 하지 않으며, 해야 할 일을 꾸준히 실천하는 이는 번뇌가 모두 사라진다."

msgid "294"
msgstr "어머니(갈애)와 아버지(자만)를 죽이고, 두 국왕(상주론과 단멸론)을 죽이고, 신하들과 그 영토(감각 기관과 대상)를 파괴한 바라문은 고통 없이 나아간다."

msgid "295"
msgstr "어머니와 아버지를 죽이고, 두 바라문 왕을 죽이고, 다섯 가지 장애(호랑이)를 제거한 성자는 고통 없이 나아간다."

msgid "296"
msgstr "고타마의 제자들은 언제나 깨어 있으며, 밤낮으로 부처님을 생각한다."

msgid "297"
msgstr "고타마의 제자들은 언제나 깨어 있으며, 밤낮으로 가르침(법)을 생각한다."

msgid "298"
msgstr "고타마의 제자들은 언제나 깨어 있으며, 밤낮으로 승가(교단)를 생각한다."

msgid "299"
msgstr "고타마의 제자들은 언제나 깨어 있으며, 밤낮으로 자신의 몸(신념처)을 관찰한다."

msgid "300"
msgstr "고타마의 제자들은 언제나 깨어 있으며, 밤낮으로 모든 생명을 해치지 않는 자비심을 즐거워한다."

msgid "301"
msgstr "고타마의 제자들은 언제나 깨어 있으며, 밤낮으로 마음 닦는 수행(명상)을 즐거워한다."

msgid "302"
msgstr "출가자의 삶은 즐거움을 얻기 어렵고 고되다. 그렇다고 재가자의 삶 또한 힘들고 괴롭다. 마음이 맞지 않는 이들과 사는 것은 고통이며, 윤회의 길을 걷는 나그네는 늘 괴롭다. 그러므로 번뇌의 나그네가 되지 말라. 그러면 고통에 떨어지지 않으리라."

msgid "303"
msgstr "신심이 깊고 계행을 갖추었으며 덕망과 재력을 가진 사람은, 어느 곳에 가더라도 존경을 받는다."

msgid "304"
msgstr "훌륭한 사람은 히말라야 산처럼 멀리 있어도 빛나지만, 악한 사람은 밤에 쏜 화살처럼 가까이 있어도 보이지 않는다."

msgid "305"
msgstr "홀로 앉고 홀로 자며 홀로 행동하여 지치지 않고, 숲속에서 홀로 자신을 억제하며 명상을 즐기는 사람이 되라."

msgid "chap22"
msgstr "지옥"

msgid "306"
msgstr "거짓말을 하는 자는 지옥에 떨어진다. 또한 악행을 저지르고도 ‘나는 하지 않았다’고 말하는 자도 지옥에 떨어진다. 이처럼 비열한 짓을 한 자들은 죽어서 저세상에서 똑같이 고통받으리라."

msgid "307"
msgstr "가사를 목에 걸치더라도 행실이 나쁘고 자제력이 없는 사람은, 그 악행 때문에 지옥에 떨어진다."

msgid "308"
msgstr "계를 어기고 절제함 없이 신도들의 보시를 받으며 살기보다는, 차라리 불에 달궈진 쇳덩이를 삼키는 것이 낫다."

msgid "309"
msgstr "방종하여 남의 아내를 범하는 자는 네 가지 불행을 겪으리라. 첫째는 죄업을 쌓는 것이요, 둘째는 편안히 잠들지 못함이며, 셋째는 비난받는 것이요, 넷째는 지옥에 떨어지는 것이다."

msgid "310"
msgstr "죄업을 얻고 악도에 떨어지니, 겁에 질린 남녀의 즐거움은 짧기만 하다. 나라의 법 또한 무거운 벌을 내린다. 그러므로 남의 아내를 가까이하지 말라."

msgid "311"
msgstr "쿠사(Kusa) 풀도 잘못 잡으면 손을 베는 것처럼, 잘못된 수행자의 길은 자신을 지옥으로 끌어들인다."

msgid "312"
msgstr "행실을 함부로 하고, 서원을 더럽히며, 마지못해 하는 수행은 큰 결실을 얻을 수 없다."

msgid "313"
msgstr "해야 할 일이 있다면 단호하게 행하라. 수행자가 게으르면 오히려 번뇌의 먼지만을 더 뿌릴 뿐이다."

msgid "314"
msgstr "악행은 하지 않는 것이 상책이니, 악행은 나중에 반드시 후회하게 되기 때문이다. 선행은 행하는 것이 상책이니, 선행은 나중에 결코 후회함이 없으리라."

msgid "315"
msgstr "변방의 성을 안팎으로 견고히 지키듯 자기 자신을 지켜라. 단 한 순간도 방심하지 말라. 기회를 놓친 자는 지옥에 떨어져 한탄하게 되리라."

msgid "316"
msgstr "부끄러워할 일이 아닌데 부끄러워하고, 정작 부끄러운 일에는 수치를 느끼지 못한다. 이러한 그릇된 견해를 가진 자들은 악도에 떨어진다."

msgid "317"
msgstr "두려워할 일이 아닌데 두려워하고, 정작 두려워해야 할 일에는 두려움을 모른다. 그릇된 견해를 가진 자들은 지옥으로 들어간다."

msgid "318"
msgstr "허물이 없는데 허물이 있다 생각하고, 허물이 있는데도 허물이 없다고 본다. 그릇된 견해를 가진 사람은 악한 곳으로 떨어진다."

msgid "319"
msgstr "죄가 있는 것을 죄로 알고, 죄가 없는 것을 죄가 없는 줄로 안다. 이처럼 바른 견해를 가진 사람들은 좋은 곳(천상)에 태어난다."

msgid "chap23"
msgstr "코끼리"

msgid "320"
msgstr "싸움터에서 화살을 맞고도 참아내는 코끼리처럼, 나도 비난을 견디리라. 세상에는 절제하지 못하는 사람들이 많기 때문이다."

msgid "321"
msgstr "길들인 코끼리를 싸움터에 데려가고, 왕도 길들인 코끼리에 올라탄다. 비난을 참고 견디며 자신을 길들인 자는 사람들 가운데 가장 뛰어난 이다."

msgid "322"
msgstr "길들인 노새도 좋고, 인더스 산의 명마도 좋으며, 큰 전투용 코끼리도 좋다. 그러나 자기 자신을 다스리는 사람은 그보다 더 훌륭하다."

msgid "323"
msgstr "훈련된 짐승을 타고서는 가보지 못한 땅(열반)에 이를 수 없다. 오직 자신을 잘 다스린 사람만이 그곳에 도달할 수 있다."

msgid "324"
msgstr "다나팔라카(Dhanapālaka)라는 코끼리는 발정기가 되면 다루기 힘들어진다. 붙잡히면 먹이를 전혀 먹지 않는데, 이는 숲속의 동료들을 그리워하기 때문이다."

msgid "325"
msgstr "빈둥빈둥 먹기만 하고 잠만 탐하며 뒹구는 모습이 사육되는 큰 돼지와 같다면, 이런 게으름뱅이는 몇 번이고 다시 태어나 윤회를 되풀이하게 된다."

msgid "326"
msgstr "이 마음은 예전에 바라는 대로, 원하는 대로, 즐거움을 따라 헤매었다. 이제 나는 이 마음을 완전히 제어하겠다. 마치 갈퀴를 든 조련사가 코끼리를 다루듯이."

msgid "327"
msgstr "방심하지 않음을 즐기고 자기 마음을 굳게 지키라. 진흙탕에 빠진 코끼리가 스스로 빠져나오듯 어려운 처지에서 자신을 구하라."

msgid "328"
msgstr "총명하고 바르게 행하며 어진 반려가 될 친구를 얻었다면, 온갖 위험을 이겨내고 깨어 있는 마음으로 기꺼이 그와 함께 가라."

msgid "329"
msgstr "총명하고 바르게 행하는 어진 반려를 얻지 못했다면, 차라리 홀로 가라. 마치 정복한 나라를 버리고 떠나는 왕처럼, 또는 숲속을 홀로 다니는 코끼리처럼."

msgid "330"
msgstr "홀로 살아가는 것은 훌륭한 일이니 어리석은 자를 벗하지 말라. 악행을 저지르지 말고, 숲속의 코끼리처럼 욕심 없이 홀로 걸어라."

msgid "331"
msgstr "어려운 일이 생겼을 때 벗이 있음은 즐겁고, 어떤 처지에서든 스스로 만족함은 즐겁다. 죽음에 임박했을 때 쌓아온 공덕은 즐겁고, 모든 고통에서 벗어나는 것은 즐겁다."

msgid "332"
msgstr "이 세상에서 어머니를 공경함은 즐겁고 아버지를 공경함도 즐겁다. 수행자가 되는 것도 즐겁고 성스러운 성자가 되는 것도 즐겁다."

msgid "333"
msgstr "늙을 때까지 계율을 지키는 것도 즐겁고, 신심이 굳건히 서 있음도 즐겁다. 지혜를 얻음은 즐겁고 악에서 벗어남 또한 즐겁다."

msgid "chap24"
msgstr "애욕"

msgid "334"
msgstr "방종한 자의 갈애는 넝쿨처럼 자란다. 마치 숲속에서 열매를 찾아다니는 원숭이처럼, 그는 이 생에서 저 생으로 헤매어 다닌다."

msgid "335"
msgstr "이 세상에서 이 천박한 집착인 갈애에 정복된 사람에게는, 비를 맞아 무성해진 풀처럼 근심이 자라난다."

msgid "336"
msgstr "이 세상에서 다스리기 어려운 천박한 갈애를 물리친 사람은 모든 근심을 여읠 것이다. 마치 물방울이 연꽃잎에서 굴러떨어지듯이."

msgid "337"
msgstr "여기 모인 모든 분께 말하노니, 향기로운 뿌리를 얻기 위해 잡초를 파내듯 갈애의 뿌리를 뽑으시오. 그리하여 강물이 갈대를 꺾듯 악마가 당신을 꺾지 못하게 하시오."

msgid "338"
msgstr "나무가 잘려도 뿌리가 깊이 박혀 있다면 다시 자라나듯, 갈애의 잠재된 힘을 뿌리 뽑지 않으면 생사의 고통은 자꾸만 되풀이된다."

msgid "339"
msgstr "쾌락의 흐름으로 치달리는 서른여섯 개의 거센 물줄기를 가진 자, 그 탐욕에 덮인 마음의 흐름은 그릇된 견해를 가진 이를 휩쓸어 가리라."

msgid "340"
msgstr "갈애의 흐름은 사방으로 흐르고, 욕망의 넝쿨은 뻗어 나가기만 한다. 넝쿨이 뻗어 나가는 것을 보았다면 지혜로써 그 뿌리를 잘라 버려라."

msgid "341"
msgstr "사람의 기쁨은 갈애에 젖어 있고 집착하기 쉽다. 환락에 빠져 다른 쾌락을 구하는 사람들은 결국 태어남과 늙음의 굴레에 갇힌다."

msgid "342"
msgstr "갈애에 쫓기는 사람들은 덫에 걸린 토끼처럼 뱅뱅 돈다. 속박과 집착에 얽매여 오랫동안 고통을 받는다."

msgid "343"
msgstr "갈애에 쫓기는 사람들은 덫에 걸린 토끼처럼 뱅뱅 돈다. 그러므로 수행자는 갈애를 털어버리고 욕망에서 벗어나기를 바라야 한다."

msgid "344"
msgstr "애욕의 숲에서 나와 다시 애욕의 숲으로 기어들고, 속박에서 벗어나 다시 속박으로 달려가는 사람을 보라. 그는 자유를 얻었다가 다시 구속되는구나."

msgid "345"
msgstr "현명한 이는 쇠나 나무, 줄로 만든 사슬이 강하다고 하지 않는다. 보석으로 만든 귀걸이, 자식이나 아내에 대한 애착이 훨씬 더 강하다고 한다."

msgid "346"
msgstr "현명한 이는 끌어당기고 늦추기 어려운 이 속박이 참으로 강하다고 한다. 이 사슬을 끊고 미련 없는 마음을 가진 사람만이 애욕을 버리고 출가한다."

msgid "347"
msgstr "갈애에 물든 자는 스스로 만든 흐름을 따라간다. 마치 거미가 스스로 짠 거미줄을 따라가듯이. 현명한 이는 이 갈애를 끊고 애착을 버려 모든 괴로움을 뒤로하고 떠난다."

msgid "348"
msgstr "저 언덕(해탈)에 도달하고자 하는 자는 과거와 미래와 현재에 대한 집착을 버려라. 마음이 완전히 자유로워지면 다시는 태어남과 늙음을 겪지 않으리라."

msgid "349"
msgstr "의혹으로 마음이 흔들리고 강한 탐욕에 차 있으며, 부정한 것을 깨끗하다고 보는 사람의 갈애는 더욱 자라나 속박을 더욱 견고하게 만든다."

msgid "350"
msgstr "의혹이 가라앉음을 기뻐하고 부정한 것을 있는 그대로 부정하게 보며 항상 깨어 있으면, 마왕의 굴레를 끊고 그를 소멸시킬 것이다."

msgid "351"
msgstr "궁극의 경지에 이르러 두려움이 없고 갈애도 죄도 없는 이는 생존의 가시를 꺾었다. 이것으로 그의 윤회는 마지막이 된다."

msgid "352"
msgstr "갈애를 떠나 집착이 없고 경전의 의미를 밝히 알며, 문자의 결합과 순서를 아는 자는 참으로 마지막 몸을 받은 이요, 위대한 성자라 불린다."

msgid "353"
msgstr "나는 모든 것을 이겼고 모든 것을 알고 있다. 어떤 것에도 물들지 않으며 모든 것을 버리고 갈애를 없애 자유를 얻었다. 스스로 깨달았으니 누구를 스승이라 부르겠는가?"

msgid "354"
msgstr "진리의 보시는 모든 보시보다 뛰어나고, 진리의 맛은 모든 맛보다 뛰어나다. 진리의 즐거움은 모든 즐거움을 능가하고, 갈애의 소멸은 모든 괴로움을 이긴다."

msgid "355"
msgstr "재물은 어리석은 자를 파멸시키지만, 저 언덕을 구하는 이를 파멸시킬 수는 없다. 어리석은 자는 재물에 대한 탐욕으로 남과 자신을 함께 망친다."

msgid "356"
msgstr "잡초는 논밭을 망치고 탐욕은 사람들을 망친다. 그러므로 탐욕에서 벗어난 이에게 바치는 공양은 큰 과보를 가져온다."

msgid "357"
msgstr "잡초는 논밭을 망치고 노여움은 사람들을 망친다. 그러므로 노여움에서 벗어난 이에게 바치는 공양은 큰 과보를 가져온다."

msgid "358"
msgstr "잡초는 논밭을 망치고 미망은 사람들을 망친다. 그러므로 미망에서 벗어난 이에게 바치는 공양은 큰 과보를 가져온다."

msgid "359"
msgstr "잡초는 논밭을 망치고 욕망은 사람들을 망친다. 그러므로 욕망에서 벗어난 이에게 바치는 공양은 큰 과보를 가져온다."

msgid "chap25"
msgstr "수행자"

msgid "360"
msgstr "눈을 제어하고 귀를 제어하며, 코와 혀를 제어함은 참으로 훌륭한 일이다."

msgid "361"
msgstr "몸을 제어하고 말을 제어하며, 마음을 제어하고 모든 것을 제어함은 참으로 훌륭한 일이다. 모든 것을 제어하는 수행자는 모든 괴로움에서 벗어난다."

msgid "362"
msgstr "손과 발을 삼가고, 말을 삼가며 극진히 조심하고, 안으로 기뻐하며 마음이 안정되어 홀로 만족해하는 사람, 그를 수행자라 부른다."

msgid "363"
msgstr "혀를 제어하고 현명하게 말하며, 교만하지 않고 진리의 의미를 밝히는 수행자의 가르침은 달고 아름답다."

msgid "364"
msgstr "진리를 즐기고 진리를 기뻐하며, 진리를 명상하고 진리를 따르는 수행자는 바른 법에서 물러나지 않는다."

msgid "365"
msgstr "자신이 얻은 것을 가볍게 여기지 말고 남의 것을 부러워하지 말라. 남의 것을 부러워하는 수행자는 마음의 평화를 얻지 못한다."

msgid "366"
msgstr "비록 얻은 것이 적더라도 그것을 가벼이 여기지 않는 수행자를 신들은 칭찬한다. 그의 삶은 깨끗하고 게으르지 않기 때문이다."

msgid "367"
msgstr "몸과 마음에 있어 ‘내 것’이라는 집착이 없고, 있던 것이 없어진다고 해서 슬퍼하지 않는 사람, 그를 수행자라 부른다."

msgid "368"
msgstr "자애로운 마음으로 살며 부처님의 가르침에 전념하는 수행자는 고요를 얻고, 모든 형성된 것들이 멈춘 안락한 경지에 이르리라."

msgid "369"
msgstr "수행자여, 배 안에 스며든 물을 퍼내라. 배가 비면 가볍게 빨리 달릴 것이다. 이와 같이 탐욕과 노여움을 끊어버리면 열반에 이르리라."

msgid "370"
msgstr "다섯 가지 낮은 단계의 속박을 끊고, 다섯 가지 높은 단계의 속박을 제거하라. 그리고 다시 다섯 가지 감각 기관을 정복하라. 다섯 가지 집착을 넘어선 수행자를 ‘폭류를 건넌 이’라 부른다."

msgid "371"
msgstr "수행자여, 명상하라. 방종하지 말라. 마음이 감각적 욕정에 휩쓸리지 않게 하라. 방종하여 지옥의 뜨거운 쇳덩이를 삼키지 말며, 불길에 데면서 ‘아, 괴롭다’고 울부짖지 말라."

msgid "372"
msgstr "지혜가 없는 자에게 명상이 없고, 명상이 없는 자에게 지혜가 없다. 지혜와 명상을 함께 갖춘 이는 열반에 가까이 있는 것이다."

msgid "373"
msgstr "고요한 마음으로 빈집에 들어가 마음을 가라앉히고, 바르게 진리를 관찰하는 수행자는 인간계를 넘어선 천상적인 기쁨을 얻는다."

msgid "374"
msgstr "육체를 구성하는 요소들의 생겨남과 사라짐을 관찰할 때마다, 그는 불멸의 진리를 깨닫는 기쁨과 행복을 얻는다."

msgid "375"
msgstr "지혜로운 수행자가 먼저 해야 할 일은 다음과 같다. 감각 기관을 제어하고 만족할 줄 알며, 계율을 지키고 정진하며, 깨끗하고 부지런한 친구와 사귀는 것이다."

msgid "376"
msgstr "언제나 친절하게 행동하고 자신의 의무를 다하라. 그러면 기쁨이 넘쳐흘러 괴로움을 끝낼 수 있으리라."

msgid "377"
msgstr "수행자여, 재스민 꽃이 시든 잎을 떨구듯, 탐욕과 노여움을 완전히 털어버려라."

msgid "378"
msgstr "몸이 고요하고 말이 고요하며 마음 또한 고요하여 잘 안정되고, 세상의 유혹을 물리친 수행자를 ‘고요에 이른 이’라 부른다."

msgid "379"
msgstr "스스로 자신을 채찍질하고 스스로를 살펴라. 수행자여, 이와 같이 자신을 보호하고 반성하면 당신은 언제나 행복하게 살리라."

msgid "380"
msgstr "자신이야말로 자신의 주인이고, 자신이야말로 자신의 의지처다. 그러므로 상인이 좋은 말을 길들이듯 자기 자신을 잘 다스려라."

msgid "381"
msgstr "부처님의 가르침을 믿고 기뻐하는 수행자는 모든 형성된 것들이 멈춘 평화롭고 행복한 경지(열반)에 이를 것이다."

msgid "382"
msgstr "비록 나이가 젊더라도 부처님의 가르침에 전념하는 수행자는 구름을 벗어난 달처럼 이 세상을 환하게 비추리라."

msgid "chap26"
msgstr "바라문"

msgid "383"
msgstr "바라문이여, 용감하게 갈애의 흐름을 끊으라. 감각적 욕락을 내버리라. 모든 형성된 것이 소멸함을 안다면, 비로소 불멸의 열반을 깨닫게 되리라."

msgid "384"
msgstr "바라문이 통찰과 명상이라는 두 가지 법으로 피안(저 언덕)에 이르렀을 때, 슬기로운 그에게는 온갖 구속이 사라진다."

msgid "385"
msgstr "저 언덕(피안)도 없고 이 언덕(차안)도 없으며, 공포와 구속으로부터 완전히 벗어난 사람, 나는 그를 바라문이라 부른다."

msgid "386"
msgstr "마음이 안정되어 평화롭게 살고, 할 일을 다 마쳐 번뇌가 없으며, 지극히 높은 목적(해탈)에 도달한 이, 나는 그를 바라문이라 부른다."

msgid "387"
msgstr "태양은 낮에 빛나고 달은 밤에 비추며, 왕은 무장했을 때 빛나고 바라문은 명상 중에 빛난다. 그러나 부처님은 밤낮없이 그 위엄 있는 광명으로 온 세상을 비춘다."

msgid "388"
msgstr "악을 멀리했기에 바라문이라 하고, 행실이 고요하기에 수행자라 한다. 자기 안의 더러움을 털어버렸기에 출가자라 한다."

msgid "389"
msgstr "바라문을 때리지 말라. 바라문 또한 맞더라도 원망하지 마라. 바라문을 때리는 것도 잘못이지만, 때린 이를 원망하며 거역하는 것은 더 큰 잘못이다."

msgid "390"
msgstr "바라문이 집착하는 마음을 억제한다면 그것은 큰 축복이다. 해치려는 마음이 사라질수록 모든 고통도 가라앉으리라."

msgid "391"
msgstr "몸이나 말이나 마음으로 악을 행하지 않고, 이 세 가지를 잘 자제하는 이, 나는 그를 바라문이라 부른다."

msgid "392"
msgstr "바르게 깨달은 이(부처님)가 가르치신 법을 누구에게 배웠을지라도, 그 스승을 공경하라. 마치 바라문이 제단 위의 불을 공경하듯이."

msgid "393"
msgstr "머리 모양이나 가문, 계급 때문에 바라문이 되는 것이 아니다. 진리와 법을 갖춘 자, 그가 진정한 바라문이며 행복한 사람이다."

msgid "394"
msgstr "어리석은 자여, 겉모습을 꾸미는 것이 무슨 소용인가? 가죽 옷을 입은들 무엇하겠는가? 그대의 속은 욕망의 밀림이거늘, 겉만 깨끗이 꾸미고 있구나."

msgid "395"
msgstr "누더기를 입고 수척하여 힘줄이 드러나 있지만, 홀로 숲속에서 명상에 잠겨 있는 이, 나는 그를 바라문이라 부른다."

msgid "396"
msgstr "태생이 바라문이라고 해서 그를 바라문이라 부르지 않는다. 그는 단지 부유하고 거만한 자일 뿐이다. 아무것도 가진 것 없이 집착에서 벗어난 이, 나는 그를 바라문이라 부른다."

msgid "397"
msgstr "모든 속박을 끊어버려 두려움이 없고, 어떤 집착도 넘어선 이, 나는 그를 바라문이라 부른다."

msgid "398"
msgstr "분노의 가죽끈과 욕망의 밧줄, 그릇된 견해의 사슬을 끊고, 무지라는 빗장을 뽑아 던져 깨달음을 얻은 이, 나는 그를 바라문이라 부른다."

msgid "399"
msgstr "욕설과 매질과 구금에 처할지라도 노여움 없이 이를 견디며, 인내라는 강력한 군대를 가진 이, 나는 그를 바라문이라 부른다."

msgid "400"
msgstr "노여워하지 않고 의무를 다하며, 계율을 지키고 갈애를 떠나 스스로 자제하여 마지막 몸을 받은 이, 나는 그를 바라문이라 부른다."

msgid "401"
msgstr "연꽃잎의 물방울이나 바늘 끝의 겨자씨처럼, 온갖 욕정에 물들지 않는 이, 나는 그를 바라문이라 부른다."

msgid "402"
msgstr "이 세상에서 이미 자신의 고통이 다한 줄 알고, 무거운 번뇌의 짐을 내려놓아 초연해진 이, 나는 그를 바라문이라 부른다."

msgid "403"
msgstr "지혜가 깊고 슬기로우며, 바른 길과 그른 길을 분별하여 최상의 목적지(열반)에 도달한 이, 나는 그를 바라문이라 부른다."

msgid "404"
msgstr "재가자든 출가자든 누구와도 얽매이지 않고, 집 없이 떠돌며 욕심이 적은 이, 나는 그를 바라문이라 부른다."

msgid "405"
msgstr "강하든 약하든 어떤 생명에게도 폭력을 쓰지 않으며, 죽이거나 죽게 하지 않는 이, 나는 그를 바라문이라 부른다."

msgid "406"
msgstr "적대하는 이들 가운데서 적대하지 않고, 폭력을 휘두르는 이들 가운데서 평화로우며, 집착하는 이들 가운데서 집착하지 않는 이, 나는 그를 바라문이라 부른다."

msgid "407"
msgstr "바늘 끝에서 떨어진 겨자씨처럼 탐욕과 노여움, 자만과 경멸을 다 털어버린 이, 나는 그를 바라문이라 부른다."

msgid "408"
msgstr "거칠거나 야비하지 않고 명석한 진실만을 말하며, 그 말로 사람의 감정을 상하게 하지 않는 이, 나는 그를 바라문이라 부른다."

msgid "409"
msgstr "이 세상에서 길건 짧건, 크건 작건, 좋건 나쁘건 간에 주지 않은 것은 결코 취하지 않는 이, 나는 그를 바라문이라 부른다."

msgid "410"
msgstr "이 세상이나 저 세상에 대해 바라는 바가 없고, 어떤 기대나 사로잡힘도 없는 이, 나는 그를 바라문이라 부른다."

msgid "411"
msgstr "아무런 집착도 없고 진리를 깨달아 의심을 벗어났으며, 불멸의 심연에 이른 이, 나는 그를 바라문이라 부른다."

msgid "412"
msgstr "이 세상에서 선과 악의 집착을 다 버리고, 근심 없이 깨끗해진 이, 나는 그를 바라문이라 부른다."

msgid "413"
msgstr "달처럼 깨끗하고 맑으며, 흐트러짐 없이 모든 갈애를 다 없앤 이, 나는 그를 바라문이라 부른다."

msgid "414"
msgstr "험난한 윤회와 미망의 길을 건너 저 언덕에 이르고, 명상에 잠겨 욕망과 의심과 집착을 버리고 고요해진 이, 나는 그를 바라문이라 부른다."

msgid "415"
msgstr "이 세상에서 모든 욕정을 버리고 집을 떠나 수행하며, 생존의 갈애를 다 끊어버린 이, 나는 그를 바라문이라 부른다."

msgid "416"
msgstr "이 세상에서 모든 욕망을 버리고 집을 떠나 수행하며, 갈망의 불길을 완전히 끈 이, 나는 그를 바라문이라 부른다."

msgid "417"
msgstr "인간적인 속박을 끊고 천상계의 구속마저 넘어서서, 모든 속박에서 벗어난 이, 나는 그를 바라문이라 부른다."

msgid "418"
msgstr "즐거움과 즐겁지 않음을 다 버리고, 번뇌 없이 청량하며 세상을 이긴 영웅, 나는 그를 바라문이라 부른다."

msgid "419"
msgstr "중생의 삶과 죽음을 환히 알고, 집착 없이 깨달음을 얻은 행복한 이, 나는 그를 바라문이라 부른다."

msgid "420"
msgstr "신들도 건달바도 인간도 그가 간 자취를 알 수 없으며, 번뇌를 다 없앤 아라한, 나는 그를 바라문이라 부른다."

msgid "421"
msgstr "과거에도 미래에도 현재에도 아무것도 가진 것이 없고, 무소유의 경지에서 집착을 여읜 이, 나는 그를 바라문이라 부른다."

msgid "422"
msgstr "소 중의 왕처럼 고결하고 영웅적인 위대한 선인이요, 승리자이며 번뇌의 때를 씻어버린 이, 나는 그를 바라문이라 부른다."

msgid "423"
msgstr "전생을 알고 천상과 지옥을 꿰뚫어 보며, 다시는 태어나지 않는 경지에 이른 완성된 성자, 나는 그를 바라문이라 부른다."

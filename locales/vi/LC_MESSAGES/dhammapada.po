msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "title"
msgstr "Kinh Pháp Cú"

msgid "chaps"
msgstr "Chương"

msgid "fontsize"
msgstr "Cỡ chữ"

msgid "chap1"
msgstr "Song Yếu"

msgid "1"
msgstr ""
"Ý dẫn đầu các pháp,\n"
"Ý làm chủ, ý tạo;\n"
"Nếu với ý ô nhiễm,\n"
"Nói lên hay hành động,\n"
"Khổ não bước theo sau,\n"
"Như xe, chân vật kéo."

msgid "2"
msgstr ""
"Ý dẫn đầu các pháp,\n"
"Ý làm chủ, ý tạo;\n"
"Nếu với ý thanh tịnh,\n"
"Nói lên hay hành động,\n"
"An lạc bước theo sau,\n"
"Như bóng, không rời hình."

msgid "3"
msgstr ""
"“Nó mắng tôi, đánh tôi,\n"
"Nó thắng tôi, cướp tôi”,\n"
"Ai ôm hiềm hận ấy,\n"
"Hận thù không thể nguôi."

msgid "4"
msgstr ""
"“Nó mắng tôi, đánh tôi,\n"
"Nó thắng tôi, cướp tôi”,\n"
"Không ôm hiềm hận ấy,\n"
"Hận thù được tự nguôi."

msgid "5"
msgstr ""
"Với hận diệt hận thù,\n"
"Đời này không có được.\n"
"Không hận diệt hận thù,\n"
"Là định luật ngàn thu."

msgid "6"
msgstr ""
"Người khác không hiểu biết,\n"
"Chúng ta đây bị hại.\n"
"Chỗ ấy, ai biết được,\n"
"Tranh luận được lắng êm."

msgid "7"
msgstr ""
"Ai sống nhìn tịnh tướng,\n"
"Không hộ trì các căn,\n"
"Ăn uống thiếu tiết độ,\n"
"Biếng nhác, chẳng tinh cần.\n"
"Ma uy hiếp kẻ ấy,\n"
"Như cây yếu trước gió."

msgid "8"
msgstr ""
"Ai sống quán bất tịnh,\n"
"Khéo hộ trì các căn,\n"
"Ăn uống có tiết độ,\n"
"Có lòng tin, tinh cần,\n"
"Ma không uy hiếp được,\n"
"Như núi đá trước gió."

msgid "9"
msgstr ""
"Ai mặc áo cà sa,\n"
"Tâm chưa rời uế trược,\n"
"Không tự chế, không thực,\n"
"Không xứng áo cà sa."

msgid "10"
msgstr ""
"Ai rời bỏ uế trược,\n"
"Giới luật khéo nghiêm trì,\n"
"Tự chế, sống chơn thực,\n"
"Thật xứng áo cà sa."

msgid "11"
msgstr ""
"Không chân, tưởng chân thật,\n"
"Chân thật, thấy không chân,\n"
"Họ không đạt chân thật,\n"
"Do tà tư tà hạnh."

msgid "12"
msgstr ""
"Chân thật, biết chân thật,\n"
"Không chân, biết không chân.\n"
"Chúng đạt được chân thật,\n"
"Do chánh tư, chánh hạnh."

msgid "13"
msgstr ""
"Như ngôi nhà vụng lợp,\n"
"Mưa liền xâm nhập vào.\n"
"Cũng vậy tâm không tu,\n"
"Tham dục liền xâm nhập."

msgid "14"
msgstr ""
"Như ngôi nhà khéo lợp,\n"
"Mưa không xâm nhập vào.\n"
"Cũng vậy tâm khéo tu,\n"
"Tham dục không xâm nhập."

msgid "15"
msgstr ""
"Nay sầu, đời sau sầu,\n"
"Kẻ ác, hai đời sầu;\n"
"Nó sầu, nó ưu não,\n"
"Thấy nghiệp uế mình làm."

msgid "16"
msgstr ""
"Nay vui, đời sau vui,\n"
"Làm phước, hai đời vui.\n"
"Người ấy vui, an vui,\n"
"Thấy nghiệp tịnh mình làm."

msgid "17"
msgstr ""
"Nay than, đời sau than,\n"
"Kẻ ác, hai đời than,\n"
"Than rằng: “Ta làm ác”,\n"
"Đọa cõi dữ, than hơn."

msgid "18"
msgstr ""
"Nay sướng, đời sau sướng,\n"
"Làm phước, hai đời sướng.\n"
"Mừng rằng: “Ta làm thiện”,\n"
"Sanh cõi lành, sướng hơn."

msgid "19"
msgstr ""
"Nếu người nói nhiều kinh,\n"
"Không hành trì, phóng dật;\n"
"Như kẻ chăn bò người,\n"
"Không phần Sa môn hạnh."

msgid "20"
msgstr ""
"Dầu nói ít kinh điển,\n"
"Nhưng hành pháp, tùy pháp,\n"
"Từ bỏ tham, sân, si,\n"
"Tỉnh giác, tâm giải thoát,\n"
"Không chấp thủ hai đời,\n"
"Dự phần Sa môn hạnh."

msgid "chap2"
msgstr "Không Phóng Dật"

msgid "21"
msgstr ""
"Không phóng dật, đường sống,\n"
"Phóng dật là đường chết.\n"
"Không phóng dật, không chết,\n"
"Phóng dật như chết rồi."

msgid "22"
msgstr ""
"Biết rõ sai biệt ấy,\n"
"Người trí không phóng dật,\n"
"Hoan hỷ không phóng dật,\n"
"An vui hạnh bậc Thánh."

msgid "23"
msgstr ""
"Người hằng tu thiền định,\n"
"Thường kiên trì tinh tấn.\n"
"Bậc trí hưởng Niết Bàn,\n"
"Ách an tịnh vô thượng."

msgid "24"
msgstr ""
"Nỗ lực, giữ chánh niệm,\n"
"Tịnh hạnh, hành thận trọng,\n"
"Tự điều, sống theo pháp,\n"
"Ai sống không phóng dật,\n"
"Tiếng lành ngày tăng trưởng."

msgid "25"
msgstr ""
"Nỗ lực, không phóng dật,\n"
"Tự điều, khéo chế ngự.\n"
"Bậc trí xây hòn đảo,\n"
"Nước lụt khó ngập tràn."

msgid "26"
msgstr ""
"Họ ngu si thiếu trí,\n"
"Chuyên sống đời phóng dật.\n"
"Người trí không phóng dật,\n"
"Như giữ tài sản quý."

msgid "27"
msgstr ""
"Chớ sống đời phóng dật,\n"
"Chớ mê say dục lạc.\n"
"Không phóng dật, thiền định,\n"
"Đạt được an lạc lớn."

msgid "28"
msgstr ""
"Người trí dẹp phóng dật,\n"
"Với hạnh không phóng dật,\n"
"Leo lầu cao trí tuệ,\n"
"Không sầu, nhìn khổ sầu.\n"
"Bậc trí đứng núi cao,\n"
"Nhìn kẻ ngu, đất bằng."

msgid "29"
msgstr ""
"Tinh cần giữa phóng dật,\n"
"Tỉnh thức giữa quần mê.\n"
"Người trí như ngựa phi,\n"
"Bỏ sau con ngựa hèn."

msgid "30"
msgstr ""
"Đế Thích không phóng dật,\n"
"Đạt ngôi vị Thiên chủ.\n"
"Không phóng dật, được khen;\n"
"Phóng dật, thường bị trách."

msgid "31"
msgstr ""
"Vui thích không phóng dật,\n"
"Tỷ kheo sợ phóng dật,\n"
"Bước tới như lửa hừng,\n"
"Thiêu kiết sử lớn nhỏ."

msgid "32"
msgstr ""
"Vui thích không phóng dật,\n"
"Tỷ kheo sợ phóng dật,\n"
"Không thể bị thối đọa,\n"
"Nhất định gần Niết Bàn."

msgid "chap3"
msgstr "Tâm"

msgid "33"
msgstr ""
"Tâm hoảng hốt dao động,\n"
"Khó hộ trì, khó nhiếp,\n"
"Người trí làm tâm thẳng,\n"
"Như thợ tên, làm tên."

msgid "34"
msgstr ""
"Như cá quăng trên bờ,\n"
"Vất ra ngoài thủy giới;\n"
"Tâm này vũng vẫy mạnh,\n"
"Hãy đoạn thế lực Ma."

msgid "35"
msgstr ""
"Khó nắm giữ, khinh động,\n"
"Theo các dục quay cuồng.\n"
"Lành thay, điều phục tâm;\n"
"Tâm điều, an lạc đến."

msgid "36"
msgstr ""
"Tâm khó thấy, tế nhị,\n"
"Theo các dục quay cuồng.\n"
"Người trí phòng hộ tâm,\n"
"Tâm hộ, an lạc đến."

msgid "37"
msgstr ""
"Chạy xa, sống một mình,\n"
"Không thân, ẩn hang sâu.\n"
"Ai điều phục được tâm,\n"
"Thoát khỏi Ma trói buộc."

msgid "38"
msgstr ""
"Ai tâm không an trú,\n"
"Không biết chân diệu pháp,\n"
"Tịnh tín bị rúng động,\n"
"Trí tuệ không viên thành."

msgid "39"
msgstr ""
"Tâm không đầy tràn dục,\n"
"Tâm không hận công phá,\n"
"Đoạn tuyệt mọi thiện ác,\n"
"Kẻ tỉnh không sợ hãi."

msgid "40"
msgstr ""
"Biết thân như đồ gốm,\n"
"Trú tâm như thành trì,\n"
"Chống Ma với gươm trí;\n"
"Giữ chiến thắng không tham."

msgid "41"
msgstr ""
"Không bao lâu thân này,\n"
"Sẽ nằm dài trên đất,\n"
"Bị vất bỏ, vô thức,\n"
"Như khúc cây vô dụng."

msgid "42"
msgstr ""
"Kẻ thù hại kẻ thù,\n"
"Oan gia hại oan gia,\n"
"Không bằng tâm hướng tà,\n"
"Gây ác cho tự thân."

msgid "43"
msgstr ""
"Điều mẹ cha bà con,\n"
"Không có thể làm được,\n"
"Tâm hướng chánh làm được,\n"
"Làm được tốt đẹp hơn."

msgid "chap4"
msgstr "Hoa"

msgid "44"
msgstr ""
"Ai chinh phục đất này,\n"
"Dạ ma, Thiên giới này?\n"
"Ai khéo giảng Pháp cú,\n"
"Như người khéo hái hoa?"

msgid "45"
msgstr ""
"Hữu học chinh phục đất,\n"
"Dạ ma, Thiên giới này.\n"
"Hữu học giảng Pháp cú,\n"
"Như người khéo hái hoa."

msgid "46"
msgstr ""
"Biết thân như bọt nước,\n"
"Ngộ thân là như huyễn,\n"
"Bẻ tên hoa của Ma,\n"
"Vượt tầm mắt thần chết."

msgid "47"
msgstr ""
"Người nhặt các loại hoa,\n"
"Ý đắm say, tham nhiễm,\n"
"Bị thần chết mang đi,\n"
"Như lụt trôi làng ngủ."

msgid "48"
msgstr ""
"Người nhặt các loại hoa,\n"
"Ý đắm say, tham nhiễm,\n"
"Các dục chưa thỏa mãn,\n"
"Đã bị chết chinh phục."

msgid "49"
msgstr ""
"Như ong đến với hoa,\n"
"Không hại sắc và hương,\n"
"Che chở hoa, lấy nhụy.\n"
"Bậc Thánh đi vào làng."

msgid "50"
msgstr ""
"Không nên nhìn lỗi người,\n"
"Người làm hay không làm.\n"
"Nên nhìn tự chính mình,\n"
"Có làm hay không làm."

msgid "51"
msgstr ""
"Như bông hoa tươi đẹp,\n"
"Có sắc nhưng không hương.\n"
"Cũng vậy, lời khéo nói,\n"
"Không làm, không kết quả."

msgid "52"
msgstr ""
"Như bông hoa tươi đẹp,\n"
"Có sắc lại thêm hương;\n"
"Cũng vậy, lời khéo nói,\n"
"Có làm, có kết quả."

msgid "53"
msgstr ""
"Như từ một đống hoa,\n"
"Nhiều tràng hoa được làm.\n"
"Cũng vậy, thân sanh tử,\n"
"Phải làm nhiều việc lành."

msgid "54"
msgstr ""
"Hương các loại hoa thơm\n"
"Không ngược bay chiều gió\n"
"Nhưng hương người đức hạnh\n"
"Ngược gió khắp tung bay\n"
"Chỉ có bậc chân nhân\n"
"Tỏa khắp mọi phương trời."

msgid "55"
msgstr ""
"Hoa chiên đàn, già la,\n"
"Hoa sen, hoa vũ quý,\n"
"Giữa những hương hoa ấy,\n"
"Giới hương là vô thượng."

msgid "56"
msgstr ""
"Ít giá trị hương này,\n"
"Hương già la, chiên đàn;\n"
"Chỉ hương người đức hạnh,\n"
"Tối thượng tỏa Thiên giới."

msgid "57"
msgstr ""
"Nhưng ai có giới hạnh,\n"
"An trú không phóng dật,\n"
"Chánh trí, chơn giải thoát,\n"
"Ác ma không thấy đường."

msgid "58"
msgstr ""
"Như giữa đống rác nhớp,\n"
"Quăng bỏ trên đường lớn,\n"
"Chỗ ấy hoa sen nở,\n"
"Thơm sạch, đẹp ý người."

msgid "59"
msgstr ""
"Cũng vậy giữa quần sanh,\n"
"Uế nhiễm, mù, phàm tục,\n"
"Đệ tử bậc Chánh Giác,\n"
"Sáng ngời với Tuệ Trí."

msgid "chap5"
msgstr "Ngu"

msgid "60"
msgstr ""
"Đêm dài cho kẻ thức,\n"
"Đường dài cho kẻ mệt,\n"
"Luân hồi dài, kẻ ngu,\n"
"Không biết chơn diệu pháp."

msgid "61"
msgstr ""
"Tìm không được bạn đường,\n"
"Hơn mình hay bằng mình,\n"
"Thà quyết sống một mình,\n"
"Không bè bạn kẻ ngu."

msgid "62"
msgstr ""
"Con tôi, tài sản tôi,\n"
"Người ngu sanh ưu não,\n"
"Tự ta, ta không có,\n"
"Con đâu, tài sản đâu."

msgid "63"
msgstr ""
"Người ngu nghĩ mình ngu,\n"
"Nhờ vậy thành có trí.\n"
"Người ngu tưởng có trí,\n"
"Thật xứng gọi chí ngu."

msgid "64"
msgstr ""
"Người ngu, dầu trọn đời,\n"
"Thân cận người có trí,\n"
"Không biết được Chánh pháp,\n"
"Như muỗng với vị canh."

msgid "65"
msgstr ""
"Người trí, dầu một khắc,\n"
"Thân cận người có trí,\n"
"Biết ngay chân diệu pháp,\n"
"Như lưỡi với vị canh."

msgid "66"
msgstr ""
"Người ngu si thiếu trí,\n"
"Tự ngã thành kẻ thù.\n"
"Làm các nghiệp không thiện,\n"
"Phải chịu quả đắng cay."

msgid "67"
msgstr ""
"Nghiệp làm không chánh thiện,\n"
"Làm rồi sanh ăn năn,\n"
"Mặt nhuốm lệ, khóc than,\n"
"Lãnh chịu quả dị thục."

msgid "68"
msgstr ""
"Và nghiệp làm chánh thiện,\n"
"Làm rồi không ăn năn,\n"
"Hoan hỷ, ý đẹp lòng,\n"
"Hưởng thọ quả dị thục."

msgid "69"
msgstr ""
"Người ngu nghĩ là ngọt,\n"
"Khi ác chưa chín muồi;\n"
"Ác nghiệp chín muồi rồi,\n"
"Người ngu chịu khổ đau."

msgid "70"
msgstr ""
"Tháng tháng với ngọn cỏ,\n"
"Người ngu có ăn uống\n"
"Không bằng phần mười sáu\n"
"Người hiểu pháp hữu vi."

msgid "71"
msgstr ""
"Nghiệp ác đã được làm,\n"
"Như sữa, không đông ngay,\n"
"Cháy ngầm theo kẻ ngu,\n"
"Như lửa tro che đậy."

msgid "72"
msgstr ""
"Tự nó chịu bất hạnh,\n"
"Khi danh đến kẻ ngu.\n"
"Vận may bị tổn hại,\n"
"Đầu nó bị nát tan."

msgid "73"
msgstr ""
"Ưa danh không tương xứng,\n"
"Muốn ngồi trước tỷ kheo,\n"
"Ưa quyền tại tịnh xá,\n"
"Muốn mọi người lễ kính."

msgid "74"
msgstr ""
"Mong cả hai tăng, tục,\n"
"Nghĩ rằng: “Chính ta làm,\n"
"Trong mọi việc lớn nhỏ,\n"
"Phải theo mệnh lệnh ta”.\n"
"Người ngu nghĩ như vậy\n"
"Dục và mạn tăng trưởng."

msgid "75"
msgstr ""
"Khác thay duyên thế lợi,\n"
"Khác thay đường Niết Bàn.\n"
"Tỷ kheo, đệ tử Phật,\n"
"Hãy như vậy thắng tri.\n"
"Chớ ưa thích cung kính,\n"
"Hãy tu hạnh viễn ly."

msgid "chap6"
msgstr "Hiền Trí"

msgid "76"
msgstr ""
"Nếu thấy bậc hiền trí,\n"
"Chỉ lỗi và khiển trách,\n"
"Như chỉ chỗ chôn vàng\n"
"Hãy thân cận người trí!\n"
"Thân cận người như vậy,\n"
"Chỉ tốt hơn, không xấu."

msgid "77"
msgstr ""
"Những người hay khuyên dạy,\n"
"Ngăn người khác làm ác,\n"
"Được người hiền kính yêu,\n"
"Bị người ác không thích."

msgid "78"
msgstr ""
"Chớ thân với bạn ác,\n"
"Chớ thân kẻ tiểu nhân.\n"
"Hãy thân người bạn lành,\n"
"Hãy thân bậc thượng nhân."

msgid "79"
msgstr ""
"Pháp hỷ đem an lạc,\n"
"Với tâm tư thuần tịnh;\n"
"Người trí thường hoan hỷ,\n"
"Với pháp bậc Thánh thuyết."

msgid "80"
msgstr ""
"Người trị thủy dẫn nước,\n"
"Kẻ làm tên nắn tên,\n"
"Người thợ mộc uốn gỗ,\n"
"Bậc trí nhiếp tự thân."

msgid "81"
msgstr ""
"Như đá tảng kiên cố,\n"
"Không gió nào dao động,\n"
"Cũng vậy, giữa khen chê,\n"
"Người trí không dao động."

msgid "82"
msgstr ""
"Như hồ nước sâu thẳm,\n"
"Trong sáng, không khuấy đục,\n"
"Cũng vậy, nghe chánh pháp,\n"
"Người trí hưởng tịnh lạc."

msgid "83"
msgstr ""
"Người hiền bỏ tất cả,\n"
"Người lành không bàn dục,\n"
"Dầu cảm thọ lạc khổ,\n"
"Bậc trí không vui buồn."

msgid "84"
msgstr ""
"Không vì mình, vì người,\n"
"Không cầu được con cái,\n"
"Không tài sản quốc độ,\n"
"Không cầu mình thành tựu,\n"
"Với việc làm phi pháp.\n"
"Vị ấy thật trì giới,\n"
"Có trí tuệ, đúng pháp."

msgid "85"
msgstr ""
"Ít người giữa nhân loại,\n"
"Đến được bờ bên kia\n"
"Còn số người còn lại,\n"
"Xuôi ngược chạy bờ này."

msgid "86"
msgstr ""
"Những ai hành trì pháp,\n"
"Theo chánh pháp khéo dạy,\n"
"Sẽ đến bờ bên kia,\n"
"Vượt ma lực khó thoát."

msgid "87"
msgstr ""
"Kẻ trí bỏ pháp đen,\n"
"Tu tập theo pháp trắng.\n"
"Bỏ nhà, sống không nhà,\n"
"Sống viễn ly khổ lạc."

msgid "88"
msgstr ""
"Hãy cầu vui Niết Bàn,\n"
"Bỏ dục, không sở hữu,\n"
"Kẻ trí tự rửa sạch,\n"
"Cấu uế từ nội tâm."

msgid "89"
msgstr ""
"Những ai với chánh tâm,\n"
"Khéo tu tập giác chi,\n"
"Từ bỏ mọi ái nhiễm,\n"
"Hoan hỷ không chấp thủ.\n"
"Không lậu hoặc, sáng chói,\n"
"Sống tịch tịnh ở đời."

msgid "chap7"
msgstr "A-La-Hán"

msgid "90"
msgstr ""
"Đích đã đến, không sầu,\n"
"Giải thoát ngoài tất cả,\n"
"Đoạn trừ mọi buộc ràng,\n"
"Vị ấy không nhiệt não."

msgid "91"
msgstr ""
"Tự sách tấn, chánh niệm,\n"
"Không thích cư xá nào,\n"
"Như ngỗng trời rời ao,\n"
"Bỏ sau mọi trú ẩn."

msgid "92"
msgstr ""
"Tài sản không chất chứa,\n"
"Ăn uống biết liễu tri,\n"
"Tự tại trong hành xứ,\n"
"Không vô tướng, giải thoát,\n"
"Như chim giữa hư không,\n"
"Hướng chúng đi khó tìm."

msgid "93"
msgstr ""
"Ai lậu hoặc đoạn sạch,\n"
"Ăn uống không tham đắm,\n"
"Tự tại trong hành xứ,\n"
"Không, vô tướng giải thoát.\n"
"Như chim giữa hư không,\n"
"Dấu chân thật khó tìm."

msgid "94"
msgstr ""
"Ai nhiếp phục các căn,\n"
"Như đánh xe điều ngự,\n"
"Mạn trừ, lậu hoặc dứt,\n"
"Người vậy, Chư Thiên mến."

msgid "95"
msgstr ""
"Như đất, không hiềm hận,\n"
"Như cột trụ, kiên trì,\n"
"Như hồ, không bùn nhơ,\n"
"Không luân hồi, vị ấy."

msgid "96"
msgstr ""
"Người tâm ý an tịnh,\n"
"Lời an, nghiệp cũng an,\n"
"Chánh trí, chơn giải thoát,\n"
"Tịnh lạc là vị ấy."

msgid "97"
msgstr ""
"Không tin, hiểu vô vi,\n"
"Người cắt mọi hệ lụy,\n"
"Cơ hội tận, xả ly,\n"
"Vị ấy thật tối thượng."

msgid "98"
msgstr ""
"Làng mạc hay rừng núi\n"
"Thung lũng hay đồi cao,\n"
"La Hán trú chỗ nào,\n"
"Đất ấy thật khả ái."

msgid "99"
msgstr ""
"Khả ái thay núi rừng,\n"
"Chỗ người phàm không ưa,\n"
"Vị ly tham ưa thích,\n"
"Vì không tìm dục lạc."

msgid "chap8"
msgstr "Ngàn"

msgid "100"
msgstr ""
"Dầu nói ngàn ngàn lời,\n"
"Nhưng không gì lợi ích,\n"
"Tốt hơn một câu nghĩa,\n"
"Nghe xong, được tịnh lạc."

msgid "101"
msgstr ""
"Dầu nói ngàn câu kệ\n"
"Nhưng không gì lợi ích,\n"
"Tốt hơn nói một câu,\n"
"Nghe xong, được tịnh lạc."

msgid "102"
msgstr ""
"Dầu nói trăm câu kệ\n"
"Nhưng không gì lợi ích,\n"
"Tốt hơn một câu pháp,\n"
"Nghe xong, được tịnh lạc."

msgid "103"
msgstr ""
"Dầu tại bãi chiến trường\n"
"Thắng ngàn ngàn quân địch,\n"
"Tự thắng mình tốt hơn,\n"
"Thật chiến thắng tối thượng."

msgid "104"
msgstr ""
"Tự thắng, tốt đẹp hơn,\n"
"Hơn chiến thắng người khác.\n"
"Người khéo điều phục mình,\n"
"Thường sống tự chế ngự."

msgid "105"
msgstr ""
"Dầu Thiên Thần, Thát Bà,\n"
"Dầu Ma vương, Phạm Thiên\n"
"Không ai chiến thắng nổi,\n"
"Người tự thắng như vậy."

msgid "106"
msgstr ""
"Tháng tháng bỏ ngàn vàng,\n"
"Tế tự cả trăm năm,\n"
"Chẳng bằng trong giây lát,\n"
"Cúng dường bậc tự tu.\n"
"Cúng dường vậy tốt hơn,\n"
"Hơn trăm năm tế tự."

msgid "107"
msgstr ""
"Dầu trải một trăm năm,\n"
"Thờ lửa tại rừng sâu,\n"
"Chẳng bằng trong giây lát,\n"
"Cúng dường bậc tự tu.\n"
"Cúng dường vậy tốt hơn,\n"
"Hơn trăm năm tế tự."

msgid "108"
msgstr ""
"Suốt năm cúng tế vật,\n"
"Để cầu phước ở đời.\n"
"Không bằng một phần tư\n"
"Kính lễ bậc chánh trực."

msgid "109"
msgstr ""
"Thường tôn trọng, kính lễ\n"
"Bậc kỳ lão trưởng thượng,\n"
"Bốn pháp được tăng trưởng:\n"
"Thọ, sắc, lạc, sức mạnh."

msgid "110"
msgstr ""
"Dầu sống một trăm năm\n"
"Ác giới, không thiền định,\n"
"Tốt hơn sống một ngày,\n"
"Trì giới, tu thiền định."

msgid "111"
msgstr ""
"Ai sống một trăm năm,\n"
"Ác tuệ, không thiền định.\n"
"Tốt hơn sống một ngày,\n"
"Có tuệ, tu thiền định."

msgid "112"
msgstr ""
"Ai sống một trăm năm,\n"
"Lười nhác không tinh tấn,\n"
"Tốt hơn sống một ngày\n"
"Tinh tấn tận sức mình."

msgid "113"
msgstr ""
"Ai sống một trăm năm,\n"
"Không thấy pháp sinh diệt,\n"
"Tốt hơn sống một ngày,\n"
"Thấy được pháp sinh diệt."

msgid "114"
msgstr ""
"Ai sống một trăm năm,\n"
"Không thấy câu bất tử,\n"
"Tốt hơn sống một ngày,\n"
"Thấy được câu bất tử."

msgid "115"
msgstr ""
"Ai sống một trăm năm,\n"
"Không thấy pháp tối thượng,\n"
"Tốt hơn sống một ngày,\n"
"Thấy được pháp tối thượng."

msgid "chap9"
msgstr "Ác"

msgid "116"
msgstr ""
"Hãy gấp làm điều lành,\n"
"Ngăn tâm làm điều ác.\n"
"Ai chậm làm việc lành,\n"
"Ý ưa thích việc ác."

msgid "117"
msgstr ""
"Nếu người làm điều ác,\n"
"Chớ tiếp tục làm thêm.\n"
"Chớ ước muốn điều ác,\n"
"Chứa ác, tất chịu khổ."

msgid "118"
msgstr ""
"Nếu người làm điều thiện,\n"
"Nên tiếp tục làm thêm.\n"
"Hãy ước muốn điều thiện,\n"
"Chứa thiện, được an lạc."

msgid "119"
msgstr ""
"Người ác thấy là hiền\n"
"Khi ác chưa chín muồi;\n"
"Khi ác nghiệp chín muồi,\n"
"Người ác mới thấy ác."

msgid "120"
msgstr ""
"Người hiền thấy là ác\n"
"Khi thiện chưa chín muồi.\n"
"Khi thiện được chín muồi,\n"
"Người hiền thấy là thiện."

msgid "121"
msgstr ""
"Chớ chê khinh điều ác,\n"
"Cho rằng: “Chưa đến mình”,\n"
"Như nước nhỏ từng giọt,\n"
"Rồi bình cũng đầy tràn.\n"
"Người ngu chứa đầy ác\n"
"Do chất chứa dần dần."

msgid "122"
msgstr ""
"Chớ chê khinh điều thiện\n"
"Cho rằng: “Chưa đến mình”,\n"
"Như nước nhỏ từng giọt,\n"
"Rồi bình cũng đầy tràn.\n"
"Người trí chứa đầy thiện,\n"
"Do chất chứa dần dần."

msgid "123"
msgstr ""
"Ít bạn đường, nhiều tiền,\n"
"Người buôn tránh đường hiểm.\n"
"Muốn sống, tránh thuốc độc,\n"
"Hãy tránh ác như vậy."

msgid "124"
msgstr ""
"Bàn tay không thương tích,\n"
"Có thể cầm thuốc độc.\n"
"Không thương tích, tránh độc,\n"
"Không làm, không có ác."

msgid "125"
msgstr ""
"Hại người không ác tâm,\n"
"Người thanh tịnh, không uế,\n"
"Tội ác đến kẻ ngu,\n"
"Như ngược gió tung bụi."

msgid "126"
msgstr ""
"Một số sinh bào thai,\n"
"Kẻ ác sinh địa ngục,\n"
"Người thiện lên cõi trời,\n"
"Vô lậu chứng Niết Bàn."

msgid "127"
msgstr ""
"Không trên trời, giữa biển,\n"
"Không lánh vào động núi,\n"
"Không chỗ nào trên đời,\n"
"Trốn được quả ác nghiệp."

msgid "128"
msgstr ""
"Không trên trời, giữa biển,\n"
"Không lánh vào động núi,\n"
"Không chỗ nào trên đời,\n"
"Trốn khỏi tay thần chết."

msgid "chap10"
msgstr "Hình Phạt"

msgid "129"
msgstr ""
"Mọi người sợ hình phạt,\n"
"Mọi người sợ tử vong.\n"
"Lấy mình làm ví dụ\n"
"Không giết, không bảo giết."

msgid "130"
msgstr ""
"Mọi người sợ hình phạt,\n"
"Mọi người thích sống còn;\n"
"Lấy mình làm ví dụ,\n"
"Không giết, không bảo giết."

msgid "131"
msgstr ""
"Chúng sanh cầu an lạc,\n"
"Ai dùng trượng hại người,\n"
"Để tìm lạc cho mình,\n"
"Đời sau không được lạc."

msgid "132"
msgstr ""
"Chúng sanh cầu an lạc,\n"
"Không dùng trượng hại người,\n"
"Để tìm lạc cho mình,\n"
"Đời sau được hưởng lạc."

msgid "133"
msgstr ""
"Chớ nói lời ác độc,\n"
"Nói ác, bị nói lại,\n"
"Khổ thay lời phẩn nộ,\n"
"Đao trượng phản chạm mình."

msgid "134"
msgstr ""
"Nếu tự mình yên lặng,\n"
"Như chiếc chuông bị bể.\n"
"Ngươi đã chứng Niết Bàn\n"
"Ngươi không còn phẩn nộ."

msgid "135"
msgstr ""
"Với gậy người chăn bò,\n"
"Lùa bò ra bãi cỏ;\n"
"Cũng vậy, già và chết,\n"
"Lùa người đến mạng chung."

msgid "136"
msgstr ""
"Người ngu làm điều ác,\n"
"Không ý thức việc làm.\n"
"Do tự nghiệp, người ngu\n"
"Bị nung nấu, như lửa."

msgid "137"
msgstr ""
"Dùng trượng phạt không trượng,\n"
"Làm ác người không ác.\n"
"Trong mười loại khổ đau,\n"
"Chịu gấp một loại khổ."

msgid "138"
msgstr ""
"Hoặc khổ thọ khốc liệt,\n"
"Thân thể bị thương vong,\n"
"Hoặc thọ bệnh kịch liệt,\n"
"Hay loạn ý tán tâm."

msgid "139"
msgstr ""
"Hoặc tai họa từ vua,\n"
"Hay bị vu trọng tội;\n"
"Bà con phải ly tán,\n"
"Tài sản bị nát tan."

msgid "140"
msgstr ""
"Hoặc phòng ốc nhà cửa\n"
"Bị hỏa tai thiêu đốt.\n"
"Khi thân hoại mạng chung,\n"
"Ác tuệ sanh địa ngục."

msgid "141"
msgstr ""
"Không phải sống lõa thể\n"
"Bện tóc, tro trét mình,\n"
"Tuyệt thực, lăn trên đất,\n"
"Sống nhớp, siêng ngồi xổm,\n"
"Làm con người được sạch,\n"
"Nếu không trừ nghi hoặc."

msgid "142"
msgstr ""
"Ai sống tự trang sức,\n"
"Nhưng an tịnh, nhiếp phục,\n"
"Sống kiên trì, phạm hạnh,\n"
"Không hại mọi sinh linh,\n"
"Vị ấy là phạm chí,\n"
"Hay sa môn, khất sĩ."

msgid "143"
msgstr ""
"Thật khó tìm ở đời,\n"
"Người biết thẹn, tự chế,\n"
"Biết tránh né chỉ trích\n"
"Như ngựa hiền tránh roi."

msgid "144"
msgstr ""
"Như ngựa hiền chạm roi,\n"
"Hãy nhiệt tâm, hăng hái,\n"
"Với tín, giới, tinh tấn,\n"
"Thiền định cùng trạch pháp.\n"
"Minh hạnh đủ, chánh niệm,\n"
"Đoạn khổ này vô lượng."

msgid "145"
msgstr ""
"Người trị thủy dẫn nước,\n"
"Kẻ làm tên nắn tên,\n"
"Người thợ mộc uốn ván,\n"
"Bậc tự điều, điều thân."

msgid "chap11"
msgstr "Già"

msgid "146"
msgstr ""
"Cười gì, hân hoan gì,\n"
"Khi đời mãi bị thiêu?\n"
"Bị tối tăm bao trùm,\n"
"Sao không tìm ngọn đèn?"

msgid "147"
msgstr ""
"Hãy xem bong bóng đẹp,\n"
"Chỗ chất chứa vết thương,\n"
"Bệnh hoạn nhiều suy tư,\n"
"Thật không gì trường cửu."

msgid "148"
msgstr ""
"Sắc này bị suy già,\n"
"Ổ tật bệnh, mỏng manh,\n"
"Nhóm bất tịnh, đổ vỡ,\n"
"Chết chấm dứt mạng sống."

msgid "149"
msgstr ""
"Như trái bầu mùa thu,\n"
"Bị vất bỏ quăng đi,\n"
"Nhóm xương trắng bồ câu,\n"
"Thấy chúng còn vui gì?"

msgid "150"
msgstr ""
"Thành này làm bằng xương,\n"
"Quét tô bằng thịt máu,\n"
"Ở đây già và chết,\n"
"Mạn, lừa đảo chất chứa."

msgid "151"
msgstr ""
"Xe vua đẹp cũng già,\n"
"Thân này rồi sẽ già,\n"
"Pháp bậc thiện, không già.\n"
"Như vậy bậc chí thiện\n"
"Nói lên cho bậc thiện."

msgid "152"
msgstr ""
"Người ít nghe kém học,\n"
"Lớn già như trâu đực.\n"
"Thịt nó tuy lớn lên,\n"
"Nhưng tuệ không tăng trưởng."

msgid "153"
msgstr ""
"Lang thang bao kiếp sống\n"
"Ta tìm nhưng chẳng gặp,\n"
"Người xây dựng nhà này,\n"
"Khổ thay, phải tái sanh."

msgid "154"
msgstr ""
"Ôi! Người làm nhà kia,\n"
"Nay ta đã thấy ngươi!\n"
"Ngươi không làm nhà nữa.\n"
"Đòn tay ngươi bị gẫy,\n"
"Kèo cột ngươi bị tan.\n"
"Tâm ta đạt tịch diệt,\n"
"Tham ái thảy tiêu vong."

msgid "155"
msgstr ""
"Lúc trẻ, không phạm hạnh,\n"
"Không tìm kiếm bạc tiền.\n"
"Như cò già bên ao,\n"
"Ủ rũ, không tôm cá."

msgid "156"
msgstr ""
"Lúc trẻ không phạm hạnh,\n"
"Không tìm kiếm bạc tiền;\n"
"Như cây cung bị gẫy,\n"
"Thở than những ngày qua."

msgid "chap12"
msgstr "Tự Ngã"

msgid "157"
msgstr ""
"Nếu biết yêu tự ngã,\n"
"Phải khéo bảo vệ mình,\n"
"Người trí trong ba canh,\n"
"Phải luôn luôn tỉnh thức."

msgid "158"
msgstr ""
"Trước hết tự đặt mình,\n"
"Vào những gì thích đáng.\n"
"Sau mới giáo hóa người,\n"
"Người trí khỏi bị nhiễm."

msgid "159"
msgstr ""
"Hãy tự làm cho mình,\n"
"Như điều mình dạy người.\n"
"Khéo tự điều, điều người,\n"
"Khó thay, tự điều phục!"

msgid "160"
msgstr ""
"Tự mình y chỉ mình,\n"
"Nào có y chỉ khác.\n"
"Nhờ khéo điều phục mình,\n"
"Được y chỉ khó được."

msgid "161"
msgstr ""
"Điều ác tự mình làm,\n"
"Tự mình sanh, mình tạo.\n"
"Nghiền nát kẻ ngu si,\n"
"Như kim cương, ngọc báu."

msgid "162"
msgstr ""
"Phá giới quá trầm trọng,\n"
"Như dây leo bám cây,\n"
"Gieo hại cho tự thân,\n"
"Như kẻ thù mong ước."

msgid "163"
msgstr ""
"Dễ làm các điều ác,\n"
"Dễ làm tự hại mình.\n"
"Còn việc lành, việc tốt,\n"
"Thật tối thượng khó làm."

msgid "164"
msgstr ""
"Kẻ ngu si miệt thị,\n"
"Giáo pháp bậc La Hán,\n"
"Bậc Thánh, bậc chánh mạng.\n"
"Chính do ác kiến này,\n"
"Như quả loại cây lau\n"
"Mang quả tự hoại diệt."

msgid "165"
msgstr ""
"Tự mình làm điều ác,\n"
"Tự mình làm nhiễm ô,\n"
"Tự mình không làm ác,\n"
"Tự mình làm thanh tịnh.\n"
"Tịnh, không tịnh tự mình,\n"
"Không ai thanh tịnh ai!"

msgid "166"
msgstr ""
"Chớ theo pháp hạ liệt.\n"
"Chớ sống mặc, buông lung;\n"
"Chớ tin theo tà kiến,\n"
"Chớ tăng trưởng tục trần."

msgid "chap13"
msgstr "Thế Gian"

msgid "167"
msgstr ""
"Dầu lợi người bao nhiêu,\n"
"Chớ quên phần tư lợi,\n"
"Nhờ thắng trí tư lợi.\n"
"Hãy chuyên tâm lợi mình."

msgid "168"
msgstr ""
"Nỗ lực, chớ phóng dật!\n"
"Hãy sống theo chánh hạnh;\n"
"Người chánh hạnh hưởng lạc,\n"
"Cả đời này, đời sau."

msgid "169"
msgstr ""
"Hãy khéo sống chánh hạnh,\n"
"Chớ sống theo tà hạnh!\n"
"Người chánh hạnh hưởng lạc,\n"
"Cả đời này, đời sau."

msgid "170"
msgstr ""
"Hãy nhìn như bọt nước,\n"
"Hãy nhìn như cảnh huyễn!\n"
"Quán nhìn đời như vậy,\n"
"Thần chết không bắt gặp."

msgid "171"
msgstr ""
"Hãy đến nhìn đời này,\n"
"Như xe vua lộng lẫy,\n"
"Người ngu mới tham đắm,\n"
"Kẻ trí nào đắm say."

msgid "172"
msgstr ""
"Ai sống trước buông lung,\n"
"Sau sống không phóng dật,\n"
"Chói sáng rực đời này.\n"
"Như trăng thoát mây che."

msgid "173"
msgstr ""
"Ai dùng các hạnh lành,\n"
"Làm xóa mờ nghiệp ác,\n"
"Chói sáng rực đời này,\n"
"Như trăng thoát mây che."

msgid "174"
msgstr ""
"Đời này thật mù quáng,\n"
"Ít kẻ thấy rõ ràng.\n"
"Như chim thoát khỏi lưới,\n"
"Rất ít đi thiên giới."

msgid "175"
msgstr ""
"Như chim thiên nga bay,\n"
"Thần thông liệng giữa trời;\n"
"Chiến thắng ma, ma quân,\n"
"Kẻ trí thoát đời này."

msgid "176"
msgstr ""
"Ai vi phạm một pháp,\n"
"Ai nói lời vọng ngữ,\n"
"Ai bác bỏ đời sau,\n"
"Không ác nào không làm."

msgid "177"
msgstr ""
"Keo kiết không sanh thiên,\n"
"Kẻ ngu ghét bố thí,\n"
"Người trí thích bố thí,\n"
"Đời sau, được hưởng lạc."

msgid "178"
msgstr ""
"Hơn thống lãnh cõi đất,\n"
"Hơn được sanh cõi trời,\n"
"Hơn chủ trì vũ trụ,\n"
"Quả Dự Lưu tối thắng."

msgid "chap14"
msgstr "Phật Đà"

msgid "179"
msgstr ""
"Vị chiến thắng không bại,\n"
"Vị bước đi trên đời,\n"
"Không dấu tích chiến thắng,\n"
"Phật giới rộng mênh mông,\n"
"Ai dùng chân theo dõi\n"
"Bậc không để dấu tích?"

msgid "180"
msgstr ""
"Ai giải tỏa lưới tham,\n"
"Ái phược hết dắt dẫn,\n"
"Phật giới rộng mênh mông,\n"
"Ai dùng chân theo dõi,\n"
"Bậc không để dấu tích?"

msgid "181"
msgstr ""
"Người trí chuyên thiền định,\n"
"Thích an tịnh viễn ly,\n"
"Chư thiên đều ái kính,\n"
"Bậc chánh giác, chánh niệm."

msgid "182"
msgstr ""
"Khó thay, được làm người,\n"
"Khó thay, được sống còn,\n"
"Khó thay, nghe diệu pháp,\n"
"Khó thay, Phật ra đời!"

msgid "183"
msgstr ""
"Không làm mọi điều ác.\n"
"Thành tựu các hạnh lành,\n"
"Tâm ý giữ trong sạch,\n"
"Chính lời chư Phật dạy."

msgid "184"
msgstr ""
"Chư Phật thường giảng dạy;\n"
"Nhẫn, khổ hạnh tối thượng,\n"
"Niết bàn, quả tối thượng;\n"
"Xuất gia không phá người;\n"
"Sa môn không hại người."

msgid "185"
msgstr ""
"Không phỉ báng, phá hoại,\n"
"Hộ trì giới căn bản,\n"
"Ăn uống có tiết độ,\n"
"Sàng tọa chỗ nhàn tịnh.\n"
"Chuyên chú tăng thượng tâm,\n"
"Chính lời chư Phật dạy."

msgid "186"
msgstr ""
"Dầu mưa bằng tiền vàng,\n"
"Các dục khó thỏa mãn.\n"
"Dục đắng nhiều ngọt ít,\n"
"Biết vậy là bậc trí."

msgid "187"
msgstr ""
"Đệ tử bậc chánh giác,\n"
"Không tìm cầu dục lạc,\n"
"Dầu là dục chư thiên,\n"
"Chỉ ưa thích ái diệt."

msgid "188"
msgstr ""
"Loài người sợ hoảng hốt,\n"
"Tìm nhiều chỗ quy y,\n"
"Hoặc rừng rậm, núi non,\n"
"Hoặc vườn cây, đền tháp."

msgid "189"
msgstr ""
"Quy y ấy không ổn,\n"
"Không quy y tối thượng.\n"
"Quy y các chỗ ấy,\n"
"Không thoát mọi khổ đau."

msgid "190"
msgstr ""
"Ai quy y Đức Phật,\n"
"Chánh pháp và chư tăng,\n"
"Ai dùng chánh tri kiến,\n"
"Thấy được bốn Thánh đế."

msgid "191"
msgstr ""
"Thấy khổ và khổ tập,\n"
"Thấy sự khổ vượt qua,\n"
"Thấy đường Thánh tám ngành,\n"
"Đưa đến khổ não tận."

msgid "192"
msgstr ""
"Thật quy y an ổn,\n"
"Thật quy y tối thượng,\n"
"Có quy y như vậy,\n"
"Mới thoát mọi khổ đau."

msgid "193"
msgstr ""
"Khó gặp bậc thánh nhơn,\n"
"Không phải đâu cũng có.\n"
"Chỗ nào bậc trí sanh,\n"
"Gia đình tất an lạc."

msgid "194"
msgstr ""
"Vui thay, Phật ra đời!\n"
"Vui thay, Pháp được giảng!\n"
"Vui thay, Tăng hòa hợp!\n"
"Hòa hợp tu, vui thay!"

msgid "195"
msgstr ""
"Cúng dường bậc đáng cúng,\n"
"Chư Phật hoặc đệ tử,\n"
"Các bậc vượt hý luận,\n"
"Đoạn diệt mọi sầu bi."

msgid "196"
msgstr ""
"Cúng dường bậc như vậy,\n"
"Tịch tịnh, không sợ hãi,\n"
"Các công đức như vậy,\n"
"Không ai ước lường được."

msgid "chap15"
msgstr "An Lạc"

msgid "197"
msgstr ""
"Vui thay, chúng ta sống,\n"
"Không hận, giữa hận thù!\n"
"Giữa những người thù hận,\n"
"Ta sống, không hận thù!"

msgid "198"
msgstr ""
"Vui thay, chúng ta sống,\n"
"Không bệnh, giữa ốm đau!\n"
"Giữa những người bệnh hoạn,\n"
"Ta sống, không ốm đau."

msgid "199"
msgstr ""
"Vui thay, chúng ta sống,\n"
"Không rộn giữa rộn ràng;\n"
"Giữa những người rộn ràng,\n"
"Ta sống, không rộn ràng."

msgid "200"
msgstr ""
"Vui thay chúng ta sống,\n"
"Không gì, gọi của ta.\n"
"Ta sẽ hưởng hỷ lạc,\n"
"Như chư thiên Quang Âm."

msgid "201"
msgstr ""
"Chiến thắng sinh thù oán,\n"
"Thất bại chịu khổ đau,\n"
"Sống tịch tịnh an lạc,\n"
"Bỏ sau mọi thắng bại."

msgid "202"
msgstr ""
"Lửa nào sánh lửa tham?\n"
"Ác nào bằng sân hận?\n"
"Khổ nào sánh khổ uẩn,\n"
"Lạc nào bằng tịnh lạc."

msgid "203"
msgstr ""
"Đói ăn, bệnh tối thượng,\n"
"Các hành, khổ tối thượng,\n"
"Hiểu như thực là vậy,\n"
"Niết Bàn, lạc tối thượng."

msgid "204"
msgstr ""
"Không bệnh, lợi tối thượng,\n"
"Biết đủ, tiền tối thượng,\n"
"Thành tín đối với nhau,\n"
"Là bà con tối thượng.\n"
"Niết Bàn, lạc tối thượng."

msgid "205"
msgstr ""
"Đã nếm vị độc cư,\n"
"Được hưởng vị nhàn tịnh,\n"
"Không sợ hãi, không ác,\n"
"Nếm được vị pháp hỷ."

msgid "206"
msgstr ""
"Lành thay, thấy Thánh nhân,\n"
"Sống chung thường hưởng lạc.\n"
"Không thấy những người ngu,\n"
"Thường thường được an lạc."

msgid "207"
msgstr ""
"Sống chung với người ngu,\n"
"Lâu dài bị lo buồn.\n"
"Khổ thay gần người ngu,\n"
"Như thường sống kẻ thù.\n"
"Vui thay, gần người trí,\n"
"Như chung sống bà con."

msgid "208"
msgstr ""
"Bậc hiền sĩ, trí tuệ,\n"
"Bậc nghe nhiều, trì giới,\n"
"Bậc tự chế, Thánh nhân;\n"
"Hãy gần gũi, thân cận\n"
"Thiện nhân, trí giả ấy,\n"
"Như trăng theo đường sao."

msgid "chap16"
msgstr "Hỷ Ái"

msgid "209"
msgstr ""
"Tự chuyên, không đáng chuyên,\n"
"Không chuyên, việc đáng chuyên.\n"
"Bỏ đích, theo hỷ ái,\n"
"Ganh tị bậc tự chuyên."

msgid "210"
msgstr ""
"Chớ gần gũi người yêu,\n"
"Trọn đời xa kẻ ghét.\n"
"Yêu không gặp là khổ,\n"
"Oán phải gặp cũng đau."

msgid "211"
msgstr ""
"Do vậy chớ yêu ai,\n"
"Ái biệt ly là ác;\n"
"Những ai không yêu ghét,\n"
"Không thể có buộc ràng."

msgid "212"
msgstr ""
"Do ái sinh sầu ưu,\n"
"Do ái sinh sợ hãi,\n"
"Ai thoát khỏi tham ái,\n"
"Không sầu, đâu sợ hãi?"

msgid "213"
msgstr ""
"Ái luyến sinh sầu ưu,\n"
"Ái luyến sinh sợ hãi.\n"
"Ai giải thoát ái luyến,\n"
"Không sầu, đâu sợ hãi?"

msgid "214"
msgstr ""
"Hỷ ái sinh sầu ưu,\n"
"Hỷ ái sinh sợ hãi.\n"
"Ai giải thoát hỷ ái,\n"
"Không sầu, đâu sợ hãi?"

msgid "215"
msgstr ""
"Dục ái sinh sầu ưu,\n"
"Dục ái sinh sợ hãi,\n"
"Ai thoát khỏi dục ái,\n"
"Không sầu, đâu sợ hãi?"

msgid "216"
msgstr ""
"Tham ái sinh sầu ưu,\n"
"Tham ái sinh sợ hãi.\n"
"Ai thoát khỏi tham ái,\n"
"Không sầu, đâu sợ hãi."

msgid "217"
msgstr ""
"Đủ giới đức, chánh kiến;\n"
"Trú pháp, chứng chân lý,\n"
"Tự làm công việc mình,\n"
"Được quần chúng ái kính."

msgid "218"
msgstr ""
"Ước vọng pháp ly ngôn,\n"
"Ý cảm xúc thượng quả,\n"
"Tâm thoát ly ác dục,\n"
"Xứng gọi bậc Thượng Lưu."

msgid "219"
msgstr ""
"Khách lâu ngày ly hương,\n"
"An toàn từ xa về,\n"
"Bà con cùng thân hữu,\n"
"Hân hoan đón chào mừng."

msgid "220"
msgstr ""
"Cũng vậy các phước nghiệp,\n"
"Đón chào người làm lành,\n"
"Đời này đến đời kia,\n"
"Như thân nhân đón chào."

msgid "chap17"
msgstr "Phẫn Nộ"

msgid "221"
msgstr ""
"Bỏ phẫn nộ, ly mạn,\n"
"Vượt qua mọi kiết sử,\n"
"Không chấp trước danh sắc,\n"
"Khổ không theo vô sản."

msgid "222"
msgstr ""
"Ai chận được phẫn nộ,\n"
"Như dừng xe đang lăn,\n"
"Ta gọi người đánh xe,\n"
"Kẻ khác cầm cương hờ."

msgid "223"
msgstr ""
"Lấy không giận thắng giận,\n"
"Lấy thiện thắng không thiện,\n"
"Lấy thí thắng xan tham,\n"
"Lấy chơn thắng hư ngụy."

msgid "224"
msgstr ""
"Nói thật, không phẫn nộ,\n"
"Của ít, thí người xin,\n"
"Nhờ ba việc lành này,\n"
"Người đến gần thiên giới."

msgid "225"
msgstr ""
"Bậc hiền không hại ai,\n"
"Thân thường được chế ngự,\n"
"Đạt được cảnh bất tử,\n"
"Đến đây, không ưu sầu."

msgid "226"
msgstr ""
"Những người thường giác tỉnh,\n"
"Ngày đêm siêng tu học,\n"
"Chuyên tâm hướng Niết Bàn,\n"
"Mọi lậu hoặc được tiêu."

msgid "227"
msgstr ""
"A-tu-la, nên biết,\n"
"Xưa vậy, nay cũng vậy:\n"
"Ngồi im bị người chê,\n"
"Nói nhiều bị người chê,\n"
"Nói vừa phải bị chê.\n"
"Làm người không bị chê,\n"
"Thật khó tìm ở đời."

msgid "228"
msgstr ""
"Xưa, vị lai và nay,\n"
"Đâu có sự kiện này:\n"
"Người hoàn toàn bị chê,\n"
"Người trọn vẹn được khen."

msgid "229"
msgstr ""
"Sáng sáng, thẩm xét kỹ,\n"
"Bậc có trí tán thán,\n"
"Bậc trí không tỳ vết,\n"
"Đầy đủ giới định tuệ."

msgid "230"
msgstr ""
"Hạnh sáng như vàng ròng,\n"
"Ai dám chê vị ấy?\n"
"Chư thiên phải khen thưởng,\n"
"Phạm Thiên cũng tán dương."

msgid "231"
msgstr ""
"Giữ thân đừng phẫn nộ,\n"
"Phòng thân khéo bảo vệ,\n"
"Từ bỏ thân làm ác,\n"
"Với thân làm hạnh lành."

msgid "232"
msgstr ""
"Giữ lời đừng phẫn nộ,\n"
"Phòng lời khéo bảo vệ,\n"
"Từ bỏ lời thô ác,\n"
"Với lời nói điều lành."

msgid "233"
msgstr ""
"Giữ ý đừng phẫn nộ,\n"
"Phòng ý khéo bảo vệ,\n"
"Từ bỏ ý nghĩ ác,\n"
"Với ý nghĩ hạnh lành."

msgid "234"
msgstr ""
"Bậc trí bảo vệ thân,\n"
"Bảo vệ luôn lời nói,\n"
"Bảo vệ cả tâm tư,\n"
"Ba nghiệp khéo bảo vệ."

msgid "chap18"
msgstr "Cấu Uế"

msgid "235"
msgstr ""
"Ngươi nay giống lá héo,\n"
"Diêm sứ đang chờ ngươi,\n"
"Ngươi đứng trước cửa chết,\n"
"Đường trường thiếu tư lương."

msgid "236"
msgstr ""
"Hãy tự làm hòn đảo,\n"
"Tinh cần gấp, sáng suốt.\n"
"Trừ cấu uế, thanh tịnh,\n"
"Đến Thánh địa chư Thiên."

msgid "237"
msgstr ""
"Đời ngươi nay sắp tàn,\n"
"Tiến gần đến Diêm Vương.\n"
"Giữa đường không nơi nghỉ,\n"
"Đường trường thiếu tư lương."

msgid "238"
msgstr ""
"Hãy tự làm hòn đảo,\n"
"Tinh cần gấp sáng suốt.\n"
"Trừ cấu uế, thanh tịnh,\n"
"Chẳng trở lại sanh già."

msgid "239"
msgstr ""
"Bậc trí theo tuần tự,\n"
"Từng sát na trừ dần,\n"
"Như thợ vàng lọc bụi,\n"
"Trừ cấu uế nơi mình."

msgid "240"
msgstr ""
"Như sét từ sắt sanh,\n"
"Sắt sanh lại ăn sắt,\n"
"Cũng vậy, quá lợi dưỡng,\n"
"Tự nghiệp dẫn cõi ác."

msgid "241"
msgstr ""
"Không tụng làm nhớp kinh,\n"
"Không đứng dậy bẩn nhà,\n"
"Biếng nhác làm nhơ sắc,\n"
"Phóng dật uế người canh."

msgid "242"
msgstr ""
"Tà hạnh nhơ đàn bà,\n"
"Xan tham nhớp kẻ thí,\n"
"Ác pháp là vết nhơ,\n"
"Đời này và đời sau."

msgid "243"
msgstr ""
"Trong hàng cấu uế ấy,\n"
"Vô minh nhơ tối thượng,\n"
"Đoạn nhơ ấy, Tỷ kheo,\n"
"Thành bậc không uế nhiễm."

msgid "244"
msgstr ""
"Dễ thay, sống không hổ,\n"
"Sống lỗ mãng như quạ,\n"
"Sống công kích huênh hoang,\n"
"Sống liều lĩnh, nhiễm ô."

msgid "245"
msgstr ""
"Khó thay, sống xấu hổ,\n"
"Thường thường cầu thanh tịnh.\n"
"Sống vô tư, khiêm tốn,\n"
"Trong sạch và sáng suốt."

msgid "246"
msgstr ""
"Ai ở đời sát sinh,\n"
"Nói láo không chân thật,\n"
"Ở đời lấy không cho,\n"
"Qua lại với vợ người."

msgid "247"
msgstr ""
"Uống rượu men, rượu nấu,\n"
"Người sống đam mê vậy,\n"
"Chính ngay tại đời này,\n"
"Tự đào bới gốc mình."

msgid "248"
msgstr ""
"Vậy người hãy nên biết,\n"
"Không chế ngự là ác.\n"
"Chớ để tham phi pháp,\n"
"Làm người đau khổ dài."

msgid "249"
msgstr ""
"Do tín tâm, hỷ tâm\n"
"Loài người mới bố thí.\n"
"Ở đây ai bất mãn\n"
"Người khác được ăn uống,\n"
"Người ấy ngày hoặc đêm,\n"
"Không đạt được tâm định?"

msgid "250"
msgstr ""
"Ai cắt được, phá được,\n"
"Tận gốc nhổ tâm ấy.\n"
"Người ấy ngày hoặc đêm,\n"
"Đạt được tâm thiền định."

msgid "251"
msgstr ""
"Lửa nào bằng lửa tham!\n"
"Chấp nào bằng sân hận!\n"
"Lưới nào bằng lưới si!\n"
"Sông nào bằng sông ái!"

msgid "252"
msgstr ""
"Dễ thay thấy lỗi người,\n"
"Lỗi mình thấy mới khó.\n"
"Lỗi người ta phanh tìm,\n"
"Như sàng trấu trong gạo,\n"
"Còn lỗi mình che đậy,\n"
"Như kẻ gian giấu bài."

msgid "253"
msgstr ""
"Ai thấy lỗi của người,\n"
"Thường sanh lòng chỉ trích,\n"
"Người ấy lậu hoặc tăng,\n"
"Rất xa lậu hoặc diệt."

msgid "254"
msgstr ""
"Hư không không dấu chân,\n"
"Ngoài đây không Sa môn,\n"
"Chúng sanh thích hý luận,\n"
"Như Lai hý luận trừ."

msgid "255"
msgstr ""
"Hư không không dấu chân,\n"
"Ngoài đây không Sa môn.\n"
"Các hành không thường trú,\n"
"Chư Phật không dao động."

msgid "chap19"
msgstr "Pháp Trụ"

msgid "256"
msgstr ""
"Ngươi đâu phải pháp trụ,\n"
"Xử sự quá chuyên chế,\n"
"Bậc trí cần phân biệt\n"
"Cả hai chánh và tà!"

msgid "257"
msgstr ""
"Không chuyên chế, đúng pháp,\n"
"Công bằng dắt dẫn người,\n"
"Bậc trí sống đúng pháp,\n"
"Thật xứng danh pháp trụ."

msgid "258"
msgstr ""
"Không phải vì nói nhiều,\n"
"Mới xứng danh bậc trí.\n"
"An ổn, không oán sợ,\n"
"Thật đáng gọi bậc trí."

msgid "259"
msgstr ""
"Không phải vì nói nhiều,\n"
"Mới xứng danh trì pháp,\n"
"Những ai tuy nghe ít,\n"
"Nhưng thân hành đúng pháp,\n"
"Không phóng túng chánh pháp,\n"
"Mới xứng danh trì pháp."

msgid "260"
msgstr ""
"Không phải là trưởng lão,\n"
"Dầu cho có bạc đầu.\n"
"Người chỉ tuổi tác cao,\n"
"Được gọi là: “Lão ngu”."

msgid "261"
msgstr ""
"Ai chân thật, đúng pháp,\n"
"Không hại, biết chế phục,\n"
"Bậc trí không cấu uế,\n"
"Mới xứng danh Trưởng Lão."

msgid "262"
msgstr ""
"Không phải nói lưu loát,\n"
"Không phải sắc mặt đẹp,\n"
"Thành được người lương thiện,\n"
"Nếu ganh, tham, dối trá."

msgid "263"
msgstr ""
"Ai cắt được, phá được,\n"
"Tận gốc nhổ tâm ấy,\n"
"Người trí ấy diệt sân,\n"
"Được gọi người hiền thiện."

msgid "264"
msgstr ""
"Đầu trọc không Sa môn,\n"
"Nếu phóng túng, nói láo.\n"
"Ai còn đầy dục tham,\n"
"Sao được gọi Sa môn?"

msgid "265"
msgstr ""
"Ai lắng dịu hoàn toàn,\n"
"Các điều ác lớn nhỏ,\n"
"Vì lắng dịu ác pháp,\n"
"Được gọi là Sa môn."

msgid "266"
msgstr ""
"Chỉ khất thực nhờ người,\n"
"Đâu phải là Tỷ kheo!\n"
"Phải theo pháp toàn diện,\n"
"Khất sĩ không chưa đủ."

msgid "267"
msgstr ""
"Ai vượt qua thiện ác,\n"
"Chuyên sống đời phạm hạnh,\n"
"Sống thẩm sát ở đời,\n"
"Mới xứng danh Tỷ kheo."

msgid "268"
msgstr ""
"Im lặng nhưng ngu si,\n"
"Đâu được gọi ẩn sĩ?\n"
"Như người cầm cán cân,\n"
"Bậc trí chọn điều lành."

msgid "269"
msgstr ""
"Từ bỏ các ác pháp,\n"
"Mới thật là ẩn sĩ.\n"
"Ai thật hiểu hai đời\n"
"Mới được gọi ẩn sĩ."

msgid "270"
msgstr ""
"Còn sát hại sinh linh,\n"
"Đâu được gọi Hiền thánh.\n"
"Không hại mọi hữu tình,\n"
"Mới được gọi Hiền Thánh."

msgid "271"
msgstr ""
"Chẳng phải chỉ giới cấm,\n"
"Cũng không phải học nhiều,\n"
"Chẳng phải chứng thiền định,\n"
"Sống thanh vắng một mình."

msgid "272"
msgstr ""
"Ta hưởng an ổn lạc,\n"
"Phàm phu chưa hưởng được.\n"
"Tỷ kheo chớ tự tin\n"
"Khi lậu hoặc chưa diệt."

msgid "chap20"
msgstr "Đạo"

msgid "273"
msgstr ""
"Tám chánh, đường thù thắng,\n"
"Bốn câu, lý thù thắng.\n"
"Ly tham, pháp thù thắng,\n"
"Giữa các loài hai chân,\n"
"Pháp nhãn, người thù thắng."

msgid "274"
msgstr ""
"Đường này không đường khác,\n"
"Đưa đến kiến thanh tịnh.\n"
"Nếu ngươi theo đường này,\n"
"Ma quân sẽ mê loạn."

msgid "275"
msgstr ""
"Nếu người theo đường này,\n"
"Đau khổ được đoạn tận.\n"
"Ta dạy người con đường,\n"
"Với trí, gai chướng diệt."

msgid "276"
msgstr ""
"Người hãy nhiệt tình làm,\n"
"Như Lai chỉ thuyết dạy.\n"
"Người hành trì thiền định,\n"
"Thoát trói buộc Ác ma."

msgid "277"
msgstr ""
"“Tất cả hành vô thường”,\n"
"Với Tuệ quán thấy vậy,\n"
"Đau khổ được nhàm chán;\n"
"Chính con đường thanh tịnh."

msgid "278"
msgstr ""
"“Tất cả hành khổ đau”,\n"
"Với Tuệ quán thấy vậy,\n"
"Đau khổ được nhàm chán;\n"
"Chính con đường thanh tịnh."

msgid "279"
msgstr ""
"“Tất cả pháp vô ngã”,\n"
"Với Tuệ quán thấy vậy,\n"
"Đau khổ được nhàm chán;\n"
"Chính con đường thanh tịnh."

msgid "280"
msgstr ""
"Khi cần không nỗ lực,\n"
"Tuy trẻ mạnh nhưng lười,\n"
"Chí nhu nhược, biếng nhác.\n"
"Với trí tuệ thụ động,\n"
"Sao tìm được chánh đạo?"

msgid "281"
msgstr ""
"Lời nói được thận trọng,\n"
"Tâm tư khéo hộ phòng,\n"
"Thân chớ làm điều ác,\n"
"Hãy giữ ba nghiệp tịnh,\n"
"Chứng đạo Thánh nhân dạy."

msgid "282"
msgstr ""
"Tu thiền trí tuệ sanh,\n"
"Bỏ thiền trí tuệ diệt.\n"
"Biết con đường hai ngả\n"
"Đưa đến hữu, phi hữu,\n"
"Hãy tự mình nỗ lực,\n"
"Khiến trí tuệ tăng trưởng."

msgid "283"
msgstr ""
"Đốn rừng không đốn cây,\n"
"Từ rừng sinh sợ hãi;\n"
"Đốn rừng và ái dục,\n"
"Tỷ kheo hãy tịch tịnh."

msgid "284"
msgstr ""
"Khi nào chưa cắt tiệt\n"
"Ái dục giữa gái trai,\n"
"Tâm ý vẫn buộc ràng,\n"
"Như bò con vú mẹ."

msgid "285"
msgstr ""
"Tự cắt dây ái dục,\n"
"Như tay bẻ sen thu,\n"
"Hãy tu đạo tịch tịnh,\n"
"Niết Bàn Thiện Thệ dạy."

msgid "286"
msgstr ""
"Mùa mưa ta ở đây,\n"
"Đông hạ cũng ở đây.\n"
"Người ngu tâm tưởng vậy,\n"
"Không tự giác hiểm nguy."

msgid "287"
msgstr ""
"Người tâm ý đắm say\n"
"Con cái và súc vật,\n"
"Tử thần bắt người ấy,\n"
"Như lụt trôi làng ngủ."

msgid "288"
msgstr ""
"Một khi tử thần đến,\n"
"Không có con che chở,\n"
"Không cha không bà con,\n"
"Không thân thích che chở."

msgid "289"
msgstr ""
"Biết rõ ý nghĩa này,\n"
"Bậc trí lo trì giới,\n"
"Mau lẹ làm thanh tịnh\n"
"Con đường đến Niết Bàn."

msgid "chap21"
msgstr "Tạp Lục"

msgid "290"
msgstr ""
"Nhờ từ bỏ lạc nhỏ,\n"
"Thấy được lạc lớn hơn,\n"
"Bậc trí bỏ lạc nhỏ,\n"
"Thấy được lạc lớn hơn."

msgid "291"
msgstr ""
"Gieo khổ đau cho người,\n"
"Mong cầu lạc cho mình,\n"
"Bị hận thù buộc ràng\n"
"Không sao thoát hận thù."

msgid "292"
msgstr ""
"Việc đáng làm, không làm,\n"
"Không đáng làm, lại làm,\n"
"Người ngạo mạn, phóng dật,\n"
"Lậu hoặc ắt tăng trưởng."

msgid "293"
msgstr ""
"Người siêng năng cần mẫn,\n"
"Thường thường quán thân niệm,\n"
"Không làm việc không đáng,\n"
"Gắng làm việc đáng làm,\n"
"Người tư niệm giác tỉnh,\n"
"Lậu hoặc được tiêu trừ."

msgid "294"
msgstr ""
"Sau khi giết mẹ cha,\n"
"Giết hai Vua Sát lỵ,\n"
"Giết vương quốc, quần thần\n"
"Vô ưu, Phạm chí sống."

msgid "295"
msgstr ""
"Sau khi giết mẹ cha,\n"
"Hai vua Bà-la-môn,\n"
"Giết hổ tướng thứ năm\n"
"Vô ưu, Phạm chí sống."

msgid "296"
msgstr ""
"Đệ tử Gotama,\n"
"Luôn luôn tự tỉnh giác\n"
"Vô luận ngày hay đêm,\n"
"Tưởng Phật Đà thường niệm."

msgid "297"
msgstr ""
"Đệ tử Gotama,\n"
"Luôn luôn tự tỉnh giác,\n"
"Vô luận ngày hay đêm,\n"
"Tưởng Chánh Pháp thường niệm."

msgid "298"
msgstr ""
"Đệ tử Gotama,\n"
"Luôn luôn tự tỉnh giác,\n"
"Vô luận ngày hay đêm,\n"
"Tưởng Tăng Già thường niệm."

msgid "299"
msgstr ""
"Đệ tử Gotama,\n"
"Luôn luôn tự tỉnh giác,\n"
"Vô luận ngày hay đêm,\n"
"Tưởng sắc thân thường niệm."

msgid "300"
msgstr ""
"Đệ tử Gotama,\n"
"Luôn luôn tự tỉnh giác,\n"
"Vô luận ngày hay đêm,\n"
"Ý vui niềm bất hại."

msgid "301"
msgstr ""
"Đệ tử Gotama,\n"
"Luôn luôn tự tỉnh giác,\n"
"Vô luận ngày hay đêm,\n"
"Ý vui tu thiền quán."

msgid "302"
msgstr ""
"Vui hạnh xuất gia khó,\n"
"Tại gia sinh hoạt khó,\n"
"Sống bạn không đồng, khổ,\n"
"Trôi lăn luân hồi, khổ,\n"
"Vậy chớ sống luân hồi,\n"
"Chớ chạy theo đau khổ."

msgid "303"
msgstr ""
"Tín tâm, sống giới hạnh\n"
"Đủ danh xưng tài sản,\n"
"Chỗ nào người ấy đến,\n"
"Chỗ ấy được cung kính."

msgid "304"
msgstr ""
"Người lành dầu ở xa\n"
"Sáng tỏ như núi tuyết,\n"
"Người ác dầu ở gần\n"
"Như tên bắn đêm đen."

msgid "305"
msgstr ""
"Ai ngồi nằm một mình,\n"
"Độc hành không buồn chán,\n"
"Tự điều phục một mình\n"
"Sống thoải mái rừng sâu."

msgid "chap22"
msgstr "Địa Ngục"

msgid "306"
msgstr ""
"Nói láo đọa địa ngục\n"
"Có làm nói không làm,\n"
"Cả hai chết đồng đẳng,\n"
"Làm người, nghiệp hạ liệt."

msgid "307"
msgstr ""
"Nhiều người khoác cà sa,\n"
"Ác hạnh không nhiếp phục.\n"
"Người ác, do ác hạnh,\n"
"Phải sanh cõi Địa ngục."

msgid "308"
msgstr ""
"Tốt hơn nuốt hòn sắt\n"
"Cháy đỏ như lửa hừng,\n"
"Hơn ác giới, buông lung\n"
"Ăn đồ ăn quốc độ."

msgid "309"
msgstr ""
"Bốn nạn chờ đợi người,\n"
"Phóng dật theo vợ người;\n"
"Mắc họa, ngủ không yên,\n"
"Bị chê là thứ ba,\n"
"Đọa địa ngục, thứ bốn."

msgid "310"
msgstr ""
"Mắc họa, đọa ác thú,\n"
"Bị hoảng sợ, ít vui,\n"
"Quốc vương phạt trọng hình.\n"
"Vậy chớ theo vợ người."

msgid "311"
msgstr ""
"Như cỏ sa vụng nắm,\n"
"Tất bị họa đứt tay\n"
"Hạnh Sa môn tà vạy,\n"
"Tất bị đọa địa ngục."

msgid "312"
msgstr ""
"Sống phóng đãng buông lung,\n"
"Theo giới cấm ô nhiễm,\n"
"Sống Phạm hạnh đáng nghi\n"
"Sao chứng được quả lớn?"

msgid "313"
msgstr ""
"Cần phải làm, nên làm\n"
"Làm cùng tận khả năng\n"
"Xuất gia sống phóng đãng,\n"
"Chỉ tăng loạn bụi đời."

msgid "314"
msgstr ""
"Ác hạnh không nên làm,\n"
"Làm xong, chịu khổ lụy,\n"
"Thiện hạnh, ắt nên làm,\n"
"Làm xong, không ăn năn."

msgid "315"
msgstr ""
"Như thành ở biên thùy,\n"
"Trong ngoài đều phòng hộ\n"
"Cũng vậy, phòng hộ mình,\n"
"Sát na chớ buông lung.\n"
"Giây phút qua, sầu muộn\n"
"Khi rơi vào địa ngục."

msgid "316"
msgstr ""
"Không đáng hổ, lại hổ.\n"
"Việc đáng hổ, lại không.\n"
"Do chấp nhận tà kiến,\n"
"Chúng sanh đi ác thú."

msgid "317"
msgstr ""
"Không đáng sợ, lại sợ,\n"
"Đáng sợ, lại thấy không,\n"
"Do chấp nhận tà kiến.\n"
"Chúng sanh đi ác thú."

msgid "318"
msgstr ""
"Không lỗi, lại thấy lỗi,\n"
"Có lỗi, lại thấy không,\n"
"Do chấp nhận tà kiến,\n"
"Chúng sanh đi ác thú."

msgid "319"
msgstr ""
"Có lỗi, biết có lỗi,\n"
"Không lỗi, biết là không,\n"
"Do chấp nhận chánh kiến,\n"
"Chúng sanh đi cõi lành."

msgid "chap23"
msgstr "Voi"

msgid "320"
msgstr ""
"Ta như voi giữa trận,\n"
"Hứng chịu cung tên rơi,\n"
"Chịu đựng mọi phỉ báng.\n"
"Ác giới rất nhiều người."

msgid "321"
msgstr ""
"Voi luyện, đưa dự hội,\n"
"Ngựa luyện, được vua cưỡi,\n"
"Người luyện, bậc tối thượng\n"
"Chịu đựng mọi phỉ báng."

msgid "322"
msgstr ""
"Tốt thay, con la thuần,\n"
"Thuần chủng loài ngựa Sin.\n"
"Đại tượng, voi có ngà.\n"
"Tự điều mới tối thượng."

msgid "323"
msgstr ""
"Chẳng phải loài cưỡi ấy,\n"
"Đưa người đến Niết-Bàn,\n"
"Chỉ có người tự điều,\n"
"Đến đích, nhờ điều phục."

msgid "324"
msgstr ""
"Con voi tên Tài Hộ,\n"
"Phát dục, khó điều phục,\n"
"Trói buộc, không ăn uống.\n"
"Voi nhớ đến rừng voi."

msgid "325"
msgstr ""
"Người ưa ngủ, ăn lớn\n"
"Nằm lăn lóc qua lại,\n"
"Chẳng khác heo no bụng,\n"
"Kẻ ngu nhập thai mãi."

msgid "326"
msgstr ""
"Trước tâm này buông lung,\n"
"Chạy theo ái, dục, lạc.\n"
"Nay Ta chánh chế ngự,\n"
"Như cầm móc điều voi."

msgid "327"
msgstr ""
"Hãy vui không phóng dật,\n"
"Khéo phòng hộ tâm ý.\n"
"Kéo mình khỏi ác đạo,\n"
"Như voi bị sa lầy."

msgid "328"
msgstr ""
"Nếu được bạn hiền trí\n"
"Đáng sống chung, hạnh lành,\n"
"Nhiếp phục mọi hiểm nguy\n"
"Hoan hỷ sống chánh niệm."

msgid "329"
msgstr ""
"Không gặp bạn hiền trí,\n"
"Đáng sống chung, hạnh lành\n"
"Như vua bỏ nước bại,\n"
"Hãy sống riêng cô độc,\n"
"Như voi sống rừng voi."

msgid "330"
msgstr ""
"Tốt hơn sống một mình,\n"
"Không kết bạn người ngu.\n"
"Độc thân, không ác hạnh\n"
"Sống vô tư vô lự,\n"
"Như voi sống rừng voi."

msgid "331"
msgstr ""
"Vui thay, bạn lúc cần!\n"
"Vui thay, sống biết đủ,\n"
"Vui thay, chết có đức!\n"
"Vui thay, mọi khổ đoạn."

msgid "332"
msgstr ""
"Vui thay, hiếu kính mẹ,\n"
"Vui thay, hiếu kính cha,\n"
"Vui thay, kính Sa môn,\n"
"Vui thay, kính Hiền Thánh."

msgid "333"
msgstr ""
"Vui thay, già có giới!\n"
"Vui thay, tín an trú!\n"
"Vui thay, được trí tuệ,\n"
"Vui thay, ác không làm."

msgid "chap24"
msgstr "Tham Ái"

msgid "334"
msgstr ""
"Người sống đời phóng dật,\n"
"Ái tăng như giây leo.\n"
"Nhảy đời này đời khác,\n"
"Như vượn tham quả rừng."

msgid "335"
msgstr ""
"Ai sống trong đời này,\n"
"Bị ái dục buộc ràng\n"
"Sầu khổ sẽ tăng trưởng,\n"
"Như cỏ Bi gặp mưa."

msgid "336"
msgstr ""
"Ai sống trong đời này\n"
"Ái dục được hàng phục\n"
"Sầu rơi khỏi người ấy\n"
"Như giọt nước lá sen."

msgid "337"
msgstr ""
"Đây điều lành Ta dạy,\n"
"Các người tụ họp đây.\n"
"Hãy nhổ tận gốc ái\n"
"Như nhổ gốc cỏ Bi.\n"
"Chớ để ma phá hoại,\n"
"Như giòng nước cỏ lau."

msgid "338"
msgstr ""
"Như cây bị chặt đốn,\n"
"Gốc chưa hại vẫn bền\n"
"Ái tùy miên chưa nhổ,\n"
"Khổ này vẫn sanh hoài."

msgid "339"
msgstr ""
"Ba mươi sáu dòng Ái,\n"
"Trôi người đốn khả ái.\n"
"Các tư tưởng tham ái\n"
"Cuốn trôi người tà kiến."

msgid "340"
msgstr ""
"Dòng ái dục chảy khắp,\n"
"Như giây leo mọc tràn,\n"
"Thấy giây leo vừa sanh,\n"
"Với tuệ, hãy đoạn gốc."

msgid "341"
msgstr ""
"Người đời nhớ ái dục,\n"
"Ưa thích các hỷ lạc.\n"
"Tuy mong cầu an lạc,\n"
"Họ vẫn phải sanh già."

msgid "342"
msgstr ""
"Người bị ái buộc ràng,\n"
"Vùng vẫy và hoảng sợ,\n"
"Như thỏ bị sa lưới.\n"
"Họ sanh ái trói buộc,\n"
"Chịu khổ đau dài dài."

msgid "343"
msgstr ""
"Người bị ái buộc ràng,\n"
"Vùng vẫy và hoảng sợ,\n"
"Như thỏ bị sa lưới.\n"
"Do vậy vị tỷ kheo,\n"
"Mong cầu mình ly tham\n"
"Nên nhiếp phục ái dục."

msgid "344"
msgstr ""
"Lìa rừng lại hướng rừng\n"
"Thoát rừng chạy theo rừng.\n"
"Nên xem người như vậy,\n"
"Được thoát khỏi buộc ràng,\n"
"Lại chạy theo ràng buộc."

msgid "345"
msgstr ""
"Sắt, cây, gai trói buộc\n"
"Người trí xem chưa bền.\n"
"Tham châu báu, trang sức\n"
"Tham vọng vợ và con."

msgid "346"
msgstr ""
"Người có trí nói rằng:\n"
"“Trói buộc này thật bền.\n"
"Rì kéo xuống, lún xuống,\n"
"Nhưng thật sự khó thoát”.\n"
"Người trí cắt trừ nó,\n"
"Bỏ dục lạc, không màng."

msgid "347"
msgstr ""
"Người đắm say ái dục\n"
"Tự lao mình xuống dòng\n"
"Như nhện sa lưới dệt.\n"
"Người trí cắt trừ nó,\n"
"Bỏ mọi khổ, không màng."

msgid "348"
msgstr ""
"Bỏ quá, hiện, vị lai,\n"
"Đến bờ kia cuộc đời,\n"
"Ý giải thoát tất cả,\n"
"Chớ vướng lại sanh già."

msgid "349"
msgstr ""
"Người tà ý nhiếp phục,\n"
"Tham sắc bén nhìn tịnh,\n"
"Người ấy ái tăng trưởng,\n"
"Làm giây trói mình chặt."

msgid "350"
msgstr ""
"Ai vui, an tịnh ý,\n"
"Quán bất tịnh, thường niệm,\n"
"Người ấy sẽ diệt ái,\n"
"Cắt đứt Ma trói buộc."

msgid "351"
msgstr ""
"Ai tới đích, không sợ,\n"
"Ly ái, không nhiễm ô\n"
"Nhổ mũi tên sanh tử,\n"
"Thân này thân cuối cùng."

msgid "352"
msgstr ""
"Ái lìa, không chấp thủ.\n"
"Cú pháp khéo biện tài\n"
"Thấu suốt từ vô ngại,\n"
"Hiểu thứ lớp trước sau.\n"
"Thân này thân cuối cùng\n"
"Vị như vậy được gọi:\n"
"Bậc Đại trí, đại nhân."

msgid "353"
msgstr ""
"Ta hàng phục tất cả,\n"
"Ta rõ biết tất cả,\n"
"Không bị nhiễm pháp nào.\n"
"Ta từ bỏ tất cả\n"
"Ái diệt, tự giải thoát.\n"
"Đã tự mình thắng trí,\n"
"Ta gọi ai thầy ta?"

msgid "354"
msgstr ""
"Pháp thí, thắng mọi thí!\n"
"Pháp vị, thắng mọi vị!\n"
"Pháp hỷ, thắng mọi hỷ!\n"
"Ái diệt, dứt mọi khổ!"

msgid "355"
msgstr ""
"Tài sản hại người ngu.\n"
"Không người tìm bờ kia\n"
"Kẻ ngu vì tham giàu,\n"
"Hại mình và hại người."

msgid "356"
msgstr ""
"Cỏ làm hại ruộng vườn,\n"
"Tham làm hại người đời.\n"
"Bố thí người ly tham,\n"
"Do vậy được quả lớn."

msgid "357"
msgstr ""
"Cỏ làm hại ruộng vườn,\n"
"Sân làm hại người đời.\n"
"Bố thí người ly sân,\n"
"Do vậy được quả lớn."

msgid "358"
msgstr ""
"Cỏ làm hại ruộng vườn,\n"
"Si làm hại người đời,\n"
"Bố thí người ly si,\n"
"Do vậy được quả lớn."

msgid "359"
msgstr ""
"Cỏ làm hại ruộng vườn,\n"
"Dục làm hại người đời.\n"
"Bố thí người ly dục,\n"
"Do vậy được quả lớn."

msgid "chap25"
msgstr "Tỷ Kheo"

msgid "360"
msgstr ""
"Lành thay, phòng hộ mắt!\n"
"Lành thay, phòng hộ tai.\n"
"Lành thay, phòng hộ mũi,\n"
"Lành thay, phòng hộ lưỡi."

msgid "361"
msgstr ""
"Lành thay, phòng hộ thân!\n"
"Lành thay, phòng hộ lời,\n"
"Lành thay, phòng hộ ý.\n"
"Lành thay, phòng tất cả.\n"
"Tỷ kheo phòng tất cả,\n"
"Thoát được mọi khổ đau."

msgid "362"
msgstr ""
"Người chế ngự tay chân,\n"
"Chế ngự lời và đầu,\n"
"Vui thích nội thiền định.\n"
"Độc thân, biết vừa đủ,\n"
"Thật xứng gọi tỷ kheo."

msgid "363"
msgstr ""
"Tỷ kheo chế ngự miệng,\n"
"Vừa lời, không cống cao,\n"
"Khi trình bày pháp nghĩa,\n"
"Lời lẽ dịu ngọt ngào."

msgid "364"
msgstr ""
"Vị tỷ kheo thích pháp,\n"
"Mến pháp, suy tư Pháp.\n"
"Tâm tư niệm chánh Pháp,\n"
"Không rời bỏ chánh Pháp."

msgid "365"
msgstr ""
"Không khinh điều mình được,\n"
"Không ganh người khác được\n"
"Tỷ kheo ganh tị người,\n"
"Không sao chứng Thiền Định."

msgid "366"
msgstr ""
"Tỷ kheo dầu được ít,\n"
"Không khinh điều mình được,\n"
"Sống thanh tịnh không nhác,\n"
"Chư thiên khen vị này."

msgid "367"
msgstr ""
"Hoàn toàn đối danh sắc,\n"
"Không chấp Ta, của Ta.\n"
"Không chấp, không sầu não,\n"
"Thật xứng danh Tỷ kheo."

msgid "368"
msgstr ""
"Tỷ kheo trú từ bi,\n"
"Tín thành giáo Pháp Phật,\n"
"Chứng cảnh giới tịch tĩnh,\n"
"Các hạnh an tịnh lạc."

msgid "369"
msgstr ""
"Tỷ kheo, tát thuyền này,\n"
"Thuyền không, nhẹ đi mau.\n"
"Trừ tham, diệt sân hận,\n"
"Tất chứng đạt Niết-Bàn."

msgid "370"
msgstr ""
"Đoạn năm, từ bỏ năm\n"
"Tụ tập năm tối thượng\n"
"Tỷ kheo vượt năm ái\n"
"Xứng danh “Vượt bộc lưu”."

msgid "371"
msgstr ""
"Tỷ kheo, hãy tu thiền,\n"
"Chớ buông lung phóng dật,\n"
"Tâm chớ đắm say dục,\n"
"Phóng dật, nuốt sắt nóng,\n"
"Bị đốt, chớ than khổ!"

msgid "372"
msgstr ""
"Không trí tuệ, không thiền,\n"
"Không thiền, không trí tuệ.\n"
"Người có thiền có tuệ,\n"
"Nhất định gần Niết-Bàn."

msgid "373"
msgstr ""
"Bước vào ngôi nhà trống,\n"
"Tỷ kheo tâm an tịnh,\n"
"Thọ hưởng vui siêu nhân\n"
"Tịnh quán theo chánh pháp."

msgid "374"
msgstr ""
"Người luôn luôn chánh niệm,\n"
"Sự sanh diệt các uẩn,\n"
"Được hoan hỷ, hân hoan,\n"
"Chỉ bậc bất tử biết."

msgid "375"
msgstr ""
"Đây Tỷ kheo có trí,\n"
"Tụ tập pháp căn bản:\n"
"Hộ căn, biết vừa đủ,\n"
"Giữ gìn căn bản giới,\n"
"Thường gần gũi bạn lành,\n"
"Sống thanh tịnh tinh cần."

msgid "376"
msgstr ""
"Giao thiệp khéo thân thiện,\n"
"Cử chỉ mực đoan trang.\n"
"Do vậy hưởng vui nhiều,\n"
"Sẽ dứt mọi khổ đau."

msgid "377"
msgstr ""
"Như hoa Vassikà,\n"
"Quăng bỏ cánh úa tàn,\n"
"Cũng vậy vị Tỷ kheo,\n"
"Hãy giải thoát tham sân."

msgid "378"
msgstr ""
"Thân tịnh, lời an tịnh,\n"
"An tịnh, khéo thiền tịnh.\n"
"Tỷ kheo bỏ thế vật,\n"
"Xứng danh “bậc tịch tịnh”."

msgid "379"
msgstr ""
"Tự mình chỉ trích mình,\n"
"Tự mình dò xét mình,\n"
"Tỷ kheo tự phòng hộ\n"
"Chánh niệm, trú an lạc."

msgid "380"
msgstr ""
"Tự mình y chỉ mình,\n"
"Tự mình đi đến mình,\n"
"Vậy hãy tự điều phục,\n"
"Như khách buôn ngựa hiền."

msgid "381"
msgstr ""
"Tỷ kheo nhiều hân hoan,\n"
"Tịnh tín giáo pháp Phật,\n"
"Chứng cảnh giới tịch tịnh,\n"
"Các hạnh an tịnh lạc."

msgid "382"
msgstr ""
"Tỷ kheo tuy tuổi nhỏ\n"
"Siêng tu giáo pháp Phật,\n"
"Soi sáng thế gian này,\n"
"Như trăng thoát khỏi mây."

msgid "chap26"
msgstr "Bà-La-Môn"

msgid "383"
msgstr ""
"Hỡi này Bà-la-môn,\n"
"Hãy tinh tấn đoạn dòng,\n"
"Từ bỏ các dục lạc,\n"
"Biết được hành đoạn diệt,\n"
"Người là bậc vô vi."

msgid "384"
msgstr ""
"Nhờ thường trú hai pháp\n"
"Đến được bờ bên kia.\n"
"Bà-la-môn có trí,\n"
"Mọi kiết sử dứt sạch."

msgid "385"
msgstr ""
"Không bờ này, bờ kia\n"
"Cả hai bờ không có,\n"
"Lìa khổ, không trói buộc\n"
"Ta gọi Bà-la-môn."

msgid "386"
msgstr ""
"Tu thiền, trú ly trần\n"
"Phận sự xong, vô lậu,\n"
"Đạt được đích tối thượng,\n"
"Ta gọi Bà-la-môn."

msgid "387"
msgstr ""
"Mặt trời sáng ban ngày,\n"
"Mặt trăng sáng ban đêm.\n"
"Khí giới sáng Sát-lỵ,\n"
"Thiền định sáng Phạm chí.\n"
"Còn hào quang đức Phật,\n"
"Chói sáng cả ngày đêm."

msgid "388"
msgstr ""
"Dứt ác gọi Phạm chí,\n"
"Tịnh hạnh gọi Sa môn,\n"
"Tự mình xuất cấu uế,\n"
"Nên gọi bậc xuất gia."

msgid "389"
msgstr ""
"Chớ có đập Phạm chí!\n"
"Phạm chí chớ đập lại!\n"
"Xấu thay đập Phạm chí\n"
"Đập trả lại xấu hơn!"

msgid "390"
msgstr ""
"Đối vị Bà-la-môn,\n"
"Đây không lợi ích nhỏ.\n"
"Khi ý không ái luyến,\n"
"Tâm hại được chận đứng,\n"
"Chỉ khi ấy khổ diệt."

msgid "391"
msgstr ""
"Với người thân miệng ý,\n"
"Không làm các ác hạnh\n"
"Ba nghiệp được phòng hộ,\n"
"Ta gọi Bà-la-môn."

msgid "392"
msgstr ""
"Từ ai, biết chánh pháp\n"
"Bậc Chánh Giác thuyết giảng,\n"
"Hãy kính lễ vị ấy,\n"
"Như phạm chí chờ lửa."

msgid "393"
msgstr ""
"Được gọi Bà-la-môn,\n"
"Không vì đầu bện tóc,\n"
"Không chủng tộc, thọ sanh,\n"
"Ai thật chân, chánh, tịnh,\n"
"Mới gọi Bà-la-môn."

msgid "394"
msgstr ""
"Kẻ ngu, có ích gì\n"
"Bện tóc với da dê,\n"
"Nội tâm toàn phiền não,\n"
"Ngoài mặt đánh bóng suông."

msgid "395"
msgstr ""
"Người mặc áo đống rác,\n"
"Gầy ốm, lộ mạch gân,\n"
"Độc thân thiền trong rừng.\n"
"Ta gọi Bà-la-môn."

msgid "396"
msgstr ""
"Ta không gọi Phạm Chí,\n"
"Vì chỗ sanh, mẹ sanh.\n"
"Chỉ được gọi tên suông\n"
"Nếu tâm còn phiền não.\n"
"Không phiền não, chấp trước\n"
"Ta gọi Bà-la-môn."

msgid "397"
msgstr ""
"Đoạn hết các kiết sử,\n"
"Không còn gì lo sợ,\n"
"Không đắm trước buộc ràng\n"
"Ta gọi Bà-la-môn."

msgid "398"
msgstr ""
"Bỏ đai da, bỏ cương\n"
"Bỏ dây, đồ sở thuộc,\n"
"Bỏ then chốt, sáng suốt,\n"
"Ta gọi Bà-la-môn."

msgid "399"
msgstr ""
"Không ác ý, nhẫn chịu,\n"
"Phỉ báng, đánh, phạt hình,\n"
"Lấy nhẫn làm quân lực,\n"
"Ta gọi Bà-la-môn."

msgid "400"
msgstr ""
"Không hận, hết bổn phận,\n"
"Trì giới, không tham ái,\n"
"Nhiếp phục, thân cuối cùng,\n"
"Ta gọi Bà-la-môn."

msgid "401"
msgstr ""
"Như nước trên lá sen,\n"
"Như hột cải đầu kim,\n"
"Người không nhiễm ái dục,\n"
"Ta gọi Bà-la-môn."

msgid "402"
msgstr ""
"Ai tự trên đời này,\n"
"Giác khổ, diệt trừ khổ,\n"
"Bỏ gánh nặng, giải thoát,\n"
"Ta gọi Bà-la-môn."

msgid "403"
msgstr ""
"Người trí tuệ sâu xa,\n"
"Khéo biết đạo, phi đạo,\n"
"Chứng đạt đích vô thượng,\n"
"Ta gọi Bà-la-môn."

msgid "404"
msgstr ""
"Không liên hệ cả hai,\n"
"Xuất gia và thế tục,\n"
"Sống độc thân, ít dục,\n"
"Ta gọi Bà-la-môn."

msgid "405"
msgstr ""
"Bỏ trượng, đối chúng sanh,\n"
"Yếu kém hay kiên cường,\n"
"Không giết, không bảo giết,\n"
"Ta gọi Bà-la-môn."

msgid "406"
msgstr ""
"Thân thiện giữa thù địch,\n"
"Ôn hòa giữa hung hăng.\n"
"Không nhiễm giữa nhiễm trước,\n"
"Ta gọi Bà-la-môn."

msgid "407"
msgstr ""
"Người bỏ rơi tham sân,\n"
"Không mạn, không ganh tị,\n"
"Như hột cải đầu kim,\n"
"Ta gọi Bà-la-môn."

msgid "408"
msgstr ""
"Nói lên lời ôn hòa,\n"
"Lợi ích và chân thật,\n"
"Không mất lòng một ai,\n"
"Ta gọi Bà-la-môn."

msgid "409"
msgstr ""
"Ở đời, vật dài, ngắn,\n"
"Nhỏ, lớn, đẹp hay xấu\n"
"Phàm không cho không lấy,\n"
"Ta gọi Bà-la-môn."

msgid "410"
msgstr ""
"Người không có hy cầu,\n"
"Đời này và đời sau,\n"
"Không hy cầu, giải thoát,\n"
"Ta gọi Bà-la-môn."

msgid "411"
msgstr ""
"Người không còn tham ái,\n"
"Có trí, không nghi hoặc,\n"
"Thể nhập vào bất tử,\n"
"Ta gọi Bà-la-môn."

msgid "412"
msgstr ""
"Người sống ở đời này\n"
"Không nhiễm cả thiện ác,\n"
"Không sầu, sạch không bụi\n"
"Ta gọi Bà-la-môn."

msgid "413"
msgstr ""
"Như trăng, sạch không uế\n"
"Sáng trong và tịnh lặng,\n"
"Hữu ái được đoạn tận,\n"
"Ta gọi Bà-la-môn."

msgid "414"
msgstr ""
"Vượt đường nguy hiểm này,\n"
"Nhiếp phục luân hồi, si,\n"
"Đến bờ kia thiền định,\n"
"Không dục ái, không nghi,\n"
"Không chấp trước, tịch tịnh,\n"
"Ta gọi Bà-la-môn."

msgid "415"
msgstr ""
"Ai ở đời đoạn dục,\n"
"Bỏ nhà, sống xuất gia,\n"
"Dục hữu được đoạn tận,\n"
"Ta gọi Bà-la-môn."

msgid "416"
msgstr ""
"Ai ở đời đoạn ái\n"
"Bỏ nhà, sống xuất gia,\n"
"Ái hữu được đoạn tận,\n"
"Ta gọi Bà-la-môn."

msgid "417"
msgstr ""
"Bỏ trói buộc loài người,\n"
"Vượt trói buộc cõi trời.\n"
"Giải thoát mọi buộc ràng,\n"
"Ta gọi Bà-la-môn."

msgid "418"
msgstr ""
"Bỏ điều ưa, điều ghét,\n"
"Mát lạnh, diệt sanh y,\n"
"Bậc anh hùng chiến thắng,\n"
"Nhiếp phục mọi thế giới,\n"
"Ta gọi Bà-la-môn."

msgid "419"
msgstr ""
"Ai hiểu rõ hoàn toàn\n"
"Sanh tử các chúng sanh,\n"
"Không nhiễm, khéo vượt qua,\n"
"Sáng suốt chân giác ngộ,\n"
"Ta gọi Bà-la-môn."

msgid "420"
msgstr ""
"Với ai, loài trời, người\n"
"Cùng với Càn-thát-bà,\n"
"Không biết chỗ thọ sanh\n"
"Lậu tận bậc La-hán.\n"
"Ta gọi Bà-la-môn."

msgid "421"
msgstr ""
"Ai quá, hiện, vị lai\n"
"Không một sở hữu gì,\n"
"Không sở hữu không nắm,\n"
"Ta gọi Bà-la-môn."

msgid "422"
msgstr ""
"Bậc trâu chúa, thù thắng,\n"
"Bậc anh hùng, đại sĩ,\n"
"Bậc chiến thắng, không nhiễm,\n"
"Bậc tẩy sạch, giác ngộ,\n"
"Ta gọi Bà-la-môn."

msgid "423"
msgstr ""
"Ai biết được đời trước,\n"
"Thấy thiên giới, đọa xứ,\n"
"Đạt được sanh diệt tận\n"
"Thắng trí, tự viên thành\n"
"Bậc mâu-ni đạo sĩ.\n"
"Viên mãn mọi thành tựu\n"
"Ta gọi Bà-la-môn."
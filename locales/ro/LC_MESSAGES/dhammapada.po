msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "title"
msgstr "Dhammapada"

msgid "chaps"
msgstr "Capitole"

msgid "fontsize"
msgstr "Mărime font"

msgid "chap1"
msgstr "Perechile"

msgid "1"
msgstr ""
"Toate stările care iau ființă\n"
"sunt determinate\n"
"de inimă.\n"
"Inima e cea care îndrumă pe cale.\n"
"Exact cum roata carului\n"
"urmează amprenta copitei\n"
"animalului care-l trage,\n"
"așa suferința va urma\n"
"cu siguranță\n"
"când vorbim sau acționăm impulsiv\n"
"dintr-o inimă impură."

msgid "2"
msgstr ""
"Toate stările care iau ființă\n"
"sunt determinate\n"
"de inimă.\n"
"Inima e cea care îndrumă pe cale.\n"
"La fel de sigur cum umbra noastră\n"
"nu ne părăsește niciodată,\n"
"așa bunăstarea va urma\n"
"când vorbim sau acționăm\n"
"cu o inimă pură."

msgid "3"
msgstr ""
"Când ne ținem strâns\n"
"de asemenea gânduri precum:\n"
"„M-au abuzat,\n"
"m-au maltratat,\n"
"m-au brutalizat,\n"
"m-au jefuit”,\n"
"păstrăm ura vie."

msgid "4"
msgstr ""
"Dacă ne eliberăm complet\n"
"de gânduri precum:\n"
"„M-au abuzat,\n"
"m-au maltratat,\n"
"m-au brutalizat,\n"
"m-au jefuit”,\n"
"ura e cucerită."

msgid "5"
msgstr ""
"Niciodată ura nu e prin ură cucerită,\n"
"ci doar prin disponibilitatea de a iubi.\n"
"Aceasta e lege eternă."

msgid "6"
msgstr ""
"Cei ce sunt litigioși\n"
"au uitat\n"
"că murim cu toții. Pentru cei înțelepți,\n"
"ce reflectă asupra acestui fapt,\n"
"nu există cârcoteli."

msgid "7"
msgstr ""
"La fel cum rafala unei furtuni\n"
"poate dezrădăcina\n"
"un copac firav,\n"
"așa cel care se ține,\n"
"fără băgare de seamă, de plăcere,\n"
"cel care se răsfață cu mâncare\n"
"și e nepăsător,\n"
"poate fi dezrădăcinat de Mara."

msgid "8"
msgstr ""
"La fel cum rafala unei furtuni\n"
"nu poate urni un munte de piatră,\n"
"așa cel care contemplă\n"
"realitatea corpului,\n"
"care dezvoltă credință și energie,\n"
"e nemișcat de Mara."

msgid "9"
msgstr ""
"Purtarea robei unuia care a renunțat,\n"
"în sine, nu-l face pe ins pur.\n"
"Acei care o poartă,\n"
"dar le lipsește încă sârguința,\n"
"sunt lipsiți de băgare de seamă."

msgid "10"
msgstr ""
"Fiind posedat de autocontrol,\n"
"onest și sârguincios în conduită,\n"
"un ins e astfel demn\n"
"de roba unuia care a renunțat."

msgid "11"
msgstr ""
"Încurcând falsul cu realul\n"
"și realul cu falsul,\n"
"insul suferă de o viață\n"
"a falsității."

msgid "12"
msgstr ""
"Dar văzând\n"
"falsul ca fals\n"
"și realul ca real,\n"
"insul trăiește\n"
"în perfectul real."

msgid "13"
msgstr ""
"Asemeni ploii infiltrându-se\n"
"printr-un acoperiș prost împăiat,\n"
"pasiunile nesupuse se preling\n"
"într-o inimă neîmblânzită."

msgid "14"
msgstr ""
"Cum ploaia nu poate penetra\n"
"un acoperiș bine împăiat,\n"
"așa pasiunile nu pot intra\n"
"într-o inimă bine instruită."

msgid "15"
msgstr ""
"Când vedem clar\n"
"propria noastră lipsă de virtute,\n"
"suntem umpluți cu mâhnire;\n"
"de acum înainte ne mâhnim."

msgid "16"
msgstr ""
"Când apreciem complet beneficiul\n"
"propriilor noastre fapte pure,\n"
"suntem plini de bucurie;\n"
"de acum înainte,\n"
"are loc o celebrare a bucuriei."

msgid "17"
msgstr ""
"De acum înainte,\n"
"cei care înfăptuiesc răul\n"
"își creează propria suferință.\n"
"Preocuparea mentală\n"
"cu gândul „Am făcut rău”\n"
"le posedă mintea\n"
"și cad în haos."

msgid "18"
msgstr ""
"De acum înainte,\n"
"cei care își trăiesc viața bine\n"
"își duc veacul în fericire.\n"
"Ei sunt plini\n"
"de o apreciere naturală a virtuții\n"
"și trăiesc cu încântare."

msgid "19"
msgstr ""
"Cu toate că insul poate cunoaște\n"
"multe despre Dhamma,\n"
"dacă insul nu trăiește propice –\n"
"asemeni unui văcar\n"
"ce râvnește vitele altuia –\n"
"insul nu va afla\n"
"niciunul din beneficiile\n"
"de a umbla Calea."

msgid "20"
msgstr ""
"Cunoscând doar puțin\n"
"despre Dhamma,\n"
"dar conformându-se cu toată inima,\n"
"transformând pasiunile\n"
"lăcomiei, urii și decepției,\n"
"eliberând toate atașamentele\n"
"de acum și de apoi,\n"
"insul cu siguranță va afla singur\n"
"beneficiile de a umbla Calea."

msgid "chap2"
msgstr "Conștiință"

msgid "21"
msgstr ""
"Băgarea de seamă duce la Nemurire;\n"
"nebăgarea de seamă duce la moarte.\n"
"Cei care sunt cu băgare de seamă\n"
"sunt vii pe deplin,\n"
"cât timp cei lipsiți de băgare de seamă\n"
"sunt deja ca morți."

msgid "22"
msgstr ""
"Înțelepții, fiind vii pe deplin,\n"
"sărbătoresc luciditatea\n"
"și își duc veacul delectându-se\n"
"în această abilitate."

msgid "23"
msgstr ""
"Cei Treziți, fermi în hotărârea lor,\n"
"se exercită viguros\n"
"și discern libertatea\n"
"din toate limitările:\n"
"eliberare, siguranță adevărată."

msgid "24"
msgstr ""
"Cei care sunt energic\n"
"angajați Căii,\n"
"care sunt puri și grijulii în efort,\n"
"stăpâni pe sine\n"
"și virtuoși în conduită,\n"
"cresc constant în radianță."

msgid "25"
msgstr ""
"Prin sârguință, vigilență,\n"
"abținere și autocontrol,\n"
"fie ca înțelepții să-și facă insule pentru ei înșiși\n"
"pe care niciun potop nu le poate învălui."

msgid "26"
msgstr ""
"Cei care sunt ignoranți și confuzi\n"
"se demască nebăgării de seamă.\n"
"Cei înțelepți prețuiesc conștiința\n"
"pe care au cultivat-o\n"
"ca lucrul lor cel mai de preț."

msgid "27"
msgstr ""
"„Nu te pierde în neglijență,\n"
"nu te pierde în senzualitate.”\n"
"Luând aminte un astfel de sfat,\n"
"cel care contemplă descoperă\n"
"profunda eliberare."

msgid "28"
msgstr ""
"Cei Treziți,\n"
"care au gustat libertatea\n"
"față de toate distragerile\n"
"cultivând conștiința,\n"
"îi văd pe toți cei suferinzi\n"
"din perspectiva compasiunii,\n"
"precum cineva pe vârful muntelui\n"
"e capabil să vadă câmpiile."

msgid "29"
msgstr ""
"Conștienți printre cei fără băgare de seamă,\n"
"treji printre cei care dorm,\n"
"cei înțelepți merg înainte\n"
"precum caii tineri puternici,\n"
"lăsându-i în urmă pe cei epuizați."

msgid "30"
msgstr ""
"Pe calea conștiinței sârguincioase\n"
"zeul Magha și-a câștigat împărăția.\n"
"Sârguința e mereu recompensată,\n"
"neglijența e mereu batjocorită."

msgid "31"
msgstr ""
"Cel care renunță și se delectează\n"
"în vigilență,\n"
"ferindu-se de nebăgare de seamă,\n"
"avansează asemeni focului prin iarbă,\n"
"consumând obstrucții mari și mici."

msgid "32"
msgstr ""
"Cel care renunță și se delectează\n"
"în vigilență\n"
"e protejat de regresie:\n"
"un ins se apropie de eliberare."

msgid "chap3"
msgstr "Mintea"

msgid "33"
msgstr ""
"La fel cum un făurar\n"
"dă forma unei săgeți,\n"
"așa cei înțelepți își cultivă mintea,\n"
"atât de excitabilă, incertă\n"
"și dificil de controlat."

msgid "34"
msgstr ""
"Asemeni unui pește care,\n"
"fiind târât din casa-i în apă\n"
"și aruncat pe teren uscat,\n"
"se va zbate,\n"
"astfel inima va tremura\n"
"când se retrage din curentul Marei."

msgid "35"
msgstr ""
"Mintea activă e dificil de domesticit,\n"
"zburdalnică și hoinărind oriunde vrea;\n"
"domesticirea ei e esențială,\n"
"călăuzind la bucuria bunăstării."

msgid "36"
msgstr ""
"Mintea protejată și păzită\n"
"duce la trai ușor.\n"
"Cu toate că mintea aceasta e subtilă,\n"
"evazivă și dificil de văzut,\n"
"insul care e atent\n"
"trebuie să se îngrijească\n"
"și să vegheze asupra ei."

msgid "37"
msgstr ""
"Hoinărind de capul ei de colo-colo,\n"
"fără formă,\n"
"mintea se așterne\n"
"în caverna inimii din interior.\n"
"Să pui stăpânire pe ea\n"
"e eliberare din înlănțuirea ignoranței."

msgid "38"
msgstr ""
"În acela a cărui minte e nestatornică,\n"
"a cărui inimă e nepregătită\n"
"cu învățături adevărate,\n"
"a cărui credință nu e matură,\n"
"plenitudinea înțelepciunii încă nu se manifestă."

msgid "39"
msgstr ""
"Nu există frică\n"
"dacă inima e necontaminată\n"
"de pasiuni\n"
"și mintea e liberă de voință bolnavă.\n"
"Văzând dincolo de bine și rău,\n"
"acela e treaz."

msgid "40"
msgstr ""
"Văzând acest corp fragil\n"
"ca un vas de lut\n"
"și fortificând inima precum zidurile unui oraș,\n"
"insul o poate confrunta pe Mara\n"
"cu arma introspecției.\n"
"Având avantajul detașării,\n"
"insul protejează ce a fost deja dobândit."

msgid "41"
msgstr ""
"Cu siguranță acest corp\n"
"curând va sta fără viață,\n"
"aruncat\n"
"încolo pe sol,\n"
"vidat de conștiință\n"
"și la fel de inutil\n"
"precum un butuc ars."

msgid "42"
msgstr ""
"Mai mult decât un hoț,\n"
"mai mult decât un inamic,\n"
"o inimă îndrumată greșit\n"
"îl duce pe ins la necaz."

msgid "43"
msgstr ""
"Nici mama, nici tata,\n"
"niciun alt membru al unei familii\n"
"nu îți poate oferi binecuvântările\n"
"generate de propria inimă bine îndrumată."

msgid "chap4"
msgstr "Flori"

msgid "44"
msgstr ""
"Cine sunt\n"
"cei care pot să vadă sincer,\n"
"așa cum sunt,\n"
"acest pământ, acest corp,\n"
"tărâmurile iadului și tărâmurile paradisului?\n"
"Cine poate discerne\n"
"bine predicata Cale a Înțelepciunii,\n"
"la fel cum ochiul unui florar iscusit\n"
"poate alege flori perfecte?"

msgid "45"
msgstr ""
"Sunt ei,\n"
"cei care umblă conștient pe Cale,\n"
"care văd cum sunt cu adevărat\n"
"acest pământ, acest corp,\n"
"tărâmurile iadului și tărâmurile paradisului.\n"
"Ei sunt aceia care pot discerne\n"
"bine predicata Cale a Înțelepciunii."

msgid "46"
msgstr ""
"Cunoaște corpul\n"
"ka fiind trecător ca spuma,\n"
"un miraj.\n"
"Floarea pasiunii senzuale\n"
"are un spin ascuns.\n"
"Vezi asta și treci dincolo de moarte."

msgid "47"
msgstr ""
"Așa cum o inundație din senin\n"
"poate mătura din cale un sat care doarme,\n"
"așa moartea îi poate distruge\n"
"pe cei care caută doar florile\n"
"plăcerilor senzuale banale."

msgid "48"
msgstr ""
"A viețui cu frustrare și nemulțumire,\n"
"dar totuși a căuta doar florile\n"
"plăcerilor senzuale banale,\n"
"îl duce pe ins sub stăpânirea distrugătorului."

msgid "49"
msgstr ""
"Precum o albină care,\n"
"adunând nectar,\n"
"nu rănește sau perturbă\n"
"culoarea și parfumul florii,\n"
"astfel și cei înțelepți\n"
"se mișcă prin lume."

msgid "50"
msgstr ""
"Nu poposi asupra defectelor\n"
"și neajunsurilor altora;\n"
"în schimb, caută claritate\n"
"în privința alor tale."

msgid "51"
msgstr ""
"Precum o floare frumoasă,\n"
"lipsită de mireasmă, dezamăgește,\n"
"așa sunt și cuvintele înțelepte\n"
"fără fapte drepte."

msgid "52"
msgstr ""
"Precum o floare frumoasă,\n"
"cu o mireasmă îmbietoare, încântă,\n"
"așa e și vorbitul înțelept și dulce\n"
"când e însoțit de fapte drepte."

msgid "53"
msgstr ""
"Așa cum multe ghirlande pot fi făcute\n"
"dintr-o adunătură de flori,\n"
"la fel multe iscusituri pot fi făcute\n"
"pe durata acestei vieți omenești."

msgid "54"
msgstr ""
"Mireasma florilor sau a lemnului de santal\n"
"bate doar în direcția vântului predominant,\n"
"dar mireasma virtuții\n"
"străbate toate direcțiile."

msgid "55"
msgstr ""
"Mireasma virtuții\n"
"de departe-ntrece\n"
"mireasma florilor\n"
"sau a lemnului de santal."

msgid "56"
msgstr ""
"Aroma lemnului de santal\n"
"și mirosul florilor\n"
"aduc doar puțină bucurie\n"
"în comparație cu mireasma virtuții,\n"
"care inundă chiar și tărâmurile cerești."

msgid "57"
msgstr ""
"Nu e posibil ca Mara să-i găsească\n"
"pe cei care-și duc veacul în luciditate,\n"
"care prin cunoaștere perfectă sunt eliberați\n"
"și trăiesc în virtute."

msgid "58"
msgstr ""
"La fel cum un lotus frumos și dulce mirositor\n"
"poate crește dintr-o grămadă\n"
"de gunoi aruncat,"

msgid "59"
msgstr ""
"strălucirea unui adevărat\n"
"discipol al lui Buddha\n"
"întrece umbrele întunecate\n"
"aruncate de ignoranță."

msgid "chap5"
msgstr "Cei Necopți"

msgid "60"
msgstr ""
"Noaptea e lungă\n"
"pentru insul care nu poate dormi.\n"
"O călătorie e lungă pentru insul obosit.\n"
"Existența ignorantă e lungă și searbădă\n"
"pentru cei inconștienți de Adevăr."

msgid "61"
msgstr ""
"Neavând niciun companion\n"
"care să fi călătorit\n"
"cel puțin așa de departe ca și noi,\n"
"e mai bine a merge singur\n"
"decât să-i întovărășești\n"
"pe cei care rămân nehotărâți."

msgid "62"
msgstr ""
"„Acesta e copilul meu,\n"
"aceasta e averea mea”:\n"
"astfel de gânduri sunt preocupări\n"
"ale celor necopți.\n"
"Dacă suntem incapabili\n"
"să ne luăm asupra noastră\n"
"chiar și pe noi înșine,\n"
"de ce să facem astfel de revendicări?"

msgid "63"
msgstr ""
"Necoptul care știe că e necopt\n"
"e câtuși de puțin înțelept;\n"
"necoptul care socotește că e înțelept\n"
"e, fără îndoială, necopt."

msgid "64"
msgstr ""
"Asemeni lingurilor incapabile să guste\n"
"din savoarea supei\n"
"sunt cei nesăbuiți care nu pot vedea adevărul,\n"
"cu toate că trăiesc\n"
"toată viața printre cei înțelepți."

msgid "65"
msgstr ""
"Asemeni limbii care poate aprecia\n"
"savoarea supei\n"
"e unul care poate discerne clar adevărul\n"
"după doar o scurtă\n"
"asociere cu cei înțelepți."

msgid "66"
msgstr ""
"Făcând rău,\n"
"fără băgare de seamă,\n"
"nesăbuiții imprudenți\n"
"își produc propriile fructe amare.\n"
"Ei se comportă\n"
"precum inamicii lor cei mai mari."

msgid "67"
msgstr ""
"O faptă nu e bine făcută\n"
"când la reflecție asupra sa remușcarea răsare:\n"
"cu lacrimi de supărare,\n"
"insul își culege fructele."

msgid "68"
msgstr ""
"O faptă e bine făcută\n"
"când la reflecție\n"
"asupra sa nicio remușcare nu răsare:\n"
"cu bucurie insul își culege fructele."

msgid "69"
msgstr ""
"Nesăbuiții percep acțiunile rele\n"
"as fiind dulci precum mierea\n"
"până când văd consecințele.\n"
"Când își zăresc roadele,\n"
"nesăbuiții suferă într-adevăr."

msgid "70"
msgstr ""
"Chiar și după luni de post aspru,\n"
"subzistând cu o dietă frugală,\n"
"un necopt nu poate fi comparat ca valoare\n"
"cu persoana care vede pur și simplu adevărul."

msgid "71"
msgstr ""
"Laptele proaspăt nu se brânzește\n"
"de îndată;\n"
"nici faptele rele nu își arată\n"
"de îndată roadele;\n"
"oricum, necopții suferă\n"
"din cauza ignoranței lor\n"
"la fel cum ar fi arși\n"
"stând pe cărbuni ascunși în cenușă."

msgid "72"
msgstr ""
"Necopții sunt aceia care folosesc prostește\n"
"orice daruri ar avea,\n"
"distrugându-și averea acumulată."

msgid "73"
msgstr ""
"Trufia și râvna necopților crește\n"
"când revendică pentru ei\n"
"autoritate, recunoaștere\n"
"și răsplată necuvenite:"

msgid "74"
msgstr ""
"falsitatea lor le afectează năzuința;\n"
"își doresc să fie văzuți\n"
"drept puternici și deslușitori."

msgid "75"
msgstr ""
"Calea care duce la câștig lumesc\n"
"și calea care duce la Eliberare\n"
"sunt căi diferite.\n"
"Văzând acest lucru, discipolul care renunță\n"
"evită distragerea\n"
"câștigului și succesului lumesc\n"
"pentru a sălășlui în solitudine."

msgid "chap6"
msgstr "Cei Înțelepți"

msgid "76"
msgstr ""
"Doar binecuvântări pot răsări din căutarea\n"
"companiei persoanelor înțelepte\n"
"și deslușitoare,\n"
"care oferă iscusit\n"
"atât mustrare, cât și sfat,\n"
"ca și cum ar ghida insul\n"
"spre o comoară ascunsă."

msgid "77"
msgstr ""
"Fie ca înțelepții să îndrume ființele\n"
"departe de întuneric,\n"
"să dea direcție și sfaturi.\n"
"Vor fi prețuiți de către cei virtuoși\n"
"și îndepărtați de către cei necopți."

msgid "78"
msgstr ""
"Nu căuta compania\n"
"prietenilor prost îndrumați;\n"
"fii prevăzător cu companionii degenerați.\n"
"Caută compania prietenilor bine îndrumați,\n"
"cei care sprijină introspecția."

msgid "79"
msgstr ""
"Capitularea sinelui Dhammei\n"
"conduce la o existență senină.\n"
"Înțelepții se delectează perpetuu în adevărul\n"
"predat de către Unul Trezit."

msgid "80"
msgstr ""
"Cei care construiesc canale\n"
"canalizează cursul apei.\n"
"Săgetarii fac săgeți.\n"
"Lemnarii făuresc lemn.\n"
"Înțelepții se domesticesc."

msgid "81"
msgstr ""
"Cum piatra solidă\n"
"e nemișcată de vânt,\n"
"așa sunt și cei cu înțelepciunea neperturbată\n"
"nici de laudă, nici de ocară."

msgid "82"
msgstr ""
"La auzul învățăturilor adevărate,\n"
"inimile celor receptivi\n"
"devin senine,\n"
"ca un lac adânc, limpede și nemișcat."

msgid "83"
msgstr ""
"Ființele virtuoase sunt neatașate.\n"
"Nu se înfruptă din vorbit fără noimă\n"
"despre plăceri senzuale.\n"
"Cunosc atât fericirea,\n"
"cât și supărarea,\n"
"dar nu sunt posedate de niciuna."

msgid "84"
msgstr ""
"Nici pentru binele propriu,\n"
"nici în numele altuia\n"
"o persoană înțeleaptă nu face pagubă\n"
"– nu pentru hatârul familiei,\n"
"averii sau câștigului.\n"
"Unul astfel e de drept numit\n"
"just, virtuos și înțelept."

msgid "85"
msgstr ""
"Puțini sunt cei care ajung departele.\n"
"Mulți pășesc fără sfârșit înapoi și înainte,\n"
"neîndrăznind să riște călătoria."

msgid "86"
msgstr ""
"Deși e dificil să treci dincolo\n"
"de marea bătută de ploile pasiunii,\n"
"cei care trăiesc în conformitate\n"
"cu Calea bine-predată\n"
"ajung departele."

msgid "87"
msgstr ""
"Cu imaginea liberării ca țel,\n"
"cei înțelepți abandonează întunericul\n"
"și prețuiesc lumina,\n"
"lasă siguranța măruntă în urmă\n"
"și caută libertatea de atașament."

msgid "88"
msgstr ""
"A fi pe urmele unei asemenea desfaceri\n"
"e dificil și rar;\n"
"totuși cei înțelepți o vor căuta,\n"
"detașându-se de obstrucții,\n"
"purificând inima și mintea."

msgid "89"
msgstr ""
"Eliberându-se de năzuință,\n"
"neîmpiedicați de obișnuințe deprinse,\n"
"cei care se aliniază cu Calea\n"
"se delectează în detașare\n"
"și, cât încă stau în lume,\n"
"sunt radioși."

msgid "chap7"
msgstr "Cei Treziți"

msgid "90"
msgstr ""
"Nu există tensiune\n"
"pentru cei care au ajuns la capătul călătoriei\n"
"și au fost eliberați\n"
"din dezastrul tuturor legăturilor încolăcite."

msgid "91"
msgstr ""
"Atenți la nevoile călătoriei,\n"
"cei pe calea conștiinței,\n"
"precum lebedele, curg ușor,\n"
"lăsând în urmă vechile locuri de odihnă."

msgid "92"
msgstr ""
"La fel ca păsările care nu lasă urme în aer\n"
"sunt cei a căror minte nu se agață\n"
"de tentațiile care le sunt oferite.\n"
"Centrul atenției lor e starea de eliberare\n"
"fără reper,\n"
"care pentru ceilalți e imperceptibilă."

msgid "93"
msgstr ""
"Sunt cei care\n"
"sunt liberi de toate piedicile;\n"
"nu se îngrijorează pentru mâncare.\n"
"Centrul atenției lor e starea de eliberare\n"
"fără reper.\n"
"La fel ca păsările care, zburând prin aer,\n"
"fără urme se duc pe cale."

msgid "94"
msgstr ""
"Precum caii bine antrenați de stăpâni\n"
"sunt cei care și-au domesticit simțurile;\n"
"având inimile eliberate\n"
"de mândrie și poluare,\n"
"generează încântare atotcuprinzătoare."

msgid "95"
msgstr ""
"Sunt aceia care descoperă\n"
"că pot abandona complet\n"
"reacțiile confuze\n"
"și să devină răbdători precum pământul;\n"
"nemișcați de ură,\n"
"nezdruncinați precum un stâlp,\n"
"neperturbați precum un iaz limpede și liniștit."

msgid "96"
msgstr ""
"Cei care ajung\n"
"la starea de libertate perfectă\n"
"prin înțelegere dreaptă\n"
"sunt neperturbați\n"
"în corp, vorbire și minte.\n"
"Ei rămân nemișcați\n"
"de vicisitudinile vieții."

msgid "97"
msgstr ""
"Cei care cunosc increatul,\n"
"care sunt liberi și statorniciți,\n"
"care au abandonat toată râvna,\n"
"sunt ființele cele mai vrednice."

msgid "98"
msgstr ""
"Fie într-o pădure,\n"
"un oraș sau ținut deschis,\n"
"încântător e sălașul\n"
"unuia care acum e deplin liber."

msgid "99"
msgstr ""
"Ființele libere de dependența\n"
"de plăceri senzuale\n"
"cunosc o formă unică de încântare.\n"
"Ele caută liniște în refugiile pădurii\n"
"pe care muritorii de rând le-ar evita."

msgid "chap8"
msgstr "Miile"

msgid "100"
msgstr ""
"Un singur cuvânt cu adevăr\n"
"care calmează mintea\n"
"e mai bine a fi auzit decât o mie\n"
"de cuvinte irelevante."

msgid "101"
msgstr ""
"Un singur vers cu adevăr\n"
"care calmează mintea\n"
"e mai bine a fi auzit decât o mie\n"
"de versuri irelevante."

msgid "102"
msgstr ""
"Recitarea unui singur vers cu adevăr\n"
"care calmează mintea\n"
"e mai bine decât a recita\n"
"o mie de versuri fără sens."

msgid "103"
msgstr ""
"Cineva ar putea învinge singur\n"
"în bătălie\n"
"o mie de mii de oameni,\n"
"dar cine dobândește\n"
"stăpânirea de sine\n"
"e de departe eroul superior."

msgid "104"
msgstr ""
"Stăpânirea de sine e victoria supremă –\n"
"de prețuit mai mult\n"
"decât dobândirea controlului\n"
"asupra altora."

msgid "105"
msgstr ""
"E o victorie pe care nicio altă ființă\n"
"nu o poate distorsiona sau înlătura."

msgid "106"
msgstr ""
"A onora, chiar și pentru un singur moment,\n"
"pe unul care a ajuns la stăpânirea de sine,\n"
"e un merit mai mare\n"
"decât a aduce ofrande nenumărate\n"
"celor nevrednici."

msgid "107"
msgstr ""
"A onora, chiar și pentru un singur moment,\n"
"pe unul care a ajuns la măiestria sinelui,\n"
"e mai prielnic decât o mie de ani\n"
"petrecuți îndeplinind formal ceremonii\n"
"bazate pe înțelegere greșită."

msgid "108"
msgstr ""
"Chiar și dacă insul petrece\n"
"un an întreg\n"
"aducând ofrande\n"
"de dragul câștigului propriu,\n"
"toate acestea nu vor cântări\n"
"un sfert din valoarea\n"
"aducerii de venerare unei ființe nobile."

msgid "109"
msgstr ""
"Pentru insul care îi onorează și respectă\n"
"mereu\n"
"pe aceia cu ani mulți,\n"
"există patru binecuvântări:\n"
"viață lungă, frumusețe, fericire și putere."

msgid "110"
msgstr ""
"O singură zi trăită\n"
"cu intenție conștientă și virtute\n"
"e de valoare\n"
"mai mare decât o sută de ani trăiți\n"
"privați de disciplină și abținere dreaptă."

msgid "111"
msgstr ""
"O singură zi trăită\n"
"cu intenție conștientă și înțelepciune\n"
"e de valoare\n"
"mai mare decât o sută de ani trăiți\n"
"privați de disciplină și înțelepciune."

msgid "112"
msgstr ""
"O singură zi trăită\n"
"cu intenție conștientă și efort temeinic\n"
"e de valoare\n"
"mai mare decât o sută de ani\n"
"trăiți în pasivitate leneșă."

msgid "113"
msgstr ""
"O singură zi trăită\n"
"în conștiința tranzienței naturii vieții\n"
"e de valoare\n"
"mai mare decât o sută de ani\n"
"trăiți inconștient de naștere și moarte."

msgid "114"
msgstr ""
"O singură zi trăită\n"
"trezit la starea nemuririi\n"
"e de valoare\n"
"mai mare decât o sută de ani\n"
"trăiți fără a recunoaște nemurirea."

msgid "115"
msgstr ""
"O singură zi trăită\n"
"trezit la adevărul profund\n"
"e de valoare\n"
"mai mare decât o sută de ani\n"
"trăiți netrezit."

msgid "chap9"
msgstr "Rău"

msgid "116"
msgstr ""
"Mergi iute spre a face ceea ce e benefic.\n"
"Abține-ți mintea de la fapte rele.\n"
"Mintea care e înceată în a face bine\n"
"poate ușor să găsească plăcere în facerea de rău."

msgid "117"
msgstr ""
"Dacă săvârșești o faptă rea,\n"
"atunci nu o repeta.\n"
"Evită a găsi plăcere în amintirea ei.\n"
"Urmarea facerii de rău e dureroasă."

msgid "118"
msgstr ""
"Odată săvârșită o faptă benefică\n"
"e bine să o repeți iar și iar.\n"
"Fii interesat de plăcerea binefacerii.\n"
"Fructul bunătății acumulate e împăcarea cu sine."

msgid "119"
msgstr ""
"Chiar și cei care înfăptuiesc răul\n"
"pot trăi în bunăstare\n"
"atâta vreme cât acțiunile lor\n"
"încă nu și-au produs direct fructele.\n"
"În orice caz, când rezultatele\n"
"faptelor se maturează,\n"
"consecințele dureroase\n"
"nu pot fi evitate."

msgid "120"
msgstr ""
"Chiar și cei care trăiesc vieți tihnite\n"
"pot cunoaște suferința\n"
"atâta vreme cât acțiunile lor\n"
"încă nu și-au produs direct fructele.\n"
"În orice caz, când fructele\n"
"faptelor se maturează,\n"
"consecințele vesele\n"
"nu pot fi evitate."

msgid "121"
msgstr ""
"Nu ignora efectele răului,\n"
"zicând: „Nu se va alege nimic din asta.”\n"
"La fel cum prin căderea treptată\n"
"a picurilor de ploaie\n"
"ulciorul de apă se umple,\n"
"astfel, în timp, cei nesăbuiți sunt corupți de\n"
"facerea de rău."

msgid "122"
msgstr ""
"Nu ignora efectele faptei drepte,\n"
"zicând: „Nu se va alege nimic din asta.”\n"
"La fel cum prin căderea treptată\n"
"a picurilor de ploaie\n"
"ulciorul de apă se umple,\n"
"astfel, în timp, cei înțelepți\n"
"devin preaplini cu bunătate."

msgid "123"
msgstr ""
"La fel cum un negustor\n"
"cu încărcătură prețioasă\n"
"evită amenințările\n"
"și acei care iubesc viața evită otrava,\n"
"așa și tu să eviți faptele rele."

msgid "124"
msgstr ""
"O mână fără o rană deschisă\n"
"poate purta otravă\n"
"și să rămână\n"
"liberă de vătămare;\n"
"la fel, răul nu are consecințe\n"
"pentru cei ce nu îl fac."

msgid "125"
msgstr ""
"Dacă rănești intenționat\n"
"o persoană inocentă,\n"
"care e pură și nevinovată,\n"
"răul ți se va întoarce,\n"
"asemenea prafului fin\n"
"aruncat în vânt."

msgid "126"
msgstr ""
"Unii se renasc în oameni;\n"
"răufăcătorii se renasc în iad.\n"
"Cei ce fac bine se renasc în exaltare,\n"
"iar cei puri merg în tărâmul fără urme."

msgid "127"
msgstr ""
"Nu există loc pe pământ\n"
"unde cineva se poate ascunde\n"
"de consecințele faptelor rele –\n"
"nici într-o peșteră de munte,\n"
"nici în ocean, nici în cer."

msgid "128"
msgstr ""
"Nu există loc pe pământ\n"
"unde moartea să nu ajungă –\n"
"nici într-o peșteră de munte,\n"
"nici în ocean, nici în cer."

msgid "chap10"
msgstr "Agresiune"

msgid "129"
msgstr ""
"Având empatie pentru alții,\n"
"insul vede că toate ființele se tem\n"
"de pedeapsă și de moarte.\n"
"Știind asta,\n"
"insul nu atacă sau provoacă un atac."

msgid "130"
msgstr ""
"Având empatie pentru alții,\n"
"insul vede că toate ființele\n"
"iubesc viața și se tem de moarte.\n"
"Știind asta,\n"
"insul nu atacă sau nu provoacă un atac."

msgid "131"
msgstr ""
"A răni ființe vii\n"
"care, la fel ca noi, caută satisfacția,\n"
"e să ne aducem rău nouă înșine."

msgid "132"
msgstr ""
"A evita rănirea ființelor vii\n"
"care, la fel ca noi, caută satisfacția,\n"
"e să ne aducem fericirea."

msgid "133"
msgstr ""
"Evită să vorbești aspru altora;\n"
"vorbitul aspru cere revanșă.\n"
"Cei răniți de cuvintele tale ar putea să te\n"
"rănească la rândul lor."

msgid "134"
msgstr ""
"Dacă ți se vorbește aspru,\n"
"fă-te tăcut ca un gong crăpat;\n"
"a nu căuta răzbunare e un semn al libertății."

msgid "135"
msgstr ""
"Precum un păstor\n"
"conduce vitele spre pășune,\n"
"bătrânețea și moartea\n"
"îndreaptă ființele vii."

msgid "136"
msgstr ""
"Deși cât timp își îndeplinesc faptele rele\n"
"nu realizează ce fac,\n"
"nesăbuiții îndură rezultatele\n"
"acțiunilor lor în consecință,\n"
"la fel cum insul se arde când mânuiește foc."

msgid "137"
msgstr ""
"A pricinui rău\n"
"celor lipsiți de apărare\n"
"aduce curând suferință celor care atacă."

msgid "138"
msgstr ""
"Vor culege durere sau sărăcie sau pierdere,\n"
"boală, nebunie sau persecuție,"

msgid "139"
msgstr ""
"abuz, dezastru sau devastare,"

msgid "140"
msgstr ""
"și, singuri, după moarte,\n"
"vor trebui să-și confrunte fărădelegile."

msgid "141"
msgstr ""
"Nici ascetismul extern,\n"
"nici înjosirea de sine,\n"
"nici privarea fizică de orice fel\n"
"nu-i pot purifica unuia inima\n"
"încă întunecată de îndoială."

msgid "142"
msgstr ""
"Înfățișarea extravagantă exterioară\n"
"nu constituie în sine un blocaj\n"
"spre libertate.\n"
"A avea o inimă în pace,\n"
"pură, asumată,\n"
"trează și nevinovată\n"
"îl distinge pe cel care a renunțat,\n"
"un drumeț, o ființă nobilă."

msgid "143"
msgstr ""
"Un cal bine dresat\n"
"nu dă motiv de strunire.\n"
"Rare sunt acele ființe care,\n"
"prin modestie și disciplină,\n"
"nu dau motiv de mustrare."

msgid "144"
msgstr ""
"Fie ca teroarea\n"
"de mediocritate nesfârșită\n"
"să te zorească spre efort măreț,\n"
"asemeni unui cal bine antrenat\n"
"încurajat de simpla atingere a biciului.\n"
"Leapădă-te de povara\n"
"zbuciumului fără sfârșit\n"
"cu încredere fără regrete,\n"
"cu puritate în fapte, efort, concentrare\n"
"și prin angajament conștiincios și disciplinat\n"
"căii."

msgid "145"
msgstr ""
"Cei care construiesc canale\n"
"canalizează cursul apei.\n"
"Săgetarii fac săgeți.\n"
"Lemnarii făuresc lemn.\n"
"Cei buni se domesticesc."

msgid "chap11"
msgstr "Bătrânețe"

msgid "146"
msgstr ""
"De ce există râs?\n"
"De ce există bucurie\n"
"când lumea e în flăcări?\n"
"Cât timp ești înnorat de întuneric,\n"
"nu ar trebui să cauți lumina?"

msgid "147"
msgstr ""
"Privește îndelung asupra acestui corp\n"
"odată decorat –\n"
"obișnuia să atragă atenție,\n"
"dar acum e doar carne purulentă,\n"
"un obiect putred.\n"
"Nu e nici sigur, nici substanțial."

msgid "148"
msgstr ""
"Acest corp se istovește cu vârsta;\n"
"devine o gazdă\n"
"pentru boală\n"
"– vulnerabil, fragil,\n"
"decrepit, o masă în dezintegrare,\n"
"care în cele din urmă\n"
"sfârșește în moarte."

msgid "149"
msgstr ""
"Ce plăcere mai aduce viața\n"
"odată ce insul a văzut\n"
"oase vechi decolorate,\n"
"aruncate și împrăștiate-n jur?"

msgid "150"
msgstr ""
"Corpul fizic e alcătuit din oase\n"
"îmbrăcate-n carne și sânge.\n"
"Agonisite înăuntrul său\n"
"sunt descompunere și moarte,\n"
"mândrie și răutate."

msgid "151"
msgstr ""
"Primită ca moștenire de la cei înțelepți\n"
"e cunoașterea\n"
"că, deși ceea ce-i impresionant la exterior\n"
"își pierde splendoarea\n"
"și cu toate că\n"
"trupurile noastre se vor descompune,\n"
"adevărul singur va supraviețui degenerărilor."

msgid "152"
msgstr ""
"Cât timp nesăbuiții, înaintând în vârstă,\n"
"pun pe ei precum boii în staulul lor,\n"
"mintea le rămâne mică."

msgid "153"
msgstr ""
"Preț de multe vieți am pribegit\n"
"căutându-l, deși e de negăsit,\n"
"pe clăditorul de case\n"
"care mi-a provocat suferința."

msgid "154"
msgstr ""
"Dar acum ești zărit\n"
"și nu vei mai construi în cele ce urmează.\n"
"Grinzile sunt desprinse și\n"
"coama acoperișului sfărâmată.\n"
"Toată râvna a încetat;\n"
"inima mea e una cu nefăcutul."

msgid "155"
msgstr ""
"Cei care, tineri fiind,\n"
"nici nu aleg o viață în renunțare,\n"
"nici nu-și câștigă existența cuviincios,\n"
"sfârșesc precum stârcii bătrâni, descurajați,\n"
"pe lângă un eleșteu fără pești."

msgid "156"
msgstr ""
"Cei care, tineri fiind,\n"
"nici nu aleg o viață în renunțare,\n"
"nici nu-și câștigă existența cuviincios,\n"
"vor sfârși deplângând trecutul,\n"
"prăbușindu-se precum săgețile consumate\n"
"care și-au ratat ținta."

msgid "chap12"
msgstr "Sinele"

msgid "157"
msgstr ""
"Dacă ținem la noi,\n"
"atunci ne dăm în propria pază\n"
"atât ziua, cât și noaptea."

msgid "158"
msgstr ""
"E înțelept\n"
"a ne îndrepta pe sine\n"
"înainte de a-i instrui pe alții."

msgid "159"
msgstr ""
"Sinele insului e cel mai greu de disciplinat.\n"
"Să faci ceea ce spui:\n"
"îmblânzește-te\n"
"înainte de a încerca să-i îmblânzești pe alții."

msgid "160"
msgstr ""
"Sincer suntem noi\n"
"cei de care depindem;\n"
"cum am putea realmente\n"
"să depindem de altcineva?\n"
"Când ajungem\n"
"la starea de autosuficiență,\n"
"găsim un refugiu rar."

msgid "161"
msgstr ""
"La fel cum diamantul poate tăia\n"
"prin piatra ce odată l-a adăpostit,\n"
"astfel și propriul rău te poate măcina."

msgid "162"
msgstr ""
"Răufăcătorii dedicați\n"
"se comportă față de ei\n"
"precum inamicii lor cei mai mari.\n"
"Sunt precum târâtoarele\n"
"care strangulează copacii\n"
"care le susțin."

msgid "163"
msgstr ""
"E ușor a face ce e fără de real folos\n"
"pentru sine,\n"
"dar e firește dificil să faci\n"
"ceea ce e într-adevăr benefic și bun."

msgid "164"
msgstr ""
"Precum bambusul\n"
"care se distruge dând roade,\n"
"la fel se rănesc și cei necopți\n"
"având perspective greșite\n"
"și luându-i în derâdere pe cei vrednici\n"
"care trăiesc în armonie cu Calea."

msgid "165"
msgstr ""
"Noi înșine facem rău\n"
"și noi înșine suntem făcuți impuri.\n"
"Noi înșine evităm răul\n"
"și noi înșine suntem făcuți puri.\n"
"Aspectul purității e grija noastră.\n"
"Nimeni altcineva nu poate fi responsabil."

msgid "166"
msgstr ""
"Cunoscând Calea pentru sine,\n"
"parcurge-o temeinic.\n"
"Nu îngădui nevoilor altora,\n"
"oricât de insistente,\n"
"să ivească confuzie."

msgid "chap13"
msgstr "Lumea"

msgid "167"
msgstr ""
"Abandonând căile nevrednice\n"
"și netrăind neglijent,\n"
"fără a avea perspective greșite,\n"
"încetăm în a perpetua deziluzia."

msgid "168"
msgstr ""
"Nu afișa falsă umilitate.\n"
"Rămâi ferm raportat la țelul tău.\n"
"Practicând cu atenția cuvenită,\n"
"ajungi la împăcarea cu sine\n"
"atât acum, cât și în viitor."

msgid "169"
msgstr ""
"Trăiește-ți viața în bun acord cu Calea –\n"
"evită o viață confuză.\n"
"O viață bine trăită duce la împăcarea cu sine\n"
"atât acum, cât și în viitor."

msgid "170"
msgstr ""
"Regele Morții nu-i poate găsi\n"
"pe cei care privesc lumea\n"
"ca fiind nesubstanțială,\n"
"ca fiind tranzientă, o bulă –\n"
"iluzorie, doar un miraj."

msgid "171"
msgstr ""
"Vino, vezi această lume.\n"
"Vezi-o precum o caleașcă împodobită festiv.\n"
"Vezi cum nesăbuiții sunt hipnotizați\n"
"de vedeniile lor;\n"
"totuși, pentru cei înțelepți nu există atașament."

msgid "172"
msgstr ""
"Sunt aceia care\n"
"se trezesc din nebăgarea de seamă.\n"
"Aduc lumină în lume\n"
"precum luna\n"
"ivindu-se dintre nori."

msgid "173"
msgstr ""
"Cel care transformă căi vechi\n"
"și lipsite de băgare de seamă\n"
"în căi noi și fapte prielnice\n"
"aduce lumină în lume\n"
"precum luna eliberată de nori."

msgid "174"
msgstr ""
"Dacă păsările sunt prinse într-o plasă,\n"
"doar câteva vor scăpa vreodată.\n"
"În această lume a iluziei,\n"
"puțini își văd de drum până la eliberare."

msgid "175"
msgstr ""
"Lebedele albe se ridică în aer.\n"
"Yoghinii înzestrați\n"
"călătoresc prin spațiu.\n"
"Ființele înțelepte\n"
"transcend deziluzia lumească,\n"
"amăgind hoardele lui Mara."

msgid "176"
msgstr ""
"Pentru insul care încalcă\n"
"legea veridicității,\n"
"insul care nu ține seama\n"
"de existența viitoare,\n"
"nu există niciun fel de rău\n"
"care să fie imposibil."

msgid "177"
msgstr ""
"Cei care eșuează în a prețui generozitatea\n"
"nu ajung pe tărâmurile cerești.\n"
"Însă cei înțelepți se bucură când oferă\n"
"și își duc de-a pururi veacul în exaltare."

msgid "178"
msgstr ""
"Mai bine decât a conduce întreaga lume,\n"
"mai bine decât a ajunge în rai,\n"
"mai bine decât stăpânirea asupra universului,\n"
"e un angajament ireversibil față de Cale."

msgid "chap14"
msgstr "Buddha"

msgid "179"
msgstr ""
"Perfecțiunea lui Buddha e completă;\n"
"nu mai există muncă de făcut.\n"
"Nu există măsură pentru înțelepciunea lui;\n"
"limitele sunt de negăsit.\n"
"În ce fel poate fi el distras\n"
"de la adevăr?"

msgid "180"
msgstr ""
"Perfecțiunea lui Buddha e completă;\n"
"în el nu există râvnă\n"
"care să-l poată trage în jos.\n"
"Nu există măsură pentru înțelepciunea lui;\n"
"limitele sunt de negăsit.\n"
"În ce fel poate fi el distras\n"
"de la adevăr?"

msgid "181"
msgstr ""
"Ființele celeste îi prețuiesc\n"
"pe Cei Treziți\n"
"care au văzut Calea pe deplin,\n"
"care sunt devotați meditației\n"
"și se încântă în pacea\n"
"renunțării."

msgid "182"
msgstr ""
"Nu e ușor să fii născut ca ființă omenească\n"
"și să trăiești această viață de muritor.\n"
"Nu e ușor a găsi oportunitatea\n"
"de a auzi Dhamma\n"
"și e rar ca un Buddha să apară."

msgid "183"
msgstr ""
"Înfrână-te de la a face rău,\n"
"cultivă ceea ce e bun,\n"
"purifică-ți inima.\n"
"Aceasta e Calea Celor Treziți."

msgid "184"
msgstr ""
"Cel care a renunțat\n"
"nu oprimă pe nimeni.\n"
"Răbdarea perseverentă\n"
"e ascetismul superior.\n"
"Eliberarea profundă,\n"
"spun Buddha,\n"
"e țelul suprem."

msgid "185"
msgstr ""
"A nu insulta, a nu vătăma,\n"
"cultivarea abținerii,\n"
"cu respect față de disciplină,\n"
"mâncatul cu modestie și împăcarea\n"
"cu locul unde insul sălășluiește,\n"
"devotament față de intenția lucidă:\n"
"aceasta e învățătura lui Buddha."

msgid "186"
msgstr ""
"Nu în avere mare\n"
"e împăcarea cu sine,\n"
"nici în plăceri senzuale,\n"
"grosolane sau rafinate."

msgid "187"
msgstr ""
"Dar în dispariția râvnei\n"
"e de găsit bucuria\n"
"de către un discipol al lui Buddha."

msgid "188"
msgstr ""
"Spre multe locuri ființele se retrag\n"
"pentru a scăpa de frică:\n"
"în munți, păduri,\n"
"câmpii și grădini;\n"
"la fel și locuri sfinte."

msgid "189"
msgstr ""
"Dar niciunul dintre aceste locuri\n"
"nu oferă refugiu adevărat;\n"
"niciunul dintre ele nu ne poate elibera de frică."

msgid "190"
msgstr ""
"Insul care-și găsește refugiul în Buddha,\n"
"în Dhamma și în Sangha,\n"
"vede cu introspecție penetrantă:"

msgid "191"
msgstr ""
"suferința, cauza ei, izbăvirea ei\n"
"și Calea care duce spre libertate adevărată."

msgid "192"
msgstr ""
"Buddha, Dhamma și Sangha:\n"
"acestea sunt refugiile adevărate;\n"
"acestea sunt supreme;\n"
"acestea duc la Eliberare."

msgid "193"
msgstr ""
"E greu a găsi\n"
"o ființă cu înțelepciune măreață;\n"
"rare sunt locurile\n"
"în care se naște.\n"
"Cei aflați în preajma sa\n"
"când apare\n"
"au într-adevăr noroc."

msgid "194"
msgstr ""
"Binecuvântată e apariția unui Buddha;\n"
"binecuvântată e revelarea Dhammei;\n"
"binecuvântată e concordia Sanghăi;\n"
"încântătoare e comuniunea armonioasă."

msgid "195"
msgstr ""
"Nemăsurat e beneficiul\n"
"obținut din cinstirea celor\n"
"ce sunt puri și dincolo de frică."

msgid "196"
msgstr ""
"Ființele care au descoperit eliberarea\n"
"de supărare și mâhnire\n"
"sunt demne de onoare."

msgid "chap15"
msgstr "Fericire"

msgid "197"
msgstr ""
"Cât timp te afli printre\n"
"cei ce urăsc\n"
"și sălășluiești fără de ură –\n"
"aceasta este cu adevărat fericirea."

msgid "198"
msgstr ""
"Cât timp te afli printre\n"
"cei ce sunt tulburați\n"
"și sălășluiești fără de tulburare –\n"
"aceasta este cu adevărat fericirea."

msgid "199"
msgstr ""
"Cât timp te afli printre\n"
"cei ce sunt lacomi\n"
"și sălășluiești fără de lăcomie –\n"
"aceasta este cu adevărat fericirea."

msgid "200"
msgstr ""
"Sălășluim fericit,\n"
"fără angoasă;\n"
"ca ființele radioase\n"
"din tărâmurile celeste\n"
"sărbătorim încântarea."

msgid "201"
msgstr ""
"Victoria duce la ură,\n"
"căci înfrânții suferă.\n"
"Cei pașnici trăiesc fericiți,\n"
"dincolo de victorie și înfrângere."

msgid "202"
msgstr ""
"Nu există niciun alt foc precum voluptatea,\n"
"nicio altă suferință precum ura,\n"
"nicio altă durere precum povara atașării,\n"
"nicio altă bucurie precum pacea adusă de eliberare."

msgid "203"
msgstr ""
"Pofta e cea mai mare nenorocire,\n"
"condiționarea e cea mai mare\n"
"sursă de disperare.\n"
"Cei înțelepți, văzând lucrurile ca atare,\n"
"înțeleg că eliberarea e cea mai mare bucurie."

msgid "204"
msgstr ""
"O minte sănătoasă este cel mai mare câștig.\n"
"Împăcarea cu sine este cea mai mare avere.\n"
"Nădejdea este cel mai bun prieten.\n"
"Libertatea necondiționată este cea mai mare\n"
"exaltare."

msgid "205"
msgstr ""
"Gustând din savoarea solitudinii\n"
"și din nectarul păcii,\n"
"cei ce beau din fericirea care e esența realității\n"
"își duc veacul fără a se teme de rău."

msgid "206"
msgstr ""
"E întotdeauna o plăcere\n"
"să nu trebuiască să întâlnești nesăbuiți.\n"
"E întotdeauna bine să vezi ființe nobile\n"
"și o încântare să trăiești cu ele."

msgid "207"
msgstr ""
"Compania ignoranților e searbădă\n"
"și dureroasă de fiecare dată,\n"
"ca și cum te-ar înconjura inamicii;\n"
"însă asocierea cu cei înțelepți\n"
"înseamnă a te simți ca acasă."

msgid "208"
msgstr ""
"Urmărește căile pe care le iau\n"
"cei ce sunt statornici,\n"
"deslușitori, puri și conștienți,\n"
"asemenea lunii care urmează\n"
"calea stelelor."

msgid "chap16"
msgstr "Afecțiune"

msgid "209"
msgstr ""
"Sunt ființe pe urma\n"
"a ceea ce ar trebui evitat\n"
"și care evită\n"
"ceea ce ar trebui urmărit.\n"
"Cufundați în simțuri își pierd calea,\n"
"iar mai apoi îi invidiază\n"
"pe cei ce cunosc adevărul."

msgid "210"
msgstr ""
"A pierde compania celor\n"
"alături de care ne simțim acasă\n"
"e dureros,\n"
"iar asocierea cu cei care ne displac\n"
"e chiar mai neplăcută;\n"
"așadar, nu vă lăsați\n"
"nici în voia companiei\n"
"celor cu care vă simțiți acasă,\n"
"nici celor care vă displac."

msgid "211"
msgstr ""
"Fiți prevăzători cu atașamentul\n"
"ce izvorăște din afecțiune,\n"
"căci despărțirea de cei dragi e dureroasă;\n"
"atunci când nu vă aliniați\n"
"nici de partea, nici împotriva afecțiunii,\n"
"nu vor exista legături care să constrângă."

msgid "212"
msgstr ""
"Din îndrăgire izvorăște mâhnirea.\n"
"Din îndrăgire izvorăște teama de a pierde.\n"
"Iar dacă insul nu îndrăgește,\n"
"nu există mâhnire –\n"
"cum ar putea fi prezentă, astfel, teama?"

msgid "213"
msgstr ""
"A se pierde în afecțiune\n"
"aduce supărare;\n"
"a se pierde în afecțiune\n"
"aduce teamă.\n"
"Eliberarea de afecțiune\n"
"înseamnă încetarea supărării –\n"
"cum ar putea fi prezentă, astfel, teama?"

msgid "214"
msgstr ""
"A se pierde în desfătare\n"
"aduce supărare;\n"
"a se pierde în desfătare\n"
"aduce teamă.\n"
"A se elibera de resimțirea oricărei desfătări\n"
"înseamnă încetarea supărării –\n"
"cum ar putea fi prezentă, astfel, teama?"

msgid "215"
msgstr ""
"A se pierde în voluptate\n"
"aduce supărare;\n"
"a se pierde în voluptate\n"
"aduce teamă.\n"
"A nu se pierde în voluptate\n"
"înseamnă încetarea supărării –\n"
"cum ar putea fi prezentă, astfel, teama?"

msgid "216"
msgstr ""
"A se pierde în râvnă\n"
"aduce supărare;\n"
"a se pierde în râvnă\n"
"aduce teamă.\n"
"Eliberarea de râvnă\n"
"înseamnă încetarea supărării –\n"
"cum ar putea fi prezentă, astfel, teama?"

msgid "217"
msgstr ""
"Cei îndrăgiți în mod firesc\n"
"sunt cei ce trăiesc săvârșind fapte drepte\n"
"și au descoperit Calea,\n"
"iar prin introspecție\n"
"au devenit consacrați adevărului."

msgid "218"
msgstr ""
"Cei care tânjesc\n"
"după ceea ce nu se poate defini,\n"
"cu inimile pline de inspirație,\n"
"cu mințile eliberate\n"
"de râvna senzuală,\n"
"se numesc\n"
"„cei destinați eliberării”."

msgid "219"
msgstr ""
"Așa cum familia și prietenii\n"
"îi întâmpină cu bucurie\n"
"pe cei dragi ce se întorc acasă de departe,"

msgid "220"
msgstr ""
"la fel propriile lor fapte bune\n"
"îi întâmpină pe cei care le-au făcut\n"
"atunci când trec de la viața aceasta la următoarea."

msgid "chap17"
msgstr "Furie"

msgid "221"
msgstr ""
"Leapădă-te de furie.\n"
"Abandonează trufia.\n"
"Eliberează-te de toate constrângerile.\n"
"Cei cu inima pură\n"
"care nu se agață nici de corp, nici de minte\n"
"nu cad pradă suferinței."

msgid "222"
msgstr ""
"Spun că cei care înfrânează furia\n"
"așa cum un vizitiu controlează\n"
"un rădvan în viteză\n"
"dețin complet controlul asupra vieților lor;\n"
"alții stau doar cu mâinile pe hățuri."

msgid "223"
msgstr ""
"Transformă furia cu bunătate\n"
"și răutatea cu ceea ce e prielnic,\n"
"zgârcenia cu generozitate\n"
"și înșelăciunea cu integritate."

msgid "224"
msgstr ""
"Aceste trei căi\n"
"conduc către paradisuri:\n"
"a susține adevărul,\n"
"a rezista în fața furiei\n"
"și a dărui, chiar dacă ai doar puțin de împărțit."

msgid "225"
msgstr ""
"Cei Treziți nu provoacă rău.\n"
"Se bucură de abținere dreaptă\n"
"și se îndreaptă către imuabilitate\n"
"acolo unde nu se mai mâhnesc."

msgid "226"
msgstr ""
"Toate impuritățile dispar\n"
"din mințile celor mereu vigilenți,\n"
"care se instruiesc zi și noapte,\n"
"și ale căror vieți sunt dedicate pe deplin eliberării."

msgid "227"
msgstr ""
"Încă din timpurile străvechi\n"
"cei care vorbesc prea mult sunt criticați,\n"
"precum și cei care vorbesc prea puțin\n"
"și cei care nu vorbesc deloc.\n"
"Toți cei din această lume sunt criticați."

msgid "228"
msgstr ""
"Nu a trăit vreodată,\n"
"nici nu va trăi,\n"
"nici nu trăiește în prezent\n"
"un om care să fie doar blamat\n"
"sau elogiat pe de-a-ntregul."

msgid "229"
msgstr ""
"Cei care trăiesc impecabil,\n"
"cei deslușitori,\n"
"inteligenți și virtuoși –\n"
"aceștia sunt elogiați neîntrerupt de cei înțelepți."

msgid "230"
msgstr ""
"Cine i-ar putea învinovăți pe aceia\n"
"a căror ființă se aseamănă cu aurul?\n"
"Până și zeii îi elogiază."

msgid "231"
msgstr ""
"Fiți prevăzători cu mișcările stângace\n"
"și purtați-vă trupul cu conștiință.\n"
"Renunțați la toate acțiunile nefaste\n"
"și cultivați-le pe cele integre."

msgid "232"
msgstr ""
"Fiți prevăzători cu enunțurile născocite\n"
"și vorbiți mereu cu conștiință.\n"
"Renunțați la toate cuvântările viclene\n"
"și cultivați-le pe cele integre."

msgid "233"
msgstr ""
"Fiți prevăzători cu gândirea nefastă\n"
"și stăruiți mereu cu conștiință.\n"
"Renunțați la toate gândurile insolente\n"
"și cultivați-le pe cele benefice."

msgid "234"
msgstr ""
"Cu pricepere se abțin înțelepții,\n"
"în acțiune, în gând\n"
"și în cuvântări."

msgid "chap18"
msgstr "Impurități"

msgid "235"
msgstr ""
"Asemenea unei frunze veștejite,\n"
"aveți mesagerul morții alături.\n"
"Chiar dacă urmează o călătorie lungă,\n"
"încă nu ați făcut nicio provizie."

msgid "236"
msgstr ""
"Grăbiți-vă întru cultivarea înțelepciunii;\n"
"clădiți-vă o insulă.\n"
"Scăpați de întinare și pângărire,\n"
"veți deveni ființe nobile."

msgid "237"
msgstr ""
"A sosit momentul să vă aflați\n"
"în prezența domniei sale, Moartea.\n"
"Nu e răgaz de odihnă în timpul călătoriei,\n"
"și totuși ce provizii v-ați făcut?"

msgid "238"
msgstr ""
"Grăbiți-vă întru cultivarea înțelepciunii;\n"
"clădiți-vă o insulă.\n"
"Scăpați de întinare și pângărire,\n"
"veți fi eliberați de naștere și de moarte."

msgid "239"
msgstr ""
"Treptat, treptat,\n"
"clipă cu clipă,\n"
"înțelepții își înlătură propriile impurități\n"
"așa cum un aurar înlătură zgura."

msgid "240"
msgstr ""
"Așa cum fierul e distrus de rugina\n"
"pe care o produce,\n"
"cei care înfăptuiesc răul sunt corodați\n"
"de propriile acțiuni."

msgid "241"
msgstr ""
"Lipsa studiului duce la uitarea învățăturilor;\n"
"neglijarea atrage stricăciunea căminului;\n"
"lenea duce la pierderea frumuseții;\n"
"nebăgarea de seamă nimicește atenția."

msgid "242"
msgstr ""
"Desfrânarea\n"
"îi înjosește pe cei ce o practică;\n"
"zgârcenia îi înjosește pe cei ce ar putea dărui.\n"
"Faptele care își înjosesc făptuitorul\n"
"sunt cu siguranță întinări."

msgid "243"
msgstr ""
"Însă cea mai gravă întinare dintre toate\n"
"este ignoranța.\n"
"Purificați-vă de aceasta și veți fi liberi."

msgid "244"
msgstr ""
"Viața pare să fie ușoară\n"
"pentru insul căruia îi lipsește rușinea,\n"
"care este la fel de neobrăzat precum o cioară,\n"
"arogant, agresiv, băgăreț și viciat."

msgid "245"
msgstr ""
"Viața nu este ușoară pentru cei ce au simțul rușinii,\n"
"cei modești, cu mintea pură și detașați,\n"
"drepți și contemplativi."

msgid "246"
msgstr ""
"Insul care distruge viața,\n"
"nu ține seama de adevăr,\n"
"iresponsabil sexual,"

msgid "247"
msgstr ""
"care ia ceea ce de drept nu îi aparține\n"
"și se lasă fără băgare de seamă\n"
"în voia drogurilor\n"
"își distruge tocmai rădăcinile propriei vieți."

msgid "248"
msgstr ""
"Insul cufundat în bunătate\n"
"trebuie să știe cele ce urmează:\n"
"lipsa stăpânirii de sine e dezastruoasă.\n"
"Nu permiteți lăcomiei și purtării nepotrivite\n"
"să vă prelungească agonia."

msgid "249"
msgstr ""
"Pe oameni îi inspiră să fie generoși\n"
"credința lor și încrederea.\n"
"Dacă ajungem nemulțumiți\n"
"de ceea ce ni s-a dat,"

msgid "250"
msgstr ""
"meditația noastră va fi stăpânită\n"
"de aflicțiune mentală nesfârșită;\n"
"însă dacă suntem liberi de această nemulțumire,\n"
"meditația noastră e plină de pace."

msgid "251"
msgstr ""
"Nu există niciun alt foc precum voluptatea,\n"
"nicio obstrucție precum ura,\n"
"nicio capcană precum decepția\n"
"și nicio vâltoare precum râvna."

msgid "252"
msgstr ""
"E ușor a vedea defectele altora,\n"
"însă e nevoie de curaj\n"
"pentru a privi la cele proprii.\n"
"Cum se întâmplă cu pleava,\n"
"un ins ar putea alege neajunsurile altora,\n"
"în timp ce și le ascunde pe cele proprii;\n"
"așa cum un vânător șiret\n"
"s-ar putea ascunde de pradă."

msgid "253"
msgstr ""
"Cei ce sunt mereu în căutarea\n"
"defectelor altora –\n"
"prejudecățile leur sporesc\n"
"și se află departe de libertate."

msgid "254"
msgstr ""
"În aer nu se găsesc drumuri,\n"
"nu există o altă eliberare în afară de Cale.\n"
"Majoritatea se dedau proliferării,\n"
"de care Cei Treziți sunt eliberați."

msgid "255"
msgstr ""
"În aer nu se găsesc drumuri,\n"
"nu există o altă eliberare în afară de Cale.\n"
"Nu există lucruri condiționate\n"
"care să fie permanente,\n"
"și totuși Buddha rămân neperturbați."

msgid "chap19"
msgstr "Cei Drepți"

msgid "256"
msgstr ""
"Luatul unei decizii arbitrare\n"
"nu duce la dreptate.\n"
"Cei înțelepți hotărăsc asupra cazului\n"
"după ce au în vedere argumentele\n"
"pentru și împotriva."

msgid "257"
msgstr ""
"Luând decizii în baza adevărului și echității,\n"
"insul protejează legea și se poate numi virtuos."

msgid "258"
msgstr ""
"Cei ce vorbesc mult\n"
"nu sunt neapărat înzestrați cu înțelepciune.\n"
"Se poate vedea că înțelepții\n"
"sunt împăcați cu viața\n"
"și fără dușmănie și teamă."

msgid "259"
msgstr ""
"Deși cunoștințele unui ins ar putea fi limitate,\n"
"dacă înțelegerea și conduita\n"
"sunt în conformitate cu Calea,\n"
"se consideră că insul este un bun\n"
"cunoscător al Dhammei."

msgid "260"
msgstr ""
"A avea părul cărunt\n"
"nu vă aduce în rândul venerabililor;\n"
"sunteți poate copți în privința anilor,\n"
"însă posibil fără sens."

msgid "261"
msgstr ""
"Insul sincer, virtuos, de o conduită impecabilă,\n"
"eliberat de toate întinările și înțelept\n"
"poate fi numit venerabil."

msgid "262"
msgstr ""
"Cei invidioși, zgârciți și manipulatori\n"
"rămân neatrăgători în ciuda înfățișării\n"
"plăcute și vorbitului elocvent."

msgid "263"
msgstr ""
"Însă cei care s-au eliberat de defecte\n"
"și au ajuns la înțelepciune\n"
"sunt cu adevărat atrăgători."

msgid "264"
msgstr ""
"Rasul părului de pe cap\n"
"nu vă transformă în cei ce renunță\n"
"dacă rămâneți plini\n"
"de nechibzuință și înșelăciune.\n"
"Cum poate cineva posedat de râvnă și voluptate\n"
"să fie în rând cu cei care renunță?"

msgid "265"
msgstr ""
"Deveniți călugări sau călugărițe\n"
"abandonând pe deplin răul,\n"
"renunțând la tot ce nu e benefic,\n"
"atât mare, cât și mic."

msgid "266"
msgstr ""
"Nu sunteți călugări sau călugărițe\n"
"pentru că depindeți de alții pentru mâncare,\n"
"ci dedicându-vă cu toată inima\n"
"instruirii trupului, vorbitului și minții."

msgid "267"
msgstr ""
"Deveniți călugări sau călugărițe\n"
"privind prin această lume cu înțelegere,\n"
"fiind dincolo de bine și de rău\n"
"și trăind o viață pură și contemplativă."

msgid "268"
msgstr ""
"Liniștea nu denotă profunzime\n"
"dacă sunteți ignoranți și neinstruiți.\n"
"Ca și cum ar ține în mână o balanță,"

msgid "269"
msgstr ""
"un învățat cântărește lucrurile,\n"
"prielnice și neprielnice,\n"
"și ajunge să cunoască atât lumile interioare,\n"
"cât și exterioare.\n"
"Astfel învățatul se numește înțelept."

msgid "270"
msgstr ""
"Cei ce încă fac rău ființelor vii\n"
"nu pot fi considerați nobili.\n"
"Cei nobili păstrează o comportare\n"
"inofensivă față de toate ființele."

msgid "271"
msgstr ""
"Nu fiți mulțumiți\n"
"doar pentru că respectați\n"
"toate regulile și normele,\n"
"nici pentru că dobândiți învățăminte vaste.\n"
"Nu vă simțiți satisfăcuți\n"
"doar pentru că ați dobândit\n"
"absorbția în meditație,"

msgid "272"
msgstr ""
"nici pentru că vă puteți cufunda\n"
"în exaltarea solitudinii.\n"
"Doar când ajungeți la eradicarea completă\n"
"a oricărei urme de ignoranță și trufie\n"
"trebuie să fiți satisfăcuți."

msgid "chap20"
msgstr "Calea"

msgid "273"
msgstr ""
"Calea cu opt brațe\n"
"este cel mai onorabil drum,\n"
"cele patru Adevăruri Nobile\n"
"cele mai onorabile enunțuri,\n"
"libertatea de râvnă\n"
"cea mai onorabilă stare,\n"
"iar Buddha atotvăzător\n"
"cea mai onorabilă ființă."

msgid "274"
msgstr ""
"Aceasta este singura Cale;\n"
"nu există alta\n"
"care să conducă la o viziune limpede.\n"
"Urmați această Cale,\n"
"iar Mara va fi dezorientată."

msgid "275"
msgstr ""
"Dacă umblați pe cale\n"
"veți ajunge la capătul suferinței.\n"
"Văzând chiar eu acest lucru,\n"
"proclam Calea care înlătură\n"
"toți spinii."

msgid "276"
msgstr ""
"Cei Treziți\n"
"nu pot decât să indice calea;\n"
"efortul trebuie să îl depunem noi înșine.\n"
"Cei ce reflectă cu înțelepciune\n"
"și intră pe cale sunt eliberați\n"
"din lanțurile Marei."

msgid "277"
msgstr ""
"„Toate lucrurile condiționate sunt\n"
"nepermanente”;\n"
"când vom vedea acest lucru prin introspecție\n"
"ne vom sătura de această viață a suferinței.\n"
"Aceasta este Calea către purificare."

msgid "278"
msgstr ""
"„Toate lucrurile condiționate\n"
"sunt incomplete”;\n"
"când vom vedea acest lucru prin introspecție\n"
"ne vom sătura de această viață a suferinței.\n"
"Aceasta este Calea către purificare."

msgid "279"
msgstr ""
"„Toate realitățile\n"
"sunt lipsite de un sine statornic”;\n"
"când vom vedea acest lucru prin introspecție\n"
"ne vom sătura de această viață a suferinței.\n"
"Aceasta este Calea către purificare."

msgid "280"
msgstr ""
"Dacă, pe când încă sunteți tineri și în putere,\n"
"amânați atunci când trebuie să acționați,\n"
"dedându-vă fanteziilor fără băgare de seamă,\n"
"Calea și înțelepciunea sa\n"
"nu vor fi niciodată limpezi."

msgid "281"
msgstr ""
"Vorbiți cu atenție,\n"
"gândiți cu abținere,\n"
"și acționați fără cusur.\n"
"Purificarea acestor trei mijloace de a vă purta\n"
"vă va conduce pe Calea înțelepților."

msgid "282"
msgstr ""
"A contempla viața conduce la înțelepciune;\n"
"înțelepciunea apune fără contemplare.\n"
"Recunoașteți cum se cultivă\n"
"și distruge înțelepciunea\n"
"și umblați pe Calea înălțării."

msgid "283"
msgstr ""
"Îndepărtați pădurile râvnei,\n"
"însă fără a ataca și distruge copacii.\n"
"Îndepărtați întreaga pădure a râvnei\n"
"și veți vedea Calea către libertate."

msgid "284"
msgstr ""
"Cât timp atracția sexuală\n"
"nu a fost îndepărtată\n"
"și dacă nu dispare chiar și\n"
"cea mai mică urmă,\n"
"inima rămâne dependentă\n"
"asemenea unui vițel alăptat\n"
"de vacă."

msgid "285"
msgstr ""
"Îndepărtați înlănțuirile afecțiunii\n"
"așa cum ați smulge o floare de toamnă.\n"
"Umblați pe Calea care conduce către liberare,\n"
"elucidată de Cel Trezit."

msgid "286"
msgstr ""
"Un necopt\n"
"este cel ce se dedă visării\n"
"privind cel mai comod loc\n"
"de trai, spunând\n"
"„Aici va fi cald,\n"
"acolo va fi răcoare” –\n"
"inconștient de iminența morții."

msgid "287"
msgstr ""
"Așa cum o inundație\n"
"poate mătura din cale un sat întreg,\n"
"cei cufundați în relații și posesii\n"
"vor fi purtați de moarte."

msgid "288"
msgstr ""
"Pe când vă apropiați de moarte\n"
"nu vă va proteja niciunul\n"
"dintre atașamentele îndrăgite."

msgid "289"
msgstr ""
"Vedeți asta, iar apoi,\n"
"cu abținere înțeleaptă și efort de neclintit,\n"
"grăbiți-vă să vă croiți drumul către liberare."

msgid "chap21"
msgstr "Diverse"

msgid "290"
msgstr ""
"Înțelepciunea îngăduie renunțarea\n"
"la o fericire mai neînsemnată\n"
"în căutarea unei fericiri mai însemnate."

msgid "291"
msgstr ""
"Eșuezi în căutarea fericirii\n"
"dacă o cauți cu prețul stării de bine\n"
"a altora.\n"
"Lațul voinței bolnave\n"
"te poate strânge în continuare."

msgid "292"
msgstr ""
"A lăsa nefăcut\n"
"ceea ce ar trebui făcut\n"
"și a face ceea ce ar trebui evitat\n"
"duce la neatenție și trufie.\n"
"Iar astfel confuzia va spori."

msgid "293"
msgstr ""
"Confuzia încetează\n"
"susținând cultivarea\n"
"lucidității cufundate în corp,\n"
"evitând ceea ce nu ar trebui făcut\n"
"și făcând lucid\n"
"ceea ce ar trebui făcut."

msgid "294"
msgstr ""
"Prin îndepărtarea râvnei și a îngâmfării,\n"
"eradicarea concepțiilor greșite\n"
"și scăparea atașamentelor\n"
"înșelătoare de sub domnia simțurilor,\n"
"ființa nobilă merge liber înainte."

msgid "295"
msgstr ""
"Odată cu îndepărtarea\n"
"tuturor obstacolelor către Cale –\n"
"lăcomie, furie, trândăvie și lene,\n"
"îngrijorare, anxietate și îndoială –\n"
"ființa nobilă merge liber înainte."

msgid "296"
msgstr ""
"Discipolii lui Buddha sunt pe deplin treji,\n"
"sălășluind atât ziua, cât și noaptea\n"
"întru contemplarea Celui Trezit."

msgid "297"
msgstr ""
"Discipolii lui Buddha sunt pe deplin treji,\n"
"sălășluind atât ziua, cât și noaptea\n"
"întru contemplarea realității."

msgid "298"
msgstr ""
"Discipolii lui Buddha sunt pe deplin treji,\n"
"sălășluind atât ziua, cât și noaptea\n"
"întru contemplarea comuniunii\n"
"dintre ființele care s-au trezit."

msgid "299"
msgstr ""
"Discipolii lui Buddha sunt pe deplin treji,\n"
"sălășluind atât ziua, cât și noaptea\n"
"întru contemplarea naturii\n"
"adevărate a corpului."

msgid "300"
msgstr ""
"Discipolii lui Buddha sunt pe deplin treji\n"
"atât ziua, cât și noaptea,\n"
"delectându-se în compasiune."

msgid "301"
msgstr ""
"Discipolii lui Buddha sunt pe deplin treji\n"
"atât ziua, cât și noaptea,\n"
"delectându-se în cultivarea\n"
"inimii."

msgid "302"
msgstr ""
"O viață a renunțării\n"
"este greu de trăit;\n"
"încercările sale\n"
"sunt greu de socotit drept plăcute.\n"
"Totuși, și viața de gospodar\n"
"este greu de trăit;\n"
"e durere asocierea\n"
"cu cei alături de care\n"
"insul nu consideră că merge în tovărășie.\n"
"Pribegitul fără angajament\n"
"va fi mereu greu;\n"
"de ce să nu renunțați\n"
"la căutarea înșelătoare a durerii?"

msgid "303"
msgstr ""
"Un călător înzestrat cu virtute,\n"
"disciplinat și dedicat\n"
"conduitei corecte,\n"
"va fi primit cu onoare;\n"
"un asemenea ins poate fi\n"
"recunoscut și poate călători încrezător."

msgid "304"
msgstr ""
"Cei buni se deslușesc încă\n"
"de la distanță.\n"
"Strălucesc asemenea\n"
"vârfurilor îndepărtate din Himalaya.\n"
"Cei neinstruiți dispar pur și simplu\n"
"asemenea săgeților trase în întuneric."

msgid "305"
msgstr ""
"Consacrați-vă cu entuziasm\n"
"cultivării solitudinii –\n"
"ședeți singuri, dormiți singuri,\n"
"umblați singuri\n"
"și delectați-vă ca și cum\n"
"ați fi izolați în pădure."

msgid "chap22"
msgstr "Iad"

msgid "306"
msgstr ""
"Minciuna duce la supărare.\n"
"Tăinuirea acțiunilor greșite\n"
"duce la supărare.\n"
"Aceste două fapte de înșelăciune\n"
"duc ființele\n"
"la aceeași stare de suferință."

msgid "307"
msgstr ""
"Cei ce poartă robele\n"
"unuia care a renunțat,\n"
"dar nutresc rău și sunt nestăpâniți\n"
"trec la o stare de supărare."

msgid "308"
msgstr ""
"Celui ce a renunțat\n"
"i-ar fi mai bine înghițind fier topit\n"
"decât să trăiască din ofrande\n"
"dobândite necinstit."

msgid "309"
msgstr ""
"Tristețea adunată,\n"
"somnul neliniștit,\n"
"vinovăția și remușcarea\n"
"sunt povara celui adulter."

msgid "310"
msgstr ""
"Scurtă este încântarea\n"
"cuplului adulter temător,\n"
"căci nu pot urma decât consecințe dureroase."

msgid "311"
msgstr ""
"Așa cum iarba kusa prinsă nepotrivit\n"
"rănește mâna celui ce o apucă,\n"
"la fel traiul unuia care a renunțat\n"
"îi rănește pe cei ce se instruiesc nepotrivit."

msgid "312"
msgstr ""
"Faptele comise nechibzuit,\n"
"practicile făcute greșit,\n"
"viața sfântă trăită cu depravare\n"
"aduc puține beneficii sau niciunul."

msgid "313"
msgstr ""
"Dacă aveți ceva de făcut,\n"
"faceți-o cum se cuvine,\n"
"cu energie și dedicare;\n"
"viața unuia ce a renunțat\n"
"trăită fără băgare de seamă\n"
"nu face decât să ridice praful."

msgid "314"
msgstr ""
"Faptele dureroase\n"
"mai bine rămân nefăcute,\n"
"deoarece conduc mereu la remușcări.\n"
"Faptele inofensive\n"
"e mai bine să fie făcute,\n"
"deoarece nu vor fi urmate de regrete."

msgid "315"
msgstr ""
"Așa cum un oraș de graniță trebuie apărat cu grijă,\n"
"păziți-vă atât pe dinăuntru, cât și pe dinafară;\n"
"clădiți-vă o apărare cu înțelepciune și în timp.\n"
"Dacă nu vă îngrijiți la momentul cuvenit de aceste lucruri,\n"
"va urma o tristețe mare."

msgid "316"
msgstr ""
"Percepțiile denaturate\n"
"care nasc stări de rușine\n"
"față de ceea ce nu e rușinos\n"
"sau indiferență\n"
"față de ceea ce e rușinos\n"
"pot duce la coborârea ființelor în iad."

msgid "317"
msgstr ""
"Percepțiile denaturate\n"
"care nasc stări de teamă\n"
"față de ceea ce nu e amenințător\n"
"sau indiferență în fața\n"
"a ceea ce e amenințător\n"
"pot duce la coborârea ființelor în iad."

msgid "318"
msgstr ""
"Percepțiile denaturate\n"
"care duc la vederea binelui drept rău\n"
"și a răului drept bine\n"
"duc la dezintegrarea ființelor."

msgid "319"
msgstr ""
"Cel ce vede limpede\n"
"și distinge ceea ce e greșit drept greșit\n"
"și ceea ce e pur drept pur\n"
"poate duce ființele dincolo de obidă."

msgid "chap23"
msgstr "Elefantul"

msgid "320"
msgstr ""
"Așa cum un elefant în luptă\n"
"ține piept săgeților,\n"
"aleg să îndur\n"
"atacurile verbale din partea celorlalți."

msgid "321"
msgstr ""
"Caii dresați cum se cuvine\n"
"pot fi de încredere în mulțimi\n"
"și sunt destinați a fi călăriți de regi.\n"
"Indivizii care s-au instruit să îndure abuzul\n"
"vor fi de prețuit pretutindeni."

msgid "322"
msgstr ""
"Caii sau elefanții dresați cum se cuvine\n"
"sunt impresionanți;\n"
"însă mult mai impresionanți\n"
"sunt indivizii care s-au îmblânzit."

msgid "323"
msgstr ""
"Nu pe un animal bine dresat\n"
"veți putea călări către tărâmul liberării;\n"
"numai purtați de un autocontrol bine instruit\n"
"veți ajunge acolo."

msgid "324"
msgstr ""
"Când este capturat, legat și în călduri,\n"
"elefantul sălbatic este agitat,\n"
"de necontrolat și nu își mănâncă mâncarea.\n"
"Tânjește după pădurea nativă de unde se trage."

msgid "325"
msgstr ""
"Necopt e acela care mănâncă în exces\n"
"și se dedă lenei, iar apoi,\n"
"simțindu-se vlăguit,\n"
"se lăfăie dormind asemenea unui\n"
"porc supradimensionat;\n"
"acest lucru prevestește suferința perpetuă."

msgid "326"
msgstr ""
"Mintea mea, cândva sălbatică\n"
"și de nestăpânit –\n"
"acum o controlez\n"
"așa cum un conducător de elefanți\n"
"controlează cu cârligul său\n"
"un elefant în călduri."

msgid "327"
msgstr ""
"Așa cum un elefant\n"
"se urnește cu hotărâre dintr-o mlaștină,\n"
"înălțați-vă având drept inspirație\n"
"atenția cultivată."

msgid "328"
msgstr ""
"Dacă găsești un companion de nădejde,\n"
"integru și înțelept,\n"
"vei depăși toate pericolele\n"
"în companie veselă și grijulie."

msgid "329"
msgstr ""
"Însă dacă nu poți găsi\n"
"un companion de nădejde,\n"
"integru și înțelept,\n"
"atunci, asemenea unui rege\n"
"ce lasă în urma un tărâm părăsit\n"
"sau unui elefant ce rătăcește de unul singur în pădure,\n"
"înaintează singur."

msgid "330"
msgstr ""
"O viață singuratică inofensivă\n"
"trăită în tihnă,\n"
"asemenea celei a elefantului retras în pădure,\n"
"este mai bună\n"
"decât compania zădarnică a necopților."

msgid "331"
msgstr ""
"Compania potrivită a prietenilor înseamnă bunătate.\n"
"Puținătatea nevoilor înseamnă bunătate.\n"
"Strângerea de virtute\n"
"până la sfârșitul vieții înseamnă bunătate.\n"
"A se lipsi de toată suferința înseamnă bunătate."

msgid "332"
msgstr ""
"A-și deservi cu cinste părinții înseamnă bunătate.\n"
"Ajutorarea celor ce renunță înseamnă bunătate.\n"
"Cinstirea ființelor trezite înseamnă bunătate."

msgid "333"
msgstr ""
"Păstrarea virtuții până la bătrânețe înseamnă bunătate.\n"
"Păstrarea unei credințe autentice înseamnă bunătate.\n"
"Apariția introspecției înseamnă bunătate.\n"
"Renunțarea la rău înseamnă bunătate."

msgid "chap24"
msgstr "Râvnă"

msgid "334"
msgstr ""
"Râvna descătușată\n"
"crește precum o târâtoare în pădure.\n"
"Pierdut în aceasta,\n"
"insul saltă dintr-o parte într-alta\n"
"precum o maimuță de copac în căutare de fructe."

msgid "335"
msgstr ""
"Cultivarea obiceiurilor\n"
"precum râvna și agățatul\n"
"se aseamănă cu fertilizarea\n"
"buruienilor nocive."

msgid "336"
msgstr ""
"Așa cum apa cade de pe o frunză de lotus,\n"
"la fel supărarea se desprinde de cei\n"
"eliberați de râvnă toxică."

msgid "337"
msgstr ""
"Ploile torențiale pot distruge recolte.\n"
"Mara te poate distruge pe tine.\n"
"Astfel te implor –\n"
"smulge toate rădăcinile râvnei.\n"
"Te binecuvântez\n"
"pentru lucrarea aceasta."

msgid "338"
msgstr ""
"Dacă rădăcinile nu sunt smulse,\n"
"un copac crește iar și iar;\n"
"suferința se întoarce la noi\n"
"cât timp râvna rămâne."

msgid "339"
msgstr ""
"Când șiroaiele plăcerii senzuale se reped,\n"
"pot provoca un torent de năzuință."

msgid "340"
msgstr ""
"Șiroaiele râvnei curg peste tot.\n"
"Târâtoarea sălbatică a râvnei\n"
"se întinde și prinde în mreje.\n"
"Prin discernerea târâtoarei cu introspecție,\n"
"îndepărtați-o."

msgid "341"
msgstr ""
"Ființele resimt plăcerea natural;\n"
"însă când plăcerea este contaminată cu râvnă,\n"
"a nu o elibera duce la frustrare,\n"
"iar suferința searbădă urmează."

msgid "342"
msgstr ""
"Captivi în obiceiurile râvnei,\n"
"oamenii intră în panică\n"
"asemenea iepurilor prinși într-o cursă.\n"
"Reacțiile lor fortifică durerea\n"
"capturării."

msgid "343"
msgstr ""
"Captivi în obiceiurile râvnei,\n"
"oamenii intră în panică\n"
"asemenea iepurilor prinși într-o cursă.\n"
"Dacă doriți să vă eliberați de capturare,\n"
"râvna însăși trebuie eliminată."

msgid "344"
msgstr ""
"Sunt inși care au început să parcurgă\n"
"calea către libertate,\n"
"însă pe seama dorinței se întorc la înlănțuire."

msgid "345"
msgstr ""
"Prin înțelepciune,\n"
"devine limpede că a fi ținut după gratii\n"
"sau a fi înlănțuit\n"
"nu limitează la fel de tare\n"
"precum dragostea față de posesii\n"
"și obsesia față de relații."

msgid "346"
msgstr ""
"Aceste legături, deși nu la fel de evidente,\n"
"sunt puternice și ne rețin.\n"
"A renunța la atașamentul\n"
"față de lumea simțurilor\n"
"înseamnă a fi eliberat din temnița râvnei."

msgid "347"
msgstr ""
"Asemenea unui păianjen prins\n"
"în propria pânză,\n"
"o ființă învăluită în râvnă senzuală\n"
"trebuie eliberată de propriile năzuințe\n"
"înainte ca aceasta să poată\n"
"umbla nestingherită."

msgid "348"
msgstr ""
"Renunțați la trecut.\n"
"Renunțați la viitor.\n"
"Renunțați la prezent.\n"
"Cu o inimă liberă,\n"
"traversați pe țărmul\n"
"aflat dincolo de suferință."

msgid "349"
msgstr ""
"Legăturile obiceiurilor și râvnei amăgitoare\n"
"sunt întărite când insul își lasă mintea,\n"
"fără băgare de seamă, să stăruie asupra\n"
"obiectelor dorinței."

msgid "350"
msgstr ""
"Însă cel ce se delectează\n"
"în potolirea gândurilor senzuale,\n"
"alert și cultivând conștiința\n"
"privind aspectele respingătoare ale corpului,\n"
"se eliberează de râvnă\n"
"și dezleagă obiceiurile amăgitoare."

msgid "351"
msgstr ""
"Nu mai este nevoie de îndreptare\n"
"pentru cei care și-au atins țelul;\n"
"sunt eliberați de teamă și năzuință.\n"
"Spinii existenței au fost scoși."

msgid "352"
msgstr ""
"Un călăuzitor este acela care a renunțat\n"
"la toată râvna și la a se agăța de lume;\n"
"care a văzut\n"
"adevărul dincolo de forme,\n"
"și totuși posedă o cunoaștere desăvârșită\n"
"a cuvintelor.\n"
"Se poate spune\n"
"despre o asemenea ființă măreață\n"
"că și-a îndeplinit sarcina."

msgid "353"
msgstr ""
"Nu declar pe altcineva drept dascălul meu,\n"
"căci de unul singur am ajuns\n"
"la înțelepciunea care depășește totul,\n"
"înțelege totul, renunță la tot.\n"
"Sunt pe deplin eliberat de toată râvna."

msgid "354"
msgstr ""
"Darul adevărului este cel mai mare dintre daruri.\n"
"Savoarea realității\n"
"depășește orice altă savoare.\n"
"Încântarea adevărului\n"
"transcende toate încântările.\n"
"Eliberarea de râvnă\n"
"pune capăt tuturor suferințelor."

msgid "355"
msgstr ""
"Bogățiile îi ruinează mai ales pe cei necopți,\n"
"însă nu și pe cei ce caută eternitatea.\n"
"La fel cum nu se gândesc la binele celorlalți\n"
"și provoacă rău,\n"
"necopții se distrug și pe sine."

msgid "356"
msgstr ""
"Buruienile provoacă stricăciuni pe câmpuri.\n"
"Voluptatea provoacă stricăciuni tuturor ființelor.\n"
"Sprijiniți-i pe cei eliberați de voluptate;\n"
"darul va duce la roade însemnate."

msgid "357"
msgstr ""
"Buruienile provoacă stricăciuni pe câmpuri.\n"
"Ura provoacă stricăciuni tuturor ființelor.\n"
"Sprijiniți-i pe cei eliberați de ură;\n"
"darul va duce la roade însemnate."

msgid "358"
msgstr ""
"Buruienile provoacă stricăciuni pe câmpuri.\n"
"Confuzia provoacă stricăciuni tuturor ființelor.\n"
"Sprijiniți-i pe cei eliberați de confuzie;\n"
"darul va duce la roade însemnate."

msgid "359"
msgstr ""
"Buruienile provoacă stricăciuni pe câmpuri.\n"
"Invidia provoacă stricăciuni tuturor ființelor.\n"
"Sprijiniți-i pe cei eliberați de invidie,\n"
"iar roadele vor fi însemnate."

msgid "chap25"
msgstr "Cel ce Renunță"

msgid "360"
msgstr ""
"Este bine a-și abține ochii.\n"
"Este bine a-și abține urechile.\n"
"Este bine a-și abține nasul.\n"
"Este bine a-și abține limba."

msgid "361"
msgstr ""
"Este bine a-și abține corpul.\n"
"Este bine a-și abține vorba.\n"
"Este bine a-și abține mintea.\n"
"Este bine a-și abține tot.\n"
"Cel ce renunță și se abține în toate privințele\n"
"va dobândi liberarea de suferință."

msgid "362"
msgstr ""
"Insul disciplinat cum se cade\n"
"în toate acțiunile,\n"
"liniștit, mulțumit\n"
"și care se delectează\n"
"în contemplare singuratică –\n"
"acesta este cel ce renunță."

msgid "363"
msgstr ""
"E plăcut a auzi cuvintele unuia ce renunță;\n"
"înțelept, neumflat în pene,\n"
"cu mintea liniștită\n"
"și cu vorba reținută\n"
"și cu sensul limpede."

msgid "364"
msgstr ""
"Cel ce își duce veacul în Dhamma,\n"
"care se delectează în Dhamma,\n"
"care contemplă Dhamma,\n"
"care memorează Dhamma,\n"
"acela nu se va abate de la Cale."

msgid "365"
msgstr ""
"A-ți deplânge soarta\n"
"sau a invidia avuțiile altora\n"
"stă în calea liniștii sufletești."

msgid "366"
msgstr ""
"Însă fiind mulțumit\n"
"chiar și cu avuții modeste,\n"
"trăind cu puritate și energic\n"
"te vei bucura de un respect deosebit."

msgid "367"
msgstr ""
"Cei ce renunță cu adevărat\n"
"se gândesc pe deplin la trup-minte\n"
"fără vreo referire la „eu” sau „al meu”\n"
"și nu își doresc ceea ce nu au."

msgid "368"
msgstr ""
"Insul ce renunță\n"
"și își duce veacul cu bunătate pașnică\n"
"și o inimă plină de devotament\n"
"față de învățăturile lui Buddha\n"
"va găsi pace, liniște și exaltare."

msgid "369"
msgstr ""
"Scoate-ți apa din barcă;\n"
"taie-ți legăturile de pasiunile pângăritoare\n"
"ale voluptății și urii;\n"
"neîmpovărat, navighează către liberare."

msgid "370"
msgstr ""
"Insul care\n"
"a tăiat atașamentele brute,\n"
"a tăiat atașamentele subtile,\n"
"care-și cultivă facultățile spirituale\n"
"este cel care găsește eliberarea de decepție."

msgid "371"
msgstr ""
"Aveți grijă!\n"
"Nu neglijați meditația\n"
"și nu permiteți minții să stăruiască\n"
"asupra senzualității\n"
"ca nu cumva să înghițiți fără băgare de seamă\n"
"o bilă roșie și încinsă de fier\n"
"și să vă întrebați: „De ce sufăr?”."

msgid "372"
msgstr ""
"Concentrarea nu apare\n"
"fără înțelegere,\n"
"iar nici înțelegerea nu apare\n"
"fără concentrare.\n"
"Insul care le cunoaște pe ambele\n"
"se apropie de liberare."

msgid "373"
msgstr ""
"O fericire dincolo de exaltarea obișnuită\n"
"este cea resimțită de cei ce renunță\n"
"care s-au retras în singurătate\n"
"cu inima liniștită\n"
"și cu o înțelegere limpede a Căii."

msgid "374"
msgstr ""
"Atunci când cei înțelepți\n"
"trăiesc contemplând\n"
"asupra naturii efemere a\n"
"acestui corp-minte\n"
"și a oricărei existențe condiționate,\n"
"resimt bucurie și încântare\n"
"văzând calea către siguranța firească."

msgid "375"
msgstr ""
"Acesta este atunci începutul\n"
"pentru cel ce renunță care începe instruirea:\n"
"controlează-ți facultățile,\n"
"dedică-te învățăturii,\n"
"caută împăcarea cu sine;"

msgid "376"
msgstr ""
"cultivă compania celor\n"
"care îți susțin aspirațiile\n"
"pentru practica energică a învățăturilor.\n"
"Frumusețea conduitei pure\n"
"condiționează starea de bine deplină,\n"
"ducând la eliberarea completă de remușcări."

msgid "377"
msgstr ""
"Așa cum florile vechi\n"
"cad de pe o plantă de iasomie,\n"
"lasă voluptatea și ura\n"
"să cadă."

msgid "378"
msgstr ""
"Îi numesc „cei pașnici”,\n"
"cu trupul calm, vorba calmă și mintea calmă\n"
"și care s-au descotorosit în profunzime\n"
"de toate obsesiile lumești."

msgid "379"
msgstr ""
"Cercetează-te.\n"
"Examinează-te.\n"
"Acordând atenția corectă\n"
"evaluării de sine,\n"
"vei trăi în tihnă."

msgid "380"
msgstr ""
"Noi suntem cei care ne protejăm;\n"
"noi suntem cu adevărat propriul nostru sălaș;\n"
"cum ar putea sta altfel lucrurile?\n"
"Așadar, cu atenția cuvenită, ne ocupăm de noi\n"
"așa cum un dresor s-ar îngriji de un pursânge."

msgid "381"
msgstr ""
"Un călugăr, o călugăriță care cultivă\n"
"o dispoziție voioasă\n"
"și sunt plini de încredere în Cale\n"
"vor găsi pace, liniște și exaltare."

msgid "382"
msgstr ""
"Cât timp este încă tânăr, cel ce renunță\n"
"și este complet devotat Căii\n"
"luminează lumea\n"
"asemenea lunii care iese din nori."

msgid "chap26"
msgstr "Ființa Măreață"

msgid "383"
msgstr ""
"Îndepărtați cu sârguință\n"
"șiroiul râvnei\n"
"și abandonați năzuințele senzuale;\n"
"cunoscând limitările intrinseci\n"
"ale tuturor lucrurilor formate,\n"
"înțelegeți ceea ce este de necreat."

msgid "384"
msgstr ""
"Toate lanțurile limitării cad la pământ\n"
"pentru cei ce văd cu limpezime\n"
"dincolo de cele două dhamma."

msgid "385"
msgstr ""
"Spun că o ființă este măreață\n"
"atunci când nu stă nici pe țărmul acesta,\n"
"pe țărmul celălalt,\n"
"nici pe vreun alt țărm.\n"
"O asemenea ființă este liberă\n"
"de toate legăturile."

msgid "386"
msgstr ""
"Spun că o ființă este măreață\n"
"atunci când sălășluiește izolată și în tihnă,\n"
"știindu-și inima eliberată\n"
"de toate impuritățile,\n"
"cu sarcina încheiată,\n"
"purificată de toate tendințele compulsive\n"
"și trează."

msgid "387"
msgstr ""
"Soarele strălucește ziua,\n"
"luna strălucește noaptea.\n"
"Însă atât toată ziua, cât și toată noaptea\n"
"Buddha strălucește\n"
"cu o splendoare glorioasă."

msgid "388"
msgstr ""
"Odată cu transformarea răului,\n"
"insul se numește ființă măreață.\n"
"Atunci când trăiește pașnic,\n"
"insul se numește contemplator.\n"
"Odată cu renunțarea la prihănire,\n"
"insul se numește cel ce renunță."

msgid "389"
msgstr ""
"Neluarea revanșei\n"
"este specifică ființelor mărețe.\n"
"Nu se lasă cuprinse de furie.\n"
"Dacă sunt atacate,\n"
"nu le stă în fire să contraatace."

msgid "390"
msgstr ""
"Suferința încetează\n"
"în măsura în care vă eliberați\n"
"de intenția de a face rău.\n"
"Nu există măreție autentică\n"
"acolo unde nu există reținerea furiei."

msgid "391"
msgstr ""
"Insul care se abține de la a face rău\n"
"cu trupul, vorba sau mintea\n"
"se poate numi ființă vrednică."

msgid "392"
msgstr ""
"Devotamentul și respectul\n"
"trebuie oferite celor care ne-au arătat Calea."

msgid "393"
msgstr ""
"Insul nu trebuie considerat a fi\n"
"demn de respect\n"
"pentru că s-a născut sau pentru formarea sa\n"
"sau orice alt semn exterior;\n"
"puritatea și înțelegerea adevărului\n"
"stabilesc valoarea unui ins."

msgid "394"
msgstr ""
"Podoabele voastre exterioare\n"
"și preocupările pseudospirituale\n"
"sunt irelevante dacă pe dinăuntru\n"
"rămâneți neglijenți."

msgid "395"
msgstr ""
"A nu se preocupa de aspectul exterior,\n"
"însă a se dedica cultivării\n"
"intense și neobosite –\n"
"aceasta înseamnă măreția."

msgid "396"
msgstr ""
"Niciun ins nu este nobil\n"
"numai datorită a ceea ce moștenește.\n"
"Nobilitatea provine din curățarea sinelui\n"
"de toate impuritățile și atașamentele."

msgid "397"
msgstr ""
"Pe cel care a tăiat toate funiile\n"
"și a descoperit curajul,\n"
"cel care este mai presus\n"
"de atașamente și pângărire,\n"
"pe acela îl recunosc drept ființă măreață."

msgid "398"
msgstr ""
"Pe cel ce desface legăturile urii,\n"
"dezleagă frânghiile râvnei,\n"
"descuie lacătele perspectivei greșite,\n"
"deschide ușile ignoranței și vede adevărul,\n"
"pe acela îl recunosc drept ființă măreață."

msgid "399"
msgstr ""
"Puterea răbdării\n"
"este tăria ființelor nobile;\n"
"acestea pot fi încătușate,\n"
"pot îndura abuz verbal și bătăi\n"
"fără ranchiună."

msgid "400"
msgstr ""
"Pe cei eliberați de furie,\n"
"disciplinați cu simplitate, virtuoși,\n"
"instruiți corect\n"
"și mai presus de renaștere,\n"
"pe aceia îi numesc ființe mărețe."

msgid "401"
msgstr ""
"Așa cum apa alunecă de pe o frunză de lotus,\n"
"plăcerile senzuale\n"
"nu se prind de o ființă măreață."

msgid "402"
msgstr ""
"Pe cei care cunosc libertatea\n"
"de a fi lăsat deoparte\n"
"povara atașamentului față de corp-minte,\n"
"pe aceia îi numesc ființe mărețe."

msgid "403"
msgstr ""
"Pe cei ce posedă o înțelepciune profundă,\n"
"care văd ce anume este în conformitate cu\n"
"Calea și ce nu este,\n"
"pe cei care au făcut tot ce le stă în putință,\n"
"pe aceia îi numesc ființe mărețe."

msgid "404"
msgstr ""
"Cei eliberați de atașamentul\n"
"fie față de laici, fie față de alții\n"
"care au renunțat,\n"
"și astfel hoinăresc fără dorințe\n"
"sau fără grijă față de siguranța de orice fel\n"
"sunt ființe mărețe."

msgid "405"
msgstr ""
"Cei care au renunțat\n"
"la a folosi forța în relațiile cu alte ființe,\n"
"fie slabe, fie puternice,\n"
"care nici nu omoară,\n"
"nici nu provoacă omorârea,\n"
"aceia se pot numi ființe mărețe."

msgid "406"
msgstr ""
"Cei ce rămân prietenoși printre cei ostili,\n"
"pașnici printre cei agresivi\n"
"și care nu se atașează de lucrurile\n"
"de care alții depind\n"
"sunt ființe mărețe."

msgid "407"
msgstr ""
"Pentru o ființă măreață,\n"
"voluptatea și rea-voința,\n"
"aroganța și îngâmfarea cad\n"
"așa cum chiar și cea mai mică sămânță\n"
"ar cădea de pe vârful unui ac."

msgid "408"
msgstr ""
"Pe cei ce spun adevărul\n"
"și încurajează cu blândețe,\n"
"fără a se întrece cu cineva,\n"
"pe aceia îi numesc ființe mărețe."

msgid "409"
msgstr ""
"Acțiunile unei ființe mărețe sunt pure.\n"
"Ființele mărețe nu își însușesc\n"
"niciodată conștient\n"
"ceea ce aparține altuia."

msgid "410"
msgstr ""
"Inima unei ființe mărețe este liberă.\n"
"Ființele mărețe nu mai tânjesc\n"
"după lucrurile din această lume\n"
"sau din orice altă lume."

msgid "411"
msgstr ""
"Inima unei ființe mărețe este liberă.\n"
"Cu o înțelegere precisă,\n"
"dincolo de îndoială,\n"
"ființele mărețe și-au înfipt bine picioarele\n"
"în tărâmul liberării."

msgid "412"
msgstr ""
"Oricine a depășit\n"
"toate legăturile cu binele și răul,\n"
"este purificat și eliberat de supărare\n"
"trebuie numit o ființă măreață."

msgid "413"
msgstr ""
"Ființele eliberate de năzuință\n"
"și care, asemenea lunii pe un cer fără de nori,\n"
"sunt pure, calme și senine:\n"
"pe acele ființe le numesc mărețe."

msgid "414"
msgstr ""
"Există ființe\n"
"care parcurg drumul greu\n"
"de-a lungul mlaștinii periculoase\n"
"a pasiunilor pângăritoare,\n"
"traversează oceanul decepției\n"
"prin întunericul ignoranței\n"
"și trec dincolo.\n"
"Sunt întărite de contemplare înțeleaptă,\n"
"sigure fără de îndoieli, eliberate;\n"
"aceste ființe sunt cu adevărat mărețe."

msgid "415"
msgstr ""
"O ființă măreață\n"
"este aceea care, abținându-se de la dorințele\n"
"plăcerii senzuale,\n"
"trăiește o viață fără de adăpost\n"
"și se eliberează\n"
"atât de dorința senzuală,\n"
"cât și de devenirea perpetuă."

msgid "416"
msgstr ""
"O ființă măreață\n"
"este aceea care, abținându-se de la orice\n"
"urmă de râvnă,\n"
"trăiește în pribegie\n"
"și se eliberează\n"
"atât de râvnă,\n"
"cât și de devenirea perpetuă."

msgid "417"
msgstr ""
"O ființă măreață\n"
"este aceea care poate vedea dincolo de toate\n"
"delectările evidente,\n"
"precum și de plăcerile subtile\n"
"pentru a se elibera de atașament."

msgid "418"
msgstr ""
"Pe insul care a încetat să urmărească\n"
"plăcerile și neplăcerile,\n"
"liniștit,\n"
"de neclintit de condițiile lumești –\n"
"pe acela îl numesc ființă măreață."

msgid "419"
msgstr ""
"Spun că oricine înțelege pe deplin\n"
"trecerea și reapariția ființelor,\n"
"oricine rămâne conștient,\n"
"neatașat, treaz,\n"
"conștient de acțiunea corectă,\n"
"acela este o ființă măreață."

msgid "420"
msgstr ""
"Starea de după moarte a ființelor mărețe\n"
"este de nedeslușit;\n"
"nu rămâne nicio urmă de pasiune.\n"
"Acestea sunt pure."

msgid "421"
msgstr ""
"Oricine trăiește eliberat\n"
"de obiceiurile agățării\n"
"de trecut, prezent sau viitor\n"
"fără atașamente față de nimic\n"
"este o ființă măreață."

msgid "422"
msgstr ""
"O ființă măreață\n"
"este la fel de netemătoare precum un taur,\n"
"nobilă, puternică, înțeleaptă, sârguincioasă;\n"
"vede dincolo de decepții\n"
"și este curată, atentă și trează."

msgid "423"
msgstr ""
"A înțelege toate dimensiunile\n"
"existențelor trecute,\n"
"a vedea cu acuratețe toate tărâmurile,\n"
"a ajunge la finalul renașterilor,\n"
"a ști cu introspecție\n"
"ceea ce trebuie știut,\n"
"a elibera inima de ignoranță –\n"
"aceasta înseamnă cu adevărat\n"
"a fi fost făcut măreț."
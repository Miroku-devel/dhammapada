msgid "title"
msgstr "الداما بادا"

msgid "chaps"
msgstr "الفصول"

msgid "fontsize"
msgstr "حجم الخط"

msgid "chap1"
msgstr "الثنائيات"

msgid "1"
msgstr "أشكال الحالات الذهنية جميعها مصدرها الذهن، فهي كلها من صنعه؛ لذا فهو الذي يقودها. فإذا تكلم أحد أو قام بفعل بذهن مشوش، تبعته المعاناة Dukkha، تماماً كما تتبع العجلة آثار حافر الثور الذي يسحب العربة."

msgid "2"
msgstr "أشكال الحالات الذهنية جميعها مصدرها الذهن، فهي كلها من صنعه؛ لذا فهو الذي يقودها. فإذا تكلم أحد بذهن نقي تبعته الفرح والبهجة sukha، مثل الظل الذي لا يغادره."

msgid "3"
msgstr "لقد آذاني، لقد عاملني بسوء، لقد أخذ مني أفضل ما عندي، لقد سرق ممتلكاتي ... إلخ. لا يمكن تخفيف مشاعر الكراهية عند أولئك الذين يكونون مثل هذه الأفكار."

msgid "4"
msgstr "لقد آذاني، لقد عاملني بسوء، لقد أخذ مني أفضل ما عندي، لقد سرق ممتلكاتي ... إلخ. يمكن تخفيف مشاعر الكراهية عند أولئك الذين لا يكونون مثل هذه الأفكار."

msgid "5"
msgstr "في واقع الأمر، لا يمكن التخفيف من الكره، من خلال نشر الكره في هذا العالم، بل من خلال نشر الطيبة المحبة. وهذا قانون قديم."

msgid "6"
msgstr "لا يدرك الناس أن الموت محتم عليهم إلا أهل الحكمة منهم. لهذا فهم أبعد الناس بحكمتهم عن الخصومة والشقاق."

msgid "7"
msgstr "من كان ذهنه مشغولاً بالمتع الحسية، وكان غير منضبط في حواسه، وغير معتدل في مأكله، وكسولاً، سوف تغلبه المارا Mara حتماً، وتقتلعه كما تقتلع الرياح العاصفة الشجرة الضعيفة."

msgid "8"
msgstr "من يحافظ على ذهنه واعياً بالأمور المفسدة، ويكون منضبطاً في حواسه، ومعتدلاً في مأكله، متسماً بالنشاط، محافظاً على سلامة اعتقاده وتوقه، فلن تغلبه المارا، كما الجبل لا تهزه الريح العاصفة."

msgid "9"
msgstr "من لم يتخل عن السموم الأخلاقية أو السموم الذهنية (kilesas)، ويتشح بالرداء الأصفر (أي كان من الرهبان)، ويفتقر إلى الانضباط والالتزام، فإنه ليس أهلاً لذلك الرداء الأصفر."

msgid "10"
msgstr "المنضبط والملتزم بالتعاليم، الذي نبذ جميع السموم الذهنية، هو لا شك أهلاً للرداء الأصفر."

msgid "11"
msgstr "أصحاب النظرة الخاطئة، هم الذين لا يروْن الأمور على حقيقتها وفي جوهرها، الذين يعيشون في عالم الزيف والأفكار الخاطئة."

msgid "12"
msgstr "أصحاب النظرة السليمة، هم الذين ينظرون إلى الأمور على حقيقتها. أولئك حتماً يصلون إلى الحقيقة كما هي."

msgid "13"
msgstr "مثلما يتخلل المطر البيت ذا السقف الرديء، كذلك الرغبة الشديدة (rāga) التي تتخلل الذهن الذي لم يتم تهذيبه بتأمل تنمية الهدوء (شماتا Samatha)، والبصيرة (فيباسانا Vipassanā)."

msgid "14"
msgstr "مثلما أن المطر لا يمكنه أن يتخلل البيت المسقوف بعناية، كذلك الرغبة الشديدة لا يمكنها أن تتخلل الذهن الذي تم تهذيبه بعناية، بتأمل تنمية الهدوء والبصيرة."

msgid "15"
msgstr "في حياته كما بعد مماته، يتغم فاعل الأمور الهدامة في كلا الوجودين، فيشعر بالهم ويعاني من الكرب عندما يرى فساد أعماله."

msgid "16"
msgstr "في حياته كما بعد مماته، يبتهج ذاك الذي يقوم بأفعال الفضيلة، فيبتهج في كلا الوجودين. يبتهج ويبتهج كثيراً عندما يرى نقاء أفعاله."

msgid "17"
msgstr "في حياته كما بعد مماته، يتحسر فاعل الأمور الهدامة ويندب: لقد قمت بالأمور الهدامة. ويصيبه عذاب أكبر عندما يُعاد ميلاده في أحد عوالم المعاناة."

msgid "18"
msgstr "في حياته كما بعد مماته، يسعد من يقوم بالفضائل في كلا الوجودين، فيقول بابتهاج: لقد قمت بكل هذه الفضائل. وسوف يبتهج أكثر عندما يُعاد ميلاده في عالم الوجود البهيج (suggati)."

msgid "19"
msgstr "الشخص الذي يقرأ النصوص النقية Tipitaka، أي تعاليم بوذا، ويُهملها، حاله كحال ذلك الراعي الذي يعد الماشية التي يملكها غيره. فمثل هذا الشخص لا نصيب له من حياة التقشف والزهد."

msgid "20"
msgstr "قد يقرأ شخص ما القليل من النصوص النقية (تعاليم بوذا)، لكنه يتدرب بناءً على الدارما، فيقطع الرغبة الشديدة من جذورها، ويقطع الكره والوهم. ويتمتع بالفهم السليم للدارما، وذهنه متحرر من السموم الذهنية، فلا يتعلق بهذا العالم أو بما وراءه. لمثل هذا الشخص نصيب من الحياة الروحانية."

msgid "chap2"
msgstr "الحضور الذهني"

msgid "21"
msgstr "الحضور الذهني هو الطريق إلى اللاموت، وغيابه هو الطريق إلى الموت. فمن تمتع بهذا الحضور لا يموت، أما من افتقدوه فهم أشبه بالأموات."

msgid "22"
msgstr "حين يعي الحكيم ذلك كله، فإنه يبتهج لكونه حاضراً، يبتهج لكونه في عالم النبلاء (ariyas)."

msgid "23"
msgstr "لا يثني الحكيم عن ممارسة تأمل تنمية الهدوء وتأمل تنمية البصيرة. فهو حاضر دائماً، يجتهد بثبات لإدراك النيرفانا.. نيرفانا لا مثيل لها، متحررة من القيود الأربعة."

msgid "24"
msgstr "إذا كان الفرد منتبهاً، حاضر الذهن، نقياً في فكره وكلامه وأفعاله.. وإذا كان يقوم بكل شيء بعناية واهتمام، مقيداً حواسه، كاسباً عيشه بحسب الدارما وهو يقظ. فإنه حينئذ سيذيع صيته."

msgid "25"
msgstr "يجعل ذو الحكمة من نفسه جزيرة مستعصية على الفيضان. وذلك، من خلال المثابرة، والحضور الذهني، والانضباط، والسيطرة على الحواس."

msgid "26"
msgstr "يسلم الأحمق والجاهل نفسيهما للإهمال، أما ذو الحكمة فيصون حضوره الذهني كجوهرة قيمة."

msgid "27"
msgstr "لذلك، على الإنسان ألا يكون مهملاً أو مدمناً على المتع الحسية. فالشخص المتمكن من الحضور الذهني، من خلال ممارسة تأمل تنمية الهدوء وتأمل تنمية البصيرة، يعيش تجربة السعادة القصوى – أي النيرفانا."

msgid "28"
msgstr "عندما يبدد ذو الحكمة الغفلة من خلال الحضور الذهني- وهو من صعد برج الحكمة، وتحرر من الأسى – فإنه ينظر بحزن إلى الكائنات التي تتألم. فمثلما ينظر الواحد من أعلى قمة الجبل نحو أولئك الذين في السهل تحته، كذلك ينظر ذو الحكمة للأمور الدنيوية التي تمثل الحمق والجهل."

msgid "29"
msgstr "ذو الحكمة حاضر ذهنه بين الغافلين، ومنتبه جداً بين أولئك الذين يعيشون في غفوة. وهو بذلك مثل حصان السباق الذي يستمر في عدوه تاركاً خلفه الخيول المتعبة."

msgid "30"
msgstr "من خلال الحضور الذهني، أصبح Magha ملكاً على كائنات الديفا. فالثناء دائماً للحضور، والذم للغفلة."

msgid "31"
msgstr "إن الراهب الذي يجد البهجة في الحضور الذهني، ويرى الخطر في الغفلة، يسير في طريقه كالنار تحرق كل القيود والأغلال، صغيرها وكبيرها."

msgid "32"
msgstr "إن الراهب الذي يجد البهجة في الحضور الذهني، ويرى الخطر في الغفلة لا يمكنه أن يتراجع، فهو بالفعل قريب إلى النيرفانا."

msgid "chap3"
msgstr "الذهن"

msgid "33"
msgstr "الذهن قابل للإثارة وغير ثابت، ومن الصعب السيطرة عليه وضبطه وصونه. وذو الحكمة يدرب ذهنه؛ على غرار صناع السهام، إذ يسوون الأسهم."

msgid "34"
msgstr "كما ترتعش السمكة عندما نخرجها من الماء وتلقى على أرض جافة، كذلك يرتعش الذهن حين يخرج من العالم الحسي ويفر إلى عالم المارا."

msgid "35"
msgstr "من الصعب السيطرة على الذهن، فهو ينطلق ويهبط بسرعة وخفة حيث يجد السرور. فمن المفيد إذن أن تروض الذهن، فالذهن المروض بشكل جيد يجلب السعادة."

msgid "36"
msgstr "من الصعب رؤية الذهن، فهو لطيف في دقته، ينطلق ويهبط حيث يجد السرور. فينبغي على ذي الحكمة إذن أن يصون ذهنه، فالذهن المصون يجلب السعادة."

msgid "37"
msgstr "يجول الذهن بعيداً ويتحرك هنا وهناك وحيداً. فهو غير مادي، يقطن في كهف القلب. أما أولئك الذين يسيطرون على ذهنهم، فيتحررون من قيود المارا."

msgid "38"
msgstr "إذا كان ذهن الشخص غير ثابت، وإذا كان جاهلاً بالدارما الحقيقية، وإذا كان اعتقاده متزعزعاً ومضطرباً، وكذا ثقته وتوقه، فحكمته لن تكتمل أبداً."

msgid "39"
msgstr "إذا كان ذهن الشخص خالياً من الرغبة الشديدة، ولم يكن مبتلى بالكره والغضب، وكان منتبهاً، فلا خطر أمامه."

msgid "40"
msgstr "لأننا نعلم أن هذا الجسم مثل جرة من الصلصال (أي هش)، وحتى نجعل الذهن آمناً (من السموم الذهنية) مثل بلدة حصينة، ينبغي على الواحد منا أن يحارب المارا بسلاح الحكمة. كما ينبغي أن يستمر في صون ذهنه، وألا يشعر بتعلق وتشبث بما ناله."

msgid "41"
msgstr "قريباً سيلقى الجسد خالياً من الوعي في التراب، منبوذاً مثل قطعة خشب لا قيمة لها."

msgid "42"
msgstr "قد يؤذي اللص لصاً ما، وقد يؤذي عدو عدواً ما، لكن الذهن الموجه خطأً تجاه نفسه يتسبب بخطر أعظم بكثير."

msgid "43"
msgstr "لا يمكن لأم أو أب أو أي قريب آخر أن ينفع شخصاً أكثر من ذهنه الموجه بشكل سليم."

msgid "chap4"
msgstr "الزُّهور"

msgid "44"
msgstr "من سيختبر ويُدرك هذه الأرض (أي الجسد)، وعالم الياما (وهو عالم المعاناة الشديدة [نيرایا])، وعالم الحيوان، وعالم الكائنات الواقعة في الفاقة العظيمة، تلك التي تُشكّل عوالم الكائنات التعيسة)، وعالم البشر، وعالم الديفا؟ مَن سيُدرك ويفهم طريق الدارما، الذي شُرح خير شرح، وكأنه الخبير في الأزهار يقطف ويختار؟"

msgid "45"
msgstr "الإنسان النبيل هو الذي سيدرك هذه الأرض وعالم البشر وعالم الديفا. هذا النبيل هو الذي سيُدرك ويفهم طريق الدارما، التي شُرحت خير شرح. مثله مثل الخبير في الأزهار يقطف ويختار."

msgid "46"
msgstr "إن الذي يدرك أنّ هذا الجسد زائل كزَبَد الماء، ويُدرك أنّه غير جوهري كالسراب، سيقطع أسهم أزهار المارا، ولا يراه الموت."

msgid "47"
msgstr "مَن ينغمس [من غير أن يشعر بالاكتفاء] في قطف الأزهار واختيارها، ومَن تعلّق ذهنه بالمتع الحسيّة، يجرفه الموت كما يكتسح الفيضان قرية ذاهلة نائمة."

msgid "48"
msgstr "المنغمس في قطف الأزهار واختيارها، والمتعلّق ذهنه بالمتع الحسّية، يقهره الموت."

msgid "49"
msgstr "كما النحلة التي تجمع الرحيق وتحوم من دون أن تُفسد الزهرة أو لونها أو عبيرها، دَع الراهب [أو الحكيم] يسكن ويتعامل في القرية من دون أن يؤثر في اعتقاد أهلها وتوقهم، أو في كرمهم وثروائهم."

msgid "50"
msgstr "ينبغي ألا ينظر المرء إلى أخطاء الآخرين أو إلى ما يفعلون وما لا يفعلون من أمور بنّاءة أو هدّامة. إنما عليه أن ينظر وحسب إلى ما قام به وما لم يقم به من الأمور البنّاءة أو الهدّامة."

msgid "51"
msgstr "تماماً، كالزهرة زاهية الألوان التي تفتقد العبير فلا تمنح حاملها عطرها، هي كلمات بوذا المنمقة التي تتحلى بالبلاغة في نظمها. فهي لا تُفيد مَن لا يتدرب على الدارما."

msgid "52"
msgstr "كما أنّ الزهرة الجميلة ذات الرائحة الزكيّة تمنح حاملها عطرها، كذلك كلمات بوذا التي تتحلى بالبلاغة في نظمها، تُفيد مَن يتدرب على الدارما."

msgid "53"
msgstr "على الإنسان أن يفعل الكثير من الأعمال البنّاءة، مثلما نحصل على أكاليل الزهور من أكوام الأزهار."

msgid "54"
msgstr "لا يُمكن لعبير الزهور أن ينتشر عكس اتجاه الريح، وكذا رائحة الصندل، أو الياسمين العربي. أما عطر الأخيار فينتشر في كل الاتجاهات، وكذلك عطر ذوي الفضيلة."

msgid "55"
msgstr "هناك عطور الصندل واللوتس والياسمين، لكنّ عطر أصحاب الفضيلة يفوق كل العطور."

msgid "56"
msgstr "رائحة خشب الصندل خفيفة، لكنّ عطر أصحاب الفضيلة هو الأقوى، فتنتشر رائحته حتى في عوالم الديفا."

msgid "57"
msgstr "لا يُمكن لكائنات المارا أن تجد الطريق الذي اتخذه مَن تحلّوا بالفضيلة [السلوك السليم]، والذين يعيشون بحضور ذهني، والذين تحرروا من السموم الذهنية من خلال الإدراك الكامل."

msgid "58"
msgstr "كما أنّ زهرة اللوتس جميلة عَطِرة الرائحة، ولكنّها قد تنمو فوق كومة قُمامة على قارعة الطريق،"

msgid "59"
msgstr "كذلك قد يظهر، ومن كومة قُمامة من الكائنات، تلميذٌ من تلامذة بوذا، يُنير بحكمته إلى المدى البعيد فوق العميان."

msgid "chap5"
msgstr "الأحمق"

msgid "60"
msgstr "طويل هو الليل لمن لم يستنر بعدُ، طويلة هي الرحلة للمسافر المتعب، طويلة هي السمسارا Samsāra للأحمق الجاهل بالدارما الحقيقية."

msgid "61"
msgstr "إذا كان المرء يسعى للرفقة ولم يجد رفيقاً خيراً منه أو مثله، فليعزم على أن يمضي وحيداً، فلا رفقة مع الأحمق."

msgid "62"
msgstr "عندي أبنائي، عندي ثروتي. بهذا الشعور بالتعلّق يُبتلى الأحمق. وفي حقيقة الأمر، ليس للأحمق نفسٌ يملكها، فكيف يكون الأبناء والثروة ملكاً له؟"

msgid "63"
msgstr "قد يكون الأحمق الذي يعرف أنه أحمق حكيماً لمعرفته بذلك. أما الأحمق الذي يظن أنه حكيم، فهو بالفعل يُدعى أحمق."

msgid "64"
msgstr "الأحمق، وإن ارتبط بشخص حكيم طوال حياته، لن يفهم الدارما تماماً، مثله مثل المغرفة التي لا تعرف طعم الحساء."

msgid "65"
msgstr "الشخص الذكي، وإن رافق شخصاً حكيماً للحظة، يفهم الدارما بسرعة، تماماً مثل اللسان الذي يعرف طعم الحساء."

msgid "66"
msgstr "الحمقى يمضون في هذه الحياة مع أنفسهم وكأنها عدوّ، يفتقرون للذكاء فيقومون بكارما سيئة تجني ثماراً مرّة."

msgid "67"
msgstr "لا يكون الفعل بنّاءً إذا المرء ندم على فعله، وبكى وانتحب نتيجة لذلك الفعل."

msgid "68"
msgstr "يكون الفعل بنّاءً إذا لم يندم المرء على فعله، وإذا كان الشخص سعيداً ومسروراً بثمار هذا الفعل."

msgid "69"
msgstr "يظن الأحمق أنّ الفعل الهدّام أو الشرّ حلو كالعسل ما لم تظهر عواقبه، ولكن حين تظهر هذه العواقب، يعاني الأحمق منها."

msgid "70"
msgstr "يظن الأحمق أنّ قيمة الشخص تكمن في الزهد والتقشف في تناول الطعام وحسب. ولكنّ ذلك لا يعادل، ولو جزءاً يسيراً، قيمة أولئك الأشخاص الذين فهموا تعاليم الدارما بالكامل."

msgid "71"
msgstr "لا تنشأ عواقب الفعل الهدّام والشرير فوراً، تماماً كالحليب الطازج الذي لا يتخثر مباشرة. فهي تتبع الأحمق وتُحرقه كجمر الفحم تحت الرماد."

msgid "72"
msgstr "لا ينال الأحمق من صيته وشهرته سوى الأذى، فهما تفسدان فضائله."

msgid "73"
msgstr "يرغب الراهب الأحمق في تحصيل المديح على خصال ليست عنده، وأن تكون له أولوية بين الرهبان، وسلطة في الأديرة، وتبجيل من أشخاص لا صلة لهم به."

msgid "74"
msgstr "يجب أن يعتقد عامة الناس وجميع الرهبان أنني أنا سبب كل ما يحدث. فليطيعوني إذن في كل الأمور صغيرها وكبيرها. هكذا يفكر الأحمق، فيكبر غروره ويزداد طمعه."

msgid "75"
msgstr "هناك طريق يؤدي إلى المنافع المادية، أما الطريق التي تؤدي إلى النيرفانا فمختلفة. وعندما يفهم تلميذ بوذا هذا تمام الفهم، لا يعود يبتهج للمنافع الدنيوية والتبجيل والشهرة، بل يدرّب نفسه على الخلوة والتجرّد وإدراك النيرفانا."

msgid "chap6"
msgstr "الحكيم"

msgid "76"
msgstr "انظر إلى الرجل الحكيم الذي يشير إلى أخطائك وكأنه دليلك إلى كنز دفين. إنّ مصاحبة مثل هذا الحكيم الذي يؤنّب على فعل الخطأ تجلب النفع لا الضرر."

msgid "77"
msgstr "على ذي الحكمة أن يقدّم النصح للحيلولة دون ارتكاب الآخرين الأخطاء. مثل هذا الإنسان يحترمه الأخيار ويكرهه الأشرار."

msgid "78"
msgstr "ينبغي ألّا يربط المرء نفسه برفاق السوء الفاسدين، بل ينبغي أن يرتبط بالأصحاب الأخيار والنبلاء."

msgid "79"
msgstr "من ينهل من الدارما يعش سعيداً بذهن صافٍ، والإنسان الحكيم هو الذي يسعد بالدارما التي يوضّحها النبلاء."

msgid "80"
msgstr "من يصنع قنوات الري يوجه الماء، وصنّاع السهام يسوّون الأسهم، والنجارون يشكلون الخشب، أما الحكماء فيروضون أنفسهم."

msgid "81"
msgstr "كالجبل الصخري لا تهزه الريح، كذلك ذو الحكمة لا يُربكه الملام أو المديح."

msgid "82"
msgstr "كالبحيرة العميقة الصافية الهادئة، يُصبح الحكيم هادئاً بعد استماعه لتعاليم الدارما."

msgid "83"
msgstr "حقاً، يتخلّى من يتحلّى بالفضيلة عن التعلّق بجميع الأشياء، فلا يتحدث برغبة حسّية. وحين يواجه الحكيم بالمتعة أو الأسى، لا يُظهر نشوة أو اكتئاباً."

msgid "84"
msgstr "مَن لا يقوم بالأعمال الهدّامة لأجل نفسه أو الآخرين، ولا يتمنّى البنات والبنين، أو الثراء أو الملك، من خلال الفعل الهدّام، ولا يتمنّى النجاح عبر وسائل ملتوية، مثل هذا المرء يتحلّى بالفضيلة حقاً، وهو حكيم وعادل."

msgid "85"
msgstr "قلّة من الناس من تصل الشاطئ الآخر (أي النيرفانا)، والباقون يمشون جميعاً على ضفة هذا الشاطئ."

msgid "86"
msgstr "أما الذين يتدربون بناءً على الدارما فسيصلون الشاطئ الآخر، بعد اجتياز عالم الموت العسير جداً عبوره."

msgid "87"
msgstr "ذو الحكمة هو من تخلّى عن الحالات السوداوية، فصار لزاماً عليه أن يُنمّي الحالات البنّاءة المشرقة. وهو مَن يترك المساكن المألوفة ليصير بلا مأوى، في خلوة، حيث من الصعب أن يجد الإنسان العادي السرور فيها."

msgid "88"
msgstr "وهناك، عليه أن يسعى إلى السرور بعد أن تخلّى عن المتع الحسّية وعن اشتهاء أي شيء، فيُنقّي نفسه من كل السموم الذهنية في الذهن."

msgid "89"
msgstr "أولئك الذين طوّروا ذهنهم جيداً بعوامل الاستنارة، وتخلّصوا من كل اشتهاء، الذين يبتهجون لتخلّيهم عن التعلّق.. مثل هؤلاء، ومع تخلّصهم من كل السموم والسموم الذهنية Āsava، قد امتلؤوا بنور الحكمة، فصاروا يشعّون نوراً، ونالوا التحرّر في هذا العالم."

msgid "chap7"
msgstr "الأرهات"

msgid "90"
msgstr "الشقاء غير موجود بالنسبة إلى الأرهات Arahat الذي أكمل رحلته، والذي تحرّر من الأسى ومن كل شيء، والذي تخلّى عن كل القيود."

msgid "91"
msgstr "أولئك الذين يتمتّعون بالحضور الذهني يجتهدون ويثابرون، ولا يتعلّقون بحياة المنازل. مثلهم مثل البجع الذي يترك البركة الموحلة، هكذا يتركون حياة المنازل."

msgid "92"
msgstr "لا يَخزنُ الأرهات أي شيء، وعندما يحصل على الطعام يتأمّل فيه جيداً. فغايته التحرّر من الوجود وتحقيق النيرفانا. أما نهاية طريقه فلا يُمكن اقتفاؤها، مثلها مثل مسار الطيور في السماء."

msgid "93"
msgstr "يخلو الأرهات من السموم الأخلاقية، فلا يتعلّق بالطعام، وغايته التحرّر من الوجود وتحقيق النيرفانا. أما نهاية طريقه فلا يُمكن اقتفاؤها، مثلها مثل مسار الطيور في السماء."

msgid "94"
msgstr "إنّ الأرهات الذي يتمتّع بملكات حسّية هادئة مثل الخيل التي روّضها الحوذي جيداً، وهو خالٍ من الكبر والسموم الأخلاقية. مثل هذا الأرهات تقدّره كائنات الديفا."

msgid "95"
msgstr "مثل الأرض، يتحلّى الأرهات بالصبر فلا يُستثار غضباً. وهو ثابت لا تشوبه مباهج الحياة أو نوازلها أو تثير اضطرابه. وهو هادئ ونقي مثل البحيرة الصافية غير العكرة. لمثل هذا الأرهات لن يكون هناك تكرار للميلاد."

msgid "96"
msgstr "الأرهات هادئ في ذهنه وهادئ في كلامه، وكذا في أفعاله. وهو يعرف الدارما بالفعل، خالٍ من السموم الذهنية، لا تشوبه مباهج الحياة ونوازلها ولا تُثير اضطرابه."

msgid "97"
msgstr "ذلك الذي حقّق الإدراك الكامل وتحرّر من الإيمان الأعمى والمتذاجة، والذي أدرك النيرفانا، والذي قطع كل ما يربطه بهذا العالم واحتمالات دائرة إعادة الميلاد، والذي أنهى جميع عواقب الأفعال البنّاء منها والهدّام، والذي تخلّص من كل رغباته، هو بالفعل أنبل الناس."

msgid "98"
msgstr "في القرية أو الغابة، في الوادي أو على التلّة، حيثما يعيش الأرهات يحلّ السرور."

msgid "99"
msgstr "الغابات تجلب البهجة، لكنّ المتشبّثين بالعالم لا يجدون فيها بهجة. فقط أولئك الذين تخلّصوا من الرغبة الشديدة والاشتهاء يجدون البهجة فيها، لأنهم لا يسعون إلى المتع الحسّية."

msgid "chap8"
msgstr "الآلاف"

msgid "100"
msgstr "كلمة واحدة مفيدة، يسكن المرء لسماعها، خير من ألف كلمة بلا فائدة، وغير مرتبطة بإدراك النيرفانا."

msgid "101"
msgstr "عبارة واحدة مفيدة، يسكن المرء لسماعها، خير من ألف عبارة بلا فائدة، وغير مرتبطة بإدراك النيرفانا."

msgid "102"
msgstr "قراءة عبارة واحدة من تعاليم الدارما، يسكن المرء لسماعها، خير من قراءة مئات العبارات غير المرتبطة بإدراك النيرفانا، ولا فائدة منها."

msgid "103"
msgstr "قد ينتصر المرء على ألف رجل في ألف معركة، غير أن أعظم المنتصرين هو من ينتصر على نفسه."

msgid "104"
msgstr "أن تنتصر على أعدائك الداخليين خير من أن تنتصر على أعدائك الخارجيين."

msgid "105"
msgstr "فمن انتصر داخلياً لن يتمكن من هم خارجه أن ينتصروا عليه، حتى ولو كانوا من كائنات الديفا أو المارا."

msgid "106"
msgstr "قد يقدم المرء العطايا شهرياً، بآلاف القطع النقدية، ولمدة مئة عام. لكن خير له من ذلك كله أن يُبجل لحظة واحدة راهباً أو متدرباً على تنمية البصيرة."

msgid "107"
msgstr "قد يتعهد العديد من الناس النار المقدسة في الغابة، ولكن لو أظهر المرء التبجيل للراهب لحظة واحدة، لكان ذلك حقاً أفضل من مئة عام في تقديم الأضاحي."

msgid "108"
msgstr "حتى ينال الخير والفضيلة، قد يقوم المرء في هذا العالم، طوال السنة، بعطايا كثيرة أو قليلة، كأضاحٍ. لكن هذه العطايا جميعها لا تعادل رُبع الخير الذي يُمكن أن يناله من تبجيل النبلاء، الذين يسيرون على الطريق السليم."

msgid "109"
msgstr "الإنسان الذي يُقدر ويُكرم أولئك الأكبر سناً والأكثر فضيلة، يغنم أربع منافع: طول العمر، والجمال، والسعادة، والقوة."

msgid "110"
msgstr "يوم واحد من حياة ذي الفضيلة، المجتهد في ممارسة تنمية الهدوء وتأمل البصيرة، خير من مئة سنة من حياة الشخص غير السوي، الذي لا يُسيطر على حواسه."

msgid "111"
msgstr "يوم واحد في حياة إنسان حكيم، يجتهد في ممارسة تأمل تنمية الهدوء وتأمل تنمية البصيرة، خير من مئة سنة في حياة إنسان جاهل لا يُسيطر على حواسه."

msgid "112"
msgstr "يوم واحد من حياة الإنسان المجتهد، بكل جِد ونشاط، في ممارسة تنمية الهدوء وتأمل البصيرة، خير من مئة سنة من حياة الشخص البليد الكسول، الذي لا يُسيطر على حواسه."

msgid "113"
msgstr "يوم واحد من حياة الإنسان المدرك لنشوء وزوال المكونات الخمسة، خير من مئة سنة من حياة الشخص الذي لا يُدرك ذلك."

msgid "114"
msgstr "يوم واحد من حياة الإنسان المدرك للنيرفانا خير من مئة سنة من حياة الشخص الذي لا يُدركها."

msgid "115"
msgstr "يوم واحد من حياة الإنسان الذي يفهم الدارما النبيلة خير من مئة سنة من حياة الشخص الذي لا يفهمها."

msgid "chap9"
msgstr "الشر"

msgid "116"
msgstr "سارِع للقيام بالأفعال البنّاءة، وامنع ذهنك عن الأفعال الهدّامة. إذا تباطأ المرء في القيام بالأفعال البنّاءة، مال ذهنه نحو الأفعال الهدّامة."

msgid "117"
msgstr "إذا قام المرء بفعل هدّام، فلا ينبغي له أن يكرره، ولا ينبغي له أن يبتهج به. فتراكم الأفعال الهدّامة يؤدّي إلى المعاناة."

msgid "118"
msgstr "إذا قام المرء بفعل بنّاء، فليكرره، وليبتهج به. فتراكم الأفعال البنّاءة يؤدّي إلى السعادة."

msgid "119"
msgstr "حتى مَن يقوم بفعل هدّام، يرى نصيباً من الخير ما لم تنضج ثمار أفعاله الهدّامة. ولكن حين تنضج تلك الثمار، حينئذٍ يرى عواقب أفعاله الهدّامة."

msgid "120"
msgstr "حتى مَن يقوم بفعل بنّاء، يرى نصيباً من المعاناة ما لم تنضج ثمار أفعاله البنّاءة. ولكن حين تنضج تلك الثمار، يرى عواقب أفعاله البنّاءة."

msgid "121"
msgstr "لا تستهن بالفعل الهدّام مهما كان بسيطاً، ولا تقل: لن يأتيني شرّ منه. فمثلما تمتلئ الجرة بقطرات الماء المتساقطة، يمتلئ الأحمق بالأفعال الهدّامة حتى لو جمعها شيئاً فشيئاً."

msgid "122"
msgstr "لا تستهن بالفعل البنّاء مهما كان بسيطاً، ولا تقل: لن يأتيني نفع منه. فمثلما تمتلئ الجرة بقطرات الماء المتساقطة، يمتلئ الحكيم بالأفعال البنّاءة حتى لو جمعها شيئاً فشيئاً."

msgid "123"
msgstr "كما يتجنّب التاجر الذي يحمل الكثير من الثروات وليس معه سوى حراسة بسيطة طريقاً خطراً، وكما يتجنّب المرء السمّ، هكذا ينبغي تجنّب الأفعال الهدّامة."

msgid "124"
msgstr "إذا لم يكن في اليد جرح، يُمكن للمرء أن يحمل السمّ بيده، فالسمّ لا ينفذ من خلال الجلد السليم. وبالمثل، لا يوجد فعل هدّام لمَن لا يقوم به."

msgid "125"
msgstr "مَن يؤذي إنساناً بريئاً لا يضمر سوءاً، ونقياً لا تشوبه شائبة، فإنّ عاقبة فعله الهدّام سترتدّ عليه، تماماً كالغبار الذي يُرمى عكس اتجاه الريح."

msgid "126"
msgstr "بعضهم يُولدون من رحم امرأة، وفاعلو الأفعال الهدّامة يُعاد ميلادهم في عوالم المعاناة، وفاعلو الأفعال البنّاءة يُعاد ميلادهم في عوالم السعادة، أما مَن تحرروا من السموم الذهنية فيبلغون النيرفانا."

msgid "127"
msgstr "ليس في السماء، ولا في وسط المحيط، ولا في شقوق الجبال، ولا في أي مكان في هذا العالم، مَن يُمكنه الهروب من عواقب أفعاله الهدّامة."

msgid "128"
msgstr "ليس في السماء، ولا في وسط المحيط، ولا في شقوق الجبال، ولا في أي مكان في هذا العالم، مَن لا يغلبه الموت."

msgid "chap10"
msgstr "العقاب"

msgid "129"
msgstr "جميع الكائنات تخاف من العقاب، وجميع الكائنات تخاف من الموت. لذا، فليضع المرء نفسه مكان الآخرين، ولا يقتل أو يتسبب في قتل أحد."

msgid "130"
msgstr "جميع الكائنات تخاف من العقاب، والحياة عزيزة على الجميع. لذا، فليضع المرء نفسه مكان الآخرين، ولا يقتل أو يتسبب في قتل أحد."

msgid "131"
msgstr "مَن يؤذي الكائنات التي تنشد السعادة بفعله الهدّام، طمعاً في تحقيق سعادته، لن يجد السعادة بعد مماته."

msgid "132"
msgstr "مَن لا يؤذي الكائنات التي تنشد السعادة بفعله الهدّام، طمعاً في تحقيق سعادته، سيجد السعادة بعد مماته."

msgid "133"
msgstr "لا تتحدث بخشونة مع أحد، فمَن تتحدث إليهم قد يردّون عليك بالمثل. حقاً، إنّ الحديث الغاضب مؤلم، وقد يرتدّ إليك العقاب بسببه."

msgid "134"
msgstr "إذا كنت هادئاً كالجرس المحطم، فقد حققت النيرفانا، ولن تجد في نفسك خصومة أو شقاقاً."

msgid "135"
msgstr "مثلما يسوق الراعي الماشية بعصاه نحو المرعى، كذلك يسوق الكِبر والموت حياة الكائنات."

msgid "136"
msgstr "عندما يقوم الأحمق بالفعل الهدّام، فإنه لا يُدرك عواقبه. لكنّ فاعل الأفعال الهدّامة يحترق بعواقب أفعاله، تماماً كمن تحرقه النار."

msgid "137"
msgstr "مَن يعاقب أو يؤذي مَن لا يستحق العقاب ولا يحمل ضغينة، فسوف يواجه بسرعة واحدة من هذه الحالات العشر:"

msgid "138"
msgstr "معاناة شديدة، أو فاقة، أو إصابة في الجسد، أو مرض شديد، أو فقدان العقل،"

msgid "139"
msgstr "أو غضب الحاكم، أو اتهام خطير، أو فقدان الأقارب، أو دمار الثروة،"

msgid "140"
msgstr "أو حريق يلتهم بيته. وبعد مماته، يُعاد ميلاده في عوالم المعاناة الشديدة."

msgid "141"
msgstr "لا المشي عارياً، ولا تلبيد الشعر، ولا الصيام، ولا النوم على الأرض، ولا التلطخ بالتراب، ولا القرفصاء، يُمكنها أن تُنقي المرء الذي لم يتجاوز الشكّ."

msgid "142"
msgstr "حتى لو كان المرء يتزيّن بالثياب، ولكنه هادئ، ومسيطر على حواسه، ومستقر في الفضيلة، ونقي، ولا يؤذي أي كائن، فهو بحقّ براهمن، وهو بحقّ ناسك، وهو بحقّ راهب."

msgid "143"
msgstr "هل هناك في هذا العالم إنسان يمنعه الحياء من ارتكاب الأفعال الهدّامة، فلا يطاله اللوم، تماماً كما يتجنب الحصان الأصيل السوط؟"

msgid "144"
msgstr "كالحصان الأصيل الذي يلمسه السوط، كُن مجتهداً ومفعماً بالرهبة (تجاه السمسارا). ومن خلال الإيمان، والفضيلة، والجهد، والتركيز، وفهم الدارما، والتمتع بالمعرفة والسلوك السليم، والحضور الذهني، اترك خلفك هذه المعاناة العظيمة."

msgid "145"
msgstr "من يصنع قنوات الري يوجه الماء، وصنّاع السهام يسوّون الأسهم، والنجارون يشكلون الخشب، أما الحكماء فيروضون أنفسهم."

msgid "chap11"
msgstr "الشيخوخة"

msgid "146"
msgstr "لماذا الضحك؟ ولماذا الابتهاج، بينما هذا العالم يحترق دائماً؟ وأنتم الذين يلفكم الظلام، ألا تبحثون عن النور؟"

msgid "147"
msgstr "انظر إلى هذا الجسد المزيّن، فهو كومة من القروح، ومجموعة من الأجزاء، ومحل للأمراض، وفيه الكثير من التصورات والأفكار، فليس له ثبات أو دوام."

msgid "148"
msgstr "هذا الجسد يبلى بمرور الزمن، وهو وكر للأمراض، وسريع العطب. فهذا الهيكل العفن يتداعى، ونهاية الحياة هي الموت."

msgid "149"
msgstr "هذه العظام الرمادية، التي تشبه القرع المطروح في الخريف، أيّ بهجة في النظر إليها؟"

msgid "150"
msgstr "هذا الجسد مبني من عظام، مكسو بلحم ودم، وفيه يكمن الهرم، والموت، والكبر، والرياء."

msgid "151"
msgstr "حتى عربات الملوك المزينة تبلى، وكذلك هذا الجسد يدركه الهرم. أما الدارما التي يتحلى بها الأخيار فلا تهرم أبداً، فهكذا يخبر الأخيار بعضهم بعضاً."

msgid "152"
msgstr "الإنسان قليل العلم يهرم مثل الثور؛ يزداد لحمه، ولكن لا تزداد حكمته."

msgid "153"
msgstr "عبر رحلة طويلة من إعادات الميلاد، بحثتُ عن بنّاء هذا البيت، فلم أجده. وتكرار الميلاد معاناة."

msgid "154"
msgstr "يا بنّاء البيت، لقد رأيتك الآن، ولن تبني هذا البيت ثانية؛ فقد تحطمت كل أضلاعك، وانكسرت دعامة بيتك. والآن، حقق ذهني النيرفانا، ووصلتُ إلى نهاية الرغبة الشديدة."

msgid "155"
msgstr "أولئك الذين لم يعيشوا حياة الزهد في شبابهم، ولم يجمعوا الثروات، هم مثل طيور البلشون الهرمة التي تقف حزينة في بركة تخلو من الأسماك."

msgid "156"
msgstr "أولئك الذين لم يعيشوا حياة الزهد في شبابهم، ولم يجمعوا الثروات، يستلقون الآن كالأقواس المحطمة، يتحسرون على ما فاتهم."

msgid "chap12"
msgstr "النفس"

msgid "157"
msgstr "إذا أدرك المرء أهمية نفسه، فعليه أن يصونها ويحميها بعناية. وعلى ذي الحكمة أن يظل متيقظاً في واحدة من فترات العمر الثلاث (الشباب، أو الكهولة، أو الشيخوخة)."

msgid "158"
msgstr "على المرء أولاً أن يوجه نفسه نحو السلوك القويم، ومن ثم ينصح الآخرين. فبذلك لا يطاله اللوم."

msgid "159"
msgstr "إذا قام المرء بتدريب نفسه كما ينصح الآخرين، وحقق السيطرة الكاملة عليها، فإنه حينئذٍ يستطيع تدريب الآخرين. فحقيقة الأمر أن السيطرة على النفس هي الأصعب."

msgid "160"
msgstr "المرء سيد نفسه، فمن غيره يكون سيداً له؟ فمن خلال السيطرة التامة على النفس، يحقق المرء السيادة التي يصعب تحقيقها."

msgid "161"
msgstr "الفعل الهدّام الذي يقوم به الأحمق، والنابع منه، والمتسبب فيه، يسحقه تماماً كما يحطم الألماسُ الحجرَ الصلد."

msgid "162"
msgstr "الشخص الذي يتسم بسلوك سيئ للغاية، كاللبلاب الذي يلتف حول شجرة فيخنقها، فإنه يفعل بنفسه تماماً ما يتمناه له عدوه."

msgid "163"
msgstr "من السهل القيام بالأفعال الهدّامة الضارة بالنفس، أما القيام بالأفعال البنّاءة والنافعة فهو الصعب جداً."

msgid "164"
msgstr "الأحمق الذي يزدري تعاليم الأرهات والنبلاء الذين يعيشون وفقاً للدارما، بسبب وجهات نظره الخاطئة، فإنه يجني ثماراً مرّة تدمره، تماماً كفاكهة القصب التي تنمو لتقتل النبتة نفسها."

msgid "165"
msgstr "المرء يقوم بالفعل الهدّام بنفسه، وبنفسه يتلوث. وبالفعل البنّاء يترك المرء الفعل الهدّام، وبنفسه يتطهر. فالنقاء وعدم النقاء يعتمدان على الشخص نفسه، ولا يمكن لأحد أن يطهر أحداً آخر."

msgid "166"
msgstr "لا ينبغي للمرء أن يهمل مصلحته الروحية لأجل مصلحة الآخرين، مهما كانت عظيمة. وحين يدرك المرء مصلحته الروحية، عليه أن يسعى جاهداً لتحقيق الغاية القصوى."

msgid "chap13"
msgstr "العالم"

msgid "167"
msgstr "لا تتبع أساليب الحياة الوضيعة، ولا تعش في غفلة، ولا تتبع وجهات النظر الخاطئة، ولا تكن ممن يطيل أمد بقائه في هذا العالم (أي السمسارا)."

msgid "168"
msgstr "كن منتبهاً ولا تكن غافلاً. اتبع الدارما وعش في استقامة. فمن يتبع الدارما يعش سعيداً في هذا العالم وفي العالم الآخر."

msgid "169"
msgstr "اتبع الدارما وعش في استقامة، ولا تعش في اعوجاج. فمن يتبع الدارما يعش سعيداً في هذا العالم وفي العالم الآخر."

msgid "170"
msgstr "انظر إلى هذا العالم كفقاعة ماء، وانظر إليه كسراب. فمن ينظر إلى العالم بهذه الطريقة لا يراه ملك الموت."

msgid "171"
msgstr "تعالوا وانظروا إلى هذا العالم، فهو مثل عربة الملوك المزينة. فبينما يغرق الحمقى فيه، لا يجد الحكماء أي تعلق به."

msgid "172"
msgstr "الشخص الذي كان غافلاً في السابق، ثم صار الآن منتبهاً وحاضر الذهن، فإنه ينير هذا العالم كما ينير القمر ليلة البدر حين يخرج من خلف السحاب."

msgid "173"
msgstr "الشخص الذي يمحو أفعاله الهدّامة من خلال القيام بالأفعال البنّاءة، فإنه ينير هذا العالم كما ينير القمر ليلة البدر حين يخرج من خلف السحاب."

msgid "174"
msgstr "هذا العالم يلفه الظلام، وقليلون هم الذين يبصرون فيه. وقليلون هم الذين يذهبون إلى عالم السعادة، مثل الطيور التي تنجو من شباك الصياد."

msgid "175"
msgstr "تطير طيور البجع في مسار الشمس، ويطير الحكماء في الهواء بقدراتهم الروحية. والحكماء الذين هزموا المارا وجنوده، يرحلون من هذا العالم (إلى النيرفانا)."

msgid "176"
msgstr "الشخص الذي ينتهك قانون الدارما، ويتحدث بالكذب، ويزدري العالم الآخر، لا يوجد فعل هدّام يعجز عن القيام به."

msgid "177"
msgstr "حقاً، البخلاء لا يذهبون إلى عوالم السعادة، والحمقى لا يمدحون العطاء. أما الحكيم فيبتهج بالعطاء، ولذلك يسعد في العالم الآخر."

msgid "178"
msgstr "إنّ ثمرة بلوغ مرتبة الداخل في التيار (Sotāpatti)، وهي أولى مراحل الاستنارة، أفضل من السيادة على الأرض، وأفضل من الذهاب إلى عوالم السعادة، وأفضل من السيادة على العوالم كلها."

msgid "chap14"
msgstr "بوذا"

msgid "179"
msgstr "من لا يمكن هزيمة انتصاره (على الرغبة الشديدة)، والذي لم يتبعه أحد من هذا العالم؛ أي طريق ستسلك لتقتفي أثر بوذا ذا العلم اللامتناهي، والذي لا يترك خلفه أثراً؟"

msgid "180"
msgstr "من لا توجد لديه رغبة شديدة تضلله وتجره إلى الوجود ثانية؛ أي طريق ستسلك لتقتفي أثر بوذا ذا العلم اللامتناهي، والذي لا يترك خلفه أثراً؟"

msgid "181"
msgstr "حتى كائنات الديفا تغبط الحكماء الذين كرسوا أنفسهم لممارسة تأمل تنمية الهدوء وتأمل تنمية البصيرة، والذين يبتهجون بالخلوة من الرغبات، والذين حققوا الاستنارة والحضور الذهني."

msgid "182"
msgstr "من الصعب أن يولد المرء إنساناً، ومن الصعب أن يعيش حياة فانية، ومن الصعب أن يستمع للدارما الحقيقية، ومن الصعب جداً ظهور البوذا."

msgid "183"
msgstr "عدم القيام بجميع الأفعال الهدامة، والقيام بجميع الأفعال البناءة، وتطهير الذهن (من السموم الذهنية)؛ هذه هي تعاليم البوذات."

msgid "184"
msgstr "الصبر هو أعلى درجات الزهد والتقشف، والنيرفانا هي الغاية القصوى؛ هكذا يقول البوذات. فالذي يؤذي الآخرين ليس بناسك، والذي يضطهد الآخرين ليس براهب."

msgid "185"
msgstr "عدم الشتم، وعدم الإيذاء، والالتزام بالقواعد الأساسية للرهبان، والاعتدال في الأكل، والسكن في مكان منعزل، والمواظبة على ممارسة التأمل؛ هذه هي تعاليم البوذات."

msgid "186"
msgstr "لا يمكن إشباع الرغبات حتى لو أمطرت السماء قطعاً نقدية ذهبية. فالمتع الحسية لا تعطي إلا القليل من السرور والكثير من المعاناة؛ والحكيم يدرك ذلك."

msgid "187"
msgstr "حتى في المتع الإلهية (في عوالم السعادة)، لا يجد تلميذ بوذا الكامل الاستنارة أي بهجة. فهو لا يجد بهجته إلا في إنهاء الرغبة الشديدة."

msgid "188"
msgstr "يلجأ الناس الذين أصابهم الخوف إلى الجبال، والغابات، والحدائق، والأشجار، والأضرحة كملجأ لهم."

msgid "189"
msgstr "لكن هذا ليس بالملجأ الآمن، وليس بالملجأ الأسمى. فمن يلجأ لهذه الأماكن لا يتحرر من جميع أشكال المعاناة."

msgid "190"
msgstr "أما من يلجأ لبوذا، وللدارما، وللسانغا (أي جماعة الرهبان)، فإنه يدرك بحكمته الحقائق الأربع النبيلة."

msgid "191"
msgstr "المعاناة، وسبب المعاناة، والتحرر من المعاناة، والطريق الثماني النبيل الذي يقود إلى التحرر من المعاناة."

msgid "192"
msgstr "هذا هو الملجأ الآمن، وهذا هو الملجأ الأسمى. فمن يلجأ إلى هذا الملجأ يتحرر من جميع أشكال المعاناة."

msgid "193"
msgstr "قد تظن أن الولاء هو مجرد تقديم الزهور، لكن لا شيء يفوق البهجة التي يحصل عليها بوذا من خلال ممارسة الدارما بناءً على الدارما."

msgid "194"
msgstr "مبارك هو ظهور البوذات، ومبارك هو سماع الدارما الحقيقية، ومباركة هي الوحدة بين الرهبان، ومباركة هي حياة الرهبان في وئام."

msgid "195"
msgstr "من يبدي التبجيل لمن يستحقون التبجيل، كالبوذات أو تلامذتهم الذين تخلصوا من السموم الذهنية، والذين تجاوزوا العقبات الروحية، وتخلصوا من الأسى والانتحاب."

msgid "196"
msgstr "من يبدي التبجيل لمثل هؤلاء الذين حققوا السلام والتحرر من الخوف، فإن ميزة تبجيله لا يمكن حصرها."

msgid "chap15"
msgstr "السعادة"

msgid "197"
msgstr "حقاً، نحن نعيش بسعادة عندما لا نضمر الكره تجاه من يكرهوننا. فبين أولئك الذين يضمرون الكره، نحن نعيش بلا كره."

msgid "198"
msgstr "حقاً، نحن نعيش بسعادة وبصحة نفسية جيدة بين أولئك المعتلين نفسياً. فبين أولئك المعتلين نفسياً، نحن نعيش بصحة نفسية جيدة."

msgid "199"
msgstr "حقاً، نحن نعيش بسعادة عندما نكون غير متطلعين لامتلاك المتع الحسية بين المتطلعين لامتلاكها. فبين أولئك المتطلعين لامتلاكها، نحن نعيش غير متطلعين إليها."

msgid "200"
msgstr "حقاً، نحن نعيش بسعادة بالغة عندما لا يكون لدينا ما يربطنا بهذا العالم. فنحن نقتات على البهجة مثل كائنات الأبهاسارا."

msgid "201"
msgstr "الانتصار يولد الكره، فالمهزوم يعيش في معاناة. أما من حقق السلام، فإنه يعيش بسعادة بعد أن تخلص من مشاعر الانتصار والهزيمة."

msgid "202"
msgstr "لا توجد نار مثل نار الشهوة، ولا يوجد شر مثل الكره، ولا توجد معاناة مثل المكونات الخمسة (للجسد والذهن)، ولا توجد سعادة تفوق النيرفانا."

msgid "203"
msgstr "الجوع هو أشد الأمراض، والمكونات الخمسة هي أعظم المعاناة. ومن يدرك هذه الحقيقة كما هي، يدرك أن النيرفانا هي السعادة القصوى."

msgid "204"
msgstr "الصحة هي أعظم مكسب، والقناعة هي أعظم ثروة، والثقة هي أعظم قريب، والنيرفانا هي السعادة القصوى."

msgid "205"
msgstr "من تذوق طعم الخلوة والسكينة، وتذوق طعم الدارما، فإنه يتحرر من الخوف والسموم الذهنية."

msgid "206"
msgstr "رؤية النبلاء تجلب السعادة، والعيش معهم سعادة دائمة. والإنسان يسعد دائماً عندما لا يرى الحمقى."

msgid "207"
msgstr "من يمشي في صحبة الحمقى يندم طويلاً، فصحبة الحمقى مؤلمة كصحبة العدو. أما صحبة الحكيم فمبهجة كلقاء الأقارب."

msgid "208"
msgstr "لذا، اتبع الحكيم، والذكي، والعالم، والصبور، والملتزم بمهامه الروحية، والنبيل. اتبع مثل هذا الإنسان الحكيم كما يتبع القمر مسار النجوم."

msgid "chap16"
msgstr "المودة"

msgid "209"
msgstr "الشخص الذي ينشغل بما لا ينفعه، ويهمل ما فيه صلاحه، والذي يتخلى عن غايته الروحية وينغمس في المتع الحسية، فإنه سيغبط حتماً أولئك الذين اجتهدوا في ممارسة التأمل."

msgid "210"
msgstr "لا تربط نفسك بمن تحبهم حباً جماً، ولا بمن تبغضهم. فعدم رؤية من تحبهم معاناة، ورؤية من تبغضهم معاناة أيضاً."

msgid "211"
msgstr "لذا، لا تجعل قلبك يتعلق بشيء أو بشخص؛ ففراق من تعلقت بهم مؤلم. أما أولئك الذين ليس لديهم ما يحبونه أو يكرهونه، فلا توجد لديهم قيود."

msgid "212"
msgstr "من المودة ينشأ الأسى، ومن المودة ينشأ الخوف. أما من تحرر من المودة فلا يوجد لديه أسى، فمن أين يأتي الخوف؟"

msgid "213"
msgstr "من الحب ينشأ الأسى، ومن الحب ينشأ الخوف. أما من تحرر من الحب فلا يوجد لديه أسى، فمن أين يأتي الخوف؟"

msgid "214"
msgstr "من المتع الحسية ينشأ الأسى، ومن المتع الحسية ينشأ الخوف. أما من تحرر من المتع الحسية فلا يوجد لديه أسى، فمن أين يأتي الخوف؟"

msgid "215"
msgstr "من الشهوة ينشأ الأسى، ومن الشهوة ينشأ الخوف. أما من تحرر من الشهوة فلا يوجد لديه أسى، فمن أين يأتي الخوف؟"

msgid "216"
msgstr "من الرغبة الشديدة ينشأ الأسى، ومن الرغبة الشديدة ينشأ الخوف. أما من تحرر من الرغبة الشديدة فلا يوجد لديه أسى، فمن أين يأتي الخوف؟"

msgid "217"
msgstr "من يتحلى بالفضيلة والبصيرة، ويهتدي بالدارما، ويدرك الحقيقة، ويقوم بواجباته الروحية؛ فإنه يكون محبوباً من الجميع."

msgid "218"
msgstr "من يطمح للوصول إلى النيرفانا، ومن لديه ذهن متقد، ومن لا يرتبط ذهنه بالمتع الحسية؛ فإنه يُدعى الذاهب عكس التيار (uddhamsoto)."

msgid "219"
msgstr "عندما يعود المسافر بأمان من مكان بعيد بعد غياب طويل، فإن أقاربه وأصدقاءه يستقبلونه بفرح وسرور."

msgid "220"
msgstr "وبالمثل، عندما يرحل من قام بالأعمال البناءة من هذا العالم إلى العالم الآخر، فإن أعماله البناءة تستقبله كما يستقبل الأقارب حبيبهم العائد."

msgid "chap17"
msgstr "الغضب"

msgid "221"
msgstr "تخلَّ عن الغضب، وانبذ الكبر، وتجاوز كل القيود. فالأسى لا يطال من لا يتعلق بالجسد والذهن (الناماروبا)، ومن لا يملك شيئاً."

msgid "222"
msgstr "من يكبح غضبه المتصاعد كما يكبح الحوذي العربة المسرعة، هو من أدعوه حوذياً حقاً، أما الآخرون فهم مجرد ممسكين بالأعنة."

msgid "223"
msgstr "اهزم الغضب باللاغضب (بالطيبة)، واهزم الشر بالخير، واهزم البخل بالعطاء، واهزم الكذب بالحقيقة."

msgid "224"
msgstr "على المرء أن يقول الحقيقة، وألا يغضب، وأن يعطي ولو القليل لمن يسأله. فمن خلال هذه الخصال الثلاث، يذهب المرء إلى عالم الديفا."

msgid "225"
msgstr "الحكماء الذين لا يؤذون أحداً، والذين يسيطرون دائماً على أفعالهم، يذهبون إلى الحالة الأبدية (النيرفانا)، حيث لا وجود للأسى."

msgid "226"
msgstr "أولئك الذين يتمتعون باليقظة الدائمة، والذين يتدربون ليلاً ونهاراً، والذين يوجهون أنفسهم نحو النيرفانا، تتلاشى سمومهم الذهنية (الآسافا)."

msgid "227"
msgstr "يا أتولا، هذا أمر قديم وليس بجديد؛ فهم يلومون الصامت، ويلومون كثير الكلام، ويلومون المعتدل في كلامه. فلا يوجد أحد في هذا العالم لا يطاله اللوم."

msgid "228"
msgstr "لم يكن، ولن يكون، ولا يوجد الآن شخص يطاله اللوم وحده، أو المديح وحده."

msgid "229"
msgstr "لكن من يمدحه الحكماء بعد مراقبته يوماً بعد يوم، لكونه يتسم بسلوك لا تشوبه شائبة، وبأنه حكيم ومتمتع بالمعرفة والفضيلة؛ فمن ذا الذي يجرؤ على لوم مثل هذا الشخص؟"

msgid "230"
msgstr "إنه نقي كعملة من الذهب الخالص، حتى كائنات الديفا تمدحه، بل ويمدحه براهما أيضاً."

msgid "231"
msgstr "احذر من ثورات الجسد، وكن مسيطراً على أفعالك. تخلَّ عن سوء سلوك الجسد، ومارس السلوك السليم بجسدك."

msgid "232"
msgstr "احذر من ثورات اللسان، وكن مسيطراً على كلامك. تخلَّ عن سوء سلوك اللسان، ومارس السلوك السليم بلسانك."

msgid "233"
msgstr "احذر من ثورات الذهن، وكن مسيطراً على أفكارك. تخلَّ عن سوء سلوك الذهن، ومارس السلوك السليم بذهنك."

msgid "234"
msgstr "الحكماء هم الذين يسيطرون على أفعالهم، وأقوالهم، وأفكارهم. فهم حقاً من حقق السيطرة الكاملة."

msgid "chap18"
msgstr "الشوائب"

msgid "235"
msgstr "أنت الآن مثل ورقة صفراء، ورسل الموت (الياما) بانتظارك. أنت تقف على مشارف الرحيل، وليس لديك زاد لرحلتك."

msgid "236"
msgstr "فلتجعل من نفسك جزيرة، ولتجتهد، ولتكن حكيماً. ومن خلال التخلص من السموم الذهنية، وتجاوز الدنس، سوف تصل إلى عالم النبلاء الإلهي."

msgid "237"
msgstr "لقد شارف عمرك على الانتهاء، وأنت الآن في طريقك لمقابلة ملك الموت (الياما). ولا توجد محطة ترتاح فيها في طريقك، وليس لديك زاد لرحلتك."

msgid "238"
msgstr "فلتجعل من نفسك جزيرة، ولتجتهد، ولتكن حكيماً. ومن خلال التخلص من السموم الذهنية، وتجاوز الدنس، فلن تعود ثانية إلى الميلاد والهرم."

msgid "239"
msgstr "على ذي الحكمة أن يزيل شوائبه شيئاً فشيئاً، لحظة بلحظة، تماماً كما يزيل الصائغ الشوائب من الفضة."

msgid "240"
msgstr "مثلما يظهر الصدأ على الحديد، ثم يأكل الحديد نفسه، كذلك الأفعال الهدامة التي يقوم بها من يتجاوز الحدود، تقوده إلى عوالم المعاناة."

msgid "241"
msgstr "عدم التكرار هو شوائب التعاليم، وعدم الصيانة هو شوائب البيوت، والكسل هو شوائب الجمال، والغفلة هي شوائب الحارس."

msgid "242"
msgstr "سوء السلوك هو شوائب المرأة، والبخل هو شوائب المعطي. حقاً، الأفعال الهدامة هي شوائب هذا العالم والعالم الآخر."

msgid "243"
msgstr "وأسوأ هذه الشوائب قاطبة هي الجهل، فهو الشائبة الكبرى. فتخلصوا من هذه الشائبة يا رهبان، لتكونوا بلا شوائب."

msgid "244"
msgstr "من السهل على المرء أن يعيش بلا حياء، مثل الغراب، متسم بالوقاحة، والمكر، والعدوانية، والفساد."

msgid "245"
msgstr "ومن الصعب على المرء أن يعيش بحياء، باحثاً دائماً عن النقاء، وغير ملتصق بالأشياء، ومتواضعاً، وبصيراً، ونقياً في حياته."

msgid "246"
msgstr "من يقتل، ويتحدث بالكذب، ويأخذ ما ليس له، ويذهب لزوجة غيره، وينغمس في شرب المسكرات؛"

msgid "247"
msgstr "فإنه يحفر قبره بنفسه في هذا العالم."

msgid "248"
msgstr "فلتدرك إذن، أيها الرجل، أن من الصعب السيطرة على الأفعال الهدامة. فلا تدع الطمع والظلم يجلبان لك معاناة طويلة."

msgid "249"
msgstr "الناس يعطون وفقاً لإيمانهم وما يملكون. فمن يشعر بالضيق من طعام وشراب الآخرين، لن يحقق السكون الذهني (التأملي) لا في النهار ولا في الليل."

msgid "250"
msgstr "أما من قطع دابر هذا الضيق، واستأصله تماماً؛ فإنه يحقق السكون الذهني في النهار وفي الليل."

msgid "251"
msgstr "لا توجد نار مثل نار الشهوة، ولا يوجد قبض مثل قبض الكره، ولا توجد شبكة مثل شبكة الوهم، ولا يوجد نهر مثل نهر الرغبة الشديدة."

msgid "252"
msgstr "من السهل رؤية أخطاء الآخرين، ومن الصعب رؤية أخطاء النفس. فالمرء يذرو أخطاء الآخرين كالهباء، أما أخطاء نفسه فيخفيها كما يخفي المخادع نفسه."

msgid "253"
msgstr "من يبحث دائماً عن أخطاء الآخرين، ويسعى دائماً للومهم، فإن سمومه الذهنية تزداد، وهو بعيد كل البعد عن التخلص منها."

msgid "254"
msgstr "لا يوجد أثر في السماء، ولا يوجد ناسك (أرهات) خارج طريق بوذا. فالناس يبتهجون بالعوائق الروحية، أما البوذات فخالون منها."

msgid "255"
msgstr "لا يوجد أثر في السماء، ولا يوجد ناسك خارج طريق بوذا. ولا يوجد شيء مشروط يبقى للأبد، والبوذات لا يتأثرون بأي اضطراب."

msgid "chap19"
msgstr "الإنسان العادل"

msgid "256"
msgstr "لا يُعد المرء عادلاً إذا اتخذ قراره بتسرع وتعسف. أما الحكيم فهو من يدرس الأمر جيداً، ويميز بين الخطأ والصواب."

msgid "257"
msgstr "من يحكم بين الآخرين من غير تعسف، ووفقاً للدارما وبإنصاف، ويحمي القانون، فهو من يُدعى عادلاً بحق."

msgid "258"
msgstr "لا يُعد المرء حكيماً لمجرد كونه كثير الكلام. أما من يتسم بالسكينة، والتحرر من الكره والخوف، فهو من يُدعى حكيماً."

msgid "259"
msgstr "لا يُعد المرء متمسكاً بالدارما لمجرد كونه كثير الكلام عنها. أما من سمع القليل من الدارما وأدرك حقيقتها بحدسه، ولم يغفل عنها أبداً، فهو المتمسك بالدارما بحق."

msgid "260"
msgstr "لا يُعد المرء شيخاً (Thera) لمجرد أن رأسه قد اشتعل شيباً؛ فإذا كان يفتقر إلى الفضيلة، فهو شيخ بالاسم فقط."

msgid "261"
msgstr "أما من يتحلى بالحقيقة، والفضيلة، وعدم الإيذاء، والانضباط، والسيطرة على الحواس، ومن تخلص من السموم الذهنية، فهو من يُدعى شيخاً بحق."

msgid "262"
msgstr "لا يصبح المرء إنساناً صالحاً بمجرد بلاغة كلامه أو جمال وجهه، إذا كان يتسم بالحسد، والبخل، والمكر."

msgid "263"
msgstr "أما من استأصل هذه الصفات تماماً، وتخلص من الكره، وهو حكيم، فهو من يُدعى إنساناً صالحاً بحق."

msgid "264"
msgstr "لا يصبح المرء ناسكاً (Samaņa) بمجرد حلاقة رأسه، إذا كان كاذباً وغير منضبط. فكيف يكون ناسكاً وهو ممتلئ بالرغبة والطمع؟"

msgid "265"
msgstr "أما من كبح جماح أفعاله الهدامة، صغيرها وكبيرها، فهو من يُدعى ناسكاً، لأنه كبح جماح كل ما هو هدام."

msgid "266"
msgstr "لا يُعد المرء راهباً (Bhikkhu) لمجرد أنه يطلب الصدقة من الآخرين. فمن يتبع أساليب حياة العامة لا يعد راهباً."

msgid "267"
msgstr "أما من تعالى على الأفعال البناءة والهدامة، وعاش حياة روحية، وسار في هذا العالم بوعي وبصيرة، فهو من يُدعى راهباً بحق."

msgid "268"
msgstr "لا يصبح المرء حكيماً (Muni) بالصمت وحده، إذا كان جاهلاً وأحمق. أما الحكيم فهو من يزن الأمور، فيأخذ بما هو بناء ويترك ما هو هدام."

msgid "269"
msgstr "ومن يدرك طبيعة العالمين (الداخلي والخارجي) فهو الحكيم بحق."

msgid "270"
msgstr "لا يُعد المرء نبيلاً (Ariya) إذا كان يؤذي الكائنات الحية. ومن خلال عدم إيذاء جميع الكائنات الحية، يُدعى المرء نبيلاً."

msgid "271"
msgstr "ليس بمجرد الالتزام بالقواعد الأخلاقية، ولا بكثرة العلم، ولا بالدخول في حالات التأمل العميق، ولا بالعيش في خلوة، ولا بالقول: لقد نلت سعادة التحرر التي لا ينالها عامة الناس،"

msgid "272"
msgstr "يمكن للراهب أن يطمئن ما لم يحقق التخلص التام من السموم الذهنية (الوصول للأرهات)."

msgid "chap20"
msgstr "المسار الروحاني"

msgid "273"
msgstr "من بين كلّ المسارات الروحانية، أنبلها مسار النبلاء ذو الفروع الثمانية. ومن بين الحقائق أنبلها الحقائق النبيلة الأربع. ومن بين الحالات أنبلها غياب الرغبة الشديدة. وأنبل الكائنات التي تمشي على رجلين البوذا الذي يرى كلّ شيء."

msgid "274"
msgstr "هذا هو المسار من أجل نقاء الرؤية، ولا مسار غيره. إذا اتبعتموه فسوف تُربكون المارا."

msgid "275"
msgstr "إذا اتبعتم هذا المسار فستضعون نهاية للمعاناة. وقد عرفتم هذا الطريق من خلالي، إنّه الطريق الذي يُحطّم أسهم السّموم الذهنية."

msgid "276"
msgstr "مهمّتكم أن تبذلوا جهدكم، فالبوذات (Tathāgatas) فقط يُرشدون إلى الطريق، وأولئك الذين يتدربون على التأمّل يتحرّرون من قيود المارا."

msgid "277"
msgstr "'كل الأشياء المشروطة متغيّرة'، وعندما ينظر المرء إلى هذا ببصيرة وحكمة، سيستيقظ من المعاناة. هذا هو مسار النقاء."

msgid "278"
msgstr "'كل الأشياء المشروطة معاناة'، وعندما ينظر المرء إلى هذا ببصيرة وحكمة، سيستيقظ من المعاناة. هذا هو مسار النقاء."

msgid "279"
msgstr "'كل الأشياء المشروطة بلا ذات'، وعندما ينظر المرء إلى هذا ببصيرة وحكمة، سيستيقظ من المعاناة. هذا هو مسار النقاء."

msgid "280"
msgstr "الإنسان الذي لا ينهض عندما ينبغي عليه ذلك، والذي رُغم شبابه وقوته، سلّم نفسه للكسل، هذا الكسول ذو الذهن البليد لن ينال مسار الحكمة."

msgid "281"
msgstr "على الإنسان توخي الحذر في كلامه، وأن يكون منضبطاً في ذهنه، وفي جسمه، وألا يرتكب الأمور غير السليمة. على المرء أن يُنقي هذه الثلاثة، ويقوم بالمسار الذي وضحه البوذات."

msgid "282"
msgstr "ألا إنّ الحكمة وليدة التأمل، ومن دون التأمل تضيع الحكمة. إذا عرفنا هذا السبيل بفرغيه: نيل الحكمة وضياعها، وجب على الإنسان الانضباط في سلوكه حتّى تربو الحكمة وتزيد."

msgid "283"
msgstr "يا رهبان! قطعوا أشجار غابة الاشتهاء، لا الأشجار الحقيقية، فغابة الاشتهاء تولّد الخوف. قطعوا أشجار الاشتهاء وكذلك ما ينمو من شجيرات صغيرة تحتها، حتى تتحرّروا من غابة الاشتهاء."

msgid "284"
msgstr "طالما لم يُجتث اشتهاء الرجل للمرأة، مهما كان ضئيلاً، ولم يقطع، سيبقى ذهنه مقيداً مثل العجل الصغير المربوط بأمه."

msgid "285"
msgstr "اقطعوا التعلّق داخلكم كما تُقطف زهرة اللوتس باليد في فصل الخريف. واجتهدوا في مسار السلام (وهو مسار) النيرفانا الذي علمه البوذات."

msgid "286"
msgstr "'هنا سأعيش خلال موسم المطر، وهنا سأعيش في الشتاء والصيف'. هذا ما يُفكّر فيه الأحمق الذي لا يُدرك عائق الموت."

msgid "287"
msgstr "يأخذ الموت من هو شغوف بما لديه من أبناء وغنم، ومن ذهنه متعلّق بهم. شأنه شأن القرية النائمة التي يسحقها فيضان عظيم."

msgid "288"
msgstr "لا يُمكن للأبناء ولا للوالدين أو الأقارب المقرّبين حماية الإنسان. فعند انقضاض الموت عليه، لا الأقارب ولا الأصحاب يُمكنهم حمايته."

msgid "289"
msgstr "وإذ يُدرك هذا الأمر ذو الحكمة، المنضبط الأخلاق والمبادئ، وجب عليه أن يُسارع إلى إزالة العوائق عن المسار المؤدي إلى النيرفانا."

msgid "chap21"
msgstr "منثورات"

msgid "290"
msgstr "إذا وجد الإنسان سعادة عظيمة في أن يتخلّى عن مُتَع صغيرة، وَجَبَ على الحكيم أن يتخلّى عن المُتَع الصغيرة لدى رؤيته السعادة العظيمة."

msgid "291"
msgstr "من يسع لنيل سعادته الشخصيّة من خلال التسبب بالألم للآخرين، وهو مكبّل بقيود العدائية، لا يُمكنه التحرّر من هذه العدائية."

msgid "292"
msgstr "أولئك الذين يتركون ما يلزم القيام به، ويقومون بما لا يلزم - المزهرون بأنفسهم وينقصهم الانتباه - تكبر فيهم السّموم الذهنية."

msgid "293"
msgstr "أولئك الذين يدأبون في بذل خير الجُهد في تنمية الحضور الذهني في الجسد، والذين لا يقومون بما لا يلزم القيام به بل يدأبون في القيام بما ينبغي القيام به، والذين يتمتعون بالحضور الذهني السليم والفهم السليم، تنتهي فيهم السّموم الذهنية."

msgid "294"
msgstr "بعد أن يقتل الساعي للتحرّر الأم (رمز الاشتهاء)، والأب (رمز الغرور)، والملكين، ويُدمّر المملكة وجابي مواردها، يتحرّر حينها من المعاناة."

msgid "295"
msgstr "بعد أن يقتل الساعي للتحرّر الأم والأب والملكين، ويُدمّر العائق الخامس وهو النمر (رمز الشك) - يتحرّر الساعي للتحرّر من المعاناة."

msgid "296"
msgstr "تلامذة غوتاما بوذا يستيقظون دائماً من النوم بأذهان واضحة يقظة، وهم ليلاً نهاراً في حضور ذهني دائم تجاه بوذا."

msgid "297"
msgstr "تلامذة غوتاما بوذا يستيقظون دائماً من النوم بأذهان واضحة يقظة، وهم ليلاً نهاراً في حضور ذهني دائم تجاه الدارما."

msgid "298"
msgstr "تلامذة غوتاما بوذا يستيقظون دائماً من النوم بأذهان واضحة يقظة، وهم ليلاً نهاراً في حضور ذهني دائم تجاه السانغا."

msgid "299"
msgstr "تلامذة غوتاما بوذا يستيقظون دائماً من النوم بأذهان واضحة يقظة، وهم ليلاً نهاراً في حضور ذهني دائم تجاه الجسد."

msgid "300"
msgstr "تلامذة غوتاما بوذا يستيقظون دائماً من النوم، وذهنهم ليلاً نهاراً يجد السرور دائماً في عدم الأذى وفي تنمية الطيبة المحبة والرأفة."

msgid "301"
msgstr "تلامذة غوتاما بوذا يستيقظون دائماً من النوم، وذهنهم ليلاً نهاراً يجد السرور دائماً في التدريب الذهني."

msgid "302"
msgstr "من الصعب أن تُصبح راهباً، من الصعب أن تكون سعيداً وأنت تُمارس التدريبات التي يقوم بها الراهب. الحياة المنزلية صعبة، والعيش مع ذوي الطبائع المختلفة مؤلم، والمسافر في السمسارا يتعرض دائماً للمعاناة. لذلك، لا تكن من المسافرين في السمسارا، ولا مِمّن يتعرضون المرة تلو الأخرى للمعاناة."

msgid "303"
msgstr "من امتلك تقوى سليمة وكان سلوكه سليماً، وامتلك الصيت والثروة أيضاً، يُجلّه الناس حيث يكون."

msgid "304"
msgstr "الأخيار منيرون مثل جبال الهيمالايا [المكسوة بالثلج]، نراهم حتى من بعيد. والأشرار مثل الأسهم التي تُطلق ليلاً لا تمكن رؤيتها."

msgid "305"
msgstr "من يجلس وحيداً وينام وحيداً ويمشي وحيداً وهو مثابر في ممارساته وتدريباته، ويُروّض نفسه بنفسه، لا بدّ أن يجد سروراً في حياة الغابة."

msgid "chap22"
msgstr "عَوالم المُعاناة القُصوى"

msgid "306"
msgstr "مَن يَقومُ بالاتّهامات الكاذبة يُعاد ميلاده في المُعاناة القُصوى Niraya. كذلك مَن يقوم بالأمور الهدّامة، ويقول: لم أفعل ذلك، يُعاد ميلاده أيضاً في عالم المُعاناة القُصوى. وكلاهما كفاعل الأمور الهدّامة، يُعاني بنفس الدرجة في وجوده التالي بعد موته."

msgid "307"
msgstr "كثيرون ممّن يرتدون رداء الرهبنة الأصفر حتى رقابهم، لديهم ميول هدّامة وشريرة، وغير منضبطين في فكرهم وكلامهم وأفعالهم؛ فيُعاد ميلادهم في عالم المُعاناة القُصوى بسبب أفعالهم الشريرة."

msgid "308"
msgstr "من الأفضل للإنسان أن يتناول كُتلةً من الحديد الساخن والمحترق كالجمر بدلاً من أن يأكل طعام الهبات الذي يُقدّمه الناس، إذا كان هذا المرء بلا أخلاق، وغير منضبط في فكره وكلامه وأفعاله."

msgid "309"
msgstr "أربعُ عواقب تحلّ على من لا يتمتّع بالانتباه واليقظة، ومَن يُسيء في سلوكه الجنسي مع زوجة رجل آخر: يُهدّم ما قام ببنائه، ويُواجه الازدراء والاحتقار، ويُعاني مشاكل في النوم، ثم ينتهي به الأمر في عالم المُعاناة القُصوى."

msgid "310"
msgstr "هذا المرء يُهدّم ما قام ببنائه، و يُعادُ ميلاده في عوالم المُعاناة القُصوى. فاستمتاع الرّجل الخائف مع المرأة الخائفة قصيرُ الأجل، ويتبعه عذابٌ من المَلِك. لذلك على الرّجل ألا يُسيء في سلوكه الجنسي مع زوجة رجل آخر."

msgid "311"
msgstr "مثل العُشبة التي إذا أُمسكت بشكل خاطئ، تجرحُ اليد التي تُمسكها. كذلك إذا كانت حياة الراهب أو الزاهد فاسدة، فإنّها تجرّه إلى عالم المُعاناة القُصوى."

msgid "312"
msgstr "لا يعود بالنّفع على الرّاهب أيّ فعل يقوم به بلا مُبالاة، أو أيّ فعل خسيس، أو أيّ سلوك مُريب."

msgid "313"
msgstr "إذا كان هناك ما ينبغي عليك القيام به فأنقذه، وقُم به بعزيمة ونشاط؛ لأنّ الحياة المُهملة والبليدة للراهب أو الزاهد تُثير غُبار السّموم الذهنية بدلاً من أن تُزيلها."

msgid "314"
msgstr "من الأفضل ألا تقوم بفعل شرير، لأنّ ذلك يجلب الندم. ومن الأفضل لك أن تقوم بعمل خير لا تندم على فعله."

msgid "315"
msgstr "مثل البلدة المُجاورة للحدود والمُحصّنة من الداخل والخارج، هكذا حصّن نفسك، ولا تترك الفرصة المُلائمة تمرّ. فأولئك الذين تفوتهم هذه اللحظة يُبتلون بالحزن والهمّ عندما يسقطون في عالم المُعاناة القُصوى."

msgid "316"
msgstr "من يخجلون مِمّا لا ينبغي الخجل منه، ولا يستخون مِمّا ينبغي الخجل منه، ويحملون رؤى خاطئة، يُعاد ميلادهم في حالة أسوأ."

msgid "317"
msgstr "من يرون الخطر فيما ليس خطرًا، ولا يرون الخطر فيما هو خطرٌ، ويحملون رؤى خاطئة، يُعاد ميلادهم في حالة أسوأ من الوجود."

msgid "318"
msgstr "من يرون الخطأ فيما ليس خطأً، ولا يرون الخطأ فيما هو خطأ، ويحملون الرؤى الخاطئة، يُعاد ميلادهم في حالة أسوأ من الوجود."

msgid "319"
msgstr "من يُدرك من الكائنات ما هو خاطئ على أنّه خاطئ، ومَن يعرف ما هو صحيح على أنّه صحيح، ويحمل الرؤى الصحيحة، يُعاد ميلاده في عالم أفضل من الوجود."

msgid "chap23"
msgstr "الفيل"

msgid "320"
msgstr "مثلما يتحمل الفيلُ السّهام التي ترميها الأقواسُ في ساحة المعركة، كذلك أنا سوف أتحمّل الكلام المؤذي. ألا إنّ سلوك الكثير من الناس سيئ."

msgid "321"
msgstr "لا يُقاد إلى ساحات المعركة سوى الخيول والفيلة المدرّبة، والملكُ لا يعتلي إلا الفيلة والخيول المدرّبة. والأكثرُ نُبلاً من بين النّاس هم الذين رَوّضوا أنفسهم، والذين يتحمّلون الإساءة بصبر."

msgid "322"
msgstr "عندما تُدرّب البغال والخيول الأصيلة والفيلة العظيمة من بلاد السّند تُصبح رائعة، لكنّ الإنسان الذي رَوّض نفسه أكثرُ رَوْعة."

msgid "323"
msgstr "ليس بأي وسيلة تنقُّلٍ يُمكن للمرء أن ينال النيرفانا. لكن من خلال ترويض النّفس بعمق، يُمكن لمَن روّض نفسه أن ينال النيرفانا."

msgid "324"
msgstr "الفيل الذي يُدعى دانابالا Dhanapāla في اهتياج، غيرُ مروّض. وهو في الأسر لا يأكل حتّى لُقمة واحدة، فهو في حنينٍ إلى غابته."

msgid "325"
msgstr "من يُعاني من الكسل والشراهة وكثرة النّوم والاستلقاء والتقلّب في الفراش، مِثْلُه مثلُ الخنزير الكبير، الذي يطعَمُ الحبوب. كذلك الإنسان البليد الذي يُولَد في الرّحِم المرّة تلو الأخرى."

msgid "326"
msgstr "في الماضي كان هذا الذّهن يجول كيفما شاء وحيثما شاء، وراء متَعه الخاصّة. أمّا الآن فسوف أسيطر على ذهني بحكمة مثلما يستخدم سائق الفيل المهماز ليقود فيلاً هائجاً."

msgid "327"
msgstr "استدعِ السُّرور في الانتباه واليقظة، وحصّن ذهنك جيّدًا. كالفيل العالق في الوحل يجُرّ نفسه خارجه، اسحب نفسك من وَحْلِ التّعاسة."

msgid "328"
msgstr "إذا وجدت صديقًا حكيمًا، ورفيقًا يتحلّى بالسّلوك السّليم وقد تغلّب على جميع العوائق، فرافقه بسرور وذهن حاضر."

msgid "329"
msgstr "إذا لم يجد المرء رفيقًا حكيمًا يتحلّى بالسّلوك السّليم، وَجَبَ عليه أن يعيش وحيدًا مثل الملك الذي تخلّى عن البلد التي تمّ غزؤها، ومثل فيل Mātanga الذي يجول وحيدًا في الغابة."

msgid "330"
msgstr "من الأفضل أن تعيش وحيدًا، فلا صُحبة مع الأحمق. وعلى المرء أن يجول وحيدًا وألاّ يرتكب فعلاً مشيئًا، وأن يكون لديه القليلُ من المسؤوليات، مثل فيل Mātanga الذي يجول وحيدًا في الغابة."

msgid "331"
msgstr "من الخير أن يكون لديك أصدقاء عندما تدعو الحاجة إلى ذلك، ومن السّعادة أن ترضى بما هو موجود، ومن السّعادة أن تكون لديك فضيلةٌ تُوشك حياتُك على النّهاية، ومن السّعادة أن تتخلّص من جميع المُعاناة."

msgid "332"
msgstr "من الأمور السارّة في هذا العالم أن يقوم المرء بالواجب تجاه أُمّه، وأن يقوم كذلك بالواجب تجاه والده. ومن الأمور السارّة في هذا العالم أيضًا أن تخدم النُّساك والبوذات."

msgid "333"
msgstr "من الأمور السارّة أن تتحلّى بالفضيلة حتّى في كِبَر السنّ. ومن الأمور السارّة أن تتمتّع بتوق واعتقاد سليم لا يتزعزع. ومن الأمور السارّة أن تنال الحكمة. ومن الأمور السارّة أخيرًا ألاّ تسلك سلوكًا بطالاً."

msgid "chap24"
msgstr "الاشتهاء"

msgid "334"
msgstr "في داخل المرء غير المتمتّع باليقظة والانتباه، ينمو الاشتهاء كالنباتات المتسلّقة؛ فيركضُ من ميلاد لآخر، كالقرد الذي يسعى خلف الفواكه في الغابة."

msgid "335"
msgstr "في هذا العالم، ينمو الأسى داخل المرء الذي غلبه عنيفُ الاشتهاء، والذي تتشبّث بالعالم، كعُشبٍ نما بكثافة."

msgid "336"
msgstr "في هذا العالم، يزول الأسى مِمّن تغلّب على هذا الاشتهاء العنيف - الذي يصعب التخلّص منه - مثل قطرات الندى المتساقطة عن ورقة زهرة اللوتس."

msgid "337"
msgstr "ولذلك سأنقل إليكم هذه التعاليم القيمة، إليكم يا من اجتمعتم هنا: اجتثّوا الاشتهاء من جذوره مثل المرء الذي يطلب الجذر العَطر، فيبحث عن جذور عشب البيرانا. لا تَدَعوا المارا تُدمّركم المرّة تلو الأخرى كما يُدمّر الماء الجاري القصب."

msgid "338"
msgstr "كما أنّ الشجرة ثابتةُ الجذور والسليمة تنمو حتّى بعد قطعها، كذلك الاشتهاء الكامن الذي لم يُجتثّ من جذوره، تنشأ المعاناة منه المرّة تلو الأخرى."

msgid "339"
msgstr "المرء ذو الرؤى الخاطئة، الذي تتدفّق بداخله تيارات الاشتهاء الستّة والثلاثون التي تقودها الرغبة الشديدة، سينجرف بسبب ذلك الرغبة الشديدة."

msgid "340"
msgstr "تندفع نوازعُ الاشتهاء نحو الأشياء المحسوسة، فتنشأ شجرة الاشتهاء المتسلّقة، وتُثبت نفسها. فعندما ترى تلك الشجرة المتسلّقة تنمو، اقطع جذورها بالحكمة."

msgid "341"
msgstr "تنشأ في الكائنات سعادة مشوبة بالاشتهاء. وتبقى هذه الكائنات المتعلّقة بالمتعة والساعية نحوها في دائرة الميلاد وكبر السنّ."

msgid "342"
msgstr "أولئك المبتلون بالاشتهاء، مُروّعون كأرنب وقع في الفخّ، مكبّلون بالقيود ويقعون في دائرة المعاناة المرة تلو الأخرى، ولزمن طويل."

msgid "343"
msgstr "أولئك المبتلون بالاشتهاء، مُروّعون كأرنب وقع في الفخّ. لذلك فإنّ الراهب الذي يتمنّى تحرير نفسه من الرغبة الشديدة، عليه أن يتخلّص من الاشتهاء."

msgid "344"
msgstr "ذلك الشخص الذي ترك حياة غابة الرغبات، وسعى في حياة التدريب، عاد مندفعًا نحوها بعد أن تحرّر منها. تعالوا وانظروا إلى ذلك الشخص الذي بعدما تحرّر عاد مندفعًا إلى تلك القيود ذاتها."

msgid "345"
msgstr "لا يرى ذو الحكمة أنّ الروابط المصنوعة من الحديد والخشب والقنّب روابط قويّة. فالشغف بالجواهر والأحجار الكريمة والأولاد والزوجات هي الروابط والقيود القويّة، إذ تجرّ المرء للأسفل."

msgid "346"
msgstr "ومع أنّها تبدو سهلة، من الصعب التحرّر منها. لكنّ ذا الحكمة يكسر هذه القيود، وينبذ المتع الحسيّة، من دون الحنين ثانية إليها."

msgid "347"
msgstr "الكائنات المأخوذة بالرغبات الحسّيّة تقع في تيارات الاشتهاء الذي صنعته بنفسها، مثل العنكبوت الذي يقع في الشبكة التي صنعها. لكنّ الحكيم الذي كسر قيود الاشتهاء، يمشي بعزم تاركًا المعاناة كلّها خلفه."

msgid "348"
msgstr "انبذ ما هو خلفك وما هو أمامك، وتخلّ عمّا بينهما، واسمُ إلى ما فوق الوجود، وبذهن متحرّر من كلّ شيء؛ وهكذا لن تخضع لدائرة إعادة الميلاد والموت."

msgid "349"
msgstr "الشخص الذي تشتّته الأفكار والرغبة الشديدة الشديدة، والذي يُطيل تأمّل الأشياء الممتعة، يزيد فيه الاشتهاء أكثر فأكثر، فيزيد حقًّا من حدّة أسره."

msgid "350"
msgstr "لكنّ من يجد السرور في تهدئة أفكاره، والذي يتمتّع بالحضور الدائم، ويتأمّل في الأمور المزعجة، سينهي المعاناة فيه. مِثْلُ هذا الشخص سيكسر قيود المارا."

msgid "351"
msgstr "ذلك الذي نال مرحلة الأرهات، متحرّرٌ من الخوف ومن الاشتهاء ومن الفساد، قد قطع أسهم الوجود، وسيكون هذا آخر ميلاد له."

msgid "352"
msgstr "من تحرّر من الاشتهاء ومن التعلّق، والماهر في معرفة تفاصيل دلالات كلمات التعاليم، والذي يعرف مجموعات الأحرف وتتابعها، ومَن عاش آخر ميلاد له، يُطلق عليه بالفعل 'صاحب حكمة عظيمة، وشخص عظيم'."

msgid "353"
msgstr "لقد تغلّبتُ على كلّ شيء، لقد عرفتُ كلّ شيء، ولستُ متعلّقًا بأيّ شيء. فقد تخلّيت عن كلّ شيء، وتحرّرتُ من كلّ الفساد بعدما تخلّصتُ من الاشتهاء. وبعدما استوعبتُ الحقائق النبيلة الأربع بنفسي مباشرة، من سأشير إليه كمعلّم لي؟"

msgid "354"
msgstr "هدية الدارما تفوق كلّ الهدايا، وطَعْم الدارما يفوق كلّ الأطعمة، والسرور في الدارما يفوق كلّ أشكال السرور، وإزالة الاشتهاء يهزم جميع أشكال المعاناة."

msgid "355"
msgstr "الثراء يُدمّر الأحمق، لكنّه لا يُدمّر مَن يسعون نحو الشاطئ البعيد أي النيرفانا. فباشتهاء الأحمق للثروة يُدمّر نفسه ويُدمّر الآخرين."

msgid "356"
msgstr "يُتلف العُشبُ الحقول، والشغف يُفسد جميع الكائنات. لذلك فإنّ تقديم العطايا لِمَن تحرّروا من الرغبة الشديدة والشغف يجلب النفع الكثير."

msgid "357"
msgstr "يُتلف العُشبُ الحقول، والكُره يُفسد جميع الكائنات. لذلك فإنّ تقديم العطايا لِمَن تحرّروا من الكره يجلب النفع الكثير."

msgid "358"
msgstr "يُتلف العُشبُ الحقول، والوهم يُفسد جميع الكائنات. لذلك فإنّ تقديم العطايا لِمَن تحرّروا من الوهم يجلب النفع الكثير."

msgid "359"
msgstr "يُتلف العُشبُ الحقول، والاشتهاء يُفسد جميع الكائنات. لذلك فإنّ تقديم العطايا لِمَن تحرّروا من الاشتهاء يجلب النفع الكثير."

msgid "chap25"
msgstr "الرّاهب"

msgid "360"
msgstr "التحكّم في الحواسّ، من بصرٍ وسمعٍ وشمٍّ وكلام، خيرٌ."

msgid "361"
msgstr "الانضباط في الجسد خيرٌ، ومن الخير الانضباط في الكلام، وفي الذّهن، في كلّ مكان. الرّاهب المنضبط في جميع حواسّه متحرر من كلّ معاناة."

msgid "362"
msgstr "من يتحكّم في يده، ويتحكّم في قدمه، ويتحكّم في كلامه، وله كاملُ السيطرة على نفسه، ويجدُ السُّرور الداخليّ في حالة الصامادي وفي خلوته راضيًا، يُسمّى راهبًا."

msgid "363"
msgstr "الرّاهب الذي يتحكّم في فمه، والمعتدل في كلامه، والمتّزن، والذي يشرح معاني الدّارما ونصوصها، حلوةٌ هي كلماتُه."

msgid "364"
msgstr "الرّاهب الذي يجد السرور في الدّارما، ومَن يتأمّل ويبحثُ في الدّارما، ويتذكّر الدّارما دائمًا، لن يحيد عنها أبدًا."

msgid "365"
msgstr "على الإنسان ألاّ يستخفّ أو يزدري ما ناله، وعليه ألاّ يحسد الآخرين على مكاسبهم. فالرّاهب الذي يحسد الآخرين لا يُمكنه بلوغ حالة الصامادي."

msgid "366"
msgstr "مع أنّ الراهب لا يحصل إلاّ على القليل، فإنه إذا لم يأسف على هذا القليل الذي حصل عليه، فكائنات الديفا ستثني حقًّا على من يسلك حياةً نقيّة، غير بليدة."

msgid "367"
msgstr "من لا ينظر للأمور الماديّة على أنَّها 'أنا ولي'، ومَن لا يتحسّر على تحلّل الذّهن والجسد، يُسمّى بالفعل الرّاهب."

msgid "368"
msgstr "إنَّ الراهب الذي يعيش في مُمارسة الطيبة المُحبّة، والذي يثق بتعاليم بوذا، سيُدرك حالة السلام والسّكينة."

msgid "369"
msgstr "أيُّها الراهبُ أخرج الماء من هذا القارب، وعند ذلك سيسير بانسياب، وبعد أن تتخلّص من الرغبة الشديدة والكُره ستُدرك النيرفانا."

msgid "370"
msgstr "تخلّص من الخمسة: (القيود الدنيا الخمسة: 1. وجهات النّظر حول ما يتعلّق بالنّفس أو ما تملكه النّفس 2. الشكّ 3. التشبّث 4. الاشتهاء الحسّي 5. الكُره)، وتخلّ عن الخمسة (القيود الخمسة: 1. التعلّق بالظواهر الملموسة 2. التعلّق بالظواهر غير الملموسة 3. التكبّر 4. الاضطراب 5. الجهل)، ونَمِّ الخمس (مَلَكات الانضباط: الثّقة، السّليم، بذل الجُهد السّليم، الحضور الذّهني، وحالة الصامادي والحكمة والبصيرة)، فالراهب الذي حَرّر نفسه من القيود الخمسة يُسمّى (من عَبَر الفيضان أي السمسارا)."

msgid "371"
msgstr "تأمّل أيُّها الراهبُ ولا تكن غافلاً أو شارد الذّهن، ولا تَدَع ذهنك يضيع في المتَع الحسّيّة. لا تفقد حضورك الذهنيّ، فتبلع كُتلة الحديد المُشتعلة؛ فتصرخ وأنت تحترق في عالم المعاناة القصوى: 'هذه معاناة'."

msgid "372"
msgstr "لا يُمكن أن يصل الإنسان إلى حالة الصامادي وهو يفتقر إلى الحكمة. ولا يُمكن أن تُوجَد الحكمة فيمن لا يتدرّب على التأمّل. من يحظى بحالة الصامادي والحكمة هو بالفعل قريبٌ من النيرفانا."

msgid "373"
msgstr "الرّاهب الذي يختلي، والذي يتمتّع بذهن هادئ، والذي يُدرك الدّارما بجلاء، يعيش متعة تفوق متعة الناس."

msgid "374"
msgstr "في كلّ مرّة يتفكّر الراهب وينبحث المرء في نشوء مكوّنات الأشياء والكائنات وزوالها إشارةً إلى تأمّل البصيرة، يجد السعادة والنشوة في ذلك. وهذا هو الطريق للنيرفانا - لمَن يملك الحكمة."

msgid "375"
msgstr "بالنسبة إلى الراهب هذه هي التعاليم الأساسيّة: ضبط الحواسّ، والرّضى، وضبط النّفس بناءً على المبادئ الأساسيّة."

msgid "376"
msgstr "كُن على صلة بالأصدقاء الروحانيّين الأخيار، الذين يتمتّعون بالنشاط، وعيشهم نقيّ. كُن حسنَ الضّيافة وذوذا، واسلك بصواب. هكذا، ومع تكرار مشاعر السعادة الغامرة، ستنتهي المعاناة."

msgid "377"
msgstr "أيُّها الرّاهب! مثلما يتخلّى نبات الياسمين عن أزهاره الذابلة، تخلّ أنت أيضًا عن الرغبة الشديدة والكره."

msgid "378"
msgstr "الرّاهب الذي يتمتّع بهدوء في الجسد، وهدوء في الكلام، وهدوء في الذّهن، ويتمتّع بالتّركيز وقد تخلّص من متع العالم، يُطلق عليه 'من تمتّع بالسّكينة'."

msgid "379"
msgstr "أيُّها الرّاهبُ حُضّ نفسك بنفسك، واختبر نفسك. فإذا حصّنت نفسك هكذا وكنت حاضرًا، ستعيش في سعادة."

msgid "380"
msgstr "المرء هو ملجأ نفسه ومُخلص نفسه. الإنسان بالفعل ملاذُ نفسه، لذلك اعتنِ بنفسك مثل تاجر الخيول الذي يعتني بالخيل الأصيلة."

msgid "381"
msgstr "إنّ الرّاهب الذي يشعر باستمرارٍ بالسُّرور ويثق بتعاليم بوذا، سوف يُحقّق حالة السلام الداخلي، أي نهاية الحالات المشروطة."

msgid "382"
msgstr "حتّى الراهبُ صغير السنّ، الذي يُكرّس نفسه من أجل تعاليم بوذا، يُنير العالم مثل القمر المُنير في سماءٍ صافية، لا غُيوم فيها ولا سُحُب."

msgid "chap26"
msgstr "البراهمن"

msgid "383"
msgstr "أيها البراهمن، اقطع تيار الاشتباه بعد أن اجتهدت وثابرت وتخلصت من الرغبات الحسية. أيها البراهمن، لقد عرفت زوال الأشياء المشروطة، فأنت تعلم النيرفانا."

msgid "384"
msgstr "عندما يصل البراهمن إلى الشاطئ البعيد خارج الثنائية، تتحطم كل القيود."

msgid "385"
msgstr "من ليس على هذا الشاطئ ولا على الشاطئ البعيد، ومن لا يعاني من التوتر الذهني، وكان خاليًا من القيود، أسميه البراهمن."

msgid "386"
msgstr "من يتدرب على التأمل، وهو خالٍ من غبار السموم الذهنية، والذي وصل إلى أسمى غاية، أسميه البراهمن."

msgid "387"
msgstr "تشرق الشمس في النهار، وينير القمر في الليل، وفي درعه يشرق المحارب، وفي التأمل يشرق البراهمن. لكن بوذا في تألقه ينير في كل الأوقات، في الليل وفي النهار."

msgid "388"
msgstr "يُسمّى المرء 'البراهمن' لأنه نبذ الشرور، ويُسمّى من يعيش باتزان ناسكًا أو زاهدًا (samana)، ويُسمّى المرء باباجتا (Papajita) لأنه تخلى عن كل ما يشين سلوكه."

msgid "389"
msgstr "ينبغي عدم الاعتداء على البراهمن، وينبغي على البراهمن عدم الشعور بالغضب نتيجة الاعتداء عليه. فمن المشين الاعتداء على البراهمن، لكن ما هو مشين أكثر هو شعور الغضب تجاه المعتدي."

msgid "390"
msgstr "بالنسبة إلى البراهمن لا شيء أفضل من أن يصون ذهنه من الأمور العزيزة عليه. ويكون مدى زوال المعاناة بحجم النيّة عن كفّ الأذى."

msgid "391"
msgstr "إذا لم يقم المرء بالسوء فعلاً أو قولاً أو فكرًا -من ضبط نفسه ضمن هذه الثلاثة- أسميه البراهمن."

msgid "392"
msgstr "إذا تعلم إنسان تعاليم بوذا من شخص ما، وجب أن يُقدّم له الاحترام والتبجيل، مثلما يُبجّل البراهما نار القربان."

msgid "393"
msgstr "لا يُصبح المرء براهمن بشعره المجدول أو لنسبه أو أصله، أو لطبقته الاجتماعية. من يُدرك الحقيقة والدارما فقط يُعتبر نقيًا، وهو من أسميه البراهمن."

msgid "394"
msgstr "أيها الأحمق! ما نفع شعرك الطويل المجدول؟ وما نفع ما ترتديه من جلد؟ وفي داخلك غابة من الشرور، تُهملها وتكتفي بتنقية ذاتك من الخارج."

msgid "395"
msgstr "من يرتدي الأثواب من قطع القماش الخرقة، وهو هزيل وقد بدت عروقه من تحت جلده، ومن يتأمل وحيدًا في الغابة، أسميه البراهمن."

msgid "396"
msgstr "لا أطلق على المرء البراهمن، فقط لأنه وُلد من رحم أنثى من طبقة البراهما، إذا كان متغطرسًا ومتكبرًا. من خلا من السموم الذهنية والتعلق، أسميه البراهمن."

msgid "397"
msgstr "من كسر كل القيود وخلا من الخوف، من تجاوز القيود وخلا من التعلق، أسميه البراهمن."

msgid "398"
msgstr "من قطع الحبل والرباط وفتح القفل، ومن استيقظ واستنار، أسميه البراهمن."

msgid "399"
msgstr "من يتحمل الإساءة والضرب والحبس بضبر ودون كره، قُوَّتُه الصبر وجيشُه القوة، أسميه البراهمن."

msgid "400"
msgstr "من لا يغضب، وصاحب السلوك السليم، ومن يتمتع بالفضيلة ويخلو من الكِبْر، والمنضبط، ومن جسده الحالي آخر جسد له، أسميه البراهمن."

msgid "401"
msgstr "من لا يتشبث بالمتع الحسيّة، مثل قطرات الماء التي لا تتشبث بأوراق زهرة اللوتس، أو مثل حبة الخردل التي لا تعلق بطرف الإبرة، أسميه البراهمن."

msgid "402"
msgstr "من يُدرك، حتى في هذا الوجود، نهاية معاناته، والذي يُلقي العبء جانبًا، والذي يخلو من التعلق، أسميه البراهمن."

msgid "403"
msgstr "من يتمتع بالحكمة العميقة، والماهر في مساره الروحاني وفي غير ذلك، والذي نال أسمى الغايات، أسميه البراهمن."

msgid "404"
msgstr "من لا يرتبط بأصحابة المنازل والبيوت، أو ذاك الذي ترك البيوت أو المأوى، والذي يخلو من الرغبات الحسيّة، وليس لديه إلا القليل من الرغبات، أسميه البراهمن."

msgid "405"
msgstr "من ألقى جانبًا استخدام القوة ضدّ جميع الكائنات، سواءً الأقوياء أم الضعفاء، والذي لا يقتل ولا يجعل الآخرين يتسببون بالقتل، أسميه البراهمن."

msgid "406"
msgstr "من لا يتصرّف بعدوانية بين المعتدين، ومن يتصف بالسلام مع أولئك الذين يحملون السلاح، ومن لا يتعلّق بالأشياء التي يتعلّق بها الآخرون، أسميه البراهمن."

msgid "407"
msgstr "من تخلص من الاشتباه والكُره والغرور والانتقاص من شأن الآخرين، مثلما تسقط حبّة الخردل من طرف الإبرة، أسميه البراهمن."

msgid "408"
msgstr "من يتحدّث بلُطف من دون قسوة ويقول كلامًا حقيقيًا، ومن لا يؤذي أحدًا بكلامه، أسميه البراهمن."

msgid "409"
msgstr "من لا يأخذ شيئًا لم يُعطه في هذا العالم، سواءً صغر أم كبر أم طال أم قصر، سواءً كان حسنًا أم قبيحًا، أسميه البراهمن."

msgid "410"
msgstr "الذي ليس فيه رغبةٌ لا في هذا العالم ولا فيما يليه، ومن خلا من التعلّق، أسميه البراهمن."

msgid "411"
msgstr "الذي ليس فيه شهواتٌ، ومن لا يُعاني من الشكّ من خلال المعرفة، ومَن أدرك النيرفانا، أسميه البراهمن."

msgid "412"
msgstr "الذي ترفّع في هذا العالم عن التعلّق بأمور الخير والشرّ، والنقيّ الذي لا يشعر بالأسى، أسميه البراهمن."

msgid "413"
msgstr "الذي مثله مثل القمر، نقيّ وواضح وبلا فساد، ومن تخلّص من السرور بهذا الوجود، أسميه البراهمن."

msgid "414"
msgstr "الذي تغلّب على هذه الطريق الصعبة، طريق السمسارا والوهم، والذي عبر إلى الشاطئ البعيد، والذي يتدرّب على التأمل، والذي يحيا في سلام تامّ لأنه لا يتشبث بشيء، أسميه البراهمن."

msgid "415"
msgstr "من تخلّى في هذا العالم عن المتع الحسّية، واتخذ التجوال بدلاً من حياة المنازل، والذي تخلّص من الشهوات الحسّية والوجود الحالي، أسميه البراهمن."

msgid "416"
msgstr "من تخلّى في هذا العالم عن الاشتباه، واتخذ التجوال بدلاً من حياة المنازل، والذي تخلّص من الاشتباه والوجود الحالي، أسميه البراهمن."

msgid "417"
msgstr "من تخلّى عن التعلّق بقيود حياة البشر، وسما فوق التعلق بحياة كائنات الديفا، ومن تخلّى عن كل القيود، أسميه البراهمن."

msgid "418"
msgstr "من تخلّى عن السرور وضدّه، وقد انطفأ فيه الرغبة الشديدة وغزا العالم، هذا البطل أسميه البراهمن."

msgid "419"
msgstr "من يعرفُ كلّ تفاصيل موت الكائنات وإعادة ميلادها، والذي خلا من التعلّق، وذو الحظّ، والمستنيرُ، أسميه البراهمن."

msgid "420"
msgstr "هذا الذي لا يعلمُ أحدٌ من الكائنات، سواءً الديفا أم الغندابا أم الناس إلى أين منتهاه، والذي تخلّص من السموم الأخلاقية، أسميه البراهمن."

msgid "421"
msgstr "مَن لا يتعلق بأي شيء في الماضي أو الحاضر أو المستقبل، ومن خلا من الجشع، أسميه البراهمن."

msgid "422"
msgstr "هذا المحارب كالثور، هذا البطل والحكيم والذي يخلو من الرغبات ومن كلّ ما يتحرّك في داخله من انفعالات، والذي نقّى نفسه من كلّ الفساد، والمستنير، أسميه البراهمن."

msgid "423"
msgstr "مَن يعرفُ كلّ الحيوات السابقة له، ومن يرى عوالم التعاسة وعوالم البهجة، ومَن أنهى دائرة إعادة الميلاد بالنسبة إليه، هو حكيمٌ أتمّ المعرفة العليا، وأتمّ كلّ ما يُمكن إتمامه، وأسميه البراهمن."

msgid "title"
msgstr "ذامابادا"

msgid "chaps"
msgstr "فصول"

msgid "fontsize"
msgstr "حجم الخط"

msgid "chap1"
msgstr "الأزواج"

msgid "1"
msgstr ""
"النوايا تشكل الخبرات؛ النية هي الأصل، وهي صانعة التجارب. "
"إن تكلمت أو فعلت بنية فاسدة، "
"يتبعك الشقاء، كما تتبع العجلة حافر الثور."

msgid "2"
msgstr ""
"النوايا تشكل الخبرات؛ النية هي الأصل، وهي صانعة التجارب. "
"إن تكلمت أو فعلت بنية صافية، "
"تتبعك السعادة كظلك الذي لا يفارقك أبداً."

msgid "3"
msgstr ""
"«شتموني، ضربوني! قهروني، سرقوني!» "
"من يحملون مثل هذه الضغينة، لن يهدأ كرههم أبداً."

msgid "4"
msgstr ""
"«شتموني، ضربوني! قهروني، سرقوني!» "
"من لا يحملون مثل هذه الضغينة، يهدأ كرههم ويسكن."

msgid "5"
msgstr ""
"فالكره لا ينتهي بالكره أبداً، بل ينتهي بالحب: "
"هذا تعليم أزلي."

msgid "6"
msgstr ""
"عندما لا يفهم الآخرون، فلنكبح نحن -الذين نفهم هذا- "
"أنفسنا في هذا الشأن؛ فهكذا تنتهي الصراعات."

msgid "7"
msgstr ""
"أولئك الذين يتأملون في الجمال، بلا كبح لملكاتهم، "
"مسرفون في الأكل، كسالى، ومفتقرون للطاقة: "
"يطرحهم «مارا» أرضاً كما تقتلع الريح شجرة ضعيفة."

msgid "8"
msgstr ""
"أولئك الذين يتأملون في غير الجميل، وملكاتهم مكبوحة جيداً، "
"معتدلون في الأكل، مخلصون ونشيطون: "
"لا يستطيع «مارا» طرحهم أرضاً، كما لا تهز الريح جبلاً صخرياً."

msgid "9"
msgstr ""
"من يرتدي الثوب المصفر وهو لم يتطهر من دنسه، "
"مفتقراً لضبط النفس وللحقيقة: فإنه لا يستحق ذلك الثوب."

msgid "10"
msgstr ""
"من طهر نفسه من كل دنس، وثبت في الأخلاق، "
"وتحلى بضبط النفس وبالحقيقة، فإنه حقاً يستحق الثوب المصفر."

msgid "11"
msgstr ""
"من يظن أن غير الجوهري جوهري، ويرى الجوهري غير جوهري؛ "
"لن يدرك الجوهر أبداً، لأن الأفكار الخاطئة هي موطنه."

msgid "12"
msgstr ""
"من عرف الجوهري كجوهري، وغير الجوهري كغير جوهري؛ "
"يدرك الجوهر، لأن الأفكار الصائبة هي موطنه."

msgid "13"
msgstr ""
"كما يتسرب المطر إلى بيت رديء السقف، "
"تتسرب الشهوة إلى عقل غير مطور."

msgid "14"
msgstr ""
"كما لا يتسرب المطر إلى بيت جيد السقف، "
"لا تتسرب الشهوة إلى عقل مطور جيداً."

msgid "15"
msgstr ""
"هنا يحزنون، وفي الآخرة يحزنون، فاعل الشر يحزن في كلي الطرفين. "
"يحزن ويضطرب، حين يرى فساد أعماله."

msgid "16"
msgstr ""
"هنا يفرحون، وفي الآخرة يفرحون، فاعل الخير يفرح في كلي الطرفين. "
"يفرح ويبتهج، حين يرى طهر أعماله."

msgid "17"
msgstr ""
"هنا يُعذبون، وفي الآخرة يُعذبون، "
"فاعل الشر يُعذب في كلي الطرفين. "
"يُعذب لتفكيره في السوء الذي اقترفه؛ "
"وحين يمضي إلى مكان بئيس، يُعذب أكثر فأكثر."

msgid "18"
msgstr ""
"هنا ينعمون، وفي الآخرة ينعمون، فاعل الخير ينعم في كلي الطرفين. "
"ينعم لتفكيره في الخير الذي اقترفه؛ "
"وحين يمضي إلى مكان طيب، ينعم أكثر فأكثر."

msgid "19"
msgstr ""
"حتى وإن ردد المرء الكتب المقدسة كثيراً، وهو مهمل لا يطبقها، "
"فهو كراعٍ يعد ماشية الآخرين، "
"تفوته بركات الحياة الزاهدة."

msgid "20"
msgstr ""
"حتى وإن لم يردد إلا القليل، لكنه يعيش وفقاً للتعاليم، "
"تاركاً الطمع والكراهية والضلال، ببصيرة عميقة "
"وقلب متحرر، غير متمسك بهذه الحياة ولا بالآتية، "
"فإنه ينال نصيبه من بركات الحياة الزاهدة."

msgid "chap2"
msgstr "اليقظة"

msgid "21"
msgstr ""
"الحذر هو سبيل الخلود؛ "
"والإهمال هو سبيل الموت. "
"الحذرون لا يموتون، "
"بينما المهملون كالأموات."

msgid "22"
msgstr ""
"بفهم هذا التمييز في مسألة اليقظة، "
"يبتهج الحكماء باليقظة، "
"سعداء في رحاب النبلاء."

msgid "23"
msgstr ""
"أولئك الذين يتأملون بانتظام، مثابرون بنشاط دائماً؛ "
"اليقظون يدركون الانطفاء (النيرفانا)، "
"الملاذ الأسمى من القيود."

msgid "24"
msgstr ""
"من كان مجتهداً ويقظاً، طاهر الفعل ومنتبهاً، "
"منضبطاً، يعيش باستقامة وحذر، "
"فإن صيته ينمو ويزداد."

msgid "25"
msgstr ""
"بالاجتهاد واليقظة، وبالانضباط وضبط النفس، "
"يبني الإنسان الفطن لنفسه جزيرة "
"لا تغمرها الفيضانات أبداً."

msgid "26"
msgstr ""
"الحمقى والجهلاء يسلمون أنفسهم للإهمال. "
"أما الحكماء فيصونون اليقظة كأثمن كنوزهم."

msgid "27"
msgstr ""
"لا تسلم نفسك للإهمال، ولا تنغمس في لذات الهوى. "
"لأنك إن كنت يقظاً ومتأملاً، "
"ستنال سعادة وافرة."

msgid "28"
msgstr ""
"عندما يطرد الفطين الإهمال باليقظة، "
"ويرتقي قصر الحكمة بلا حزن، "
"يرقب هذا الجيل الغارق في الأسى، كما يرقب المرء "
"من قمة الجبل الحمقى في الأسفل."

msgid "29"
msgstr ""
"يقظٌ بين المهملين، مستيقظٌ بينما الآخرون نيام— "
"الحكيم الحق يسبقهم، كفرس سريع يتجاوز هزيلاً."

msgid "30"
msgstr ""
"باليقظة صار «ماغافا» سيداً للآلهة. "
"الناس يمدحون اليقظة، بينما الإهمال مذموم دوماً."

msgid "31"
msgstr ""
"الناسك الذي يحب اليقظة، ويرى الخطر في الإهمال— "
"يتقدم كالنار، يحرق القيود كبيرة وصغيرة."

msgid "32"
msgstr ""
"الناسك الذي يحب اليقظة، ويرى الخطر في الإهمال— "
"لا يمكن لمثله أن يتراجع، وقد اقترب من الانطفاء."

msgid "chap3"
msgstr "العقل"

msgid "33"
msgstr ""
"العقل يرتجف ويضطرب، يصعب حراسته ويصعب كبحه. "
"ذوو البصيرة يقومونه، كما يقوم صانع السهام سهمه."

msgid "34"
msgstr ""
"كسمكة سُحبت من البحر وأُلقيت على الشاطئ، "
"يتخبط هذا العقل، محاولاً التخلص من سطوة «مارا»."

msgid "35"
msgstr ""
"صعبٌ كبحه، متقلبٌ، يحلُّ حيثما يشاء؛ "
"من الخير ترويض العقل؛ فالعقل المروض يقود إلى الغبطة."

msgid "36"
msgstr ""
"يصعب رؤيته، غاية في اللطف، يحلُّ حيثما يشاء؛ "
"ذوو البصيرة يحمون العقل، فالعقل المحروس يقود إلى الغبطة."

msgid "37"
msgstr ""
"العقل يسافر بعيداً، يهيم وحيداً؛ بلا جسد، يكمن في القلب. "
"أولئك الذين يكبحون العقل يتحررون من قيود «مارا»."

msgid "38"
msgstr ""
"من كان عقله مضطرباً، ولا يفهم التعليم الحق، "
"وتتذبذب ثقته، لن تكتمل حكمته أبداً."

msgid "39"
msgstr ""
"من كان عقله غير ملوث، وقلبه غير جريح، "
"وقد تخلى عن الثواب والعقاب، يقيظاً، فلا يخشى شيئاً."

msgid "40"
msgstr ""
"عارفاً أن هذا الجسد ينكسر كالفخار، ومحصناً العقل كالقلعة، "
"هاجم «مارا» بسيف الحكمة، واحرس غنيمتك، ولا تستكن أبداً."

msgid "41"
msgstr ""
"عما قريب سيسكن هذا الجسد فوق الأرض، "
"فاقداً للوعي، ملقىً كخشبٍ لا قيمة له."

msgid "42"
msgstr ""
"العقل الموجه خطأً يلحق بك ضرراً "
"أشد مما يلحقه كارهٌ بمكروه، أو عدوٌ لعدوه."

msgid "43"
msgstr ""
"العقل الموجه صواباً يقدم لك خيراً "
"أكثر مما يقدمه لك أبوك أو أمك أو أي قريب آخر."

msgid "chap4"
msgstr "الأزهار"

msgid "44"
msgstr ""
"من يروض هذه الأرض، وعالم «ياما» مع آلهته؟ "
"من ينسق كلمة الحق الحكيمة، كما ينسق الخبير زهرة؟"

msgid "45"
msgstr ""
"التلميذ يروض هذه الأرض، وعالم «ياما» مع آلهته. "
"التلميذ ينسق كلمة الحق الحكيمة، كما ينسق الخبير زهرة."

msgid "46"
msgstr ""
"عارفاً أن هذا الجسد كزبد البحر، مدركاً أنه مجرد سراب، "
"وقاطعاً براعم «مارا»، يختفي المرء عن ملك الموت."

msgid "47"
msgstr ""
"كما يكتسح فيضان عارم قرية نائمة، يختطف الموت "
"الإنسان وهو يقطف الأزهار، وعقله غارق فيها."

msgid "48"
msgstr ""
"المفني يسيطر على الإنسان الذي لم يشبع من لذاته، "
"حتى وهو يقطف الأزهار، وعقله غارق فيها."

msgid "49"
msgstr ""
"تأخذ النحلة الرحيق وتمضي، دون أن تمس جمال الزهرة "
"أو عطرها؛ هكذا ينبغي للحكيم أن يسير في القرية."

msgid "50"
msgstr ""
"لا تتبع عيوب الآخرين، ولا ما فعلوه أو تركوه. "
"عليك فقط مراقبة نفسك، وما فعلته أو تركته."

msgid "51"
msgstr ""
"كزهره بهية ذات لون ولكن بلا عطر؛ "
"كذلك الكلام البليغ لا ثمرة له لمن لا يعمل به."

msgid "52"
msgstr ""
"كزهره بهية ذات لون وعطر معاً، "
"كذلك الكلام البليغ مثمرٌ لمن يعمل به."

msgid "53"
msgstr ""
"كما يصنع المرء قلائد كثيرة من كومة أزهار، "
"كذلك على الإنسان حين يولد أن يفعل الكثير من الأمور الخيرة."

msgid "54"
msgstr ""
"عطر الأزهار لا ينتشر عكس الريح، ولا خشب الصندل، "
"ولا الياسمين؛ لكن عطر الأخيار ينتشر عكس الريح؛ "
"فضيلة الإنسان الحق تفوح في كل اتجاه."

msgid "55"
msgstr ""
"بين كل العطور —الصندل أو اللوتس أو الياسمين— "
"يبقى عطر الفضيلة هو الأسمى."

msgid "56"
msgstr ""
"خافتٌ هو عطر الصندل أو الرياحين؛ "
"لكن عطر الفضلاء يرتفع حتى يبلغ أعلى الآلهة."

msgid "57"
msgstr ""
"أولئك المكتملون في الأخلاق، المتأملون بيقظة، "
"المتحررون بالحكمة الأسمى، لا يجد «مارا» إلى دربهم سبيلاً."

msgid "58"
msgstr ""
"من كومة نفايات ملقاة على الطريق، "
"قد تتفتح زهرة لوتس، فواحة وبهيجة."

msgid "59"
msgstr ""
"كذلك، بين من يُحسبون نفاية، "
"يتألق تلميذ «بوذا» الكامل "
"بحكمته فوق العوام العميان."

msgid "chap5"
msgstr "الأحمق"

msgid "60"
msgstr ""
"الليل طويل على الساهر؛ والميل طويل على المتعب؛ "
"والتيه طويل على الحمقى الذين لا يفهمون التعليم الحق."

msgid "61"
msgstr ""
"إن لم تجد في ترحالك رفيقاً يماثلك أو يفوقك، "
"فاعزم على السير وحيداً؛ فلا رفقة في الحمقى."

msgid "62"
msgstr ""
"«الأبناء لي، والثروة لي»— هكذا يضطرب الأحمق. "
"بينما حتى نفسه ليست ملكه، فكيف بأبنائه أو ثروته."

msgid "63"
msgstr ""
"الأحمق الذي يعرف أنه أحمق، هو حكيم إلى هذا الحد. "
"أما الأحمق الحق فهو من يتوهم أنه حكيم."

msgid "64"
msgstr ""
"حتى لو لازم الأحمق الحكيم طيلة حياته، "
"فلن يفهم التعليم أبداً، كالملعقة التي لا تعرف طعم الحساء."

msgid "65"
msgstr ""
"أما الفطن، فلو لازم الحكيم ولو لساعة، "
"فإنه يدرك التعليم سريعاً، كاللسان الذي يعرف طعم الحساء."

msgid "66"
msgstr ""
"الحمقى والجهلاء يتصرفون كأعداء لأنفسهم، "
"يقترفون آثاماً تنضج كثمار مرة."

msgid "67"
msgstr ""
"ليس من الخير فعل أمرٍ يندم عليه المرء لاحقاً، "
"فيبكي وينوح، حين تلازمه عواقبه."

msgid "68"
msgstr ""
"من الخير فعل أمرٍ لا يندم عليه المرء لاحقاً، "
"بل يسعده ويبهجه، حين تلازمه عواقبه."

msgid "69"
msgstr ""
"يتخيل الأحمق أن الشر حلو ما دام لم ينضج بعد. "
"ولكن بمجرد أن ينضج ذلك الشر، يقع في الشقاء."

msgid "70"
msgstr ""
"قد يأكل الأحمق طعامه بطرف نصل عشب شهراً بعد شهر؛ "
"لكنه لن يساوي جزءاً من ستة عشر ممن فقهوا التعليم."

msgid "71"
msgstr ""
"فالعمل السيء لا يفسد سريعاً كاللبن. "
"بل يتبع الأحمق كجمرٍ يشتعل تحت الرماد."

msgid "72"
msgstr ""
"كل شهرة ينالها الأحمق لا تجلب له إلا الضرر. "
"تحطم كل ميزة طيبة لديه، وتشتت فكره شذر مذر."

msgid "73"
msgstr ""
"قد يطلب المكانة التي يفتقدها، والجاه بين الرهبان؛ "
"والسلطة في الصوامع، والتكريم بين العائلات الأخرى."

msgid "74"
msgstr ""
"«ليظن الجميع أن العمل أُنجز بي وحدي. وفي كل ما يجب فعله، ليكن قراري هو الأعلى.» "
"هكذا يفكر الأحمق، بينما ينمو طمعه وكبرياؤه."

msgid "75"
msgstr ""
"فسبيل الربح وطريق الانطفاء أمران مختلفان تماماً. "
"الناسك تلميذ «بوذا»، بصلته لما يعنيه هذا حقاً، "
"لا ينبغي أن يفرح بالتكريم، بل عليه أن ينشد العزلة."

msgid "chap6"
msgstr "الفطين"

msgid "76"
msgstr ""
"اعتبر من يرى عيوبك كدليلٍ إلى كنز مخفي. "
"ابقَ قريباً ممن هو حكيم وفطين ويقومك حين تحتاج. "
"بالتمسك بمثل هذا الشخص المنصف، تتحسن الأمور ولا تسوء."

msgid "77"
msgstr ""
"انصح وأرشد؛ واكبح السوء: "
"فسيحبك الأخيار، ويكرهك الأشرار."

msgid "78"
msgstr ""
"لا تخالط رفاق السوء، ولا أراذل الناس. "
"خالط الرفاق الروحانيين، وخيرة الرجال."

msgid "79"
msgstr ""
"بالفرح في التعليم تنام هانئاً، بقلبٍ صافٍ وواثق. "
"الفطين يبتهج دوماً بالتعليم الذي أعلنه النبلاء."

msgid "80"
msgstr ""
"السقاة يوجهون الماء، وصناع السهام يقومون النبال، "
"والنجارون يشكلون الخشب، أما الفطناء فيروضون أنفسهم."

msgid "81"
msgstr ""
"كما لا تحرك الريح صخرة صماء، "
"كذلك لا يتأثر الحكماء بمدحٍ أو ذم."

msgid "82"
msgstr ""
"كبحيرة عميقة، صافية ونقية، "
"كذلك يصفو الفطناء حين يسمعون التعاليم."

msgid "83"
msgstr ""
"الأخيار يتخلون عن كل شيء، ولا يتملقون لنيل ما يشتهون. "
"سواء مسهم الحزن أو الفرح، "
"لا يظهر الفطناء محبطين ولا منتشين."

msgid "84"
msgstr ""
"لا تتمنَّ النجاح بوسائل غير عادلة، لنفسك أو لغيرك، "
"طمعاً في ولد أو مال أو وطن؛ بل كن صالحاً وحكيماً وعادلاً."

msgid "85"
msgstr ""
"قليلون هم من البشر من يعبرون إلى الشاطئ الآخر. "
"أما البقية فيركضون على الشاطئ القريب."

msgid "86"
msgstr ""
"حين يُشرح التعليم جيداً، فإن أولئك الذين يمارسونه "
"سيعبرون ملكوت الموت الذي يصعب اجتيازه."

msgid "87"
msgstr ""
"على الفطين أن يتخلص من الصفات المظلمة ويطور المضيئة. "
"تاركاً حياة البيت إلى العزلة التي يصعب الاستمتاع بها،"

msgid "88"
msgstr ""
"ليحاول إيجاد القناعة هناك، تاركاً خلفه اللذات الحسية. "
"بلا ملكية، على الفطين أن يطهر نفسه من شوائب العقل."

msgid "89"
msgstr ""
"أولئك الذين تطورت عقولهم حقاً في عوامل اليقظة؛ "
"الذين بتركهم للتعلق يبتهجون بعدم التملك: "
"بانقضاء شوائبهم، وبإشراقهم، ينطفئون (يتحررون) في هذا العالم."

msgid "chap7"
msgstr "المكتملون"

msgid "90"
msgstr ""
"في نهاية الرحلة، تخلصوا من الأسى؛ أحرارٌ في كل مكان، "
"تخلوا عن كل القيود، فلا اضطراب فيهم."

msgid "91"
msgstr ""
"اليقظون يجتهدون؛ لا يهنؤون بمستقر. "
"كالبجع الذي غادر المستنقع، يتركون بيتاً وراء بيت."

msgid "92"
msgstr ""
"أولئك الذين لا يدخرون شيئاً، وفهموا طبيعة طعامهم، "
"ومجالهم هو التحرر من العلامات والفراغ: "
"يصعب تتبع أثرهم، كالطيور في السماء."

msgid "93"
msgstr ""
"من انتهت شوائبه، ولم يعد متعلقاً بطعام؛ "
"ومجاله هو التحرر من العلامات والفراغ: "
"يصعب تتبع مساره، كالطيور في السماء."

msgid "94"
msgstr ""
"من سكنت ملكاته، كخيول روضها سائس، "
"من تخلى عن الكبرياء والشوائب؛ "
"هذا الذي لم يعد يتأثر تغبطه حتى الآلهة."

msgid "95"
msgstr ""
"هادئٌ كالأرض، مخلصٌ لعهوده، ثابتٌ كعمود إندرا، "
"كبحيرة خالية من الوحل؛ مثل هذا لا يعود للتيه."

msgid "96"
msgstr ""
"عقله هادئ، هادئٌ قوله وفعله. "
"مثل هذا في سلام، تحرر حقاً بالاستنارة."

msgid "97"
msgstr ""
"بلا إيمان أعمى، محطمٌ للقيود، من لا يقر بشيء (من الأوهام)، "
"منقطع الأمل (الدنيوي)، قد استغل فرصته: هذا هو حقاً الإنسان الأسمى!"

msgid "98"
msgstr ""
"سواء في قرية أو برية، في وادٍ أو مرتفعات، "
"حيثما يحل المكتملون، فذاك مكان مبهج."

msgid "99"
msgstr ""
"مبهجة هي البراري حيث لا يلهو الناس. "
"هناك يسعد الخالون من الطمع، لا الباحثون عن اللذات الحسية."

msgid "chap8"
msgstr "الألوف"

msgid "100"
msgstr ""
"خير من ألف كلمة لا معنى لها، كلمة واحدة ذات مغزى، "
"سماعها يمنحك السلام."

msgid "101"
msgstr ""
"خيرٌ من ألف بيتِ شعرٍ لا معنى له، بيتٌ واحدٌ ذو مغزى، "
"سماعه يمنحك السلام."

msgid "102"
msgstr ""
"خيرٌ من تلاوة مئة بيتٍ لا معنى لها، قولةٌ واحدةٌ من الحكمة (الداما)، "
"سماعها يمنحك السلام."

msgid "103"
msgstr ""
"ليس الفاتح الأسمى من يهزم مليون رجل في معركة، "
"بل هو من يهزم رجلاً واحداً: نفسه."

msgid "104"
msgstr ""
"من المؤكد أن قهر النفس خيرٌ من قهر سائر الخلق. "
"عندما يروض الإنسان نفسه، عيشاً في انضباط دائم،"

msgid "105"
msgstr ""
"لا إله، ولا كائن، ولا «مارا»، ولا ملاك، يمكنه إبطال نصر "
"شخصية كهذه."

msgid "106"
msgstr ""
"بدلاً من تقديم ألف قربان كل شهر لقرنٍ كامل، "
"خيرٌ للمرء أن يكرم لساعة واحدة من طوّر نفسه. "
"ذاك الإكرام خيرٌ من قرنٍ من القرابين."

msgid "107"
msgstr ""
"بدلاً من خدمة النار المقدسة في الغابة لمئة عام، "
"خيرٌ للمرء أن يكرم لساعة واحدة شخصية طوّرت نفسها. "
"ذاك الإكرام خيرٌ من مئة عام من الخدمة."

msgid "108"
msgstr ""
"كل ما قد يقدمه طالب الفضل من تضحية أو قربان في العالم لعامٍ كامل، "
"لا يساوي ربع فضل الانحناء لمن استقام قلبه."

msgid "109"
msgstr ""
"من اعتاد الانحناء، وإكرام الشيوخ دوماً، "
"تنمو له أربع بركات: العمر، والجمال، والسعادة، والقوة."

msgid "110"
msgstr ""
"أن تعيش يوماً واحداً بخلقٍ قويمٍ ومستغرقاً في التأمل، "
"خيرٌ من مئة عام بلا أخلاقٍ وبلا تركيز."

msgid "111"
msgstr ""
"أن تعيش يوماً واحداً حكيماً ومستغرقاً في التأمل، "
"خيرٌ من مئة عامٍ من الطيش والشرود."

msgid "112"
msgstr ""
"أن تعيش يوماً واحداً بنشاطٍ وقوة، "
"خيرٌ من مئة عامٍ من الكسل والفتور."

msgid "113"
msgstr ""
"أن تعيش يوماً واحداً مدركاً لظهور الأشياء وزوالها، "
"خيرٌ من مئة عامٍ أعمى عن هذا الظهور والزوال."

msgid "114"
msgstr ""
"أن تعيش يوماً واحداً مدركاً لحالة الخلود (ما وراء الموت)، "
"خيرٌ من مئة عامٍ أعمى عن حالة الخلود."

msgid "115"
msgstr ""
"أن تعيش يوماً واحداً مدركاً للتعليم الأسمى، "
"خيرٌ من مئة عامٍ أعمى عن التعليم الأسمى."

msgid "chap9"
msgstr "الشر"

msgid "116"
msgstr ""
"سارع إلى فعل الخير، واحرس عقلك من الشر؛ "
"فمن تباطأ في فعل الخير، وجدت أفكاره في الشر لذة."

msgid "117"
msgstr ""
"إن فعلت سوءاً، فلا تكرره مراراً، "
"ولا تعلق قلبك به، فإن تراكم الشر شقاء."

msgid "118"
msgstr ""
"إن فعلت خيراً، فافعله مراراً وتكراراً، "
"وعلق قلبك به، فإن تراكم الخير بهجة."

msgid "119"
msgstr ""
"حتى الشرير يرى الخير، ما دام شره لم ينضج بعد. "
"ولكن بمجرد أن ينضج ذاك الشر، يرى الشرير عواقب شره."

msgid "120"
msgstr ""
"وحتى الصالح يرى السوء، ما دام صلاحه لم ينضج بعد. "
"ولكن بمجرد أن ينضج ذاك الصلاح، يرى الصالح عواقب صلاحه."

msgid "121"
msgstr ""
"لا تستهن بالشر، ظاناً أنه لن يدركك. "
"الوعاء يمتلئ بقطرات الماء المتساقطة واحدة تلو الأخرى؛ "
"والأحمق يمتلئ شراً بتراكم السوء شيئاً فشيئاً."

msgid "122"
msgstr ""
"لا تستهن بالخير، ظاناً أنه لن يدركك. "
"الوعاء يمتلئ بقطرات الماء المتساقطة واحدة تلو الأخرى؛ "
"واليقيظ يمتلئ خيراً بتراكم الصلاح شيئاً فشيئاً."

msgid "123"
msgstr ""
"تجنب الشر، كما يتجنب تاجرٌ ذو بضاعة ثمينة وحرس قليل "
"طريقاً خطراً، أو كما يتجنب محب الحياة شرب السم."

msgid "124"
msgstr ""
"يمكنك حمل السم في يدك إن لم يكن بها جرح، "
"فالسم لا ينفذ من غير جرح؛ "
"ولا يصيبك سوء ما لم تقترف سوءاً."

msgid "125"
msgstr ""
"من يظلم إنساناً لا ذنب له، طاهراً لا شائبة فيه، "
"يرتد الشر على الأحمق، كغبارٍ دقيقٍ يُلقى في وجه الريح."

msgid "126"
msgstr ""
"البعض يولد في رحم؛ وفاعلو الشر يمضون إلى الجحيم؛ "
"والصالحون يمضون إلى الجنة؛ أما الأطهار فينطفئون تماماً (يتحررون)."

msgid "127"
msgstr ""
"ليس في أعالي الجو، ولا في أعماق المحيط، ولا في شقوق الجبال؛ "
"لن تجد مكاناً على الكوكب تهرب فيه من عواقب أفعالك الشريرة."

msgid "128"
msgstr ""
"ليس في أعالي الجو، ولا في أعماق المحيط، ولا في شقوق الجبال؛ "
"لن تجد مكاناً على الكوكب لا يقهرك فيه الموت."

msgid "chap10"
msgstr "العصا"

msgid "129"
msgstr ""
"الكل يرتجف من العصا، والكل يخشى الموت. "
"عامل الآخرين كنفسك؛ فلا تقتل ولا تحرض على القتل."

msgid "130"
msgstr ""
"الكل يرتجف من العصا، والكل يحب الحياة. "
"عامل الآخرين كنفسك؛ فلا تقتل ولا تحرض على القتل."

msgid "131"
msgstr ""
"الكائنات تحب السعادة، فإذا آذيتهم بعصاك "
"بحثاً عن سعادتك الخاصة، فلن تجد السعادة بعد الموت."

msgid "132"
msgstr ""
"الكائنات تحب السعادة، فإذا لم تؤذهم بعصاك "
"بحثاً عن سعادتك الخاصة، ستجد السعادة بعد الموت."

msgid "133"
msgstr ""
"لا تتحدث بخشونة، فقد يردون عليك بمثلها. "
"فالكلام الهجومي مؤلم، والعصا قد ترتد إليك."

msgid "134"
msgstr ""
"إن أسكتَّ نفسك كجرسٍ مكسور، "
"فقد بلغت الانطفاء ولم تعد تعرف النزاع."

msgid "135"
msgstr ""
"كما يسوق الراعي الماشية إلى المرعى بالعصا، "
"كذلك يسوق الهرم والموت حياة الكائنات الحية."

msgid "136"
msgstr ""
"الأحمق لا يدرك السوء الذي يقترفه. "
"لكن بسبب تلك الأفعال، يُعذب الجاهل كأنما تحرقه النار."

msgid "137"
msgstr ""
"من يهاجم بعنف المسالمين والأبرياء، "
"يسقط سريعاً في واحدة من عشر حالات بئيسة:"

msgid "138"
msgstr ""
"ألم شديد؛ أو خسارة؛ أو تحطم الجسد؛ أو مرض خطير؛ أو اضطراب عقلي؛"

msgid "139"
msgstr ""
"أو أذىً من الحكام؛ أو افتراء خبيث؛ أو فقد القريب؛ أو هلاك الثروة؛"

msgid "140"
msgstr ""
"أو أن تلتهم النار بيته. وحين يتحلل جسده، "
"يولد ذاك الطائش من جديد في الجحيم."

msgid "141"
msgstr ""
"ليس العري، ولا الشعر الملبد، ولا التلطخ بالوحل، ولا الصوم، ولا النوم على الأرض، "
"ولا التمرغ في التراب، ولا القرفصاء، "
"بمطهرٍ لإنسانٍ لم يتحرر من الشك."

msgid "142"
msgstr ""
"قد يكون متأنقاً في ثيابه، لكنه إن عاش بصلاح —هادئاً، مروضاً، "
"ملتزماً بالدرب الروحاني، تاركاً العنف تجاه كل الكائنات— "
"فهو الحكيم، والزاهد، والناسك."

msgid "143"
msgstr ""
"هل يوجد في العالم إنسان يكبح نفسه بوازع الضمير؟ "
"إنسان يهرب من الملامة، كما يهرب فرسٌ كريمٌ من السوط؟"

msgid "144"
msgstr ""
"كالفرس الكريم تحت السوط، كن فطناً وممتلئاً بالعزم. "
"بالإيمان، والأخلاق، والنشاط، والتركيز، وفحص المبادئ، "
"متمكناً في المعرفة والسلوك، يقظاً، تخلَّ عن هذا الشقاء العظيم."

msgid "145"
msgstr ""
"بينما السقاة يوجهون الماء، وصناع السهام يشكلون النبال، "
"والنجارون يشكلون الخشب — المخلصون لعهودهم يروضون أنفسهم."

msgid "chap11"
msgstr "الهرم"

msgid "146"
msgstr ""
"ما الفرح، وما الضحك، والنيران تشتعل دوماً؟ "
"وأنتم في غياهب الظلمة، ألا تبحثون عن نور؟"

msgid "147"
msgstr ""
"انظر إلى هذه الدمية المزخرفة، جسدٌ مبنيٌ من القروح، عليلٌ، مهووسٌ به، "
"لا يدوم فيه شيءٌ أبداً."

msgid "148"
msgstr ""
"هذا الجسد بالٍ وضعيف، وكرٌ للأمراض. "
"هذه الجيفة النتنة تتداعى، فالحياة تنتهي بالموت."

msgid "149"
msgstr ""
"هذه العظام الشاحبة ملقاة كقرعٍ يابسٍ في الخريف— "
"أي متعةٍ ترجى من رؤيتها؟"

msgid "150"
msgstr ""
"في هذه المدينة المبنية من العظام، والمكسوة باللحم والدم، "
"يُخزن الهرم والموت، ومعهم الكبرياء والاحتقار."

msgid "151"
msgstr ""
"عربات الملوك المزخرفة تبلى، وحتى هذا الجسد يهرم. "
"لكن حقيقة الأخيار لا تهرم أبداً— هكذا يقول الأخيار للأخيار."

msgid "152"
msgstr ""
"الإنسان قليل العلم يهرم كالثور— "
"ينمو لحمه، لكن لا تنمو حكمته."

msgid "153"
msgstr ""
"متنقلاً عبر ولادات لا تحصى، ارتحلت دون جدوى، "
"باحثاً عن باني البيت؛ فما أشد ألم الولادة المكررة."

msgid "154"
msgstr ""
"لقد رأيتك يا باني البيت! لن تبني بيتاً ثانية! "
"تحطمت كل دعائمك، وانهدم سقفك. "
"العقل، بعزمه على الهدم، قد بلغ نهاية الرغبات."

msgid "155"
msgstr ""
"في شبابهم نبذوا الدرب الروحاني وفشلوا في نيل أي ثروة. "
"الآن يكتئبون كطيور مالك الحزين العجوز في بركةٍ خالية من السمك."

msgid "156"
msgstr ""
"في شبابهم نبذوا الدرب الروحاني وفشلوا في نيل أي ثروة. "
"الآن يرقدون كسهامٍ مستهلكة، ينوحون على ما فات."

msgid "chap12"
msgstr "النفس"

msgid "157"
msgstr ""
"لو عرفت أن نفسك حبيبةٌ إليك، لرعيتها حق الرعاية. "
"في واحدة من ساعات الليل الثلاث، على الفطين أن يظل يقظاً."

msgid "158"
msgstr ""
"على الفطين أن يتجنب الفساد بأن يرسخ نفسه أولاً "
"فيما هو لائق، ثم يرشد الآخرين."

msgid "159"
msgstr ""
"لو عامل المرء نفسه كما يرشد غيره، "
"لأفلح المروض في الترويض حقاً: فترويض النفس، كما يبدو، عسير."

msgid "160"
msgstr ""
"المرء هو سيد نفسه، فمن غيره يكون له سيداً؟ "
"بالنفس المروضة جيداً، ينال المرء سيداً نادراً بحق."

msgid "161"
msgstr ""
"فالشر الذي يقترفه المرء بنفسه، والنابع والمتولد من نفسه، "
"يسحق الجاهل، كما يسحق الماس حجراً كريماً أدنى منه."

msgid "162"
msgstr ""
"من خنقته الفجور، كما تخنق اللبلابة شجرة ضخمة، "
"يفعل بنفسه ما لا يتمناه له إلا عدوه."

msgid "163"
msgstr ""
"من السهل فعل الأمور السيئة الضارة بالنفس، "
"لكن الأمور الطيبة النافعة هي أصعب ما يمكن فعله."

msgid "164"
msgstr ""
"بسبب الآراء الفاسدة —والاستخفاف بإرشاد المكتملين "
"والنبلاء الذين يعيشون باستقامة— يجلب الأحمق دمار نفسه، "
"كما تهلك شجرة الخيزران حين تثمر."

msgid "165"
msgstr ""
"فبالنفس يُفعل الشر، وبالنفس يتلوث المرء. "
"وبالنفس يُترك الشر، وبالنفس يتطهر المرء. "
"الطهر والدنس أمران شخصيان، ولا يمكن لأحد أن يطهر غيره."

msgid "166"
msgstr ""
"لا تهمل أبداً ما فيه خير لنفسك لأجل غيرك، مهما عظم شأنه. "
"بمعرفتك اليقينة بما هو خيرٌ لنفسك، كن عازماً على بلوغ هدف قلبك."

msgid "chap13"
msgstr "العالم"

msgid "167"
msgstr ""
"لا تركن إلى الأمور الدنيئة، ولا تقم في الإهمال، "
"لا تركن إلى الآراء الخاطئة، ولا تطل أمد بقائك في العالم."

msgid "168"
msgstr ""
"انهض، لا تكن غافلاً، عِش بالمبادئ والسلوك القويم. "
"فمن استقام سلوكه ينام هانئاً، في هذا العالم وفي الآتي."

msgid "169"
msgstr ""
"عِش بالمبادئ والسلوك القويم، ولا تسلك مسالك السوء. "
"فمن استقام سلوكه ينام هانئاً، في هذا العالم وفي الآتي."

msgid "170"
msgstr ""
"انظر إلى العالم كفقاعة أو سراب، "
"عندها لن يراك ملك الموت."

msgid "171"
msgstr ""
"تعال، انظر إلى هذا العالم المزين كعربة ملكية فاخرة. "
"هنا يغرق الحمقى، أما ذوو البصيرة فلا تقيدهم السلاسل."

msgid "172"
msgstr ""
"من كان يوماً غافلاً ثم تاب إلى اليقظة، "
"يضيء العالم كالقمر حين يخرج من بين الغيوم."

msgid "173"
msgstr ""
"من استبدل فعله السيء بفعلٍ حسن، "
"يضيء العالم كالقمر حين يخرج من بين الغيوم."

msgid "174"
msgstr ""
"العالم أعمى، وقليلون هم من يبصرون بوضوح. "
"حفنةٌ فقط تذهب إلى الجنة، كطائرٍ نجا من شبكة."

msgid "175"
msgstr ""
"البجع يطير في مسار الشمس، والحكماء يطيرون عبر الفضاء. "
"اليقظون يتركون العالم، بعد أن هزموا «مارا» وجيوشه."

msgid "176"
msgstr ""
"عندما يستخف المرء بالآخرة، ويخطئ في أمرٍ واحدٍ فقط — "
"الكذب — فلا يوجد شرٌ لن يقترفه."

msgid "177"
msgstr ""
"البخلاء لا يرتقون إلى الجنة، والأحمق فقط من لا يمدح العطاء. "
"اليقظون يحتفون بالعطاء، وبذلك يجدون السعادة في الآخرة."

msgid "178"
msgstr ""
"ثمرة دخول «التيار» خيرٌ من ملك الأرض قاطبة، "
"وخيرٌ من الذهاب إلى الجنة، ومن السيادة على العالم أجمع."

msgid "chap14"
msgstr "البوذا"

msgid "179"
msgstr ""
"من لا يمكن إبطال نصره، نصرٌ لا يضاهيه شيء في العالم؛ "
"بأي أثرٍ تقتفي ذاك «البوذا»، "
"وهو الذي لا يترك أثراً في مداه اللامتناهي؟"

msgid "180"
msgstr ""
"ليس له نصيبٌ من الرغبة، ذاك النسّاج المتمسك: فأين تقتفي أثره؟ "
"بأي أثرٍ تقتفي ذاك «البوذا»، "
"وهو الذي لا يترك أثراً في مداه اللامتناهي؟"

msgid "181"
msgstr ""
"اليقظون العازمون على الاستغراق، محبو سلام الزهد، "
"«البوذا»، الدائمو اليقظة، تغبطهم حتى الآلهة."

msgid "182"
msgstr ""
"من العسير نيل الولادة البشرية؛ وحياة البشر صعبة؛ "
"ومن العسير سماع التعليم الحق؛ وظهور «البوذا» عسير."

msgid "183"
msgstr ""
"اجتناب كل شر؛ واعتناق الخير؛ وتطهير العقل: "
"هذا هو تعليم «البوذا»."

msgid "184"
msgstr ""
"الصبر والتقبل هو التقى الأسمى. الانطفاء هو الغاية القصوى، "
"هكذا يقول «البوذا». لا يوجد زاهدٌ حق يؤذي غيره، "
"ولا يلحق عابدٌ ضرراً بغيره."

msgid "185"
msgstr ""
"عدم قول السوء وعدم إلحاق الضرر؛ والانضباط في العهد؛ "
"والاعتدال في الأكل؛ والمقام في الأماكن البعيدة؛ "
"والالتزام بالعقل السامي — هذا هو تعليم «البوذا»."

msgid "186"
msgstr ""
"حتى لو أمطرت السماء ذهباً، فلن تشبع من اللذات الحسية. "
"الفطين يدرك أن اللذات الحسية "
"تمنح قليل القناعة وكثير الشقاء."

msgid "187"
msgstr ""
"لذا فهم لا يجدون لذة حتى في النعيم السماوي. "
"تلميذ «البوذا» المستنير يبتهج بنهاية الرغبة."

msgid "188"
msgstr ""
"كثيرون يلجأون إلى الجبال والغابات، "
"وإلى المزارات في الحدائق؛ أولئك يسوقهم الخوف."

msgid "189"
msgstr ""
"لكن ذاك الملجأ ليس مأمناً، وليس بالملجأ الأسمى. "
"باللجوء إلى ذاك المكان، لن تتحرر من كل شقاء."

msgid "190"
msgstr ""
"أما من لجأ إلى «البوذا»، وإلى تعليمه وإلى «السانغا» (الجماعة)، "
"يرى الحقائق الأربع النبيلة بفهمٍ صحيح:"

msgid "191"
msgstr ""
"الشقاء، وأصل الشقاء، وتجاوز الشقاء، "
"والدرب الثماني النبيل الذي يؤدي إلى سكون الشقاء."

msgid "192"
msgstr ""
"ذاك الملجأ هو المأمن، وهو الملجأ الأسمى. "
"باللجوء إلى ذاك المقام، تتحرر من كل شقاء."

msgid "193"
msgstr ""
"من العسير العثور على إنسانٍ كريم المحتد: فهم لا يولدون في أي مكان. "
"العائلة التي يولد فيها ذاك اليقيظ تزدهر بالسعادة."

msgid "194"
msgstr ""
"طوبى لظهور «البوذا»! وطوبى لتعليم «الداما»! "
"طوبى لانسجام الجماعة، وسعي المنسجمين طوبى له."

msgid "195"
msgstr ""
"عندما يبجل المرء المستحقين — «البوذا» أو تلاميذه، "
"الذين تجاوزوا كثرة الأوهام، "
"وتركوا خلفهم الحزن والعويل،"

msgid "196"
msgstr ""
"المنطفئون، الذين لا يخشون شيئاً من أي جهة — فإن فضل من "
"يبجل أمثال هؤلاء، لا يمكن لأحدٍ أن يحصيه، "
"أو يقول إنه يبلغ هذا القدر فحسب."

msgid "chap15"
msgstr "السعادة"

msgid "197"
msgstr ""
"فلنعش بسعادة بالغة، محبين بين الحاقدين. "
"بين البشر الحاقدين، فلنعش بالمحبة."

msgid "198"
msgstr ""
"فلنعش بسعادة بالغة، أصحاء بين العليلين. "
"بين البشر العليلين، فلنعش بصحة."

msgid "199"
msgstr ""
"فلنعش بسعادة بالغة، قانعين بين الطامعين. "
"بين البشر الطامعين، فلنعش بقناعة."

msgid "200"
msgstr ""
"فلنعش بسعادة بالغة، نحن الذين لا نملك شيئاً. "
"سوف نقتات على الغبطة، كآلهة النور المشع."

msgid "201"
msgstr ""
"النصر يولد العداوة؛ فالمهزوم ينام مكسوراً. "
"أما المسالم فينام هانئاً، بعد أن ترك النصر والهزيمة وراءه."

msgid "202"
msgstr ""
"لا نار كالجشع، ولا جرم كالكراهية، "
"ولا شقاء كالارتباط بالخماسي (العناصر)، ولا غبطة تفوق السلام."

msgid "203"
msgstr ""
"الجوع هو أسوأ الأمراض، والارتباط بالظروف هو أسوأ الشقاء. "
"ولمن يعرف هذا حقاً، فإن الانطفاء هو السعادة القصوى."

msgid "204"
msgstr ""
"الصحة هي البركة الأسمى؛ والقناعة هي الثروة المثلى؛ "
"والثقة هي القرابة الأسمى؛ والانطفاء هو السعادة القصوى."

msgid "205"
msgstr ""
"بعد شرب رحيق العزلة ورحيق السلام— "
"تحرر من التوتر، وتحرر من السوء، واشرب رحيق الحق البهيج."

msgid "206"
msgstr ""
"من الخير رؤية النبلاء، والمقام معهم خيرٌ دائم. "
"لو لم ترَ الحمقى أبداً، لكنت دائماً سعيداً."

msgid "207"
msgstr ""
"فمن يصاحب الحمقى يحزن طويلاً. "
"العيش مع الحمقى مؤلم، كمن حُبس مع عدوه. "
"أما العيش مع اليقيظ فسعيد، كلقاء الأقرباء."

msgid "208"
msgstr ""
"لذلك: اليقيظ، الحكيم، المتعلّم، عظيم الفضيلة، "
"المخلص لعهوده، النبيل: اتبع شخصاً صادقاً وفطناً كهذا، "
"كما يتبع القمر مسارات النجوم."

msgid "chap16"
msgstr "المحبوب"

msgid "209"
msgstr ""
"ببذل جهدك فيما لا ينبغي، وإهمال ما يجب عليك فعله، "
"ونسيان هدفك، تتعلق بما تعزه، "
"حاسداً أولئك المخلصين لهدف قلوبهم."

msgid "210"
msgstr ""
"لا تقترب أبداً ممن تحبهم أو تبغضهم. "
"فعدم رؤية المحبوب شقاء، وكذلك رؤية المبغض."

msgid "211"
msgstr ""
"لذلك لا تعزّ شيئاً، فمن السوء فقدان من تحب. "
"لا توجد قيود فيمن لا يحمل حباً ولا بغضاً."

msgid "212"
msgstr ""
"الحزن ينبع مما نعزه، والخوف ينبع مما نعزه؛ "
"ومن تحرر من إعزاز الأشياء فلا حزن لديه، فكيف بالخوف."

msgid "213"
msgstr ""
"الحزن ينبع من التعلق، والخوف ينبع من التعلق؛ "
"ومن تحرر من التعلق فلا حزن لديه، فكيف بالخوف."

msgid "214"
msgstr ""
"الحزن ينبع من التلذذ، والخوف ينبع من التلذذ؛ "
"ومن تحرر من التلذذ فلا حزن لديه، فكيف بالخوف."

msgid "215"
msgstr ""
"الحزن ينبع من الرغبة، والخوف ينبع من الرغبة؛ "
"ومن تحرر من الرغبة فلا حزن لديه، فكيف بالخوف."

msgid "216"
msgstr ""
"الحزن ينبع من التوق، والخوف ينبع من التوق؛ "
"ومن تحرر من التوق فلا حزن لديه، فكيف بالخوف."

msgid "217"
msgstr ""
"المكتمل في الفضيلة والرؤية، الراسخ في المبادئ، والصادق، "
"الذي يفعل بنفسه ما يجب فعله: ذاك هو من يحبه الناس."

msgid "218"
msgstr ""
"التواق لإدراك ما لا يوصف، سيمتلئ بالوعي. "
"وعقله غير المقيد بلذات الحس، يُقال إنه يمضي عكس التيار."

msgid "219"
msgstr ""
"عندما يعود الرجل سالماً بعد زمن طويل في الغربة، "
"يحتفي الأهل والأصدقاء والأحبة بعودته."

msgid "220"
msgstr ""
"كذلك، عندما ينتقل فاعل الخير من هذا العالم إلى الآخر، "
"تستقبله أعماله الحسنة هناك، كما يرحب الأهل بعودة من يحبون."

msgid "chap17"
msgstr "الغضب"

msgid "221"
msgstr ""
"تخلَّ عن الغضب، وتخلص من الكبرياء، وانجُ من كل قيد. "
"الشقاء لا يصيب من لا يملك شيئاً، ولا يتمسك بالاسم والشكل."

msgid "222"
msgstr ""
"عندما يهيج الغضب كعربة مندفعة، فاحكم كبحه. "
"هذا ما أسميه سائساً؛ أما الآخرون فيكتفون بمسك الأعنة."

msgid "223"
msgstr ""
"اهزم الغضب باللطف، واللؤم بالفضيلة، "
"والبخل بالعطاء، والكذب بالحق."

msgid "224"
msgstr ""
"قل الحق، ولا تغضب، وأعطِ من سألك ولو القليل. "
"بهذه الوسائل الثلاث، قد تدخل في حضرة الآلهة."

msgid "225"
msgstr ""
"أولئك الحكماء المسالمون، المنضبطون دوماً في أجسادهم، "
"يمضون إلى الحالة التي لا تزول، حيث لا وجود للحزن."

msgid "226"
msgstr ""
"دائمو اليقظة، يمارسون ليل نهار، وتركيزهم فقط على الانطفاء، "
"تبلغ شوائبهم نهايتها."

msgid "227"
msgstr ""
"لطالما كان الأمر هكذا يا «أتولا»، ليس اليوم فقط. "
"يلومونك إن صمتّ، ويلومونك إن تكلمت كثيراً، "
"وحتى إن تكلمت باعتدال: لا أحد في العالم ينجو من الملامة."

msgid "228"
msgstr ""
"لم يوجد قط، ولن يوجد، ولا يوجد اليوم، "
"شخصٌ ممدوحٌ بالكامل أو مذمومٌ بالكامل."

msgid "229"
msgstr ""
"إن مدح ذوو البصيرة —بعد مراقبة يوماً بعد يوم— "
"ذاك الحكيم ذا السلوك المنزه، المتصف بالأخلاق والحكمة؛"

msgid "230"
msgstr ""
"كالذهب الخالص، من ذا الذي يجرؤ على انتقاده؟ "
"حتى الآلهة تمدحه، ومن لدن القدوس أيضاً هو ممدوح."

msgid "231"
msgstr ""
"احذر من أفعال الغضب، وكن منضبطاً في جسدك. "
"بتخليك عن سوء سلوك الجسد، سِر بجسدك في صلاح."

msgid "232"
msgstr ""
"احذر من كلمات الغضب، وكن منضبطاً في قولك. "
"بتخليك عن سوء سلوك القول، سِر بقولك في صلاح."

msgid "233"
msgstr ""
"احذر من أفكار الغضب، وكن منضبطاً في عقلك. "
"بتخليك عن سوء سلوك العقل، سِر بعقلك في صلاح."

msgid "234"
msgstr ""
"اليقيظ منضبط في جسده، ومنضبط أيضاً في قوله، "
"وفي فكره أيضاً هو منضبط: إنه منضبط في كل شيء."

msgid "chap18"
msgstr "الشوائب"

msgid "235"
msgstr ""
"أنت اليوم كورقة ذابلة، ورسل «ياما» (الموت) ينتظرونك. "
"تقف عند أبواب الرحيل، وليس معك زادٌ للطريق."

msgid "236"
msgstr ""
"اجعل من نفسك جزيرة! سارع بالاجتهاد، وتعلم الحكمة! "
"متطهراً من الشوائب، ومنزهاً، ستمضي إلى الملكوت السماوي للنبلاء."

msgid "237"
msgstr ""
"لقد قطعت مراحل الحياة، والآن تنطلق للقاء «ياما». "
"وليس في الطريق مستقر، ومع ذلك ليس معك زادٌ للطريق."

msgid "238"
msgstr ""
"اجعل من نفسك جزيرة! سارع بالاجتهاد، وتعلم الحكمة! "
"متطهراً من الشوائب، ومنزهاً، لن تعود ثانية للولادة والهرم."

msgid "239"
msgstr ""
"على الفطن أن يطهر شوائبه تدريجياً، "
"شيئاً فشيئاً، لحظة فلحظة، كصائغٍ يصفي الفضة."

msgid "240"
msgstr ""
"الصدأ المتولد من الحديد هو ما يأكل المعدن الذي نشأ فيه. "
"وكذلك أفعال المرء هي التي تقود المتجاوز إلى مكان بئيس."

msgid "241"
msgstr ""
"عدم الترديد شائبة الكتب. والإهمال شائبة البيوت. "
"الكسل شائبة الجمال. والغفلة شائبة الحارس."

msgid "242"
msgstr ""
"سوء السلوك شائبة المرأة. والبخل شائبة المعطي. "
"الصفات السيئة شائبة في هذا العالم وفي الآتي."

msgid "243"
msgstr ""
"لكن شائبة أسوأ من هذه هي الجهل، وهي أسوأ الشوائب قاطبة. "
"بعد التخلي عن تلك الشائبة، كونوا بلا شوائب أيها النساك!"

msgid "244"
msgstr ""
"الحياة سهلة لمن لا حياء له. بكل جرأة الغراب الوقحة، "
"يعيشون بصلف، ووقاحة، وفساد."

msgid "245"
msgstr ""
"الحياة صعبة لذوي الضمير الحريصين على الطهر، "
"الذين لا يتعلقون ولا يوقحون، طاهري المعاش وذوي بصيرة."

msgid "246"
msgstr ""
"خذ أي شخص في هذا العالم يقتل الكائنات الحية، "
"ويتحدث بالكذب، ويسرق، ويرتكب الزنا،"

msgid "247"
msgstr ""
"وينغمس في شرب المسكرات والخمور. "
"فهو هنا تحديداً يحفر جذور نفسه بنفسه."

msgid "248"
msgstr ""
"اعلم هذا يا صديقي: هؤلاء غير منضبطين وأشرار. "
"لا تدع ذاك الجشع والظلم يلحقان بك الألم طويلاً."

msgid "249"
msgstr ""
"الناس يعطون وفقاً لإيمانهم، ووفقاً لثقتهم. "
"فإن تضايقت من ذلك، ومن طعام وشراب الآخرين، "
"فلن تنغمس، ليلًا أو نهاراً، في التركيز السامي (السامادي)."

msgid "250"
msgstr ""
"أولئك الذين قطعوا دابر ذلك، واجتثوه من جذوره، وأبادوه، "
"سوف ينغمسون، ليلًا أو نهاراً، في التركيز السامي."

msgid "251"
msgstr ""
"لا نار كالجشع، ولا جرم كالكراهية، "
"لا شبكة كالضلال، ولا نهر كالتوق."

msgid "252"
msgstr ""
"من السهل رؤية عيوب الآخرين، ومن الصعب رؤية عيوب النفس. "
"فعيوب الآخرين تُنثر عالياً كالهشيم، "
"بينما تُخفى عيوب النفس، كما يخفي المخادع يداً رديئة."

msgid "253"
msgstr ""
"عندما تبحث عن زلات الآخرين، وتجد العيوب دائماً، "
"فإن شوائبك تزداد، وتغدو بعيداً عن إنهائها."

msgid "254"
msgstr ""
"في الفضاء لا يوجد أثر، ولا يوجد ناسك حق خارج هذا الطريق. "
"الناس يستمتعون بالتوسع (في الأوهام)، أما المستنيرون فمحررون من التوسع."

msgid "255"
msgstr ""
"في الفضاء لا يوجد أثر، ولا يوجد ناسك حق خارج هذا الطريق. "
"لا توجد ظروف تدوم للأبد، والمستيقظون لا يتزعزعون."

msgid "chap19"
msgstr "العادل"

msgid "256"
msgstr ""
"لا تصبح عادلاً بإصدار أحكام متسرعة. "
"على الفطين أن يقيم ما هو ذو صلة وما هو غير رديء."

msgid "257"
msgstr ""
"الحكيم يحكم على الآخرين دون تسرع، بعدل وإنصاف؛ "
"وذاك الحارس للقانون يُقال إنه عادل."

msgid "258"
msgstr ""
"لست عالماً فطيناً لمجرد أنك تتحدث كثيراً. "
"من كان آمناً، وخالياً من العداوة والخوف، يُقال إنه فطين."

msgid "259"
msgstr ""
"لست حافظاً للتعليم لمجرد أنك تكرره كثيراً. "
"من يرى التعليم مباشرة بعد سماع القليل فقط "
"هو حقاً من حفظ التعليم، لأنه لا ينساه أبداً."

msgid "260"
msgstr ""
"لا تصبح شيخاً بمجرد ظهور الشيب؛ "
"فمن نضج في العمر فقط، يُقال إنه هرم سُدى."

msgid "261"
msgstr ""
"من كان صادقاً وراسخاً في المبادئ، مسالماً، منضبطاً، "
"ومتحكماً في نفسه، يقيظاً، مطهراً من الشوائب، يُقال إنه شيخ."

msgid "262"
msgstr ""
"ليس بمجرد الفصاحة، أو بجمال البشرة "
"يصبح المرء قدسياً، إن كان حاسداً، بخيلاً، ومخادعاً."

msgid "263"
msgstr ""
"لكن إن قطع دابر ذلك، واجتثه من جذوره، وأباده، "
"فذاك الحكيم، المطهر من الرذائل، يُقال إنه قدسي."

msgid "264"
msgstr ""
"الكاذب وناكث العهود ليس ناسكاً بمجرد حلاقة رأسه. "
"كيف يمكن لمن هو ممتلئ بالرغبة والجشع أن يكون ناسكاً؟"

msgid "265"
msgstr ""
"من كفَّ عن كل أفعال السوء، كبيرها وصغيرها، "
"بسبب كفه عن تلك الأفعال يُقال إنه ناسك."

msgid "266"
msgstr ""
"لا تصبح ناسكاً بمجرد التسول من الآخرين. "
"من قام بالواجبات الدنيوية لم يصبح ناسكاً بعد."

msgid "267"
msgstr ""
"لكن من يعيش حياة روحانية، وقد نفى كلاً من الفضل والسوء، "
"ويسير متأملاً في العالم، يُقال إنه ناسك."

msgid "268"
msgstr ""
"لا تصبح حكيماً بالتظاهر بالحكمة، "
"وأنت لا تزال مرتبكاً وجاهلاً. "
"الفطين الذي يمسك الموازين، آخذاً الأفضل فقط،"

msgid "269"
msgstr ""
"ومتجنباً السيء — ذاك هو الحكيم، وهكذا يصبح المرء حكيماً. "
"من يزن الأمور بحكمة في العالم، يُقال عنه بذلك إنه حكيم."

msgid "270"
msgstr ""
"لا تصبح نبيلاً بإيذاء الكائنات الحية. "
"من كان مسالماً تجاه كل الكائنات الحية يُقال إنه نبيل."

msgid "271"
msgstr ""
"ليس بالوصايا والشعائر، ولا بكثرة العلم، "
"ولا بالاستغراق التأملي، ولا بالعيش في عزلة،"

msgid "272"
msgstr ""
"أختبر غبطة الزهد التي لا يرتادها عامة الناس. "
"لا يمكن للناسك أن يركن للثقة دون بلوغ نهاية الشوائب."

msgid "chap20"
msgstr "الدرب"

msgid "273"
msgstr ""
"من الدروب، الثماني هو الأفضل؛ ومن الحقائق، التصريحات الأربعة؛ "
"والتجرد هو أفضل الأشياء، والبصير هو أفضل البشر."

msgid "274"
msgstr ""
"هذا هو الدرب، ولا يوجد غيره لتطهير الرؤية. "
"عليكم جميعاً ممارسة هذا، فهو السبيل لإرباك «مارا»."

msgid "275"
msgstr ""
"عندما تمارسون هذا جميعاً، ستنهون الشقاء. "
"لقد شرحت لكم الدرب لاستئصال الشوكة بالحكمة."

msgid "276"
msgstr ""
"عليكم أنتم القيام بالعمل، فالمستنيرون فقط يوجهون الطريق. "
"المتأملون الممارسون للاستغراق يتحررون من قيود «مارا»."

msgid "277"
msgstr ""
"كل الظروف غير دائمة — عندما يُرى هذا بالحكمة، "
"يزهد المرء في الشقاء: هذا هو درب الطهر."

msgid "278"
msgstr ""
"كل الظروف شقاء — عندما يُرى هذا بالحكمة، "
"يزهد المرء في الشقاء: هذا هو درب الطهر."

msgid "279"
msgstr ""
"كل الأشياء ليست «أنا» — عندما يُرى هذا بالحكمة، "
"يزهد المرء في الشقاء: هذا هو درب الطهر."

msgid "280"
msgstr ""
"لا ينطلقون عندما يحين وقت الانطلاق؛ وهم شباب وأقوياء، "
"لكنهم يسلمون للفتور. عقولهم محبطة في تفكير غارق، "
"كسالى وواترين، لا يمكنهم تبين الدرب."

msgid "281"
msgstr ""
"محترس في القول، منضبط في العقل، لا يفعل فعلاً بدنياً غير سوي. "
"طهر هذه الطرق الثلاث في أداء الأعمال، ونل الدرب الذي عرفه الرؤاة."

msgid "282"
msgstr ""
"من التأمل تنبع الحكمة، وبدون تأمل تنتهي الحكمة. "
"بمعرفة هذين الدربين — التقدم والتراجع — "
"عليك أن تسير بحيث تنمو الحكمة."

msgid "283"
msgstr ""
"اقطع غابة الرغبات، وليس مجرد شجرة؛ فمن الغابة ينبع الخوف. "
"بعد قطع الغابة وتشابكها، كونوا أحراراً من الغابات أيها النساك!"

msgid "284"
msgstr ""
"ما دام الرباط، مهما صغر، الذي يربط الرجل بالنساء لم يُقطع، "
"يبقى عقله محاصراً، كعجلٍ يرضع من أمه."

msgid "285"
msgstr ""
"اجتث التعلق بالنفس، كقطف لوتس خريفية. "
"انشد فقط درب السلام، الانطفاء الذي علمه القدوس."

msgid "286"
msgstr ""
"«هنا سأبقى في الأمطار؛ وهنا في الشتاء، وهنا في الصيف»؛ "
"هكذا يفكر الأحمق، غير مدرك للخطر."

msgid "287"
msgstr ""
"كما يكتسح فيضان عارم قرية نائمة، يختطف الموت "
"الإنسان الذي يفرط في تدليل الأبناء والماشية، وعقله غارق فيهم."

msgid "288"
msgstr ""
"الأبناء لا يوفرون لك ملجأً، ولا الأب، ولا الأقارب. "
"عندما يقبض عليك «المفني»، لا ملجأ في الأهل."

msgid "289"
msgstr ""
"بمعرفة السبب في ذلك، الفطين، والمنضبط أخلاقياً، "
"سيمهد سريعاً الدرب الذي يقود إلى الانطفاء."

msgid "chap21"
msgstr "متنوعات"

msgid "290"
msgstr ""
"إن كان بالتخلي عن السعادة المادية يرى المرء سعادة وافرة، "
"فإن اليقيظ يتخلى عن السعادة المادية، طمعاً في السعادة الوافرة."

msgid "291"
msgstr ""
"من ينشد سعادته بفرض الشقاء على الآخرين، "
"عائشاً في ألفة مع العداوة، لن يتحرر من العداوة."

msgid "292"
msgstr ""
"يتركون ما يجب فعله، ويفعلون ما لا يجب فعله. "
"للمتكبرين والمهملين، تزداد شوائبهم فقط."

msgid "293"
msgstr ""
"أولئك الذين التزموا حقاً باليقظة الدائمة للجسد، "
"لا يمارسون ما لا يجب فعله، بل يفعلون دائماً ما يجب فعله. "
"بيقيظين وواعين، تبلغ شوائبهم نهايتها."

msgid "294"
msgstr ""
"بقتله الأم والأب، وملكين أرستقراطيين، "
"وبإبادته للمملكة مع جابي ضرائبها، "
"يسير الحكيم بلا كدر."

msgid "295"
msgstr ""
"بقتله الأم والأب، وملكين مزدهرين، "
"ونمرٍ كخامسٍ لهم، يسير الحكيم بلا كدر."

msgid "296"
msgstr ""
"تلاميذ «غوتاما» يستيقظون دائماً منتعشين، "
"الذين يذكرون «البوذا» باستمرار ليلًا ونهاراً."

msgid "297"
msgstr ""
"تلاميذ «غوتاما» يستيقظون دائماً منتعشين، "
"الذين يذكرون التعليم باستمرار ليلًا ونهاراً."

msgid "298"
msgstr ""
"تلاميذ «غوتاما» يستيقظون دائماً منتعشين، "
"الذين يذكرون الجماعة باستمرار ليلًا ونهاراً."

msgid "299"
msgstr ""
"تلاميذ «غوتاما» يستيقظون دائماً منتعشين، "
"الذين يتيقظون لأجسادهم باستمرار ليلًا ونهاراً."

msgid "300"
msgstr ""
"تلاميذ «غوتاما» يستيقظون دائماً منتعشين، "
"الذين تبتهج عقولهم ليلًا ونهاراً بالسلام."

msgid "301"
msgstr ""
"تلاميذ «غوتاما» يستيقظون دائماً منتعشين، "
"الذين تبتهج عقولهم ليلًا ونهاراً بالتأمل."

msgid "302"
msgstr ""
"الخروج (للزهد) عسير، ومن الصعب نيل السعادة فيه؛ وحياة البيت عسيرة أيضاً "
"ومؤلمة، ومن المؤلم المقام مع من لا يجمعك بهم شيء. "
"المسافر فريسة للألم، فلا تكن مسافراً، ولا تكن فريسة للألم."

msgid "303"
msgstr ""
"من كان مؤمناً، ومكتملاً في الأخلاق، ومباركاً بالشهرة والثروة، "
"فهو مُكرّم في أي مكان يحلّ فيه."

msgid "304"
msgstr ""
"الأخيار يشعون من بعيد، كقمم الهملايا، "
"أما الأشرار فلا يُرون، كالسهام المبعثرة في الليل."

msgid "305"
msgstr ""
"يجلس وحيداً، ينام وحيداً، ويرتحل وحيداً بلا كلل؛ "
"من يروض نفسه وحيداً، يجد بهجته في أعماق الغابة."

msgid "chap22"
msgstr "الجحيم"

msgid "306"
msgstr ""
"الكاذب يمضي إلى الجحيم، وكذا من ينكر فعلاً قد فعله. "
"كلاهما سواء في الآخرة، أولئك الرجال ذوو الأعمال الدنيئة."

msgid "307"
msgstr ""
"كثيرون ممن يرتدون الثوب الأصفر غير منضبطين وأشرار. "
"بسبب شرهم، يولدون ثانية في الجحيم جزاء أعمالهم السيئة."

msgid "308"
msgstr ""
"خيرٌ للفاسد وغير المنضبط أن يبتلع كرة حديدية محماة، "
"تتوهج كاللهب المحرق، من أن يقتات على صدقات الناس."

msgid "309"
msgstr ""
"أربعة أمور تصيب الغافل الذي يضاجع زوجة غيره: "
"الإثم، والأرق، وسوء السمعة، والولادة في الجحيم."

msgid "310"
msgstr ""
"إنه يحصد الإثم ويولد في مكان بئيس، "
"كل ذلك لأجل لذة عابرة يختلسها زوجان خائفان، "
"لذة يفرض عليها الحكام عقاباً ثقيلاً. "
"لذا، لا ينبغي للرجل أن يضاجع زوجة غيره."

msgid "311"
msgstr ""
"عشب «الكوشا» إن قُبض عليه خطأً جرح اليد. "
"وكذلك حياة الزهد، إن سُلكت خطأً جرت صاحبها إلى الجحيم."

msgid "312"
msgstr ""
"أي فعل متراخٍ، أو طقس فاسد، "
"أو حياة روحانية مريبة، لا تثمر نفعاً كبيراً."

msgid "313"
msgstr ""
"إن وجب فعل شيء، فافعله بعزم واجتهاد. "
"فحياة الزهد إن سُلكت بفتور، زادت غبار الرغبات ثورة."

msgid "314"
msgstr ""
"الفعل السيء خيرٌ له أن يظل غير مفعول، فإنه سيؤذيك لاحقاً. "
"أما الفعل الحسن فخيرٌ له أن يُفعل، فهو لا يجلب كدراً."

msgid "315"
msgstr ""
"كما تُحرس المدينة الحدودية من الداخل والخارج، كذلك احرسوا أنفسكم— "
"لا تدعوا اللحظة تفوتكم. فمن أضاع لحظته "
"سيحزن حين يُساق إلى الجحيم."

msgid "316"
msgstr ""
"الذين لا يخجلون مما يخجل، ويخجلون مما لا خجل فيه؛ "
"هؤلاء المتمسكون بالرؤية الخاطئة يمضون إلى مكان بئيس."

msgid "317"
msgstr ""
"الذين يرون الخطر حيث لا خطر، ويعمون عن الخطر الحقيقي، "
"هؤلاء المتمسكون بالرؤية الخاطئة يمضون إلى مكان بئيس."

msgid "318"
msgstr ""
"الذين يرون العيب حيث لا عيب، ويعمون عن العيب الحقيقي، "
"هؤلاء المتمسكون بالرؤية الخاطئة يمضون إلى مكان بئيس."

msgid "319"
msgstr ""
"الذين يعرفون العيب كعيب، والمنزه كمنزه، "
"هؤلاء المتمسكون بالرؤية الصحيحة يمضون إلى مستقر طيب."

msgid "chap23"
msgstr "الفيلة"

msgid "320"
msgstr ""
"كفيلٍ أصابته السهام في معركة، سأحتمل الإساءة، "
"فالكثير من الناس سيئو السلوك."

msgid "321"
msgstr ""
"الدابة المروضة هي التي تُقاد إلى الحشود؛ "
"والفيل المروض هو الذي يمتطيه الملك؛ "
"والإنسان المروض الذي يحتمل الإساءة هو خير البشر."

msgid "322"
msgstr ""
"أولئك الذين روضوا أنفسهم خيرٌ من البغال المروضة، "
"أو الخيول الأصيلة، أو الفيلة الضخمة ذات الأنياب."

msgid "323"
msgstr ""
"فليس على تلك الركائب تبلغ المكان الذي لم يُطأ قط، "
"بل بفضل النفس التي تم ترويضها جيداً، "
"تذهب إلى هناك، مروضاً بصحبة المروضين."

msgid "324"
msgstr ""
"الفيل «دنابالا» هائجٌ وصعب المراس. "
"وهو في قيده لا يذوق لقمة، لأنه يشتاق إلى غابة الفيلة."

msgid "325"
msgstr ""
"من يغلبه النعاس بسبب الإفراط في الأكل، ويحب النوم، "
"ويتقلب في فراشه كخنزير ضخم عُلف بالحبوب: "
"ذاك البليد يعود إلى الرحم مرة تلو الأخرى."

msgid "326"
msgstr ""
"في الماضي، كان عقلي يهيم حيث يشاء وكيفما يحلو له. "
"أما الآن، فسأقوده بعناية، "
"كما يقود المروض فيلاً هائجاً بمهموزه."

msgid "327"
msgstr ""
"ابتهجوا بالاجتهاد! واحرسوا عقولكم جيداً! "
"انتشلوا أنفسكم من هذه الحفرة، كفيلٍ غاص في وحل."

msgid "328"
msgstr ""
"إن وجدت رفيقاً يقيظاً، صديقاً فطناً تعيش معه في سعادة، "
"فارتحل معه فرحاً وواعياً، متجاوزاً كل المحن."

msgid "329"
msgstr ""
"إن لم تجد رفيقاً يقيظاً، ولا صديقاً فطناً تعيش معه في سعادة، "
"فارتحل وحيداً كفيلٍ في البراري، "
"أو كملكٍ يفر من مملكةٍ مهزومة."

msgid "330"
msgstr ""
"الارتحال وحيداً خير، فلا صحبة مع الحمقى. "
"ارتحل وحيداً ولا تقترف سوءاً، هانئاً كفيلٍ في البراري."

msgid "331"
msgstr ""
"الصديق وقت الضيق بركة؛ والقناعة بما تيسر بركة؛ "
"والأعمال الصالحة بركة عند نهاية العمر، "
"والتخلي عن كل شقاء هو البركة الكبرى."

msgid "332"
msgstr ""
"في هذا العالم، من البركة برّ الأم وبرّ الأب. "
"ومن البركة أيضاً إكرام الزهاد والحكماء."

msgid "333"
msgstr ""
"من البركة التزام الوصايا حتى الكبر؛ "
"وبركةٌ أن تكون راسخاً في الإيمان؛ ونيل الحكمة بركة؛ "
"ومن البركة تجنب فعل السوء."

msgid "chap24"
msgstr "التوق"

msgid "334"
msgstr ""
"عندما يعيش الإنسان بغفلة، ينمو فيه التوق كاللبلاب. "
"يقفز من شيء إلى آخر، "
"كقردٍ طماعٍ يبحث عن الفاكهة في غابة."

msgid "335"
msgstr ""
"من غلبه هذا التوق البئيس، وهذا التعلق بالعالم، "
"نمت أحزانه كما ينمو العشب تحت المطر."

msgid "336"
msgstr ""
"أما من قهر هذا التوق البئيس، "
"الذي يصعب تجاوزه في العالم، تساقطت عنه الأحزان، "
"كقطرات الماء تتساقط عن ورقة اللوتس."

msgid "337"
msgstr ""
"أقول لكم هذا أيها الأخيار، يا كل من اجتمع هنا: "
"اجتثوا جذور التوق، كما تجتثون العشب بحثاً عن جذوره. "
"لا تدعوا «مارا» يحطمكم مراراً، كما يحطم التيار القصب."

msgid "338"
msgstr ""
"الشجرة تنمو ثانية حتى لو قُطعت، ما دامت جذورها قوية وسليمة؛ "
"والشقاء ينبت مراراً، ما دام ميل النفس للتوق لم يُستأصل."

msgid "339"
msgstr ""
"من كانت بصيرته ضحلة، وتيارات اللذة الستة والثلاثون فيه عارمة، "
"تكتسحه أفكار الشهوة الجارفة."

msgid "340"
msgstr ""
"التيارات تجري في كل مكان؛ وعشب الرغبة ينبت ويستقر. "
"عند رؤية هذا العشب النابت، اقطع جذوره بالحكمة."

msgid "341"
msgstr ""
"أفراح المرء تنبع من حواسه وأشواقه. "
"الباحثون عن السعادة، المنغمسون في اللذة، يستمرون في الولادة والهرم."

msgid "342"
msgstr ""
"الناس الذين يسوقهم الظمأ (التوق)، يزحفون حول أنفسهم كأرنبٍ في شرك. "
"مقيدين ومغلولين، يعودون إلى الألم المرة تلو الأخرى لزمن طويل."

msgid "343"
msgstr ""
"الناس الذين يسوقهم الظمأ، يزحفون حول أنفسهم كأرنبٍ في شرك. "
"لذلك، على من ينشد التجرد أن يطرد الظمأ."

msgid "344"
msgstr ""
"بعد أن تحرر من التشابك، انطلق إلى الغابة، "
"ثم عاد يركض إلى نفس الغابة التي تركها خلفه. "
"انظروا إلى هذا المرء! بعد أن نال الحرية، يركض نحو القيد."

msgid "345"
msgstr ""
"يقول الحكماء إن القيد المصنوع من حديد أو خشب أو حبال ليس قوياً. "
"بل الهوس بالأقراط المرصعة، والقلق على الزوج والأبناء:"

msgid "346"
msgstr ""
"هذا، كما يقول الحكماء، هو القيد القوي الذي يجر المنغمسين للأسفل، ويصعب الإفلات منه. "
"وبعد قطع هذا القيد أيضاً، ينطلقون غير مكترثين، "
"تاركين وراءهم لذات الحس."

msgid "347"
msgstr ""
"المنبهرون بالشهوة يسقطون في التيار، كعنكبوت علقت في نسيجها. "
"أما اليقظون فيمضون قدماً بعد قطع هذا القيد أيضاً، "
"غير مكترثين، بعد أن تركوا وراءهم كل شقاء."

msgid "348"
msgstr ""
"تخلَّ عن الماضي، وتخلَّ عن المستقبل، وتخلَّ عن الحاضر، "
"عابراً إلى ما وراء الولادة. بقلبٍ محرر من كل جهة، "
"لن تعود ثانية للولادة والهرم."

msgid "349"
msgstr ""
"من تتقاذفه الأفكار، ممتلئاً بالشهوة، ومركزاً على الجمال، "
"ينمو توقه أكثر فأكثر، مكبلاً إياه بقيودٍ متينة."

msgid "350"
msgstr ""
"أما من يحب تهدئة أفكاره، مطوراً إدراك زوال الجمال، "
"يقيظاً دوماً، فسيقضي حتماً على ذاك التوق، قاطعاً قيود «مارا»."

msgid "351"
msgstr ""
"الواثق، الذي لا يخشى شيئاً، المتحرر من التوق والعيوب، "
"بعد أن حطم سهام الولادات القادمة، يكون هذا الجسد هو آخره."

msgid "352"
msgstr ""
"المتحرر من التوق ومن التمسك، الخبير في معاني الكلمات، "
"العالم بترتيب الحروف وتناسقها، "
"يُقال عنه إنه يحمل جسده الأخير، "
"إنه ذو حكمة عظيمة، إنسانٌ عظيم."

msgid "353"
msgstr ""
"أنا الغالب، العليم بكل شيء، المنزه في وسط كل شيء. "
"لقد تركت الكل، وتحررت بنهاية التوق. "
"بما أنني عرفت بنفسي، فمن ذا الذي أتبعه؟"

msgid "354"
msgstr ""
"عطاء التعليم يعلو كل عطاء؛ "
"ومذاق التعليم يعلو كل مذاق؛ "
"وبهجة التعليم تعلو كل بهجة؛ "
"ونهاية التوق تقهر كل شقاء."

msgid "355"
msgstr ""
"الثروات تدمر الأحمق، لكن ليس الباحث عن الشاطئ الآخر. "
"بسبب التوق للمال، يدمر الأحمق نفسه ويدمر الآخرين."

msgid "356"
msgstr ""
"الأعشاب الضارة آفة المحاصيل، والجشع آفة هؤلاء الناس. "
"لذلك، فإن العطاء لمن تحرر من الجشع يثمر ثمراً عظيماً."

msgid "357"
msgstr ""
"الأعشاب الضارة آفة المحاصيل، والكراهية آفة هؤلاء الناس. "
"لذلك، فإن العطاء لمن تحرر من الكراهية يثمر ثمراً عظيماً."

msgid "358"
msgstr ""
"الأعشاب الضارة آفة المحاصيل، والضلال آفة هؤلاء الناس. "
"لذلك، فإن العطاء لمن تحرر من الضلال يثمر ثمراً عظيماً."

msgid "359"
msgstr ""
"الأعشاب الضارة آفة المحاصيل، والشهوة آفة هؤلاء الناس. "
"لذلك، فإن العطاء لمن تحرر من الشهوة يثمر ثمراً عظيماً."

msgid "chap25"
msgstr "النساك"

msgid "360"
msgstr ""
"انضباط العين خير؛ وخيرٌ هو انضباط الأذن؛ "
"انضباط الأنف خير؛ وخيرٌ هو انضباط اللسان."

msgid "361"
msgstr ""
"انضباط الجسد خير؛ وخيرٌ هو انضباط القول؛ "
"انضباط العقل خير؛ وفي كل مكان، الانضباط خير. "
"الناسك المنضبط في كل شيء يتحرر من كل شقاء."

msgid "362"
msgstr ""
"المنضبط في اليد والقدم، وفي القول — ذاك هو الانضباط الأسمى؛ "
"السعيد في داخله، الهادئ، المنفرد، القانع، ذاك ما أسميه ناسكاً."

msgid "363"
msgstr ""
"عندما يشرح الناسك المنضبط الفم، الحكيم في مشورته، غير المضطرب، "
"نص التعليم ومعناه، تكون كلماته عذبة."

msgid "364"
msgstr ""
"المبتهج بالتعليم، والمتلذذ به، والمتأمل فيه، "
"الناسك الذي يذكر التعليم دائماً لا يحيد عن الحق."

msgid "365"
msgstr ""
"لا ينبغي للناسك الميسور أن يحتقر غيره، ولا أن يكون حسوداً. "
"فالناسك الذي يحسد الآخرين لا يبلغ صفاء الذهن."

msgid "366"
msgstr ""
"إن كان الناسك قليل المتاع، فلا ينبغي للميسورين احتقاره. "
"فالآلهة حقاً تمدح ذاك الذي لا يكلّ، وطاهر العيش."

msgid "367"
msgstr ""
"من لا يملك شعوراً بالتملك في عالم الاسم والشكل، "
"ومن لا يحزن على ما ليس لديه، يُقال عنه إنه ناسك."

msgid "368"
msgstr ""
"الناسك الذي يتأمل في المحبة، والمخلص لتعليم «البوذا»، "
"سيدرك حالة السلام، وسكون الأحوال البهيج."

msgid "369"
msgstr ""
"أفرغ هذا القارب أيها الناسك! فمتى أفرغته طفا خفيفاً. "
"بعد قطع الرغبة والكراهية، ستصل إلى الانطفاء."

msgid "370"
msgstr ""
"خمسة تقطعها، وخمسة تتركها، وخمسة أخرى تطورها. "
"عندما يحطم الناسك السلاسل الخمس، يُقال إنه عبر الفيضان."

msgid "371"
msgstr ""
"مارس الاستغراق، ولا تكن غافلاً! لا تدع العقل يلهو بالحواس! "
"لا تبتلع غافلاً كرة حديدية محماة! "
"وحين تحرقك، لا تصرخ: «وا ألما!»"

msgid "372"
msgstr ""
"لا استغراق لمن لا حكمة له، ولا حكمة لمن لا استغراق له. "
"أما من اجتمعا فيه — فقد اقترب حقاً من الانطفاء."

msgid "373"
msgstr ""
"الناسك الذي يدخل كوخاً فارغاً بعقلٍ هادئ "
"يجد لذة تفوق البشر حين يتبين الحق بوضوح."

msgid "374"
msgstr ""
"كلما تيقظ لنشوء الأشياء وزوالها، "
"شعر بالنشوة والفرح: تلك هي الحرية من الموت لمن عرف."

msgid "375"
msgstr ""
"هذه هي بداية الدرب للناسك الحكيم هنا: "
"حراسة الحواس، والقناعة، والانضباط في نهج الزهد."

msgid "376"
msgstr ""
"صاحب رفاق الروح، الذين لا يكلون وطاهري العيش. "
"شارك ما لديك مع الآخرين، وكن لابقاً في سلوكك. "
"وعندما تمتلئ بالفرح، ستنهي كل شقاء."

msgid "377"
msgstr ""
"كما تسقط الياسمينة زهورها الذابلة، أيها النساك، أسقطوا الجشع والكراهية."

msgid "378"
msgstr ""
"هادئ الجسد، هادئ القول، مسالم ومطمئن؛ "
"الناسك الذي نبذ طعم العالم يُقال عنه إنه في سلام."

msgid "379"
msgstr ""
"حثّ نفسك، وتأمل في نفسك. "
"الناسك المنضبط واليقيظ سيعيش دائماً في سعادة."

msgid "380"
msgstr ""
"النفس هي سيد النفس، فمن غيرها يكون سيداً؟ "
"النفس هي مسكن النفس، "
"لذا روض نفسك، كما يروض التاجر جواده الأصيل."

msgid "381"
msgstr ""
"الناسك الممتلئ بالفرح والواثق في تعليم «البوذا»، "
"سيدرك حالة السلام، وسكون الأحوال البهيج."

msgid "382"
msgstr ""
"الناسك الشاب المخلص لتعليم «البوذا»، "
"يضيء العالم، كالقمر حين يخرج من بين الغيوم."

msgid "chap26"
msgstr "الحكماء"

msgid "383"
msgstr ""
"اقطع التيار مجتهداً! وانبذ لذات الحس أيها الحكيم. "
"بمعرفتك لنهاية الأحوال، اعرف ما لم يُخلق، أيها الحكيم."

msgid "384"
msgstr ""
"عندما يتجاوز الحكيم ثنائية الأشياء، "
"عندها ينهي بوعيه كل القيود."

msgid "385"
msgstr ""
"من ليس له شاطئ قريب ولا بعيد، "
"ولا كلاهما؛ الخالي من التوتر، والمتجرد، "
"ذاك هو من أسميه حكيماً."

msgid "386"
msgstr ""
"المستغرق، الخالي من الآمال، الذي أتم مهمته، وبلا شوائب، "
"الذي بلغ الغاية القصوى: ذاك هو من أسميه حكيماً."

msgid "387"
msgstr ""
"تسطع الشمس نهاراً، ويشع القمر ليلًا، "
"ويلمع النبيل في درعه، ويشرق الحكيم في استغراقه. "
"لكن طوال الليل والنهار، يسطع «البوذا» بمجده."

msgid "388"
msgstr ""
"يُسمى الحكيم حكيماً لأنه نبذ الشر، "
"ويُسمى الناسك ناسكاً لأنه يعيش حياة هادئة. "
"ومن نبذ كل الشوائب يُقال عنه إنه «منتبذ»."

msgid "389"
msgstr ""
"لا ينبغي لأحد أن يضرب حكيماً، ولا ينبغي للحكيم أن يرد الأذى. "
"ويلٌ لمن يؤذي حكيماً، وويلٌ أكثر لمن يرد الأذى بالأذى."

msgid "390"
msgstr ""
"لا شيء خيرٌ للحكيم من كبح عقله عن التعلق. "
"وحيثما تراجعت الرغبة القاسية، هناك يهدأ الشقاء."

msgid "391"
msgstr ""
"من لا يفعل سوءاً ببدنه أو قوله أو عقله، "
"المنضبط في هذه الثلاث، ذاك هو من أسميه حكيماً."

msgid "392"
msgstr ""
"عليك أن تكرم بامتنان من تتعلم منه الحق "
"الذي علمه «البوذا» المستنير، كما يكرم الكاهن النار المقدسة."

msgid "393"
msgstr ""
"ليس بالشعر الملبد ولا بالنسب ولا بالمولد يكون المرء حكيماً. "
"بل الصادقون والمستقيمون: هم الأطهار، وهم الحكماء."

msgid "394"
msgstr ""
"ما نفع الشعر الملبد أيها الغافل، وما نفع جلد الغزال؟ "
"التشابك في داخلك، وأنت تلمع ظاهرك."

msgid "395"
msgstr ""
"من يرتدي ثياباً من خرقة، نحيلاً تظهر عروقه، "
"متأملاً وحيداً في الغابة، ذاك هو من أسميه حكيماً."

msgid "396"
msgstr ""
"لا أسمي المرء حكيماً لمجرد الرحم الذي وُلد منه. "
"إن كان لا يزال متمسكاً، فهو مجرد شخص يقول «أنا جدير». "
"أما من لا يملك شيئاً ولا يأخذ شيئاً: فذاك هو من أسميه حكيماً."

msgid "397"
msgstr ""
"بعد قطع كل القيود، لا قلق لديه. "
"لقد تحرر من أغلاله وتجرد: ذاك هو من أسميه حكيماً."

msgid "398"
msgstr ""
"لقد قطع الحبل والرسن، واللجام والزمام أيضاً، "
"وبعد رفع العائق، استيقظ: ذاك هو من أسميه حكيماً."

msgid "399"
msgstr ""
"الإساءة، والقتل، والحبس: يحتملها بلا غضب. "
"الصبر هو جيشه القوي: ذاك هو من أسميه حكيماً."

msgid "400"
msgstr ""
"غير سريع الغضب ولا متكلف، ملتزم بالوصايا والسنن، "
"مروضٌ، وهذا الجسد هو آخره: ذاك هو من أسميه حكيماً."

msgid "401"
msgstr ""
"كمثل الماء على ورقة اللوتس، أو بذور الخردل على رأس إبرة، "
"تنزلق عنهم لذات الحس: ذاك هو من أسميه حكيماً."

msgid "402"
msgstr ""
"لقد أدركوا بأنفسهم نهاية الشقاء في هذه الحياة؛ "
"وبعد وضع العبء والتجرد: ذاك هو من أسميه حكيماً."

msgid "403"
msgstr ""
"عميق الحكمة، فطين، خبير بالدرب وبما ليس بدرب؛ "
"وبلوغ الغاية القصوى: ذاك هو من أسميه حكيماً."

msgid "404"
msgstr ""
"لا يختلط بأهل الدور ولا بالمشردين؛ "
"مرتحل بلا حصن، وقليل المطالب: ذاك هو من أسميه حكيماً."

msgid "405"
msgstr ""
"لقد كفوا عن العنف تجاه الكائنات، قويها وضعيفها؛ "
"فلا يقتلون ولا يحرضون على قتل: ذاك هو من أسميه حكيماً."

msgid "406"
msgstr ""
"لا يصارعون المصارعين، وهم في سلام بين من حمل السلاح، "
"ولا يتمسكون بشيء بين المتمسكين: ذاك هو من أسميه حكيماً."

msgid "407"
msgstr ""
"لقد نبذوا الجشع والكراهية، ومعهم الكبرياء والازدراء، "
"كبذرة خردل سقطت عن رأس إبرة: ذاك هو من أسميه حكيماً."

msgid "408"
msgstr ""
"كلماتهم مهذبة، نافعة، وصادقة، "
"ولا تجرح أحداً: ذاك هو من أسميه حكيماً."

msgid "409"
msgstr ""
"لا يسرقون شيئاً في هذا العالم، طويلاً كان أم قصيراً، دقيقاً أم غليظاً، "
"جميلاً أم قبيحاً: ذاك هو من أسميه حكيماً."

msgid "410"
msgstr ""
"لا يحملون أملاً في هذا العالم ولا في الآتي؛ "
"بلا حاجة للأمل، وبلا تعلق: ذاك هو من أسميه حكيماً."

msgid "411"
msgstr ""
"لا تشبث لديهم، فقد حررهم اليقين من الحيرة، "
"لقد بلغوا الغاية، والتحرر من الموت: "
"ذاك هو من أسميه حكيماً."

msgid "412"
msgstr ""
"لقد نجوا من التعلق بالأعمال، خيرها وشرها؛ "
"بلا حزن، بلا دنس، وبلا شائبة: ذاك هو من أسميه حكيماً."

msgid "413"
msgstr ""
"طاهرون كالقمر في تمامه، ناصعون بلا كدر، "
"لقد أنهوا الرغبة في الولادة ثانية: ذاك هو من أسميه حكيماً."

msgid "414"
msgstr ""
"لقد تجاوزوا مستنقع الضلال المنهك، ودورة التناسخ. "
"متأملون في سكون، متحررون من الحيرة، "
"لقد عبروا إلى الشاطئ الآخر. "
"وقد انطفأت فيهم الرغبة بعدم التمسك: ذاك هو من أسميه حكيماً."

msgid "415"
msgstr ""
"لقد تركوا المثيرات الحسية، وخرجوا من حياة الدنيا؛ "
"ووضعوا حداً للولادة في عالم الحواس: ذاك هو من أسميه حكيماً."

msgid "416"
msgstr ""
"لقد تركوا التوق، وخرجوا من حياة الدنيا؛ "
"وأنهوا الرغبة في الولادة من جديد: ذاك هو من أسميه حكيماً."

msgid "417"
msgstr ""
"لقد خلعوا النير البشري، وأفلتوا من النير السماوي؛ "
"متحررون من كل القيود: ذاك هو من أسميه حكيماً."

msgid "418"
msgstr ""
"بترك الرغبة والاستياء، صاروا باردين (هامدين) وأحراراً من التعلق؛ "
"بطلٌ، وسيد العالم أجمع: ذاك هو من أسميه حكيماً."

msgid "419"
msgstr ""
"يعرفون زوال الكائنات وولادتها من جديد؛ "
"متحررون، قدسيون، ومستيقظون: ذاك هو من أسميه حكيماً."

msgid "420"
msgstr ""
"الآلهة، والكائنات السماوية، والبشر لا يعرفون مصيرهم؛ "
"المكتملون الذين انتهت شوائبهم: ذاك هو من أسميه حكيماً."

msgid "421"
msgstr ""
"ليس لديهم ما قبل ولا ما بعد، ولا حتى ما بينهما. "
"لا يملكون شيئاً، ولا يأخذون شيئاً: ذاك هو من أسميه حكيماً."

msgid "422"
msgstr ""
"قائد القطيع، البطل الفذ، الرائي العظيم والمنتصر؛ "
"ساكنٌ، مطهرٌ، ومستيقظٌ: ذاك هو من أسميه حكيماً."

msgid "423"
msgstr ""
"من يعرف حيواته الماضية، ويرى الجنة ومواضع الخسران، "
"وقد بلغ نهاية الولادة؛ حكيمٌ ذو بصيرة كاملة "
"في ذروة الكمال الروحي: ذاك هو من أسميه حكيماً."
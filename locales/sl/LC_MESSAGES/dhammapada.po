msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "title"
msgstr "Dhammapada"

msgid "chaps"
msgstr "Poglavja"

msgid "fontsize"
msgstr "Velikost pisave"

msgid "chap1"
msgstr "Nasprotja"

msgid "1"
msgstr ""
"Misel vodi vse stvari,\n"
"misel jih rodi in oblikuje.\n"
"Če človek poln zlih misli\n"
"govori ali deluje,\n"
"trpljenje mu zato sledi,\n"
"kot voz kopitom vpreženega vola."

msgid "2"
msgstr ""
"Misel vodi vse stvari,\n"
"misel jih rodi in oblikuje.\n"
"Če človek dobrih misli\n"
"govori ali deluje, sreča vedno mu sledi,\n"
"kot senca ga nikoli ne pusti."

msgid "3"
msgstr ""
"Zmerjal me je, udaril me je,\n"
"premagal me je, okradel me je –\n"
"kdor se predaja takim mislim,\n"
"bo vedno poln sovraštva."

msgid "4"
msgstr ""
"Zmerjal me je, udaril me je,\n"
"premagal me je, okradel me je –\n"
"kdor take misli opusti,\n"
"bo pomiril vse sovraštvo."

msgid "5"
msgstr ""
"Kajti na tem svetu se sovraštvo\n"
"s sovraštvom nikoli ne umiri,\n"
"ampak le z ljubeznijo –\n"
"to stara je resnica."

msgid "6"
msgstr ""
"Ljudje namreč ne vedo,\n"
"da prav vse nas čaka smrt –\n"
"kdor dobro to razume,\n"
"takoj prepire pomiri."

msgid "7"
msgstr ""
"Kdor išče le prijetnosti in ne obvlada svojih čutov,\n"
"kdor mere v hrani ne pozna\n"
"in je brezmočen, len,\n"
"hitro ga premaga Māra,\n"
"upogne se kot bilka v vetru."

msgid "8"
msgstr ""
"Kdor pa pozna tudi nevšečnost\n"
"in dobro obvlada svoje čute,\n"
"kdor je zmeren v hrani,\n"
"vedno vztrajen in goreč,\n"
"ga Māra nikdar ne premaga,\n"
"trden je kot skala v vetru."

msgid "9"
msgstr ""
"Kdor si želi oranžno oblačilo,\n"
"a pri tem je daleč od resnice,\n"
"poln napak in brez obvladovanja,\n"
"res ni vreden oranžnega blaga."

msgid "10"
msgstr ""
"Kdor pa je brez vseh napak,\n"
"poln vrlin in zbranosti,\n"
"kdor se obvlada in pozna resnico,\n"
"zares zasluži oranžno oblačilo."

msgid "11"
msgstr ""
"Kdor ima nebistveno za bistveno,\n"
"v bistvu pa vidi nebistveno,\n"
"tak človek napačno razmišlja,\n"
"nikoli ne bo prišel do bistva."

msgid "12"
msgstr ""
"Kdor pa v bistvu vidi bistveno,\n"
"v nebistvu pa nebistveno,\n"
"tak človek prav razmišlja,\n"
"kmalu bo prišel do bistva."

msgid "13"
msgstr ""
"Kot slabo krito hišo\n"
"takoj premoči dež –\n"
"tako slabo razvite misli\n"
"takoj premagajo strasti."

msgid "14"
msgstr ""
"Kot dobro krite hiše\n"
"nikoli ne premoči dež –\n"
"tako razvitih misli\n"
"ne premagajo strasti."

msgid "15"
msgstr ""
"Kdor dela zlo, povsod trpi,\n"
"na tem svetu in na onem –\n"
"ko spozna sadove svojih zlih dejanj,\n"
"je žalosten in zaskrbljen."

msgid "16"
msgstr ""
"Dober človek pa je povsod srečen,\n"
"na tem svetu in na onem –\n"
"ko spozna sadove svojih dobrih del,\n"
"je vesel in radosten."

msgid "17"
msgstr ""
"Kdor dela zlo, povsod trpi,\n"
"na tem svetu in na onem –\n"
"trpi ob misli na zla dela,\n"
"še bolj pa, ko spozna njihov sad."

msgid "18"
msgstr ""
"Dober človek je povsod vesel,\n"
"na tem svetu in na onem –\n"
"veseli se svojih dobrih del,\n"
"še bolj pa njihovih sadov."

msgid "19"
msgstr ""
"Nevednež, ki o modrosti veliko govori,\n"
"v skladu z njo pa ne deluje,\n"
"je kot pastir, ki šteje tujo čredo –\n"
"sadov modrosti nikoli ne spozna."

msgid "20"
msgstr ""
"Kdor pa o modrosti malo govori,\n"
"a v skladu z njo deluje,\n"
"je res svoboden, modrec brez želja,\n"
"ki zapustil je sovraštvo in nevednost –\n"
"nič ga ne veže na ta ali oni svet,\n"
"saj je izkusil sad modrosti."

msgid "chap2"
msgstr "Pazljivost"

msgid "21"
msgstr ""
"Pazljivost vodi onkraj smrti,\n"
"nepazljivost vodi v smrt –\n"
"pazljivi ne umirajo,\n"
"nepazljivi pa žive kot mrtvi."

msgid "22"
msgstr ""
"Modri, ki to res razumejo\n"
"in vedno so pazljivi,\n"
"uživajo v pazljivosti,\n"
"saj poznajo svet popolnih."

msgid "23"
msgstr ""
"Modri, ki so vedno zbrani\n"
"in se neprestano trudijo,\n"
"izkusijo nibbāno\n"
"in se osvobodijo vseh vezi."

msgid "24"
msgstr ""
"Kdor je vztrajen, buden in pazljiv,\n"
"premišljen, umirjen v svojih delih,\n"
"kdor živi pravično in se obvladuje,\n"
"njegova slava neprestano raste."

msgid "25"
msgstr ""
"Modrec, ki je vztrajen in pazljiv,\n"
"poln zbranosti in obvladovanja,\n"
"naj zgradi si otok zase,\n"
"ki ga povodenj ne odnese."

msgid "26"
msgstr ""
"Bedaki in nevedneži\n"
"so zelo lahkomiselni,\n"
"modrec pa goji pazljivost\n"
"in pazi jo kot dragocen zaklad."

msgid "27"
msgstr ""
"Ne bodite lahkomiselni,\n"
"ne prepustite se užitkom –\n"
"le kdor je buden in pazljiv,\n"
"lahko spozna največjo srečo."

msgid "28"
msgstr ""
"Ko pazljivi modrijan\n"
"prežene lahkomiselnost,\n"
"se povzpne na grad modrosti,\n"
"kjer živi brez žalosti –\n"
"kot izkušen hribolazec,\n"
"ki je prišel na vrh gore,\n"
"gleda tja v dolino\n"
"na žalostne neumneže."

msgid "29"
msgstr ""
"Sredi spečih in nepazljivih\n"
"je modrec buden in pazljiv –\n"
"po poti gre kot hiter konj,\n"
"ki je prehitel šibko kljusje."

msgid "30"
msgstr ""
"S pazljivostjo je Maghavā\n"
"postal najvišji bog –\n"
"pazljivost prav vsi hvalijo,\n"
"lahkomiselnost pa grajajo."

msgid "31"
msgstr ""
"Bhikkhu, ki je pazljiv\n"
"in ne pozna nemarnosti,\n"
"napreduje kakor ogenj –\n"
"pred sabo žge prav vse ovire."

msgid "32"
msgstr ""
"Bhikkhu, ki je pazljiv\n"
"in ne pozna nemarnosti,\n"
"ne more nič več izgubiti,\n"
"saj je prestopil prag nibbāne."

msgid "chap3"
msgstr "Misli"

msgid "33"
msgstr ""
"Nemirne in nestalne misli\n"
"se težko obvladajo in zadrže –\n"
"modrec jih uravnava\n"
"kot lokostrelec puščice."

msgid "34"
msgstr ""
"Misli so nemirne\n"
"kakor riba, ki brez vode\n"
"trepeta na suhih tleh –\n"
"zapustite svet želja!"

msgid "35"
msgstr ""
"Dobro je obvladovanje misli,\n"
"ki so hitre in se težko zadržijo\n"
"in gredo, kamor si želijo –\n"
"obvladovanje misli bo prineslo srečo."

msgid "36"
msgstr ""
"Modrec budno opazuje svoje misli,\n"
"ki so varljive in težko zaznavne\n"
"in gredo, kamor si želijo –\n"
"opazovanje misli bo prineslo srečo."

msgid "37"
msgstr ""
"Samotne in breztelesne misli\n"
"ležijo v srcu in gredo v daljave –\n"
"kdor jih obvlada,\n"
"se osvobodi Mārovih vezi."

msgid "38"
msgstr ""
"Čigar misli so nemirne\n"
"in ne pozna resnice,\n"
"kdor je poln omahovanja,\n"
"ne bo spoznal nibbāne."

msgid "39"
msgstr ""
"Čigar misli so brez želja,\n"
"v srcu pa je brez sovraštva,\n"
"kdor je onkraj dobrega in zla,\n"
"je buden — strahu ne pozna."

msgid "40"
msgstr ""
"Ko spoznaš, da je telo kot krhek vrč,\n"
"si utrdi misli kot trdnjavo –\n"
"z mečem modrosti premagaj Māro,\n"
"in ne naveži se na svojo zmago!"

msgid "41"
msgstr ""
"Kmalu bo to telo\n"
"ležalo na zemlji –\n"
"odvrženo in brez zavesti\n"
"kot neuporaben, trhel hlod."

msgid "42"
msgstr ""
"Sovražnik ti lahko stori\n"
"veliko žalosti in zla,\n"
"še bolj pa ti škodujejo\n"
"zmedene in napačne misli."

msgid "43"
msgstr ""
"Pravilne misli\n"
"so ti bolj v pomoč\n"
"kot oče ali mati\n"
"ali vsi prijatelji."

msgid "chap4"
msgstr "Cvetovi"

msgid "44"
msgstr ""
"Kdo bo razumel ta svet,\n"
"svet mrtvih in še svet bogov?\n"
"Kdo bo našel pot modrosti\n"
"kot vrtnar najlepši cvet?"

msgid "45"
msgstr ""
"Učenec bo razumel ta svet,\n"
"svet mrtvih in še svet bogov,\n"
"učenec bo našel pot modrosti\n"
"kot vrtnar najlepši cvet."

msgid "46"
msgstr ""
"Ko spoznaš, da je telo minljivo,\n"
"ko dojameš, da je kot privid,\n"
"posekaj Mārove cvetove\n"
"in pojdi tja, kjer smrti ni."

msgid "47"
msgstr ""
"Človeka, ki je poln želja\n"
"in išče le cvetove,\n"
"odnese smrt kot hudournik,\n"
"ki poplavi spečo vas."

msgid "48"
msgstr ""
"Človeka, ki je poln želja\n"
"in išče le cvetove,\n"
"užitki ne zadovoljijo –\n"
"smrt ga premaga, pokonča."

msgid "49"
msgstr ""
"Kot čebela, ki nabere med in odleti,\n"
"a pri tem cvetov ne poškoduje,\n"
"njih barve, vonja nič ne spremeni –\n"
"takšen naj bo modrec med ljudmi."

msgid "50"
msgstr ""
"Ne razmišljaj o napakah drugih,\n"
"kaj so storili in česa ne,\n"
"ampak sodi le lastne napake,\n"
"kaj si storil in česa ne."

msgid "51"
msgstr ""
"Lepe besede, ki jim dejanja ne sledijo,\n"
"so kot čudovite rože,\n"
"lepih barv, a brez vsakršnih vonjav –\n"
"brezplodne ostanejo in prazne."

msgid "52"
msgstr ""
"Lepe besede, ki dejanja jim sledijo,\n"
"pa so kot čudovite rože,\n"
"lepih barv in najprijetnejših vonjav –\n"
"saj so smiselne in plodovite."

msgid "53"
msgstr ""
"Kot se iz mnogo pisanih cvetov\n"
"spletajo okrasni venci –\n"
"naj tudi človek v življenju\n"
"stori veliko dobrih del."

msgid "54"
msgstr ""
"Vonj cvetov odnese veter,\n"
"vonj sandalovine in jasmina –\n"
"le vonj vrlin se širi proti vetru,\n"
"saj gre povsod, doseže vse strani."

msgid "55"
msgstr ""
"Sandalovina, lotos,\n"
"lilija, jasmin –\n"
"med vsemi temi vonji\n"
"je najboljši vonj vrlin."

msgid "56"
msgstr ""
"Šibek je ta vonj cvetov,\n"
"vonj sandalovine ali lilij,\n"
"izvrsten pa je vonj vrlin,\n"
"saj se širi tudi med bogovi."

msgid "57"
msgstr ""
"Kdor je poln vrlin,\n"
"vedno buden in pazljiv,\n"
"je res moder in svoboden –\n"
"po poti gre, kjer ni več zla."

msgid "58"
msgstr ""
"Kot lahko sredi smeti,\n"
"ki so odvržene ob poti,\n"
"zacveti prekrasen lotos\n"
"lepih barv in vonjav –"

msgid "59"
msgstr ""
"tako tudi učenec Buddhe,\n"
"ki je med ničvredneži,\n"
"s svojo modrostjo zasenči\n"
"njih neumnost in slepoto."

msgid "chap5"
msgstr "Bedak"

msgid "60"
msgstr ""
"Dolga je noč, če bediš,\n"
"dolga je pot, če si utrujen,\n"
"še daljša je samsāra bedakov,\n"
"ki ne poznajo prave resnice."

msgid "61"
msgstr ""
"Če ne najdeš boljšega od sebe\n"
"ali pa človeka, ki ti je enak,\n"
"se raje odloči za samoto –\n"
"saj med bedaki ni prijateljstva."

msgid "62"
msgstr ""
"Bedak je vedno v skrbeh,\n"
"v mislih pri bogastvu in sinovih,\n"
"pri tem pa niti ni sam svoj gospod –\n"
"kaj bo z bogastvom in sinovi?"

msgid "63"
msgstr ""
"Bedak, ki ve, da je neumen,\n"
"je vsaj v tem že modrijan,\n"
"bedak, ki je ponosen na svojo modrost,\n"
"pa je zares bedak."

msgid "64"
msgstr ""
"Čeprav se bedak vse življenje\n"
"druži z modrimi ljudmi,\n"
"nikoli ne spozna resnice –\n"
"kot žlica je, ki ne pozna jedi."

msgid "65"
msgstr ""
"Če pa pameten človek\n"
"le za hip druži se z modrimi,\n"
"hitro bo spoznal resnico –\n"
"kot jezik je, ki takoj okusi jed."

msgid "66"
msgstr ""
"Bedaki brez modrosti\n"
"so sami si sovražniki,\n"
"saj počno veliko zla,\n"
"kar obrodi grenke sadove."

msgid "67"
msgstr ""
"Če dela dobro ne opravimo,\n"
"ga kasneje obžalujemo,\n"
"saj tako delo obrodi\n"
"vedno žalost in obup."

msgid "68"
msgstr ""
"Če pa dela dobro opravimo,\n"
"ga nikoli ne obžalujemo,\n"
"saj tako delo obrodi\n"
"vedno radost in veselje."

msgid "69"
msgstr ""
"Dokler zlo ne dozori,\n"
"je za bedaka kakor med,\n"
"ko pa obrodi sadove,\n"
"takrat bedak zelo trpi."

msgid "70"
msgstr ""
"Čeprav se bedak dolge mesece posti\n"
"in zajema hrano s travnim listom,\n"
"ni vreden niti šestnajstine modreca,\n"
"ki je popolnoma spoznal resnico."

msgid "71"
msgstr ""
"Saj zlo takoj ne dozori –\n"
"kot mleko je, ki se ne sesiri v hipu –\n"
"ampak sledi bedaku in ga žge\n"
"kot žerjavica, ki pod pepelom tli."

msgid "72"
msgstr ""
"Bedak si veča znanje\n"
"samo na lastno škodo –\n"
"z njim si bodočnost uničuje\n"
"in se odmika od modrosti."

msgid "73"
msgstr ""
"Bedak si želi lažno slavo\n"
"in prednost med menihi,\n"
"želi oblast nad samostani\n"
"in spoštovanje vseh ljudi."

msgid "74"
msgstr ""
"»Vsi naj vedo, kaj sem storil,\n"
"tako menihi kot posvetneži,\n"
"vsi naj se zavedajo,\n"
"da jaz vodim vse stvari« –\n"
"take misli ima bedak,\n"
"ki je ponosen, poln želja."

msgid "75"
msgstr ""
"Saj pot posvetnega dobička\n"
"je drugačna od poti v nibbāno –\n"
"zato naj bhikkhu, učenec Buddhe,\n"
"ki to popolnoma razume,\n"
"ne uživa v posvetni slavi –\n"
"živi naj nenavezan v samoti!" 

msgid "chap6"
msgstr "Modrec"  

msgid "76"
msgstr ""
"Če srečaš modrega človeka,\n"
"ki opazi vse napake\n"
"in te nanje opozarja,\n"
"živi s takim učenjakom\n"
"in spoznal boš pot modrosti."

msgid "77"
msgstr ""
"Naj ti svetuje in te opominja\n"
"in naj odvrača te od zla –\n"
"pametni ga cenijo,\n"
"bedaki pa sovražijo."

msgid "78"
msgstr ""
"Ne živi s slabimi ljudmi,\n"
"ne druži se z nizkotneži –\n"
"živi z dobrimi prijatelji,\n"
"druži se z najboljšimi ljudmi!"

msgid "79"
msgstr ""
"Resnicoljubni srečno živijo\n"
"in imajo čiste misli –\n"
"modrec se preda resnici,\n"
"ki jo učijo plemeniti."

msgid "80"
msgstr ""
"Poljedelci vodo usmerjajo,\n"
"lokostrelci puščice ravnajo,\n"
"tesarji les ukrivljajo,\n"
"modri pa si misli obvladujejo."

msgid "81"
msgstr ""
"Modrec trden je kot skala,\n"
"ki ga veter ne premakne,\n"
"saj ga nikdar ne vznemiri\n"
"niti hvala niti graja."

msgid "82"
msgstr ""
"Ko modri zaslišijo resnico,\n"
"se popolnoma umirijo –\n"
"tihi so kot jezero,\n"
"ki je mirno in globoko."

msgid "83"
msgstr ""
"Modreci se vsemu odrečejo\n"
"in ne govorijo o željah –\n"
"če so srečni ali nesrečni,\n"
"tega nikdar ne pokažejo."

msgid "84"
msgstr ""
"Kdor ne išče uspeha z goljufijo,\n"
"kdor si ne želi sinov, bogastva, oblasti,\n"
"kdor ne škoduje sebi niti drugim,\n"
"je moder, pravičen, poln vrlin."

msgid "85"
msgstr ""
"Malo takih je ljudi,\n"
"ki gredo na oni breg –\n"
"večina ostane na tem bregu\n"
"in le teka sem ter tja."

msgid "86"
msgstr ""
"Kdor je spoznal resnico\n"
"in živi v skladu z njo,\n"
"bo odšel na oni breg,\n"
"zapustil bo svet smrtnikov."

msgid "87"
msgstr ""
"Modrec, ki je zapustil dom\n"
"in odšel v samoto,\n"
"naj prežene vso temo,\n"
"stopi naj na pot svetlobe."

msgid "88"
msgstr ""
"Nenavezan, brez želja\n"
"naj uživa v samoti,\n"
"misli naj očisti zla,\n"
"zapusti naj vse strasti."

msgid "89"
msgstr ""
"Kdo je razvil sedem vrlin,\n"
"ki k razsvetljenju vodijo,\n"
"kdor se je odrekel vsem željam\n"
"in je svoboden, brez pohlepa,\n"
"kdor se je osvobodil strasti,\n"
"pozna nibbāno že na tem svetu."  

msgid "chap7"
msgstr "Popolni"  

msgid "90"
msgstr ""
"Kdor je prehodil svojo pot,\n"
"zapustil žalost in se osvobodil,\n"
"kdor je presekal vse vozle,\n"
"ne pozna več ognja želja."

msgid "91"
msgstr ""
"Pazljivi prav vse zapustijo\n"
"in niso več navezani na dom –\n"
"kot labodi so, ki odletijo z jezera\n"
"in gredo svobodni iz kraja v kraj."

msgid "92"
msgstr ""
"Kdor ničesar ne kopiči\n"
"in namen hrane res pozna,\n"
"kdor že dosegel je nibbāno,\n"
"ki je prazna, onkraj vseh stvari,\n"
"njegova pot je brez sledov,\n"
"kot je pot ptic sredi neba."

msgid "93"
msgstr ""
"Kdor je umiril vse strasti\n"
"in nima več želja po hrani,\n"
"kdor že dosegel je svobodo,\n"
"ki je prazna, onkraj vseh stvari,\n"
"njegovo pot težko je najti,\n"
"kot je pot ptic sredi neba."

msgid "94"
msgstr ""
"Kdor ima svoje čute umirjene\n"
"kot konje, ki jih brzda kočijaž,\n"
"mu zavidajo celo bogovi,\n"
"saj je brez ponosa in onkraj vseh želja."

msgid "95"
msgstr ""
"Kdor sprejme vse enako kakor zemlja,\n"
"kdor vztrajen je in trden kot steber,\n"
"kdor je čist kot gorsko jezero –\n"
"na svetu se več ne rodi."

msgid "96"
msgstr ""
"Mirne so njegove misli,\n"
"vse besede in dejanja –\n"
"kdor je vse zares spoznal,\n"
"svoboden je in poln miru."

msgid "97"
msgstr ""
"Človeka, ki je posekal vse vezi,\n"
"pozna nibbāno in ni lahkoveren –\n"
"brez želje je, ne bo se več rodil,\n"
"postal je največji med ljudmi."

msgid "98"
msgstr ""
"V gozdu ali na vasi,\n"
"v gorah ali v dolini –\n"
"kjer živijo popolni,\n"
"je zares čudovito."

msgid "99"
msgstr ""
"Čudoviti so samotni gozdovi,\n"
"ki jih ljudje ne obiskujejo –\n"
"tam uživajo popolni,\n"
"saj so onkraj vseh želja."

msgid "chap8"
msgstr "Tisoči"  

msgid "100"
msgstr ""
"Ena pametna beseda je več vredna\n"
"kot tisoč nesmiselnih besed,\n"
"saj kdor sliši pametno besedo,\n"
"ga takoj prevzame mir."

msgid "101"
msgstr ""
"En moder stavek je več vreden\n"
"kot na tisoče neumnosti –\n"
"saj kdor sliši moder stavek,\n"
"ga takoj prevzame mir."

msgid "102"
msgstr ""
"En sam stih resnice je več vreden\n"
"kot sto neumnih pesmi,\n"
"saj kdor sliši moder stih,\n"
"se popolnoma umiri."

msgid "103"
msgstr ""
"Junak lahko premaga\n"
"na tisoče sovražnikov,\n"
"največji zmagovalec pa je tisti,\n"
"ki je premagal sebe."

msgid "104"
msgstr ""
"Zmaga nad seboj je vredna več\n"
"kot zmaga nad sovražniki –\n"
"saj človeku, ki se obvladuje\n"
"in se vedno zadrži,"

msgid "105"
msgstr ""
"nihče ne more odvzeti zmage,\n"
"niti gandhabbe niti bogovi\n"
"niti Māra skupaj z Brahmo\n"
"ga ne morejo premagati."

msgid "106"
msgstr ""
"Če se pokloniš plemenitemu človeku,\n"
"pa čeprav samo za kratek hip,\n"
"je več vredno kot sto let žrtvovanj\n"
"in vsak mesec na tisoč darovanj –\n"
"tako spoštovanje je res boljše\n"
"kot sto let molitev in obredov."

msgid "107"
msgstr ""
"Če se pokloniš plemenitemu človeku,\n"
"pa čeprav samo za kratek hip,\n"
"je več vredno kot sto let žrtvovanj\n"
"in čaščenja žrtvenega ognja –\n"
"tako spoštovanje je res boljše\n"
"kot sto let molitev in obredov."

msgid "108"
msgstr ""
"Karkoli dober človek podari\n"
"ali žrtvuje v letu dni,\n"
"ni vredno četrtine spoštovanja,\n"
"s katerim modrece pozdravi."

msgid "109"
msgstr ""
"Kdor vedno spoštljivo pozdravlja\n"
"in časti modre ljudi,\n"
"bo užival štiri sadove:\n"
"dolgo življenje, lepoto, srečo in moč."

msgid "110"
msgstr ""
"Več vreden je en dan življenja,\n"
"ki ga človek zbrano preživi,\n"
"kot sto let bedaka,\n"
"ki živi brez zbranosti."

msgid "111"
msgstr ""
"Več vreden je en dan življenja,\n"
"ki ga človek modro preživi,\n"
"kot sto let neumnosti,\n"
"brez najmanjše zbranosti."

msgid "112"
msgstr ""
"Več vreden je en dan naporov\n"
"in vztrajne prizadevnosti,\n"
"kot sto let lenobe,\n"
"v brezmočnem životarjenju."

msgid "113"
msgstr ""
"Več vreden je en dan človeka,\n"
"ki pozna minljivost vseh stvari,\n"
"kot sto let nevedneža,\n"
"ki ne pozna minljivosti."

msgid "114"
msgstr ""
"Več vreden je en dan človeka,\n"
"ki pozna nesmrtnost,\n"
"kot sto let bedaka,\n"
"ki ne pozna nesmrtnosti."

msgid "115"
msgstr ""
"Več vreden je en dan človeka,\n"
"ki pozna resnico,\n"
"kot sto let bedaka,\n"
"ki resnice ne pozna."  

msgid "chap9"
msgstr "Zlo"  

msgid "116"
msgstr ""
"Ne obotavljaj se pri dobrih delih,\n"
"odvračaj misli od vsega zla –\n"
"kdor je pri tem počasen,\n"
"v mislih že počenja zlo."

msgid "117"
msgstr ""
"Če človek naredi napako,\n"
"naj je ne ponavlja kar naprej,\n"
"v tem početju naj ne uživa –\n"
"ponavljanje napak le veča zlo."

msgid "118"
msgstr ""
"Če pa stori človek dobro delo,\n"
"naj ga ponavlja kar naprej,\n"
"v tem početju naj uživa –\n"
"veliko dobrega prinaša srečo."

msgid "119"
msgstr ""
"Hudodelec srečno živi,\n"
"dokler njegovo zlo ne dozori,\n"
"ko pa zlo že obrodi,\n"
"takrat spozna sadove zla."

msgid "120"
msgstr ""
"Dober človek težko živi,\n"
"dokler njegovo dobro ne dozori,\n"
"ko pa dobro že obrodi,\n"
"takrat spozna sadove dobrega."

msgid "121"
msgstr ""
"Ne podcenjuj zla, ne misli,\n"
"da se mu lahko izogneš –\n"
"saj kot se po kapljicah\n"
"napolni vrč do roba,\n"
"tako se bedak napolni z zlom,\n"
"ki se počasi nabira v njem."

msgid "122"
msgstr ""
"Ne podcenjuj dobrega, ne misli,\n"
"da dobrega ne boš spoznal –\n"
"saj kot se po kapljicah\n"
"napolni vrč do roba,\n"
"tako se modrec napolni z dobrim,\n"
"ki se počasi nabira v njem."

msgid "123"
msgstr ""
"Izogibaj se zla kot bogat trgovec,\n"
"ki se boji nevarne poti,\n"
"kot človek, ki hoče živeti\n"
"in se vedno strupa boji."

msgid "124"
msgstr ""
"Če na roki nimaš rane,\n"
"lahko z njo nosiš celo strup,\n"
"saj strup zdravi roki ne škoduje –\n"
"kdor je brez zla, zanj ni nevarnosti."

msgid "125"
msgstr ""
"Bedak, ki užali mirnega človeka\n"
"čistih misli in čistega srca,\n"
"bo kmalu sam izkusil enako zlo –\n"
"vrne se mu kot pesek, vržen v nebo."

msgid "126"
msgstr ""
"Nekateri se na zemlji spet rodijo,\n"
"hudodelci gredo navzdol po poti zla,\n"
"dobri okusijo sadove sreče –\n"
"ugasnejo pa le popolni."

msgid "127"
msgstr ""
"Niti na nebu niti sredi morja\n"
"niti v samotni gorski votlini –\n"
"nikjer na svetu ni takega kraja,\n"
"kjer bi se človek rešil zla."

msgid "128"
msgstr ""
"Niti na nebu niti sredi morja\n"
"niti v samotni gorski votlini –\n"
"nikjer na svetu ni takega kraja,\n"
"kjer človeka ne bi našla smrt."  

msgid "chap10"
msgstr "Palica"  

msgid "129"
msgstr ""
"Vsi se tresejo pred palico,\n"
"vsi se bojijo smrti –\n"
"zavedaj se, da tudi ti si tak,\n"
"zato ne ubijaj in ne želi smrti!"

msgid "130"
msgstr ""
"Vsi se tresejo pred palico,\n"
"vsi ljubijo življenje –\n"
"zavedaj se, da tudi ti si tak,\n"
"zato ne ubijaj in ne želi smrti!"

msgid "131"
msgstr ""
"Kdor s palico kaznuje bitja,\n"
"ki si želijo srečo,\n"
"pri tem pa sam jo išče zase,\n"
"ne bo po smrti našel sreče."

msgid "132"
msgstr ""
"Kdor s palico ne muči bitij,\n"
"ki si želijo srečo,\n"
"pri tem pa sam jo išče zase,\n"
"bo po smrti našel sreče."

msgid "133"
msgstr ""
"Z nikomer ne govori grobo,\n"
"saj grobost se ti povrne –\n"
"prepiranje je res boleče\n"
"in sledijo mu lahko udarci."

msgid "134"
msgstr ""
"Če se popolnoma umiriš\n"
"in si tih kot počen boben,\n"
"si dosegel že nibbāno,\n"
"saj v sebi nimaš več sovraštva."

msgid "135"
msgstr ""
"Kot pastir, ki s palico\n"
"žene govedo na pašo,\n"
"tako tudi starost in smrt\n"
"odženeta ljudem življenje."

msgid "136"
msgstr ""
"Ko bedak počenja zlo,\n"
"se tega niti ne zaveda,\n"
"potem pa ga lastna dejanja\n"
"mučijo in žgejo kot ogenj."

msgid "137"
msgstr ""
"Kdor s palico napada bitja,\n"
"ki so nenasilna in brez zla,\n"
"ga bo kmalu doletela\n"
"vsaj ena od desetih muk:"

msgid "138"
msgstr ""
"nesreča z ostro bolečino,\n"
"težka poškodba na telesu,\n"
"zelo nevarno obolenje\n"
"ali zmeda in norost;"

msgid "139"
msgstr ""
"in še kraljeva nemilost,\n"
"grobo obrekovanje,\n"
"smrt prijatelja\n"
"ali izguba premoženja."

msgid "140"
msgstr ""
"Lahko pa mu še velik ogenj\n"
"požge prav vse njegove hiše,\n"
"po smrti, ko telo razpade,\n"
"pa se neumnež rodi v peklu."

msgid "141"
msgstr ""
"Niti golota, dolgi lasje, umazanija,\n"
"niti post in spanje na golih tleh,\n"
"niti prah, pepel in vztrajno čepenje\n"
"ne morejo očistiti dvomljivca."

msgid "142"
msgstr ""
"Človek, ki živi bogato in razkošno,\n"
"pri tem pa je miren, dober, poln vrlin,\n"
"nenasilen in brez dvoma –\n"
"asket je, pravi bhikkhu, brāhmana."

msgid "143"
msgstr ""
"Redek je na svetu človek,\n"
"ki se lahko sramuje zla,\n"
"da se izogne vsake graje\n"
"kot dober konj udarcev biča."

msgid "144"
msgstr ""
"Bodite torej vztrajni in goreči\n"
"kot dober konj, ki ga je ošvrknil bič –\n"
"saj kdor je veren, vztrajen, poln vrlin,\n"
"kdor zbran, pazljiv razmišlja o resnici,\n"
"je modrec, ki z resnico res živi –\n"
"zapustil bo to veliko trpljenje."

msgid "145"
msgstr ""
"Poljedelci vodo usmerjajo,\n"
"lokostrelci puščice ravnajo,\n"
"tesarji les ukrivljajo,\n"
"zbrani pa si misli obvladujejo."

msgid "chap11"
msgstr "Starost"

msgid "146"
msgstr ""
"Od kod ta radost in veselje,\n"
"ko pa je ves svet v plamenih?\n"
"Obdaja vas popolna tema,\n"
"zakaj ne iščete luči?"

msgid "147"
msgstr ""
"Poglej to lutkasto telo,\n"
"o katerem toliko razmišljamo –\n"
"polno je bolezni, polno ran,\n"
"v njem se vse spreminja, nič ni obstojno!"

msgid "148"
msgstr ""
"Kako je staro to telo,\n"
"kup bolezni in težav,\n"
"razpadajoče je in gnilo –\n"
"življenje s smrtjo se konča!"

msgid "149"
msgstr ""
"Poglej ta kup belih kosti,\n"
"leži kot buče v jeseni,\n"
"ki so odvržene in posušene –\n"
"kdo uživa ob pogledu nanje?"

msgid "150"
msgstr ""
"Ta hiša, zgrajena iz kosti,\n"
"je obdana z mesom in krvjo –\n"
"v njej živijo starost, smrt,\n"
"ponos in sprenevedanje."

msgid "151"
msgstr ""
"Celo kraljevski voz se obrabi\n"
"in tudi to telo se stara –\n"
"vrline dobrih pa ne ostarijo,\n"
"saj se širijo med dobrimi."

msgid "152"
msgstr ""
"Ta neumni človek\n"
"raste kakor vol –\n"
"telo se mu razvija,\n"
"pamet pa je vedno ista."

msgid "153"
msgstr ""
"Mnogokrat sem se rodil,\n"
"iskal sem ga, a nisem našel\n"
"stvarnika, ki je zgradil to hišo –\n"
"boleča sta umiranje in rojstvo!"

msgid "154"
msgstr ""
"Stvarnik, zdaj te dobro vidim,\n"
"te hiše več ne boš gradil!\n"
"Zlomljeni so vsi tramovi\n"
"in podporni drog je uničen,\n"
"spoznal svobodo sem nibbāne,\n"
"dosegel konec sem želja."

msgid "155"
msgstr ""
"Kdor v mladosti ni šel na pot resnice,\n"
"kdor zakladov modrosti ni spoznal,\n"
"propada žalosten kot stara čaplja,\n"
"ki stoji ob suhem jezeru brez rib."

msgid "156"
msgstr ""
"Kdor v mladosti ni šel na pot resnice,\n"
"kdor zakladov modrosti ni spoznal,\n"
"živi zapuščen kot zlomljen lok\n"
"in objokuje vse, kar že davno je minilo."

msgid "chap12"
msgstr "Samostojnost"

msgid "157"
msgstr ""
"Kdor se ima resnično rad,\n"
"naj se zelo dobro pazi –\n"
"modrec naj bo vedno buden,\n"
"prebedi naj vse noči!"

msgid "158"
msgstr ""
"Kdor je sam spoznal resnico\n"
"in v skladu z njo živi,\n"
"tak modrec naj svetuje drugim,\n"
"saj je vzor za vse ljudi."

msgid "159"
msgstr ""
"Kdor je vzgojen, naj vzgaja druge,\n"
"kdor sam zares tako živi,\n"
"kot druge vzgaja in uči –\n"
"najtežje je samoobvladovanje!"

msgid "160"
msgstr ""
"Vsak naj si vedno sam pomaga,\n"
"kdo drug mu je lahko v pomoč?\n"
"Kdor se popolnoma obvlada,\n"
"je zares sam svoj gospod."

msgid "161"
msgstr ""
"Vse zlo si človek sam stori,\n"
"v njem se rodi in razvija –\n"
"zlo zdrobi bedaka kot diamant,\n"
"ki razreže vsak trd kamen."

msgid "162"
msgstr ""
"Če se v človeku razraste zlo\n"
"kot ovijalka okrog drevesa,\n"
"si sam stori prav vse,\n"
"kar mu sovražniki želé."

msgid "163"
msgstr ""
"Človek z lahkoto stori\n"
"slabe in nekoristne stvari,\n"
"z največjo težavo pa stori\n"
"dobre in koristne stvari."

msgid "164"
msgstr ""
"Neumnež, poln napačnih pogledov,\n"
"ki zavrača nauk pravičnih,\n"
"plemenitih in popolnih,\n"
"bo kmalu tudi sam propadel,\n"
"saj živi ničvredno kot plevel,\n"
"razvija se le v lastno škodo."

msgid "165"
msgstr ""
"Človek si sam stori vse zlo\n"
"in sam zato tudi trpi,\n"
"človek se sam izogne zlu,\n"
"sam se ga osvobodi –\n"
"vsak nosi v sebi svoje zlo,\n"
"nihče drug ga ne more očistiti."

msgid "166"
msgstr ""
"Ne zanemarjaj svojih dolžnosti,\n"
"pa čeprav pomagaš drugim,\n"
"ko spoznaš pravo dolžnost,\n"
"se ji posveti — išči le nibbāno!"

msgid "chap13"
msgstr "Svet"

msgid "167"
msgstr ""
"Ne živi nizkotnega življenja,\n"
"ne predajaj se brezbrižnosti,\n"
"ne razvijaj napačnih pogledov,\n"
"ne navezuj se na ta svet!"

msgid "168"
msgstr ""
"Vstani, ne obotavljaj se,\n"
"pojdi na pot resnice!\n"
"Kdor gre na pot resnice,\n"
"bo srečen na tem in onem svetu."

msgid "169"
msgstr ""
"Pojdi na pot resnice,\n"
"izogni se napačni poti –\n"
"kdor gre na pot resnice,\n"
"bo srečen na tem in onem svetu."

msgid "170"
msgstr ""
"Poglej, ta svet je kot mehurček,\n"
"ta svet je prazen kot privid!\n"
"Kdor tako gleda na ta svet,\n"
"je zapustil kraljestvo smrti."

msgid "171"
msgstr ""
"Pridi in poglej, ta svet\n"
"je čudovit kot kraljevska kočija!\n"
"Bedaki se zgubijo v njem,\n"
"modrih pa ne vznemiri."

msgid "172"
msgstr ""
"Kdor je živel brezbrižno,\n"
"potem pa je postal pazljiv,\n"
"razsvetli ves svet kot luna,\n"
"ki se prikaže izza oblakov."

msgid "173"
msgstr ""
"Kdor je storil dosti zla,\n"
"potem pa ga je prekril z dobrim,\n"
"razsvetli ves svet kot luna,\n"
"ki se prikaže izza oblakov."

msgid "174"
msgstr ""
"To je svet slepcev,\n"
"nihče zares ne vidi.\n"
"Le redki pridejo v nebesa –\n"
"kot ptice prosti, brez pasti."

msgid "175"
msgstr ""
"Labodi letajo po poti sonca,\n"
"kdor ima moč, leti v nebo,\n"
"modri pa premagajo Mārovo vojsko\n"
"in se odmaknejo od sveta."

msgid "176"
msgstr ""
"Kdor je prekršil nauk resnice\n"
"in govoril samo laži,\n"
"kdor ne verjame v ponovno rojstvo,\n"
"lahko stori prav vsako zlo."

msgid "177"
msgstr ""
"Skopuhi ne gredo v nebesa,\n"
"bedaki darežljivosti ne hvalijo,\n"
"modrec pa uživa v dajanju,\n"
"srečen je na tem in onem svetu."

msgid "178"
msgstr ""
"Spoznanje nibbāne je več vredno\n"
"kot oblast nad vsem svetom,\n"
"več kot oblast nad vsem vesoljem,\n"
"več kot vsi užitki v nebesih."

msgid "chap14"
msgstr "Buddha"

msgid "179"
msgstr ""
"Zmage mu nihče ne odvzame,\n"
"strasti mu ne sledijo več –\n"
"to je vsevedni Buddha, brez sledov –\n"
"kako ga boste zapeljali?"

msgid "180"
msgstr ""
"Navezanost ga več ne omreži\n"
"in želje ga ne vodijo –\n"
"to je Buddha, ki je onkraj vseh poti,\n"
"kako ga boste zapeljali?"

msgid "181"
msgstr ""
"Buddhe, ki vztrajno meditirajo\n"
"in so modri in pazljivi,\n"
"poznajo mir nibbāne –\n"
"celo bogovi jim zavidajo."

msgid "182"
msgstr ""
"Redko je človeško rojstvo,\n"
"težko je življenje smrtnikov,\n"
"redko se resnica sliši,\n"
"še redkeje pa se rodi Buddha!"

msgid "183"
msgstr ""
"Ne počenjaj zla,\n"
"delaj samo dobro,\n"
"očisti svoje misli –\n"
"tako učijo buddhe."

msgid "184"
msgstr ""
"Potrpežljivost je vrlina,\n"
"največ pa je nibbāna – tako učijo buddhe.\n"
"Kdor muči druge, se ni odrekel svetu,\n"
"kdor žali druge, še ni asket."

msgid "185"
msgstr ""
"Prijaznost, nenasilje\n"
"in obvladovanje,\n"
"zmernost pri hrani,\n"
"samotno bivališče\n"
"in visoka zbranost –\n"
"tako učijo buddhe."

msgid "186"
msgstr ""
"Modrec ve, da niti dež zlatnikov\n"
"ne zadovolji vseh želja,\n"
"saj taki užitki so minljivi\n"
"in se končajo z dukkho."

msgid "187"
msgstr ""
"Modreca ne veselijo\n"
"niti nebeški užitki –\n"
"Buddhov učenec najde srečo\n"
"le v svobodi, brez želja."

msgid "188"
msgstr ""
"Prestrašeni ljudje\n"
"iščejo mnoga zatočišča –\n"
"gore, gozdove, parke,\n"
"drevesa in svetišča."

msgid "189"
msgstr ""
"Vendar to niso varna zatočišča,\n"
"to niso najboljša zatočišča,\n"
"kdor se k njim zateče,\n"
"se ne osvobodi trpljenja."

msgid "190"
msgstr ""
"Kdor pa se zateče Buddhi,\n"
"kdor ima v dhammi in sanghi zatočišče,\n"
"bo pravilno razumel\n"
"štiri plemenite resnice:"

msgid "191"
msgstr ""
"trpljenje, izvor trpljenja\n"
"in prenehanje trpljenja\n"
"in plemenito osemčleno pot,\n"
"ki vodi onkraj trpljenja."

msgid "192"
msgstr ""
"To je varno zatočišče,\n"
"to je najboljše zatočišče,\n"
"kdor pride v tako zatočišče,\n"
"se osvobodi trpljenja."

msgid "193"
msgstr ""
"Redek je res moder človek,\n"
"Buddha se ne rodi povsod –\n"
"kjer pa se rodi tak modrec,\n"
"tam ljudje srečno živijo."

msgid "194"
msgstr ""
"Buddhovo rojstvo prinese srečo,\n"
"srečen je, kdor sliši njegov nauk,\n"
"srečni so otroci Buddhe,\n"
"ki se zbrani podajo na pot."

msgid "195"
msgstr ""
"Kdor vse ariye spoštuje,\n"
"Buddho in njegove učence,\n"
"ki so samsāro zapustili\n"
"in so onkraj žalosti in solz,"

msgid "196"
msgstr ""
"kdor spoštuje vse popolne,\n"
"ki povsod so brez strahu,\n"
"je zares odličen človek,\n"
"nihče mu ne more izmeriti vrlin."

msgid "chap15"
msgstr "Sreča"

msgid "197"
msgstr ""
"Zdaj živimo zelo srečno,\n"
"brez sovraštva med sovražniki –\n"
"med sovražnimi ljudmi\n"
"živimo brez sovraštva!"

msgid "198"
msgstr ""
"Zdaj živimo zelo srečno,\n"
"zdravi smo med bolnimi –\n"
"med bolnimi ljudmi\n"
"živimo brez bolezni!"

msgid "199"
msgstr ""
"Zdaj živimo zelo srečno,\n"
"brez želja med pohlepnimi –\n"
"med pohlepnimi ljudmi\n"
"živimo brez pohlepa!"

msgid "200"
msgstr ""
"Zdaj živimo zelo srečno,\n"
"saj ničesar nimamo –\n"
"sijoči smo kakor bogovi,\n"
"ki žive le od radosti!"

msgid "201"
msgstr ""
"Zmaga prinese sovraštvo,\n"
"saj premaganec težko živi –\n"
"miren človek pa je srečen,\n"
"zapustil je poraz in zmago."

msgid "202"
msgstr ""
"Največji ogenj so strasti,\n"
"sovraštvo je največje zlo,\n"
"telo prinese največ muk,\n"
"največja sreča pa je mir."

msgid "203"
msgstr ""
"Najhujša bolezen je lakota,\n"
"bivanje prinese največ muk –\n"
"kdor to popolnoma razume,\n"
"ve, da je nibbāna pravi mir."

msgid "204"
msgstr ""
"Zdravje je največje bogastvo,\n"
"zadovoljstvo največji zaklad,\n"
"zaupanje je najboljši prijatelj,\n"
"nibbāna pa je največji mir."

msgid "205"
msgstr ""
"Kdor je spoznal mir v samoti,\n"
"kdor je okusil radost spokojnosti,\n"
"je brez strahu in onkraj zla,\n"
"saj pozna okus resnice."

msgid "206"
msgstr ""
"Dobro je srečati popolne,\n"
"življenje z njimi je prijetno;\n"
"če se izogneš še bedakom,\n"
"boš vedno srečen na tem svetu."

msgid "207"
msgstr ""
"Kdor pa se druži z bedaki,\n"
"bo zelo dolgo trpel,\n"
"saj življenje z njimi je težavno\n"
"kot življenje med sovražniki,\n"
"z modrimi pa vedno je prijetno\n"
"kot srečanje s prijatelji."

msgid "208"
msgstr ""
"Zatorej:\n"
"če srečaš modrega človeka,\n"
"ki je pameten in vztrajen,\n"
"plemenit in poln vrlin,\n"
"pojdi z njim na pot modrosti\n"
"kot mesec, ki gre po poti zvezd."

msgid "chap16"
msgstr "Užitki"

msgid "209"
msgstr ""
"Človek, ki je lahkomiseln\n"
"in nikoli ni pazljiv,\n"
"ne išče več resnice\n"
"in zavida vsem, ki se obvladajo."

msgid "210"
msgstr ""
"Osvobodi se užitkov,\n"
"osvobodi se trpljenja –\n"
"tako trpljenje kot užitki,\n"
"oboje prinaša dukkho."

msgid "211"
msgstr ""
"Ne navezuj se na užitke,\n"
"izguba užitkov je boleča –\n"
"kdor je svoboden, brez vezi,\n"
"je onkraj užitkov in trpljenja."

msgid "212"
msgstr ""
"Užitki prinesejo žalost,\n"
"užitki prinesejo strah –\n"
"kdor se osvobodi užitkov,\n"
"je onkraj strahu in žalosti."

msgid "213"
msgstr ""
"Želje prinesejo žalost,\n"
"želje prinesejo strah –\n"
"kdor se osvobodi želja,\n"
"je onkraj strahu in žalosti."

msgid "214"
msgstr ""
"Navezanost prinese žalost,\n"
"navezanost prinese strah –\n"
"kdor se reši vseh vezi,\n"
"zanj ni več strahu in žalosti."

msgid "215"
msgstr ""
"Poželenje spremlja žalost,\n"
"poželenje spremlja strah –\n"
"kdor živi brez želja,\n"
"zanj ni strahu in žalosti."

msgid "216"
msgstr ""
"Pohlep prinese žalost,\n"
"pohlep prinese strah –\n"
"kdor se osvobodi pohlepa,\n"
"je onkraj strahu in žalosti."

msgid "217"
msgstr ""
"Kdor je moder in poln vrlin,\n"
"pravičnik, ki pozna resnico,\n"
"kdor izpolni vse dolžnosti,\n"
"je priljubljen med ljudmi."

msgid "218"
msgstr ""
"Kdor želi doseči »neimenovano«,\n"
"kdor je prežet s to mislijo,\n"
"ni več navezan na užitke –\n"
"vztrajno gre navzgor po toku."

msgid "219"
msgstr ""
"Človeka, ki je bil dolgo na poti\n"
"in se je vrnil domov,\n"
"sprejmejo z veseljem\n"
"vsi znanci in prijatelji."

msgid "220"
msgstr ""
"Tako tudi dobrega človeka,\n"
"ki je umrl in odšel na oni svet,\n"
"pričakajo njegova dobra dela\n"
"kot dragega prijatelja."

msgid "chap17"
msgstr "Jeza"

msgid "221"
msgstr ""
"Zapusti jezo in ponos,\n"
"premagaj vse ovire!\n"
"Kdor nima nič za svoje,\n"
"je brez želja in ne trpi."

msgid "222"
msgstr ""
"Kdor obvlada svojo jezo\n"
"kot divje konje kočijaž,\n"
"je zame pravi kočijaž –\n"
"drugi le držijo za vajeti!"

msgid "223"
msgstr ""
"Z ljubeznijo premagaj jezo,\n"
"premagaj zlo z dobroto,\n"
"skopost premagaj z radodarnostjo,\n"
"lažnivca pa z resnico!"

msgid "224"
msgstr ""
"Govori le resnico in ne jezi se,\n"
"daj vsakemu, ki te zaprosi!\n"
"Kdor sledi te tri poti,\n"
"prišel bo tja, kjer so bogovi."

msgid "225"
msgstr ""
"Modreci so nenasilni\n"
"in se obvladujejo,\n"
"ko izkusijo nesmrtnost,\n"
"se osvobodijo žalosti."

msgid "226"
msgstr ""
"Kdor je vedno buden,\n"
"kdor se noč in dan uči,\n"
"kdor nibbāno vztrajno išče,\n"
"se bo rešil vseh strasti."

msgid "227"
msgstr ""
"To je stara stvar, Atula,\n"
"to ni prav nič novega –\n"
"grajajo te, če si tiho,\n"
"grajajo, če govoriš,\n"
"grajajo te, če si zmeren,\n"
"nič na svetu ni brez graje!"

msgid "228"
msgstr ""
"Saj človeka, ki bi bil brez graje\n"
"ali pa brez visoke hvale,\n"
"doslej še ni bilo na svetu,\n"
"ga ni in tudi ga ne bo."

msgid "229"
msgstr ""
"Kogar pa modri preizkusijo\n"
"in ga potem hvalijo,\n"
"je res pameten in brez napak,\n"
"poln modrosti in vrlin."

msgid "230"
msgstr ""
"Kdo graja takega človeka,\n"
"ki je popoln in čist kot zlato?\n"
"Celo bogovi in sam Brahmā\n"
"ga neprestano hvalijo."

msgid "231"
msgstr ""
"Varuj se jeznih dejanj,\n"
"obvladaj si telo!\n"
"Opusti slaba dela,\n"
"razvijaj dobra dela!"

msgid "232"
msgstr ""
"Varuj se napačnih besed,\n"
"obvladaj si besede!\n"
"Opusti napačne besede,\n"
"govori le dobe besede!"

msgid "233"
msgstr ""
"Varuj se jeznih misli,\n"
"obvladaj svoje misli!\n"
"Opusti jezne misli,\n"
"razvijaj dobre misli!"

msgid "234"
msgstr ""
"Modri obvladajo dejanja,\n"
"modri obvladajo besede,\n"
"modri, ki obvladajo še misli,\n"
"pa se zares obvladajo."

msgid "chap18"
msgstr "Napake"

msgid "235"
msgstr ""
"Zdaj si kot posušen list,\n"
"glasnik smrti te že čaka,\n"
"na pragu smrti stojiš\n"
"in popotnice ni zate."

msgid "236"
msgstr ""
"Zgradi si otok zase,\n"
"hitro napreduj, postani moder!\n"
"Ko boš miren in jasnih misli,\n"
"boš odšel v deželo plemenitih."

msgid "237"
msgstr ""
"Zdaj si že star,\n"
"približal si se smrti,\n"
"postaj ni več na poti\n"
"in tudi popotnice ni zate."

msgid "238"
msgstr ""
"Zgradi si otok zase,\n"
"hitro napreduj, postani moder!\n"
"Ko boš miren in jasnih misli,\n"
"se ne boš več rodil, ne boš več star."

msgid "239"
msgstr ""
"Kot spreten zlatar\n"
"počasi prečisti zlato,\n"
"tako naj se modrec\n"
"vztrajno očisti napak."

msgid "240"
msgstr ""
"Rja, ki se pojavi na železu,\n"
"ga hitro uniči in razžre –\n"
"če se predaš udobnemu življenju,\n"
"boš kmalu šel po poti zla."

msgid "241"
msgstr ""
"Brez ponavljanja se znanje izgubi,\n"
"brez vzdrževanja hiša ne stoji,\n"
"lenoba kvari vso lepoto,\n"
"nepazljivost pa je slab čuvaj."

msgid "242"
msgstr ""
"Razvrat napaka je za žensko,\n"
"napaka darovalca je skopost,\n"
"napačno je prav vse zlo\n"
"na tem svetu in na onem."

msgid "243"
msgstr ""
"Največja izmed vseh napak\n"
"pa gotovo je nevednost –\n"
"osvobodite se nevednosti,\n"
"bodite brez napak!"

msgid "244"
msgstr ""
"Človek, ki je nesramen in vsiljiv,\n"
"predrzen kakor krokar,\n"
"pokvarjen, opravljiv –\n"
"navidez lahko živi."

msgid "245"
msgstr ""
"Skromen, nesebičen človek,\n"
"ki vedno išče le popolnost,\n"
"je čistih misli in dejanj –\n"
"navidez težko živi."

msgid "246"
msgstr ""
"Kdor uničuje življenje\n"
"in govori laži,\n"
"kdor jemlje, kar mu ni dano,\n"
"in z ženami drugih živi,"

msgid "247"
msgstr ""
"kdor se vdaja pijači\n"
"in je lahkomiseln,\n"
"si seka lastne korenine\n"
"in uniči si življenje."

msgid "248"
msgstr ""
"Zato se zavedaj, človek,\n"
"da je neobvladovanje veliko zlo –\n"
"naj ti pohlep in nepravičnost\n"
"ne povzročita dolgih muk!"

msgid "249"
msgstr ""
"Ljudje darujejo po svoji vesti\n"
"ali pa iz lastnega veselja –\n"
"kdor zavida drugim\n"
"hrano in pijačo,\n"
"ne bo dosegel zbranosti\n"
"ne podnevi ne ponoči."

msgid "250"
msgstr ""
"Kdor pa je izkoreninil\n"
"in posekal vso zavist,\n"
"bo dosegel zbranost\n"
"tako podnevi kot ponoči."

msgid "251"
msgstr ""
"Strasti so največji ogenj,\n"
"jeza je najmočnejša spona,\n"
"nevednost je največja mreža,\n"
"največji tok pa je tok želja."

msgid "252"
msgstr ""
"Napake drugih takoj vidimo,\n"
"lastne napake pa s težavo,\n"
"napake drugih takoj pokažemo\n"
"kot pleve, ki jih ločimo od zrnja,\n"
"lastne napake pa hitro skrijemo\n"
"kot zvit goljuf svoje namene."

msgid "253"
msgstr ""
"Kdor išče le napake drugih,\n"
"sam pa je vedno zamerljiv,\n"
"bo vse bolj in bolj zmeden,\n"
"še dolgo se ne bo osvobodil!"

msgid "254"
msgstr ""
"Na nebu ni poti,\n"
"v sebi išči pot –\n"
"ljudje so vedno v težavah,\n"
"popolni pa so brez ovir."

msgid "255"
msgstr ""
"Na nebu ni poti,\n"
"v sebi išči pot –\n"
"nobeden pojav ni večen,\n"
"le buddhe so onkraj sprememb."

msgid "chap19"
msgstr "Pravičnost"

msgid "256"
msgstr ""
"Kdor presoja le po zakonih,\n"
"še ni pravičnik –\n"
"modrec presodi oboje,\n"
"tako dobro kakor zlo."

msgid "257"
msgstr ""
"Kdor je enak do vseh ljudi,\n"
"moder in nepristranski,\n"
"kdor je čuvaj dhamme,\n"
"ta pravi je pravičnik."

msgid "258"
msgstr ""
"Kdor samo veliko govori,\n"
"še ni zares učen –\n"
"učenjak je poln miru,\n"
"brez strahu je in sovraštva."

msgid "259"
msgstr ""
"Kdor samo učeno govori,\n"
"še ne pozna resnice,\n"
"kdor pa sliši par besed\n"
"in takoj razume dhammo\n"
"in živi v skladu z njo –\n"
"ta pravi je pravičnik."

msgid "260"
msgstr ""
"Kdor je siv in ves postaran,\n"
"še ni »star modrijan« –\n"
"tak človek je zastonj živel,\n"
"saj z leti je le ostarel."

msgid "261"
msgstr ""
"Kdor pozna dhammo in resnico,\n"
"kdor je nenasilen, zadržan,\n"
"je pravi modrec, brez napak –\n"
"pravijo mu »star modrijan«."

msgid "262"
msgstr ""
"Kdor je lep in ves prijazen,\n"
"v srcu pa zavisten, goljufiv,\n"
"poln pohlepa in želja –\n"
"ne bo nikoli dober človek."

msgid "263"
msgstr ""
"Kdor pa je odpravil vse napake\n"
"in izkoreninil zlo,\n"
"tak modrec se nikoli ne jezi,\n"
"dober je in poln vrlin."

msgid "264"
msgstr ""
"Če se lažnivec obrije,\n"
"še ne postane bhikkhu –\n"
"kako naj se poda na pot resnice,\n"
"če je poln pohlepa in želja?"

msgid "265"
msgstr ""
"Kdor pa pomiri vse zlo,\n"
"tako veliko kakor malo,\n"
"tak človek se imenuje bhikkhu,\n"
"saj je poln miru in onkraj zla."

msgid "266"
msgstr ""
"Kdor se preživlja z beračenjem,\n"
"še ne postane bhikkhu,\n"
"kajti bhikkhu sprejme dhammo\n"
"in ne samo beračenja."

msgid "267"
msgstr ""
"Kdor se zaveda vseh dejanj,\n"
"kdor je onkraj dobrega in zla\n"
"in zares razume svet –\n"
"tak človek se imenuje bhikkhu."

msgid "268"
msgstr ""
"Zmeden nevednež, ki molči,\n"
"še ni tih mislec, modrijan,\n"
"kajti modrec sprejme dobro\n"
"in se izogne vsemu zlu."

msgid "269"
msgstr ""
"Kdor loči zlo od dobrega,\n"
"je tih mislec, modrijan,\n"
"kdor pozna oba svetova,\n"
"je pravi muni, modrijan."

msgid "270"
msgstr ""
"Kdor ubija živa bitja,\n"
"ne bo nikoli ariya,\n"
"kdor pa je onkraj vsega zla,\n"
"je resnični ariya."

msgid "271"
msgstr ""
"Ne obredi ne pravila\n"
"ne veliko znanje\n"
"ne izkušnja zbranosti\n"
"in življenje v samoti"

msgid "272"
msgstr ""
"ne sreča brez želja,\n"
"ki ljudje je ne poznajo –\n"
"nič naj te ne zadovolji,\n"
"dokler se ne očistiš vsega zla."

msgid "chap20"
msgstr "Pot"

msgid "273"
msgstr ""
"Najboljša pot je osemčlena,\n"
"najboljši izrek je štiričlen,\n"
"najboljše stanje je brezželjnost,\n"
"kdor vidi, je najboljši med ljudmi."

msgid "274"
msgstr ""
"To je edina pot, nobena druga\n"
"ne vodi k čistemu spoznanju –\n"
"pojdite po tej poti\n"
"od nevednosti k svobodi!"

msgid "275"
msgstr ""
"Ko sem si izvlekel trne,\n"
"sem začel kazati pot,\n"
"kdor gre po njej, kdor ji sledi,\n"
"bo dosegel konec dukkhe."

msgid "276"
msgstr ""
"Vsak naj gre sam na pot,\n"
"saj buddhe so le učitelji –\n"
"kdor zbrano ji sledi,\n"
"se bo Māre osvobodil."

msgid "277"
msgstr ""
"Kdor zares spozna,\n"
"da je vse minljivo,\n"
"bo zapustil dukkho –\n"
"to je pot očiščenja."

msgid "278"
msgstr ""
"Kdor zares spozna,\n"
"da je vse boleče,\n"
"bo zapustil dukkho –\n"
"to je pot očiščenja."

msgid "279"
msgstr ""
"Kdor zares spozna,\n"
"da je vse privid,\n"
"bo zapustil dukkho –\n"
"to je pot očiščenja."

msgid "280"
msgstr ""
"Če mlad in močan človek\n"
"zamudi vse priložnosti\n"
"in živi len in neodločen,\n"
"ne bo spoznal modrosti."

msgid "281"
msgstr ""
"Zavedaj se besed, obvladaj misli,\n"
"tvoja dejanja naj bodo brez zla!\n"
"Očisti misli, besede in dejanja,\n"
"pojdi po poti, ki jo učijo modri!"

msgid "282"
msgstr ""
"Zbranost vodi v modrost,\n"
"modrosti ni brez zbranosti.\n"
"Kdor ve, kako modrost nastane\n"
"in kako se izgubi –\n"
"naj se poda na tisto pot,\n"
"ki vodi v modrost."

msgid "283"
msgstr ""
"Posekaj gozd strasti, ne pa dreves,\n"
"saj v takem gozdu je nevarnost!\n"
"Posekajte vse strasti in želje,\n"
"zapustite gozd strasti!"

msgid "284"
msgstr ""
"Dokler ne uničiš vseh želja,\n"
"vseh navezanosti na ljudi,\n"
"tako dolgo boš še nesvoboden,\n"
"kot teliček, ki odvisen je od krave."

msgid "285"
msgstr ""
"Posekaj vso navezanost,\n"
"kot bi odtrgal jesenski lotos!\n"
"Podaj se na pot miru,\n"
"ki vodi v nibbāno!"

msgid "286"
msgstr ""
"Tukaj bom živel v deževju,\n"
"tam pa poleti in pozimi –\n"
"tako bedak razmišlja,\n"
"ki se ne zaveda smrti."

msgid "287"
msgstr ""
"Človeka, ki je poln želja\n"
"in razmišlja o bogastvu in sinovih,\n"
"odnese smrt kot hudournik,\n"
"ki odplavi spečo vas."

msgid "288"
msgstr ""
"Sinovi ga ne ščitijo,\n"
"ne oče ne sorodniki,\n"
"saj kogar odnese smrt,\n"
"zanj ni več pomoči."

msgid "289"
msgstr ""
"Zato naj modrec,\n"
"ki ta svet zares pozna,\n"
"hitro očisti pot\n"
"in gre v nibbāno!"

msgid "chap21"
msgstr "Razni Izreki"

msgid "290"
msgstr ""
"Če lahko zamenjaš\n"
"majhne užitke za veliko srečo,\n"
"bodi moder — pusti užitke\n"
"in spoznaj veliko srečo!"

msgid "291"
msgstr ""
"Kdor razmišlja le o lastni sreči,\n"
"drugim pa povzroči trpljenje,\n"
"se zla ne bo osvobodil,\n"
"saj je ves ovit v sovraštvo."

msgid "292"
msgstr ""
"Kdor se izogne vsem dolžnostim\n"
"in počne samo neumnosti,\n"
"je nepazljiv in domišljav –\n"
"odnesel ga bo tok želja."

msgid "293"
msgstr ""
"Kdor pa jasno se zaveda\n"
"prav vseh svojih dejanj,\n"
"vedno opravi vse dolžnosti\n"
"in ne počne neumnosti –\n"
"kdor je buden in pazljiv,\n"
"bo svoboden od želja."

msgid "294"
msgstr ""
"Ubil je mater in očeta\n"
"in dva bojevita kralja,\n"
"uničil je deželo in ministra –\n"
"brāhmana je onkraj zmede in trpljenja!"

msgid "295"
msgstr ""
"Ubil je mater in očeta\n"
"in dva bojevita kralja,\n"
"prehodil je nevarno pot –\n"
"brāhmana gre brez strahu!"

msgid "296"
msgstr ""
"Učenci Gotame so vedno budni,\n"
"resnično budni so učenci Gotame,\n"
"saj neprestano, dan in noč,\n"
"razmišljajo o Buddhi."

msgid "297"
msgstr ""
"Učenci Gotame so vedno budni,\n"
"resnično budni so učenci Gotame,\n"
"saj neprestano, dan in noč,\n"
"razmišljajo o dhammi."

msgid "298"
msgstr ""
"Učenci Gotame so vedno budni,\n"
"resnično budni so učenci Gotame,\n"
"saj neprestano, dan in noč,\n"
"razmišljajo o sanghi."

msgid "299"
msgstr ""
"Učenci Gotame so vedno budni,\n"
"resnično budni so učenci Gotame,\n"
"saj neprestano, dan in noč,\n"
"zavedajo se svojih dejanj."

msgid "300"
msgstr ""
"Učenci Gotame so vedno budni,\n"
"resnično budni so učenci Gotame,\n"
"saj neprestano, dan in noč,\n"
"živijo v nenasilju."

msgid "301"
msgstr ""
"Učenci Gotame so vedno budni,\n"
"resnično budni so učenci Gotame,\n"
"saj neprestano, dan in noč,\n"
"razvijajo modrost in zbranost."

msgid "302"
msgstr ""
"Težko je zapustiti svet,\n"
"težko je živeti med ljudmi,\n"
"popotnik v samsāri\n"
"zares težko živi –\n"
"zato ne bodite popotniki,\n"
"zapustite samsāro."

msgid "303"
msgstr ""
"Kdor je vztrajen in poln vrlin,\n"
"bo kmalu slaven in bogat –\n"
"kamorkoli gre tak človek,\n"
"ga ljudje spoštujejo."

msgid "304"
msgstr ""
"Dobre ljudi povsod opazijo\n"
"kot zasnežene vrhove Himālaye,\n"
"zli pa se v temi skrivajo\n"
"kot ponoči izstreljene puščice."

msgid "305"
msgstr ""
"Vsak naj sam živi,\n"
"sam naj se vedno trudi –\n"
"kdor sam sebe obvladuje,\n"
"srečno živi v samoti."

msgid "chap22"
msgstr "Sadovi Zla"

msgid "306"
msgstr ""
"Lažnivec gre v pekel\n"
"in tudi hudodelec, ki taji svoja dejanja –\n"
"po smrti bosta oba enaka,\n"
"sadove zla bosta spoznala."

msgid "307"
msgstr ""
"Mnogi, ki so oblečeni v oranžno,\n"
"so polni zla in brez obvladovanja –\n"
"kdor je poln zla in dela zlo,\n"
"se bo zato rodil v peklu."

msgid "308"
msgstr ""
"Lahkomiseln in zloben človek,\n"
"ki se preživlja z beračenjem,\n"
"bi si storil dosti manjše zlo,\n"
"če bi požrl ognjeno kroglo."

msgid "309"
msgstr ""
"Brezbrižneža, ki prešuštvuje,\n"
"štiri nesreče doletijo:\n"
"ponižanje, nemirno spanje,\n"
"graja in trpljenje."

msgid "310"
msgstr ""
"Ponižanje prinese zlo usodo,\n"
"kratek užitek spremlja strah,\n"
"kralj hudo kaznuje tak prekršek –\n"
"zato ne prešuštvujte!"

msgid "311"
msgstr ""
"Kdor nespretno prime travo,\n"
"si bo porezal roko –\n"
"menih, ki sanghe ne razume,\n"
"se bo gotovo rodil v peklu."

msgid "312"
msgstr ""
"Lahkomiselna dejanja,\n"
"napačen razvoj\n"
"in bhikkhu, poln dvomov –\n"
"ne obrode lepih sadov."

msgid "313"
msgstr ""
"Kar je storiti treba,\n"
"stori brez odlašanja,\n"
"saj brezbrižen asketizem\n"
"dvigne le še več prahu."

msgid "314"
msgstr ""
"Najbolje je, če brez zla živiš,\n"
"saj zlo prinese le trpljenje,\n"
"najbolje je, če delaš dobro,\n"
"saj zato ne boš trpel."

msgid "315"
msgstr ""
"Varuj se kot obmejno mesto,\n"
"ki je zastraženo od vseh strani,\n"
"tako od znotraj kot od zunaj.\n"
"Ne zapravljaj svojega življenja!\n"
"Kdor je brezbrižen le za hip,\n"
"se bo kmalu znašel v peklu!"

msgid "316"
msgstr ""
"Kdor se brez vzroka sramuje,\n"
"pravega sramu pa ne pozna,\n"
"tak človek napačno presoja\n"
"in spušča se po poti zla."

msgid "317"
msgstr ""
"Kdor prestrašen je brez vzroka,\n"
"pravega strahu pa ne pozna,\n"
"tak človek napačno presoja\n"
"in spušča se po poti zla."

msgid "318"
msgstr ""
"Kdor napake vidi, kjer jih ni,\n"
"pravih napak pa ne opazi,\n"
"tak človek napačno presoja\n"
"in spušča se po poti zla."

msgid "319"
msgstr ""
"Kdor pa popolnoma razloči\n"
"prave poglede od napačnih,\n"
"tak človek prav razmišlja\n"
"in gre navzgor po poti sreče."

msgid "chap23"
msgstr "Slon"

msgid "320"
msgstr ""
"Mirno bom prenesel vse žalitve\n"
"kot mogočen slon sredi bojišča,\n"
"ki se za puščice ne zmeni,\n"
"saj ljudje se ne obvladajo."

msgid "321"
msgstr ""
"Ukročene slone vodijo v boj,\n"
"udomačene konje jezdi kralj,\n"
"najboljši človek se obvlada\n"
"in prenese vse žalitve."

msgid "322"
msgstr ""
"Odlične so udomačene mule\n"
"in plemeniti konji iz dežele Sindh,\n"
"odlični so udomačeni sloni,\n"
"še boljši pa je človek, ki se obvlada!"

msgid "323"
msgstr ""
"Kdor gre na pot z vozovi,\n"
"ne bo prišel v »deželo brez sledov«,\n"
"saj tja lahko prispe le tisti,\n"
"ki se obvlada in gre brez sledov."

msgid "324"
msgstr ""
"Mogočen slon Dhanapālaka\n"
"postane divji v času parjenja –\n"
"v ujetništvu ne more jesti,\n"
"ko se spominja slonovskega gaja."

msgid "325"
msgstr ""
"Len in zaspan požeruh,\n"
"leži in se valja kot svinja,\n"
"ki se nažrla je pomij –\n"
"velikokrat se bo rodil!"

msgid "326"
msgstr ""
"Prej so misli šle, kamor so hotele,\n"
"prepustile so se željam in užitkom –\n"
"zdaj pa jih bom popolnoma obvladal\n"
"kot krotilec svoje divje slone."

msgid "327"
msgstr ""
"Uživajte v pazljivosti\n"
"in pazite na svoje misli,\n"
"izvlecite se iz težav\n"
"kot slon iz blatnega močvirja!"

msgid "328"
msgstr ""
"Če srečaš modrega prijatelja,\n"
"človeka, ki je dober in vzgojen,\n"
"pojdi z njim vesel in zbran,\n"
"premagaj vse nevarnosti!"

msgid "329"
msgstr ""
"Če pa ne najdeš modrega prijatelja,\n"
"človeka, ki je dober in vzgojen,\n"
"ostani raje sam kot slon v gozdovih,\n"
"kot kralj, ki ostal je brez kraljestva!"

msgid "330"
msgstr ""
"Kajti boljše je življenje v samoti\n"
"kot pa prijateljstvo z bedaki –\n"
"živi sam in ne delaj zla,\n"
"bodi brezskrben, kot je slon v gozdovih!"

msgid "331"
msgstr ""
"Prijetno je prijateljstvo,\n"
"prijetno je, če z vsemi si zadovoljen,\n"
"ob smrti so prijetna dobra dela,\n"
"prijetno je, če rešiš se trpljenja."

msgid "332"
msgstr ""
"Skrb za mater je prijetna,\n"
"prijetna je skrb za očeta,\n"
"prijetno je v družbi z asketi\n"
"in v spremstvu brāhmanov."

msgid "333"
msgstr ""
"Prijetne so vrline v starosti,\n"
"prijetno je, če nimaš dvomov,\n"
"prijetno je razvijanje modrosti,\n"
"prijetno, če ne delaš zla."

msgid "chap24"
msgstr "Želje"

msgid "334"
msgstr ""
"Želje lahkomiselnega človeka\n"
"rastejo kot ovijalke –\n"
"kot opica, ki v gozdu išče sadeže,\n"
"skače tak človek iz življenja v življenje."

msgid "335"
msgstr ""
"Ko premagajo človeka želje\n"
"in navezanost na svet,\n"
"se razbohoti njegova žalost\n"
"kot plevel po obilnem dežju."

msgid "336"
msgstr ""
"Če pa premaga nizkotne želje\n"
"in obvlada navezanost na svet,\n"
"zdrsi z njega vse trpljenje\n"
"kot kaplja vode z lotosa."

msgid "337"
msgstr ""
"Zato vam pravim — bodite srečni,\n"
"vsi, ki ste zdaj sem prišli!\n"
"Uničite vse želje,\n"
"kot izruva zeliščar korenine!\n"
"Naj vas Māra več ne zlomi\n"
"kot povodenj šibek trs!"

msgid "338"
msgstr ""
"Če so korenine močne in zdrave,\n"
"bo posekano drevo popolno zraslo –\n"
"dokler ne uničiš vseh želja,\n"
"se bo stalno vračalo trpljenje."

msgid "339"
msgstr ""
"Šestintrideset močnih tokov,\n"
"ki so polni prijetnih užitkov,\n"
"odnaša zaslepljenega človeka\n"
"na valovih želja in strasti."

msgid "340"
msgstr ""
"Povsod tečejo tokovi,\n"
"povsod brstijo ovijalke –\n"
"ko vidiš nove popke in poganjke,\n"
"z modrostjo jim posekaj korenine."

msgid "341"
msgstr ""
"Tokovi želja gredo povsod,\n"
"povsod jih spremljajo užitki –\n"
"kdor grabi užitke in išče srečo,\n"
"se bo ponovno rodil in bo ponovno star."

msgid "342"
msgstr ""
"Ljudje, ki so polni želja,\n"
"tekajo kot preplašeni zajci –\n"
"zvezani so z vezmi in okovi,\n"
"dolgo bodo še trpeli."

msgid "343"
msgstr ""
"Ljudje, ki so polni želja,\n"
"tekajo kot preplašeni zajci –\n"
"kdor pa želi doseči brezželjnost,\n"
"naj opusti vse želje in strah."

msgid "344"
msgstr ""
"Poglejte tega neumnega človeka –\n"
"bil je svoboden, užival je v samoti,\n"
"potem pa se vrnil v gozd želja –\n"
"resnično, sam si je nadel okove!"

msgid "345"
msgstr ""
"Vezi iz železa, lesa ali konoplje\n"
"niso močne — pravijo modri –\n"
"dosti močnejša je navezanost\n"
"na zlato, dragulje, žene in sinove."

msgid "346"
msgstr ""
"Ta vez je močna — pravijo –\n"
"voljna je, a trdna in nezlomljiva.\n"
"Modri jo posekajo in so brez želja,\n"
"nenavezani na svet, vse užitke zapustijo."

msgid "347"
msgstr ""
"Kdor je poln strasti, bo padel v tok želja\n"
"kot pajek, ki se ujame v lastno mrežo –\n"
"modri vse posekajo in so brez želja,\n"
"nenavezani na svet, vso dukkho zapustijo."

msgid "348"
msgstr ""
"Pusti preteklost, pusti prihodnost,\n"
"pusti sedanjost — pojdi na oni breg!\n"
"Ko bodo tvoje misli res svobodne,\n"
"ne boš več star, ne boš se več rodil."

msgid "349"
msgstr ""
"Zmeden človek, ki je poln strasti\n"
"in išče le prijetnosti,\n"
"si neprestano množi želje\n"
"in z njimi veča si vezi."

msgid "350"
msgstr ""
"Kdor pa umiri svoje misli\n"
"in tudi nevšečnosti spozna,\n"
"se bo osvobodil želja –\n"
"posekal bo Mārove vezi."

msgid "351"
msgstr ""
"Kdor je popoln in neustrašen,\n"
"onkraj želja in strasti,\n"
"kdor je posekal vse trne,\n"
"se ne bo več na svetu rodil."

msgid "352"
msgstr ""
"Brez vezi in brez želja živi,\n"
"pozna pomen besed in stavkov,\n"
"razume sporočilo spisov –\n"
"to je človek, ki je zadnjič na tem svetu\n"
"in ne bo se več rodil,\n"
"to je resnično velik modrec."

msgid "353"
msgstr ""
"Vse sem premagal, vse sem spoznal,\n"
"osvobodil sem se vseh stvari,\n"
"vse sem zapustil, svoboden sem, brez želja –\n"
"sam sem našel pot, kdo naj bi bil moj učitelj?"

msgid "354"
msgstr ""
"Najboljši dar je dar resnice,\n"
"najboljši okus je okus resnice,\n"
"največji užitek je resnica,\n"
"brezželjnost pa je največja sreča!"

msgid "355"
msgstr ""
"Nevedneže bogastvo uničuje,\n"
"ne pa tiste, ki gredo na oni breg,\n"
"saj bedaki v želji za bogastvom\n"
"pogubijo sebe in še druge."

msgid "356"
msgstr ""
"Plevel uničuje polja,\n"
"strasti uničujejo ljudi,\n"
"zato daruj brezstrastnim –\n"
"tak dar obilno obrodi."

msgid "357"
msgstr ""
"Plevel uničuje polja,\n"
"sovraštvo pa ljudi,\n"
"zato daruj le srečnim –\n"
"tak dar obilno obrodi."

msgid "358"
msgstr ""
"Plevel uničuje polja,\n"
"nevednost pa ljudi,\n"
"zato daruj le modrim –\n"
"tak dar obilno obrodi."

msgid "359"
msgstr ""
"Plevel uničuje polja,\n"
"želje pa ljudi,\n"
"zato daruj le brezželjnim –\n"
"tak dar obilno obrodi."

msgid "chap25"
msgstr "Bhikkhu"

msgid "360"
msgstr ""
"Dobro je obvladovanje vida,\n"
"dobro je obvladovanje sluha,\n"
"dobro je obvladovanje vonja,\n"
"dobro je obvladovanje okusa,"

msgid "361"
msgstr ""
"dobro je obvladovanje telesa,\n"
"dobro je obvladovanje besed,\n"
"dobro je obvladovanje misli,\n"
"dobro je obvladovanje čutov –\n"
"bhikkhu, ki vse to obvlada,\n"
"se popolnoma osvobodi trpljenja."

msgid "362"
msgstr ""
"Kdor obvlada vse korake in dejanja,\n"
"vse besede in misli,\n"
"kdor srečen, zbran živi v samoti –\n"
"ta je zame bhikkhu!"

msgid "363"
msgstr ""
"Bhikkhu, ki ve, kaj govori,\n"
"je moder in ni domišljav –\n"
"kako prijetno ga je slišati,\n"
"ko razloži pomen besed in spisov!"

msgid "364"
msgstr ""
"Bhikkhu, ki živi z resnico,\n"
"o njej razmišlja, se je veseli,\n"
"vedno zaveda se resnice –\n"
"nikoli je ne bo izgubil!"

msgid "365"
msgstr ""
"Kar si prejel, ne zaničuj,\n"
"pa tudi drugim ne zavidaj –\n"
"bhikkhu, ki je poln zavisti,\n"
"ne bo dosegel zbranosti."

msgid "366"
msgstr ""
"Čeprav dobi le majhen dar,\n"
"ga bhikkhu sploh ne zaničuje –\n"
"zato ga hvalijo celo bogovi,\n"
"saj je buden, brez napak."

msgid "367"
msgstr ""
"Kdor ni navezan na ta svet,\n"
"kdor nima čisto nič za svoje\n"
"in, česar ni, ne obžaluje –\n"
"ta je zame pravi bhikkhu."

msgid "368"
msgstr ""
"Bhikkhu, ki je poln ljubezni\n"
"in verjame v Buddhov nauk,\n"
"bo spoznal največji mir,\n"
"nibbāno, ki vse pomiri."

msgid "369"
msgstr ""
"Izprazni si ta čoln, bhikkhu,\n"
"in hitro boš napredoval –\n"
"posekaj želje in sovraštvo\n"
"in dosegel boš nibbāno."

msgid "370"
msgstr ""
"Pet jih posekaj, pet zapusti,\n"
"pet pa še naprej razvijaj –\n"
"bhikkhu, ki je posekal pet vezi,\n"
"je zapustil tok želja."

msgid "371"
msgstr ""
"Zberi se, bhikkhu, ne bodi lahkomiseln,\n"
"naj misli ti ne bledijo med čutnimi užitki!\n"
"Bodi pazljiv, da ne požreš žareče krogle,\n"
"saj potem boš gorel in vpil — to je muka!"

msgid "372"
msgstr ""
"Brez modrosti ni zbranosti,\n"
"brez zbranosti pa ni modrosti –\n"
"kdor je moder in zbran,\n"
"je prestopil prag nibbāne."

msgid "373"
msgstr ""
"Bhikkhu, ki je odšel v samoten kraj,\n"
"mirnih, čistih misli, brez strasti,\n"
"uživa radost in veselje –\n"
"spoznal je že nesmrtnost."

msgid "374"
msgstr ""
"Ko popolnoma dojame\n"
"nastajanje in izginjanje stvari,\n"
"uživa radost in veselje –\n"
"spoznal je že nesmrtnost."

msgid "375"
msgstr ""
"Tak naj bo začetek\n"
"v življenju bhikkhuja:\n"
"obvladovanje čutov, zadovoljstvo,\n"
"življenje po pravilih\n"
"in prijateljstvo z ljudmi,\n"
"ki so vztrajni in pošteni."

msgid "376"
msgstr ""
"Prijazen naj bo, gostoljuben\n"
"in prijetnega vedenja –\n"
"tako bo vedno poln veselja,\n"
"dukkhe se bo osvobodil."

msgid "377"
msgstr ""
"Kot suhi cvetovi,\n"
"ki odpadejo z jasmina,\n"
"naj z vas odpadajo strasti\n"
"in vse sovraštvo, menihi!"

msgid "378"
msgstr ""
"Bhikkhu, ki je zapustil svet,\n"
"je miren in resnično zbran –\n"
"mirne so njegove misli,\n"
"njegove besede in dejanja."

msgid "379"
msgstr ""
"Vsak naj se sam vzpodbuja,\n"
"sam naj se obvlada in zadrži –\n"
"bhikkhu, če boš buden in pazljiv,\n"
"boš zares srečno živel."

msgid "380"
msgstr ""
"Vsak naj si sam pomaga,\n"
"vsak naj si sam najde pot –\n"
"zato sam sebe obvladuj\n"
"kot svoje konje kočijaž!"

msgid "381"
msgstr ""
"Bhikkhu, ki je poln modrosti\n"
"in verjame v Buddhov nauk,\n"
"bo spoznal največji mir,\n"
"srečo, ki vse pomiri."

msgid "382"
msgstr ""
"Če gre bhikkhu, čeprav še mlad,\n"
"po poti, ki jo Buddha je učil,\n"
"razsvetli ves svet kot luna,\n"
"ki se prikaže izza oblakov."

msgid "chap26"
msgstr "Brāhmaṇa"

msgid "383"
msgstr ""
"Presekaj tok in vztrajno napreduj,\n"
"zapusti vse užitke, brāhmana!\n"
"Ko boš spoznal minljivost vseh stvari,\n"
"boš izkusil stanje ne-minljivosti."

msgid "384"
msgstr ""
"Ko doseže popolno zbranost in modrost,\n"
"gre brāhmana na oni breg,\n"
"takrat spozna naravo vseh stvari,\n"
"osvobodi se vseh vezi."

msgid "385"
msgstr ""
"Kdor je onkraj obeh bregov,\n"
"zanj ne obstaja svet nasprotij,\n"
"kdor je svoboden, brez strahu –\n"
"je zame pravi brāhmana!"

msgid "386"
msgstr ""
"Kdor je zbran in poln miru,\n"
"brez napak in brez strasti,\n"
"je dosegel končni cilj –\n"
"tak je zame brāhmana!"

msgid "387"
msgstr ""
"Podnevi sije sonce,\n"
"ponoči sveti mesec,\n"
"kralj sije na prestolu,\n"
"brāhmana pa v zbranosti –\n"
"Buddha sije dan in noč,\n"
"Buddha je vedno poln sijaja!"

msgid "388"
msgstr ""
"Kdor je onkraj zlega, je brāhmana,\n"
"kdor živi mirno, je asket,\n"
"kdor je zapustil vse napake,\n"
"pa je resničen samotar."

msgid "389"
msgstr ""
"Nihče naj ne udari brāhmane,\n"
"pa tudi brāhmana naj se ne jezi –\n"
"gorje mu, kdor udari brāhmano,\n"
"gorje brāhmani, če se zato jezi!"

msgid "390"
msgstr ""
"Saj za brāhmano je dosti bolje,\n"
"če ne razmišlja o užitkih –\n"
"ko izgine želja po nasilju,\n"
"se umiri tudi trpljenje."

msgid "391"
msgstr ""
"Kdor obvlada svoje misli,\n"
"svoje besede in dejanja,\n"
"kdor je popolnoma brez zlega,\n"
"je zame pravi brāhmana!"

msgid "392"
msgstr ""
"Kot brāhmana časti žrtveni ogenj,\n"
"tako spoštuj človeka,\n"
"ki ti je pokazal dhammo,\n"
"nauk, ki ga je učil Buddha."

msgid "393"
msgstr ""
"Nihče ni brāhmana po rojstvu,\n"
"zaradi sorodstva ali dolgih las –\n"
"kdor pa pozna resnico in pravičnost,\n"
"je res čist, pravi brāhmana."

msgid "394"
msgstr ""
"Čemu dolgi lasje, nevednež,\n"
"čemu obleka iz kozje kože?\n"
"Tvoja zunanjost je urejena,\n"
"znotraj pa si poln strasti!"

msgid "395"
msgstr ""
"Kdor je oblečen v prašne cunje\n"
"in suh, da se mu vidijo kosti,\n"
"kdor zbran živi v samotnem gozdu,\n"
"je zame pravi brāhmana."

msgid "396"
msgstr ""
"Kdor se rodi v dobri družini\n"
"in je zato ponosen, domišljav,\n"
"tak človek še ni brāhmana,\n"
"saj je poln strasti, želja –\n"
"kdor pa je svoboden, brez vezi,\n"
"je zame pravi brāhmana."

msgid "397"
msgstr ""
"Kdor je odvrgel vse okove\n"
"in se ničesar ne boji,\n"
"je zame pravi brāhmana,\n"
"saj je svoboden, onkraj vseh vezi."

msgid "398"
msgstr ""
"Kdor posekal je vezi in spone,\n"
"kdor je uničil vse zapahe in vrvi,\n"
"potem pa še odvrgel prečni tram,\n"
"je res svoboden, pravi brāhmana."

msgid "399"
msgstr ""
"Kdor je brez jeze lahko prenese\n"
"zmerjanje, udarce, muke,\n"
"kdor je res potrpežljiv,\n"
"je zame pravi brāhmana."

msgid "400"
msgstr ""
"Kdor je prijateljski in ves predan,\n"
"vrl, vzgojen in brez želja,\n"
"kdor je zadnjič na tem svetu,\n"
"je zame pravi brāhmana."

msgid "401"
msgstr ""
"Njegovi užitki so odpadli\n"
"kot vodna kaplja z lotosa,\n"
"kot gorčično seme z igline konice –\n"
"je zame pravi brāhmana!"

msgid "402"
msgstr ""
"Kdor je že spoznal\n"
"konec dukkhe na tem svetu,\n"
"kdor se je osvobodil bremena,\n"
"je zame pravi brāhmana."

msgid "403"
msgstr ""
"Kdor je učen in zelo moder,\n"
"videc, ki pozna obe poti,\n"
"kdor dosegel je najvišji cilj,\n"
"je zame pravi brāhmana."

msgid "404"
msgstr ""
"Kdor se ne druži z ljudmi\n"
"niti ne živi s samotarji,\n"
"je nenavezan, brez želja –\n"
"tak je pravi brāhmana."

msgid "405"
msgstr ""
"Kdor do vseh je nenasilen,\n"
"tako do šibkih kot do močnih,\n"
"kdor ne ubije in smrti ne želi,\n"
"je zame pravi brāhmana."

msgid "406"
msgstr ""
"Prijateljski je s sovražniki\n"
"in miren nad nasilneži,\n"
"med pohlepneži pa brez želja –\n"
"je pravi brāhmana."

msgid "407"
msgstr ""
"Z njega sta odpadla jeza in pohlep\n"
"kot gorčično zrno z igline konice,\n"
"kdor je brez ponosa, onkraj vseh klevet –\n"
"je zame pravi brāhmana."

msgid "408"
msgstr ""
"Mirne so njegove besede\n"
"in vedno govori resnico,\n"
"nikogar ne užali, razjezi –\n"
"tak je pravi brāhmana."

msgid "409"
msgstr ""
"Kdor ne vzame nič, kar mu ni dano,\n"
"naj bo veliko ali majhno,\n"
"prijetno ali neprijetno –\n"
"je zame pravi brāhmana."

msgid "410"
msgstr ""
"Na tem svetu nima več želja,\n"
"za oni svet nobenih upov ne goji\n"
"in je svoboden, brez strahu –\n"
"tak je zame brāhmana."

msgid "411"
msgstr ""
"Kdor je izkusil nesmrtnost\n"
"in s spoznanjem odvrgel dvom,\n"
"je nenavezan, brez želja –\n"
"tak je pravi brāhmana."

msgid "412"
msgstr ""
"Kogar na svetu nič ne omejuje,\n"
"kdor je onkraj dobrega in zla,\n"
"je miren, brez žalosti in brez želja –\n"
"tak je zame brāhmana."

msgid "413"
msgstr ""
"Kdor je čist kot mesec, jasen,\n"
"poln miru in ves sijoč,\n"
"kdor se je osvobodil sveta,\n"
"je zame pravi brāhmana."

msgid "414"
msgstr ""
"Kdor je prehodil to močvirje,\n"
"kdor je prehodil to težko pot,\n"
"kdor je premagal samsāro\n"
"in se osvobodil vseh zmot,\n"
"kdor je prišel na oni breg,\n"
"je zbran, brez dvomov in strasti –\n"
"tak človek je spoznal nibbāno,\n"
"tak je zame brāhmana."

msgid "415"
msgstr ""
"Kdor je zapustil čutne užitke\n"
"in samoten, brez doma živi,\n"
"kdor je onkraj čutnega življenja,\n"
"je zame pravi brāhmana."

msgid "416"
msgstr ""
"Kdor se je odrekel vsem željam\n"
"in samoten, brez doma živi,\n"
"kdor se je rešil vseh vezi,\n"
"je zame pravi brāhmana."

msgid "417"
msgstr ""
"Kdor je odvrgel človeške vezi\n"
"in zapustil tudi božanske,\n"
"kdor se je rešil vseh vezi,\n"
"je zame pravi brāhmana."

msgid "418"
msgstr ""
"Kdor je zapustil užitke in trpljenje\n"
"in miren, brez strasti živi,\n"
"je junak, ki je premagal svet –\n"
"tak je zame brāhmana."

msgid "419"
msgstr ""
"Kdor popolnoma pozna\n"
"smrt in rojstvo vseh ljudi,\n"
"kdor je buden, srečen, brez želja,\n"
"je zame pravi brāhmana."

msgid "420"
msgstr ""
"Nihče ne pozna njegove poti,\n"
"ne bogovi ne gandhabbe ne ljudje,\n"
"saj je popoln, brez strasti –\n"
"tak je pravi brāhmana."

msgid "421"
msgstr ""
"Kdor ni navezan na preteklost,\n"
"na sedanjost in bodočnost,\n"
"kdor nima nič in nič ne obdrži,\n"
"je zame pravi brāhmana."

msgid "422"
msgstr ""
"Kdor je plemenit in brez strahu,\n"
"modrec, ki je vse premagal\n"
"in je miren, buden, razsvetljen,\n"
"je zame pravi brāhmana."

msgid "423"
msgstr ""
"Kdor pozna vsa prejšnja rojstva,\n"
"kdor se je smrti osvobodil,\n"
"kdor pozna radost v nebesih\n"
"in trpljenje v peklu,\n"
"je resnično onkraj vseh želja –\n"
"to je pravi modrec, pravi brāhmana."
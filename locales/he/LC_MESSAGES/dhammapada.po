msgid "title"
msgstr "דהאמאפאדה"

msgid "chaps"
msgstr "פרקים"

msgid "fontsize"
msgstr "גודל גופן"

msgid "chap1"
msgstr "הצמדים"

msgid "1"
msgstr ""
"התודעה קודמת לכל התופעות, "
"התודעה היא ראש להן, כולן מעשה תודעה. "
"אם אדם מדבר או פועל "
"עם תודעה לא טהורה, "
"סבל בא בעקבותיו "
"כגלגלי עגלה העוקבים אחר השור."

msgid "2"
msgstr ""
"התודעה קודמת לכל התופעות, "
"התודעה היא ראש להן, כולן מעשה תודעה. "
"אם אדם מדבר או פועל "
"עם תודעה טהורה, "
"אושר בא בעקבותיו "
"כמו צילו העוקב אחריו."

msgid "3"
msgstr ""
"\"הוא פגע בי, הוא הכה אותי, "
"הוא הביס אותי, הוא שדד אותי.\" "
"מי שמטפח מחשבות כאלו, "
"השנאה לא שוקטת בו."

msgid "4"
msgstr ""
"\"הוא פגע בי, הוא הכה אותי, "
"הוא הביס אותי, הוא שדד אותי.\" "
"מי שלא מטפח מחשבות כאלו, "
"השנאה שוקטת בו."

msgid "5"
msgstr ""
"לעולם שנאה אינה שוקטת "
"באמצעות שנאה, "
"רק באמצעות אי-שנאה היא שוקטת— "
"זהו חוק נצחי."

msgid "6"
msgstr ""
"יש אנשים שלא מבינים "
"שכולנו נידונים למות— "
"אך אלו שמבינים זאת "
"מיישבים את מריבותיהם."

msgid "7"
msgstr ""
"מי שמרוכז בתענוגות, "
"חסר שליטה בחושיו, "
"אינו מתון באכילה, "
"עצלן ורופס, "
"אותו מָארַה מכניע, "
"כשם שסופה מפילה עץ חלש."

msgid "8"
msgstr ""
"מי שעוסק בהתבוננות בדוֹחֶה, "
"שולט בחושיו, "
"מתון באכילה, "
"בעל אמון ומאמץ כנה, "
"מָארַה אינו מכניע אותו, "
"כשם שסופה אינה מפילה הר יציב."

msgid "9"
msgstr ""
"מי שלובש את הגלימה הכתומה, "
"אך אינו נקי מזיהומים, "
"חסר שליטה עצמית ואינו ישר— "
"הוא לבטח אינו ראוי לה."

msgid "10"
msgstr ""
"אך מי שנקי מזיהומים, "
"מבוסס במוסר, "
"בעל שליטה עצמית ובעל יושר— "
"הוא אכן ראוי לגלימה הכתומה."

msgid "11"
msgstr ""
"אלו שרואים את המהותי במה שאינו מהותי "
"ורואים את מה שאינו מהותי במהותי, "
"לא מגיעים לעולם אל המהותי "
"ואובדים בכוונות טועות."

msgid "12"
msgstr ""
"אלו שרואים את המהותי כמהותי "
"ואת הלא-מהותי כלא-מהותי, "
"מגיעים אל המהותי "
"וחיים עם כוונות טובות."

msgid "13"
msgstr ""
"כשם שאל בית שאינו מסוכך היטב "
"יחדור גשם, "
"כך לתודעה בלתי מפותחת כראוי "
"תחדור תאווה."

msgid "14"
msgstr ""
"כשם שאל בית מסוכך היטב "
"לא יחדור גשם, "
"כך לתודעה מפותחת כראוי "
"לא תחדור תאווה."

msgid "15"
msgstr ""
"הוא מצטער עכשיו ומצטער אחר כך, "
"העושה רע מצטער בשני העולמות. "
"הוא מצטער ומתייסר "
"בראותו את מעשיו הלא טהורים."

msgid "16"
msgstr ""
"הוא שמח עכשיו ושמח אחר כך, "
"העושה טוב שמח בשני העולמות. "
"הוא שמח ומאושר "
"בראותו את מעשיו הטהורים."

msgid "17"
msgstr ""
"הוא סובל עכשיו וסובל אחר כך, "
"העושה רע סובל בשני העולמות. "
"המחשבה 'עשיתי רע' מענה אותו, "
"והוא סובל עוד יותר כאשר הוא מגיע אל עולם היגון."

msgid "18"
msgstr ""
"הוא שמח כאן ושמח אחר כך, "
"העושה טוב, שמח בשני העולמות. "
"המחשבה 'עשיתי טוב' משמחת אותו, "
"והוא שמח אף יותר כאשר הוא מגיע אל עולם השמחה."

msgid "19"
msgstr ""
"אדם המשנן כתבים רבים, "
"אך ברשלנותו אינו פועל בהתאם, "
"דומה לרועה בקר שסופר רק את הבקר של אחרים— "
"הוא אינו לוקח חלק בברכה של חיי הפרישות."

msgid "20"
msgstr ""
"על אף שאדם משנן מעט כתבים, "
"אם הוא הולך בדרך הדְהַמַּה ופועל על פיה, "
"אם הוא זונח תאווה, שנאה ואשליה, "
"אם הוא בעל חוכמה אמיתית ותודעה משוחררת, "
"ואינו נקשר לדבר בעולם הזה או בעולם הבא— "
"הוא אכן לוקח חלק בברכה של חיי הפרישות."

msgid "chap2"
msgstr "ערנות"

msgid "21"
msgstr ""
"ערנות היא הדרך אל האלמוות, "
"חוסר ערנות היא הדרך אל המוות. "
"הערניים לא מתים, "
"בעוד אלה שאינם ערניים כאילו היו מתים."

msgid "22"
msgstr ""
"בהבנה בהירה זו, "
"החכמים הערניים "
"שמחים בערנות, "
"ונהנים בעולמם של האציליים."

msgid "23"
msgstr ""
"המתרגל בהתמדה, "
"ברציפות ובמאמץ איתן— "
"החכם יגשים נִיבָּאנַה, "
"השחרור הנעלה משעבוד."

msgid "24"
msgstr ""
"האדם הנמרץ והקשוב, "
"שמעשיו טהורים וזהירים, "
"בעל השליטה העצמית והערני, החי על פי הדְהַמַּה— "
"תהילתו מתעצמת."

msgid "25"
msgstr ""
"באמצעות מאמץ וערנות, "
"משמעת ושליטה עצמית, "
"החכם עושה לעצמו אי, "
"אשר שיטפון לא יכול להכניע."

msgid "26"
msgstr ""
"הטיפשים והבורים "
"נכנעים לחוסר ערנות, "
"אך החכם שומר על ערנות "
"כעל העושר הגדול ביותר."

msgid "27"
msgstr ""
"אל תיכנעו לחוסר ערנות "
"אל תקדישו עצמכם להנאות חושים. "
"רק המתרגל הערני "
"משיג אושר גדול."

msgid "28"
msgstr ""
"מסלק חוסר ערנות באמצעות ערנות, "
"כך החכם פועל "
"ומעפיל למגדל החוכמה נטול צער. "
"אז הוא מביט על ההמון מלא הצער, "
"כפי שהעומד על ראש הר "
"מביט על השוטים למטה."

msgid "29"
msgstr ""
"ערני בין חסרי ערנות, "
"ער לגמרי בין ישנים— "
"החכם מתקדם כמו סוס מהיר, "
"המותיר אחריו סוס חלש."

msgid "30"
msgstr ""
"בזכות ערנות, אִינְדְרַה "
"נעשה ראש הישויות השמימיות. "
"ערנות זוכה לשבחים, "
"חוסר ערנות זוכה תמיד לבוז."

msgid "31"
msgstr ""
"הנזיר המקדיש עצמו לערנות "
"ורואה סכנה בחוסר ערנות, "
"מתקדם כמו אש "
"השורפת את כל הזיהומים גדולים כקטנים."

msgid "32"
msgstr ""
"הנזיר המקדיש עצמו לערנות, "
"ורואה סכנה בחוסר ערנות, "
"לא ימעד. "
"הוא קרוב לנִיבָּאנַה."

msgid "chap3"
msgstr "התודעה"

msgid "33"
msgstr ""
"התודעה הפכפכה ובלתי יציבה, "
"קשה לריסון וקשה לשליטה. "
"החכם מיישר אותה "
"כמו שיוצר חיצים מיישר את החץ."

msgid "34"
msgstr ""
"כדג שהוטל מפרפר על קרקע יבשה "
"לאחר שהוצא מבריכת מגוריו— "
"כך גם התודעה הזו מיטלטלת "
"על מנת להימלט מתחומו של מָארַה."

msgid "35"
msgstr ""
"כיבוש התודעה הוא דבר נפלא, "
"כה קשה לאחיזה, תמיד זריזה, "
"ונודדת לכל מקום בו היא חפצה— "
"תודעה מאומנת מביאה שמחה."

msgid "36"
msgstr ""
"איש חכם, הגן על התודעה! "
"כה חמקמקה וקשה להבחנה, "
"נודדת לכל מקום בו היא חפצה— "
"תודעה מאובטחת מביאה שמחה."

msgid "37"
msgstr ""
"התודעה חבויה וחסרת צורה, "
"נודדת למרחקים ובודדה— "
"אלו המכניעים אותה "
"משוחררים מכבליו של מָארַה."

msgid "38"
msgstr ""
"מי שתודעתו אינה יציבה, "
"שאינו יודע את הלימוד הטוב, "
"ושאמונו מעורער— "
"חוכמתו אינה מבשילה."

msgid "39"
msgstr ""
"לערני, שתודעתו אינה ספוגה בתאווה, "
"אינה מיוסרת משנאה, "
"ושהתעלה מעבר לחסד ומגרעת— "
"פחד לא קיים."

msgid "40"
msgstr ""
"משהבנת שהגוף הזה הוא ככלי חרס, "
"ומשביססת את התודעה הזו כעיר מבצר, "
"הכה במָארַה בחרב החוכמה— "
"הגן על מה שכבשת, אך אל תיצמד לדבר."

msgid "41"
msgstr ""
"מה נורא! תוך זמן קצר "
"יהיה הגוף הזה מוטל על האדמה, "
"מושלך ללא רוח חיים, "
"כמו בול עץ חסר תועלת."

msgid "42"
msgstr ""
"תודעה שמכוונת לפגוע "
"תגרום לאדם נזק גדול יותר "
"מאשר כל נזק שאויב יעשה לאויבו, "
"או שונא לשונאו."

msgid "43"
msgstr ""
"לא אם, לא אב, "
"או כל קרוב אחר, "
"יכולים להועיל לאדם יותר מתודעתו שלו, "
"כאשר היא מכוונת לטוב."

msgid "chap4"
msgstr "פרחים"

msgid "44"
msgstr ""
"מי ידע את זו האדמה, "
"את עולמו של יָאמַה והישויות שבו? "
"מי יבין את דברי החוכמה המוצגים כהלכה, "
"כאדם מיומן המלקט פרחים?"

msgid "45"
msgstr ""
"החניך יבין את זו האדמה, את עולמו של יָאמַה "
"ואת העולם הזה עם הישויות שבו. "
"החניך יבין את דברי החוכמה המוצגים כהלכה "
"כאדם מיומן המלקט פרחים."

msgid "46"
msgstr ""
"משהבנת שהגוף הזה הוא כמו קצף, "
"משחדרת לטבעו האשלייתי, "
"משעקרת את חיצי הפרח של מָארַה, "
"תוכל לצאת מטווח ראייתו של מלך המוות."

msgid "47"
msgstr ""
"אדם המלקט רק את הפרחים, "
"שדעתו נצמדת בתאווה— "
"המוות סוחף אותו, "
"כשיטפון אדיר הסוחף כפר רדום."

msgid "48"
msgstr ""
"אדם המלקט רק את הפרחים, "
"שדעתו נצמדת בתאווה, "
"ושחושיו אינם מסופקים— "
"נמצא תחת שליטתו של המוות."

msgid "49"
msgstr ""
"כדבורה שאוספת את הצוף "
"ועוזבת את הפרח "
"מבלי לפגוע בצבעו וריחו, "
"כך החכם מתהלך בכפר."

msgid "50"
msgstr ""
"אל לו לאדם למצוא דופי באחר, "
"במה שעשה או לא עשה. "
"על אדם לבחון רק את עצמו, "
"את מה שעשה או לא עשה."

msgid "51"
msgstr ""
"כפרח יפה השופע בצבע אך חסר ניחוח, "
"כך מילותיו היפות "
"של מי שאינו נוהג על פיהן "
"אינן נושאות פרי."

msgid "52"
msgstr ""
"כפרח יפה השופע בצבע ובעל ניחוח, "
"כך מילותיו היפות "
"של האדם הנוהג על פיהן "
"נושאות פרי."

msgid "53"
msgstr ""
"כשם שניתן לשזור זרים רבים "
"מערימת פרחים גדולה, "
"כך גם על בן התמותה "
"לעשות מעשים טובים רבים."

msgid "54"
msgstr ""
"ניחוחם המתוק של פרחים אינו נישא נגד הרוח, "
"אף לא ניחוחם של עץ הסנדל, הבירנית והיסמין. "
"אך ניחוחו של הטוב נישא נגד הרוח. "
"אדם טוב קורן וחודר לכל עבר."

msgid "55"
msgstr ""
"מכל הניחוחות— "
"עץ הסנדל, הבירנית, "
"לוטוס ויסמין— "
"ניחוח הטוהר המוסרי הוא הטוב ביותר."

msgid "56"
msgstr ""
"עמום הוא ניחוחם "
"של הטַגַרַה ועץ הסנדל, "
"לעומת ניחוח הטוהר המוסרי הנעלה, "
"אשר נישא אף בין הישויות השמימיות."

msgid "57"
msgstr ""
"מָארַה לא מוצא לעולם "
"את דרכם של המוסריים, "
"החיים בערנות ומשוחררים "
"באמצעות ידיעה מושלמת."

msgid "58"
msgstr ""
"כשם שעל ערימת אשפה "
"המושלכת לצד הדרך, "
"יכול ללבלב לוטוס ריחני "
"ונעים למראה,"

msgid "59"
msgstr ""
"כך בין אנשים "
"בורים ועיוורים, "
"תלמידו של המואר בשלמות "
"זוהר מלא חוכמה."

msgid "chap5"
msgstr "הטיפש"

msgid "60"
msgstr ""
"ארוך הוא הלילה למי שאינו ישן, "
"ארוכה היא הדרך ליגע, "
"ארוכה היא הסַמְסָארַה לטיפשים "
"שלא יודעים את האמת הנעלה."

msgid "61"
msgstr ""
"אם לא תמצא אדם "
"טוב ממך או שווה לך, "
"עשה את דרכך לבד. "
"אין טעם ברעות עם טיפשים."

msgid "62"
msgstr ""
"\"יש לי בנים, יש לי רכוש\", "
"כך הטיפש חושב ודואג. "
"אך אין לו אפילו את עצמו, "
"לכן, אילו בנים? איזה רכוש?"

msgid "63"
msgstr ""
"טיפש היודע את טיפשותו "
"הוא נבון לפחות במידה זו, "
"אך טיפש החושב עצמו חכם "
"הוא בהחלט נקרא 'טיפש'."

msgid "64"
msgstr ""
"אדם טיפש, "
"אפילו נמצא במחיצת אדם חכם כל חייו, "
"אינו מבין את הדהמה "
"יותר משכפית מבינה את טעם המרק."

msgid "65"
msgstr ""
"אדם נבון, "
"אפילו נמצא במחיצת אדם חכם לרגע אחד, "
"מבין במהירות את הדהמה, "
"כפי שלשון מבינה את טעם המרק."

msgid "66"
msgstr ""
"טיפשים דלי בינה "
"מתנהגים כאילו היו אויבים של עצמם, "
"הם עושים מעשים רעים "
"המניבים פירות מרים."

msgid "67"
msgstr ""
"מעשה לא טוב "
"הוא זה שעשייתו גוררת חרטה, "
"ושאת פירותיו "
"חווים בדמעות ובפנים בוכיות."

msgid "68"
msgstr ""
"מעשה טוב "
"הוא זה שעשייתו אינה גוררת חרטה, "
"ושאת פירותיו "
"חווים בשמחה ואושר."

msgid "69"
msgstr ""
"כל עוד המעשה הרע לא מבשיל, "
"מדמה אותו הטיפש לדבש, "
"אך כאשר מבשיל המעשה הרע, "
"אז הטיפש מצטער."

msgid "70"
msgstr ""
"חודש אחר חודש הסגפן הטיפש יכול לאכול "
"בעזרת קצה גבעול עשב, "
"אך עדיין הוא אינו שווה לקמצוץ "
"של אדם שבחן היטב את הדהמה."

msgid "71"
msgstr ""
"כמו חלב טרי, "
"מעשה רע אינו מחמיץ מהר, "
"הוא עוקב אחר הטיפש, "
"כמו אש הבוערת תחת אפר."

msgid "72"
msgstr ""
"הטיפש משיג ידע שמוביל לאבדון, "
"זה הורס לטיפש "
"כל חלקה טובה "
"ומפצח את ראשו."

msgid "73"
msgstr ""
"הטיפש מחפש כבוד שלא מגיע לו, "
"זכות קדימה בין נזירים, "
"סמכות במנזרים, "
"והערצה מאנשים אחרים."

msgid "74"
msgstr ""
"\"הלוואי שבעלי בית ופרושים יחשבו "
"שהדבר נעשה על ידי. הלוואי שיהיו "
"תחת שליטתי בנוגע לכל חובה שהיא\"— "
"זוהי שאיפתו של הטיפש, "
"כך, תשוקתו וגאוותו מתעצמים."
msgid "75"
msgstr ""
"אחד הוא החיפוש אחר הישגים ארציים, "
"ואחרת היא הדרך לניבאנה. "
"כאשר הוא מבין זאת כך, "
"הנזיר, תלמידו של הבודהה, "
"לא ייסחף אחר תהילה, "
"אלא ייפתח הינתקות."  

msgid "chap6"
msgstr "החכם"

msgid "76"
msgstr ""
"כאדם המְכַוֵן אל אוצר "
"הוא החכם "
"המצביע על טעויותיך. "
"התרועע עם חכם מעין זה, "
"התחבר עם אדם כזה— "
"רעות כזו הינה לטובה, לא לרעה."

msgid "77"
msgstr ""
"תן לו להתריע, להדריך "
"ולשמור אותך מהתנהגות לא נאותה. "
"אדם כזה הינו יקר לאנשים טובים, "
"ומתועב על ידי הרעים."

msgid "78"
msgstr ""
"אל תתחבר עם ידידים רעים, "
"אל תתחבר עם שפלים. "
"התחבר עם ידידים טובים, "
"התחבר עם אנשים נעלים."

msgid "79"
msgstr ""
"אדם ששמח בדְהַמַּה, "
"ישן באושר עם תודעה בהירה. "
"החכם נהנה תמיד מהדְהַמַּה "
"שהוצגה על ידי הנעלה."

msgid "80"
msgstr ""
"חופרי תעלות מובילים מים, "
"עושי חיצים מיישרים חיצים, "
"נגרים מעצבים עץ, "
"החכמים שולטים בעצמם."

msgid "81"
msgstr ""
"כשם שסלע מוצק "
"אינו נע ברוח, "
"כך החכמים לא מושפעים "
"משבחים והאשמות."

msgid "82"
msgstr ""
"כפי שאגם עמוק "
"צלול ושליו, "
"כך החכם הופך צלול "
"כאשר הוא שומע את הדְהַמַּה."

msgid "83"
msgstr ""
"אכן, הטובים מוותרים על הכל, "
"הם לא משוחחים על תשוקות להנאות החושים. "
"החכמים אינם חשים התעלות או דיכאון, "
"כאשר נוגעים בהם אושר או כאב."

msgid "84"
msgstr ""
"הוא לא ישתוקק להצלחה באמצעים לא כשרים, "
"לא למען עצמו ולא למען אחר. "
"הוא לא ישתוקק לבנים, עושר או שלטון— "
"כך הוא יהיה מוסרי, חכם והגון."

msgid "85"
msgstr ""
"מעטים האנשים "
"שחוצים אל הגדה שמעבר. "
"רובם רק רצים "
"מעלה ומטה בגדה הקרובה."

msgid "86"
msgstr ""
"אלו הפועלים בהתאם "
"לדְהַמַּה המוצגת בשלמות "
"יחצו אל מעבר לממלכת המוות "
"הקשה כל כך לצליחה."

msgid "87"
msgstr ""
"משעזב את התורות האפלות, החכם מפתח בהירות. "
"משעזב את הבית לטובת חיי חסר-בית, הוא חי הרחק בבדידות."

msgid "88"
msgstr ""
"משזנח את התאווה, בלי דבר— שם עליו לבקש הנאה. "
"החכם ינקה עצמו מזיהומי התודעה."

msgid "89"
msgstr ""
"אלו שתודעתם פותחה היטב "
"לכדי שלמות בגורמי ההתעוררות, "
"אשר לא נאחזים "
"ובשמחה מוותרים על ההיקשרות, "
"הזוהרים, החופשיים מהתחלואים— "
"הם הגשימו נִיבָּאנַה בעולם הזה."  

msgid "chap7"
msgstr "הארהנט"

msgid "90"
msgstr ""
"במי שסיים את המסע, חסר הצער, "
"אשר השתחרר מהכל לחלוטין, "
"והכחיד את כל הקשרים, "
"קדחת התשוקות אינה קיימת עוד."

msgid "91"
msgstr ""
"המודעים מאמצים את עצמם, "
"הם אינם קשורים לאף בית— "
"כמו ברבורים שנטשו את האגם, "
"הם מותירים מאחור בית אחר בית."

msgid "92"
msgstr ""
"אלו שאינם צוברים "
"ונבונים ביחס למזון, "
"שמושאם הוא הרִיק, "
"החופש חסר ההתניות— "
"דרכם היא כזו של הציפורים באוויר, "
"בלתי ניתנת לעקיבה."

msgid "93"
msgstr ""
"האדם שתחלואיו הושמדו, "
"ואינו קשור למזון, "
"שמושאו הוא הריק, "
"החופש חסר ההתניות— "
"דרכו היא כזו של הציפורים באוויר, "
"בלתי ניתנת לעקיבה."

msgid "94"
msgstr ""
"מי שחושיו שלווים "
"כסוסים מאולפים היטב על ידי רוכב, "
"שנטש את היהירות והוא חופשי מהתחלואים— "
"אדם כמותו גם הישויות השמימיות מוקירות."

msgid "95"
msgstr ""
"כמו האדמה שאינה דוחה דבר, "
"אדם חסר דאגות, מאומן כראוי, "
"כעמוד איתן או כאגם צלול נטול בוץ— "
"אין לו קיום נוסף."

msgid "96"
msgstr ""
"מחשבתו רגועה, "
"דיבורו רגוע, ומעשיו רגועים, "
"המשוחרר לגמרי דרך הבנה נכונה, "
"שליו לחלוטין ויציב."

msgid "97"
msgstr ""
"האדם שמעבר לאמונה, היודע את הבלתי-נוצר, "
"אשר חתך את כל הקשרים, "
"אשר השמיד את הגורמים ללידה והפסיק להיאחז— "
"הוא אכן הטוב מבני האדם."

msgid "98"
msgstr ""
"בין אם זה כפר, יער, "
"עמק או גבעה— "
"המקומות בהם אַרַהַנְטִים נמצאים "
"הם אכן מעוררי השראה."

msgid "99"
msgstr ""
"מעוררי השראה הם היערות, "
"היכן שאנשים ארציים אינם מוצאים הנאה. "
"שם חסרי התשוקה שמחים, "
"כי אין הם מחפשים אחר הנאות חושים."

msgid "chap8"
msgstr "האלפים"

msgid "100"
msgstr ""
"טובה יותר מאלף "
"מילים נטולות משמעות, "
"היא מילה אחת בעלת משמעות, "
"שהשומע אותה משיג שלווה."

msgid "101"
msgstr ""
"טובה יותר מאלף "
"פסקאות נטולות משמעות, "
"היא פסקה אחת בעלת משמעות, "
"שהשומע אותה משיג שלווה."

msgid "102"
msgstr ""
"טוב יותר מלומר אלף "
"פסקאות נטולות משמעות "
"הוא לומר פסקה אחת של דְהַמַּה, "
"שהשומע אותה משיג שלווה."

msgid "103"
msgstr ""
"אף אם אדם יביס בקרב "
"אלף אנשים אלף פעמים, "
"עדיין, המנצח הגדול מכולם "
"הוא מי שמנצח את עצמו."

msgid "104"
msgstr ""
"ניצחון-עצמי הוא טוב יותר "
"מניצחון על אחרים "
"לאדם בעל שליטה עצמית "
"וריסון מוסרי מתמיד."

msgid "105"
msgstr ""
"אפילו ישות שמיימית, גַנְדְהַבַּה, "
"מָארַה או בְּרַהַמַה "
"לא יכולים להפוך את ניצחונו "
"של האדם הזה לתבוסה."

msgid "106"
msgstr ""
"טוב יותר מהקרבת קורבנות באלפים "
"חודש אחר חודש "
"במשך מאה שנים, "
"הוא רגע אחד "
"בו אדם מעניק כבוד "
"לבעלי תודעה מפותחת."

msgid "107"
msgstr ""
"טוב יותר מביצוע פולחן "
"אש קורבן ביער "
"במשך מאה שנים, "
"הוא רגע אחד "
"בו אדם מעניק כבוד "
"לבעלי תודעה מפותחת."

msgid "108"
msgstr ""
"אי אילו מתנות ומנחות שאדם המחפש ברכה "
"יציע בעולם הזה במשך שנה שלמה, "
"כל אלה לא שווים אף רבע מהחסד המושג "
"בכיבוד האנשים ההגונים, המצוינים באמת."

msgid "109"
msgstr ""
"לזה אשר תמיד נלהב "
"לכבד ולשרת את המבוגרים, "
"ארבע הברכות האלו מתגשמות: "
"חיים ארוכים, יופי, אושר וכוח."

msgid "110"
msgstr ""
"אף שניתן לחיות מאה שנים "
"ללא מוסר וללא שליטה עצמית, "
"עדיפים חיים של יום אחד "
"עם מוסר ומודעות."

msgid "111"
msgstr ""
"אף שניתן לחיות מאה שנים "
"בטיפשות ובחוסר שליטה עצמית, "
"עדיפים חיים של יום אחד "
"עם חוכמה ומודעות."

msgid "112"
msgstr ""
"אף שניתן לחיות מאה שנים "
"בעצלות ובהתהוללות, "
"עדיפים חיים של יום אחד "
"מלאי מאמץ ונחישות."

msgid "113"
msgstr ""
"אף שניתן לחיות מאה שנים "
"מבלי להבין את ההופעה וההעלמות של הדברים, "
"עדיפים חיים של יום אחד "
"בהתבוננות בהופעה וההעלמות של הדברים."

msgid "114"
msgstr ""
"אף שניתן לחיות מאה שנים "
"מבלי לראות אף פעם את האלמוות, "
"עדיפים חיים של יום אחד "
"ולראות את האלמוות."

msgid "115"
msgstr ""
"אף שניתן לחיות מאה שנים "
"מבלי לראות אף פעם את האמת הנעלה, "
"עדיפים חיים של יום אחד "
"ולראות את האמת הנעלה."  

msgid "chap9"
msgstr "רוע"

msgid "116"
msgstr ""
"מהר לעשות טוב "
"ורסן את עצמך מלעשות רע. "
"כשאדם איטי בעשיית טוב, "
"תודעתו נוטה לרוע."

msgid "117"
msgstr ""
"אם עשית רע— "
"אל תחזור על זה, "
"אל תייחל לזה, "
"כי הצבירה של רוע מולידה סבל."

msgid "118"
msgstr ""
"אם עשית טוב— "
"חזור על זה, "
"ייחל לזה, "
"כי מבורכת היא הצבירה של טוב."

msgid "119"
msgstr ""
"ייתכן שאדם העושה הרע יפגוש גורל טוב "
"כל עוד הרוע עדיין לא הבשיל, "
"אך כאשר הוא מבשיל, "
"אז עושה הרע רואה את תוצאות מעשיו הרעים."

msgid "120"
msgstr ""
"ייתכן שאדם העושה טוב יפגוש גורל אכזר "
"כל עוד הטוב עדיין לא הבשיל, "
"אך כאשר הוא מבשיל, אז עושה-הטוב רואה "
"את תוצאות מעשיו הטובים."

msgid "121"
msgstr ""
"אל תתייחס בקלות דעת לרוע "
"במחשבה \"זה לא יחזור אלי\", "
"טיפה אחר טיפה גם קערה מתמלאת במים— "
"כך גם הטיפש, "
"האוסף מעט למעט, "
"ממלא עצמו ברוע."

msgid "122"
msgstr ""
"אל תתייחס בקלות דעת לטוב, "
"במחשבה \"זה לא יחזור אלי\", "
"טיפה אחר טיפה גם קערה מתמלאת במים— "
"כך גם החכם, "
"האוסף מעט למעט, "
"ממלא עצמו בטוב."

msgid "123"
msgstr ""
"כפי שסוחר הנוסע עם ליווי מצומצם "
"וסחורות רבות ירחק מדרכים לא בטוחות, "
"או אדם הרוצה לחיות ירחק מרעל— "
"כך גם עליך להתרחק ממעשים רעים."

msgid "124"
msgstr ""
"כף יד נטולת פצעים "
"יכולה לשאת אפילו רעל. "
"רעל לא משפיע על מי שאין לו פצעים— "
"אין שום חולי לאדם שלא עושה כל רע."

msgid "125"
msgstr ""
"מי שפוגע באדם תמים, "
"טהור וחסר אשמה— "
"הרוע חוזר אל הטיפש הזה, "
"כמו אבק המושלך נגד הרוח."

msgid "126"
msgstr ""
"יש שנולדים ברחם, "
"הרשעים נולדים בעולמות היגון, "
"המסורים הולכים לעולמות הברכה, "
"חסרי התחלואים מגשימים נִיבָּאנַה."

msgid "127"
msgstr ""
"לא בשמים, לא באמצע האוקיאנוס, "
"ולא בנקיקי הרים— "
"אין מקום בעולם בו אדם יוכל לברוח "
"מהתוצאות של מעשיו הרעים."

msgid "128"
msgstr ""
"לא בשמים, לא באמצע האוקיאנוס "
"ולא בנקיקי הרים— "
"אין מקום בעולם בו אדם יוכל "
"להתגבר על המוות."  

msgid "chap10"
msgstr "אלימות"

msgid "129"
msgstr ""
"כולם יראים מפני אלימות, "
"כולם פוחדים מהמוות. "
"בראותך שאחרים כמותך, "
"אל תהרוג ואל תגרום לאחר להרוג."

msgid "130"
msgstr ""
"כולם יראים מפני אלימות, "
"החיים יקרים לכולם. "
"בראותך שאחרים כמותך, "
"אל תהרוג ואל תגרום לאחר להרוג."

msgid "131"
msgstr ""
"אם בעודך רוצה להיות מאושר "
"אתה משתמש באלימות נגד יצורים חיים "
"אשר גם רוצים להיות מאושרים— "
"לא תמצא אושר בעתיד."

msgid "132"
msgstr ""
"אם בעודך רוצה להיות מאושר "
"אינך משתמש באלימות נגד יצורים חיים "
"אשר גם רוצים להיות מאושרים— "
"תמצא אושר בעתיד."

msgid "133"
msgstr ""
"אל תדבר אל אף אחד בגסות, "
"דבריך ישיבו יחס דומה. "
"אכן, דיבור מעליב פוגע, "
"וייתכן שנקמה תשיג אותך."

msgid "134"
msgstr ""
"אם כמו פעמון שבור "
"אינך מהדהד, "
"אתה קרוב לנִיבָּאנַה, "
"כי אין בך עוד עוינות."

msgid "135"
msgstr ""
"כמו רועה המוביל את העדר "
"למרעה עם מקל, "
"כך גם הזדקנות ומוות מוליכים "
"את כוח החיים של בני התמותה."

msgid "136"
msgstr ""
"אף כאשר הוא עושה רע, "
"הטיפש אינו מבין זאת. "
"השוטה מתענה כתוצאה ממעשיו, "
"כמו אדם הנשרף באש."

msgid "137"
msgstr ""
"מי שמשתמש באלימות כנגד אדם לא אלים, "
"ופוגע במי שלא מזיק, תוך זמן קצר "
"יהיה באחד מעשרת המצבים:"

msgid "138"
msgstr ""
"הוא יחווה כאב חד, אסון, פגיעה בגוף, "
"מחלה אנושה, מחלת נפש,"

msgid "139"
msgstr ""
"הוא יסתבך בצרות עם השלטונות, "
"יואשם באשמות חמורות, יאבד קרובים, יאבד רכוש,"

msgid "140"
msgstr ""
"ביתו יחרב בלהבות, ולאחר מותו "
"השוטה הזה יוולד בגיהינום."

msgid "141"
msgstr ""
"לא הליכה בעירום, ולא רַסְטוֹת, ולא לכלוך, "
"ולא צום, ולא שינה על פני האדמה, "
"ולא התמרחות בעפר ואפר, ולא הסתגפות בהרים "
"יכולים לטהר אדם אשר לא התעלה מעבר לספק."

msgid "142"
msgstr ""
"גם אם יהיה מקושט היטב, עדיין, אם הוא יציב, "
"רגוע, בעל שליטה, ומבוסס בתרגול הרוחני, "
"לאחר שזנח אלימות כלפי כל היצורים החיים— "
"הוא ברהמין, הוא פרוש, הוא נזיר."

msgid "143"
msgstr ""
"היכן ניתן למצוא אדם "
"בעולם הזה המרוסן בענווה, "
"היודע מעט האשמות, "
"כפי שסוס טוב יודע מעט מהשוט?"

msgid "144"
msgstr ""
"כמו סוס טוב הנמנע מהשוט, "
"היה ערני ודרוך, התמלא בכמיהה רוחנית. "
"עם אמונה ומוסר טהור, מאמץ וריכוז, בחקירה של האמת, "
"בהשלמת הידע, בהתנהגות נאותה ומודעות, "
"שים קץ לסבל העצום הזה."

msgid "145"
msgstr ""
"חופרי תעלות מובילים מים, "
"יוצרי חיצים מיישרים חיצים, "
"נגרים מעצבים עץ, "
"והמאומנים היטב שולטים בעצמם."

msgid "chap11"
msgstr "הזדקנות"

msgid "146"
msgstr ""
"בעוד העולם עולה כל הזמן בלהבות, "
"מה לך הצחוק הזה, מה העליצות? "
"עטוי אפלה, "
"מדוע אינך מחפש את האור?"

msgid "147"
msgstr ""
"הבט בדמות הגוף היפה הזה— "
"ערימת כאב ומחלות, "
"נגוע במלא מחשבות, "
"בלי דבר מתמשך או יציב."

msgid "148"
msgstr ""
"הגוף הזה בלוי לגמרי, "
"קן מחלות שברירי, "
"גופה מצחינה מתפרקת— "
"אכן, החיים נגמרים במוות."

msgid "149"
msgstr ""
"העצמות האלה "
"שצבען כשל יונים, "
"כדלעות הן הפזורות בסתיו— "
"איזו הנאה יש במראה שכזה?"

msgid "150"
msgstr ""
"העיר הזו בנויה מעצמות "
"המודבקות בבשר ודם, "
"מכילה הזדקנות ומוות, "
"יוהרה, זלזול, וצביעות."

msgid "151"
msgstr ""
"אפילו מרכבות מלכותיות מפוארות מתבלות, "
"וכך גם הגוף הזה מזדקן. "
"אך הדְהַמַּה של הישרים אינה דועכת "
"כאשר מלמדים אותה לאנשים טובים."

msgid "152"
msgstr ""
"מי שלומד מעט "
"מזדקן כמו פר— "
"הוא גדל בנפח "
"אך חוכמתו אינה גדלה."

msgid "153"
msgstr ""
"דרך לידות רבות בסַנְֹסָארַה נדדתי לריק, "
"בחיפוש אחר בונה הבית— לידות חוזרות ונשנות גורמות סבל."

msgid "154"
msgstr ""
"בונה הבית, התגליתַ! לא תבנה שוב בית זה, "
"כי כל קורות הגג שלך שבורות ועמוד היסוד שלך מנופץ. "
"תודעתי השיגה את הבלתי-מותנה, הגשמתי את הכחדת ההשתוקקות."
msgid "155"
msgstr ""
"מי שלא הלך בדרך של חיים רוחניים, "
"או שנכשל להשיג עושר בצעירותו, "
"דועך כמו עגור זקן "
"באגם בלי דגים."

msgid "156"
msgstr ""
"מי שלא הלך בדרך של חיים רוחניים, "
"או שנכשל להשיג עושר בצעירותו, "
"שוכב כמו חץ משומש שנורה, "
"מתאבל על העבר."

msgid "chap12"
msgstr "עצמי"

msgid "157"
msgstr ""
"אם אדם יקר לעצמו, "
"עליו לשמור על עצמו היטב. "
"החכם שומר על ערנות "
"במשך שלוש אשמורות הלילה."

msgid "158"
msgstr ""
"ראשית על אדם לבסס "
"את עצמו במה שראוי, "
"ורק לאחר מכן להדריך אחרים— "
"כך החכם לא יואשם."

msgid "159"
msgstr ""
"כפי שאדם מלמד אחרים, כך עליו לפעול. "
"כדי שאדם יאמן אחרים, "
"ראשית עליו להיות מרוסן בעצמו— "
"אכן, קשה היא שליטה עצמית."

msgid "160"
msgstr ""
"אדם הוא המגן של עצמו, "
"מי עוד יוכל להיות המגן? "
"כאשר אדם בשליטה מלאה, "
"הוא משיג מגן הקשה להשגה."

msgid "161"
msgstr ""
"הרע נעשה על ידי אדם בעצמו, "
"נולד מתוך עצמו, נוצר בעצמו— "
"הוא שוחק את הטיפש "
"כמו יהלום השוחק אבן חן קשה."

msgid "162"
msgstr ""
"כמו הצמח המטפס מָאלוּבָא "
"החונק את עץ הסָאל עליו הוא גדל, "
"כך גם אדם מושחת פוגע בעצמו, "
"בהתאם לאיחוליו של אויב."

msgid "163"
msgstr ""
"קל לאדם לעשות רע "
"ונזק לעצמו, "
"אך להועיל ולעשות טוב, "
"קשה לו עד מאוד."

msgid "164"
msgstr ""
"הטיפש אשר בשל השקפה "
"מרושעת משמיץ את לימוד האַרַהַנְטִים, "
"האציליים החיים חיי דְהַמַּה, "
"מצמיח רק פירות של הרס עצמי— "
"כמו במבוק הקַטְהַקַה המת עם הנבת פירותיו."

msgid "165"
msgstr ""
"אדם עושה רע בעצמו, "
"אדם מזוהם במו ידיו. "
"אדם נמנע מלעשות רע בעצמו, "
"אדם מטוהר במו ידיו. "
"טוהר וחוסר טוהר של אדם תלויים בו— "
"אף אחד לא יכול לטהר אחר."

msgid "166"
msgstr ""
"אל לך להזניח את רווחתך למען זו של אחרים, "
"עד כמה גדולה שתהיה. "
"דע את רווחתך בבהירות, "
"ופעל להשגת המטרה הנעלה."

msgid "chap13"
msgstr "העולם"

msgid "167"
msgstr ""
"אל תעסוק בדברים נחותים, "
"אל תחיה בפיזור-דעת, "
"אל תאמץ השקפות שגויות, "
"אל תשתהה ארוכות בקיום ארצי."

msgid "168"
msgstr ""
"התעורר! אל תהיה שאנן! "
"הובל חיים של דְהַמַּה ועשייה טובה. "
"ההולכים בדרך הדְהַמַּה חיים באושר "
"גם בעולם הזה וגם בעולם הבא."

msgid "169"
msgstr ""
"הובל חיים של דְהַמַּה ועשייה טובה. "
"אל תוביל חיים בזויים. "
"ההולכים בדרך הדְהַמַּה חיים באושר "
"גם בעולם הזה וגם בעולם הבא."

msgid "170"
msgstr ""
"כפי שאדם מביט בבועה, "
"כפי שאדם מביט בדמיון שווא, "
"אם הוא מביט כך בעולם— "
"מלך המוות לא יכול לראותו."

msgid "171"
msgstr ""
"בוא, הבט בעולם הזה, "
"היפה כמרכבה מלכותית. "
"הטיפשים שקועים בו, "
"אך הנבון חסר הקשרות אליו."

msgid "172"
msgstr ""
"מי שנהג בחוסר תשומת לב "
"ועתה הוא נוהג במודעות, "
"מאיר את העולם הזה "
"כמו ירח ללא ענן."

msgid "173"
msgstr ""
"מי שמשנה את התנהגותו הרעה "
"לעשייה מיטיבה, "
"מאיר את העולם הזה "
"כמו ירח ללא ענן."

msgid "174"
msgstr ""
"העולם הזה עיוור, "
"רק מעטים רואים בו בבהירות. "
"כפי שציפורים מעטות מצליחות לחמוק מרשת, "
"רק מעטים הולכים אל עולמות הברכה."

msgid "175"
msgstr ""
"ברבורים נעים בשמים, "
"בעלי כוחות נעים באוויר, "
"החכם נע מן העולם "
"לאחר שהביס את מָארַה וצבאו."

msgid "176"
msgstr ""
"מי שהפר את הכלל האחד "
"של הימנעות מאמירת שקר, "
"ומזלזל במה שיבוא אחר כך, "
"אין דבר רע שהוא אינו מסוגל לעשות."

msgid "177"
msgstr ""
"קמצנים אינם בדרכם אל עולמות שמימיים, "
"טיפשים אינם משבחים נדיבות, "
"אך החכם נהנה בנתינה, "
"ודי בכך להפוך אותו למאושר אחר כך."

msgid "178"
msgstr ""
"ריבונות על כל העולם, "
"לידה בעולמות שמימיים, "
"שליטה בכל העולמות— "
"טוב מכל אלה הוא פריו של 'הנכנס לזרם'."

msgid "chap14"
msgstr "הבּוּדְּהַה"

msgid "179"
msgstr ""
"ניצחונו של הבּוּדְּהַה הוא בלתי הפיך, "
"אף אחד בעולם לא מסוגל להשתוות לו. "
"באיזה נתיב תוכל להדריך את 'חסר הנתיב', "
"בעל הטווח הבלתי מוגבל?"

msgid "180"
msgstr ""
"לבּוּדְּהַה לא קיימת עוד ההשתוקקות "
"הסבוכה והמסבכת אשר מנציחה את ההתהוות. "
"באיזה נתיב תוכל להדריך את 'חסר הנתיב', "
"בעל הטווח הבלתי מוגבל?"

msgid "181"
msgstr ""
"החכמים אשר מסורים למדיטציה "
"מוצאים הנאה בפרישות שלווה. "
"אפילו הישויות השמימיות מוקירות "
"את אלה המודעים, הבּוּדְּהוֹת הנעלים."

msgid "182"
msgstr ""
"נדיר להיוולד כאדם, "
"נדירים הם חיי התמותה. "
"נדיר לזכות בהזדמנות לשמוע את הדְהַמַּה הטובה, "
"ונדיר באמת להיות עֵד להופעתם של הבּוּדְּהוֹת."

msgid "183"
msgstr ""
"הימנעות מרע, "
"פיתוח טוּב, "
"וטיהור התודעה— "
"זהו לימוד הבּוּדְּהוֹת."

msgid "184"
msgstr ""
"סובלנות מתמדת היא הסגפנות הגבוהה ביותר. "
"הבּוּדְּהוֹת אומרים \"נִיבָּאנַה היא נעלה\". "
"מי שמזיק לאחרים אינו נזיר אמיתי, "
"מי שפוגע באחרים אינו פרוש אמיתי."

msgid "185"
msgstr ""
"לא לגנות, לא לפגוע, "
"להיות מרוסן בהתאם לכללי הנזירות, "
"לאכול במתינות, "
"לשהות בבדידות, "
"להיות מסור לתרגול מדיטציה— "
"זהו לימוד הבּוּדְּהוֹת."

msgid "186"
msgstr ""
"אפילו בגשם של מטבעות זהב "
"אין סיפוק לתשוקות, "
"כי תענוגות החושים מעניקים מעט סיפוק וגורמים כאב רב."

msgid "187"
msgstr ""
"לאחר שהוא מבין זאת, החכם לא מוצא הנאה אפילו בהנאות שמימיות. "
"תלמידו של הער בשלמות מוצא הנאה בקץ ההשתוקקות."

msgid "188"
msgstr ""
"אנשים המאויימים על ידי פחד, מחפשים מקלט במקומות רבים— "
"בגבעות, יערות, חורשות, עצים ומקדשים."

msgid "189"
msgstr ""
"אף אחד מאלה אינו באמת מקום מחסה בטוח, אף אחד מאלה אינו מחסה נעלה. "
"אדם אינו משוחרר מכל הסבל במקומות מחסה כאלו."

msgid "190"
msgstr ""
"אדם שמוצא מחסה בבּוּדְּהַה, בדְהַמַּה, ובסַנְגְהַה, "
"רואה בתבונה נכונה את ארבעת אמיתות האציליים:"

msgid "191"
msgstr ""
"סבל, מקור הסבל, קץ הסבל, "
"ודרך האציליים המתומנת המובילה אל קץ הסבל."
msgid "192"
msgstr ""
"זה אכן מחסה בטוח, זהו המחסה הנעלה. "
"לאחר שהלך אל מחסה זה, "
"אדם משוחרר מכל הסבל."

msgid "193"
msgstr ""
"קשה למצוא אדם בעל חוכמה גדולה— "
"אין הוא נולד בכל מקום. "
"היכן שחכם כזה נולד, "
"משפחתו משגשגת באושר."

msgid "194"
msgstr ""
"מבורכת היא הופעת הבּוּדְּהוֹת, "
"מבורך הוא לימוד הדְהַמַּה הטובה, "
"מבורך הוא האיחוד בסַנְגְהַה, "
"ומבורך הוא התרגול של אלו בהרמוניה."

msgid "195"
msgstr ""
"הוא מכבד את אלו הראויים לכבוד— הבּוּדְּהוֹת ותלמידיהם, "
"אשר התעלו מעבר לכל המכשולים וצלחו מעבר לצער ובכי."

msgid "196"
msgstr ""
"מי שמכבד אותם, השלווים וחסרי הפחד, "
"אין שיעור לחסדיו בכל מדד שהוא."

msgid "chap15"
msgstr "שמחה"

msgid "197"
msgstr ""
"אכן, אנו חיים בשמחה, "
"ידידותיים בין העוינים. "
"בין אנשים עוינים, "
"אנו חיים חסרי שנאה."

msgid "198"
msgstr ""
"אכן, אנו חיים בשמחה, "
"חסרי יסורים בין המתייסרים. "
"בין המתייסרים, "
"אנו חיים חסרי יסורים."

msgid "199"
msgstr ""
"אכן, אנו חיים בשמחה, "
"חסרי חמדנות בין החמדנים. "
"בין החמדנים, "
"אנו חיים חסרי חמדנות."

msgid "200"
msgstr ""
"אכן, אנו חיים בשמחה, "
"חסרי הקשרות לדבר. "
"ניזונים מתחושות התעלות, "
"נחייה כישויות הקורנות."

msgid "201"
msgstr ""
"ניצחון מוליד טינה, "
"המובס חי בכאב. "
"השלווים חיים בשמחה, "
"וזונחים ניצחון ותבוסה."

msgid "202"
msgstr ""
"אין אש כתשוקה, "
"ואין מצוקה כשנאה, "
"אין כאבים כמִצְרַפִים, "
"ואין שמחה הנעלה על השלווה."

msgid "203"
msgstr ""
"רעב הוא המחלה הגרועה מכל, "
"סַנְקְהַרוֹת הן הסבל הנורא מכל. "
"לאדם היודע זאת באמת, "
"נִיבָּאנַה היא האושר הגדול מכל."

msgid "204"
msgstr ""
"בריאות היא הבעלות הטובה ביותר, "
"סיפוק הוא העושר הטוב ביותר, "
"אמון הוא העמית הטוב ביותר, "
"נִיבָּאנַה היא האושר הגדול מכל."

msgid "205"
msgstr ""
"לאחר שטעם את טעם "
"ההתבודדות והשלווה, "
"הוא הופך חופשי מייסורים ועבירות, "
"וגומע את טעם ברכת הדְהַמַּה."

msgid "206"
msgstr ""
"טוב לראות את האציליים, "
"להיות בחברתם תמיד משמח. "
"הרחק ממראה טיפשים, "
"אדם יהיה תמיד מאושר."

msgid "207"
msgstr ""
"המתרועע בחברת טיפשים "
"דרכו מתארכת. "
"מכאיב להיות בחברת טיפשים— "
"כמו לחיות עם אויב, "
"אך משמח להיות בחברת החכם, "
"כמו מפגש עם קרובים."

msgid "208"
msgstr ""
"לכן— "
"לך בעקבות בעל החוכמה, הנבון והמלומד, "
"שומר המוסר, הממלא את חובותיו האציליים, "
"הוא אשר לו תכונות כשל צדיק וחכם, "
"כמו קבוצת כוכבים הסובבים את הירח."

msgid "chap16"
msgstr "חיבה"

msgid "209"
msgstr ""
"הוא המתרגל את שיש להימנע ממנו, "
"ואינו מתרגל את שעליו לעשות, "
"לאחר שוויתר על המטרה ונצמד ליקר לו, "
"מקנא לבסוף באלו שמתרגלים."

msgid "210"
msgstr ""
"אל תחפש קירבה עם האהובים עליך "
"וגם לא עם השנואים עליך. "
"לא לראות את האהובים זה סבל, "
"וכך גם לראות את השנואים."

msgid "211"
msgstr ""
"לכן, אל תוקיר דבר, "
"כי פרידה מהיקר פוגעת. "
"אין כבלים לאלו "
"אשר אין להם דבר אהוב או לא אהוב."

msgid "212"
msgstr ""
"מתוך חיבה צומח צער, "
"מתוך חיבה צומח פחד. "
"במי שהשתחרר לחלוטין מחיבה "
"אין צער, ומהיכן יגיע פחד?"

msgid "213"
msgstr ""
"מתוך אהבה צומח צער, "
"מתוך אהבה צומח פחד. "
"במי שהשתחרר לחלוטין מאהבה "
"אין צער, ומהיכן יגיע פחד?"

msgid "214"
msgstr ""
"מתוך התענגות צומח צער, "
"מתוך התענגות צומח פחד. "
"במי שהשתחרר לחלוטין מהתענגות "
"אין צער, ומהיכן יגיע פחד?"

msgid "215"
msgstr ""
"מתוך תאווה צומח צער, "
"מתוך תאווה צומח פחד. "
"במי שהשתחרר לחלוטין מתאווה "
"אין צער, ומהיכן יגיע פחד?"

msgid "216"
msgstr ""
"מתוך השתוקקות צומח צער, "
"מתוך השתוקקות צומח פחד. "
"במי שהשתחרר לחלוטין מהשתוקקות "
"אין צער, ומהיכן יגיע פחד?"

msgid "217"
msgstr ""
"המוסריים ובעלי התובנה, "
"הצדיקים ויודעי האמת, "
"אשר עושים את שעליהם לעשות— "
"אותם אנשים מוקירים."

msgid "218"
msgstr ""
"המכוון לעבר הבלתי ניתן לתיאור "
"אשר תודעתו בעלת השראה, "
"ושאינה כבולה להנאות החושים— "
"מכונה 'אדם הנע במעלה הזרם'."

msgid "219"
msgstr ""
"כאשר אדם שנעדר מביתו זמן רב שב ממרחקים, "
"קרובים, חברים ועמיתים, על שובו שמחים ומברכים."

msgid "220"
msgstr ""
"כך עם אדם העושה חסדים— כאשר הוא מגיע לעולם הבא, "
"מקבלים אותו מעשיו הטובים כמו קרובים המקבלים את פני יקירם."

msgid "chap17"
msgstr "כעס"

msgid "221"
msgstr ""
"זנח את הכעס, וותר על הגאווה, "
"התגבר על כל הכבלים. "
"מי שאינו נאחז בגוף ובתודעה, "
"חסר דבר, סבל לא פוגע בו."

msgid "222"
msgstr ""
"אדם הבולם כעס שמתעורר בו, "
"כמו רכב שעוצר מרכבה מתדרדרת— "
"אותו אני מכנה 'רכב אמיתי', "
"האחרים רק אוחזים במושכות."

msgid "223"
msgstr ""
"התגבר על הכעס באמצעות אי-כעס, "
"התגבר על הרוע באמצעות טוב-לב, "
"התגבר על הקמצנות באמצעות נדיבות, "
"התגבר על השקר באמצעות אמת."

msgid "224"
msgstr ""
"על אדם לדבר אמת, לא לתת מקום לכעס "
"ולתת למי שמבקש גם כשיש לו מעט. "
"בעזרת שלושה אלו "
"הוא יגיע אל ממלכת הישויות השמימיות."

msgid "225"
msgstr ""
"החכמים שאינם פוגעים "
"ותמיד מרוסנים בגוף, "
"הולכים אל האלמוות, "
"היכן שאין צער."

msgid "226"
msgstr ""
"הערניים בכל עת, "
"המתאמנים יומם וליל, "
"ותמיד מכוונים לנִיבָּאנַה— "
"תחלואיהם מתפוגגים."

msgid "227"
msgstr ""
"אַטוּלַה, זוהי אימרה עתיקה, "
"לא כזו המתאימה רק לימינו: "
"\"הם מאשימים את מי ששותק, "
"הם מאשימים את מי שמדבר הרבה, "
"הם מאשימים את מי שמדבר מעט. "
"אין אדם בעולם הזה שלא מאשימים אותו\"."

msgid "228"
msgstr ""
"מעולם לא היה, לעולם לא יהיה, "
"וגם כעת לא נמצא אדם, "
"אשר זוכה רק להאשמות "
"או זוכה רק לשבחים."

msgid "229"
msgstr ""
"לאחר שהתבונן בו יום אחר יום, "
"החכם משבח את האדם בעל ההתנהגות חסרת הדופי: "
"מרוסן, נבון ומוסרי."

msgid "230"
msgstr ""
"האדם אשר כמו זהב צרוף— "
"מי יוכל להאשים אותו? "
"אפילו הישויות השמימיות משבחות אותו, "
"ואף בְּרַהַמַה משבח אותו."

msgid "231"
msgstr ""
"שמור על עצמך מפני זעם במעשים, "
"היה מרוסן בגופך. "
"לאחר שזנחת התנהגות לא נאותה, "
"תרגל התנהגות נאותה."

msgid "232"
msgstr ""
"שמור על עצמך מפני זעם בדיבור, "
"היה מרוסן בדבריך. "
"לאחר שזנחת דיבור לא נאות, "
"תרגל דיבור נאות."

msgid "233"
msgstr ""
"שמור על עצמך מפני זעם במחשבה, "
"היה מרוסן במחשבותיך. "
"לאחר שזנחת חשיבה לא נאותה, "
"תרגל חשיבה נאותה."

msgid "234"
msgstr ""
"החכמים מרוסנים במעשיהם, "
"מרוסנים בדיבורם, ומרוסנים במחשבתם— "
"הם אכן מרוסנים כראוי."

msgid "chap18"
msgstr "חוסר טוהר"

msgid "235"
msgstr ""
"כעלה נובל אתה כעת, "
"שליחי המוות ממתינים לך. "
"אתה עומד בפתח המוות, "
"בלי כל אספקה למסע."

msgid "236"
msgstr ""
"עשה אי לעצמך, "
"היה חכם והזדרז לעשות מאמץ. "
"חסר-תשוקה, לאחר שתפטר מהזיהומים, "
"תגיע לשטחם השמיימי של האציליים."

msgid "237"
msgstr ""
"חייך הגיעו לקיצם כעת, "
"אתה מתקדם אל עבר מלך המוות. "
"לא יהיה לך מקום מנוחה בדרך, "
"וגם לא כל אספקה למסע."

msgid "238"
msgstr ""
"עשה אי לעצמך, "
"היה חכם והזדרז לעשות מאמץ. "
"חסר-תשוקה, לאחר שתפטר מהזיהומים, "
"לא תחווה שוב לידה והזדקנות."

msgid "239"
msgstr ""
"כמו נפח המסיר שכבות חִמצון מכסף, "
"רגע אחר רגע, מעט למעט— "
"כך בהדרגה החכם "
"מסיר את זיהומיו."

msgid "240"
msgstr ""
"כפי שחלודה מעכלת את המתכת ממנה היא נוצרת— "
"כך גם מעשיהם של עבריינים "
"מובילים אותם אל עולמות היגון."

msgid "241"
msgstr ""
"אי-שינון הוא פגם בלימוד מנטרות, "
"הזנחה היא פגם בבית, "
"רישול הוא פגם במראה, "
"חוסר-ערנות הוא פגם בשומר."

msgid "242"
msgstr ""
"חוסר צניעות הוא פגם באישה, "
"קמצנות היא פגם באדם נדיב— "
"דברים רעים אלה הם אכן פגמים "
"גם בעולם הזה וגם בעולם הבא."

msgid "243"
msgstr ""
"פגם גדול מכל אלו היא בורות, "
"הגרועה מכל הפגמים. "
"נזירים, זִנחו פגם אחד זה "
"והיו חסרי פגמים."

msgid "244"
msgstr ""
"קלים הם החיים לחסר המצפון, "
"החצוף כעורב, "
"הרברבן, הפזיז, "
"החי בשחיתות."

msgid "245"
msgstr ""
"קשים הם החיים לבעל המצפון, "
"התר תמיד אחר טוהר, "
"הנמרץ, העניו, "
"המוביל חיים טהורים."

msgid "246"
msgstr ""
"מי שהורג יצורים חיים, אומר שקרים, "
"לוקח מה שלא ניתן, הולך לאישה של אחר,"

msgid "247"
msgstr ""
"ושותה משקאות משכרים— "
"אדם כזה פועל לעקירת שורשיו כבר בעולם הזה."

msgid "248"
msgstr ""
"אדם יקר, דע לך: לא קל לרסן את הרע. "
"אל תיתן לחמדנות ולהתנהגות רעה "
"לגרור אותך לאומללות ארוכת טווח."

msgid "249"
msgstr ""
"אנשים נותנים על פי אמונם ובהתאם לרצונם. "
"מי שאינו שבע רצון מהאוכל והמשקה שניתן לו לא משיג סַמָאדְהִי ביום או בלילה."

msgid "250"
msgstr ""
"מי שבו חוסר שביעות הרצון הזה נכחד לחלוטין ונעקר מהשורש, "
"משיג סַמָאדְהִי ביום או בלילה."

msgid "251"
msgstr ""
"אין אש כתשוקה, אין אחיזה כשנאה, "
"אין רשת כאשליה, אין נהר כהשתוקקות."

msgid "252"
msgstr ""
"קל לראות טעויות של אחרים, אך קשה לאדם לראות את טעויותיו שלו. "
"את שגיאותיו של אחר מנפה אדם כמו מוץ, אך מסתיר את שלו "
"כרמאי המסתיר זריקה כושלת של קוביות."

msgid "253"
msgstr ""
"אדם המחפש פגמים באחרים ותמיד ביקורתי— "
"תחלואיו גדלים, והוא רחוק מהכחדתם."

msgid "254"
msgstr ""
"אין עקבות בשמים, ואין פרושים מחוץ לדרכו של הבּוּדְּהַה. "
"אנשים מכורים להתרבות-מנטאלית, "
"אך הבּוּדְּהוֹת חופשיים מהתרבות-מנטאלית."

msgid "255"
msgstr ""
"אין עקבות בשמים, ואין פרושים מחוץ לדרכו של הבּוּדְּהַה. "
"אין דברים מותנים נצחיים, "
"ואין חוסר יציבות בבּוּדְּהוֹת."

msgid "chap19"
msgstr "הצדיק"

msgid "256"
msgstr ""
"אדם אינו צודק כאשר הוא שוקל דברים באופן שרירותי. "
"אדם חכם חוקר "
"הן את הנכון והן את השגוי."

msgid "257"
msgstr ""
"מי שמנהיג אחרים ללא שימוש בכוח, בהגינות ובהתאם לדְהַמַּה, "
"הנבון 'שומר הדְהַמַּה'— "
"הוא מכונה 'צדיק'."

msgid "258"
msgstr ""
"אדם אינו חכם רק משום שהוא מדבר הרבה. "
"השליו, חסר הטינה וחסר הפחד— "
"הוא מכונה 'חכם'."

msgid "259"
msgstr ""
"אדם אינו 'תומך הדְהַמַּה' רק משום שהוא מדבר הרבה. "
"אם אדם, על אף שלמד מעט דְהַמַּה, אינו מקל ראש בעניין "
"אלא רואה בעצמו את האמת שבכך— הוא אכן 'תומך הדְהַמַּה'."

msgid "260"
msgstr ""
"הוא אינו בכיר רק בשל שערו האפור. "
"מי שבוגר רק בגילו "
"מכונה 'זקן שוטה'."

msgid "261"
msgstr ""
"מי שמוסרי וישר, נטול אלימות, מרוסן, בעל שליטה עצמית, "
"חכם וללא כל דופי— "
"מכונה בצדק 'בכיר'."

msgid "262"
msgstr ""
"אדם קנאי, אנוכי וערמומי לא הופך לאדם בעל אופי טוב באמצעות יופי חיצוני או דיבור רהוט."

msgid "263"
msgstr ""
"מי שנחתכו בו הזיהומים הללו, נעקרו מהשורש והוכחדו— "
"החכם חסר הפגמים נקרא 'בעל מזג טוב'."

msgid "264"
msgstr ""
"לא באמצעות גילוח ראש אדם חסר יושר וריסון הופך לפרוש. "
"מי שמלא תשוקה וחמדנות, "
"כיצד יהיה פרוש?"

msgid "265"
msgstr ""
"מי שהכניע לחלוטין כל רוע, הן גדול והן קטן— "
"כיוון שהתגבר על כל הרוע, "
"הוא מכונה 'פרוש'."

msgid "266"
msgstr ""
"אדם אינו נזיר רק משום שהוא חי מנדבות אחרים. "
"גם לא באמצעות אימוץ צורת התנהגות "
"הופך אדם לנזיר אמיתי."

msgid "267"
msgstr ""
"מי שמעבר לחסד ופגיעה, שמוביל חיים רוחניים "
"וחי עם הבנה בעולם הזה— "
"נקרא בצדק 'נזיר'."

msgid "268"
msgstr ""
"לא באמצעות שתיקה הופך הטיפש לחכם. "
"מי שכאילו היה אוחז במאזניים— מקבל את הטוב ונמנע מהרע, הוא אכן חכם."

msgid "269"
msgstr ""
"בהמנעו מהרע, הנזיר פיקח. "
"כיוון שהוא יודע את שני העולמות הללו, הוא מכונה 'חכם'."

msgid "270"
msgstr ""
"מי שפוגע ביצורים חיים אינו אצילי. "
"הבלתי מזיק לכל היצורים החיים "
"מכונה 'אצילי'."

msgid "271"
msgstr ""
"לא בשמירה על מסורת וטקסים בלבד, או בלמידה מרובה בלבד, "
"או בהשגת סַמָאדְּהִי בלבד, או בחיי התבודדות בלבד,"

msgid "272"
msgstr ""
"או בהשגת אושר הפרישות אותו אנשים ארציים אינם חווים— "
"אל לכם להיות שבעי רצון, נזירים, עד שתגשימו בעצמכם את חדלון התחלואים."

msgid "chap20"
msgstr "הדרך"

msgid "273"
msgstr ""
"מכל הדרכים, הדרך המתומנת היא הטובה ביותר. "
"מכל האמיתות, ארבע האמיתות הן הטובות ביותר. "
"מכל התופעות, העדר התשוקה היא הטובה ביותר. "
"מכל בני האדם והישויות, 'הרואה' הוא הטוב ביותר."

msgid "274"
msgstr ""
"זו הדרך ואין אחרת "
"הטובה ממנה לטיהור הראייה. "
"לך בה "
"ותעתע במָארַה."

msgid "275"
msgstr ""
"בלכתך בדרך הזו "
"תשים קץ לסבל. "
"זו הדרך אותה הצגתי "
"לאחר שגיליתי כיצד לשלוף את קוץ התשוקה."

msgid "276"
msgstr ""
"עליך לעשות את המאמץ בעצמך, "
"הטַטְהָאגַטוֹת רק מראים את הדרך. "
"אלו המתרגלים, הצועדים בדרך, "
"הם ישתחררו מכבליו של מָארַה."

msgid "277"
msgstr ""
"\"כל הדברים המותנים ארעיים\"— "
"כאשר אדם רואה זאת בחוכמה, "
"הוא מתפכח מהסבל— "
"זו הדרך לטיהור."

msgid "278"
msgstr ""
"\"כל הדברים המותנים כואבים\"— "
"כאשר אדם רואה זאת בחוכמה, "
"הוא מתפכח מהסבל— "
"זו הדרך לטיהור."

msgid "279"
msgstr ""
"\"כל הדברים המותנים חסרי עצמיות\"— "
"כאשר אדם רואה זאת בחוכמה, "
"הוא מתפכח מהסבל— "
"זו הדרך לטיהור."

msgid "280"
msgstr ""
"הרדום בעוד עליו לקום ולפעול, "
"המתבטל בעוד הוא צעיר וחזק, "
"הרפה בעוד עליו להיות נחוש— "
"אדם עצלן כזה לא מוצא את הדרך לחוכמה."

msgid "281"
msgstr ""
"ריסון החשיבה, שמירה על הדיבור, "
"והמנעות מכל רע במעשה— "
"מי שיטהר את שלושת דרכי הפעולה הללו "
"יגשים את הדרך שהוצגה על ידי החכם."

msgid "282"
msgstr ""
"חוכמה צומחת מתוך מאמץ, "
"ללא מאמץ חוכמה דועכת. "
"לאחר שאדם מבין את שתי הדרכים האלו להתפתחות ודעיכה, "
"עליו לפעול כך שחוכמתו תגדל."

msgid "283"
msgstr ""
"עיקרו את יער-התשוקה עד אחרון העצים, "
"מתוך היער צומח פחד. "
"לאחר שעקרתם את היער וסבך השיחים, "
"אז, נזירים, תהיו חסרי תשוקה."

msgid "284"
msgstr ""
"כל עוד לא נעקר סבך השיחים של תשוקת גבר לאישה, "
"כולל הקטנים ביותר, תודעתו כבולה— "
"כמו עגל יונק לאימו."

msgid "285"
msgstr ""
"עקור את החיבה לעצמך "
"כפי שעוקרים לוטוס לבן של סתיו. "
"פַּתֵח את הדרך לשלווה, "
"לנִיבָּאנַה, כפי שהוצגה על ידי הנעלה."

msgid "286"
msgstr ""
"\"כאן אחיה בעונת הגשמים, כאן בחורף וכאן בקיץ\"— "
"כך מהרהר לו הטיפש, "
"ולא מבין את הסכנה."

msgid "287"
msgstr ""
"אדם הקשור לילדיו ומרעו בהתאהבות ממכרת— "
"המוות סוחף אותו, "
"כשיטפון הסוחף כפר בשנתו."

msgid "288"
msgstr ""
"לא קרובים, לא בנים, ואף לא הורים אינם מהווים הגנה המעניקה שלווה אמיתית— "
"מי שנלכד על ידי המוות, אף קרוב לא יכול להציל אותו."

msgid "289"
msgstr ""
"לאחר שהבין זאת— על החכם להיות מרוסן מוסרית "
"ולהזדרז לפנות אל הדרך המובילה לנִיבָּאנַה."

msgid "chap21"
msgstr "שוֹנוֹת"

msgid "290"
msgstr ""
"אם כתוצאה מעזיבת אושר קטן "
"יוכל אדם להשיג אושר גדול יותר, "
"על החכם לעזוב את האושר הקטן "
"בחפשו אחר אושר גדול יותר."

msgid "291"
msgstr ""
"מי שמחפש את אושרו "
"בגרימת כאב לאחרים, "
"הינו כבול בכבלי האיבה, "
"ולא ישתחרר ממנה."

msgid "292"
msgstr ""
"אלה שדוחים את שעליהם לעשות "
"ועושים את שאין לעשות, "
"היהירים והרשלנים— "
"תחלואיהם רק גדלים."

msgid "293"
msgstr ""
"מי שלקחו על עצמם להתמיד בפיתוח קשב לגוף, "
"ולא מחפשים לעשות את שאין לעשות, "
"בעלי הקשב והבנה מלאה— "
"תחלואיהם מגיעים לקיצם."

msgid "294"
msgstr ""
"לאחר שהרג אם (השתוקקות), אב (תפישת עצמיות), "
"שני מלכים לוחמים (ההשקפות הקיצוניות), "
"והשמיד ארץ (חושים) על יושביה (הקשרות ותשוקה)— "
"הוא ברהמין חסר טרדות."

msgid "295"
msgstr ""
"לאחר שהרג אם, אב, שני מלכים מלומדים, "
"והשמיד את דרך הנמר כחמישי (חמשת המכשולים), "
"הוא ברהמין חסר טרדות."

msgid "296"
msgstr ""
"תלמידיו של גוֹטַמַה ערים תמיד, "
"ביום ובלילה "
"מתרגלים קשב לסגולות הבּוּדְּהַה."

msgid "297"
msgstr ""
"תלמידיו של גוֹטַמַה ערים תמיד, "
"ביום ובלילה "
"מתרגלים קשב לסגולות הדְהַמַּה."

msgid "298"
msgstr ""
"תלמידיו של גוֹטַמַה ערים תמיד, "
"ביום ובלילה "
"מתרגלים קשב לסגולות הסַנְגְהַה."

msgid "299"
msgstr ""
"תלמידיו של גוֹטַמַה ערים תמיד, "
"ביום ובלילה "
"מתרגלים קשב לגוף."

msgid "300"
msgstr ""
"תלמידיו של גוֹטַמַה ערים תמיד, "
"ביום ובלילה "
"תודעתם מוצאת הנאה באי-פגיעה."

msgid "301"
msgstr ""
"תלמידיו של גוֹטַמַה תמיד ערים, "
"ביום ובלילה "
"תודעתם מוצאת הנאה בתרגול מדיטציה."

msgid "302"
msgstr ""
"לא קל לצאת לפרישות, לא קל להנות מכך, "
"גם חיים ארציים הם קשים ומלאי צער. "
"לחיות בחברת אנשים לא ראויים זה סבל, "
"הנודד ללא מטרה נתון לסבל— "
"לכן אל תהיה נודד ללא מטרה, ואל תהיה נתון לסבל."

msgid "303"
msgstr ""
"אדם בעל מוסר ואמון, שם טוב ועושר, "
"מכובד בכל מקום "
"ובכל ארץ אליה הוא מגיע."

msgid "304"
msgstr ""
"הטובים נראים ממרחק, כמו הרי ההימאליה, "
"אך הרשעים אינם נראים אף מקרוב, "
"כמו חיצים הנורים בלילה."

msgid "305"
msgstr ""
"הוא אשר יושב לבדו, ישן לבדו והולך לבדו, "
"החרוץ החי בבדידות אשר אימן את עצמו— "
"הוא ימצא הנאה ביער."

msgid "chap22"
msgstr "גיהנום"

msgid "306"
msgstr ""
"השקרן הולך לגיהינום, "
"וכך גם מי שטוען \"לא עשיתי זאת\". "
"שני האנשים השפלים הללו "
"חולקים בעזיבתם יעד זהה בחיים הבאים."

msgid "307"
msgstr ""
"רבים מהלובשים את הגלימה הכתומה "
"הם חסרי שליטה עצמית ובעלי מזג רע. "
"כתוצאה ממעשיהם הרעים "
"המושחתים הללו יוולדו בגיהינום."

msgid "308"
msgstr ""
"טוב יותר לבלוע כדור ברזל הבוער מחום כמו להבות אש, "
"מלהיות אדם חסר מוסר "
"החי על נדבות מזון."

msgid "309"
msgstr ""
"ארבעה אסונות יפקדו אדם פזיז הנואף עם אשת אחר: "
"צבירת מגרעות, שינה טרודה, "
"מוניטין רע, ולידה בגיהינום."

msgid "310"
msgstr ""
"קצרה הנאתם של האיש והאישה המפוחדים. "
"אז נצברות מגרעות, לידה לא טובה בעתיד, "
"והמלך מטיל עונש כבד— לכן אל לאדם לנאוף עם אשת אחר."

msgid "311"
msgstr ""
"כפי שעשב קוּסַה הנתפס לא נכון חותך את כף היד, "
"כך גם פרישות הנתפסת לא נכון "
"גוררת אדם לגיהינום."

msgid "312"
msgstr ""
"כל פעולה בהיסח דעת, כל חובה מוסרית המושחתת, "
"כל חיים רוחניים העומדים בספק— "
"כל אלה אינם מניבים פירות רבים."

msgid "313"
msgstr ""
"על אדם לעשות את שעליו לעשות מתוך מאמץ איתן. "
"חיי פרישות בטלים "
"מעוררים אף יותר אבק."

msgid "314"
msgstr ""
"מוטב לא לעשות מעשה רע, כי לאחר מכן הוא גורם לאדם להתענות. "
"מוטב לעשות מעשה טוב, "
"כי לאחר מכן אין הוא גורם לאדם חרטות."

msgid "315"
msgstr ""
"כמו עיר חומה, המוגנת מבפנים ומבחוץ— שמור על עצמך היטב, "
"אל תיתן להזדמנות הזו לחמוק. אלו שמפספסים את ההזדמנות, "
"מצטערים כשהם נולדים בגיהינום."

msgid "316"
msgstr ""
"המתביישים במה שאין להתבייש, ואינם מתביישים במה שיש להתבייש— "
"האוחזים בהשקפות מוטעות "
"מועדים להגיע לעולמות היגון."

msgid "317"
msgstr ""
"הרואים פחד היכן שאין פחד, ואינם רואים פחד היכן שיש פחד— "
"האוחזים בהשקפות מוטעות "
"מועדים להגיע לעולמות היגון."

msgid "318"
msgstr ""
"המוצאים דופי במה שאין דופי, ואינם מוצאים דופי במה שיש דופי— "
"האוחזים בהשקפות מוטעות "
"מועדים להגיע לעולמות היגון."

msgid "319"
msgstr ""
"המכירים בטעות כטעות ואת שאינו טעות כחסר-טעות— "
"האוחזים בהשקפות נכונות, "
"מועדים להגיע לעולמות הברכה."

msgid "chap23"
msgstr "הפיל"

msgid "320"
msgstr ""
"כמו פיל בקרב אליו נורים חיצים מכל עבר, "
"כך גם אני אעמוד בהאשמות— "
"אכן, אנשים רבים הם חסרי מוסר."

msgid "321"
msgstr ""
"פיל מאולף הוא זה שניתן להובילו דרך המון, "
"פיל מאולף הוא זה שעליו רוכב המלך. "
"כך, הטוב מבין האנשים הוא בעל השליטה העצמית, "
"אשר עומד בהאשמות."

msgid "322"
msgstr ""
"מצויינים הם פרדות מאולפים, סוסים גזעיים מעמק האינדו, "
"פילים גדולים ופילים בעלי ניבים— "
"אך טוב מכל אלה הוא בעל השליטה העצמית."

msgid "323"
msgstr ""
"לא באמצעות אמצעים אלה "
"יוכל אדם להגיע אל הארץ חסרת הדרך "
"אליה הולך האדם המאומן היטב "
"בריסון ובשליטה עצמית."

msgid "324"
msgstr ""
"הפיל דְהַנַפָּאלַה מאבד שליטה בתקופת הייחום. "
"בעל-הניבים הקשור אף לא אוכל, "
"כאשר הוא נזכר ביער הפילים."

msgid "325"
msgstr ""
"אדם עצלן, גרגרן ובטלן, המתהפך במיטה "
"כמו חזיר שמן ושבע "
"נולד מחדש שוב ושוב."

msgid "326"
msgstr ""
"לפני כן התודעה הזו נדדה כפי שרצתה, לאן שחשקה, "
"אך עתה אני אשלוט בה בחוכמה— "
"כרוכב השולט בפיל פראי."

msgid "327"
msgstr ""
"היה מסור לערנות, שמור היטב על תודעתך, "
"חלץ עצמך מביצת הפגעים הזו— "
"כמו פיל המחלץ עצמו מהבוץ."

msgid "328"
msgstr ""
"אם אתה מוצא חבר פיקח המוביל חיים ראויים, "
"היה בחברתו בשמחה ובמודעות "
"והתגבר על כל הקשיים."

msgid "329"
msgstr ""
"אם אינך יכול למצוא חבר פיקח המוביל חיים ראויים, "
"אז, כפי שמלך מותיר אחריו ממלכה מובסת "
"או פיל בודד ביער הפילים— לך בדרכך לבדך."

msgid "330"
msgstr ""
"מוטב לחיות לבד, אין רעות עם טיפשים. "
"לך לבדך ואל תעשה כל רע, "
"היה חסר דאגות כמו הפיל מָאטַנְגַה ביער."

msgid "331"
msgstr ""
"מבורכים הם חברים כאשר יש צורך, מבורך הוא סיפוק עם מה שיש, "
"מבורכים הם חסדים כשהחיים מגיעים לקיצם, "
"ומבורכת היא הזניחה של כל הסבל."

msgid "332"
msgstr ""
"מבורך בעולם הוא הסיוע של אדם לאימו, "
"וכך גם מבורך הסיוע של אדם לאביו. "
"מבורך בעולם הוא הסיוע לפרושים, "
"וכך גם מבורך הסיוע לברהמינים."

msgid "333"
msgstr ""
"מבורך הוא המוסר עד סוף החיים, מבורך הוא האמון האיתן, "
"מבורכת היא השגת החוכמה, "
"ומבורכת היא ההמנעות מעשיית כל רע."

msgid "chap24"
msgstr "השתוקקות"

msgid "334"
msgstr ""
"השתוקקותו של אדם החי בפראות גדלה כמו צמח מטפס. "
"הוא קופץ מחיים לחיים, "
"כמו קוף המחפש פירות ביער."

msgid "335"
msgstr ""
"מי שמוכנע על ידי ההשתוקקות המאמללת ונקשר אל העולם, "
"צערו מתרבה כעשב בִּירַנַה אחרי הגשם."

msgid "336"
msgstr ""
"אך מי שמכניע את ההשתוקקות המאמללת הזו, "
"הצער נושר ממנו כטיפת מים מעלה לוטוס."

msgid "337"
msgstr ""
"עיקרו את שורש ההשתוקקות כפי שחופרים את שורש הבִּירַנַה הריחניים. "
"אל תיתנו למָארַה להרוס אתכם שוב ושוב "
"כמו ששיטפון דורס קני סוף."

msgid "338"
msgstr ""
"כפי שעץ שנפל ישוב לגדול אם שורשיו נותרו שלמים, "
"כך גם סבל צומח שוב ושוב "
"עד אשר ההשתוקקות החבויה נעקרת."

msgid "339"
msgstr ""
"שלושים ושישה זרמי התשוקה הזורמים אל עבר מושאי ההנאה, "
"סוחפים אדם בעל השקפות רעות בשיטפון מחשבות התאווה."

msgid "340"
msgstr ""
"נהרות אלה זורמים בכל מקום והצמח המטפס של ההשתוקקות נובט. "
"בראותך את המטפס מנביט, "
"חתוך את שורשיו באמצעות חוכמה."

msgid "341"
msgstr ""
"יצורים חיים מאושרים בנהרות התאוות— "
"בהסתמכות על שמחה הגורמת הנאה, "
"מגיעים אנשים ללידה והזדקנות."

msgid "342"
msgstr ""
"בני האנושות מוקירי התשוקה מתרוצצים כארנבים מפוחדים. "
"לכודים בשלשלאות, "
"הם סובלים שוב ושוב זמן רב."

msgid "343"
msgstr ""
"בני האנושות מוקירי התשוקה מתרוצצים כארנבים מפוחדים. "
"לכן, על אף ההנאה שבתשוקה, "
"על אדם לייחל לאי-תשוקה."

msgid "344"
msgstr ""
"למרות שזנח את הכמיהה לחיי-בית ופנה אל היער, "
"הוא רץ בחזרה מהיער אל חיי-בית. "
"הביטו, על אף שהוא חופשי, הוא שב אל השעבוד."

msgid "345"
msgstr ""
"השלשלאות העשויות ברזל או עץ אינן החזקות ביותר. "
"הכמיהה לתכשיטים, ילדים ונשים הן שלשלאות חזקות בהרבה."

msgid "346"
msgstr ""
"הן מושכות מטה וקשות להתרה; "
"החכמים חותכים אותן ופורשים מהעולם."

msgid "347"
msgstr ""
"האחוזים בתאווה לכודים במערבולת כעכביש ברשתו. "
"גם אותה חותכים החכמים, "
"וללא כל כמיהה, הם זונחים את כל הסבל."

msgid "348"
msgstr ""
"זנח את העבר, זנח את העתיד, זנח את ההווה וחצה אל מעבר לקיום. "
"עם תודעה משוחררת מכל דבר "
"לא תמצא עוד לידה והזדקנות."

msgid "349"
msgstr ""
"אדם המוטרד ממחשבות ובעל תאווה עזה— "
"השתוקקותו גדלה בקביעות, "
"והוא אכן מחזק את השלשלאות."

msgid "350"
msgstr ""
"מי שנהנה מהשקטת מחשבותיו ומתרגל מודעות והתבוננות בדוֹחֶה— "
"הוא אכן ישים קץ לתשוקה "
"וינפץ את שלשלאותיו של מָארַה."

msgid "351"
msgstr ""
"הוא שהשיג את המטרה, חסר הפחד ונטול התאווה— "
"השתחרר מההשתוקקות ושלף את קוץ הקיום. "
"זהו גופו האחרון."

msgid "352"
msgstr ""
"המשוחרר מהשתוקקות והקשרות, המומחה במשמעויות השפה, "
"הוא אכן נושא את גופו האחרון "
"ומכונה חכם גדול, אדם גדול."

msgid "353"
msgstr ""
"הנני מנצח-כל, הנני כל-יודע, בלתי מוכתם על ידי דבר. "
"לאחר שזנחתי הכל, השתחררתי תוך הכחדת ההשתוקקות. "
"משהבנתי הכל בעצמי, למי אוכל לקרוא מורי?"

msgid "354"
msgstr ""
"מתנת הדְהַמַּה טובה מכל המתנות, טעם הדְהַמַּה מכל הטעמים. "
"הנאת הדְהַמַּה טובה מכל ההנאות, "
"השחרור מתשוקה מביס את כל הסבל."

msgid "355"
msgstr ""
"עושר הורס את הטיפש, אך לא את מי שמחפש את הגדה השנייה. "
"בתשוקה לעושר הורס השוטה "
"את עצמו ואת הסובבים לו."

msgid "356"
msgstr ""
"עשב משחית את השדות, תאווה משחיתה את בני האדם. "
"לכן, נדבה לאלה החופשיים מתאווה "
"מניבה פירות רבים."

msgid "357"
msgstr ""
"עשב משחית את השדות, שנאה משחיתה את בני האדם. "
"לכן, נדבה לאלה החופשיים משנאה "
"מניבה פירות רבים."

msgid "358"
msgstr ""
"עשב משחית את השדות, אשליה משחיתה את בני האדם. "
"לכן, נדבה לאלה החופשיים מאשליה "
"מניבה פירות רבים."

msgid "359"
msgstr ""
"עשב משחית את השדות, השתוקקות משחיתה את בני האדם. "
"לכן, נדבה לאלה החופשיים מהשתוקקות "
"מניבה פירות רבים."

msgid "chap25"
msgstr "הנזיר"

msgid "360"
msgstr ""
"טוב הוא ריסון העין, ריסון האוזן הוא טוב. "
"טוב הוא ריסון האף, "
"ריסון הלשון הוא טוב."

msgid "361"
msgstr ""
"טוב הוא ריסון הגוף, ריסון הדיבור הוא טוב. "
"טוב הוא ריסון המחשבה, בכל עניין ריסון הוא טוב. "
"הנזיר המרוסן בכל דרך משתחרר מכל סבל."

msgid "362"
msgstr ""
"המרוסן בידיו, ברגליו ובדיבורו, "
"המוצא הנאה בעצמו, המיושב בדעתו, "
"המתבודד והמסופק—אותו מכנים 'נזיר'."

msgid "363"
msgstr ""
"הנזיר המרוסן בלשונו, המצטט דברים ללא יוהרה, "
"ומבהיר את משמעות הלימוד— "
"נעים לשמוע את דבריו."

msgid "364"
msgstr ""
"הנזיר המוצא הנאה בדְהַמַּה, המהרהר בדְהַמַּה "
"וזוכר אותה היטב— "
"לא מאבד את הדְהַמַּה הטובה."

msgid "365"
msgstr ""
"אל לאדם לזלזל בהישגיו, וגם לא לקנא באלו של אחרים. "
"נזיר המקנא בהישגיהם של אחרים "
"אינו משיג ריכוז."

msgid "366"
msgstr ""
"אם נזיר לא מזלזל בהישגיו, אף אם הם מועטים— "
"הישויות השמימיות משבחות אותו "
"המוביל בחריצות חיים טהורים."

msgid "367"
msgstr ""
"מי שאין בו חיבה מכל סוג שהיא לתודעה ולגוף, "
"ושאינו מצטער על מה שאין לו, "
"הוא אכן מכונה 'נזיר'."

msgid "368"
msgstr ""
"הנזיר השוהה באהבה חסרת גבולות ומסור לתורת הבּוּדְּהַה, "
"משיג את השלווה הגבוהה— "
"ברכת החידלון של הדברים המותנים."

msgid "369"
msgstr ""
"נזיר, רוקן את הסירה—ריקה, היא תשוט בקלות. "
"לאחר שתחתוך את התשוקה והשנאה, "
"תגיע לנִיבָּאנַה."

msgid "370"
msgstr ""
"חתוך את החמישה, עזוב את החמישה, ופתח את החמש. "
"הנזיר שהתגבר על חמשת הכבלים "
"מכונה 'אדם שצלח את הזרם'."

msgid "371"
msgstr ""
"נזיר, תרגל מדיטציה, אל תהיה שאנן. "
"אל תבלע כדור ברזל לוהט בשאננות, "
"כי אז תזעק \"זה כואב!\""

msgid "372"
msgstr ""
"אין ריכוז מדיטטיבי לחסר החוכמה, "
"ולא חוכמה לחסר הריכוז המדיטטיבי. "
"מי שיש בו את שניהם קרוב לנִיבָּאנַה."

msgid "373"
msgstr ""
"לאחר שהנזיר נטש את ביתו והשקיט את תודעתו, "
"כשהוא רואה ישירות את הדְהַמַּה הנכונה, "
"אושרו עולה על זה האנושי."

msgid "374"
msgstr ""
"בכל פעם שהוא מתבונן בהופעת והעלמות המִצְרַפִים, "
"הוא חווה שמחה ואושר— "
"לאלו שיודעים, זהו האלמוות."

msgid "375"
msgstr ""
"אלו יסודות החיים: אבטחת החושים, שביעות רצון וריסון. "
"חיה בחברת חברים נמרצים וטהורים;"

msgid "376"
msgstr ""
"היה לבבי ונעים הליכות, "
"וכך, מלא שמחה, תשים קץ לסבל."

msgid "377"
msgstr ""
"כצמח היסמין המשיל את פרחיו הקמלים— "
"כך גם עליכם נזירים, "
"להשיל את תשוקתכם ושנאתכם."

msgid "378"
msgstr ""
"הנזיר השליו בגופו, בדיבורו ובתודעתו, "
"אשר דחה את פתיון העולם— "
"הוא מכונה 'נינוח'."

msgid "379"
msgstr ""
"נזיר, בקר את עצמך, בחן את עצמך— "
"עם מודעות ושליטה עצמית "
"תחיה באושר."

msgid "380"
msgstr ""
"אדם הוא אכן המגן של עצמו ויוצר גורלו— "
"על כן, שלוט בעצמך, "
"כמו סוחר השולט בסוס טוב."

msgid "381"
msgstr ""
"הנזיר מלא השמחה והסיפוק מתורת הבּוּדְּהַה "
"צועד אל עבר הברכה של "
"הדממת הדברים המותנים."

msgid "382"
msgstr ""
"הנזיר הזה, שבעודו צעיר הקדיש עצמו לתורה— "
"מאיר את העולם "
"כמו ירח מתוך ענן."

msgid "chap26"
msgstr "הברהמין"

msgid "383"
msgstr ""
"ברהמין, סלק את תשוקות החושים וחתוך את הזרם. "
"לאחר שתדע את חדלון הדברים המותנים, "
"תדע את הבלתי-נוצר."

msgid "384"
msgstr ""
"כאשר הברהמין מגיע אל הגדה שמעבר בשתי דרכים, "
"אז כל קשריו "
"של 'היודע' נעלמים."

msgid "385"
msgstr ""
"מי שאין עבורו 'הגדה הזו' ולא 'הגדה שמעבר', "
"חסר הצער שהסיר את העול— "
"אותו אני מכנה 'ברהמין'."

msgid "386"
msgstr ""
"מי שיושב ומתרגל ללא דופי, שחופשי מהתחלואים, "
"הוא שהגיע למטרה הנעלה ביותר— "
"אותו אני מכנה 'ברהמין'."

msgid "387"
msgstr ""
"השמש זוהרת ביום, הירח בלילה, הלוחם בשריונו. "
"הברהמין זוהר במדיטציה— אך הבּוּדְּהַה זוהר "
"בגדולתו כל היום וכל הלילה."

msgid "388"
msgstr ""
"משום שנפטר מהרוע הוא ברהמין, ומשום שזנח זיהומיו "
"הוא מכונה 'אדם שיצא לפרישות'. "
"התנהגותו שלווה."

msgid "389"
msgstr ""
"אל לאדם להכות ברהמין, ואל לברהמין לכעוס. "
"בושה היא למכה ברהמין, "
"ובושה גדולה עוד יותר למשיב בכעס."

msgid "390"
msgstr ""
"אין דבר מועיל יותר לברהמין משמירת תודעתו. "
"כאשר הכוונות לפגוע נפסקות, "
"אז הסבל שוקט."

msgid "391"
msgstr ""
"מי שאינו עושה כל רע במעשה, דיבור או מחשבה, "
"אשר מרוסן בשלוש דרכים אלו— "
"אותו אני מכנה 'ברהמין'."

msgid "392"
msgstr ""
"את האדם ממנו לומדים את הדְהַמַּה מהבּוּדְּהַה, "
"יש לכבד במסירות— "
"כפי שברהמין מכבד את מנחת האש."

msgid "393"
msgstr ""
"לא בזכות שיער או שושלת אדם הוא ברהמין. "
"אדם של יושר ואמת— "
"הוא טהור, הוא ברהמין."

msgid "394"
msgstr ""
"שוטה, לשם מה שיערך הקלוע או בגד העור? "
"בתוכך התסבוכת "
"ואתה מקשט את עצמך מבחוץ."

msgid "395"
msgstr ""
"האדם הלובש סחבות, הכחוש, המתרגל בבדידות ביער— "
"אותו אני מכנה 'ברהמין'."

msgid "396"
msgstr ""
"אינני מכנה אדם 'ברהמין' רק בשל לידתו. "
"החופשי מהקשרות ואינו קשור לדבר— "
"אותו אני מכנה 'ברהמין'."

msgid "397"
msgstr ""
"מי שחתך את כל הכבלים ואין לו דאגות, "
"הוא שהתנתק מההצמדות— "
"אותו אני מכנה 'ברהמין'."

msgid "398"
msgstr ""
"מי שחתך את השוט והרסן והסיר המכשולים— "
"אותו אני מכנה 'ברהמין'."

msgid "399"
msgstr ""
"מי שעומד בעלבונות מבלי לנטור טינה, "
"הוא שכוח סובלנותו גדול כצבא— "
"אותו אני מכנה 'ברהמין'."

msgid "400"
msgstr ""
"מי שמסור לתרגול, נינוח ומוסרי בענווה, "
"הוא שנושא את גופו האחרון— "
"אותו אני מכנה 'ברהמין'."

msgid "401"
msgstr ""
"כמו טיפת מים על עלה לוטוס או חרדל על חוד מחט, "
"הוא שאינו מוכתם בהנאות החושים— "
"אותו אני מכנה 'ברהמין'."

msgid "402"
msgstr ""
"מי שיודע בבהירות את קץ הסבל בחייו אלה, "
"הוא שהוריד את העול ואינו כבול— "
"אותו אני מכנה 'ברהמין'."

msgid "403"
msgstr ""
"הנבון המבחין בין הדרך הנכונה למוטעית, "
"הוא שהשיג את המטרה הנעלה— "
"אותו אני מכנה 'ברהמין'."

msgid "404"
msgstr ""
"מי שחי בנפרד מבעלי-בית ומחסרי-בית כאחד, "
"שאין לו מקום קבע ומעט רצונות— "
"אותו אני מכנה 'ברהמין'."

msgid "405"
msgstr ""
"מי שמתרחק מאלימות כלפי כלל היצורים, "
"שלא הורג או גורם לאחרים להרוג— "
"אותו אני מכנה 'ברהמין'."

msgid "406"
msgstr ""
"מי שחברותי בין העוינים ושלום בין האלימים, "
"וחסר הקשרות בין הקשורים— "
"אותו אני מכנה 'ברהמין'."

msgid "407"
msgstr ""
"מי שנשרו ממנו תאווה ושנאה ויוהרה, "
"כמו גרגר חרדל מחודה של מחט— "
"אותו אני מכנה 'ברהמין'."

msgid "408"
msgstr ""
"מי שמדבר אמת במילים עדינות ומחכימות, "
"הוא שאינו פוגע באחר— "
"אותו אני מכנה 'ברהמין'."

msgid "409"
msgstr ""
"מי שאינו לוקח דבר שלא ניתן לו, "
"בין אם ארוך או קצר, יפה או מכוער— "
"אותו אני מכנה 'ברהמין'."

msgid "410"
msgstr ""
"מי שאינו רוצה דבר בעולם הזה או בבא, "
"הוא שנטול תשוקה ואינו כבול— "
"אותו אני מכנה 'ברהמין'."

msgid "411"
msgstr ""
"חסר ההקשרויות, שהתפטר מספקות באמצעות הבנה "
"והתבסס באלמוות— "
"אותו אני מכנה 'ברהמין'."

msgid "412"
msgstr ""
"מי שהתגבר על החיבור לחסד ולרוע, "
"נטול הצער, הטהור ללא דופי— "
"אותו אני מכנה 'ברהמין'."

msgid "413"
msgstr ""
"מי שכמו הירח, טהור, נקי ורגוע, "
"שהתענגותו מהקיום מוצתה— "
"אותו אני מכנה 'ברהמין'."

msgid "414"
msgstr ""
"מי שחצה את דרך האשליה והסַנְֹסָארַה, "
"המשוחרר ללא אחיזה וחסר ספקות— "
"אותו אני מכנה 'ברהמין'."

msgid "415"
msgstr ""
"מי שזנח את הנאות החושים ויצא לפרישות, "
"והנאתו מהקיום מוצתה— "
"אותו אני מכנה 'ברהמין'."

msgid "416"
msgstr ""
"מי שזנח את ההשתוקקות ויצא לפרישות, "
"והשתוקקותו לקיום מוצתה— "
"אותו אני מכנה 'ברהמין'."

msgid "417"
msgstr ""
"מי שזנח שעבוד אנושי והתעלה מעל שמיימי, "
"ומשוחרר מכל שעבוד— "
"אותו אני מכנה 'ברהמין'."

msgid "418"
msgstr ""
"מי שחיסל את האהוב והלא-אהוב והפך שליו, "
"הגיבור שהביס את כל העולמות— "
"אותו אני מכנה 'ברהמין'."

msgid "419"
msgstr ""
"מי שיודע בכל הדרכים את המיתות והלידות, "
"חסר ההקשרות, הער שהלך-מעבר— "
"אותו אני מכנה 'ברהמין'."

msgid "420"
msgstr ""
"מי שיעדו אינו ידוע לישויות או לבני-אדם, "
"האַרַהַנְט החופשי מהתחלואים— "
"אותו אני מכנה 'ברהמין'."

msgid "421"
msgstr ""
"מי שאינו נקשר לדבר מהעבר, הווה או עתיד, "
"שאינו לוקח דבר ואינו בעלים של דבר— "
"אותו אני מכנה 'ברהמין'."

msgid "422"
msgstr ""
"הגיבור האצילי, החכם הגדול והמביס, "
"חסר התשוקה, הער והמטוהר— "
"אותו אני מכנה 'ברהמין'."

msgid "423"
msgstr ""
"מי שיודע לידותיו הקודמות וראה גיהינומים, "
"החכם שהגשים תובנת-על והשלים כל ההישגים— "
"אותו אני מכנה 'ברהמין'."